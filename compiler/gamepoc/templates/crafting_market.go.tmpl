			return
		}
		now := r.state.Life.Seconds
		r.state.Crafting.Serial++
		r.state.Crafting.Jobs = append(r.state.Crafting.Jobs, crafting.Job{ID: job, Worker: ms.Actor, Client: ms.Actor, Plan: p, Store: ms.OrderStore, Start: now, Due: now + r.craftingQueue(ms.Actor) + p.Seconds})
