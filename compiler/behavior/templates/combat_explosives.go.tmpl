// Code generated by ANG. Finite thrown explosives and observed-area decisions.
package behavior

import (
	"errors"
	"math"
	"strconv"
)

func validateExplosiveStock(a Combatant) error {
	if len(a.Explosives) > 16 {
		return errors.New("too many explosive definitions")
	}
	seen := map[string]bool{}
	for _, stock := range a.Explosives {
		x := stock.Explosive
		if x.ID == "" || len(x.ID) > 256 || seen[x.ID] || stock.Count < 0 || stock.Count > 1000 || x.Damage < 1 || x.Damage > 1000000 || x.RadiusMM < 1 || x.RadiusMM > 100000 || x.RangeMM < 1 || x.RangeMM > 100000 || x.AP < 1 || x.AP > 100 || x.Suppression < 0 || x.Suppression > 1000000 || x.Bleed < 0 || x.Bleed > 1000000 {
			return errors.New("invalid explosive stock")
		}
		seen[x.ID] = true
	}
	return nil
}

func (space CombatSpace) blastProtection(origin, target Cell) float64 {
	if space.BlastProtection != nil {
		p := space.BlastProtection(origin, target)
		if math.IsNaN(p) || math.IsInf(p, 0) {
			return 1
		}
		return math.Max(0, math.Min(1, p))
	}
	if !space.shotClear(origin, target) {
		return 1
	}
	return 0
}

// The falloff is explicit authored gameplay, not a claim to simulate pressure.
// Full opaque geometry stops this model; hidden bodies never stop a throw or
// alter its preview. Actual collateral is resolved by the physical host.
func CombatBlastScale(space CombatSpace, x CombatExplosive, origin, target Cell) float64 {
	distance := space.rangeMM(origin, target)
	if distance > x.RadiusMM {
		return 0
	}
	return (1 - .8*float64(distance)/float64(x.RadiusMM)) * (1 - space.blastProtection(origin, target))
}

func (s CombatState) knowsThrowArea(space CombatSpace, r CombatRules, a Combatant, to Cell) bool {
	if space.visible(a.Position, to, r) {
		return true
	}
	for _, c := range a.Contacts {
		if c.Checked || s.Turn-c.ObservedTurn > r.MemoryTurns {
			continue
		}
		if space.rangeMM(c.Position, to) <= max(space.CellMM, c.Radius*space.CellMM) {
			return true
		}
	}
	return false
}

func (s *CombatState) executeThrow(space CombatSpace, r CombatRules, actorID string, action CombatAction) error {
	if err := r.Validate(); err != nil {
		return err
	}
	a := s.Current()
	if a == nil || a.ID != actorID || !a.Able() || a.Noncombatant || a.StunTurns > 0 {
		return errors.New("throw unavailable")
	}
	if err := validateExplosiveStock(*a); err != nil {
		return err
	}
	observed := s.Clone()
	observed.Observe(space, r)
	a = observed.Actor(actorID)
	stockIndex := -1
	for i, x := range a.Explosives {
		if x.Explosive.ID == action.ItemID && x.Count > 0 {
			stockIndex = i
			break
		}
	}
	if stockIndex < 0 {
		return errors.New("no carried explosive")
	}
	x := a.Explosives[stockIndex].Explosive
	if a.AP < x.AP || !space.standable(action.To) || space.rangeMM(a.Position, action.To) > x.RangeMM || !observed.knowsThrowArea(space, r, *a, action.To) {
		return errors.New("throw AP, range or observed area unavailable")
	}
	clear := space.shotClear(a.Position, action.To)
	if space.ThrowClear != nil {
		clear = space.ThrowClear(a.Position, action.To)
	}
	if !clear {
		return errors.New("throw arc blocked")
	}
	*s = observed
	a = s.Actor(actorID)
	a.AP -= x.AP
	a.Explosives[stockIndex].Count--
	s.ActionSeq++
	origin := a.Position
	s.event(CombatEvent{Type: "throw", ActorID: actorID, ItemID: x.ID, ItemsSpent: 1, From: origin, To: action.To, AP: x.AP, Reason: "finite carried explosive"})
	// One explosion event lets a host apply the SAME authored blast to ambient
	// bystanders outside the turn queue without making them known to the planner.
	s.event(CombatEvent{Type: "explosion", ActorID: actorID, ItemID: x.ID, From: origin, To: action.To, Reason: "physical blast"})
	for i := range s.Actors {
		b := &s.Actors[i]
		if b.HP <= 0 {
			continue
		}
		scale := CombatBlastScale(space, x, action.To, b.Position)
		if scale <= 0 {
			continue
		}
		stream := "combat.v2/" + s.ID + "/" + strconv.FormatUint(s.ActionSeq, 10) + "/blast/" + b.ID
		spread := r.DamageMin + (r.DamageMax-r.DamageMin)*float64(CounterRandom(s.Seed, actorID, s.Turn, stream)>>11)*(1.0/(1<<53))
		raw := int(math.Round(float64(x.Damage) * scale * spread))
		blocked := CombatArmorBlocked(*b, raw, "torso")
		damage := s.ApplyDamage(space, r, actorID, b.ID, raw, int(math.Ceil(float64(x.Bleed)*scale)), int(math.Ceil(float64(x.Suppression)*scale)), "torso")
		s.event(CombatEvent{Type: "blast_hit", ActorID: actorID, TargetID: b.ID, ItemID: x.ID, From: action.To, To: b.Position, Amount: damage, Hit: raw > 0, ArmorBlocked: blocked, BodyPart: "torso", Reason: "blast and geometry"})
	}
	s.explosionSignal(space, r, action.To, actorID)
	s.AfterAction(space, r, actorID, action)
	return nil
}

// The flash/sound belongs to the landing point, never the hidden thrower.
// A visible flash carries an exact area observation; hearing alone is coarse
// and anonymous, using the host's same acoustic attenuation as other sounds.
func (s *CombatState) explosionSignal(space CombatSpace, r CombatRules, origin Cell, throwerID string) {
	emitter := Combatant{Position: origin, HP: 1, Prone: true}
	for i := range s.Actors {
		listener := &s.Actors[i]
		if !listener.Able() || listener.ID == throwerID {
			continue
		}
		visible := space.ActorVisible(*listener, emitter, r)
		audible := space.rangeMM(listener.Position, origin) <= r.HearingRangeMM && (space.CanHear == nil || space.CanHear(*listener, emitter))
		if !visible && !audible {
			continue
		}
		pos, source, radius := origin, "explosion", 0
		if !visible {
			pos = Cell{origin.X / 3 * 3, origin.Y / 3 * 3}
			source = "hearing"
			radius = 3
		}
		s.remember(listener, CombatContact{SubjectID: "noise.blast." + strconv.FormatUint(s.ActionSeq, 10), Position: pos, ObservedTurn: s.Turn, ObservedAction: s.ActionSeq, ReceivedTurn: s.Turn, Source: source, SourceID: listener.ID, Radius: radius, Visible: visible})
	}
}

// The only candidate centres come from this actor's existing contacts. No
// hidden actor position, health, movement or unseen civilian is queried here.
func (s CombatState) explosiveCandidates(space CombatSpace, r CombatRules, a Combatant) []CombatCandidate {
	if a.Noncombatant || !a.Able() || a.StunTurns > 0 {
		return nil
	}
	var candidates []CombatCandidate
	for _, stock := range a.Explosives {
		x := stock.Explosive
		if stock.Count < 1 || a.AP < x.AP {
			continue
		}
		seen := map[Cell]bool{}
		for _, contact := range a.Contacts {
			if contact.Source == "hearing" || contact.Team == a.Team || contact.Checked || s.Turn-contact.ObservedTurn > r.MemoryTurns || seen[contact.Position] {
				continue
			}
			to := contact.Position
			seen[to] = true
			if !space.standable(to) || space.rangeMM(a.Position, to) > x.RangeMM {
				continue
			}
			clear := space.shotClear(a.Position, to)
			if space.ThrowClear != nil {
				clear = space.ThrowClear(a.Position, to)
			}
			if !clear {
				continue
			}
			score := -float64(x.Damage) * CombatBlastScale(space, x, to, a.Position) * 5
			for _, c := range a.Contacts {
				if c.Source == "hearing" || c.Checked || s.Turn-c.ObservedTurn > r.MemoryTurns {
					continue
				}
				certainty := 1 - float64(s.Turn-c.ObservedTurn)/float64(r.MemoryTurns+1)
				potential := float64(x.Damage) * CombatBlastScale(space, x, to, c.Position) * certainty
				if c.Team == a.Team {
					score -= potential * 5
				} else if c.Source != "hearing" {
					score += potential
				}
			}
			for _, ally := range s.Actors {
				if ally.ID == a.ID || (!ally.Noncombatant && ally.Team != a.Team) || !space.ActorVisible(a, ally, r) {
					continue
				}
				score -= float64(x.Damage) * CombatBlastScale(space, x, to, ally.Position) * 5
			}
			if space.VisibleBystanders != nil {
				for _, pos := range space.VisibleBystanders(a) {
					score -= float64(x.Damage) * CombatBlastScale(space, x, to, pos) * 5
				}
			}
			if score > 0 {
				candidates = append(candidates, CombatCandidate{Action: CombatAction{Type: "throw", ItemID: x.ID, To: to}, Score: score * r.AttackWeight, Reason: "known hostile area less visible friendly blast risk", AP: x.AP})
			}
		}
	}
	return candidates
}
