   if !a.Arrived{a.Arrived=true;a.StartedAt=s.Seconds;a.Activity=step.Activity;a.Label=step.Label;if a.OverrideLevel!=""{a.Activity="rest";a.Label="Прибыл";a.OverrideLevel="";a.OverrideEdge=""};if a.Activity=="eat"{a.Meals++};s.note(person.Name+": "+a.Label)};continue
