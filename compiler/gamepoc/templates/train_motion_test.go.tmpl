 r:=lifeRuntimeFixture(t);level:="level.c7_transport_hub";hero:=r.state.Life.Actor(playerActorID)
 hero.Level=level;hero.Position=behavior.Cell{X:125,Y:46};hero.Goal=hero.Position;hero.Trip=nil;hero.Path=nil;hero.PendingPath=nil;hero.Body=nil;hero.Manual=true;hero.OverrideLevel="";hero.OverrideEdge="";hero.Visits[level]=1;r.syncLifeHero();r.updateLifeExploration()
 guard:=r.state.Life.Actor("char.poc_hub_guard");if guard==nil{t.Fatal("missing existing hub guard fixture")}
 space:=r.world.Life.Space(level,nil)
 for y:=52;y<60;y++{for x:=0;x<128;x++{target:=behavior.Cell{X:x,Y:y};if space.CanStand(target)||len(space.Path(guard.Position,target,behavior.Cell{},0))!=0{t.Fatalf("NPC can enter the declared track at %v",target)}}}
 c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})};r.lifeMove(c,&pb.MoveTo{Epoch:r.state.Epoch,InputSeq:1,X:64,Y:54})
 if result:=(<-c.out).GetMoveResult();result==nil||result.Ok||result.Reason!="Сюда нельзя пройти"{t.Fatalf("ordinary hero track move was not refused by navigation: %+v",result)}
