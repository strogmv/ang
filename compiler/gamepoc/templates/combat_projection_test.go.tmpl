func TestCombatProjectionObservesEventsAtTheirOwnTime(t *testing.T){
 r,_,target:=combatLifeFixture(t,true)
 level:=r.currentLevel();l:=r.world.Life.Locations[level];l.Terrain=[]string{".....",".#...",".#...",".#...","....."};l.PlayerRangeCells=20;r.world.Life.Locations[level]=l;delete(r.world.Decks,level);r.world.Opaque["#"]=true
 hero:=r.combatant(playerActorID,"hero");hero.Position=behavior.Cell{X:0,Y:2};enemy:=r.combatant(target,"enemy");enemy.Position=behavior.Cell{X:3,Y:2}
 previous:=behavior.CombatState{ID:"projection",LevelID:level,Active:true,Turn:1,Actors:[]behavior.Combatant{hero,enemy}}
 r.state.Combat=previous.Clone();r.state.Combat.Actor(playerActorID).Position=behavior.Cell{X:2,Y:2}
 r.state.CombatPublicSeq=0;r.state.CombatPublicSerial=0;r.state.CombatPublicEvents=nil
 events:=[]behavior.CombatEvent{{Type:"guard",ActorID:target,From:enemy.Position,To:enemy.Position,Reason:"private tactical reasoning"}}
 from:=hero.Position;for _,to:=range []behavior.Cell{{X:0,Y:1},{X:0,Y:0},{X:1,Y:0},{X:2,Y:0},{X:2,Y:1},{X:2,Y:2}}{events=append(events,behavior.CombatEvent{Type:"move",ActorID:playerActorID,From:from,To:to});from=to}
 events=append(events,behavior.CombatEvent{Type:"guard",ActorID:target,From:enemy.Position,To:enemy.Position,Reason:"private tactical reasoning"})
 for i:=range events{events[i].Turn=1;events[i].Sequence=uint64(i+1)};r.state.Combat.Events=events;r.state.Combat.EventSeq=uint64(len(events))
 r.capturePublicCombatEventsFrom(previous)
 seen:=0;for i,e:=range r.state.CombatPublicEvents{if e.Reason!=""||e.Sequence!=uint64(i+1){t.Fatal("private reason or sequence gap disclosed")};if e.ActorID==target{seen++}}
 if seen!=1||len(r.state.CombatPublicEvents)!=len(events)-1{t.Fatal("coming around the corner retroactively exposed an earlier hidden action",r.state.CombatPublicEvents)}
 saved:=append([]behavior.CombatEvent(nil),r.state.CombatPublicEvents...);r.capturePublicCombatEvents();if !reflect.DeepEqual(saved,r.state.CombatPublicEvents){t.Fatal("republication duplicated observed events")}
