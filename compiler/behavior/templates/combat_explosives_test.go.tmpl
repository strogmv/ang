func TestCombatExplosionHearingUsesLandingPointAndAnonymousSource(t *testing.T) {
	r, space := combatAdvancedRules(), combatFixtureSpace()
	space.Space.Visible = func(from, to Cell) bool { return from == to || from.Y == 1 && to.Y == 1 }
	origins := []Cell{}
	space.CanHear = func(_, source Combatant) bool { origins = append(origins, source.Position); return true }
	a, b := combatBomber("a", "blue", Cell{1, 1}, 1), combatClub("b", "red", Cell{5, 1})
	a.Initiative = 30
	listener := combatClub("listener", "red", Cell{8, 5})
	s := combatNewAdvanced(t, r, space, a, b, listener)
	combatDo(t, &s, space, r, "a", CombatAction{Type: "throw", ItemID: combatBomb().ID, To: Cell{5, 1}})
	if len(origins) == 0 {
		t.Fatal("no acoustic propagation was attempted")
	}
	for _, origin := range origins {
		if origin != (Cell{5, 1}) {
			t.Fatal("explosion was heard from the thrower's position")
		}
	}
	heard := false
	for _, c := range s.Actor("listener").Contacts {
		if strings.HasPrefix(c.SubjectID, "noise.blast.") {
			heard = true
			if c.Source != "hearing" || c.SourceID != "listener" || c.Team != "" || c.Position == (Cell{5, 1}) || c.Radius != 3 {
				t.Fatal("heard blast exposed the thrower's identity or exact unseen origin")
			}
		}
	}
	if !heard {
		t.Fatal("hidden listener did not remember an audible anonymous blast area")
	}
}
