 if s.Outcome=="escape"&&s.Phase=="done"&&r.talkNear(e.Actor,24){
  if d:=r.world.Conversations[e.Talk.Gate];d!=nil&&r.talkEntry(talkCtx{conv:d,key:talkKey(e.Talk.Gate,e.Actor),self:e.Actor,t:&talkState{}})!=nil{
   if t:=r.state.Memory.Talks[talkKey(e.Talk.Gate,e.Actor)];t==nil||!t.chose("bye"){return e.Talk.Gate,true}
  }
 }
 return "",false
}
// encounterTalkAllowed: whether a conversation is the encounter's (owned), and whether it may go on now.
func(r *Runtime)encounterTalkAllowed(conv string)(owned,ok bool){
 e:=r.world.CalendarEncounter;if e==nil{return false,false};s:=r.state.CalendarEncounter
 reach:=func(id string)int{if d:=r.world.Conversations[id];d!=nil{return d.Reach};return e.Reach}
 switch conv{
 case e.Talk.Custody:
  return true,s.Phase=="conversation"&&s.Outcome==""&&r.encounterGuardAvailable()&&r.encounterNear(e.Guard,e.Reach)&&!r.heroInCombat()
 case e.Talk.Sack:
  return true,s.Day<=e.FirstDays&&s.Phase=="selling"&&r.encounterTradeAllowed(e.Actor)&&r.talkNear(e.Actor,reach(conv))
 case e.Talk.Gate:
  return true,s.Outcome=="escape"&&r.talkNear(e.Actor,reach(conv))
 }
 return false,false
}
// encounterTalkClosed: the custody's closing word is a choice: its outcome, or the failure's when the check failed; the
// talk's own timeout (no answer within its answer seconds) is the duty's timeout.
func(r *Runtime)encounterTalkClosed(conv,self,word string,failed bool){
 e:=r.world.CalendarEncounter;if e==nil||conv!=e.Talk.Custody||r.state.CalendarEncounter.Outcome!=""{return}
 if word=="timeout"{r.resolveEncounter("timeout","forced",true,false);return}
 for _,c:=range e.Choices{if c.ID==word{
  outcome:=c.Outcome;if failed&&c.Fail!=nil{outcome=c.Fail.Outcome}
  r.resolveEncounter(c.ID,outcome,r.memorySeenBy(talkCtx{},e.Guard),failed);return
 }}
}
// encounterPassageOpen (world query passage_open): the way from the actor to the gate's passage is open on the floor.
func(r *Runtime)encounterPassageOpen()bool{
 e:=r.world.CalendarEncounter;if e==nil{return false};a:=r.state.Life.Actor(e.Actor);edge:=r.world.Life.Edge(e.GateEdge)
 return a!=nil&&edge!=nil&&a.OnFloor()&&a.Level==edge.From&&r.state.Life.StaticTravelSeconds(r.world.Life,a.Level,a.Position,edge.Exit)>=0
}
// migrateEncounterMemory: a save from before story memory had the custody's log in the encounter and the acquaintance as
// two flags. The log becomes the custody talk; the acquaintance and a settled custody become the facts the conversation
// would have written (its own data replayed: the closing answer's effects, with the guard's sight as it was saved).
func(r *Runtime)migrateEncounterMemory(s *state){
 e:=r.world.CalendarEncounter;if e==nil||r.world.Memory==nil{s.CalendarEncounter.Talk=dialogueSession{};return}
 keep:=r.state;r.state=*s;defer func(){*s=r.state;r.state=keep}();v:=&r.state.CalendarEncounter
 if met:=r.encounterMetFact();met!=""&&(v.Met||v.Bought){if _,ok:=r.state.Memory.Facts[met];!ok{
  args:=r.world.Memory.Facts[met].OnTrade.Args
  if v.Met&&!v.Bought{if d:=r.world.Conversations[e.Talk.Sack];d!=nil{for _,n:=range d.Nodes{for _,o:=range n.Options{for _,do:=range o.Do{if do.Fact==met&&do.When==nil&&o.Check==nil{args=do.Args}}}}}}
  r.memoryWrite(met,args,talkCtx{self:e.Actor,quiet:true})
 }}
 v.Met,v.Bought=false,false
 custody:=talkKey(e.Talk.Custody,e.Actor)
 if d:=r.world.Conversations[e.Talk.Custody];d!=nil&&len(v.Talk.Lines)+len(v.Talk.Chosen)+len(v.Talk.Checks)>0&&r.state.Memory.Talks[custody]==nil{
  t:=r.talkState(custody);t.dialogueSession=migrateTalk(d,v.Talk)
  t.Node=d.Entries[len(d.Entries)-1].Node;t.Entry=d.Entries[len(d.Entries)-1].ID;t.Nodes=[]string{t.Node}
  r.state.Memory.Serial++;t.Serial=r.state.Memory.Serial
  if v.Phase=="conversation"{r.state.Memory.Open=custody}
 }
 v.Talk=dialogueSession{}
 if v.Outcome==""{return}
 d:=r.world.Conversations[e.Talk.Custody];if d==nil{return}
 settled:=false;for _,n:=range d.Nodes{for _,o:=range n.Options{for _,do:=range append(append([]memDo(nil),o.Do...),failDo(o)...){if _,ok:=r.state.Memory.Facts[do.Fact];do.Fact!=""&&ok{settled=true}}}}
 if settled{return}
 seen:=false;for _,entry:=range v.Log{if entry.Choice==v.Choice&&entry.Cause==e.Duty.Law{seen=entry.Observed}}
 c:=talkCtx{conv:d,key:custody,self:e.Actor,t:r.talkState(custody),seen:map[string]bool{e.Guard:seen},quiet:true}
 if v.Choice=="timeout"{if ev:=d.Events["timeout"];ev!=nil{r.memoryDo(c,ev.Do)};return}
 for _,n:=range d.Nodes{for _,o:=range n.Options{if o.Close!=v.Choice{continue}
  failed:=false;for _,ch:=range e.Choices{if ch.ID==v.Choice&&ch.Fail!=nil&&ch.Fail.Outcome==v.Outcome&&ch.Outcome!=v.Outcome{failed=true}}
  if failed&&o.Fail!=nil{r.memoryDo(c,o.Fail.Do)}else{r.memoryDo(c,o.Do)};return
 }}
}
func failDo(o convOption)[]memDo{if o.Fail==nil{return nil};return o.Fail.Do}
// migrateTalk: an older custody log keeps what the conversation still has — its answers and checks by id (a question
// folded since, like the old intake question, goes), its people's lines, the voices and check results.
func migrateTalk(d *conversationDef,old dialogueSession)dialogueSession{
 options:=map[string]bool{};for _,n:=range d.Nodes{for _,o:=range n.Options{options[o.ID]=true}}
 speakers:=map[string]bool{};for _,sp:=range d.Speakers{speakers[sp]=true}
 s:=dialogueSession{}
 for _,id:=range old.Chosen{if options[id]{s.Chosen=append(s.Chosen,id)}}
 for id,c:=range old.Checks{if options[id]{if s.Checks==nil{s.Checks=map[string]dialogueCheckRecord{}};s.Checks[id]=c}}
 for _,l:=range old.Lines{if l.Kind!="line"||speakers[l.Speaker]{s.Lines=append(s.Lines,l)}}
 return s
}
// encounterFight: the hero attacked the guard during the custody (combat.go): a fact of the hall. The talk is hidden while
// the fight goes on (its owner does not hold it) and the guard's fate decides the rest.
func(r *Runtime)encounterFight(){
 e:=r.world.CalendarEncounter;if e==nil{return}
 if _,ok:=r.state.Memory.Facts[e.Facts.Fight];!ok{r.memoryWrite(e.Facts.Fight,nil,talkCtx{self:e.Actor})}
}
