func openWith(t *testing.T, r *Runtime, who string) *talkState {
	t.Helper()
	if err := r.conversationCommand(&pb.PocLifeCommand{Action: "conversation_open", Destination: who}); err != nil {
		t.Fatal(err)
	}
	conv, _ := r.talkOf(who)
	return r.state.Memory.Talks[talkKey(conv.Conversation, who)]
}

// hasNews: the person has something of his own to say now — an interjection not yet said, a question not yet asked
// (a talk that opens always is offered without it; one that opens with news only then).
func hasNews(r *Runtime, who string) bool {
	def, ok := r.talkOf(who)
	return ok && r.talkNews(def.Conversation, who)
}

// witnessFor: the fact written now (minus ago seconds) with the person as its witness.
func witnessFor(r *Runtime, who, fact string, ago int64) {
	r.memoryWrite(fact, nil, talkCtx{self: who, quiet: true})
	rec := r.state.Memory.Facts[fact]
	rec.Witnesses = append(rec.Witnesses, who)
	rec.Second -= ago
	rec.First = rec.Second
	r.state.Memory.Facts[fact] = rec
}

func TestMemoryMarketAsksAfterProkhorWhileHeIsMissing(t *testing.T) {
	r := memoryDay(t, 5)
	e := r.world.CalendarEncounter
	if _, ok := r.state.Memory.Facts[e.Facts.Missing]; !ok {
		t.Fatal("the missing days wrote no fact")
	}
	akim := akimAt(t, r)
	news := false
	if def, ok := r.talkOf(akim.Actor); ok {
		news = def.Open == "news"
	}
	// a talk that opens only with news: a stranger of Prokhor's is offered none; one that opens always is offered
	if _, ok := r.talkAvailable(akim.Actor); ok == news {
		t.Fatalf("Akim's talk with a stranger of Prokhor's: offered %v, opens only with news %v", ok, news)
	}
	if r.talkNews(r.world.Memory.Talks[0].Conversation, akim.Actor) {
		t.Fatal("Akim has something to say to a stranger of Prokhor's")
	}
	met := r.encounterMetFact()
	r.memoryWrite(met, map[string]string{"how": "greeted"}, talkCtx{self: e.Actor, quiet: true})
	tk := openWith(t, r, akim.Actor)
	// his own greeting (the writer's line for him) or the caste's
	if tk.Interjected || !strings.HasPrefix(tk.Lines[0].Text, "dlg.market.") || tk.Lines[0].Speaker != akim.Actor {
		t.Fatalf("Akim did not see it, yet: %+v", tk.Lines)
	}
	if err := choose(r, "ask_prokhor"); err != nil {
		t.Fatal(err)
	}
	if last := tk.Lines[len(tk.Lines)-1]; last.Text != "dlg.market.ask_prokhor.akim" || last.Speaker != akim.Actor {
		t.Fatalf("Akim answers %+v", last)
	}
	if _, ok := r.state.Memory.Topics["topic.prokhor_missing"]; !ok {
		t.Fatal("asking gave no topic")
	}
	if shown := shownIDs(dialogueView(t, r, "ru")); !shown["ask_prokhor"] || !shown["trade"] || !shown["bye"] {
		t.Fatalf("answers after the question: %v", shown)
	}
	// knowing where Prokhor sleeps, Akim's answer changes; a witness of the acquaintance says it first, once
	w := memoryDay(t, 5)
	akimAt(t, w)
	w.memoryTopic("topic.prokhor_gate")
	w.memoryWrite(met, map[string]string{"how": "bought"}, talkCtx{self: e.Actor, quiet: true})
	rec := w.state.Memory.Facts[met]
	rec.Witnesses = append(rec.Witnesses, akim.Actor)
	w.state.Memory.Facts[met] = rec
	tk = openWith(t, w, akim.Actor)
	if !tk.Interjected || tk.Lines[0].Text != "interject.prokhor_met.akim" {
		t.Fatalf("the witness did not say it first: %+v", tk.Lines)
	}
	if err := choose(w, "ask_prokhor"); err != nil {
		t.Fatal(err)
	}
	if last := tk.Lines[len(tk.Lines)-1]; last.Text != "dlg.market.ask_prokhor.akim_gate" {
		t.Fatalf("the gate variant: %+v", last)
	}
	if err := choose(w, "bye"); err != nil {
		t.Fatal(err)
	}
	w.talkDrop()
	if _, ok := w.talkAvailable(akim.Actor); ok == news {
		t.Fatalf("Akim's talk after he said it and was asked: offered %v, opens only with news %v", ok, news)
	}
	if def, _ := w.talkOf(akim.Actor); w.talkNews(def.Conversation, akim.Actor) {
		t.Fatal("Akim has news after he said it and was asked")
	}
}

func TestActOneMarketAkimOpening(t *testing.T) {
	const aside = "interject.night_car.akim"
	const water = "fact.prokhor.given_water"
	const waterLine = "interject.water.akim"
	for _, witnessed := range []bool{false, true} {
		t.Run(fmt.Sprintf("witnessed=%t", witnessed), func(t *testing.T) {
			r := memoryDay(t, 5)
			akim := akimAt(t, r)
			if witnessed {
				witnessFor(r, akim.Actor, water, 0)
			} else {
				r.memoryWrite(water, nil, talkCtx{self: r.world.CalendarEncounter.Actor, quiet: true})
			}
			if r.world.Memory.Facts[water].Visibility != "witnessed" || r.memoryKnows(akim.Actor, water) != witnessed {
				t.Fatal("the water fact has the wrong visibility")
			}
			if r.dialogueText("ru", aside) != "четвёртый вагон отцепляют потому у нас их три" ||
				r.dialogueText("en", aside) != "they unhitch the fourth car y'all that's why we only got three" {
				t.Fatal("Akim's aside differs from the script")
			}
			tk := openWith(t, r, akim.Actor)
			if witnessed {
				if !tk.Interjected || len(tk.Lines) != 2 || tk.Lines[0].Text != waterLine || tk.Lines[1].Text != aside {
					t.Fatalf("witness did not lead with the fresh fact: %+v", tk.Lines)
				}
				if err := choose(r, "bye"); err != nil {
					t.Fatal(err)
				}
				tk = openWith(t, r, akim.Actor)
			}
			if tk.Interjected || len(tk.Lines) != 2 || tk.Lines[0].Text != "dlg.market.peddler_akim.greet" ||
				tk.Lines[1].Speaker != akim.Actor || tk.Lines[1].Text != aside {
				t.Fatalf("standing market aside and greeting: %+v", tk.Lines)
			}
			tick, gameTime := r.state.Tick, r.state.Life.Seconds
			r.step()
			if !r.talkHolds() || r.state.Tick != tick || r.state.Life.Seconds != gameTime {
				t.Fatal("the world continued during the opening")
			}
			loaded := memoryRoundTripBytes(t, r, r.snapshotState())
			if loaded.Memory.Open == "" || !reflect.DeepEqual(loaded.Memory.Talks[loaded.Memory.Open], tk) {
				t.Fatal("the open market talk did not survive the save")
			}
			r.state = loaded
			if err := choose(r, "bye"); err != nil {
				t.Fatal(err)
			}
		})
	}
}

func TestMemoryInterjectionFreshestOnceAndStale(t *testing.T) {
	r := memoryDay(t, 5)
	akim := akimAt(t, r)
	witnessFor(r, akim.Actor, "fact.prokhor.custody_refuse", 600)
	witnessFor(r, akim.Actor, "fact.prokhor.custody_lie_caught", 0)
	for _, want := range []string{"interject.lie_caught.akim", "interject.custody_refuse.akim"} {
		tk := openWith(t, r, akim.Actor)
		if !tk.Interjected || tk.Lines[0].Text != want {
			t.Fatalf("want %s first: %+v", want, tk.Lines)
		}
		if err := choose(r, "bye"); err != nil {
			t.Fatal(err)
		}
		r.talkDrop()
	}
	if hasNews(r, akim.Actor) {
		t.Fatal("the same fact was offered twice")
	}
	// a fact older than the freshness is remembered, not said first
	w := memoryDay(t, 5)
	akimAt(t, w)
	w.world.Memory.InterjectionRules.FreshDays = 1
	witnessFor(w, akim.Actor, "fact.prokhor.custody_refuse", 2*86400)
	if hasNews(w, akim.Actor) {
		t.Fatal("a stale fact was said first")
	}
	// who did not see it says nothing (step 1 has no rumours)
	x := memoryDay(t, 5)
	akimAt(t, x)
	x.memoryWrite("fact.prokhor.custody_lie_caught", nil, talkCtx{self: x.world.CalendarEncounter.Actor, quiet: true})
	if hasNews(x, akim.Actor) {
		t.Fatal("Akim knows what he never witnessed")
	}
}

func TestMemoryWitnessesBySightHearingAndScene(t *testing.T) {
	r := memoryDay(t, 5)
	akim := akimAt(t, r)
	e := r.world.CalendarEncounter
	hero := r.state.Life.Actor(playerActorID)
	// public: everyone of the level at once; private: only the named; a silver reader knows what is recorded
	for _, f := range []string{"fact.prokhor.custody_refuse", "fact.prokhor.custody_escape_unseen", "fact.law.duty_refusal"} {
		r.memoryWrite(f, nil, talkCtx{self: e.Actor})
	}
	for i := range r.state.Life.Actors {
		a := &r.state.Life.Actors[i]
		if a.ID == playerActorID || !a.OnFloor() {
			continue
		}
		// a public fact: the level; it is in the record too — silver reads it from anywhere
		if r.memoryKnows(a.ID, "fact.prokhor.custody_refuse") != (a.Level == hero.Level || barkCatalog.Castes[a.ID] == "silver") {
			t.Fatalf("%s on %s and the public refusal", a.ID, a.Level)
		}
		if r.memoryKnows(a.ID, "fact.prokhor.custody_escape_unseen") != (a.ID == e.Actor) {
			t.Fatalf("%s knows a private fact", a.ID)
		}
		if r.memoryKnows(a.ID, "fact.law.duty_refusal") != (a.ID == e.Guard || barkCatalog.Castes[a.ID] == "silver") {
			t.Fatalf("%s and the record", a.ID)
		}
	}
	// a quiet lie is heard within two cells only
	r.memoryWrite("fact.prokhor.custody_lie_believed", nil, talkCtx{self: e.Actor})
	if !r.memoryKnows(akim.Actor, "fact.prokhor.custody_lie_believed") {
		t.Fatal("Akim beside the hero did not hear the quiet lie")
	}
	w := memoryDay(t, 5)
	akimAt(t, w)
	a := w.state.Life.Actor(akim.Actor)
	moved := false
	for _, c := range []inv.Cell{{X: a.Position.X + 6, Y: a.Position.Y}, {X: a.Position.X - 6, Y: a.Position.Y}, {X: a.Position.X, Y: a.Position.Y + 6}, {X: a.Position.X, Y: a.Position.Y - 6}} {
		if w.world.Life.Walks(a.Level, behavior.Cell{X: c.X, Y: c.Y}) {
			peddlerPlace(t, w, playerActorID, c)
			moved = true
			break
		}
	}
	if !moved {
		t.Skip("no cell six steps from Akim")
	}
	w.memoryWrite("fact.prokhor.custody_lie_believed", nil, talkCtx{self: e.Actor})
	if w.memoryKnows(akim.Actor, "fact.prokhor.custody_lie_believed") {
		t.Fatal("Akim heard a quiet lie six cells away")
	}
}

