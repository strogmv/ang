{{ if .UseOperationRuntime -}}
type responseLoggable interface {
	Unmarshal([]byte) error
	String() (string, error)
}

func (pp *{{ .StructName }}) logResponsePreferParsed(
	tx *model.Transaction,
	respStatus string,
	rawResp []byte,
	respHeaders http.Header,
	resp any,
) {
	// 1) Prefer provider-defined redacted logging when available.
	if loggableResp, ok := resp.(responseLoggable); ok {
		if err := loggableResp.Unmarshal(rawResp); err == nil {
			if logResp, logErr := loggableResp.String(); logErr == nil {
				pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus, logResp)
				return
			}
		}
	}
	// 2) Fallback: best-effort parse+marshal for readable logs.
	if err := json.Unmarshal(rawResp, resp); err == nil {
		if logResp, logErr := json.Marshal(resp); logErr == nil {
			pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus, string(logResp))
			return
		}
	}
	// 3) Final fallback: raw response details.
	pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus, pp.httpClient.LogRawResponseDetails(rawResp, respHeaders))
}

{{ end }}

