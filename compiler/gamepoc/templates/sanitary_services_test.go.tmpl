func TestSanitaryRejectForgedDoorAndFlow(t *testing.T) {
	r, u := sanitaryFixture(t, "shower")
	sanitaryUsing(t, r, u)
	sanitaryAdvance(t, r, 2)
	for _, mutate := range []func(*state){func(s *state) { d := s.Sanitary.Doors[u.cellKey()]; d.To = 1; s.Sanitary.Doors[u.cellKey()] = d }, func(s *state) {
		p := s.Sanitary.Users[playerActorID]
		p.WaterRemainder++
		s.Sanitary.Users[playerActorID] = p
	}, func(s *state) { s.Life.Actor(playerActorID).ServiceAttachment = "invented" }, func(s *state) { s.Sanitary.Completed = map[string]uint64{u.ID: 1} }} {
