// Code generated by ANG. Typed train drawing contract, current level only.
package poc

import ("math";pb "angelsdemons/server/internal/transport/grpc/pb/game/v1")

func(r *Runtime)appendTrainMotion(view *pb.PocLifeView,level,locale string){
 s:=r.trainMotionSnapshot()
 if p,ok:=r.state.TrainPassengers[playerActorID];ok{view.HeroBoarded=true;view.BoardingStatus=r.localText(locale,"ui.train.boarded","");view.BoardingRemainingSeconds=math.Max(0,float64(p.DepartNS-r.simNS())/1e9)}
 motion:=&pb.PocRailMotion{ClockDomain:s.ClockDomain,ClockSeconds:s.ClockSeconds,SampleSimNs:s.SampleSimNS,Epoch:s.Epoch,GameSeconds:s.GameSeconds,SkippedDepartures:r.state.TrainDispatch.Skipped}
 for _,train:=range s.Trains{
  t:=&pb.PocRailTrain{TrainId:train.TrainID,Run:train.Run,Phase:train.Phase,DistanceM:train.DistanceM,SpeedMps:train.SpeedMPS,DoorsOpen:train.DoorsOpen,DoorProgress:train.DoorProgress,WheelTravelM:train.WheelTravelM,NextLocationKey:train.NextLocationKey,NextLocationEtaSeconds:train.NextLocationETASeconds}
  for _,module:=range train.Modules{
   m:=&pb.PocRailModule{Id:module.ID}
   for _,binding:=range module.Bindings{if binding.LevelID==level{m.Bindings=append(m.Bindings,&pb.PocRailBinding{LevelId:level,Visible:binding.Visible,X:binding.X,Y:binding.Y,Z:binding.Z,YawDegrees:binding.YawDegrees})}}
   if len(m.Bindings)>0{t.Modules=append(t.Modules,m)}
  }
  for _,passage:=range train.Passages{if passage.LevelID==level{t.Passages=append(t.Passages,&pb.PocRailPassage{LevelId:level,NameKey:passage.NameKey,Visible:passage.Visible,EtaSeconds:passage.ETASeconds,ArrivalClockSeconds:passage.ArrivalClockSeconds,Approaching:passage.Approaching})}}
  motion.Trains=append(motion.Trains,t)
 }
 view.TrainMotion=motion
 if c:=r.world.TrainMotion;c!=nil{
  catalog:=&pb.PocRailCatalog{DoorTravelM:c.DoorTravelM,BoardingDoorGroup:c.BoardingDoorGroup}
  stocks:=append([]trainMotionStock{{NameKey:c.NameKey,TrainID:c.TrainID,StockID:c.StockID,PrefabResource:c.PrefabResource}},c.AdditionalFleet...)
  for _,stock:=range stocks{catalog.Stocks=append(catalog.Stocks,&pb.PocRailStock{TrainId:stock.TrainID,StockId:stock.StockID,PrefabResource:stock.PrefabResource,NameKey:stock.NameKey})}
  for _,module:=range c.Modules{catalog.Modules=append(catalog.Modules,&pb.PocRailModuleDefinition{Id:module.ID,OffsetM:module.OffsetM,LengthM:module.LengthM,WidthM:module.WidthM})}
  view.TrainCatalog=catalog
 }
}
