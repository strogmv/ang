// world.hud (owner 20.11: «у гг же иплантипрован чип бронзы это самый крутой, только большинство функций
// заблокированны»). Presentation only: every value below is read from state the server already keeps (the wound model,
// the brain's needs, the light on the hero and his steps, the inventory, the fight's view); nothing here is a rule, is
// saved, or reaches a decision.
type chipHudCatalog struct {
	ItemSlots int `json:"item_slots"`
	Feed struct {
		Lines    int               `json:"lines"`
		HitKey   string            `json:"hit_key"`
		MissKey  string            `json:"miss_key"`
		ActKey   string            `json:"act_key"`
		Events   map[string]string `json:"events"`
		Modes    map[string]string `json:"modes"`
		OtherKey string            `json:"other_key"`
	} `json:"feed"`
	Quick []struct {
		Definition string `json:"definition"`
		KindKey    string `json:"kind_key"`
		IdleKey    string `json:"idle_key"`
	} `json:"quick_items"`
	Needs []struct {
		ID         string `json:"id"`
		BrainIndex int    `json:"brain_index"`
		TextKey    string `json:"text_key"`
	} `json:"needs"`
	Seen []struct {
		Below   *float64 `json:"below,omitempty"`
		TextKey string   `json:"text_key"`
	} `json:"seen"`
	Noise struct {
		StillKey string `json:"still_key"`
		QuietKey string `json:"quiet_key"`
		WalkKey  string `json:"walk_key"`
		RunKey   string `json:"run_key"`
	} `json:"noise"`
	Functions []struct {
		ID        string `json:"id"`
		Icon      string `json:"icon"`
		NameKey   string `json:"name_key"`
		TextKey   string `json:"text_key"`
		Unlock    string `json:"unlock"`
		ReasonKey string `json:"reason_key,omitempty"`
		LaterKey  string `json:"later_key,omitempty"`
	} `json:"functions"`
	Link struct {
		Default string            `json:"default"`
		Levels  map[string]string `json:"levels"`
		States  map[string]struct {
			TextKey string `json:"text_key"`
			Bars    int32  `json:"bars"`
		} `json:"states"`
	} `json:"link"`
}

// chipHudName: a fighter's name as the HUD shows it («Вы» for the hero, «кто-то» for one the hero does not see).
func (r *Runtime) chipHudName(locale, id string, seen map[string]bool) string {
	if id == playerActorID {
		return r.localText(locale, "ui.screen.combat.you", "you")
	}
	if !seen[id] {
		return r.localText(locale, "ui.hud.someone", "someone")
	}
	fallback := id
	if person := r.world.Life.Person(id); person != nil && person.Name != "" {
		fallback = person.Name
	}
	return r.localText(locale, "actor."+id+".name", fallback)
}

// appendChipHud builds state.hud after the fight's view and the hero's condition are in msg.
func (r *Runtime) appendChipHud(msg *pb.PocGameState, locale string) {
	h := r.world.Hud
	if h == nil || !r.state.Life.Enabled {
		return
	}
	text := func(key string) string { return r.localText(locale, key, key) }
	v := &pb.PocHudView{BloodPermille: 1000, State: "ok", StateText: text("wounds.state.ok")}
	msg.Hud = v
	// the medmonitor: the hero's body in the wound model (the fight's own copy in a fight), or whole
	if body, known := r.biomonitorBody(playerActorID); known {
		// the view appendWoundViews made of the same body this publish, else made here
		var view wounds.SelfView
		if r.chipHudSelf != nil {
			view = *r.chipHudSelf
		} else {
			view = combatWounds.ViewSelf(body, 7*86400)
		}
		r.chipHudSelf = nil
		v.State = strings.TrimPrefix(view.State, "wounds.state.")
		v.StateText = text(view.State)
		v.BloodPermille = int32(max(0, min(1000, 1000-body.LostPermille())))
		danger := map[string]bool{}
		for _, line := range view.Lines {
			danger[line.Wound] = danger[line.Wound] || line.Danger
		}
		for _, w := range body.Wounds {
			v.Wounds = append(v.Wounds, &pb.PocWoundMark{Zone: w.Zone, Limb: w.Limb, Danger: danger[w.ID]})
		}
	}
	hero := r.state.Life.Actor(playerActorID)
	if hero != nil {
		for _, n := range h.Needs {
			need := hero.Brain.Needs[n.BrainIndex]
			v.Needs = append(v.Needs, &pb.PocHudNeed{Id: n.ID, Permille: int32(max(0, min(1000, 1000-need/1000))), Text: text(n.TextKey)})
		}
	}
	// how much the hero shows (the light on him, his pose, whether he moves) and how loud his steps are: what his own
	// body tells; never whether anyone sees or hears him
	if body := msg.HeroBody; body != nil && msg.Life != nil {
		factor := 1.0
		if il := msg.Life.Illumination; il != nil && il.Known {
			factor = il.VisibilityFactor
		}
		if r.world.Stealth.Enabled && body.Sneaking && !msg.Life.SneakUpright {
			factor *= r.world.Stealth.SneakVisibility
		}
		if r.world.Stealth.Enabled && body.Moving {
			factor *= r.world.Stealth.MovingVisibility
		}
		for _, level := range h.Seen {
			if level.Below == nil || factor < *level.Below {
				v.SeenText = text(level.TextKey)
				break
			}
		}
		switch {
		case !body.Moving:
			v.NoiseText = text(h.Noise.StillKey)
		case body.Sneaking:
			v.NoiseText = text(h.Noise.QuietKey)
		case body.Run:
			v.NoiseText = text(h.Noise.RunKey)
		default:
			v.NoiseText = text(h.Noise.WalkKey)
		}
	}
	if start := r.world.Start; start != nil && r.state.Memory.OpeningPlayed {
		v.OfficialStatus = "student"
		if status := r.storyOfficialStatus(); status != "" { v.OfficialStatus = status }
		v.SchematicRepair = r.state.Memory.Facts[start.AbilityFact].Count > 0
	}
	for _, f := range h.Functions {
		row := &pb.PocChipFunction{Id: f.ID, Icon: f.Icon, Title: text(f.NameKey), Open: f.Unlock == "start", Text: text(f.TextKey)}
		if !row.Open {
			row.Locked = v.OfficialStatus == "" || v.OfficialStatus == "copper"
			switch {
			case row.Locked:
				row.Reason, row.Text = text(f.ReasonKey), text(f.LaterKey)
			case v.OfficialStatus == "student":
				row.Reason, row.Text = text("file.slot.training"), ""
			default:
				row.Reason, row.Text = "", ""
			}
		}
		v.Functions = append(v.Functions, row)
	}
	link := h.Link.Default
	if msg.Life != nil {
		if state, ok := h.Link.Levels[msg.Life.LevelId]; ok {
			link = state
		}
	}
	if state, ok := h.Link.States[link]; ok {
		v.Link = &pb.PocChipLink{State: link, Text: text(state.TextKey), Bars: state.Bars}
	}
	r.appendChipHudWeapons(v, msg, text)
	r.appendChipHudQuick(v, msg, text)
	v.ItemSlots, v.ItemMore = r.chipHudItemSlots()
	r.appendChipHudFight(v, msg, locale, text)
}

// The weapons the hero carries that a fight would let him hold, in the inventory's own stable order (the panel never
// reorders itself): the one in hand marked, a firearm's charge as «8/10».
func (r *Runtime) appendChipHudWeapons(v *pb.PocHudView, msg *pb.PocGameState, text func(string) string) {
	s := r.state.Inventory
	current, held, holding := r.equippedCombatItem(s, playerActorID)
	others := map[string]behavior.CombatEquipmentOption{}
	for _, o := range r.combatEquipmentOptions(playerActorID) {
		others[o.ID] = o
	}
	for _, id := range combatItemKeys(s) {
		other, isOther := others[id]
		inHand := holding && id == current.ID
		if !inHand && !isOther {
			continue
		}
		item := s.Items[id]
		weapon := held
		if isOther {
			weapon = other.Weapon
		}
		definition := r.world.Inventory.Definitions[item.Definition]
		row := &pb.PocHudWeapon{ItemId: id, Definition: item.Definition, Title: text(definition.Name), Kind: weapon.Kind,
			KindText: text("ui.hud.weapon_kind." + weapon.Kind), Held: inHand}
		if weapon.Magazine > 0 {
			ammo := other.Ammo
			if inHand && msg.PlayerCondition != nil {
				ammo = int(msg.PlayerCondition.Ammo)
			}
			row.AmmoText = fmt.Sprintf("%d/%d", ammo, weapon.Magazine)
		}
		v.Weapons = append(v.Weapons, row)
	}
}

// The fixed quick slots: how many of each the hero carries, and the server's own option that uses one now (an aid on
// a wound, in a fight or out of it); without one the slot says why it rests.
func (r *Runtime) appendChipHudQuick(v *pb.PocHudView, msg *pb.PocGameState, text func(string) string) {
	h := r.world.Hud
	if len(h.Quick) == 0 {
		return
	}
	wanted := map[string]bool{}
	for _, q := range h.Quick {
		wanted[q.Definition] = true
	}
	count := map[string]int64{}
	s := r.state.Inventory
	for _, item := range s.Items {
		if wanted[item.Definition] && r.combatCarried(s, playerActorID, item) {
			count[item.Definition] += item.Quantity
		}
	}
	var options []*pb.PocCombatOption
	if msg.Combat != nil && msg.Combat.Active {
		options = msg.Combat.Options
	} else if msg.PlayerCondition != nil {
		options = msg.PlayerCondition.AidOptions
	}
	for _, q := range h.Quick {
		row := &pb.PocQuickItem{Definition: q.Definition, Title: text(r.world.Inventory.Definitions[q.Definition].Name),
			KindText: text(q.KindKey), Count: int32(count[q.Definition])}
		if row.Count > 0 {
			for _, o := range options {
				if o.ItemId == q.Definition && (row.Use == nil || !row.Use.Enabled && o.Enabled) {
					row.Use = o
				}
			}
		}
		if row.Use == nil {
			row.Reason = text(q.IdleKey)
		}
		v.Quick = append(v.Quick, row)
	}
}

// The ПРЕДМЕТЫ deck's slots (review 21.11: the panel never reorders itself): an item keeps its slot while the hero
// carries it, a newly carried one takes the first empty slot (in id order); more counts the carried items no slot holds
// (the deck's «+N»). The saved slots (state.HudSlots) are written by the tick (advanceChipHudSlots); a view between
// ticks shows the same assignment the next tick saves.
func (r *Runtime) chipHudItemSlots() (slots []string, more int32) {
	n := r.world.Hud.ItemSlots
	s := r.state.Inventory
	ids := make([]string, 0, 16)
	for id, item := range s.Items {
		if !item.Hidden && item.Quantity > 0 && r.carried(item) {
			if r.world.Inventory.Dress != nil && item.Location.Store != inv.DressStore(playerActorID, heroBelt) {
				if !dressWorn(item) { more++ }
				continue
			}
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	held := make(map[string]bool, len(ids))
	for _, id := range ids {
		held[id] = true
	}
	slots = make([]string, n)
	placed := map[string]bool{}
	for i := 0; i < n && i < len(r.state.HudSlots); i++ {
		if id := r.state.HudSlots[i]; held[id] && !placed[id] {
			slots[i], placed[id] = id, true
		}
	}
	next := 0
	for _, id := range ids {
		if placed[id] {
			continue
		}
		for next < n && slots[next] != "" {
			next++
		}
		if next == n {
			more++
			continue
		}
		slots[next], placed[id] = id, true
	}
	return slots, more
}

// advanceChipHudSlots: the tick saves the slots whenever the inventory changed (its revision) or a game was loaded.
func (r *Runtime) advanceChipHudSlots() {
	if r.world.Hud == nil || !r.state.Life.Enabled {
		return
	}
	key := chipHudSlotsKey{epoch: r.state.Epoch, revision: r.state.Inventory.Revision, known: true}
	if key == r.chipHudSlotsAt {
		return
	}
	r.chipHudSlotsAt = key
	r.state.HudSlots, _ = r.chipHudItemSlots()
}

type chipHudSlotsKey struct {
	epoch    string
	revision uint64
	known    bool
}

// loadChipHudSlots: a loaded slot keeps only an item the save holds, once. A save made between a command that used
// up an item and the next tick still names it; that slot is simply empty again (the slots only show, no rule reads them).
func loadChipHudSlots(s *state) {
	seen := map[string]bool{}
	for i, id := range s.HudSlots {
		if _, ok := s.Inventory.Items[id]; id != "" && (!ok || seen[id]) {
			s.HudSlots[i] = ""
		}
		seen[id] = true
	}
}

// The fight's feed (its last events as short lines) and the order of turns (initiative; a fighter the hero has not
// seen is only «?», his id is not sent).
func (r *Runtime) appendChipHudFight(v *pb.PocHudView, msg *pb.PocGameState, locale string, text func(string) string) {
	h := r.world.Hud
	c := msg.Combat
	if c == nil {
		return
	}
	seen := map[string]bool{}
	for _, a := range c.Actors {
		seen[a.Id] = true
	}
	for i := len(c.Events) - 1; i >= 0 && len(v.Feed) < h.Feed.Lines; i-- {
		e := c.Events[i]
		word, listed := h.Feed.Events[e.Type]
		if !listed {
			continue
		}
		key := h.Feed.ActKey
		if e.Type == "attack" {
			if mode, ok := h.Feed.Modes[e.Mode]; ok {
				word = mode
			}
			key = h.Feed.MissKey
			if e.Hit {
				key = h.Feed.HitKey
			}
		}
		part := ""
		if e.BodyPart != "" {
			part = strings.ToLower(r.localText(locale, "ui.combat.body."+e.BodyPart, e.BodyPart))
		}
		line := strings.NewReplacer("{actor}", r.chipHudName(locale, e.ActorId, seen), "{action}", text(word), "{part}", part,
			"{ap}", fmt.Sprint(e.Ap)).Replace(text(key))
		v.Feed = append([]*pb.PocHudFeedLine{{Sequence: e.Sequence, Text: line}}, v.Feed...)
	}
	if !c.Active {
		return
	}
	for _, a := range r.state.Combat.Actors {
		if !a.Able() && a.ID != playerActorID {
			continue
		}
		row := &pb.PocTurnSlot{Current: a.ID == c.CurrentActorId, Own: a.ID == playerActorID}
		if seen[a.ID] || row.Own {
			row.Id, row.Title = a.ID, r.chipHudName(locale, a.ID, seen)
		} else {
			row.Unknown = true
		}
		v.Order = append(v.Order, row)
	}
}
