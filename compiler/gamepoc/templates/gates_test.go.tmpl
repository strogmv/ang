// Code generated by ANG. Gate stand through the real host: Go MoveTo, sight,
// calendar rates, lockdown timing and a real disk save in the middle of a lift.
package poc

import (
 "angelsdemons/server/internal/behavior"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
 "testing"
)

type gateStand struct{r *Runtime;level sdkLevel;gate behavior.LifeGate;mid,axis behavior.Cell;near int}

// The first compiled SDK stand with a gate; content without one skips.
func gateStandRuntime(t *testing.T)*gateStand{
 t.Helper();r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 for _,l:=range r.world.LocationSDK.Levels{if len(l.Gates)==0{continue}
  if result:=sdkHostNew(t,r,"sdk:"+l.ID,"gate-stand");!result.Ok{t.Fatal(result)}
  g:=&gateStand{r:r,level:l,gate:l.Gates[0]};g.mid=g.gate.Opening[len(g.gate.Opening)/2]
  if g.gate.Opening[0].Y==g.gate.Opening[len(g.gate.Opening)-1].Y{g.axis=behavior.Cell{Y:1}}else{g.axis=behavior.Cell{X:1}}
  g.near=1;if (l.Spawn.X-g.mid.X)*g.axis.X+(l.Spawn.Y-g.mid.Y)*g.axis.Y<0{g.near=-1}
  // Park the stand people where they stand: these checks time the hero alone.
  for i:=range r.state.Life.Actors{if a:=&r.state.Life.Actors[i];a.ID!=playerActorID{a.Manual=true;a.Goal=a.Position;a.Path=nil;a.Arrived=true}}
  return g
 }
 t.Skip("no SDK stand with a gate in this content");return nil
}
// at moves the calendar forward (never back) to the next given second of the day.
func(g *gateStand)at(second int64){s:=&g.r.state.Life;s.Seconds+=((second-s.Seconds%86400)%86400+86400)%86400}
func(g *gateStand)side(k int)point{return point{g.mid.X+g.axis.X*g.near*k,g.mid.Y+g.axis.Y*g.near*k}}
func(g *gateStand)state()behavior.LifeGateState{return g.r.state.Life.Gates[g.gate.ID]}
// onNear: the hero is strictly on the spawn side of the gate line.
func(g *gateStand)onNear()bool{h:=g.r.state.Life.Actor(playerActorID).Position;return ((h.X-g.mid.X)*g.axis.X+(h.Y-g.mid.Y)*g.axis.Y)*g.near>0}
func(g *gateStand)inOpening()bool{h:=g.r.state.Life.Actor(playerActorID).Position;for _,c:=range g.gate.Opening{if c==h{return true}};return false}
// Every frame passes full Life validation, including "no body under a lowered gate".
func(g *gateStand)step(t *testing.T){t.Helper();g.r.step();if err:=g.r.state.Life.Validate(g.r.world.Life,g.r.state.Tick);err!=nil{t.Fatal(err)}}
// farCell: the nearest spawn-side floor cell whose walk to the opening exceeds steps.
func(g *gateStand)farCell(t *testing.T,steps int)point{
 t.Helper();terrain:=g.level.Terrain;start:=g.side(1);dist:=map[point]int{start:0};queue:=[]point{start}
 for len(queue)>0{at:=queue[0];queue=queue[1:];if dist[at]>=steps{return at}
  for _,d:=range []point{{1,0},{0,1},{-1,0},{0,-1}}{n:=point{at.X+d.X,at.Y+d.Y};if n.Y<0||n.Y>=len(terrain)||n.X<0||n.X>=len(terrain[n.Y])||terrain[n.Y][n.X]!='.'{continue};if _,ok:=dist[n];ok{continue};if ((n.X-g.mid.X)*g.axis.X+(n.Y-g.mid.Y)*g.axis.Y)*g.near<=0{continue};dist[n]=dist[at]+1;queue=append(queue,n)}}
 t.Fatalf("stand has no floor %d steps from its gate",steps);return point{}
}
func(g *gateStand)until(t *testing.T,limit int,what string,done func()bool){t.Helper();for i:=0;i<limit;i++{if done(){return};g.step(t)};if !done(){t.Fatalf("%s not reached: %+v hero=%v",what,g.state(),g.r.state.Life.Actor(playerActorID).Position)}}
func(g *gateStand)walk(t *testing.T,to point){t.Helper();if res:=sdkHostMove(t,g.r,to,g.r.state.LastMoveSeq+1);!res.Ok{t.Fatalf("move to %v rejected: %s",to,res.Reason)};g.until(t,400,"arrival",func()bool{return g.r.state.Player==to&&len(g.r.state.Path)==0})}
func(g *gateStand)command(t *testing.T,action string){t.Helper();if err:=g.r.lifeCommand(&pb.PocLifeCommand{Action:action,Destination:g.gate.ID});err!=nil{t.Fatal(err)}}
func(g *gateStand)wire(t *testing.T)(*pb.PocGateState,*pb.PocObserverView){t.Helper();c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})};g.r.sendState(c);w:=(<-c.out).GetGameState();if w==nil||w.Life==nil{t.Fatal("no state")};for _,s:=range w.Life.Gates{if s.Id==g.gate.ID{return s,w.PlayerView}};return nil,w.PlayerView}

func TestGateStandScheduleObstructionAtFastCalendarAndBlockedPassage(t *testing.T){
 g:=gateStandRuntime(t);r:=g.r
 if s:=g.state();s.State!="open"||!s.Passable(){t.Fatalf("stand starts with a closed gate: %+v",s)}
 // Hero waits inside the opening; the calendar runs at ×300 across the close time.
 g.walk(t,point{g.mid.X,g.mid.Y});g.at(g.gate.CloseSecond-60)
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"rate",SecondsPerTick:30});err!=nil{t.Fatal(err)}
 g.until(t,200,"stop over the hero",func()bool{return g.state().State=="stopped"})
 if s:=g.state();s.Position(r.state.Tick)!=behavior.GateFull||s.Cause!="schedule"||!g.inOpening(){t.Fatalf("gate moved over the hero: %+v",s)}
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"rate",SecondsPerTick:1});err!=nil{t.Fatal(err)}
 // Leave: clear for the retry time, warn again, lower and lock.
 g.walk(t,g.side(4));left:=r.state.Tick;last:=behavior.GateFull
 g.until(t,600,"locked",func()bool{p:=g.state().Position(r.state.Tick);if p>last{t.Fatal("lift rose while closing")};last=p;return g.state().State=="locked"})
 if g.state().Start<left+g.gate.RetryTicks{t.Fatal("lowered before the opening stayed clear")}
 if res:=sdkHostMove(t,r,g.side(-3),r.state.LastMoveSeq+1);res.Ok{t.Fatal("hero allowed through a locked gate")}
 wire,view:=g.wire(t);if wire==nil||wire.State!="locked"||wire.Passable||wire.SeeThrough{t.Fatalf("wire %+v",wire)}
 if viewSees(view,int32(g.side(-2).X),int32(g.side(-2).Y)){t.Fatal("hero sees through a lowered gate")}
}

func TestGateStandMorningLiftSaveLoadResumesAndSightThreshold(t *testing.T){
 g:=gateStandRuntime(t);r:=g.r;g.at(g.gate.CloseSecond+60)
 g.until(t,400,"locked",func()bool{return g.state().State=="locked"})
 g.at(g.gate.OpenSecond-30)
 g.until(t,400,"mid lift",func()bool{p:=g.state().Position(r.state.Tick);return g.state().State=="opening"&&p>=g.gate.SightClearPPM&&p<behavior.GateFull*7/10})
 wire,view:=g.wire(t);if wire==nil||wire.Passable||!wire.SeeThrough||wire.SegmentDurationNs<=0{t.Fatalf("mid lift wire %+v",wire)}
 if !viewSees(view,int32(g.side(-2).X),int32(g.side(-2).Y)){t.Fatal("no sight under a gate raised above 2.1 m")}
 if res:=sdkHostMove(t,r,g.side(-3),r.state.LastMoveSeq+1);res.Ok{t.Fatal("passage accepted before full lift")}
 saved:=g.state().Position(r.state.Tick)
 if err:=r.writeSave("slot3",r.snapshotState());err!=nil{t.Fatal(err)}
 for i:=0;i<20;i++{g.step(t)}
 loaded,_,err:=r.readSave("slot3");if err!=nil{t.Fatal(err)};sdkHostLoad(t,r,loaded,"gate-load")
 if p:=g.state().Position(r.state.Tick);p!=saved||g.state().State!="opening"{t.Fatalf("load changed lift %d -> %d",saved,p)}
 g.step(t);if p:=g.state().Position(r.state.Tick);p<=saved{t.Fatal("lift did not resume after load")}
 g.until(t,400,"open",func()bool{return g.state().State=="open"})
 if res:=sdkHostMove(t,r,g.side(-3),r.state.LastMoveSeq+1);!res.Ok{t.Fatal("open gate refused passage")}
}

// Alarm: a hero far from the gate cannot make it; one next to it can.
func TestGateStandLockdownFarFailsNearPasses(t *testing.T){
 g:=gateStandRuntime(t);r:=g.r;g.at((g.gate.OpenSecond+g.gate.CloseSecond)/2)
 g.until(t,400,"open by day",func()bool{return g.state().State=="open"})
 warnSteps:=int(g.gate.LockdownWarningTicks/r.world.Life.MoveTicks)
 // Far: walk distance to the opening well beyond the warning.
 g.walk(t,g.farCell(t,warnSteps+3))
 if res:=sdkHostMove(t,r,g.side(-3),r.state.LastMoveSeq+1);!res.Ok{t.Fatal("open gate refused passage")}
 g.command(t,"gate_lockdown");crossed:=false
 g.until(t,600,"lockdown down",func()bool{if !g.onNear(){crossed=true};s:=g.state();return s.State=="lockdown"&&s.Duration==0})
 if crossed||!g.onNear(){t.Fatal("far hero crossed under the alarm")}
 if res:=sdkHostMove(t,r,g.side(-3),r.state.LastMoveSeq+1);res.Ok{t.Fatal("passage accepted under lockdown")}
 g.command(t,"gate_release");g.until(t,600,"reopen",func()bool{return g.state().State=="open"})
 // Near: two cells away, through within the warning.
 g.walk(t,g.side(2))
 if res:=sdkHostMove(t,r,g.side(-3),r.state.LastMoveSeq+1);!res.Ok{t.Fatal("open gate refused passage")}
 g.command(t,"gate_lockdown")
 g.until(t,600,"lockdown down",func()bool{s:=g.state();return s.State=="lockdown"&&s.Duration==0&&len(r.state.Path)==0})
 if g.onNear()||g.inOpening(){t.Fatal("near hero did not pass within the warning")}
 // Power loss: governor descent, no raise until mains return.
 g.command(t,"gate_release");g.until(t,600,"reopen",func()bool{return g.state().State=="open"})
 g.command(t,"gate_power_off");g.until(t,600,"no power down",func()bool{s:=g.state();return s.State=="no_power"&&s.Duration==0})
 g.command(t,"gate_power_on");g.until(t,600,"reopen after mains",func()bool{return g.state().State=="open"})
 if err:=func()error{r.state.SDKLayout="";defer func(){r.state.SDKLayout=g.level.ID}();return r.gateCommand("gate_lockdown",g.gate.ID)}();err==nil{t.Fatal("gate input accepted outside the stand")}
}
