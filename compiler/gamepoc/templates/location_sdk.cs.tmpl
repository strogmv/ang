  // Presentation only: post-processing follows the graphics option; the flat
  // ambient follows the view brightness like the authored light sources.
  void LocationSDKApplyPresentation(float brightness){
   // Graphics option for user shaders (demo-hub v2-light floor): 1 at economy, 0 at full (the default of an unset global).
   Shader.SetGlobalFloat("_AngGraphicsEconomy",GraphicsFull?0f:1f);
   // A painted background already carries its own grade and glow: post stays off.
   var postProfile=LocationSDKOverrideContract.PresentationProfile(locationSDKPresentationEntry,GraphicsFull);if(locationSDKVolume!=null&&postProfile!=null&&locationSDKVolume.sharedProfile!=postProfile)locationSDKVolume.sharedProfile=postProfile;
   if(locationSDKCameraData!=null)locationSDKCameraData.renderPostProcessing=postProfile!=null&&locationSDKVolume!=null&&LocationSDKBackgroundStatus!="active";
   var entry=locationSDKPresentationEntry;if(entry==null)return;
   if(!locationSDKAmbientSaved){locationSDKPriorAmbientMode=RenderSettings.ambientMode;locationSDKPriorAmbientLight=RenderSettings.ambientLight;locationSDKPriorAmbientProbe=RenderSettings.ambientProbe;locationSDKPriorReflection=RenderSettings.reflectionIntensity;locationSDKAmbientSaved=true;}
   Color ambient=LocationSDKOverrideContract.PresentationAmbient(entry,locationSDKTime,brightness);var probe=new UnityEngine.Rendering.SphericalHarmonicsL2();probe.AddAmbientLight(ambient);
   RenderSettings.ambientMode=UnityEngine.Rendering.AmbientMode.Flat;RenderSettings.ambientLight=ambient;RenderSettings.ambientProbe=probe;RenderSettings.reflectionIntensity=entry.reflection_intensity;
  }
