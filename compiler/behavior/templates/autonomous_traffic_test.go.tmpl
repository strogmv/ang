  hero:=s.Actor("hero");if hero.Manual||hero.Position!=(Cell{5,2})||hero.Goal!=(Cell{7,2})||len(hero.Path)!=0||len(hero.PendingPath)==0||hero.YieldUntil!=0||hero.Activity=="yielding"{t.Fatalf("population commandeered the scheduled controlled actor: %+v",hero)}
  if s.Actor("service").Position!=(Cell{6,2}){t.Fatal("population displaced an occupied service post")}
  if tick==30{raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};replay=&LifeState{};if err=json.Unmarshal(raw,replay);err!=nil{t.Fatal(err)}}
 }
 resident:=s.Population.Actors[0]
 if resident.Position!=(Cell{4,2})||resident.Goal!=(Cell{5,1})||resident.Arrived{t.Fatalf("resident must retain its destination while waiting at physical contact: %+v",resident)}
