// Code generated by ANG. Authored rail waiting pockets for autonomous residents.
package behavior

import("fmt";"hash/fnv")

func(m LifeModel)validatePlatforms()error{
 for _,edge:=range m.Edges{
  if edge.BoardingWindowSeconds<0||edge.BoardingWindowSeconds>edge.PeriodSeconds||(edge.BoardingWindowSeconds>0&&edge.Mode!="rail")||(edge.NightPeriodSeconds>0&&edge.BoardingWindowSeconds>edge.NightPeriodSeconds){return fmt.Errorf("invalid boarding window %s",edge.ID)}
  if len(edge.WaitingCells)==0{if edge.BoardingLeadSeconds!=0{return fmt.Errorf("platform %s has lead time without waiting cells",edge.ID)};continue}
  if edge.Mode!="rail"||len(edge.WaitingCells)>32||edge.BoardingLeadSeconds<1||edge.BoardingLeadSeconds>3600{return fmt.Errorf("invalid platform waiting policy %s",edge.ID)}
  seen:=map[Cell]bool{}
  for _,at:=range edge.WaitingCells{
   if seen[at]||!m.Walks(edge.From,at){return fmt.Errorf("invalid platform waiting cell %s",edge.ID)};seen[at]=true
   for _,other:=range m.Edges{if other.From==edge.From&&other.Exit==at||other.To==edge.From&&other.Entry==at{return fmt.Errorf("platform waiting cell overlaps travel threshold %s",edge.ID)}}
   if len(m.Space(edge.From,nil).Path(at,edge.Exit,Cell{},0))==0{return fmt.Errorf("platform waiting cell cannot reach boarding %s",edge.ID)}
  }
 }
 return nil
}

// Goal is a durable pocket claim; WaitingDeparture is the existing durable
// timetable choice, not a seat reservation. No appearance/disappearance or
// calendar advancement occurs here. The ordinary planner executes each step.
func(s *LifeState)platformDestination(m LifeModel,a *LifeActor,edge *LifeEdge)(Cell,bool){
 if len(edge.WaitingCells)==0||a.ID==s.ControlledActorID||a.Manual{return edge.Exit,false}
 // A pocket claim may change while walking. Finish the accepted route prefix
 // before negotiating another destination; never restart an in-flight step.
 // The ordinary mover clears invalid/occupied prefixes on physical contact.
 if len(a.Path)>0{return a.Goal,false}
 // Once a boarding approach is committed, another passenger taking its old
 // pocket must not turn the walker around. Capacity retries remain at the
 // existing gate under beginLifeTrip, rather than inventing seat reservations.
 if a.WaitingDeparture>0&&a.Goal==edge.Exit{return edge.Exit,false}
 free:=func(at Cell)bool{
  if s.occupied(a.Level,at,a.ID){return false}
  for _,other:=range s.Actors{if other.ID!=a.ID&&other.ID!=s.ControlledActorID&&!other.Manual&&other.OnFloor()&&other.Level==a.Level&&!other.Arrived&&other.Goal==at{return false}}
  for _,other:=range s.Population.Actors{if other.Materialized&&other.Trip==nil&&other.Level==a.Level&&!other.Arrived&&other.Goal==at{return false}}
  return true
 }
 pocket:=Cell{};found:=false
 for _,at:=range edge.WaitingCells{if at==a.Goal&&free(at){pocket,found=at,true;break}}
 if !found{
  h:=fnv.New32a();_,_=h.Write([]byte(a.ID+"\x00"+edge.ID));start:=int(h.Sum32()%uint32(len(edge.WaitingCells)))
  for n:=range len(edge.WaitingCells){at:=edge.WaitingCells[(start+n)%len(edge.WaitingCells)];if free(at){pocket,found=at,true;break}}
 }
 if !found{a.Path=nil;a.Activity="waiting";a.Label="life.platform.full";return a.Position,true}
 gatePath:=m.Space(a.Level,nil).Path(pocket,edge.Exit,Cell{},0)
 // Static distance sets a conservative release time; congestion still uses
 // the ordinary occupancy-aware route and the actual boarding gate.
 rate:=s.SecondsPerTick;if m.Brain.Enabled{rate=1};travelLead:=int64(len(gatePath))*m.MoveTicks*rate+rate
 if a.WaitingDeparture==0{
  if a.Position!=pocket{a.Label="life.platform.approach";return pocket,false}
  a.WaitingDeparture=edge.NextDeparture(s.Seconds+travelLead+edge.BoardingLeadSeconds)
 }
 if s.Seconds+travelLead>=a.WaitingDeparture-edge.BoardingWindowSeconds{a.Label="life.platform.boarding";return edge.Exit,false}
 if a.Position==pocket{a.Goal=pocket;a.Path=nil;a.Activity="waiting";a.Label="life.platform.waiting";return pocket,true}
 a.Label="life.platform.approach";return pocket,false
}
