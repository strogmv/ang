	known.Refuted = true
	r.state.Memory.Story.Hero[missing] = known
	if note = r.placeNote("ru", loadingMarket); note != nil {
		t.Fatalf("a refuted rumour is still the line: %+v", note)
	}
	if rows := storyRows(r, "ru"); len(rows.Entries) == 0 {
		t.Fatal("the rumour left the journal")
	}
}

