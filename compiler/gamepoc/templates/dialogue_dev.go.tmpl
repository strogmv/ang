				s.put("fired", rule.ID, strconv.FormatInt(at, 10))
			} else if now := r.state.Life.Seconds; rule.When != nil {
				at := r.storyConditionWake(rule.When, now)
				if now < at && at < math.MaxInt64 {
					s.put("scheduled", rule.ID, strconv.FormatInt(at, 10))
				}
			}
		}
