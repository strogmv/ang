		a := &out.Actors[i]
		a.Safety=a.Safety.clone();a.Profile=s.Actors[i].Profile.clone();a.Brain=a.Brain.Clone()
		a.Path = append([]Cell(nil), a.Path...)
		if a.Trip != nil {
			trip := *a.Trip
			a.Trip = &trip
		}
		a.Visits = make(map[string]int, len(s.Actors[i].Visits))
		for level, count := range s.Actors[i].Visits {
			a.Visits[level] = count
		}
	}
	return out
}

// Only materialized actors occupy cells. Coarse residents have an abstract
// level/anchor, not hidden physical copies. Their first reserved step also
// blocks other movement kernels so two systems cannot claim the same cell.
func (s PopulationState) Occupied() map[string]map[Cell]bool {
	occupied := map[string]map[Cell]bool{}
	for _, a := range s.Actors {
		if (!a.Materialized&&!a.CombatHold) || a.Trip != nil {
			continue
		}
		if occupied[a.Level] == nil {
			occupied[a.Level] = map[Cell]bool{}
		}
		occupied[a.Level][a.Position] = true
		if len(a.Path) > 0 {
			occupied[a.Level][a.Path[0]] = true
		}
	}
	return occupied
}
func populationCellFree(l LifeModel, level string, at Cell, occupied map[string]map[Cell]string, id string) bool {
	return l.Walks(level, at) && (occupied[level][at] == "" || occupied[level][at] == id)
}
func populationReserve(occupied map[string]map[Cell]string, level string, at Cell, id string) {
	if occupied[level] == nil {
		occupied[level] = map[Cell]string{}
	}
	if occupied[level][at]!=id{occupied[level][at] = id}
}
func populationUnreserve(occupied map[string]map[Cell]string, level string, at Cell, id string) {
	if occupied[level][at] == id {
		delete(occupied[level], at)
	}
}
func populationLanding(l LifeModel, level string, entry Cell, occupied map[string]map[Cell]string, id string) (Cell, bool) {
	for _, at := range []Cell{entry, {entry.X + 1, entry.Y}, {entry.X, entry.Y + 1}, {entry.X - 1, entry.Y}, {entry.X, entry.Y - 1}} {
		if populationCellFree(l, level, at, occupied, id) {
			return at, true
		}
	}
	return Cell{}, false
}
func (p PopulationModel) freeAnchor(l LifeModel, level string, index int, occupied map[string]map[Cell]string, id string, reachable func(Cell) bool) (Cell, bool) {
	anchors := p.Anchors[level]
	step:=populationAnchorStride(len(anchors));first:=index/len(p.ShiftOffsets)
	for n := range anchors {
		at := anchors[((first+n)*step)%len(anchors)]
		if populationCellFree(l, level, at, occupied, id) && (reachable==nil || reachable(at)) {
			return at, true
		}
	}
	return Cell{}, false
}

// Public waiting pockets are destinations, never invisible bodies. Existing
// positions and first-step reservations still decide whether a step can start.
// Cold residents use the timetable at the abstract exit without offscreen paths.
func(s *PopulationState)platformDestination(p PopulationModel,l LifeModel,a *PopulationActor,edge *LifeEdge,occupied,claims map[string]map[Cell]string,seconds,secondsPerTick int64)(Cell,bool){
