# Generated by ANG. Ordinary local-server capture for the screen review command.
extends SceneTree
const Catalog=preload("res://generated/screens/catalog.gd")
const C = preload("res://generated/game_contract.gd")
var socket := WebSocketPeer.new()
var cache := C.ViewCache.new()
var token := ""
var hello_sent := false
var new_sent := false
var begin := 0
var received := 0
var changing_locale := false
var save_view:=C.PocSaveSlots.new()
var preferences
func _initialize() -> void:
	begin = Time.get_ticks_msec()
	if ResourceLoader.exists("res://generated/settings.gd"):preferences=load("res://generated/settings.gd").new()
	socket.inbound_buffer_size = 32 * 1024 * 1024
	socket.outbound_buffer_size = 4 * 1024 * 1024
	token = OS.get_environment("ANG_SCREEN_TOKEN")
	socket.connect_to_url(OS.get_environment("ANG_SCREEN_URL"))
func _process(_delta: float) -> bool:
	socket.poll()
	if Time.get_ticks_msec()-begin>45000: push_error("real state capture timed out: socket=%d hello=%s new=%s received=%d" % [socket.get_ready_state(),hello_sent,new_sent,received]);quit(2);return false
	if socket.get_ready_state()!=WebSocketPeer.STATE_OPEN: return false
	if not hello_sent:
		hello_sent = true
		var message := C.ClientMessage.new()
		message.hello = C.Hello.new()
		message.hello.session_token = token
		message.hello.player_name = "Godot"
		message.hello.locale = "ru"
		message.hello.client_version = "poc-1"
		message.hello.view_subscription = C.ViewSubscription.new()
		message.hello.view_subscription.static_on_change = true
		_send(message)
	while socket.get_available_packet_count()>0:
		var raw := socket.get_packet().get_string_from_utf8()
		var envelope := cache.decode_ServerMessage(JSON.parse_string(raw))
		print("SCREEN_CAPTURE_MESSAGE ",JSON.parse_string(raw).keys())
		if envelope.save_slots!=null:save_view=envelope.save_slots
		if envelope.game_state == null: continue
		received += 1
		var state := envelope.game_state
		print("SCREEN_CAPTURE_STATE active=",state.active," tick=",state.tick," inventory=",state.inventory!=null)
		if not new_sent:
			new_sent = true
			var message:=Catalog.command(Catalog.specification().review_action.ref,state,null,{},"screen-capture-new")
			_send(message)
		elif state.active and state.inventory != null:
			var record := {"game_state":state.to_dict(),"saves":save_view.to_dict(),"settings":preferences.snapshot() if preferences!=null else {},"provenance":{"source":"ordinary local server Hello/NewGame","content_hash":state.content_hash,"received":received}}
			var path := OS.get_environment("ANG_SCREEN_STATE")+(".en" if changing_locale else "")
			FileAccess.open(path,FileAccess.WRITE).store_string(JSON.stringify(record))
			if changing_locale: socket.close();quit()
			else:
				changing_locale = true
				var message := C.ClientMessage.new()
				message.locale = C.PocLocaleRequest.new()
				message.locale.locale = "en"
				_send(message)
	return false
func _send(message: C.ClientMessage) -> void:
	var sent := socket.send_text(JSON.stringify(message.to_dict()))
	assert(sent == OK)
