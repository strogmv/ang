 for seed:=int64(1);seed<=100;seed++{
  r.state=base;r.state=r.snapshotState();r.state.Combat.Seed=seed;hero:=r.state.Combat.Actor(playerActorID);foe:=r.state.Combat.Actor(scene.Guard);spec:=r.world.CombatRuntime.Probes["contact"];hero.Position=spec.Hero;foe.Position=spec.Enemy
  body:=combatWounds.NewBody(hero.ID,r.bodyChip(hero.ID));if _,err:=combatWounds.ApplyHit(&body,wounds.Hit{Weapon:"item.knife_simple",Author:foe.ID,Zone:"abdomen",Depth:"deep",Structures:[]string{"liver"},Seed:42});err!=nil{t.Fatal(err)};projectWoundBody(hero,body);hero.FightResponse="flee"
