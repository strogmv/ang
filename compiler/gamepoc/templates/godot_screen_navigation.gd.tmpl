# Generated by ANG. Shared screen mechanics, configured by the catalog.
extends RefCounted
const C = preload("res://generated/game_contract.gd")
const Catalog = preload("res://generated/screens/catalog.gd")
var ui
func _init(screen):
	ui = screen
func _input(event: InputEvent) -> void:
	if not ui.visible:
		return
	if ui.host != null and ui.host.native_proof and not event.has_meta("bilibin_proof"):
		return
	if event is InputEventKey and event.pressed and not event.echo and _hotkey(event):
		ui.get_viewport().set_input_as_handled()
		return
	if event is InputEventKey and (event.keycode in [KEY_ENTER, KEY_KP_ENTER] or
		event.physical_keycode in [KEY_ENTER, KEY_KP_ENTER]):
		var focus: Control = ui.get_viewport().gui_get_focus_owner()
		if focus is Button and ui.is_ancestor_of(focus) and not focus.disabled:
			if event.pressed and not event.echo:
				focus.pressed.emit()
			ui.get_viewport().set_input_as_handled()
			return
	if event is InputEventKey and event.pressed and event.keycode == KEY_ESCAPE:
		ui._close()
		ui.get_viewport().set_input_as_handled()
	elif event is InputEventKey and event.pressed and event.keycode in [KEY_PAGEDOWN, KEY_PAGEUP]:
		_scroll_by(320 if event.keycode == KEY_PAGEDOWN else -320)
		ui.get_viewport().set_input_as_handled()
	elif event is InputEventJoypadMotion and event.axis == JOY_AXIS_RIGHT_Y:
		ui.scroll_axis = event.axis_value
		ui.get_viewport().set_input_as_handled()
	elif event is InputEventJoypadButton and event.pressed:
		match event.button_index:
			JOY_BUTTON_B:
				ui._close()
			JOY_BUTTON_DPAD_UP:
				_navigate(-1)
			JOY_BUTTON_DPAD_DOWN:
				_navigate(1)
			JOY_BUTTON_A:
				var focus: Control = ui.get_viewport().gui_get_focus_owner()
				if focus is Button and ui.is_ancestor_of(focus):
					focus.pressed.emit()
			_:
				return
		ui.get_viewport().set_input_as_handled()
	elif event is InputEventJoypadMotion and event.axis in [JOY_AXIS_LEFT_X, JOY_AXIS_LEFT_Y]:
		if event.axis == JOY_AXIS_LEFT_Y:
			ui.hold.y = event.axis_value
		else:
			ui.hold.x = event.axis_value
		if absf(event.axis_value)<0.45:
			ui.held_time = 0
			ui.repeat_at = 0.35
		else:
			_navigate(1 if event.axis_value>0 else -1)
			ui.held_time = 0
			ui.repeat_at = 0.35
		ui.get_viewport().set_input_as_handled()


func _navigate(step: int) -> void:
	if ui.rail.is_empty():
		return
	var index: int = ui.rail.find(ui.get_viewport().gui_get_focus_owner())
	ui.rail[posmod(index+step, ui.rail.size())].grab_focus()


func _scroll_by(amount: float) -> void:
	var target: ScrollContainer = ui.page_scroll
	if not ui.scroll_targets.is_empty():
		target = ui.scroll_targets[-1]
	var focus: Control = ui.get_viewport().gui_get_focus_owner()
	if focus is ScrollContainer:
		target = focus
	if is_instance_valid(target):
		if target != ui.page_scroll:
			ui.page_scroll.ensure_control_visible(target)
		target.scroll_vertical += roundi(amount)


func _process(delta: float) -> void:
	if not ui.visible:
		return
	if absf(ui.scroll_axis)>0.2:
		_scroll_by(ui.scroll_axis*600*delta)
	if ui.hold.length()<0.45:
		return
	ui.held_time += delta
	if ui.held_time>ui.repeat_at:
		_navigate(1 if ui.hold.x+ui.hold.y>0 else -1)
		ui.repeat_at += 0.12

func _hotkey(event: InputEventKey) -> bool:
	for binding in ui.spec.get("hotkeys", []):
		var key := OS.find_keycode_from_string(binding.key)
		if event.keycode != key and event.physical_keycode != key:
			continue
		var buttons: Array[Button] = []
		for control in ui.rail:
			if control is Button and control.get_meta("focus_id", "") == binding.control:
				buttons.append(control)
		if buttons.is_empty():
			return true
		var index: int = binding.get("index", 0)
		if binding.get("direction", 0) != 0:
			index = 0
			var definition: Dictionary = ui.elements.definition(binding.control, ui.spec.controls)
			var selected: C.ProtoMessage = ui.selected.get(binding.control)
			var identity: String = ui.elements.identity(definition, selected) if selected != null else ""
			for i in range(buttons.size()):
				if buttons[i].get_meta("row_identity", "") == identity:
					index = i
					break
			index = posmod(index + int(binding.direction), buttons.size())
		if index < buttons.size():
			buttons[index].grab_focus()
			buttons[index].pressed.emit()
		return true
	return false
