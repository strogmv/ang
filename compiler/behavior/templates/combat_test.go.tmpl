func TestCombatGuardRequiresInitialCostAndOneRealDeflection(t *testing.T) {
	for _, test := range []struct {
		name string
		ap int
		want bool
	}{{"shortfall", 3, false}, {"exact_deflection", 4, true}} {
		t.Run(test.name, func(t *testing.T) {
			r, space := combatFixtureRules(), combatFixtureSpace()
			r.GuardAP, r.APPerTurn = 2, test.ap
			space.CellMM = 500
			a, b := combatClub("a", "blue", Cell{1, 1}), combatClub("b", "red", Cell{4, 1})
			a.Initiative, b.Initiative, b.Weapon.RangeMM = 30, 10, 1500
			a.WeaponUsesLimited, a.WeaponUsesRemaining = true, 3
			s := combatNewAdvanced(t, r, space, a, b)
			offered := false
			for _, candidate := range s.Decide(space, r).Candidates {
				if candidate.Action.Type == "guard" {
					offered = true
				}
			}
			if offered != test.want {
				t.Fatalf("guard budget option=%v want=%v at AP%d/guard%d", offered, test.want, test.ap, r.GuardAP)
			}
			// The executor permits a manually requested reserve smaller than a
			// deflection. Resolve a real incoming strike to prove why the AI must
			// not value that unaffordable defense, without changing the executor.
			combatDo(t, &s, space, r, "a", CombatAction{Type: "guard"})
			reserved := s.Actor("a").ReservedAP
			combatDo(t, &s, space, r, "b", CombatAction{Type: "attack", TargetID: "a"})
			parries := 0
			for _, event := range s.Events {
				if event.Type == "parry" && event.ActorID == "a" {
					parries++
					if event.AP != r.GuardAP { t.Fatal("deflection changed its real AP cost") }
				}
			}
			if test.want {
				if parries != 1 || reserved != r.GuardAP || s.Actor("a").ReservedAP != 0 || s.Actor("a").WeaponUsesRemaining != 2 {
					t.Fatal("exact budget did not pay for precisely one actual deflection")
				}
			} else if parries != 0 || reserved >= r.GuardAP || s.Actor("a").WeaponUsesRemaining != 3 {
				t.Fatal("insufficient reserve was converted into a free deflection")
			}
		})
	}
}


