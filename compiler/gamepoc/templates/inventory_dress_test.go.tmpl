func TestDressWearPreviewAndTakeOff(t *testing.T) {
	r, c := dressFixture(t)
	boots := dressSupply(t, r, "test.dress.boots", "item.work_boots", r.dressPack(r.state.Inventory))
	before := r.dressEffects(r.state.Inventory, inv.Item{})
	hero := r.state.Life.Actor(playerActorID)
	hero.Sneaking = true
	beforeStep := r.heroStepLoudness(hero, false)
	if beforeStep <= 0 || beforeStep >= 0.9 {
		t.Fatalf("quiet step fixture must exercise an uncapped hearing value, got %g", beforeStep)
	}
	row := r.dressRow(c.locale, boots, before, 0)
	if row.Comparison == "" || len(row.Actions) == 0 || row.Actions[0].Id != "dress_equip" {
		t.Fatalf("missing wearable comparison/action: %v", row)
	}
	with := row.Actions[0]
	if result := dressWire(t, r, c, with.Id, boots); !result.Ok {
		t.Fatal(result.Message)
	}
	worn := r.dressEffects(r.state.Inventory, inv.Item{})
	if worn.mass != with.MassG || worn.noise != int(with.NoisePermille) || worn.visible != before.visible || worn.armor != before.armor ||
		worn.noise != before.noise*r.world.Inventory.Definitions[boots.Definition].StepLoudness/1000 {
		t.Fatalf("effects differ from declared step noise or preview: %+v -> %+v; %v", before, worn, with)
	}
	wantStep := math.Min(1, beforeStep*float64(r.world.Inventory.Definitions[boots.Definition].StepLoudness)/1000)
	if got := r.heroStepLoudness(hero, false); math.Abs(got-wantStep) > 1e-12 {
		t.Fatalf("actual hearing consumer: got %g, want %g", got, wantStep)
	}
	if result := dressWire(t, r, c, "dress_unequip", r.state.Inventory.Items[boots.ID]); !result.Ok {
		t.Fatal(result.Message)
	}
	got := r.dressEffects(r.state.Inventory, inv.Item{})
	if got != before {
		t.Fatalf("taking off changed unrelated effects: %+v vs %+v", got, before)
	}
	if got := r.heroStepLoudness(hero, false); math.Abs(got-beforeStep) > 1e-12 {
		t.Fatalf("taking off did not restore actual hearing: got %g, want %g", got, beforeStep)
	}
}

