  }
  bool CombatFinalDown(string id){if(id=="char.hero")return state.PlayerCondition!=null&&(state.PlayerCondition.Down||state.PlayerCondition.Stance=="prone");foreach(var a in state.SceneAgents)if(a.Id==id)return a.Activity=="down";return false;}
  string CombatModeOf(PocCombatEvent e){
