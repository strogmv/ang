func cartTestRuntime(t *testing.T) (*Runtime, *behavior.LifeActor, cartBay) {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	c := &connection{out: make(chan *pb.ServerMessage, 64), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "cart.new", Scenario: "life", Seed: 777}}}})
	hero := r.state.Life.Actor(playerActorID)
	r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1, X: int32(hero.Position.X), Y: int32(hero.Position.Y)})
	if !hero.Manual {
		t.Fatal("ordinary hero control failed")
	}
	if r.world.CartParking == nil {
		t.Skip("world has no cart parking")
	}
	if !r.world.Life.Brain.Enabled {
		t.Fatal("test requires the actual utility brain")
	}
	return r, r.state.Life.Actor(r.world.CartParking.OwnerActorID), r.world.CartParking.Bays[0]
}
func cartAdvanceNS(r *Runtime, seconds int64) { r.state.Tick += seconds * int64(r.world.Config.TickHz) }
func TestCartParkingAuthorityReleaseRetrieveAndClone(t *testing.T) {
	r, a, b := cartTestRuntime(t)
	cfg := r.world.CartParking
	inventory := r.state.Inventory.Clone()
	a.Level = cfg.LevelID
	a.Trip = nil
	a.ResidenceID = ""
	a.Manual = false
	a.Path = nil
	a.PendingPath = nil
	a.Position = b.PreHandle
	a.Brain.Place = behavior.LifeAffordance{ID: b.PlaceID, Kind: "seated_food"}
	wanted := behavior.LifeStep{Level: a.Level, At: behavior.Cell{X: 81, Y: 63}, Activity: "eat", Label: "life.npc.seated_food"}
	a.Brain.Target = wanted
	step, on := r.cartRouteDetour(a, wanted)
	if !on || step.At != b.Handle {
		t.Fatal("park must approach handle before seat")
	}
	if r.cartServiceReady(a.ID) || r.cartTradeReady(a.ID) {
		t.Fatal("approach cannot trade or start inside service")
	}
	a.Position = b.Handle
	step, on = r.cartRouteDetour(a, wanted)
	s := r.state.Peddlers.Carts[cfg.CartID]
	if on || step != wanted || s.Phase != "parked" || s.Pose != b.Pose || s.Motion.StartNS != s.Motion.EndNS || s.ParkCount != 1 {
		t.Fatal("an already aligned cart must detach once without a fictitious movement wait")
	}
	clone := r.state.Peddlers.clone()
	v := clone.Carts[cfg.CartID]
	v.Phase = "pickup"
	clone.Carts[cfg.CartID] = v
	if r.state.Peddlers.Carts[cfg.CartID].Phase != "parked" {
		t.Fatal("cart clone aliases save")
	}
	before := r.state.Peddlers.Carts[cfg.CartID]
	for i := 0; i < 8; i++ {
		r.cartRouteDetour(a, wanted)
	}
	if !reflect.DeepEqual(before, r.state.Peddlers.Carts[cfg.CartID]) {
		t.Fatal("polling duplicated the zero-displacement handoff")
	}
	if !r.cartServiceReady(a.ID) || r.cartTradeReady(a.ID) {
		t.Fatal("parked owner should resume service, cart sales closed")
	}
	a.Position = behavior.Cell{X: 81, Y: 63}
	r.cartRouteDetour(a, wanted)
	if r.state.Peddlers.Carts[cfg.CartID].Pose != b.Pose {
		t.Fatal("cart followed seated owner")
	}
	a.Brain.Place = behavior.LifeAffordance{}
	wanted = behavior.LifeStep{Level: "level.poc_housing", At: behavior.Cell{X: 12, Y: 12}, Activity: "sleep", Label: "home"}
	step, on = r.cartRouteDetour(a, wanted)
	if !on || step.Level != cfg.LevelID || step.At != b.PreHandle {
		t.Fatal("night departure must collect cart through ordinary route")
	}
	a.Position = b.PreHandle
	r.cartRouteDetour(a, wanted)
	a.Position = b.Handle
	r.cartRouteDetour(a, wanted)
	if r.state.Peddlers.Carts[cfg.CartID].Phase != "pickup" {
		t.Fatal("pickup missing")
	}
	cartAdvanceNS(r, 2)
	r.cartRouteDetour(a, wanted)
	s = r.state.Peddlers.Carts[cfg.CartID]
	if s.Phase != "turning" || !s.Motion.Arc || len(a.RouteFootprint) == 0 {
		t.Fatal("pickup must reserve and execute its physical turn before walking")
	}
	cartAdvanceNS(r, 2)
	r.cartRouteDetour(a, wanted)
	s = r.state.Peddlers.Carts[cfg.CartID]
	if s.Phase != "handoff" || len(a.Path) != 1 || a.Path[0] != s.ExitCell {
		t.Fatal("turn must hand off its verified ordinary first step")
	}
	a.Position = s.ExitCell
	a.Path = nil
	r.cartRouteDetour(a, wanted)
	s = r.state.Peddlers.Carts[cfg.CartID]
	if s.Phase != "attached" || s.ParkCount != 1 || s.PickupCount != 1 || !r.cartTradeReady(a.ID) {
		t.Fatal("same cart did not reattach once")
	}
	if !reflect.DeepEqual(inventory, r.state.Inventory) {
		t.Fatal("parking mutated inventory, account or item IDs")
	}
}
