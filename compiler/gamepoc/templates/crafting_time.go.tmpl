// ---------------------------------------------------------------- time
func (r *Runtime) advanceCrafting(delta int64) error {
	if !r.craftingOn() || delta <= 0 {
		return nil
	}
	// stage 2: the law (reports, cases, the raid, the danger of a hacked gun) and the market (restock, residents)
	r.advanceCraftingLaw()
	r.advanceCraftingMarket()
	if len(r.state.Crafting.Jobs) == 0 {
		return nil
	}
	m := r.world.Crafting
	hero := r.craftingHero()
	first := map[string]bool{}
	finished := []string{}
	for k := range r.state.Crafting.Jobs {
		j := &r.state.Crafting.Jobs[k]
		if j.Done {
			continue
		}
		working := false
		if j.Client == "" {
			working = j.Plan.Unattended || j.Plan.Station == ""
			if !working && hero != nil {
				b := r.craftingBench(hero)
				working = b.Station == j.Plan.Station && b.Present
			}
		} else if !first[j.Worker] {
			first[j.Worker] = true
			if ms, ok := m.Master(j.Worker); ok {
				working = r.storefrontOpen(ms.Shop)
			}
		}
		if working {
			j.Progress = min(j.Plan.Seconds, j.Progress+delta)
		}
		if j.Progress >= j.Plan.Seconds {
			finished = append(finished, j.ID)
		}
	}
	for _, id := range finished {
		if k := r.craftingJobIndex(id); k >= 0 {
			r.craftingFinish(k)
		}
	}
	return nil
}

// craftingFinish ends a job in one transform. If the hero's hands cannot take the result (capacity), it is put on the
// floor under the hero; if even that fails the job waits finished and is retried next frame.
func (r *Runtime) craftingFinish(k int) {
	m := r.world.Crafting
	j := r.state.Crafting.Jobs[k]
	if j.Plan.Kind == "study" || j.Plan.Kind == "apprentice" {
		r.craftingLearnFinish(k)
		return
	}
	rec, _ := m.Recipe(j.Plan.Recipe)
	order := j.Client != ""
	// stage 2: a master's job for himself (salvage of a bought thing) and a resident's order end without a collect
	self := order && j.Client == j.Worker
	npc := order && !self && j.Client != m.Hero.Actor
	now := r.state.Life.Seconds
	build := func(to inv.Location) (inv.Transform, []string) {
		t := inv.Transform{}
		results := []string{}
		resultTo := to
		owner := playerActorID
		if order {
			resultTo = inv.Location{Kind: "store", Store: j.Store}
		}
		if self {
			ms, _ := m.Master(j.Worker)
			resultTo, owner = inv.Location{Kind: "store", Store: ms.Stores[len(ms.Stores)-1]}, j.Worker
		}
		if npc {
			resultTo, owner = inv.Location{Kind: "store", Store: inv.ActorStore(j.Client)}, j.Client
		}
		var masterBack *inv.Location
		if order {
			ms, _ := m.Master(j.Worker)
			back := inv.Location{Kind: "store", Store: ms.Stores[len(ms.Stores)-1]}
			masterBack = &back
		}
		p := j.Plan
		if p.Outcome == "success" {
			for _, u := range p.Uses {
				t.Spend = append(t.Spend, inv.Spend{Item: u.Stack, Quantity: u.Quantity})
			}
		} else {
			t.Relocate = append(t.Relocate, r.craftingReturn(crafting.Job{Store: j.Store, Worker: j.Worker, Plan: crafting.Plan{Uses: p.Uses}}, resultTo, masterBack)...)
			for _, u := range p.Spoil {
				t.Spend = append(t.Spend, inv.Spend{Item: u.Stack, Quantity: u.Quantity})
			}
		}
		if p.Target != "" {
			if p.Kind == "disassemble" {
				t.Spend = append(t.Spend, inv.Spend{Item: p.Target, Quantity: 1})
			} else {
				t.Restore = append(t.Restore, inv.Restore{Item: p.Target, Condition: p.Condition})
				if !order || npc {
					t.Relocate = append(t.Relocate, inv.Relocate{Item: p.Target, Quantity: 1, To: resultTo})
				}
				results = append(results, p.Target)
			}
		}
		for n, mk := range p.Makes {
			id := fmt.Sprintf("instance:craft:%s:out:%d", j.ID, n)
			t.Make = append(t.Make, inv.Make{ID: id, Definition: mk.Definition, Quantity: mk.Quantity, Condition: mk.Condition, Owner: owner, Origin: "crafting:" + j.ID, Location: resultTo, Grade: inv.Grade{Quality: mk.Quality, Provenance: mk.Origin}})
			results = append(results, id)
		}
		if order && p.Outcome != "success" && j.PaidMinor > 0 {
			ms, _ := m.Master(j.Worker)
			if acc, ok := r.craftingAccount(j.Client); ok {
				t.Payments = append(t.Payments, r.craftingPayment(ms.Account, acc.ID, j.PaidMinor))
			}
		}
		return t, results
	}
	hands := inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}
	t, results := build(hands)
	model := r.inventoryModelFor(true)
	if _, err := r.state.Inventory.Transform(model, t); err != nil {
		hero := r.state.Life.Actor(playerActorID)
		if order || hero == nil {
			return
		}
		t, results = build(inv.Location{Kind: "ground", Level: hero.Level, At: inv.Cell{X: hero.Position.X, Y: hero.Position.Y}})
		if _, err := r.state.Inventory.Transform(model, t); err != nil {
			return
		}
	}
	a := r.state.Crafting.Actors[j.Worker]
	m.Award(&a, rec.Discipline, j.Plan)
	// stage 2: the first build from a flawed copy shows the error
	flawShown := j.Plan.Flaw != "" && !a.Revealed[rec.ID]
	if flawShown {
		if a.Revealed == nil {
			a.Revealed = map[string]bool{}
		}
		a.Revealed[rec.ID] = true
	}
	r.state.Crafting.Actors[j.Worker] = a
	if j.Worker == m.Hero.Actor && rec.Legal == "legal" && j.Plan.Outcome == "success" {
		r.state.Crafting.Law.Trust = min(1000, r.state.Crafting.Law.Trust+m.Law.Trust.GainLegalJob)
	}
	if rec.Kind == "bypass" && j.Plan.Outcome == "success" && j.Plan.Target != "" {
		r.craftingHacked(j.Plan.Target)
	}
	// stage 2: a swap of the master stays in the thing (found on inspection) and in the journal of an heirloom
	if j.Swap.Class != "" && len(results) > 0 {
		if r.state.Crafting.Market.Swaps == nil {
			r.state.Crafting.Market.Swaps = map[string]crafting.Swap{}
		}
		r.state.Crafting.Market.Swaps[results[0]] = j.Swap
	}
	if rec.Heirloom && j.Plan.Target != "" {
		if r.state.Crafting.Journal == nil {
			r.state.Crafting.Journal = map[string][]crafting.Entry{}
		}
		r.state.Crafting.Journal[j.Plan.Target] = append(r.state.Crafting.Journal[j.Plan.Target], crafting.Entry{Second: now, Worker: j.Worker, Recipe: rec.ID, Outcome: j.Plan.Outcome, Quality: j.Plan.Quality, Condition: j.Plan.Condition, Swap: j.Swap.Class})
	}
	notice := crafting.Notice{Key: "crafting.notice." + j.Plan.Outcome, Recipe: rec.ID, Outcome: j.Plan.Outcome, Second: now}
	if j.Plan.Learn != "" {
		notice = crafting.Notice{Key: "crafting.notice.learned", Recipe: j.Plan.Learn, Outcome: j.Plan.Outcome, Second: now}
	}
	if flawShown {
		notice = crafting.Notice{Key: "crafting.notice.flaw", Recipe: rec.ID, Outcome: j.Plan.Outcome, Second: now}
	}
	if npc || self {
		// a resident's thing went home, a master's salvage into his box: nothing waits at the counter
		r.craftingRemove(k)
		return
	}
	if order {
		notice.Key = "crafting.notice.ready"
		if j.Plan.Outcome != "success" {
			notice.Key = "crafting.notice.refund"
		}
		job := &r.state.Crafting.Jobs[k]
		job.Done, job.Results, job.Refunded = true, results, j.Plan.Outcome != "success" && j.PaidMinor > 0
		if len(results) == 0 {
			r.craftingRemove(k)
		}
	} else {
		r.craftingRemove(k)
	}
	r.state.Crafting.Notice = notice
}

// craftingSellerWork: a master working an order at the open stall shows the kit's work action (Matvey solders); the
// action began when the order did, so the clip phase is stable across saves.
func (r *Runtime) craftingSellerWork(actor string) (string, int64, bool) {
	if !r.craftingOn() {
		return "", 0, false
	}
	ms, ok := r.world.Crafting.Master(actor)
	if !ok || ms.WorkAction == "" {
		return "", 0, false
	}
	for _, j := range r.state.Crafting.Jobs {
		if j.Worker == actor && !j.Done {
			return ms.WorkAction, r.state.Life.Seconds - j.Progress, true
		}
	}
	return "", 0, false
}

// ---------------------------------------------------------------- save
func (r *Runtime) validateCraftingSave(s state) error {
	m := r.world.Crafting
	if m.Hero.Actor == "" {
		return nil
	}
	if err := m.ValidateState(s.Crafting); err != nil {
		return err
	}
	held := map[string]string{}
	for _, j := range s.Crafting.Jobs {
		if j.Plan.Kind == "study" || j.Plan.Kind == "apprentice" {
			continue // a lesson holds no things (the carrier stays in the hero's hands)
		}
		ids := append([]string(nil), j.Results...)
		if !j.Done {
			if j.Plan.Target != "" {
				ids = append(ids, j.Plan.Target)
			}
			for _, u := range j.Plan.Uses {
				ids = append(ids, u.Stack)
			}
		}
		for _, id := range ids {
			i, ok := s.Inventory.Items[id]
			if !ok || i.Location.Kind != "store" || i.Location.Store != j.Store {
				return fmt.Errorf("crafting job %s: held item %s is not in %s", j.ID, id, j.Store)
			}
			held[id] = j.ID
		}
	}
	stores := map[string]bool{m.Hero.WorkStore: true}
	for _, ms := range m.Masters {
		stores[ms.OrderStore] = true
	}
	// (a master's working stock box, Stores[2], holds free parts and is not checked here)
	for id, i := range s.Inventory.Items {
		if i.Location.Kind == "store" && stores[i.Location.Store] && held[id] == "" {
			return fmt.Errorf("crafting: %s lies in %s without a job", id, i.Location.Store)
		}
	}
	return nil
}
