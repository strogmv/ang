package scheduler

import (
	"context"
	"fmt"
	"os"
	"strings"
	"time"
	_ "time/tzdata"

	{{- if .HasPublish }}
	"{{GoModule}}/internal/domain"
	{{- end }}
	"{{GoModule}}/internal/pkg/logger"
	"{{GoModule}}/internal/port"
)

type Schedule struct {
	Name    string
	Service string
	Action  string
	At      time.Time
	Publish string
	Every   time.Duration
	Payload map[string]any
	{{- if .HasCron }}
	// Cron, when set, fires the schedule at every minute it matches, in
	// SCHEDULER_TIMEZONE; At and Every are then unused.
	Cron *CronSpec
	{{- end }}
}

type Scheduler struct {
	Publisher port.Publisher
	Schedules []Schedule
}

func New(publisher port.Publisher, schedules []Schedule) *Scheduler {
	return &Scheduler{Publisher: publisher, Schedules: schedules}
}

func (s *Scheduler) Start(ctx context.Context) {
	for _, sc := range s.Schedules {
		sc := sc
		{{- if .HasCron }}
		if sc.Cron != nil {
			go s.runCron(ctx, sc)
			continue
		}
		{{- end }}
		go func() {
			if sc.Every > 0 {
				if !sc.At.IsZero() {
					sleep := time.Until(sc.At)
					if sleep > 0 {
						timer := time.NewTimer(sleep)
						select {
						case <-ctx.Done():
							timer.Stop()
							return
						case <-timer.C:
						}
					}
				}
				ticker := time.NewTicker(sc.Every)
				defer ticker.Stop()
				for {
				if s.Publisher != nil && sc.Publish != "" {
					if err := safePublish(s.Publisher, sc); err != nil {
						fmt.Println("scheduler publish error:", err)
					}
				}
					select {
					case <-ctx.Done():
						return
					case <-ticker.C:
					}
				}
			}
			sleep := time.Until(sc.At)
			if sleep > 0 {
				timer := time.NewTimer(sleep)
				select {
				case <-ctx.Done():
					timer.Stop()
					return
				case <-timer.C:
				}
			}
			if s.Publisher != nil && sc.Publish != "" {
				if err := safePublish(s.Publisher, sc); err != nil {
					fmt.Println("scheduler publish error:", err)
				}
			}
		}()
	}
}

var DefaultSchedules = []Schedule{
{{- range .Schedules }}
	{
		Name: "{{ .Name }}",
		Service: "{{ .Service }}",
		Action: "{{ .Action }}",
		At: mustParseTime("{{ .At }}"),
		Publish: "{{ .Publish }}",
		Every: mustParseDuration("{{ .Every }}"),
		{{- if .Cron }}
		Cron: mustParseCron("{{ .Cron }}"),
		{{- end }}
		{{- if .Payload }}
		Payload: map[string]any{
			{{- range .Payload }}
			"{{ .Name }}": {{ if eq .Type "string" }}{{ printf "%q" .Value }}{{ else if .Value }}{{ .Value }}{{ else }}nil{{ end }},
			{{- end }}
		},
		{{- end }}
	},
{{- end }}
}

{{ if .HasCron }}// runCron publishes the schedule at each time its cron expression matches.
func (s *Scheduler) runCron(ctx context.Context, sc Schedule) {
	location := schedulerLocation()
	for {
		next := sc.Cron.Next(time.Now().In(location))
		if next.IsZero() {
			return
		}
		timer := time.NewTimer(time.Until(next))
		select {
		case <-ctx.Done():
			timer.Stop()
			return
		case <-timer.C:
		}
		if s.Publisher != nil && sc.Publish != "" {
			if err := safePublish(s.Publisher, sc); err != nil {
				fmt.Println("scheduler publish error:", err)
			}
		}
	}
}

func mustParseCron(v string) *CronSpec {
	spec, err := ParseCron(v)
	if err != nil {
		panic(fmt.Sprintf("scheduler: cron %q: %v", v, err))
	}
	return spec
}

{{ end }}func mustParseTime(v string) time.Time {
	if v == "" {
		return time.Time{}
	}
	t, err := time.Parse(time.RFC3339, v)
	if err == nil {
		return t
	}
	clock, err := time.Parse("15:04", v)
	if err != nil {
		return time.Time{}
	}
	now := time.Now().In(schedulerLocation())
	next := time.Date(now.Year(), now.Month(), now.Day(), clock.Hour(), clock.Minute(), 0, 0, now.Location())
	if !next.After(now) {
		next = next.Add(24 * time.Hour)
	}
	return next
}

func schedulerLocation() *time.Location {
	name := strings.TrimSpace(os.Getenv("SCHEDULER_TIMEZONE"))
	if name == "" {
		return time.UTC
	}
	location, err := time.LoadLocation(name)
	if err != nil {
		fmt.Printf("scheduler invalid timezone %q, using UTC: %v\n", name, err)
		return time.UTC
	}
	return location
}

func mustParseDuration(v string) time.Duration {
	if v == "" {
		return 0
	}
	d, err := time.ParseDuration(v)
	if err != nil {
		return 0
	}
	return d
}

func publishEvent(publisher port.Publisher, sc Schedule) error {
	if publisher == nil || sc.Publish == "" {
		return nil
	}
	switch sc.Publish {
	{{- range .Schedules }}
	{{- if .Publish }}
	case "{{ .Publish }}":
		var ev domain.{{ ExportName .Publish }}
		{{- range .Payload }}
		ev.{{ .Name | ExportName }} = {{ if eq .Type "string" }}{{ printf "%q" .Value }}{{ else if .Value }}{{ .Value }}{{ else }}0{{ end }}
		{{- end }}
		return publisher.Publish{{ ExportName .Publish }}(context.Background(), ev)
	{{- end }}
	{{- end }}
	default:
		return nil
	}
}

// safePublish publishes one tick; a panic becomes an error, so one bad tick
// neither ends the process nor stops the schedule.
func safePublish(publisher port.Publisher, sc Schedule) (err error) {
	defer func() {
		if r := recover(); r != nil {
			err = logger.PanicError("scheduler", sc.Name, r)
		}
	}()
	return publishEvent(publisher, sc)
}
