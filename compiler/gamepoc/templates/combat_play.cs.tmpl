  Vector3 CombatBloodDir(Vector3 normal,LocationSDKHumanoid victim,string attacker){var toCam=locationSDKCamera!=null?-locationSDKCamera.transform.forward:Vector3.back;toCam.y=0;toCam.Normalize();return (normal*.45f+toCam*.75f).normalized;}
  Transform CombatNearestBone(LocationSDKHumanoid h,Vector3 p){Transform best=null;float bd=float.MaxValue;foreach(var b in new[]{HumanBodyBones.Hips,HumanBodyBones.Spine,HumanBodyBones.Chest,HumanBodyBones.UpperChest,HumanBodyBones.Neck,HumanBodyBones.Head,HumanBodyBones.LeftUpperArm,HumanBodyBones.RightUpperArm}){var t=h.animator.GetBoneTransform(b);if(t==null)continue;float d=(t.position-p).sqrMagnitude;if(d<bd){bd=d;best=t;}}return best;}
  void CombatDroplets(Vector3 at,Vector3 normal,PocCombatBloodSign s,int n,System.Random rng,float floorY){
   for(int i=0;i<n;i++){Vector3 r=new Vector3((float)rng.NextDouble()-.5f,(float)rng.NextDouble()-.5f,(float)rng.NextDouble()-.5f)*2*s.spread;float sp=s.speed*(.55f+.45f*(float)rng.NextDouble());var v=(normal+r+Vector3.up*.2f).normalized*sp;float size=s.droplet_m*(.7f+.6f*(float)rng.NextDouble());var go=CombatBloodPiece("droplet",at,Quaternion.identity,Vector3.one*size);combatDrops.Add(new CombatDrop{t=go.transform,v=v,size=size,floorY=floorY});}
  }
  void CombatBloodTick(PocCombatLook look){
   if(look==null||look.blood==null)return;float dt=CombatDt,g=look.blood.gravity;
   for(int i=combatDrops.Count-1;i>=0;i--){var d=combatDrops[i];if(d.t==null){combatDrops.RemoveAt(i);continue;}d.v+=Vector3.down*g*dt;var p=d.t.position+d.v*dt;if(p.y<=d.floorY+.003f){p.y=d.floorY+.003f;d.t.position=p;d.t.rotation=Quaternion.identity;d.t.localScale=new Vector3(d.size*1.8f,.002f,d.size*1.8f);combatDrops.RemoveAt(i);continue;}d.t.position=p;if(d.v.sqrMagnitude>.01f)d.t.rotation=Quaternion.LookRotation(d.v);float stretch=Mathf.Clamp(1+d.v.magnitude*.3f,1,1.9f);d.t.localScale=new Vector3(d.size,d.size,d.size*stretch);}
   foreach(var b in combatBleeds){float age=CombatNow-b.at;if(b.stain!=null){float k=CombatSmooth(age/Mathf.Max(.05f,look.blood.stain_grow_s));float size=Mathf.Lerp(b.stainSize*.35f,b.stainSize,k);var ls=b.stain.parent!=null?b.stain.parent.lossyScale:Vector3.one;float u=size*b.stainScale/Mathf.Max(.001f,ls.x);b.stain.localScale=new Vector3(u,u*1.5f,u*.12f);}
    if(b.pool!=null){float k=Mathf.Clamp01(age/Mathf.Max(.1f,b.sign.pool_grow_s));float sq=Mathf.Sqrt(k);b.pool.localScale=new Vector3(b.poolSize*sq,.002f,b.poolSize*sq*.9f);}
    if(b.pulsesLeft>0&&CombatNow>=b.nextPulse){b.pulsesLeft--;b.nextPulse=CombatNow+b.sign.pulse_s;Vector3 p,n;if(b.body!=null&&b.body.go!=null&&CombatZonePoint(b.body,look,b.zone,b.side,out p,out n))CombatDroplets(p,b.normal,b.sign,b.sign.pulse_droplets,b.rng,b.body.go.transform.position.y);}
   }
  }
  // Review log (autoplay only): what the contact frame really was.
  internal readonly List<string> combatM1Rows=new List<string>(),combatM1Sounds=new List<string>();internal float combatM1LastContact=-1;
  static float M1Yaw(Vector3 a,Vector3 toTarget){a.y=0;toTarget.y=0;if(a.sqrMagnitude<1e-6f||toTarget.sqrMagnitude<1e-6f)return -1;return Vector3.Angle(a,toTarget);}
  void CombatM1Contact(CombatBeat b,LocationSDKHumanoid a,LocationSDKHumanoid v,Transform hand,Transform tip,Vector3 point,float w,Transform hips){
   combatM1LastContact=CombatNow;if(combatAutoDir==null)return;
   var to=v.go.transform.position-a.go.transform.position;var ls=a.animator.GetBoneTransform(HumanBodyBones.LeftUpperLeg).position;var rs=a.animator.GetBoneTransform(HumanBodyBones.RightUpperLeg).position;var la=a.animator.GetBoneTransform(HumanBodyBones.LeftUpperArm).position;var ra=a.animator.GetBoneTransform(HumanBodyBones.RightUpperArm).position;
   var pelvis=Vector3.Cross((rs-ls).normalized,Vector3.up);var chest=Vector3.Cross((ra-la).normalized,Vector3.up);var f=hips.position-beat0(b);var flat=to;flat.y=0;flat.Normalize();
   var lf=a.animator.GetBoneTransform(HumanBodyBones.LeftFoot).position;var rf=a.animator.GetBoneTransform(HumanBodyBones.RightFoot).position;
   string outcome=b.hit?"hit":b.parried?"parried":"miss";
   combatM1Rows.Add("{\"dsp\":"+AudioSettings.dspTime.ToString("R",System.Globalization.CultureInfo.InvariantCulture)+",\"t\":"+CombatF(CombatAutoTime)+",\"clock\":"+CombatF(CombatNow)+",\"frame\":"+Time.frameCount+",\"actor\":"+CombatJ(b.actor)+",\"target\":"+CombatJ(b.target)+",\"outcome\":"+CombatJ(outcome)+",\"mode\":"+CombatJ(b.mode)+",\"zone\":"+CombatJ(b.zone)+",\"side\":"+CombatJ(b.side)+",\"sign\":"+CombatJ(b.sign)+",\"clip\":"+CombatJ(b.clip==null?"":b.clip.state)+",\"reaction\":"+CombatJ(b.reaction==null?"":b.reaction.state)+",\"ik_weight\":"+CombatF(w)+",\"tip_to_point_m\":"+CombatF(Vector3.Distance(tip.position,point))+",\"tip_to_skin_m\":"+CombatF(CombatSkinGap(v,tip.position))+",\"pelvis_deg\":"+CombatF(M1Yaw(pelvis,to))+",\"shoulders_deg\":"+CombatF(M1Yaw(chest,to))+",\"root_deg\":"+CombatF(M1Yaw(a.go.transform.forward,to))+",\"hips_travel_m\":"+CombatF(Vector3.Dot(f,flat))+",\"tip_travel_m\":"+CombatF(Vector3.Dot(tip.position-b.tip0,flat))+",\"body_gap_m\":"+CombatF(M1BodyGap(a,v))+",\"feet_m\":"+CombatF(to.magnitude)+",\"lf\":["+CombatF(lf.x)+","+CombatF(lf.y)+","+CombatF(lf.z)+"],\"rf\":["+CombatF(rf.x)+","+CombatF(rf.y)+","+CombatF(rf.z)+"]}");
  }
  float M1BodyGap(LocationSDKHumanoid a,LocationSDKHumanoid v){float best=float.PositiveInfinity;foreach(var b in new[]{HumanBodyBones.Head,HumanBodyBones.Chest,HumanBodyBones.LeftHand,HumanBodyBones.RightHand,HumanBodyBones.RightLowerArm,HumanBodyBones.LeftLowerArm,HumanBodyBones.LeftUpperLeg,HumanBodyBones.LeftLowerLeg,HumanBodyBones.LeftFoot,HumanBodyBones.RightFoot}){var t=a.animator.GetBoneTransform(b);if(t!=null)best=Mathf.Min(best,CombatSkinGap(v,t.position));}return best;}
  static Vector3 beat0(CombatBeat b){return b.hips0;}
