// The cooldown survives a real save and load: the loaded game does not say the same line again before its cooldown.
func TestBarksCooldownSurvivesSave(t *testing.T) {
	r := barksFixture(t)
	barkYataiEvening(t, r)
	var first barks.Speech
	for i := 0; i < 4000 && first.Line == ""; i++ {
		for _, sp := range barkRun(r, 1) {
			if sp.Kind == "line" {
				first = sp
			}
		}
	}
	if first.Line == "" {
		t.Fatal("no yatai line to save")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(loaded.Barks.Lines, r.state.Barks.Lines) || loaded.Barks.Serial != r.state.Barks.Serial {
		t.Fatal("the save lost the barks clocks")
	}
	r.state = loaded
	line, _, _ := barkCatalog.Line(first.Line)
	until := first.Second + line.CooldownSeconds
	for _, sp := range barkRun(r, int(until-r.state.Life.Seconds)-1) {
		if sp.Line == first.Line {
			t.Fatalf("the loaded game repeated %s before its cooldown", first.Line)
		}
	}
}

// Determinism: two games with the same seed and the same people say the same lines at the same ticks.
func TestBarksDeterminism(t *testing.T) {
	a, b := barksFixture(t), barksFixture(t)
	barkYataiEvening(t, a)
	barkYataiEvening(t, b)
	x, y := barkRun(a, 3000), barkRun(b, 3000)
	if len(x) == 0 || !reflect.DeepEqual(x, y) {
		t.Fatalf("the same seed gave different lines (%d vs %d)", len(x), len(y))
	}
}

// A line plays only with its facts, at its place, in its period, heard by the hero — checked on every line a day of the
// real Life world says (people walk their routines, gates lock, shops close).
func TestBarksInvariantsOnALifeDay(t *testing.T) {
	r := barksFixture(t)
	r.state.Life.SecondsPerTick = 10
	seen := uint64(0)
	spoken := 0
	for tick := 0; tick < 8640; tick++ {
		r.step()
		f, ok := r.barkFrame()
		if !ok {
			continue
		}
		byID := map[string]barks.Actor{}
		for _, a := range f.Actors {
			byID[a.ID] = a
		}
		holds := map[string]bool{}
		for _, fact := range f.Facts {
			holds[fact.Event] = true
		}
		for _, sp := range r.state.Barks.Active {
			if sp.Serial <= seen || sp.Kind != "line" {
				continue
			}
			spoken++
			l, pack, _ := barkCatalog.Line(sp.Line)
			a, here := byID[sp.Speaker]
			place, _ := barkCatalog.Place(pack.Place)
			if !here || !place.Has(a.Level, a.At) {
				t.Fatalf("%s spoken by %s away from %s", sp.Line, sp.Speaker, pack.Place)
			}
			if face, _ := barkCatalog.Face(l.Caste); !face.Speaks {
				t.Fatalf("a silent caste spoke: %s", sp.Line)
			}
			for _, react := range l.React {
				if react.Negate == holds[react.Event] {
					t.Fatalf("%s spoken without its fact %s", sp.Line, react.Event)
				}
			}
			dx, dy := a.At.X-f.Hero.At.X, a.At.Y-f.Hero.At.Y
			if dx*dx+dy*dy > pack.HeroWithinCells*pack.HeroWithinCells {
				t.Fatalf("%s spoken out of the hero's hearing", sp.Line)
			}
		}
		for _, sp := range r.state.Barks.Active {
			seen = max(seen, sp.Serial)
		}
		if n := len(r.state.Barks.Visible(r.state.Tick)); n > barkCatalog.MaxActive+1 {
			t.Fatalf("%d lines at once", n)
		}
	}
	t.Logf("a Life day: %d lines", spoken)
}

// Silent castes never own a line (owner 02.11: gold and platinum are silent in act one).
