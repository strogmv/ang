func (pp *{{ .StructName }}) checkStatusBackoff(opKind string, attempt int) time.Duration {
	if attempt < 1 {
		attempt = 1
	}
	base := time.Duration(0)
{{- if .UseOperationRuntime }}
	if op, ok := operationTransports[opKind]; ok && op.RetryInitialBackoff != "" {
		if d, err := time.ParseDuration(op.RetryInitialBackoff); err == nil {
			base = d
		}
	}
{{- else }}
	_ = opKind
{{- end }}
	if base <= 0 {
{{- if and .RuntimePolicyConfig .RuntimePolicyConfig.Retries .RuntimePolicyConfig.Retries.InitialBackoff }}
		if d, err := time.ParseDuration("{{ .RuntimePolicyConfig.Retries.InitialBackoff }}"); err == nil {
			base = d
		}
{{- end }}
	}
	if base <= 0 {
		return 0
	}
	// Exponential backoff capped by max_backoff when configured.
	backoff := base << (attempt - 1)
	maxBackoff := ""
{{- if .UseOperationRuntime }}
	if op, ok := operationTransports[opKind]; ok && op.RetryMaxBackoff != "" {
		maxBackoff = op.RetryMaxBackoff
	}
{{- end }}
	if maxBackoff == "" {
{{- if and .RuntimePolicyConfig .RuntimePolicyConfig.Retries .RuntimePolicyConfig.Retries.MaxBackoff }}
		maxBackoff = "{{ .RuntimePolicyConfig.Retries.MaxBackoff }}"
{{- end }}
	}
	if maxBackoff != "" {
		if maxD, err := time.ParseDuration(maxBackoff); err == nil && maxD > 0 && backoff > maxD {
			backoff = maxD
		}
	}
	return backoff
}

func (pp *{{ .StructName }}) shouldRetryCheckStatus(opKind string, err error, attempt int) bool {
	if attempt >= pp.checkStatusMaxAttempts(opKind) {
		return false
	}
{{- if and .RuntimePolicyConfig .RuntimePolicyConfig.Retries .RuntimePolicyConfig.Retries.RetryOnNotFound }}
	if {{ .RuntimePolicyConfig.Retries.RetryOnNotFound }} && httpcli.IsNotFoundError(err) {
		return true
	}
{{- end }}
{{- if and .RuntimePolicyConfig .RuntimePolicyConfig.Retries .RuntimePolicyConfig.Retries.RetryOn5xx }}
	if {{ .RuntimePolicyConfig.Retries.RetryOn5xx }} && httpcli.IsUnexpectedError(err) {
		return true
	}
{{- end }}
{{- if and .RuntimePolicyConfig .RuntimePolicyConfig.Retries .RuntimePolicyConfig.Retries.RetryOnRateLimit }}
	if {{ .RuntimePolicyConfig.Retries.RetryOnRateLimit }} && isRateLimitedError(err) {
		return true
	}
{{- end }}
	return false
}

