func TestWeaponInBagIsHiddenUntilActuallyEquipped(t *testing.T){
 r:=equipmentFixture(t);id:="";for key,i:=range r.state.Inventory.Items{if i.Definition=="item.security_stunner"{id=key;break}}
 // Authorized world setup supplies a real item, not an observation boolean.
