// Code generated by ANG. Finite physical ammunition packs and their empty carriers.
package poc

import (
	"errors"
	"fmt"
	"sort"

	inv "angelsdemons/server/internal/inventory"
)

type combatAmmoPack struct {
	AmmoDefinition  string `json:"ammo_definition"`
	Rounds          int    `json:"rounds"`
	EmptyDefinition string `json:"empty_definition"`
}

func (c combatCatalog) validateAmmoPacks(m inv.Model) error {
	keys := make([]string, 0, len(c.AmmoPacks))
	for id := range c.AmmoPacks {
		keys = append(keys, id)
	}
	sort.Strings(keys)
	physical := func(id string) (inv.Definition, bool) {
		d, ok := m.Definitions[id]
		return d, ok && d.Carrier == "physical" && d.ContainerVolume == 0 && d.Currency == "" && d.Mass > 0 && d.Volume > 0
	}
	for _, id := range keys {
		p := c.AmmoPacks[id]
		pack, packed := physical(id)
		ammo, rounds := physical(p.AmmoDefinition)
		empty, shell := physical(p.EmptyDefinition)
		_, recursiveAmmo := c.AmmoPacks[p.AmmoDefinition]
		_, recursiveShell := c.AmmoPacks[p.EmptyDefinition]
		if !packed || !rounds || !shell || p.Rounds < 1 || p.Rounds > 1000 || int64(p.Rounds) > ammo.StackLimit || id == p.AmmoDefinition || id == p.EmptyDefinition || p.AmmoDefinition == p.EmptyDefinition || recursiveAmmo || recursiveShell {
			return fmt.Errorf("invalid physical ammunition pack %s", id)
		}
		// Exact conservation is authored, including the empty spring carrier.
		// Division avoids overflowing on a malformed external catalog.
		n := int64(p.Rounds)
		mass, volume := pack.Mass-empty.Mass, pack.Volume-empty.Volume
		if mass < 1 || volume < 1 || mass%n != 0 || volume%n != 0 || mass/n != ammo.Mass || volume/n != ammo.Volume {
			return fmt.Errorf("ammunition pack %s must conserve mass and volume", id)
		}
		compatible := false
		for _, w := range c.Weapons {
			if w.Magazine > 0 && w.AmmoDefinition == p.AmmoDefinition {
				compatible = true
				break
			}
		}
		if !compatible {
			return fmt.Errorf("ammunition pack %s has no compatible firearm", id)
		}
	}
	return nil
}

func (r *Runtime) combatReserveAmmo(s inv.State, actor, definition string) int {
	n := int64(r.combatCount(s, actor, definition, func(i inv.Item) bool { return !r.combatLoadedContainer(s, i) }))
	for _, id := range combatItemKeys(s) {
		i := s.Items[id]
		p, ok := r.world.CombatRuntime.AmmoPacks[i.Definition]
		if !ok || p.AmmoDefinition != definition || i.Owner != actor || !r.combatCarried(s, actor, i) || r.combatLoadedContainer(s, i) {
			continue
		}
		// Match the existing combat stock bound without overflowing multiplication.
		if p.Rounds < 1 || i.Quantity > (1000000-n)/int64(p.Rounds) {
			return 1000000
		}
		n += i.Quantity * int64(p.Rounds)
	}
	return int(n)
}

// The caller owns a draft for the complete reload. Transform itself is atomic,
// but ignores locks, so this adapter checks both custody chains before using it.
// The loaded portion goes straight into the magazine; the remaining needles and
// empty carrier stay where the pack was. A full bag needs no temporary headroom.
func (r *Runtime) unpackCombatAmmo(s *inv.State, actor, id, gun string, amount int) error {
	i, exists := s.Items[id]
	p, known := r.world.CombatRuntime.AmmoPacks[i.Definition]
	weapon, hasGun := s.Items[gun]
	w, firearm := r.world.CombatRuntime.Weapons[weapon.Definition]
	store, hasStore := s.Stores[inv.ItemStore(gun)]
	if !exists || !known || !hasGun || !firearm || !hasStore || store.Locked || amount < 1 || amount > p.Rounds || w.AmmoDefinition != p.AmmoDefinition || i.Owner != actor || !r.combatCarried(*s, actor, i) || r.combatLoadedContainer(*s, i) || !r.combatCarried(*s, actor, weapon) {
		return errors.New("physical ammunition pack unavailable")
	}
	loaded := r.combatCount(*s, actor, w.AmmoDefinition, func(round inv.Item) bool { return round.Location.Store == store.ID })
	if loaded+amount > w.Magazine {
		return errors.New("magazine capacity exceeded")
	}
	where := i.Location
	where.Slot = ""
	base := fmt.Sprintf("combat.ammo-pack.%s.%d", id, s.Revision)
	makeItem := func(part int, definition string, quantity int, location inv.Location) inv.Make {
		return inv.Make{ID: inv.InstanceID(base, 0, part), Definition: definition, Quantity: int64(quantity), Condition: i.Condition, Owner: i.Owner, Origin: i.Origin, Location: location, Grade: i.Grade}
	}
	makeItems := []inv.Make{
		makeItem(0, p.AmmoDefinition, amount, inv.Location{Kind: "store", Store: store.ID}),
		makeItem(2, p.EmptyDefinition, 1, where),
	}
	if amount < p.Rounds {
		makeItems = append(makeItems, makeItem(1, p.AmmoDefinition, p.Rounds-amount, where))
	}
	_, err := s.Transform(r.inventoryModelFor(true), inv.Transform{Spend: []inv.Spend{{Item: id, Quantity: 1}}, Make: makeItems})
	return err
}
