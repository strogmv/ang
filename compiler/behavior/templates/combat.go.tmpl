		value := guardRisk * float64(a.Weapon.ParryPercent) / 100 * r.CoverWeight
		if canRiposte && reserve >= r.GuardAP+a.Weapon.AttackAP && (!a.WeaponUsesLimited || a.WeaponUsesRemaining >= 2) {
			value += float64(a.WeaponRisk()) * .3 * r.AttackWeight
		}
		add(CombatCandidate{CombatAction{Type: "guard"}, value, "hold remaining AP against an observed melee reach; counter only within own reach and reserves", r.GuardAP})
	}
	if !a.Noncombatant && a.Trained && r.ReactionAP > 0 && combatWeaponKind(a.Weapon) == "firearm" && a.AP >= r.ReactionAP+a.Weapon.AttackAP && a.Ammo > 0 && nearest <= a.Weapon.RangeMM && (!a.WeaponUsesLimited || a.WeaponUsesRemaining > 0) {
		value := float64(a.WeaponRisk()) * .3 * r.AttackWeight
