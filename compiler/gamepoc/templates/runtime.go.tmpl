func (r *Runtime) step() {
	defer r.updateExploration()
	if !r.state.Active || r.state.Paused {
		return
	}
	r.state.Tick++
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		panic(err)
	}
	if r.state.Life.Enabled {
		if err := r.lifeStep(); err != nil {
			r.stopPopulation(err)
		}
		return
	}
	now := r.state.Tick * (int64(time.Second) / int64(r.world.Config.TickHz))
	for len(r.state.Path) > 0 && now >= r.state.MoveStartNS+r.moveDurationNS() {
		blocked := false
		for _, a := range r.sceneActors() {
			if a.Position == r.state.Path[0] {
				blocked = true
				break
			}
		}
		if blocked {
			r.state.MoveStartNS += r.tickNS()
			break
		}
		r.setActorFacing(playerActorID, r.state.Player, r.state.Path[0])
		r.state.Player = r.state.Path[0]
		r.state.Path = r.state.Path[1:]
		r.state.MoveStartNS += r.moveDurationNS()
	}
	r.demoStep()
}
func (r *Runtime) move(c *connection, m *pb.MoveTo) {
	if r.state.Life.Enabled {
		r.lifeMove(c, m)
		return
	}
	result := &pb.PocMoveResult{Epoch: r.state.Epoch, InputSeq: m.InputSeq}
	switch {
	case m.Epoch != r.state.Epoch:
		result.Reason = "Мир изменился. Повторите команду"
	case m.InputSeq == 0 || m.InputSeq <= c.lastMoveSeq:
		result.Reason = "Устаревшая команда движения"
	case r.missionActor() == playerActorID && r.state.Demo.Enabled && !r.state.Demo.TargetAlive:
		result.Reason = "Герой погиб"
	case r.missionActor() == playerActorID && r.state.Demo.Captured:
		result.Reason = "Герой захвачен"
	case !r.state.Active:
		result.Reason = "Сначала начните игру"
	case r.state.Paused:
		result.Reason = "Мир на паузе"
	default:
		c.lastMoveSeq = m.InputSeq
		target := point{int(m.X), int(m.Y)}
		from := r.state.Player
		moving := len(r.state.Path) > 0
		if moving {
			from = r.state.Path[0]
		}
		blocked := map[point]bool{}
		for _, a := range r.sceneActors() {
			blocked[a.Position] = true
			if len(a.Path) > 0 {
				blocked[a.Path[0]] = true
			}
		}
		route := r.pathAvoid(from, target, blocked)
		if !r.walkable(target) || (from != target && len(route) == 0) {
			result.Reason = "Сюда нельзя пройти"
		} else {
			if moving {
				route = append([]point{from}, route...)
			} else {
				r.state.MoveStartNS = r.simNS()
			}
			r.state.Path = route
			r.state.LastMoveSeq = m.InputSeq
			result.Ok = true
		}
	}
	r.send(c, &pb.ServerMessage{Msg: &pb.ServerMessage_MoveResult{MoveResult: result}})
	// Publish the authorized route immediately, including before the first tick.
	r.sendState(c)
}
