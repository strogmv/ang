func TestAutosaveWaitsOutCombatAndAlarm(t *testing.T) {
	r, _ := saveFixture(t)
	every := r.world.Config.AutoSave.EveryPlayMinutes * int64(time.Minute)
	level := r.currentLevel()
	zone := func(phase string) func(bool) {
		return func(on bool) {
			r.state.AccessZones = nil
			if on {
				r.state.AccessZones = &accessZoneState{Records: []accessZoneRecord{{Zone: "zone", Person: playerActorID, Phase: phase}}}
			}
		}
	}
	for name, set := range map[string]func(bool){
		"combat on the hero's level": func(on bool) { r.state.Combat.Active, r.state.Combat.LevelID = on, level },
		"lockdown alarm":             func(on bool) { r.state.Life.LocationLockdown = map[string]bool{level: on} },
		"access zone countdown":      zone("countdown"),
		"turret fire":                zone("fire"),
	} {
		r.saves.playedNS = 2 * every
		set(true)
		r.autosaveWhenDue()
		if len(r.jobs) != 0 {
			t.Fatalf("%s: the autosave did not wait", name)
		}
		set(false)
		r.autosaveWhenDue()
		if len(r.jobs) != 1 {
			t.Fatalf("%s: no autosave once it was over", name)
		}
		r.diskComplete(r.storageRuntime().diskWork(<-r.jobs))
	}
	// being scanned or let through is no alarm
	for _, phase := range []string{"scan", "granted"} {
		r.saves.playedNS = every
		zone(phase)(true)
		r.autosaveWhenDue()
		if len(r.jobs) != 1 {
			t.Fatalf("an access zone %s held the autosave", phase)
		}
		r.diskComplete(r.storageRuntime().diskWork(<-r.jobs))
	}
}

