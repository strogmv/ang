 for _,a:=range r.sceneActors(){
  if a.YieldUntil>0&&r.state.Tick>=a.YieldUntil{a.YieldUntil=0;if a.Task=="yielding"{a.Task=a.YieldResumeTask;a.Goal=a.YieldResumeGoal;a.Path=nil}}
  if controlled[a.ID]||a.Task=="considering"{continue}
  intent:=r.actorIntent(*a);observed:=a.Reaction.Awareness.Position
  if f,k:=a.Memory.Lookup("poc.hero","incident");k==behavior.KnowledgeTrue{observed=f.Position}else if f,ok:=a.Memory.Best("alarm");ok{observed=f.Position}
  if a.Task=="investigating"&&len(a.Path)==0&&a.Position==a.Goal{r.finishInvestigation(a)}
  switch intent{
  case "hold":
   r.suspendRoutine(a,"удерживает позицию");a.Task="holding_post";a.Path=nil;a.Goal=a.Position
  case "alarm":
   if a.AlarmRaisedTick==0{r.raiseAlarm(a)}
  case "avoid":
   r.suspendRoutine(a,"держится в стороне")
   if goal,ok:=r.sceneSpace(map[string]bool{a.ID:true}).Escape(cell(a.Position),observed,r.world.AI.Policy.Social.SafeDistance);ok{r.applySocialOrder(a,behavior.Order{ActorID:a.ID,Goal:goal,Mode:"avoiding"},observed)}
  case "investigate":
   if snd,ok:=a.Memory.Best("sound");ok{
    r.suspendRoutine(a,"идёт проверить звук");a.Investigating=snd.Subject
    space:=r.sceneSpace(map[string]bool{a.ID:true})
    if _,goals,ok:=space.Rally(snd.Position,[]behavior.Member{{ID:a.ID,Position:cell(a.Position),Available:true}},0);ok{r.applySocialOrder(a,behavior.Order{ActorID:a.ID,Goal:goals[a.ID],Mode:"investigating"},snd.Position)}else{r.finishInvestigation(a)}
   }
  case "gather_watch","withdraw":
   r.suspendRoutine(a,"отходит к наблюдателям")
   if !haveFocus{focus=observed;haveFocus=true}
   if behavior.Distance(observed,focus)>r.world.AI.Policy.Social.CrowdJoinDistance{continue}
   crowd=append(crowd,behavior.Member{ID:a.ID,Position:cell(a.Position),Moving:len(a.Path)>0,Available:true});crowdIDs[a.ID]=true
  case "flee":
   r.suspendRoutine(a,"уходит от опасности")
   if goal,ok:=r.sceneSpace(map[string]bool{a.ID:true}).Escape(cell(a.Position),observed,r.world.AI.Policy.Social.FleeDistance);ok{r.applySocialOrder(a,behavior.Order{ActorID:a.ID,Goal:goal,Mode:"fleeing"},observed)}
  case "assist":
   r.suspendRoutine(a,"идёт на помощь")
   // A helper keeps the observers' safe distance with a view of the incident; closer support
   // positions belong to accepted group roles, so helpers never crowd the group's approach lanes.
   space:=r.sceneSpace(map[string]bool{a.ID:true});space.RequireGoalView=true;keep:=r.world.AI.Policy.Social.SafeDistance
   if _,goals,ok:=space.Rally(observed,[]behavior.Member{{ID:a.ID,Position:cell(a.Position),Available:true}},keep);ok{r.applySocialOrder(a,behavior.Order{ActorID:a.ID,Goal:goals[a.ID],Mode:"assisting",MinTargetDistance:keep},observed)}
  default:
   if a.RoutineSuspended{
    a.BusyUntil+=r.state.Tick-a.RoutinePausedTick;a.RoutineSuspended=false;a.Task="returning";a.Path=nil
    r.applySocialOrder(a,behavior.Order{Goal:cell(a.RoutineGoal),Mode:"returning"},cell(r.state.Player))
   }
  }
 }
 if len(crowd)>0{
  d.Crowd.SubjectID="poc.hero";d.Crowd.ID="poc.market_observers"
  orders:=d.Crowd.Update(r.sceneSpace(crowdIDs),r.world.AI.Policy.Social,crowd,focus)
  for _,order:=range orders{for _,a:=range r.sceneActors(){if a.ID==order.ActorID{r.applySocialOrder(a,order,focus);break}}}
 }
}
// finishInvestigation resolves a checked sound: nothing found means the fact is forgotten and the
// routine resumes with the same remaining work; a seen source already produced visual facts.
func(r *Runtime) finishInvestigation(a *demoAgent){
 if a.Investigating!=""{a.Memory.Forget(a.Investigating,"sound");r.demoEvent(a.Name+": проверил источник звука");a.Investigating=""}
}
// suspendRoutine parks the interrupted work once; the remaining work time is restored on return.
func(r *Runtime) suspendRoutine(a *demoAgent,event string){
 if a.RoutineSuspended{return}
 a.RoutineTask=a.Task;a.RoutineGoal=a.Goal;a.RoutinePausedTick=r.state.Tick;a.RoutineSuspended=true;r.demoEvent(a.Name+": "+event)
}
func(r *Runtime) advanceResident(a *demoAgent){
 now:=r.state.Tick*r.tickNS()
 if len(a.Path)>0&&now>=a.MoveStartNS+r.agentDurationNS(){
  next:=a.Path[0];if r.sceneOccupied(next,a.ID){r.sceneBlocked(a,next);a.MoveStartNS+=r.tickNS();return}
  a.Position=next;a.Path=a.Path[1:];a.MoveStartNS+=r.agentDurationNS();a.BlockedTicks=0
 }
 r.finishSocialMotion(a)
}
func(r *Runtime) finishSocialMotion(a *demoAgent){
 if len(a.Path)>0{return}
 if a.Task=="returning"&&a.Position==a.Goal{a.Task=a.RoutineTask;if a.Task==""{a.Task="working"}}
}
func(r *Runtime) appendResidentStates(msg *pb.PocGameState){
 for _,a:=range r.state.Demo.Residents{msg.SceneAgents=append(msg.SceneAgents,r.sceneAgentMessage(a))}
}
func(r *Runtime) sceneAgentMessage(a demoAgent)*pb.PocAgentState{
 reason:=a.Reaction.Reason;if a.Personal.GoalID!=""{reason=a.Personal.Reason}
 v:=&pb.PocAgentState{Id:a.ID,Name:a.Name,X:int32(a.Position.X),Y:int32(a.Position.Y),Task:a.Task,Role:a.Role,GoalX:int32(a.Goal.X),GoalY:int32(a.Goal.Y),MotionStartNs:a.MoveStartNS,MovementStepNs:r.agentDurationNS(),MotionPaused:a.Task=="considering",MotionSampleNs:a.PausedAtNS,Intent:r.actorIntent(a),DecisionReason:reason,ObservedSubjectId:a.Reaction.Awareness.SubjectID,ObservationSource:a.Reaction.Awareness.Source}
 v.ActionStatus=a.Progress.Status;v.ActionReason=a.Progress.Reason;v.ActionDeadlineTick=a.Progress.DeadlineTick;v.ActionRecoveries=int32(a.Progress.Recoveries)
 v.WatchSubjectId=a.Reaction.WatchSubjectID;v.HasLookTarget=a.Reaction.HasLookTarget;v.LookX=int32(a.Reaction.LookAt.X);v.LookY=int32(a.Reaction.LookAt.Y)
 if r.selectedActor(a.ID){v.GroupId=r.state.Demo.Squad.ID}else if a.RoutineSuspended{v.GroupId=r.state.Demo.Crowd.ID}
 for _,p:=range a.Path{v.Path=append(v.Path,&pb.PocPoint{X:int32(p.X),Y:int32(p.Y)})};return v
}
func(r *Runtime) validateSocialSave(s state)error{
 if err:=s.Demo.Progress.Validate(s.Tick,r.world.AI.Policy.Recovery.Group);err!=nil{return err}
 for _,actors:=range [][]demoAgent{s.Demo.Agents,s.Demo.Residents}{for _,a:=range actors{
  if err:=a.Progress.Validate(s.Tick,r.world.AI.Policy.Recovery.Movement);err!=nil{return err}
  if err:=a.Memory.Validate(r.world.AI.Policy.Memory,s.Tick);err!=nil{return err}
  if err:=a.Personal.Validate(r.world.AI,s.Tick);err!=nil{return err}
  if a.RoutineSuspended&&(a.RoutinePausedTick<0||a.RoutinePausedTick>s.Tick){return errors.New("invalid suspended work clock")}
 }}
 if len(s.Demo.Residents)!=len(r.world.Entities){return errors.New("invalid resident registry")}
 ids:=map[string]bool{};for _,a:=range s.Demo.Agents{ids[a.ID]=true}
 for i,a:=range s.Demo.Residents{
  if a.ID!=r.world.Entities[i].ID||!r.walkable(a.Position)||len(a.Path)>len(r.world.Terrain)*len(r.world.Terrain[0]){return errors.New("invalid resident state")};ids[a.ID]=true
  previous:=a.Position;for _,p:=range a.Path{if !r.walkable(p)||manhattan(previous,p)!=1{return errors.New("invalid resident route")};previous=p}
 }
 for _,goals:=range []map[string]behavior.Cell{s.Demo.Squad.RallyGoals,s.Demo.Squad.StageGoals,s.Demo.Squad.ContactGoals,s.Demo.Crowd.Goals}{
  if len(goals)>len(ids){return errors.New("invalid saved social group size")}
  reserved:=map[behavior.Cell]bool{};for id,p:=range goals{if !ids[id]||!r.walkable(location(p))||reserved[p]{return errors.New("invalid saved group reservation")};reserved[p]=true}
 }
 switch s.Demo.Squad.Phase{case "","awaiting","assembling","regroup","approaching","committing","in_position":default:return errors.New("invalid saved squad phase")}
 return nil
}
func(r *Runtime) sceneBlocked(waiter *demoAgent,next point,routes ...[]point){
 r.observeMovement(waiter,waiter.Task,waiter.Goal)
 reason:="formation_constraint";if r.sceneOccupied(next,waiter.ID){reason="occupied"}
 waiter.Progress.Block(reason,"positions_changed",r.state.Tick,r.world.AI.Policy.Recovery.Movement)
 waiter.BlockedTicks++;policy:=r.world.AI.Policy.Social
 if waiter.BlockedTicks>=policy.YieldBlockedTicks{
  for _,blocker:=range r.sceneActors(){if blocker.ID==waiter.ID||blocker.Position!=next{continue}
   sameGroup:=r.selectedActor(waiter.ID)&&r.selectedActor(blocker.ID)&&!r.state.Demo.Captured
   if sameGroup&&len(blocker.Path)==0&&r.state.Demo.Squad.ExchangeSlots(waiter.ID,blocker.ID){
    waiter.Path=nil;blocker.Path=nil;waiter.BlockedTicks=0;blocker.BlockedTicks=0;r.demoEvent("Группа меняет позиции, освобождая проход");return
   }
   if blocker.Task=="considering"||blocker.Task=="capturing"||blocker.Task=="delivered"||blocker.YieldUntil>r.state.Tick{break}
   focus:=cell(r.state.Player);minimum:=0
   if blocker.Reaction.Awareness.Known&&blocker.Reaction.Awareness.Active{focus=blocker.Reaction.Awareness.Position;minimum=policy.SafeDistance}
   if r.selectedActor(blocker.ID)&&!r.state.Demo.Captured{focus=r.state.Demo.Squad.Target;minimum=2;if r.state.Demo.Squad.Phase=="assembling"{minimum=r.groupPolicy().Standoff}}
   desired:=waiter.Path;if len(routes)>0{desired=routes[0]};avoid:=map[behavior.Cell]bool{};for _,p:=range desired{avoid[cell(p)]=true}
   space:=r.sceneSpace(map[string]bool{blocker.ID:true});route:=space.YieldRoute(cell(blocker.Position),focus,minimum,avoid)
   if len(route)==0{break};goal:=route[len(route)-1]
   if r.selectedActor(blocker.ID)&&r.state.Demo.TeamReady&&!behavior.SupportedStep(blocker.ID,goal,r.squadMembers(),r.groupPolicy().Cohesion){break}
   blocker.YieldUntil=r.state.Tick+policy.YieldHoldTicks+int64(len(route))*r.world.Config.CaptureDemo.MoveEveryTicks
   if !r.selectedActor(blocker.ID)&&blocker.RoutineSuspended{if r.state.Demo.Crowd.Goals==nil{r.state.Demo.Crowd.Goals=map[string]behavior.Cell{}};r.state.Demo.Crowd.Goals[blocker.ID]=goal}else{blocker.YieldResumeTask=blocker.Task;blocker.YieldResumeGoal=blocker.Goal;blocker.Task="yielding"}
   blocker.Path=nil;for _,p:=range route{blocker.Path=append(blocker.Path,location(p))};blocker.Goal=location(goal);blocker.MoveStartNS=r.state.Tick*r.tickNS()
   r.demoEvent(blocker.Name+": уступает проход");break
  }
 }
 if waiter.BlockedTicks>=policy.ReplanBlockedTicks{waiter.Path=nil;waiter.MoveStartNS=r.state.Tick*r.tickNS()}
}

func(r *Runtime) observeMovement(a *demoAgent,mode string,goal point){
 a.Progress.Observe(fmt.Sprintf("%s:%d,%d",mode,goal.X,goal.Y),fmt.Sprintf("%d,%d",a.Position.X,a.Position.Y),r.state.Tick,r.world.AI.Policy.Recovery.Movement)
}
func(r *Runtime) sceneProgressStep(){
 policy:=r.world.AI.Policy.Recovery.Movement
 for _,a:=range r.sceneActors(){
  switch a.Task{case "patrol","joining","assembling","approaching","committing","responding","transporting","yielding","gather_watch","withdraw","returning","fleeing","assisting","avoiding","investigating":default:a.Progress.Pause(r.state.Tick);continue}
  r.observeMovement(a,a.Task,a.Goal)
  if a.Position==a.Goal&&len(a.Path)==0{a.Progress.Complete();continue}
  if len(a.Path)==0&&a.Progress.Status=="running"{a.Progress.Block("route_unavailable","positions_changed",r.state.Tick,policy)}
  switch a.Progress.Poll(r.state.Tick,policy){
  case "recover":a.Path=nil;a.BlockedTicks=0;r.demoEvent(a.Name+": пересматривает движение — "+a.Progress.Reason)
  case "failed":a.Path=nil;a.Task="blocked";r.demoEvent(a.Name+": действие остановлено — "+a.Progress.Reason)
  }
 }
}
func(r *Runtime) missionProgressStep(){
 d:=&r.state.Demo;policy:=r.world.AI.Policy.Recovery.Group
 if d.Plan.Status=="completed"{d.Progress.Complete();return}
 if d.Plan.Status=="failed"{return}
 mark:=fmt.Sprintf("%t/%t/%t",d.Captured,d.Held,d.AtMedblock)
 for _,c:=range d.Candidates{if c.Selected{a:=d.Agents[r.demoAgentIndex(c.AgentID)];if a.Progress.Status=="failed"{r.failMission(a.ID+": "+a.Progress.Reason);return};mark+=fmt.Sprintf("/%s:%d,%d",a.ID,a.Position.X,a.Position.Y)}}
 d.Progress.Observe(d.Plan.Root,mark,r.state.Tick,policy)
 reason:=d.Plan.Reason;if reason==""{reason=d.Squad.Reason};if reason==""{reason="awaiting_world_result"}
 d.Progress.Block(reason,"group_progress",r.state.Tick,policy)
 switch d.Progress.Poll(r.state.Tick,policy){
 case "recover":
  for i:=range d.Agents{if r.selectedActor(d.Agents[i].ID){d.Agents[i].Path=nil}}
  if !d.Captured{d.Squad.RallyValid=false;d.TeamReady=false}
  d.Plan.Restart("bounded recovery: "+reason);r.demoEvent("Группа пересматривает план: "+reason)
 case "failed":r.failMission(d.Progress.Reason)
 }
}
func(r *Runtime) failMission(reason string){
 d:=&r.state.Demo
 if d.Progress.Key==""{d.Progress.Observe(r.world.Config.CaptureDemo.MissionRoot,"",r.state.Tick,r.world.AI.Policy.Recovery.Group)}
 d.Plan.Status="failed";d.Plan.Reason=reason;d.Progress.Status="failed";d.Progress.Reason=reason
 for i:=range d.Agents{a:=&d.Agents[i];if r.selectedActor(a.ID){a.Path=nil;a.Task="blocked"}}
 r.demoEvent("Задание остановлено: "+reason)
}
