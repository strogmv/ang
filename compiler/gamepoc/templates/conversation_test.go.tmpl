func TestMemoryInterjectionFreshestOnceAndStale(t *testing.T) {
	r := memoryDay(t, 5)
	akim := akimAt(t, r)
	witnessFor(r, akim.Actor, "fact.prokhor.custody_refuse", 600)
	witnessFor(r, akim.Actor, "fact.prokhor.custody_lie_caught", 0)
	for _, want := range []string{"interject.lie_caught.akim", "interject.custody_refuse.akim"} {
		tk := openWith(t, r, akim.Actor)
		if !tk.Interjected || tk.Lines[0].Text != want {
			t.Fatalf("want %s first: %+v", want, tk.Lines)
		}
		if err := choose(r, "bye"); err != nil {
			t.Fatal(err)
		}
		r.talkDrop()
	}
	if _, ok := r.talkAvailable(akim.Actor); ok {
		t.Fatal("the same fact was offered twice")
	}
	// a fact older than the freshness is remembered, not said first
	w := memoryDay(t, 5)
	akimAt(t, w)
	w.world.Memory.InterjectionRules.FreshDays = 1
	witnessFor(w, akim.Actor, "fact.prokhor.custody_refuse", 2*86400)
	if _, ok := w.talkAvailable(akim.Actor); ok {
		t.Fatal("a stale fact was said first")
	}
	// who did not see it says nothing (step 1 has no rumours)
	x := memoryDay(t, 5)
	akimAt(t, x)
	x.memoryWrite("fact.prokhor.custody_lie_caught", nil, talkCtx{self: x.world.CalendarEncounter.Actor, quiet: true})
	if _, ok := x.talkAvailable(akim.Actor); ok {
		t.Fatal("Akim knows what he never witnessed")
	}
}

func TestMemoryWitnessesBySightHearingAndScene(t *testing.T) {
	r := memoryDay(t, 5)
	akim := akimAt(t, r)
	e := r.world.CalendarEncounter
	hero := r.state.Life.Actor(playerActorID)
	// public: everyone of the level at once; private: only the named; a silver reader knows what is recorded
	for _, f := range []string{"fact.prokhor.custody_refuse", "fact.prokhor.custody_escape_unseen", "fact.law.duty_refusal"} {
		r.memoryWrite(f, nil, talkCtx{self: e.Actor})
	}
	for i := range r.state.Life.Actors {
		a := &r.state.Life.Actors[i]
		if a.ID == playerActorID || !a.OnFloor() {
			continue
		}
		// a public fact: the level; it is in the record too — silver reads it from anywhere
		if r.memoryKnows(a.ID, "fact.prokhor.custody_refuse") != (a.Level == hero.Level || barkCatalog.Castes[a.ID] == "silver") {
			t.Fatalf("%s on %s and the public refusal", a.ID, a.Level)
		}
		if r.memoryKnows(a.ID, "fact.prokhor.custody_escape_unseen") != (a.ID == e.Actor) {
			t.Fatalf("%s knows a private fact", a.ID)
		}
		if r.memoryKnows(a.ID, "fact.law.duty_refusal") != (a.ID == e.Guard || barkCatalog.Castes[a.ID] == "silver") {
			t.Fatalf("%s and the record", a.ID)
		}
	}
	// a quiet lie is heard within two cells only
	r.memoryWrite("fact.prokhor.custody_lie_believed", nil, talkCtx{self: e.Actor})
	if !r.memoryKnows(akim.Actor, "fact.prokhor.custody_lie_believed") {
		t.Fatal("Akim beside the hero did not hear the quiet lie")
	}
	w := memoryDay(t, 5)
	akimAt(t, w)
	a := w.state.Life.Actor(akim.Actor)
	moved := false
	for _, c := range []inv.Cell{{X: a.Position.X + 6, Y: a.Position.Y}, {X: a.Position.X - 6, Y: a.Position.Y}, {X: a.Position.X, Y: a.Position.Y + 6}, {X: a.Position.X, Y: a.Position.Y - 6}} {
		if w.world.Life.Walks(a.Level, behavior.Cell{X: c.X, Y: c.Y}) {
			peddlerPlace(t, w, playerActorID, c)
			moved = true
			break
		}
	}
	if !moved {
		t.Skip("no cell six steps from Akim")
	}
	w.memoryWrite("fact.prokhor.custody_lie_believed", nil, talkCtx{self: e.Actor})
	if w.memoryKnows(akim.Actor, "fact.prokhor.custody_lie_believed") {
		t.Fatal("Akim heard a quiet lie six cells away")
	}
}

