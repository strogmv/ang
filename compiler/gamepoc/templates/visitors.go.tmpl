}

// visitorArrivals: the arrivals of a day, by the second (a pure function of the seed and the day).
func (r *Runtime) visitorArrivals(day int64) []visitorArrival {
	v := r.world.Visitors
	c := &r.visitors
	if c.ready && c.seed == r.state.Seed && c.day == day {
		return c.arrivals
	}
	var total int64
	for _, h := range v.Hours {
		total += h
	}
	out := make([]visitorArrival, 0, v.PerDay)
	for i := int64(0); i < v.PerDay && total > 0; i++ {
		serial := day*visitorSerialStride + i
		pick := int64(r.visitorDraw(serial, "hour") % uint64(total))
		hour := 0
		for hour < len(v.Hours)-1 && pick >= v.Hours[hour] {
			pick -= v.Hours[hour]
			hour++
		}
		out = append(out, visitorArrival{Second: v.OpenSecond + int64(hour)*3600 + int64(r.visitorDraw(serial, "second")%3600), Number: i})
	}
	sort.Slice(out, func(i, j int) bool {
		if out[i].Second != out[j].Second {
			return out[i].Second < out[j].Second
		}
		return out[i].Number < out[j].Number
	})
	c.seed, c.day, c.arrivals, c.ready = r.state.Seed, day, out, true
	return out
}
func (r *Runtime) visitorIndex() {
	c := &r.visitors
	if c.targets != nil {
		return
	}
	c.targets, c.category = map[string]int{}, map[string][]int{}
	for i, t := range r.world.Visitors.Targets {
		c.targets[t.ID] = i
		c.category[t.Category] = append(c.category[t.Category], i)
	}
}

// visitorStock: what stands for sale on the showcases now.
func (r *Runtime) visitorStock() map[string]map[string]int64 {
	c := &r.visitors
	if c.stockReady && c.stockAt == r.state.Inventory.Revision {
		return c.stock
	}
	out := map[string]map[string]int64{}
	for _, i := range r.state.Inventory.Items {
		if !i.ForSale || i.Hidden || i.Quantity < 1 || i.Owner == "" || i.Location.Kind != "store" {
			continue
		}
		m := out[i.Location.Store]
		if m == nil {
			m = map[string]int64{}
			out[i.Location.Store] = m
		}
		m[i.Definition] += i.Quantity
	}
	c.stock, c.stockAt, c.stockReady = out, r.state.Inventory.Revision, true
	return out
}

// visitorFloor: a signature of the level's floor now; the remembered walks belong to one floor.
func (r *Runtime) visitorFloor() {
	c := &r.visitors
	h := uint64(14695981039346656037)
	for _, row := range r.world.Life.Locations[r.world.Visitors.Level].Terrain {
		for i := 0; i < len(row); i++ {
			h = (h ^ uint64(row[i])) * 1099511628211
		}
		h = (h ^ 10) * 1099511628211
	}
	// market musician v1.1: his clear front shuts for planning while he is set up
	if r.buskerFront() != nil {
		h = (h ^ 0x627573) * 1099511628211
	}
	if h != c.floor || c.paths == nil {
		c.floor, c.paths = h, map[[2]behavior.Cell][]behavior.Cell{}
	}
}

// visitorPath: the walk over the floor as it is now (bodies are not asked); false when there is none.
func (r *Runtime) visitorPath(from, to behavior.Cell) ([]behavior.Cell, bool) {
	if from == to {
		return nil, true
	}
	c := &r.visitors
	if c.paths == nil {
		r.visitorFloor()
	}
	key := [2]behavior.Cell{from, to}
	if p, ok := c.paths[key]; ok {
		return p, len(p) > 0
	}
	p := r.world.Life.SpaceFor(r.world.Visitors.Level, nil, "").Path(from, to, behavior.Cell{}, 0)
	// market musician v1.1: while he is set up a walk goes round his clear front (the camera's line to him), his seat and
	// his case when a way round exists; a walk that starts or ends in them keeps those two cells
	if front := r.buskerRound(); front != nil {
		crosses := false
		for _, at := range p {
			if front[at] && at != to {
				crosses = true
				break
			}
		}
		if crosses {
			shut := make(map[behavior.Cell]bool, len(front))
			for at := range front {
				if at != from && at != to {
					shut[at] = true
				}
			}
			if q := r.world.Life.SpaceFor(r.world.Visitors.Level, shut, "").Path(from, to, behavior.Cell{}, 0); len(q) > 0 {
				p = q
			}
		}
	}
	if len(c.paths) > 1<<14 {
		c.paths = map[[2]behavior.Cell][]behavior.Cell{}
	}
	c.paths[key] = p
	return p, len(p) > 0
}
func (r *Runtime) visitorAccount(slot string) string { return "account." + slot + ".crd" }

// visitorMove: money between the outside account and a slot (both sides in one step; the sum of the accounts holds).
func (r *Runtime) visitorMove(from, to string, amount int64) bool {
	a, ok1 := r.state.Inventory.Accounts[from]
	b, ok2 := r.state.Inventory.Accounts[to]
	if !ok1 || !ok2 || amount < 0 || a.Balance < amount {
		return false
	}
	if amount == 0 {
		return true
	}
	a.Balance -= amount
	a.Revision++
	b.Balance += amount
	b.Revision++
	r.state.Inventory.Accounts[from], r.state.Inventory.Accounts[to] = a, b
	r.state.Inventory.Revision++
	return true
}
func (r *Runtime) visitorNoteSale(seller string, units, minor int64) {
	l := &r.state.Visitors.Ledger
	if l.Units == nil {
		l.Units, l.Turnover = map[string]int64{}, map[string]int64{}
	}
	l.Units[seller] += units
	l.Turnover[seller] += minor
	l.Purchases += units
	l.Spent += minor
}

// visitorOpen: the selling place serves now (its keeper at the post in his hours, a panel not in service).
func (r *Runtime) visitorOpen(t visitorTarget) bool {
	if t.Shop != "" {
		return r.storefrontOpen(t.Shop)
	}
	return r.vendingServes(t.Store)
}

// visitorChoose: the selling place for a thing of the list — one of the open places of the category with goods, by the draw; for
// the peddlers' category a peddler who stands at a stop of his round ("peddler:<shop>", the cell next to him).
func (r *Runtime) visitorChoose(serial int64, n int, category string) (string, behavior.Cell, bool) {
	v := r.world.Visitors
	if category == v.PeddlerCategory {
		type spot struct {
			id string
			at behavior.Cell
		}
		var open []spot
		for _, p := range r.world.Peddlers.Peddlers {
			if r.peddlerStopNow(p) == "" {
				continue
			}
			a := r.state.Life.Actor(p.Actor)
			held := r.state.Life.BlockedCells(v.Level, "")
			for _, d := range []behavior.Cell{{X: 0, Y: 1}, {X: 1, Y: 0}, {X: 0, Y: -1}, {X: -1, Y: 0}} {
				at := behavior.Cell{X: a.Position.X + d.X, Y: a.Position.Y + d.Y}
				// walkers v1: a free cell beside him, never the cell he is heading for (his stop)
				if r.world.Life.WalksFor(v.Level, at, "") && !held[at] && at != a.Goal {
					open = append(open, spot{"peddler:" + p.Shop, at})
					break
				}
			}
		}
		if len(open) == 0 {
			return "", behavior.Cell{}, false
		}
		s := open[r.visitorDraw(serial, fmt.Sprintf("choose.%d", n))%uint64(len(open))]
		return s.id, s.at, true
	}
	r.visitorIndex()
	stock := r.visitorStock()
	var open []int
	for _, i := range r.visitors.category[category] {
		if len(stock[v.Targets[i].Store]) > 0 && r.visitorOpen(v.Targets[i]) {
			open = append(open, i)
		}
	}
	if len(open) == 0 {
		return "", behavior.Cell{}, false
	}
	t := v.Targets[open[r.visitorDraw(serial, fmt.Sprintf("choose.%d", n))%uint64(len(open))]]
	if len(t.Spots) > 0 {
		return t.ID, r.visitorSpotAmong(t.Spots), true
	}
	return t.ID, r.visitorSpot(behavior.Cell{X: t.At.X, Y: t.At.Y}), true
}

// visitorSpotAmong (torgomat v2): a place with its own standing cells (a terminal's panel row): the first of them the fewest
// walkers stand on or head for.
func (r *Runtime) visitorSpotAmong(spots []inv.Cell) behavior.Cell {
	taken := r.visitorSpotsTaken()
	best := behavior.Cell{X: spots[0].X, Y: spots[0].Y}
	for _, c := range spots[1:] {
		if cell := (behavior.Cell{X: c.X, Y: c.Y}); taken[cell] < taken[best] {
			best = cell
		}
	}
	return best
}

// visitorSpotsTaken: the standing cells walkers stand on or head for (walkers v1: and the cells the Life's people stand on —
// a resident buying at the same counter, a seller's helper; people do not stand inside each other).
func (r *Runtime) visitorSpotsTaken() map[behavior.Cell]int {
	taken := map[behavior.Cell]int{}
	for _, b := range r.state.Visitors.Bodies {
		if b.Phase == "leave" {
			continue
		}
		spot := b.At
		if len(b.Path) > 0 {
			spot = b.Path[len(b.Path)-1]
		}
		taken[spot]++
	}
	for at := range r.state.Life.BlockedCells(r.world.Visitors.Level, "") {
		taken[at]++
	}
	return taken
}

// visitorTableTaken (food court v1.1): the places at the tables held now — by a walker bound for or eating at one, by a person
// of the hall who reserved one (the Life brain places of the tables) or stands on it.
func (r *Runtime) visitorTableTaken() map[int]bool {
	t := r.world.Visitors.Tables
	out := map[int]bool{}
	if t == nil {
		return out
	}
	for _, b := range r.state.Visitors.Bodies {
		if b.Table > 0 {
			out[b.Table-1] = true
		}
	}
	level := r.world.Visitors.Level
	held := map[behavior.Cell]bool{}
	for _, p := range t.Places {
		for c := range r.npcSeatsTaken(level, p, "") {
			held[c] = true
		}
	}
	for c := range r.state.Life.BlockedCells(level, "") {
		held[c] = true
	}
	for i, s := range t.Spots {
		if held[behavior.Cell{X: s.At.X, Y: s.At.Y}] {
			out[i] = true
		}
	}
	return out
}

// visitorMeal: what he bought at the place to eat at a table (in his bag, a thing the place sells that is one of the
// tables' meals), the first by name.
func (r *Runtime) visitorMeal(slot string, t *visitorTarget) string {
	meals := map[string]bool{}
	for _, m := range r.world.Visitors.Tables.Meals {
		meals[m] = true
	}
	sells := map[string]bool{}
	for _, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == t.Store && meals[i.Definition] {
			sells[i.Definition] = true
		}
	}
	bag := inv.ActorStore(slot)
	var defs []string
	for _, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == bag && sells[i.Definition] {
			defs = append(defs, i.Definition)
		}
	}
	if len(defs) == 0 {
		return ""
	}
	sort.Strings(defs)
	return defs[0]
}

// visitorToTable (food court v1.1): having bought at a hot-food place, by his draw he walks to the free place at a table
// nearest to him; false when he does not (the draw, nothing he can eat, no free place, no way there).
func (r *Runtime) visitorToTable(b *visitorBody, slot string) bool {
	t := r.world.Visitors.Tables
	tg := r.visitorTargetOf(b.Target)
	if t == nil || tg == nil {
		return false
	}
	ok := false
	for _, sh := range t.Shops {
		ok = ok || sh == tg.Shop
	}
	if !ok || int64(r.visitorDraw(b.Serial, fmt.Sprintf("table.%d", len(b.Stops)))%1000) >= t.ChancePermille {
		return false
	}
	meal := r.visitorMeal(slot, tg)
	if meal == "" {
		return false
	}
	taken := r.visitorTableTaken()
	best, bestD := -1, 0
	for i, s := range t.Spots {
		if taken[i] {
			continue
		}
		if d := manhattan(location(b.At), point{s.At.X, s.At.Y}); best < 0 || d < bestD {
			best, bestD = i, d
		}
	}
	if best < 0 {
		return false
	}
	path, found := r.visitorPath(b.At, behavior.Cell{X: t.Spots[best].At.X, Y: t.Spots[best].At.Y})
	if !found {
		return false
	}
	b.Phase, b.Target, b.Units, b.Path, b.Table, b.Meal = "walk", "", 0, path, best+1, meal
	b.Blocked, b.Yield = 0, 0
	return true
}

// visitorTargetOf: the selling place a walker is at (nil for a peddler or none).
func (r *Runtime) visitorTargetOf(id string) *visitorTarget {
	r.visitorIndex()
	if i, ok := r.visitors.targets[id]; ok {
		return &r.world.Visitors.Targets[i]
	}
	return nil
}

// visitorSpot: where a walker stands at a selling place — the customer's cell or a cell beside it along the counter,
// the one the fewest walkers stand on or head for (people do not stand inside each other).
// Walkers v1, addendum 1: the customer's cell is also where the people of the hall buy (their place at the counter); a
// walker who stands there for a minute would keep them waiting beside it, so he takes it only when every cell beside is
// more crowded than it.
func (r *Runtime) visitorSpot(at behavior.Cell) behavior.Cell {
	v := r.world.Visitors
	taken := r.visitorSpotsTaken()
	best, least := at, taken[at]+1
	for _, dx := range []int{1, -1, 2, -2} {
		spot, near := behavior.Cell{X: at.X + dx, Y: at.Y}, behavior.Cell{X: at.X + dx/absInt(dx), Y: at.Y}
		// the cell between must be floor too: a spot behind a post or a wall is another place
		if !r.world.Life.Walks(v.Level, spot) || !r.world.Life.Walks(v.Level, near) {
			continue
		}
		if taken[spot] < least {
			best, least = spot, taken[spot]
		}
	}
	return best
}

// visitorBuy: up to `units` of one thing at the selling place, each by the ordinary purchase of an inventory actor who
// stands on the customer's cell (a peddler sells by his own law). It returns the units bought.
func (r *Runtime) visitorBuy(slot string, serial int64, n int, target string, at behavior.Cell, want int64) int64 {
	v := r.world.Visitors
	model := r.inventoryModelFor(true)
	account, ok := r.state.Inventory.Accounts[r.visitorAccount(slot)]
	if !ok {
		return 0
	}
	if len(target) > 8 && target[:8] == "peddler:" {
		for _, p := range r.world.Peddlers.Peddlers {
			if p.Shop != target[8:] || r.peddlerStopNow(p) == "" {
				continue
			}
			a := r.state.Life.Actor(p.Actor)
			if a == nil || manhattan(location(a.Position), location(at)) > r.world.Peddlers.ReachCells {
				return 0
			}
			stock := r.craftingClassStock()
			var ids []string
			for id, i := range r.state.Inventory.Items {
				if i.ForSale && !i.Hidden && i.Quantity > 0 && i.Owner == p.Actor && i.Location.Kind == "store" && i.Location.Store == p.Tray {
					if price := r.peddlerLawPrice(i, stock); price > 0 && price <= account.Balance {
						ids = append(ids, id)
					}
				}
			}
			if len(ids) == 0 {
				return 0
			}
			sort.Strings(ids)
			var bought int64
			pick := ids[r.visitorDraw(serial, fmt.Sprintf("item.%d", n))%uint64(len(ids))]
			for bought < want {
				item, ok := r.state.Inventory.Items[pick]
				if !ok {
					break
				}
				_, price, err := r.peddlerSell(p, slot, item, inv.Location{Kind: "store", Store: inv.ActorStore(slot)}, 0, fmt.Sprintf("visitor/%d/%d/%d", serial, n, bought))
				if err != nil {
					break
				}
				r.visitorNoteSale(p.Actor, 1, price)
				bought++
			}
			return bought
		}
		return 0
	}
	r.visitorIndex()
	index, ok := r.visitors.targets[target]
	if !ok {
		return 0
	}
	t := v.Targets[index]
	if !r.visitorOpen(t) || !r.commerceAccessible(slot, inv.Location{Kind: "store", Store: t.Store}) {
		return 0
	}
	price := func(i inv.Item) (int64, bool) {
		d := model.Definitions[i.Definition]
		q, err := inv.Quote(d, 1)
		return q, err == nil && d.PriceUnit == account.Currency
	}
	// one thing of the showcase he can pay for: the fuller the heap, the likelier (trays thin out together)
	lowest := map[string]string{}
	units := map[string]int64{}
	var total int64
	for id, i := range r.state.Inventory.Items {
		if !i.ForSale || i.Hidden || i.Quantity < 1 || i.Owner == "" || i.Location.Kind != "store" || i.Location.Store != t.Store {
			continue
		}
		if q, ok := price(i); !ok || q > account.Balance {
			continue
		}
		if old, ok := lowest[i.Definition]; !ok || id < old {
			lowest[i.Definition] = id
		}
		units[i.Definition] += i.Quantity
		total += i.Quantity
	}
	if total == 0 {
		return 0
	}
	defs := make([]string, 0, len(lowest))
	for d := range lowest {
		defs = append(defs, d)
	}
	sort.Strings(defs)
	roll := int64(r.visitorDraw(serial, fmt.Sprintf("item.%d", n)) % uint64(total))
	chosen := defs[len(defs)-1]
	for _, d := range defs {
		if roll < units[d] {
			chosen = d
			break
		}
		roll -= units[d]
	}
	// he may stand a cell or two aside along the counter: the purchase is made across it at the customer's cell (a counter
	// its cook serves: at the cook's post, handed over to the pickup place)
	cell := t.At
	if t.ServeAt != nil {
		cell = *t.ServeAt
	}
	var bought int64
	for bought < want {
		// the lowest instance of the chosen thing that is still there
		pick := ""
		for id, i := range r.state.Inventory.Items {
			if i.Definition == chosen && i.ForSale && !i.Hidden && i.Quantity > 0 && i.Owner != "" && i.Location.Kind == "store" && i.Location.Store == t.Store && (pick == "" || id < pick) {
				pick = id
			}
		}
		item, ok := r.state.Inventory.Items[pick]
		if !ok {
			break
		}
		q, _ := price(item)
		if cur := r.state.Inventory.Accounts[account.ID]; q > cur.Balance {
			break
		}
		_, err := r.state.Inventory.Execute(model, inv.Action{Actor: slot, Kind: "buy", Item: item.ID, Quantity: 1, Sequence: r.state.Inventory.Cursors[slot].Sequence + 1, ExpectedRevision: item.Revision},
			inv.Access{Level: v.Level, At: cell, Known: func(i inv.Item) bool { return i.ID == item.ID }, Reach: func(a inv.Anchor) bool {
				return a.Kind == "world" && a.Level == v.Level && manhattan(point{a.At.X, a.At.Y}, point{cell.X, cell.Y}) <= model.Actions.ReachCells
			}})
		if err != nil {
			break
		}
		r.vendingNoteSale(t.Store, item.Definition)
		r.visitorNoteSale(item.Owner, 1, q)
		bought++
	}
	return bought
}

// visitorLeave: what he bought leaves the sector with him; what is left of the purse goes back to the outside account.
func (r *Runtime) visitorLeave(slot string) {
	v := r.world.Visitors
	model := r.inventoryModelFor(true)
	l := &r.state.Visitors.Ledger
	store := inv.ActorStore(slot)
	var ids []string
	for id, i := range r.state.Inventory.Items {
		if i.Owner == slot && i.Location.Kind == "store" && i.Location.Store == store {
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	for _, id := range ids {
		i := r.state.Inventory.Items[id]
		if err := r.state.Inventory.Consume(model, slot, id, i.Quantity); err != nil {
			panic(fmt.Sprintf("visitors: %s cannot carry %s out: %v", slot, id, err))
		}
		if l.Carried == nil {
			l.Carried = map[string]int64{}
		}
		l.Carried[i.Definition] += i.Quantity
	}
	if a, ok := r.state.Inventory.Accounts[r.visitorAccount(slot)]; ok && a.Balance > 0 {
		l.PurseOut += a.Balance
		r.visitorMove(a.ID, v.Outside.Account, a.Balance)
	}
}

// visitorArrive: one arrival — who he is, what he came for; a body if one is free, else the unseen purchase.
func (r *Runtime) visitorArrive(day int64, a visitorArrival) {
	v := r.world.Visitors
	s := &r.state.Visitors
	serial := day*visitorSerialStride + a.Number
	s.Ledger.Arrived++
	weigh := func(stream string, n int, share func(int) int64) int {
		var total int64
		for i := 0; i < n; i++ {
			total += share(i)
		}
		pick := int64(r.visitorDraw(serial, stream) % uint64(total))
		for i := 0; i < n-1; i++ {
			if pick < share(i) {
				return i
			}
			pick -= share(i)
		}
		return n - 1
	}
	kind := weigh("kind", len(v.Kinds), func(i int) int64 { return v.Kinds[i].Share })
	k := v.Kinds[kind]
	entryOf := func(stream string) int {
		id := k.Entries[weigh(stream, len(k.Entries), func(i int) int64 { return k.Entries[i].Share })].ID
		for i, e := range v.Entries {
			if e.ID == id {
				return i
			}
		}
		return 0
	}
	entry, exit := entryOf("entry"), entryOf("exit")
	var stops []visitorStop
	for i, w := range k.Wants {
		if int64(r.visitorDraw(serial, fmt.Sprintf("want.%d", i))%1000) < w.ChancePermille {
			stops = append(stops, visitorStop{Category: w.Category, Units: w.Units.Min + int64(r.visitorDraw(serial, fmt.Sprintf("units.%d", i))%uint64(w.Units.Max-w.Units.Min+1))})
		}
	}
	if len(stops) > 1 {
		turn := int(r.visitorDraw(serial, "order") % uint64(len(stops)))
		stops = append(append([]visitorStop(nil), stops[turn:]...), stops[:turn]...)
	}
	if len(stops) > v.MaxStops {
		stops = stops[:v.MaxStops]
	}
	purse := k.Purse.Min + int64(r.visitorDraw(serial, "purse")%uint64(k.Purse.Max-k.Purse.Min+1))
	if len(stops) == 0 {
		s.Ledger.Passed++
		purse = 0
	}
	used := make([]bool, len(v.Slots))
	for _, b := range s.Bodies {
		used[b.Slot] = true
	}
	slot := 0
	for i := 1; i < len(v.Slots); i++ {
		if !used[i] {
			slot = i
			break
		}
	}
	// walkers v1: he steps in on a free cell at his entry (or right beside it); a crowded entry is like no free body
	start, free := r.visitorEntryCell(entry)
	if !free {
		slot = 0
	}
	if slot == 0 {
		// no free body: he is in and out unseen, with the same list
		if len(stops) == 0 || !r.visitorMove(v.Outside.Account, r.visitorAccount(v.Slots[0]), purse) {
			return
		}
		s.Ledger.Unseen++
		s.Ledger.PurseIn += purse
		for n, st := range stops {
			if target, at, ok := r.visitorChoose(serial, n, st.Category); ok {
				r.visitorBuy(v.Slots[0], serial, n, target, at, st.Units)
			}
		}
		r.visitorLeave(v.Slots[0])
		return
	}
	if !r.visitorMove(v.Outside.Account, r.visitorAccount(v.Slots[slot]), purse) {
		return
	}
	s.Ledger.Walked++
	s.Ledger.PurseIn += purse
	// walkers v1, addendum 1: a visible walker walks to walk_stops places of his list and stays at each a while; what else he
	// came for he has bought on his way in, unseen (the day's trade does not change with the look of the hall)
	if v.WalkStops > 0 && len(stops) > v.WalkStops {
		for i := v.WalkStops; i < len(stops); i++ {
			if target, at, ok := r.visitorChoose(serial, i, stops[i].Category); ok {
				r.visitorBuy(v.Slots[slot], serial, i, target, at, stops[i].Units)
			}
		}
		stops = stops[:v.WalkStops]
	}
	b := visitorBody{Serial: serial, Slot: slot, Kind: kind, Exit: exit, At: start, Phase: "walk", Stops: stops, Since: r.state.Tick}
	r.visitorHead(&b)
	s.Bodies = append(s.Bodies, b)
	if len(s.Bodies) > s.Ledger.PeakBodies {
		s.Ledger.PeakBodies = len(s.Bodies)
	}
}

// visitorHead: the next thing of the list that has an open selling place he can walk to; with none left, the way out.
func (r *Runtime) visitorHead(b *visitorBody) {
	v := r.world.Visitors
	b.Table, b.Meal = 0, ""
	b.Listen, b.Paying = 0, false
	// a walker in transit keeps the cell he is stepping into: the new way starts there
	from, prefix := b.At, []behavior.Cell(nil)
	if b.Going && len(b.Path) > 0 {
		from, prefix = b.Path[0], []behavior.Cell{b.Path[0]}
	}
	b.Blocked, b.Yield = 0, 0
	for len(b.Stops) > 0 {
		st := b.Stops[0]
		b.Stops = b.Stops[1:]
		n := len(b.Stops)
		target, at, ok := r.visitorChoose(b.Serial, n, st.Category)
		if !ok {
			continue
		}
		path, ok := r.visitorPath(from, at)
		if !ok && from != at {
			continue
		}
		b.Phase, b.Target, b.Units, b.Path = "walk", target, st.Units, append(append([]behavior.Cell(nil), prefix...), path...)
		return
	}
	exit := v.Entries[b.Exit].At
	path, _ := r.visitorPath(from, behavior.Cell{X: exit.X, Y: exit.Y})
	b.Phase, b.Target, b.Units, b.Path = "leave", "", 0, append(append([]behavior.Cell(nil), prefix...), path...)
}

// advanceVisitors: one server tick of the hall's visitors (the calendar may have moved by many seconds).
func (r *Runtime) advanceVisitors() error {
	if !r.visitorsOn() {
		return nil
	}
	if err := r.advanceVisitorSupply(); err != nil {
		return err
	}
	r.visitorFloor()
	v := r.world.Visitors
	s := &r.state.Visitors
	now := r.state.Life.Seconds
	if now < s.Last {
		s.Last = now
	}
	// arrivals in (Last, now]
	for day := s.Last / 86400; day <= now/86400; day++ {
		from, to := int64(-1), int64(86400)
		if day == s.Last/86400 {
			from = s.Last % 86400
		}
		if day == now/86400 {
			to = now % 86400
		}
		arrivals := r.visitorArrivals(day)
		for i := sort.Search(len(arrivals), func(i int) bool { return arrivals[i].Second > from }); i < len(arrivals) && arrivals[i].Second <= to; i++ {
			r.visitorArrive(day, arrivals[i])
		}
	}
	s.Last = now
	clock := now % 86400
	closing := clock >= v.CloseSecond || clock < v.OpenSecond
	out := clock >= v.LeaveSecond || clock < v.OpenSecond
	// walkers v1: one pass in the order of the serials; every walker asks the cells as they are after those before him
	sort.Slice(s.Bodies, func(i, j int) bool { return s.Bodies[i].Serial < s.Bodies[j].Serial })
	w := r.walkersPass()
	kept := s.Bodies[:0]
	for _, b := range s.Bodies {
		slot := v.Slots[b.Slot]
		if out {
			w.release(b)
			r.visitorLeave(slot)
			continue
		}
		if closing && b.Phase != "leave" {
			b.Stops = nil
			r.visitorHead(&b)
		}
		if b.Going {
			if b.Wait > 0 {
				b.Wait--
				kept = append(kept, b)
				continue
			}
			// he has stepped into the cell he held
			w.free(b.At, b.Serial)
			b.At, b.Path, b.Going = b.Path[0], b.Path[1:], false
			// market musician v1: within earshot he may stop and listen
			r.buskerNotice(&b)
		}
		// market musician v1: the music has stopped — the listener goes on
		if b.Phase == "listen" && !r.buskerPlaying() && b.Wait > 0 {
			b.Wait = 0
		}
		// the hero (or the cabinet) is about to take his cell, or a person of the hall waits for it: he steps aside, at a
		// stall too
		if (w.priority[b.At] || w.wanted[b.At]) && r.visitorStepAside(&b, w, nil) {
			kept = append(kept, b)
			continue
		}
		if b.Wait > 0 {
			b.Wait--
			kept = append(kept, b)
			continue
		}
		if len(b.Path) > 0 {
			if !r.world.Life.WalksFor(v.Level, b.Path[0], "") {
				// the next cell is shut now (a gate leaf): he waits; after a while he looks for another way to the same
				// place, and with none he gives the place up (on the way out — he is let out where he stands)
				b.Held++
				if b.Held > visitorHoldTicks {
					b.Held = 0
					if path, ok := r.visitorPath(b.At, b.Path[len(b.Path)-1]); ok {
						b.Path = append([]behavior.Cell(nil), path...)
					} else if b.Phase == "leave" {
						w.release(b)
						s.Ledger.Stuck++
						r.visitorLeave(slot)
						continue
					} else {
						r.visitorHead(&b)
					}
				}
				kept = append(kept, b)
				continue
			}
			b.Held = 0
			// market musician v1.1: the next cell is in his clear front (his way was planned before he set up, or he stepped
			// aside into it): he plans again round it, out of it at once
			if goal := b.Path[len(b.Path)-1]; r.buskerInFront(b.Path[0]) && !r.buskerInFront(goal) {
				if path, ok := r.visitorPath(b.At, goal); ok && len(path) > 0 && !r.buskerInFront(path[0]) {
					b.Path = append([]behavior.Cell(nil), path...)
				}
			}
			if b.Phase == "leave" && len(b.Path) == 1 && !r.walkerOpen(w, b.Path[0], b.Serial) {
				// the last cell of his way out is taken (somebody steps in there): he is at the way out
				b.Path = nil
			}
		}
		if len(b.Path) > 0 {
			if r.walkerOpen(w, b.Path[0], b.Serial) {
				w.take(b.Path[0], b.Serial)
				b.Going, b.Wait, b.Blocked, b.Yield = true, r.visitorStepTicks(b)-1, 0, 0
				kept = append(kept, b)
				continue
			}
			// a body stands in the next cell
			b.Blocked++
			if !r.visitorPass(&b, w) && b.Phase == "leave" && b.Blocked > visitorStuckTicks {
				// no way out for minutes: let out where he stands (counted; the acceptance expects none)
				w.release(b)
				s.Ledger.Stuck++
				r.visitorLeave(slot)
				continue
			}
			kept = append(kept, b)
			continue
		}
		switch b.Phase {
		case "walk": // at the stall: he looks, then buys
			// market musician v1: at a listening place he listens; at the case he pays by its reader
			if b.Listen > 0 {
				l := r.world.Busker.Listeners
				b.Phase, b.Wait = "listen", buskerSpan(r.visitorDraw(b.Serial, "listen.ticks"), l.ListenTicks)
				break
			}
			if b.Paying {
				b.Phase, b.Wait = "pay", r.world.Busker.Listeners.PayTicks
				break
			}
			if b.Table > 0 { // food court v1.1: at his place at a table — he eats standing
				e := v.Tables.EatTicks
				b.Phase, b.Wait = "eat", e.Min+int64(r.visitorDraw(b.Serial, "eat")%uint64(e.Max-e.Min+1))
				break
			}
			b.Phase = "stand"
			// walkers v1, addendum 1: he looks at the showcase (or trades) standing still, as long as the place asks
			b.Wait = r.visitorDwell(b)
		case "stand":
			got := r.visitorBuy(slot, b.Serial, len(b.Stops), b.Target, b.At, b.Units)
			b.Bought += got
			// at a terminal he waits at the panel until the thing is dispensed and taken (torgomat v2: take_ticks of the place)
			if t := r.visitorTargetOf(b.Target); got > 0 && t != nil && t.TakeTicks > 0 {
				b.Phase, b.Wait = "take", t.TakeTicks
				break
			}
			if got > 0 && r.visitorToTable(&b, slot) {
				break
			}
			r.visitorHead(&b)
		case "take":
			r.visitorHead(&b)
		case "eat": // eaten: on to the rest of his list, or out
			r.visitorHead(&b)
		case "listen": // market musician v1: he has listened; some pay by the reader of the case
			r.buskerListened(&b)
		case "pay":
			r.buskerPaid(slot, b.Serial)
			r.visitorHead(&b)
		default: // at the way out
			w.release(b)
			s.Ledger.Out++
			if d := r.state.Tick - b.Since; b.Since > 0 && d > s.Ledger.Longest {
				s.Ledger.Longest = d
			}
			r.visitorLeave(slot)
			continue
		}
		kept = append(kept, b)
	}
	for i := len(kept); i < len(s.Bodies); i++ {
		s.Bodies[i] = visitorBody{}
	}
	s.Bodies = kept
	return nil
}

// advanceVisitorSupply: once a trading day, when the keeper first stands at the open stall (a peddler at the first stop
// of his round), every lot is laid out to its starting stock from the locked consignment. Goods only move: the
// consignment is finite, and a lot it cannot fill stays as it is.
func (r *Runtime) advanceVisitorSupply() error {
	v := r.world.Visitors
	s := &r.state.Visitors
	now := r.state.Life.Seconds
	day, clock := now/86400, now%86400
	var model inv.Model
	ready := false
	for _, rule := range v.Supply.Rules {
		if s.Supplied[rule.Shop] == day+1 {
			continue
		}
		var front *inv.Shopfront
		for i := range r.world.Inventory.Shopfronts {
			if r.world.Inventory.Shopfronts[i].ID == rule.Shop {
				front = &r.world.Inventory.Shopfronts[i]
			}
		}
		if front == nil || clock < front.OpenSecond || clock >= front.CloseSecond || !r.storefrontOpen(rule.Shop) {
			continue
		}
		if s.Supplied == nil {
			s.Supplied = map[string]int64{}
		}
		s.Supplied[rule.Shop] = day + 1
		have := map[string]int64{}
		var ids []string
		for id, i := range r.state.Inventory.Items {
			if i.Location.Kind != "store" || i.Owner != front.Owner {
				continue
			}
			switch i.Location.Store {
			case front.DisplayStore, front.ReserveStore:
				if i.ForSale {
					have[i.Definition] += i.Quantity
				}
			case rule.Store:
				ids = append(ids, id)
			}
		}
		sort.Strings(ids)
		var moves []inv.Move
		for _, lot := range rule.Lots {
			need := lot.Full - have[lot.Item]
			for _, id := range ids {
				if need <= 0 {
					break
				}
				i := r.state.Inventory.Items[id]
				if i.Definition != lot.Item {
					continue
				}
				q := min(i.Quantity, need)
				moves = append(moves, inv.Move{Item: id, Quantity: q, ExpectedRevision: i.Revision, To: inv.Location{Kind: "store", Store: front.DisplayStore}})
				need -= q
			}
		}
		if len(moves) == 0 {
			continue
		}
		if !ready {
			model, ready = r.inventoryModelFor(true), true
		}
		tx := inv.Transaction{Actor: front.Owner, Sequence: r.state.Inventory.Cursors[front.Owner].Sequence + 1, RequestTag: fmt.Sprintf("visitors/supply/%s/%d", rule.Shop, day), Moves: moves}
		if _, err := r.vendingApplyUnlocked(model, tx, rule.Store); err != nil {
			return fmt.Errorf("visitors: supply of %s: %w", rule.Shop, err)
		}
	}
	return nil
}

// appendVisitors: the walkers the hero sees on the level (nothing of their purses or lists).
func (r *Runtime) appendVisitors(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView) {
	if !r.visitorsOn() || hero == nil || hero.Level != r.world.Visitors.Level {
		return
	}
	for _, b := range r.state.Visitors.Bodies {
		if !viewSees(perception, int32(b.At.X), int32(b.At.Y)) {
			continue
		}
		row := &pb.PocVisitor{Id: b.Serial, Look: r.world.Visitors.Kinds[b.Kind].Look, X: int32(b.At.X), Y: int32(b.At.Y), NextX: int32(b.At.X), NextY: int32(b.At.Y), Phase: b.Phase}
		if b.Going && len(b.Path) > 0 {
			// walkers v1: only a walker in transit is drawn on his way into the next cell; one who waits stands
			row.NextX, row.NextY, row.StepTicks = int32(b.Path[0].X), int32(b.Path[0].Y), int32(b.Wait+1)
		} else if t := r.visitorTargetOf(b.Target); len(b.Path) == 0 && t != nil && t.Face != nil && (b.Phase == "stand" || b.Phase == "take") {
			row.FaceX, row.FaceY = t.Face.X, t.Face.Y
		}
		row.Act = r.visitorAct(b)
		// market musician v1: a listener faces the musician, a payer the reader of the case
		if !b.Going && len(b.Path) == 0 {
			if b.Phase == "listen" && b.Listen > 0 && b.Listen <= len(r.world.Busker.Spot.Listen) {
				f := r.world.Busker.Spot.Listen[b.Listen-1].Face
				row.FaceX, row.FaceY = f.X, f.Y
			}
			if b.Phase == "pay" {
				k := r.world.Busker.Spot
				row.FaceX, row.FaceY = float64(k.Case.X-b.At.X), float64(k.Case.Y-b.At.Y)
			}
		}
		// food court v1.1: what he carries from the counter to his table and eats there; eating, he faces the table and
		// the point of it in front of him is given
		if b.Table > 0 {
			row.Meal = b.Meal
		}
		if b.Phase == "eat" && b.Table > 0 && r.world.Visitors.Tables != nil && len(b.Path) == 0 && !b.Going {
			s := r.world.Visitors.Tables.Spots[b.Table-1]
			row.FaceX, row.FaceY = s.Face.X, s.Face.Y
			row.TableXMm, row.TableYMm, row.TableZMm = int32(s.Table.X*1000), int32(s.Table.Y*1000), int32(s.Table.Z*1000)
		}
		view.Visitors = append(view.Visitors, row)
	}
}

// visitorDwell: how long the walker looks at the place he has just reached (its own look, else the catalog's), by his draw;
// the same number while he stands there (the draw is by his serial and the stops still on his list).
func (r *Runtime) visitorDwell(b visitorBody) int64 {
	dwell := r.world.Visitors.DwellTicks
	if t := r.visitorTargetOf(b.Target); t != nil && t.DwellTicks != nil {
		dwell = *t.DwellTicks
	}
	return dwell.Min + int64(r.visitorDraw(b.Serial, fmt.Sprintf("dwell.%d", len(b.Stops)))%uint64(dwell.Max-dwell.Min+1))
}

// visitorAct (market people part C): what the walker does with the machine of his place now — the place's act of his phase,
// while he stands still on a standing cell of the place from which his hand reaches every touch of the act (the act's
// cells; on the others he waits beside the one who uses the machine, as his purchase goes through; not stepping aside, not
// on the way); nil otherwise. The phase began
// `length - Wait` ticks ago (Wait counts the phase down to 0: the look `visitorDwell` ticks, the take `take_ticks`), so the
// act's start and length come from the state as it is (nothing new is saved); the touches' ticks are resolved for this
// length (compiler/gamepoc/visitors.go VisitorTouchSpan, checked at build time for the shortest and longest phase).
func (r *Runtime) visitorAct(b visitorBody) *pb.PocMachineAct {
	// market musician v1: the palm on the reader of the case
	if b.Phase == "pay" {
		return r.buskerPayAct(b)
	}
	t := r.visitorTargetOf(b.Target)
	if t == nil || len(t.Acts) == 0 || b.Going || len(b.Path) > 0 || (b.Phase != "stand" && b.Phase != "take") {
		return nil
	}
	var act *visitorAct
	for i := range t.Acts {
		if t.Acts[i].Phase == b.Phase {
			act = &t.Acts[i]
		}
	}
	if act == nil {
		return nil
	}
	on := false
	for _, c := range act.Cells {
		on = on || (b.At.X == c.X && b.At.Y == c.Y)
	}
	if !on {
		return nil
	}
	length := t.TakeTicks
	if b.Phase == "stand" {
		length = r.visitorDwell(b)
	}
	if b.Wait < 0 || b.Wait > length {
		return nil
	}
	// Wait runs from `length` down to 0 and the phase ends on the tick after the one with Wait 0: the act lasts length+1
	// ticks, the next phase begins on its end tick (the take on the tick of the sale)
	n := length + 1
	out := &pb.PocMachineAct{Name: act.Act, Tick: r.state.Tick - (length - b.Wait), Ticks: int32(n)}
	for _, h := range act.Touches {
		from, to := int64(0), int64(0)
		if h.From != nil {
			from = *h.From
		} else {
			from = n - *h.FromEnd
		}
		if h.To != nil {
			to = *h.To
		} else {
			to = n - *h.ToEnd
		}
		out.Touches = append(out.Touches, &pb.PocMachineTouch{X: h.At.X, Y: h.At.Y, Z: h.At.Z, Hand: h.Hand, Part: h.Part, FromTick: int32(from), ToTick: int32(to)})
	}
	if b.Phase == "take" {
		out.Thing = r.visitorThing(t, out.Tick)
	}
	return out
}

// visitorThing: the scene of what the machine of the place handed over on the tick his take began — a terminal's sale of
// that tick, the public event its window plays; "" for a place that hands nothing or when another sale has followed.
func (r *Runtime) visitorThing(t *visitorTarget, tick int64) string {
	i, ok := r.vendingDisplayUnit(t.Store)
	if !ok {
		return ""
	}
	s := r.vendingUnitState(r.world.Vending.Units[i].ID)
	if s.SaleTick != tick || s.SaleItem == "" {
		return ""
	}
	return r.vendingItemScene(s.SaleItem)
}

func (r *Runtime) validateVisitorSave(s state) error {
	v := r.world.Visitors
	if v.Level == "" {
		if len(s.Visitors.Bodies) != 0 {
			return errors.New("visitors in a world without them")
		}
		return nil
	}
	if s.Visitors.Last < 0 || s.Visitors.Last > s.Life.Seconds || len(s.Visitors.Bodies) > v.MaxBodies {
		return errors.New("invalid visitors clock or crowd")
	}
	slots := map[int]bool{}
	// what a walker's references by name may name (owner 20.11: every saved reference to content is checked on load)
	categories, meals := map[string]bool{v.PeddlerCategory: true}, map[string]bool{}
	for _, k := range v.Kinds {
		for _, w := range k.Wants {
			categories[w.Category] = true
		}
	}
	for _, t := range v.Targets {
		categories[t.Category] = true
	}
	if v.Tables != nil {
		for _, m := range v.Tables.Meals {
			meals[m] = true
		}
	}
	// a walker may head for a peddler on his round ("peddler:<shop>")
	peddlerShops := map[string]bool{}
	for _, p := range r.world.Peddlers.Peddlers {
		peddlerShops[p.Shop] = true
	}
	for _, b := range s.Visitors.Bodies {
		eatMax, spots := int64(0), 0
		if v.Tables != nil {
			eatMax, spots = v.Tables.EatTicks.Max, len(v.Tables.Spots)
		}
		if b.Table < 0 || b.Table > spots || (b.Table > 0) != (b.Meal != "") || b.Phase == "eat" && b.Table == 0 {
			return errors.New("invalid visitor at a table")
		}
		if b.Slot < 1 || b.Slot >= len(v.Slots) || slots[b.Slot] || b.Kind < 0 || b.Kind >= len(v.Kinds) || b.Exit < 0 || b.Exit >= len(v.Entries) || b.Wait < 0 || b.Wait > max(v.DwellTicks.Max, r.visitorMaxTake(), r.visitorMaxDwell(), eatMax, r.buskerMaxWait())+max(v.MoveTicks, r.world.Busker.Listeners.SlowMoveTicks) ||
			(b.Phase != "walk" && b.Phase != "stand" && b.Phase != "take" && b.Phase != "leave" && b.Phase != "eat" && b.Phase != "listen" && b.Phase != "pay") || b.At.X < 0 || b.At.Y < 0 || len(b.Stops) > v.MaxStops || b.Units < 0 || b.Bought < 0 || b.Held < 0 || b.Held > visitorHoldTicks ||
			(b.Going && len(b.Path) == 0) || b.Blocked < 0 || b.Blocked > visitorStuckTicks+1 || b.Yield < 0 || b.Since < 0 || b.Since > s.Tick {
			return errors.New("invalid visitor")
		}
		slots[b.Slot] = true
		at := b.At
		for _, next := range b.Path {
			if manhattan(location(at), location(next)) > 1 && !r.visitorLinked(at, next) || next.X < 0 || next.Y < 0 {
				return errors.New("invalid visitor path")
			}
			at = next
		}
		if b.Target != "" && r.visitorTargetOf(b.Target) == nil && !(len(b.Target) > 8 && b.Target[:8] == "peddler:" && peddlerShops[b.Target[8:]]) {
			return fmt.Errorf("a visitor heads for %s, which the game no longer has", b.Target)
		}
		if b.Meal != "" && !meals[b.Meal] {
			return fmt.Errorf("a visitor eats %s, which the tables no longer serve", b.Meal)
		}
		for _, stop := range b.Stops {
			if !categories[stop.Category] {
				return fmt.Errorf("a visitor wants %s, which the game no longer sells", stop.Category)
			}
		}
	}
	l := s.Visitors.Ledger
	if l.Arrived < 0 || l.Walked < 0 || l.Unseen < 0 || l.Passed < 0 || l.Purchases < 0 || l.Spent < 0 || l.PurseIn < l.PurseOut || l.PurseOut < 0 || l.Walked+l.Unseen > l.Arrived {
		return errors.New("invalid visitors ledger")
	}
	return nil
}

// visitorLinked: two cells joined by a link of the level (a stair), not by a floor step.
func (r *Runtime) visitorLinked(a, b behavior.Cell) bool {
	for _, c := range r.world.Life.LinkIndex(r.world.Visitors.Level)[a] {
		if c == b {
			return true
		}
	}
	return false
}

// visitorMaxDwell: the longest look of any place with its own (a saved walker may be in it).
func (r *Runtime) visitorMaxDwell() int64 {
	var m int64
	for _, t := range r.world.Visitors.Targets {
		if t.DwellTicks != nil {
			m = max(m, t.DwellTicks.Max)
		}
	}
	return m
}

// visitorMaxTake: the longest wait after paying of any place (a saved walker may be in it).
func (r *Runtime) visitorMaxTake() int64 {
	var m int64
	for _, t := range r.world.Visitors.Targets {
		m = max(m, t.TakeTicks)
	}
	return m
}
