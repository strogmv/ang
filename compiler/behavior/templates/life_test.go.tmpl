func TestLifeSixLevelRoundTripUsesEveryPhysicalExitAndSurvivesTransitSave(t *testing.T){
 m:=lifeFixture();m.Locations=map[string]LifeLocation{};m.Edges=nil
 levels:=[]string{"home","station","work","service_stair","copper_ward","branch"}
 for _,id:=range levels{m.Locations[id]=LifeLocation{Name:id,Terrain:[]string{"#######","#.....#","#.....#","#.....#","#######"}}}
 pairs:=[][2]string{{"home","station"},{"station","work"},{"work","service_stair"},{"service_stair","copper_ward"},{"work","branch"}}
 for _,pair:=range pairs{m.Edges=append(m.Edges,
  LifeEdge{ID:pair[0]+"_"+pair[1],From:pair[0],To:pair[1],Exit:Cell{5,1},Entry:Cell{1,2},Mode:"walk",TravelSeconds:7,Seats:2},
  LifeEdge{ID:pair[1]+"_"+pair[0],From:pair[1],To:pair[0],Exit:Cell{1,1},Entry:Cell{5,2},Mode:"walk",TravelSeconds:7,Seats:2})}
 m.Actors=[]LifePerson{{ID:"traveller",Name:"Traveller",Steps:[]LifeStep{{Level:"home",At:Cell{2,2},Activity:"rest"}}}}
 if err:=m.Validate();err!=nil{t.Fatal(err)}
 s:=m.Start();s.ControlledActorID="traveller";a:=s.Actor("traveller");a.Manual=true;a.Arrived=false;a.OverrideLevel="copper_ward";a.OverrideAt=Cell{3,2}
 seen:=map[string]bool{};saved:=false;tick:=int64(0)
 advanceUntil:=func(level string){
  t.Helper()
  for count:=0;count<400;count++{
   tick++;before:=*s.Actor("traveller");s.Advance(m,tick);a=s.Actor("traveller")
   if err:=s.Validate(m,tick);err!=nil{t.Fatalf("tick%d: %v",tick,err)}
   if a.Trip!=nil{e:=m.Edge(a.Trip.Edge);if e==nil||a.Level!=e.From||a.Position!=e.Exit{t.Fatal("departure skipped its physical exit")};seen[e.ID]=true
    if !saved{raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var restored LifeState;if err=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)};if err=restored.Validate(m,tick);err!=nil{t.Fatal(err)};s=restored;saved=true}
   }
   a=s.Actor("traveller")
   if a.Level!=before.Level{if before.Trip==nil||s.Seconds<before.Trip.Arrival{t.Fatal("level changed without completing transit")};e:=m.Edge(before.Trip.Edge);if a.Level!=e.To||a.Position!=e.Entry{t.Fatal("arrived outside the real destination landing")}}
   if a.Level==level&&a.Trip==nil&&a.Arrived&&a.OverrideLevel==""{return}
  }
