// vendingCommand takes the hero's inventory commands that concern a terminal: "buy" of a showcase item (checks of the
// unit, the access profile and the funds, then the ordinary purchase), "sell" (buy-back) and "charge" (the dock hook).
// It returns false for every other command.
func (r *Runtime) vendingCommand(c *connection, q *pb.PocInventoryCommand, tag string, result *pb.PocInventoryResult) bool {
	v := r.world.Vending
	if len(v.Units) == 0 {
		return false
	}
	locale := ""
	if c != nil {
		locale = c.locale
	}
	unit := -1
	switch q.Action {
	case "buy":
		item, ok := r.state.Inventory.Items[q.ItemId]
		if !ok || item.Location.Kind != "store" {
			return false
		}
		if unit, ok = r.vendingDisplayUnit(item.Location.Store); !ok {
			return false
		}
	case "sell", "charge":
		var ok bool
		if unit, ok = r.vendingDisplayUnit(q.StoreId); !ok {
			result.Message = r.localText(locale, "ui.torgomat.refused.away", "ui.torgomat.refused.away")
			return true
		}
	default:
		return false
	}
	u := v.Units[unit]
	refuse := func(key, item string) bool {
		r.vendingHeroResult(unit, key, item, 0, true)
		result.Ok = false
		result.Message = r.vendingText(locale, key, item, 0)
		return true
	}
	if r.vendingHeroUnit() != unit {
		return refuse("ui.torgomat.refused.away", "")
	}
	if r.vendingInService(unit) {
		return refuse("ui.torgomat.refused.service", "")
	}
	model := r.inventoryModelFor(true)
	switch q.Action {
	case "buy":
		item := r.state.Inventory.Items[q.ItemId]
		var offer *vendingOffer
		for k := range u.Sells {
			if u.Sells[k].Item == item.Definition {
				offer = &u.Sells[k]
			}
		}
		if offer == nil {
			return refuse("ui.torgomat.refused.stock", item.Definition)
		}
		if len(offer.RequiresProfile) > 0 && !includesString(offer.RequiresProfile, r.actorProfileID(playerActorID)) {
			return refuse("ui.torgomat.refused.profile", item.Definition)
		}
		price, err := inv.Quote(model.Definitions[item.Definition], 1)
		if err != nil || r.vendingHeroBalance(model.Definitions[item.Definition].PriceUnit) < price {
			return refuse("ui.torgomat.refused.funds", item.Definition)
		}
		action := inv.Action{Actor: playerActorID, Kind: "buy", Item: q.ItemId, Store: q.StoreId, Quantity: 1, ExpectedRevision: q.ExpectedRevision, Sequence: q.Sequence, RequestTag: tag}
		if _, err := r.executeActorAction(action); err != nil {
			return refuse("ui.torgomat.refused.stock", item.Definition)
		}
		r.vendingServed(unit, false, item.Definition)
		r.vendingHeroResult(unit, "ui.torgomat.result.bought", item.Definition, price, false)
		result.Ok = true
		result.Message = r.vendingText(locale, "ui.torgomat.result.bought", item.Definition, price)
		return true
	case "charge":
		// Hook: the dock reads the binding of the gear and the chip of the person. No item carries a binding yet, so
		// every request is the honest refusal «no gear bound to your chip» (no money, no state change except the band).
		if !includesString(u.Services, "charge") {
			return refuse("ui.torgomat.refused.not_accepted", "")
		}
		return refuse("ui.torgomat.charge.none", "")
	}
	// sell: one unit of a carried item the unit accepts, at the system price, within the daily limit of the account
	item, ok := r.state.Inventory.Items[q.ItemId]
	if !ok || item.Revision != q.ExpectedRevision || !r.carried(item) || item.Quantity < 1 {
		return refuse("ui.torgomat.refused.not_accepted", "")
	}
	price, accepted := r.vendingBuyPrice(u, item.Definition)
	if !accepted {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	if r.vendingBuybackUsed(playerActorID)+price > v.BuybackDailyLimitMinor {
		return refuse("ui.torgomat.refused.limit", item.Definition)
	}
	if r.state.Paused {
		return refuse("ui.torgomat.refused.service", "")
	}
	hero, system, err := r.state.Inventory.TradeAccounts(model, playerActorID, v.Owner, v.Level, r.vendingAccountCurrency())
	if err != nil || system.ID != v.Account || system.Balance < price {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	tx := inv.Transaction{Actor: playerActorID, Sequence: q.Sequence, RequestTag: tag,
		Moves:    []inv.Move{{Item: item.ID, Quantity: 1, ExpectedRevision: item.Revision, To: inv.Location{Kind: "store", Store: u.IntakeStore}, ChangeOwner: true, Owner: v.Owner}},
		Payments: []inv.Payment{{From: system.ID, To: hero.ID, Currency: system.Currency, Amount: price, FromRevision: system.Revision, ToRevision: hero.Revision}}}
	if _, err := r.vendingApplyUnlocked(model, tx, u.IntakeStore); err != nil {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	if r.state.Vending.Buyback == nil {
		r.state.Vending.Buyback = map[string]vendingBuyback{}
	}
	day := r.vendingDayKey()
	b := r.state.Vending.Buyback[playerActorID]
	if b.Day != day {
		b = vendingBuyback{Day: day}
	}
	b.Minor += price
	r.state.Vending.Buyback[playerActorID] = b
	r.vendingServed(unit, true, item.Definition)
	r.vendingHeroResult(unit, "ui.torgomat.result.sold", item.Definition, price, false)
	r.focusActor(playerActorID, item.ID)
	result.Ok = true
	result.Message = r.vendingText(locale, "ui.torgomat.result.sold", item.Definition, price)
	return true
}

// The system's own locked stores (cassette, intake) open only inside its own transaction and lock again (as the owner's
// stock lock of a shop: inventory commerceApply).
func (r *Runtime) vendingApplyUnlocked(model inv.Model, tx inv.Transaction, stores ...string) (inv.Result, error) {
	locked := []string{}
	for _, id := range stores {
		if st, ok := r.state.Inventory.Stores[id]; ok && st.Locked {
			st.Locked = false
			r.state.Inventory.Stores[id] = st
			locked = append(locked, id)
		}
	}
	result, err := r.state.Inventory.Apply(model, tx)
	for _, id := range locked {
		st := r.state.Inventory.Stores[id]
		st.Locked = true
		r.state.Inventory.Stores[id] = st
	}
	return result, err
}
func (r *Runtime) vendingText(locale, key, definition string, minor int64) string {
	text := r.localText(locale, key, key)
	if definition != "" {
		d := r.world.Inventory.Definitions[definition]
		text = strings.ReplaceAll(text, "{item}", r.localText(locale, d.Name, d.Name))
	}
	return strings.ReplaceAll(text, "{crd}", strings.ReplaceAll(inv.FormatMoney(minor, r.world.Inventory.Currencies[r.vendingAccountCurrency()].Scale),".",r.localText(locale,"ui.format.decimal_separator",".")))
}

// advanceVending: the night round of the service cabinet (advanceVendingRobot) and the hero's result line fading when he
// leaves the panel.
func (r *Runtime) advanceVending() error {
	v := r.world.Vending
	if len(v.Units) == 0 || !r.state.Life.Enabled {
		return nil
	}
	hero := r.vendingHeroUnit()
	for i, u := range v.Units {
		s := r.vendingUnitState(u.ID)
		if hero != i && s.HeroKey != "" {
			s.HeroKey, s.HeroItem, s.HeroMinor = "", "", 0
			r.setVendingUnitState(u.ID, s)
		}
	}
	return r.advanceVendingRobot()
}

// advanceVendingRobot (addendum 1): the cabinet leaves its bay so that it has coupled when the first module's window opens,
// drives its route a cell at a time (it waits while a body stands in the next cell; after give_way_seconds the body has
// stepped aside), couples at the docking port on the block's end, loads the modules in the refill order — each its
// seconds_per_unit, the shelves filling one by one in fill_seconds — uncouples and drives home. A round the clock skipped
// whole (a new game, a long load) is done unseen: every module filled to its par at once. Nothing is created: the goods come
// from the module's own locked cassette.
func (r *Runtime) advanceVendingRobot() error {
	v := r.world.Vending
	rb := v.Robot
	if rb.OutLeg == nil || rb.BackLeg == nil || len(v.Refill.Order) == 0 {
		return nil
	}
	s := &r.state.Vending.Robot
	now := r.state.Life.Seconds
	day := r.vendingDayKey()
	dayStart := now - now%86400
	n := len(v.Refill.Order)
	depart := dayStart + v.Refill.FromSecond - rb.OutLeg.Seconds - rb.CoupleSeconds
	nominalEnd := dayStart + v.Refill.FromSecond + int64(n)*v.Refill.SecondsPerUnit
	for guard := 0; guard < 100000; guard++ {
		switch s.Phase {
		case "", "done":
			if s.Phase == "done" && s.Day == day {
				return nil
			}
			if now < depart {
				return nil
			}
			if now >= nominalEnd {
				// the round of today lies behind a jump of the clock: the modules are filled unseen
				for j := 0; j < n; j++ {
					if err := r.vendingFinishUnit(j, day, true); err != nil {
						return err
					}
				}
				*s = vendingRobotState{Day: day, Phase: "done", Waits: s.Waits}
				return nil
			}
			*s = vendingRobotState{Day: day, Phase: "out", Since: depart, Waits: s.Waits}
		case "out", "back":
			leg := rb.OutLeg
			if s.Phase == "back" {
				leg = rb.BackLeg
			}
			last := len(leg.Cells) - 1
			for s.Cell < last {
				due := s.Since + rb.CellSeconds
				if now < due {
					return nil
				}
				if r.vendingBlocked(leg.Cells[s.Cell+1]) && now-due < rb.GiveWaySeconds {
					if !s.Waited {
						s.Waits++
					}
					s.Waited = true
					return nil
				}
				if s.Waited {
					due = now
				}
				s.Cell, s.Since, s.Waited = s.Cell+1, due, false
			}
			if s.Phase == "out" {
				s.Phase, s.Cell = "couple", 0
			} else {
				s.Phase, s.Cell = "done", 0
				return nil
			}
		case "couple":
			if now < s.Since+rb.CoupleSeconds {
				return nil
			}
			s.Phase, s.Since, s.Unit, s.Steps, s.Moved = "load", s.Since+rb.CoupleSeconds, 0, 0, false
		case "load":
			i, _ := r.vendingUnitIndex(v.Refill.Order[s.Unit])
			u := v.Units[i]
			steps := max(1, len(u.Shelves))
			for s.Steps < steps && now >= s.Since+int64(s.Steps+1)*rb.FillSeconds/int64(steps) {
				moved, err := r.vendingRefill(u, s.Steps)
				if err != nil {
					return err
				}
				s.Moved = s.Moved || moved > 0
				s.Steps++
			}
			if now < s.Since+v.Refill.SecondsPerUnit {
				return nil
			}
			us := r.vendingUnitState(u.ID)
			us.RefillDay = day
			if s.Moved {
				us.Refills++
			}
			r.setVendingUnitState(u.ID, us)
			s.Unit, s.Since, s.Steps, s.Moved = s.Unit+1, s.Since+v.Refill.SecondsPerUnit, 0, false
			if s.Unit >= n {
				s.Phase, s.Unit = "uncouple", 0
			}
		case "uncouple":
			if now < s.Since+rb.CoupleSeconds {
				return nil
			}
			s.Phase, s.Cell, s.Since = "back", 0, s.Since+rb.CoupleSeconds
		default:
			*s = vendingRobotState{}
			return nil
		}
	}
	return nil
}

// vendingFinishUnit: every shelf step of the j-th module of the order at once (a round the clock skipped).
func (r *Runtime) vendingFinishUnit(j int, day int64, count bool) error {
	v := r.world.Vending
	i, ok := r.vendingUnitIndex(v.Refill.Order[j])
	if !ok {
		return nil
	}
	u := v.Units[i]
	moved := false
	for k := 0; k < max(1, len(u.Shelves)); k++ {
		m, err := r.vendingRefill(u, k)
		if err != nil {
			return err
		}
		moved = moved || m > 0
	}
	us := r.vendingUnitState(u.ID)
	us.RefillDay = day
	if moved && count {
		us.Refills++
	}
	r.setVendingUnitState(u.ID, us)
	return nil
}
func (r *Runtime) vendingUnitIndex(id string) (int, bool) {
	for i, u := range r.world.Vending.Units {
		if u.ID == id {
			return i, true
		}
	}
	return -1, false
}

// vendingBlocked: a body stands where the cabinet's body would be in that cell — the cell and clearance_cells round it (the
// hero, a person of the hall, a resident of the population, a visitor).
func (r *Runtime) vendingBlocked(c inv.Cell) bool {
	v := r.world.Vending
	k := v.Robot.ClearanceCells
	near := func(at behavior.Cell) bool { return absInt(at.X-c.X) <= k && absInt(at.Y-c.Y) <= k }
	for _, a := range r.state.Life.Actors {
		if a.Level == v.Level && a.OnFloor() && near(a.Position) {
			return true
		}
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.Level == v.Level && a.Trip == nil && near(a.Position) {
			return true
		}
	}
	if r.world.Visitors.Level == v.Level {
		for _, b := range r.state.Visitors.Bodies {
			if near(b.At) {
				return true
			}
		}
	}
	return false
}

// vendingRefill moves goods of the system from the cassette to the showcase (nothing is created): step k fills shelf k —
// its thing up to the shares of its shelves so far (the last shelf of a thing brings it to the par level). A unit without
// shelves is filled to the par level in one step.
func (r *Runtime) vendingRefill(u vendingUnit, step int) (int64, error) {
	v := r.world.Vending
	model := r.inventoryModelFor(true)
	var moves []inv.Move
	var moved int64
	ids := make([]string, 0)
	for id, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == u.CassetteStore && i.Owner == v.Owner {
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	targets := []vendingOffer{}
	if step < len(u.Shelves) {
		sh := u.Shelves[step]
		var upto int64
		for k := 0; k <= step; k++ {
			if u.Shelves[k].Item == sh.Item {
				upto += u.Shelves[k].Units
			}
		}
		targets = append(targets, vendingOffer{Item: sh.Item, Par: upto})
	} else {
		targets = u.Sells
	}
	for _, o := range targets {
		need := o.Par - r.vendingStock(u.DisplayStore, o.Item)
		for _, id := range ids {
			if need <= 0 || len(moves) >= 64 {
				break
			}
			i := r.state.Inventory.Items[id]
			if i.Definition != o.Item {
				continue
			}
			q := i.Quantity
			if q > need {
				q = need
			}
			moves = append(moves, inv.Move{Item: id, Quantity: q, ExpectedRevision: i.Revision, To: inv.Location{Kind: "store", Store: u.DisplayStore}})
			need -= q
			moved += q
		}
	}
	if len(moves) == 0 {
		return 0, nil
	}
	tx := inv.Transaction{Actor: v.Owner, Sequence: r.state.Inventory.Cursors[v.Owner].Sequence + 1, RequestTag: "vending/refill/" + u.ID, Moves: moves}
	if _, err := r.vendingApplyUnlocked(model, tx, u.CassetteStore); err != nil {
		return 0, err
	}
	// The cassette stock is the system's goods for sale already (locked and out of every reach until it is moved).
	return moved, nil
}
func (r *Runtime) vendingStock(store, definition string) int64 {
	var n int64
	for _, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == store && i.Definition == definition && !i.Hidden {
			n += i.Quantity
		}
	}
	return n
}

// appendVending: the public signals of every unit while the hero is on the hub floor; occupancy and the queue only for
// lanes the hero sees; the offers and the buy-back list only for the unit whose panel the hero stands at.
func (r *Runtime) appendVending(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView, locale string) {
	v := r.world.Vending
	if len(v.Units) == 0 || hero == nil || !hero.OnFloor() || hero.Level != v.Level {
		return
	}
	laneOf := map[inv.Cell]int{}
	approachOf := map[inv.Cell]int{}
	for i, u := range v.Units {
		for _, c := range u.Lane {
			laneOf[c] = i
		}
		for _, c := range u.Approach {
			approachOf[c] = i
		}
	}
	queue := make([]int32, len(v.Units))
	occupied := make([]bool, len(v.Units))
	count := func(level string, at behavior.Cell, ok bool) {
		if !ok || level != v.Level {
			return
		}
		c := inv.Cell{X: at.X, Y: at.Y}
		if i, in := laneOf[c]; in {
			queue[i]++
		}
		if i, in := approachOf[c]; in {
			occupied[i] = true
		}
	}
	for _, a := range r.state.Life.Actors {
		count(a.Level, a.Position, a.OnFloor())
	}
	for _, a := range r.state.Life.Population.Actors {
		count(a.Level, a.Position, a.Trip == nil)
	}
	active := r.vendingHeroUnit()
	scale := r.world.Inventory.Currencies[r.vendingAccountCurrency()].Scale
	for i, u := range v.Units {
		seen := viewSees(perception, int32(u.Panel.X), int32(u.Panel.Y))
		occ := occupied[i] && seen
		unit := &pb.PocVendingUnit{Id: u.ID, N: int32(u.N), Kind: u.Kind, Status: r.vendingStatus(i), LampPpm: int32(r.vendingLamp(i, occ)), Dock: u.Dock, Active: i == active, StoreId: u.DisplayStore, Services: append([]string(nil), u.Services...)}
		if seen {
			unit.Occupied, unit.Queue = occ, queue[i]
		}
		for _, o := range u.Sells {
			if r.vendingStock(u.DisplayStore, o.Item) > 0 {
				unit.Stocked = true
				break
			}
		}
		if i == active {
			r.appendVendingPanel(unit, i, locale, scale)
		}
		// torgomat v2: the goods behind the glass, the last dispense and buy-back, the service hatch
		unit.Shelves = r.vendingShelfRows(u)
		s := r.vendingUnitState(u.ID)
		if s.SaleSerial > 0 {
			unit.Sale = &pb.PocVendingEvent{Serial: s.SaleSerial, Definition: s.SaleItem, Resource: r.vendingItemScene(s.SaleItem), Tick: s.SaleTick, Ticks: int32(v.ServingTicks), Shelf: s.SaleShelf}
		}
		if s.IntakeSerial > 0 {
			in := v.Intake
			unit.Intake = &pb.PocVendingEvent{Serial: s.IntakeSerial, Definition: s.IntakeItem, Resource: r.vendingItemScene(s.IntakeItem), Tick: s.IntakeTick, Ticks: int32(in.LightTicks + in.OpenTicks + in.TakeTicks + in.CloseTicks)}
		}
		view.Vending = append(view.Vending, unit)
	}
	if pose, ok := r.vendingRobotPose(); ok && viewSees(perception, int32(math.Floor(pose.X*2)), int32(math.Floor(pose.Y*2))) {
		view.VendingRobot = pose
	}
}

// vendingRobotPose: where the service cabinet is now (its state): driving between two cells of its leg (standing before a body
// in its lane), coupled at the docking port, loading the module of the order, uncoupling. Not in its bay: nothing to send.
func (r *Runtime) vendingRobotPose() (*pb.PocVendingRobot, bool) {
	v := r.world.Vending
	rb := v.Robot
	s := r.state.Vending.Robot
	if rb.OutLeg == nil || rb.BackLeg == nil || !r.state.Life.Enabled {
		return nil, false
	}
	now := r.state.Life.Seconds
	out := &pb.PocVendingRobot{Resource: rb.Resource}
	switch s.Phase {
	case "out", "back":
		leg := rb.OutLeg
		if s.Phase == "back" {
			leg = rb.BackLeg
		}
		a := leg.Points[min(s.Cell, len(leg.Points)-1)]
		b := leg.Points[min(s.Cell+1, len(leg.Points)-1)]
		f := 0.0
		if !s.Waited {
			f = math.Max(0, math.Min(1, float64(now-s.Since)/float64(rb.CellSeconds)))
		}
		out.X, out.Y = a[0]+(b[0]-a[0])*f, a[1]+(b[1]-a[1])*f
		out.YawDegrees = math.Mod(math.Atan2(b[0]-a[0], b[1]-a[1])*180/math.Pi+360, 360)
		if a == b {
			out.YawDegrees = rb.Dock.YawDegrees
		}
		out.Phase = "drive"
		if s.Waited {
			out.Phase = "wait"
		}
		out.PhasePpm = int32(f * 1000000)
		return out, true
	case "couple", "load", "uncouple":
		out.X, out.Y, out.YawDegrees, out.Phase = rb.Dock.X, rb.Dock.Y, rb.Dock.YawDegrees, s.Phase
		span := rb.CoupleSeconds
		if s.Phase == "load" {
			span = v.Refill.SecondsPerUnit
			out.Unit = v.Refill.Order[min(s.Unit, len(v.Refill.Order)-1)]
		}
		out.PhasePpm = int32(max(int64(0), min(int64(1000000), (now-s.Since)*1000000/max(int64(1), span))))
		return out, true
	}
	return nil, false
}

func (r *Runtime) appendVendingPanel(unit *pb.PocVendingUnit, i int, locale string, scale int64) {
	v := r.world.Vending
	u := v.Units[i]
	model := r.inventoryModelFor(true)
	service := r.vendingInService(i)
	profile := r.actorProfileID(playerActorID)
	for _, o := range u.Sells {
		d := model.Definitions[o.Item]
		offer := &pb.PocVendingOffer{Definition: o.Item, Name: r.localText(locale, d.Name, d.Name)}
		best := inv.Item{}
		for id, it := range r.state.Inventory.Items {
			if it.Location.Kind != "store" || it.Location.Store != u.DisplayStore || it.Definition != o.Item || it.Hidden || !it.ForSale || it.Quantity < 1 {
				continue
			}
			offer.Quantity += it.Quantity
			if best.ID == "" || id < best.ID {
				best = it
			}
		}
		price, err := inv.Quote(d, 1)
		if err == nil {
			offer.Price = inv.FormatMoney(price, model.Currencies[d.PriceUnit].Scale) + " " + d.PriceUnit
		}
		offer.ItemId, offer.Revision = best.ID, best.Revision
		reason := ""
		switch {
		case service:
			reason = "ui.torgomat.refused.service"
		case len(o.RequiresProfile) > 0 && !includesString(o.RequiresProfile, profile):
			reason = "ui.torgomat.no_profile"
		case best.ID == "":
			reason = "ui.torgomat.out_of_stock"
		case err != nil || r.vendingHeroBalance(d.PriceUnit) < price:
			reason = "ui.torgomat.no_money"
		}
		offer.Ok = reason == ""
		if reason != "" {
			offer.Reason = r.localText(locale, reason, reason)
		}
		unit.Offers = append(unit.Offers, offer)
	}
	left := v.BuybackDailyLimitMinor - r.vendingBuybackUsed(playerActorID)
	if left < 0 {
		left = 0
	}
	unit.BuybackLeft = inv.FormatMoney(left, scale)
	ids := make([]string, 0)
	for id, it := range r.state.Inventory.Items {
		if _, accepted := r.vendingBuyPrice(u, it.Definition); accepted && r.carried(it) {
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	for _, id := range ids {
		it := r.state.Inventory.Items[id]
		d := model.Definitions[it.Definition]
		price, _ := r.vendingBuyPrice(u, it.Definition)
		offer := &pb.PocVendingOffer{ItemId: id, Definition: it.Definition, Name: r.localText(locale, d.Name, d.Name), Quantity: it.Quantity, Revision: it.Revision, Price: inv.FormatMoney(price, scale) + " " + r.vendingAccountCurrency()}
		reason := ""
		if service {
			reason = "ui.torgomat.refused.service"
		} else if price > left {
			reason = "ui.torgomat.refused.limit"
		}
		offer.Ok = reason == ""
		if reason != "" {
			offer.Reason = r.localText(locale, reason, reason)
		}
		unit.Buyback = append(unit.Buyback, offer)
	}
	if s := r.vendingUnitState(u.ID); s.HeroKey != "" {
		unit.Message = r.vendingText(locale, s.HeroKey, s.HeroItem, s.HeroMinor)
	}
}

// validateVendingSave: a loaded state may only name the units of the world, and no account may have sold back more
// than the daily limit.
func (r *Runtime) validateVendingSave(s state) error {
	v := r.world.Vending
	known := map[string]bool{}
	for _, u := range v.Units {
		known[u.ID] = true
	}
	for id := range s.Vending.Units {
		if !known[id] {
			return errVendingSave
		}
	}
	for _, b := range s.Vending.Buyback {
		if b.Minor < 0 || b.Minor > v.BuybackDailyLimitMinor || b.Day < 0 {
			return errVendingSave
		}
	}
	// the cabinet: a known phase, a cell of its leg, a module of the order
	rb, st := v.Robot, s.Vending.Robot
	switch st.Phase {
	case "", "done", "couple", "uncouple":
	case "out", "back":
		leg := rb.OutLeg
		if st.Phase == "back" {
			leg = rb.BackLeg
		}
		if leg == nil || st.Cell < 0 || st.Cell >= len(leg.Cells) {
			return errVendingSave
		}
	case "load":
		if st.Unit < 0 || st.Unit >= len(v.Refill.Order) || st.Steps < 0 {
			return errVendingSave
		}
	default:
		return errVendingSave
	}
	return nil
}

var errVendingSave = errors.New("vending state names an unknown unit, exceeds the daily buy-back limit or puts the service cabinet off its round")

// vendingFaceAgent (torgomat v2): a person who stands at the panel of a terminal for his purchase (his brain's place is the
// unit and he stands on its approach) faces the panel while the thing is dispensed.
func (r *Runtime) vendingFaceAgent(a *pb.PocAgentState, standing bool) {
	v := r.world.Vending
	if !standing || len(v.Units) == 0 {
		return
	}
	place := ""
	if p := r.state.Life.Actor(a.Id); p != nil {
		place = p.Brain.Place.ID
	} else {
		for i := range r.state.Life.Population.Actors {
			if r.state.Life.Population.Actors[i].ID == a.Id {
				place = r.state.Life.Population.Actors[i].Brain.Place.ID
				break
			}
		}
	}
	for _, u := range v.Units {
		if place != "vending."+u.ID {
			continue
		}
		for _, c := range u.Approach {
			if int32(c.X) == a.X && int32(c.Y) == a.Y {
				a.FaceX, a.FaceY = 0, 1
				if u.Face == "south" {
					a.FaceY = -1
				}
			}
		}
	}
}
