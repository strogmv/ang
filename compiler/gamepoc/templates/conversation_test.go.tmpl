// Anyone the hero can address opens the conversation column: a person with nothing special to say greets by his caste
// and may be left; nobody is sent to another screen.
func TestTalkWithAnyoneOpensTheSharedTalk(t *testing.T) {
	r := memoryDay(t, 5)
	shared := ""
	named := map[string]bool{playerActorID: true, r.world.CalendarEncounter.Actor: true}
	for _, def := range r.world.Memory.Talks {
		if def.Others {
			shared = def.Conversation
		}
		for _, p := range def.People {
			named[p] = true
		}
	}
	if shared == "" {
		t.Skip("no talk takes everyone else")
	}
	hero := r.state.Life.Actor(playerActorID)
	stranger := ""
	for i := range r.state.Life.Actors {
		a := &r.state.Life.Actors[i]
		if named[a.ID] || a.Level != r.world.Peddlers.Level || !a.OnFloor() || a.CombatHold || !r.bodyCanSpeak(a.ID) || r.talkSelfTrades(a.ID) {
			continue
		}
		if !r.talkNamed(a.ID) {
			// a person without a name in the content is not addressed: no text key ever stands for a name
			if _, ok := r.talkOf(a.ID); ok {
				t.Fatalf("%s has no name, yet a talk", a.ID)
			}
			continue
		}
		for _, c := range []inv.Cell{{X: a.Position.X + 1, Y: a.Position.Y}, {X: a.Position.X - 1, Y: a.Position.Y}, {X: a.Position.X, Y: a.Position.Y + 1}, {X: a.Position.X, Y: a.Position.Y - 1}} {
			if r.world.Life.Walks(a.Level, behavior.Cell{X: c.X, Y: c.Y}) {
				peddlerPlace(t, r, playerActorID, c)
				stranger = a.ID
				break
			}
		}
		if stranger != "" {
			break
		}
	}
	if stranger == "" {
		t.Fatal("nobody of the hall stands where the hero can walk up")
	}
	hero = r.state.Life.Actor(playerActorID)
	if conv, ok := r.talkAvailable(stranger); !ok || conv != shared {
		t.Fatalf("%s offers %q, %v", stranger, conv, ok)
	}
	sees := &pb.PocObserverView{}
	for y := 0; y < 256; y++ {
		sees.Cells = append(sees.Cells, strings.Repeat("2", 256))
	}
	view := &pb.PocLifeView{}
	r.appendTalkTargets(view, hero, sees, "ru")
	offered, twice := false, map[string]bool{}
	for _, target := range view.TalkTargets {
		if twice[target.Id] || target.Id == playerActorID {
			t.Fatalf("talk target %s twice, or the hero himself", target.Id)
		}
		twice[target.Id] = true
		offered = offered || target.Id == stranger && target.Name != ""
	}
	if !offered {
		t.Fatalf("%s beside the hero is no talk target", stranger)
	}
	tk := openWith(t, r, stranger)
	if len(tk.Lines) == 0 || tk.Lines[0].Kind != "line" || tk.Lines[0].Speaker != stranger || !strings.HasPrefix(tk.Lines[0].Text, "dlg.market.") {
		t.Fatalf("%s did not greet: %+v", stranger, tk.Lines)
	}
	v := dialogueView(t, r, "ru")
	if v.Lines[0].Text == "" || v.SpeakerName == "" {
		t.Fatalf("the greeting has no words or the speaker no name: %+v", v)
	}
	shown := shownIDs(v)
	if shown["trade"] || !shown["bye"] || v.Trade != nil {
		t.Fatalf("a person with nothing to sell offers %v", shown)
	}
	for _, c := range v.Choices {
		if c.TradeWith != "" {
			t.Fatalf("answer %s opens another window", c.Id)
		}
	}
	// the goods' commands are refused outside trade
	if err := tradeCommand(r, "conversation_buy", "anything"); err == nil {
		t.Fatal("a buy was taken in a talk with a person who sells nothing")
	}
	if err := choose(r, "bye"); err != nil {
		t.Fatal(err)
	}
}

