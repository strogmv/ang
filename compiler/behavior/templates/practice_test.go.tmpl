func practiceEvent(actor, rule string, sequence, tick int64) PracticeEvent {
	return PracticeEvent{Actor: actor, Rule: rule, Sequence: sequence, Tick: tick, Outcome: "success", QualityPermille: 1000}
}
func practiceApply(t *testing.T, s *PracticeState, m PracticeModel, e PracticeEvent) PracticeResult {
	t.Helper()
	result, err := s.Apply(m, e, e.Tick)
	if err != nil {
		t.Fatal(err)
	}
	if err := s.Validate(m, e.Tick); err != nil {
		t.Fatal(err)
	}
	return result
}
func TestPracticeTenUsesDevelopOnlyUsedSkillForEveryActor(t *testing.T) {
	m := practiceFixture()
	if err := m.Validate(); err != nil {
		t.Fatal(err)
	}
	s := m.Start()
	for n := int64(1); n <= 10; n++ {
		for _, actor := range []string{"hero", "worker"} {
			r := practiceApply(t, &s, m, practiceEvent(actor, "aimed_shot", n, n*2))
			if r.GainMilli <= 0 {
				t.Fatal("meaningful repeated use stopped developing")
			}
		}
	}
	if s.Value("hero", "shooting") <= 20 || s.Value("worker", "shooting") != s.Value("hero", "shooting") {
		t.Fatal("ten uses did not develop equal profiles equally")
	}
	if s.Value("hero", "melee") != 10 || s.Value("worker", "melee") != 10 {
		t.Fatal("unrelated skill received general XP")
	}
	before := s.Value("hero", "shooting")
	practiceApply(t, &s, m, practiceEvent("hero", "melee_exchange", 11, 22))
	if s.Value("hero", "shooting") != before || s.Actors["hero"].Skills["melee"].ValueMilli <= 10000 {
		t.Fatal("melee development affected wrong skill")
	}
}
func TestPracticeNoviceMasterFailureAndQuality(t *testing.T) {
	m := practiceFixture()
	p := m.Profiles["worker"]
	p.Skills["shooting"] = PracticeSkillInitial{Start: 70, Cap: 80}
	m.Profiles["worker"] = p
	s := m.Start()
	novice := practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 1, 2))
	master := practiceApply(t, &s, m, practiceEvent("worker", "aimed_shot", 1, 2))
	if novice.GainMilli <= master.GainMilli || master.GainMilli <= 0 {
		t.Fatal("novice/master diminishing growth missing")
	}
	fresh := m.Start()
	miss := practiceEvent("hero", "aimed_shot", 1, 2)
	miss.Outcome = "failure"
	failed := practiceApply(t, &fresh, m, miss)
	if failed.GainMilli <= 0 || failed.GainMilli >= novice.GainMilli {
		t.Fatal("meaningful failure must teach less")
	}
	fresh = m.Start()
	half := practiceEvent("hero", "aimed_shot", 1, 2)
	half.QualityPermille = 500
	low := practiceApply(t, &fresh, m, half)
	if low.GainMilli <= 0 || low.GainMilli >= novice.GainMilli {
		t.Fatal("quality multiplier ignored")
	}
}
func TestPracticeRepeatWindowCooldownAndZeroQuality(t *testing.T) {
	m := practiceFixture()
	m.Rules[0].RepeatWindowTicks = 10
	s := m.Start()
	first := practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 1, 0))
	before := s.Clone()
	if _, err := s.Apply(m, practiceEvent("hero", "aimed_shot", 2, 1), 1); err == nil {
		t.Fatal("cooldown accepted")
	}
	if !reflect.DeepEqual(s, before) {
		t.Fatal("cooldown rejection mutated state")
	}
	second := practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 2, 2))
	if second.GainMilli >= first.GainMilli {
		t.Fatal("repeat practice was not reduced")
	}
	oldRepeat := s.Actors["hero"].Repetitions["aimed_shot"]
	zero := practiceEvent("hero", "aimed_shot", 3, 2)
	zero.QualityPermille = 0
	result := practiceApply(t, &s, m, zero)
	if result.GainMilli != 0 || s.Actors["hero"].Repetitions["aimed_shot"] != oldRepeat {
		t.Fatal("zero-quality action consumed learning budget")
	}
	fourth := practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 4, 10))
	repeat := s.Actors["hero"].Repetitions["aimed_shot"]
	if repeat.Count != 1 || repeat.WindowStart != 10 || repeat.LastTick != 10 || fourth.GainMilli <= second.GainMilli {
		t.Fatal("simulation-time repetition window failed to reset")
	}
}
func TestPracticeReplayAndRejectedPayloadsAreAtomic(t *testing.T) {
	m := practiceFixture()
	s := m.Start()
	e := practiceEvent("hero", "aimed_shot", 1, 10)
	first := practiceApply(t, &s, m, e)
	before := s.Clone()
	replay, err := s.Apply(m, e, 15)
	if err != nil || !replay.Replayed || replay.GainMilli != first.GainMilli || !reflect.DeepEqual(s, before) {
		t.Fatal("later exact replay changed practice", err)
	}
	for _, tc := range []struct {
		name  string
		event PracticeEvent
		now   int64
	}{
		{"altered duplicate", PracticeEvent{Actor: "hero", Rule: "aimed_shot", Sequence: 1, Tick: 10, Outcome: "failure", QualityPermille: 1000}, 10},
		{"skip", practiceEvent("hero", "aimed_shot", 3, 12), 12},
		{"zero sequence", practiceEvent("hero", "aimed_shot", 0, 12), 12},
		{"clock backward", practiceEvent("hero", "aimed_shot", 2, 9), 9},
		{"future", practiceEvent("hero", "aimed_shot", 2, 20), 12},
		{"not current", practiceEvent("hero", "aimed_shot", 2, 12), 13},
		{"unknown rule", practiceEvent("hero", "missing", 2, 12), 12},
		{"unknown actor", practiceEvent("missing", "aimed_shot", 1, 12), 12},
		{"invalid outcome", PracticeEvent{Actor: "hero", Rule: "aimed_shot", Sequence: 2, Tick: 12, Outcome: "claimed", QualityPermille: 1000}, 12},
		{"invalid quality", PracticeEvent{Actor: "hero", Rule: "aimed_shot", Sequence: 2, Tick: 12, Outcome: "success", QualityPermille: 1001}, 12},
	} {
		t.Run(tc.name, func(t *testing.T) {
			if _, err := s.Apply(m, tc.event, tc.now); err == nil {
				t.Fatal("invalid event accepted")
			}
			if !reflect.DeepEqual(s, before) {
				t.Fatal("rejection mutated state")
			}
		})
	}
	practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 2, 12))
	before = s.Clone()
	if _, err := s.Apply(m, e, 14); err == nil || !reflect.DeepEqual(s, before) {
		t.Fatal("older receipt replayed after newer action")
	}
}
func TestPracticeCapsZeroMultipliersAndTinyPositiveSignals(t *testing.T) {
	for _, tc := range []struct {
		name   string
		modify func(*PracticeModel)
		zero   bool
	}{
		{"at cap", func(m *PracticeModel) {
			p := m.Profiles["hero"]
			p.Skills["shooting"] = PracticeSkillInitial{Start: 80, Cap: 80}
			m.Profiles["hero"] = p
		}, true},
		{"zero cap", func(m *PracticeModel) {
			p := m.Profiles["hero"]
			p.Skills["shooting"] = PracticeSkillInitial{}
			m.Profiles["hero"] = p
		}, true},
		{"zero learning", func(m *PracticeModel) { p := m.Profiles["hero"]; p.LearnPermille = 0; m.Profiles["hero"] = p }, true},
		{"zero base", func(m *PracticeModel) { m.Rules[0].BaseGainMilli = 0 }, true},
		{"zero outcome", func(m *PracticeModel) { m.Rules[0].SuccessPermille = 0 }, true},
		{"tiny positive", func(m *PracticeModel) {
			m.Rules[0].BaseGainMilli = 1
			m.Rules[0].SuccessPermille = 1
			p := m.Profiles["hero"]
			p.LearnPermille = 1
			m.Profiles["hero"] = p
		}, false},
	} {
		t.Run(tc.name, func(t *testing.T) {
			m := practiceFixture()
			tc.modify(&m)
			s := m.Start()
			r := practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 1, 2))
			if (r.GainMilli == 0) != tc.zero {
				t.Fatal("zero/positive signal rounding wrong", r)
			}
			if s.Actors["hero"].Repetitions["aimed_shot"].Count != 1 {
				t.Fatal("positive-quality action did not consume repetition")
			}
		})
	}
	m := practiceFixture()
	m.Rules[0].BaseGainMilli = 100000
	p := m.Profiles["hero"]
	p.LearnPermille = 3000
	m.Profiles["hero"] = p
	s := m.Start()
	r := practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 1, 2))
	if r.AfterMilli > 80000 {
		t.Fatal("gain exceeded individual cap")
	}
}
func TestPracticeSaveCloneAndMalformedState(t *testing.T) {
	m := practiceFixture()
	s := m.Start()
	practiceApply(t, &s, m, practiceEvent("hero", "aimed_shot", 1, 2))
	practiceApply(t, &s, m, practiceEvent("worker", "melee_exchange", 1, 2))
	clone := s.Clone()
	a := clone.Actors["hero"]
	a.Skills["shooting"] = PracticeSkill{}
	a.Repetitions["aimed_shot"] = PracticeRepeat{}
	clone.Actors["hero"] = a
	if s.Actors["hero"].Skills["shooting"].Cap != 80 || s.Actors["hero"].Repetitions["aimed_shot"].Count != 1 {
		t.Fatal("clone aliases actor maps")
	}
	raw, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var restored PracticeState
	if err := json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	if err := restored.Validate(m, 2); err != nil {
		t.Fatal(err)
	}
	for seq := int64(2); seq < 20; seq++ {
		e := practiceEvent("hero", "aimed_shot", seq, seq*2)
		practiceApply(t, &s, m, e)
		practiceApply(t, &restored, m, e)
	}
	if !reflect.DeepEqual(s, restored) {
		t.Fatal("save replay diverged")
	}
	for _, mutate := range []func(*PracticeState){
		func(s *PracticeState) { delete(s.Actors, "hero") },
		func(s *PracticeState) { s.Actors["ghost"] = s.Actors["hero"] },
		func(s *PracticeState) { a := s.Actors["hero"]; delete(a.Skills, "shooting"); s.Actors["hero"] = a },
		func(s *PracticeState) {
			a := s.Actors["hero"]
			v := a.Skills["shooting"]
			v.ValueMilli = 80001
			a.Skills["shooting"] = v
			s.Actors["hero"] = a
		},
		func(s *PracticeState) { a := s.Actors["hero"]; a.Sequence++; s.Actors["hero"] = a },
		func(s *PracticeState) { a := s.Actors["hero"]; a.LastResult.GainMilli++; s.Actors["hero"] = a },
		func(s *PracticeState) { a := s.Actors["hero"]; a.LastResult.Replayed = true; s.Actors["hero"] = a },
		func(s *PracticeState) {
			a := s.Actors["hero"]
			r := a.Repetitions["aimed_shot"]
			r.Count = 1000
			a.Repetitions["aimed_shot"] = r
			s.Actors["hero"] = a
		},
		func(s *PracticeState) {
			a := s.Actors["hero"]
			a.Repetitions["unknown"] = PracticeRepeat{Count: 1}
			s.Actors["hero"] = a
		},
		func(s *PracticeState) {
			a := s.Actors["hero"]
			r := a.Repetitions["aimed_shot"]
			r.LastTick = 1000
			a.Repetitions["aimed_shot"] = r
			s.Actors["hero"] = a
		},
	} {
		bad := s.Clone()
		mutate(&bad)
		if bad.Validate(m, 38) == nil {
			t.Fatal("malformed saved practice accepted")
		}
	}
	if err := (PracticeState{}).Validate(PracticeModel{}, 0); err != nil {
		t.Fatal("legacy empty model failed", err)
	}
}
func TestPracticeModelRejectsInvalidContent(t *testing.T) {
	for _, mutate := range []func(*PracticeModel){
		func(m *PracticeModel) { m.Skills = append(m.Skills, m.Skills[0]) },
		func(m *PracticeModel) { m.Rules = append(m.Rules, m.Rules[0]) },
		func(m *PracticeModel) { m.Rules[0].Skill = "unknown" },
		func(m *PracticeModel) { m.Rules[0].BaseGainMilli = 100001 },
		func(m *PracticeModel) { m.Rules[0].Difficulty = 101 },
		func(m *PracticeModel) { m.Rules[0].SuccessPermille = 1001 },
		func(m *PracticeModel) { m.Rules[0].FailurePermille = -1 },
		func(m *PracticeModel) { m.Rules[0].CooldownTicks = 0 },
		func(m *PracticeModel) { m.Rules[0].RepeatWindowTicks = 1 },
		func(m *PracticeModel) { m.Rules[0].RepeatScale = 0 },
		func(m *PracticeModel) { p := m.Profiles["hero"]; p.LearnPermille = 3001; m.Profiles["hero"] = p },
		func(m *PracticeModel) {
			p := m.Profiles["hero"]
			p.Skills["shooting"] = PracticeSkillInitial{Start: 81, Cap: 80}
			m.Profiles["hero"] = p
		},
		func(m *PracticeModel) {
			p := m.Profiles["hero"]
			p.Skills["unknown"] = PracticeSkillInitial{}
			m.Profiles["hero"] = p
		},
	} {
		m := practiceFixture()
		mutate(&m)
		if m.Validate() == nil {
			t.Fatal("invalid practice model accepted")
		}
	}
}
