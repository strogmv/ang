// Code generated by ANG. Combat panel and presentation hints (doc 96, owner 02.11 «бой в Player»).
// Every offered action is validated by executing it on a COPY of the encounter with the ordinary executor: the panel
// shows its AP and, when refused, the reason in words. The copy is discarded; no outcome, roll or hidden state of an
// opponent is published. Observed hand items and each public event's AP let Unity choose the clip of a seen blow.
package poc

import (
	"fmt"
	"math"
	"sort"
	"strconv"
	"strings"
 "errors"

	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

// combatPanelCache keeps the last computed options of one decision point (encounter, event, turn, AP, locale).
type combatPanelCache struct {
	key     string
	options []*pb.PocCombatOption
}

func (r *Runtime) appendCombatPanel(msg *pb.PocGameState, locale string) {
	r.appendWoundViews(msg,locale)
 r.appendGroundWeapons(msg)
 // A weapon in a seen hand is observable before any fight (scenes and encounters only: one inventory pass each).
	if r.world.PlayableID != "" || r.state.Combat.Active {
		for _, a := range msg.SceneAgents {
			if item, _, ok := r.equippedCombatItem(r.state.Inventory, a.Id); ok {
				a.HeldItem = item.Definition
			}
		}
	}
	view := msg.Combat
	if view == nil {
		return
	}
	s := &r.state.Combat
	// The decisive blow resolves the encounter inside the same command. Its public events stay on this level so the
	// client can still show what already happened; positions of the finished encounter are not republished.
	if !s.Active && s.ID != "" && s.LevelID == r.currentLevel() && len(view.Events) == 0 {
		for _, e := range r.state.CombatPublicEvents {
			view.Events = append(view.Events, &pb.PocCombatEvent{Type: e.Type,Mode:e.Mode, ActorId: e.ActorID, TargetId: e.TargetID, FromX: int32(e.From.X), FromY: int32(e.From.Y), ToX: int32(e.To.X), ToY: int32(e.To.Y), Amount: int32(e.Amount), Hit: e.Hit, Turn: e.Turn, Sequence: e.Sequence, BodyPart: e.BodyPart, ItemId: e.ItemID})
		}
	}
	if len(view.Events) == len(r.state.CombatPublicEvents) {
		for i, e := range r.state.CombatPublicEvents {
			if view.Events[i].Sequence == e.Sequence {
				view.Events[i].Ap = int32(e.AP)
			}
		}
	}
	if !s.Active {
		return
	}
	hero := s.Actor(playerActorID)
	for _, v := range view.Actors {
		a := s.Actor(v.Id)
		if a == nil {
			continue
		}
		// The weapon in a visible hand is observable; its ammunition, wear and AP are not.
		v.HeldItem = a.Weapon.ID
		if v.HeldItem == "" {
			v.HeldItem = "unarmed"
		}
		if d, ok := r.world.Inventory.Definitions[v.HeldItem]; ok {
			v.HeldName = r.localText(r.validLocale(locale), d.Name, d.Name)
		} else {
			v.HeldName = r.localText(r.validLocale(locale), "ui.combat.unarmed", "")
		}
		if hero != nil && a.ID != playerActorID {
			v.DistanceMm = int32(r.combatDistance(hero.Position, a.Position))
		}
	}
	if hero == nil {
		return
	}
	view.TurnAp = int32(r.world.CombatRuntime.Rules.APPerTurn)
	key := fmt.Sprintf("%s|%d|%d|%d|%d|%t|%s", s.ID, s.EventSeq, s.Turn, hero.AP, hero.ReservedAP, r.state.Paused, r.validLocale(locale))
	if r.combatPanel.key != key {
		r.combatPanel = combatPanelCache{key: key, options: r.combatOptions(r.validLocale(locale))}
	}
	view.Options = r.combatPanel.options
}

// combatTry executes one action on a copy and returns the AP it took from the hero.
func (r *Runtime) combatTry(action behavior.CombatAction) (int,error){
 trial:=&Runtime{world:r.world,state:r.snapshotState(),npcAccountIDs:r.npcAccountIDs};before:=trial.state.Combat.Actor(playerActorID);if before==nil{return 0,fmt.Errorf("missing hero")};ap:=before.AP;beforeSeq:=trial.state.Combat.EventSeq
 if err:=trial.performCombatAction(playerActorID,&action);err!=nil{return 0,err};spent:=0;found:=false;for _,e:=range trial.state.Combat.Events{if e.Sequence>beforeSeq&&e.ActorID==playerActorID&&(e.Type==action.Type||action.Type=="aid"&&e.Type=="bandage"||action.Type=="aid_continue"&&e.Type=="bandage"){spent+=e.AP;found=true}};if found{return spent,nil};after:=trial.state.Combat.Actor(playerActorID);if after!=nil{return max(0,ap-after.AP),nil};return 0,nil
}

func (r *Runtime) combatOptions(locale string) []*pb.PocCombatOption {
	s := &r.state.Combat
	hero := s.Actor(playerActorID)
	rules := r.world.CombatRuntime.Rules
	text := func(key string, pairs ...string) string {
		return strings.NewReplacer(pairs...).Replace(r.localText(locale, key, key))
	}
	meters := func(mm int) string {
		m := strconv.FormatFloat(float64(mm)/1000, 'f', 1, 64)
		if locale == "ru" {
			m = strings.Replace(m, ".", ",", 1)
		}
		return m
	}
	current := s.Current()
	ready := current != nil && current.ID == playerActorID && !r.state.Paused && hero.Able() && hero.StunTurns == 0
	needAP := func(need int) string {
		return text("error.combat.need_ap", "{need}", strconv.Itoa(need), "{have}", strconv.Itoa(hero.AP))
	}
	var out []*pb.PocCombatOption
	emit := func(group, id, label string, action behavior.CombatAction, nominal int, why func(error) string) {
		o := &pb.PocCombatOption{Id: id, Action: action.Type, TargetId: action.TargetID, Mode: action.Mode, ItemId: action.ItemID, X: int32(action.To.X), Y: int32(action.To.Y), Ap: int32(nominal), Label: label, Group: group}
		switch {
		case !ready:
			o.Reason = text("error.combat.not_turn")
		case action.Type == "end":
			o.Enabled = true
		default:
			ap, err := r.combatTry(action)
			if err == nil {
				o.Enabled, o.Ap = true, int32(ap)
			} else if nominal > hero.AP {
				o.Reason = needAP(nominal)
			} else {
				o.Reason = why(err)
			}
		}
		if group=="care"&&!o.Enabled{for _,prior:=range out{if prior.Group=="care"&&!prior.Enabled{return}}}
  if group=="care"&&!o.Enabled&&o.Reason!=text("wounds.aid.under_threat"){return}
  out = append(out, o)
	}
add:=func(group,id,label string,action behavior.CombatAction,nominal int,why func(error)string){
  if group=="attack"&&action.BodyPart=="torso"&&action.Mode!="stun_blow"&&action.Mode!="chokehold"{
   ids:=make([]string,0,len(rules.Targets));for part:=range rules.Targets{ids=append(ids,part)};sort.Strings(ids)
   for _,part:=range ids{q:=action;q.BodyPart=part;key:=id;if part!="torso"{key+="|"+part};emit(group,key,label,q,nominal+rules.Targets[part].ExtraAP,why)}
   return
  };emit(group,id,label,action,nominal,why)
 }
 other := func(error) string { return text("error.combat.other") }
	spent := hero.WeaponUsesLimited && hero.WeaponUsesRemaining == 0
	firearm := hero.Weapon.Magazine > 0
	// Visible, still fighting opponents, nearest first (server metric distance).
	var targets []behavior.Combatant
	for _, a := range s.Actors {
		if a.ID == playerActorID || a.Team == hero.Team || !a.Able() || !r.combatTargetVisible(a) {
			continue
		}
		targets = append(targets, a)
	}
	sort.SliceStable(targets, func(i, j int) bool {
		return r.combatDistance(hero.Position, targets[i].Position) < r.combatDistance(hero.Position, targets[j].Position)
	})
	for _, t := range targets {
		target := t
		dist := r.combatDistance(hero.Position, target.Position)
		attackWhy := func(error) string {
   if rules.CloseMM>0&&hero.Weapon.RangeMM>rules.CloseMM&&dist<=rules.CloseMM{return text("error.combat.cramped")}
			switch {
			case spent:
				return text("error.combat.weapon_spent")
			case firearm && hero.Ammo < 1:
				return text("error.combat.no_ammo")
			case dist > hero.Weapon.RangeMM:
				return text("error.combat.reach", "{dist}", meters(dist), "{reach}", meters(hero.Weapon.RangeMM))
			}
			return text("error.combat.line")
		}
		if firearm {
			add("attack", "attack.single."+target.ID, text("ui.combat.shoot"), behavior.CombatAction{Type: "attack", TargetID: target.ID, Mode: "single", BodyPart: "torso"}, hero.Weapon.AttackAP, attackWhy)
			if hero.Weapon.AimAP > 0 {
				add("attack", "attack.aimed."+target.ID, text("ui.combat.aimed_shot"), behavior.CombatAction{Type: "attack", TargetID: target.ID, Mode: "aimed", Aim: 1, BodyPart: "torso"}, hero.Weapon.AttackAP+hero.Weapon.AimAP, attackWhy)
			}
		} else {
			add("attack", "attack.single."+target.ID, text("ui.combat.mode.single"), behavior.CombatAction{Type: "attack", TargetID: target.ID, Mode: "single", BodyPart: "torso"}, hero.Weapon.AttackAP, attackWhy)
			if hero.Weapon.QuickAP > 0 {
				add("attack", "attack.quick."+target.ID, text("ui.combat.mode.quick"), behavior.CombatAction{Type: "attack", TargetID: target.ID, Mode: "quick", BodyPart: "torso"}, hero.Weapon.QuickAP, attackWhy)
			}
			if hero.Weapon.HeavyAP > 0 {
				add("attack", "attack.heavy."+target.ID, text("ui.combat.mode.heavy"), behavior.CombatAction{Type: "attack", TargetID: target.ID, Mode: "heavy", BodyPart: "torso"}, hero.Weapon.HeavyAP, attackWhy)
			}
		}

 if !firearm{
  for _,tech:=range []string{"stun_blow","chokehold"}{mode:=tech;add("attack","attack."+mode+"."+target.ID,text("wounds.technique."+mode),behavior.CombatAction{Type:"attack",TargetID:target.ID,Mode:mode,BodyPart:"head"},map[string]int{"stun_blow":max(3,hero.Weapon.HeavyAP),"chokehold":6}[mode],func(error)string{return text("error.combat.technique_position")})}
 }
		if at, ok := r.combatStep(hero, &target, false); ok {
			add("move", "move.approach."+target.ID, text("ui.combat.approach"), behavior.CombatAction{Type: "move", To: at}, 0, other)
		} else {
			reason := text("error.combat.no_step")
			if dist <= max(hero.Weapon.RangeMM, 1000) {
				reason = text("error.combat.adjacent")
			}
			out = append(out, &pb.PocCombatOption{Id: "move.approach." + target.ID, Action: "move", TargetId: target.ID, Label: text("ui.combat.approach"), Group: "move", Reason: reason})
		}
	}
	if len(targets) > 0 {
		if at, ok := r.combatStep(hero, &targets[0], true); ok {
			add("move", "move.retreat", text("ui.combat.retreat"), behavior.CombatAction{Type: "move", To: at}, 0, other)
		} else {
			out = append(out, &pb.PocCombatOption{Id: "move.retreat", Action: "move", Label: text("ui.combat.retreat"), Group: "move", Reason: text("error.combat.no_step")})
		}
	}
	for _, option := range r.combatEquipmentOptions(playerActorID) {
		name := r.world.Inventory.Definitions[option.Weapon.ID].Name
		add("weapon", "equip."+option.ID, text("ui.combat.equip_item", "{item}", r.localText(locale, name, name)), behavior.CombatAction{Type: "equip", ItemID: option.ID}, rules.EquipAP, other)
	}
	if firearm {
		add("weapon", "reload", text("ui.combat.reload"), behavior.CombatAction{Type: "reload"}, rules.ReloadAP, func(error) string {
			switch {
			case hero.Ammo >= hero.Weapon.Magazine:
				return text("error.combat.full")
			case hero.ReserveAmmo < 1:
				return text("error.combat.no_reserve")
			}
			return other(nil)
		})
	}

 if hero.Aid!=nil{add("care","aid_continue",text("ui.combat.aid_continue"),behavior.CombatAction{Type:"aid_continue"},min(hero.AP,hero.Aid.RemainingS),other)}
 body:=combatBody(*hero)
 careThreat:=r.woundCareThreatened(*hero)
 for wi,w:=range body.Wounds{
  if careThreat&&wi>0{break}
  for _,spec:=range []struct{kind,item string}{{"pressure",""},{"tourniquet","item.med_tourniquet"},{"packing","item.med_gauze"},{"dressing","item.med_patch"},{"medkit","item.medkit_guard"}}{
   if careThreat&&spec.kind!="pressure"{continue}
   q:=spec;z,_:=combatWounds.Zone(w.Zone)
   label:=text("wounds.aid."+q.kind)+" · "+text(z.Name)+" ("+w.ID+")"
   add("care","aid."+w.ID+"."+q.kind,label,behavior.CombatAction{Type:"aid",TargetID:w.ID,Mode:q.kind,ItemID:q.item},min(hero.AP,int(combatWounds.Aid.Kinds[q.kind].Seconds)),func(err error)string{var refusal textError;if errors.As(err,&refusal){return text(refusal.Key,"{aid}",text("wounds.aid."+q.kind))};return other(err)})
  }
 }

for _,d:=range []behavior.Cell{{1,0},{0,1},{-1,0},{0,-1}}{at:=behavior.Cell{X:hero.Position.X+d.X*max(1,rules.RollDistanceMM/max(1,r.world.Life.Locations[r.state.Combat.LevelID].CellMM)),Y:hero.Position.Y+d.Y*max(1,rules.RollDistanceMM/max(1,r.world.Life.Locations[r.state.Combat.LevelID].CellMM))};if _,err:=r.combatTry(behavior.CombatAction{Type:"roll",To:at});err==nil{add("move",fmt.Sprintf("roll.%d.%d",at.X,at.Y),text("ui.combat.roll"),behavior.CombatAction{Type:"roll",To:at},rules.RollAP,other)}}
 if !firearm {
		add("stance", "guard", text("ui.combat.guard"), behavior.CombatAction{Type: "guard"}, rules.GuardAP+1, func(error) string {
			if spent {
				return text("error.combat.weapon_spent")
			}
			return text("error.combat.guard_reserve", "{need}", strconv.Itoa(rules.GuardAP))
		})
	} else {
		out = append(out, &pb.PocCombatOption{Id: "guard", Action: "guard", Label: text("ui.combat.guard"), Group: "stance", Ap: int32(rules.GuardAP), Reason: text("error.combat.guard_firearm")})
	}
	if hero.Crouched || hero.Prone {
		add("stance", "stand", text("ui.combat.stand"), behavior.CombatAction{Type: "stand"}, rules.CrouchAP, func(error) string { return text("error.combat.stance") })
	} else {
		add("stance", "crouch", text("ui.combat.crouch"), behavior.CombatAction{Type: "crouch"}, rules.CrouchAP, func(error) string { return text("error.combat.stance") })
	}
	add("move","disengage",text("ui.combat.leave"),behavior.CombatAction{Type:"disengage"},0,func(error)string{return text("error.combat.break_distance")})
 add("turn", "end", text("ui.combat.end_turn"), behavior.CombatAction{Type: "end"}, 0, other)
	return out
}

// Body spacing (doc 96 v2, owner 02.11 «модели не держат дистанцию»; world.combat_spacing). A combat step never ENDS
// closer than body_mm to a standing participant, nor closer to an opponent than the low edge of the mover's hand-weapon
// band (a club fighter does not walk into knife distance). Enforced by the engine on every destination (EndSpacingMM);
// the panel's «Сблизиться» prefers a cell inside the band. Hit chance, damage and reach rules are not touched.
type combatSpacingBand struct {
	MinMM int `json:"min_mm"`
	MaxMM int `json:"max_mm"`
}
type combatSpacing struct {
 FallZones map[string]string `json:"fall_zones"`
 FallLengthMM int `json:"fall_length_mm"`
 FallWidthMM int `json:"fall_width_mm"`
 WeaponSweepMM int `json:"weapon_sweep_mm"`
 CameraYawDeg float64 `json:"camera_yaw_deg"`
	BodyMM  int                          `json:"body_mm"`
	Weapons map[string]combatSpacingBand `json:"weapons"`
}

func (r *Runtime) combatEndSpacingMM(mover, other behavior.Combatant) int {
 return r.world.CombatSpacing.BodyMM
}

// combatBand: where the hero wants to stand to strike — [low edge, min(high edge, reach)].
func (r *Runtime) combatBand(c *behavior.Combatant) (int, int) {
	sp := r.world.CombatSpacing
	lo, hi := sp.BodyMM, c.Weapon.RangeMM
	if b, ok := sp.Weapons[c.Weapon.ID]; ok {
		lo, hi = max(lo, b.MinMM), min(hi, b.MaxMM)
	}
	return lo, max(lo, hi)
}

// combatStep picks a destination the ordinary executor accepts this turn: at striking distance of the target, inside the
// weapon's spacing band when one is reachable (approach), or as far as possible from it (retreat). Candidates are cells
// on rays from the hero; each is checked on a copy of the encounter.
func (r *Runtime) combatStep(hero *behavior.Combatant, target *behavior.Combatant, away bool) (behavior.Cell, bool) {
	unit := r.world.Life.Locations[r.state.Combat.LevelID].CellMM
	if unit < 1 {
		unit = 1000
	}
	rules := r.world.CombatRuntime.Rules
	budget:=hero.AP;if away&&budget>1{budget--} // leave a command window before the automatic next turn
	reach := budget * 1000 / max(1, rules.MoveAPPerMeter) / unit
	if reach < 1 {
		return behavior.Cell{}, false
	}
	type candidate struct {
		at    behavior.Cell
		score int
	}
	seen := map[behavior.Cell]bool{hero.Position: true}
	lo, hi := r.combatBand(hero)
	var list []candidate
	consider := func(at behavior.Cell) {
		if seen[at] || at.X < 0 || at.Y < 0 {
			return
		}
		seen[at] = true
		d := r.combatDistance(at, target.Position)
		if away {
			list = append(list, candidate{at, -d})
		} else if d >= lo && d <= hi {
			list = append(list, candidate{at, r.combatDistance(hero.Position, at)})
		} else if d >= max(lo, 500) {
			list = append(list, candidate{at, 1000000 + d + r.combatDistance(hero.Position, at)/8})
		}
	}
	if away {
		for i := 0; i < 16; i++ {
			a := float64(i) * math.Pi / 8
			for k := reach; k >= 1; k-- {
				consider(behavior.Cell{X: hero.Position.X + int(math.Round(math.Cos(a)*float64(k))), Y: hero.Position.Y + int(math.Round(math.Sin(a)*float64(k)))})
			}
		}
	} else {
		for dy := -2; dy <= 2; dy++ {
			for dx := -2; dx <= 2; dx++ {
				consider(behavior.Cell{X: target.Position.X + dx, Y: target.Position.Y + dy})
			}
		}
		// Toward a target beyond this turn's AP: cells on the straight line, the farthest first.
		dx, dy := float64(target.Position.X-hero.Position.X), float64(target.Position.Y-hero.Position.Y)
		if n := math.Hypot(dx, dy); n > 0 {
			for k := 1; k <= reach && float64(k) < n; k++ {
				consider(behavior.Cell{X: hero.Position.X + int(math.Round(dx/n*float64(k))), Y: hero.Position.Y + int(math.Round(dy/n*float64(k)))})
			}
		}
	}
	space:=r.combatSpace(r.state.Combat)
 sort.SliceStable(list, func(i,j int)bool{if list[i].score!=list[j].score{return list[i].score<list[j].score};if space.PositionTie!=nil{return space.PositionTie(*hero,list[i].at)<space.PositionTie(*hero,list[j].at)};return false})
	now := r.combatDistance(hero.Position, target.Position)
	for n, c := range list {
		if n >= 200 {
			break
		}
		gain := now - r.combatDistance(c.at, target.Position)
		if away {
			gain = -gain
		}
		// Into the band a shorter step counts (from the edge of reach to the weapon's own distance).
		if gain < unit && (away || gain <= 0 || c.score >= 1000000) {
			continue
		}
		// A striking place must keep the target in sight (a diagonal past a corner may hide it).
		if !away && c.score < 1000000 && !r.combatObserverSees(r.state.Combat.LevelID, playerActorID, c.at, target.Position) {
			continue
		}
		if ap, err := r.combatTry(behavior.CombatAction{Type: "move", To: c.at}); err == nil && (!away||ap<=budget) {
			return c.at, true
		}
	}
	return behavior.Cell{}, false
}

func(r *Runtime)appendGroundWeapons(msg *pb.PocGameState){
 if !strings.HasPrefix(r.world.PlayableID,"combat_")&&r.state.Combat.ID==""{return}
 hero:=r.state.Life.Actor(playerActorID);if hero==nil||!hero.OnFloor(){return};level:=r.currentLevel()
 for _,id:=range combatItemKeys(r.state.Inventory){item:=r.state.Inventory.Items[id]
  if item.Location.Kind!="ground"||item.Location.Level!=level{continue};if _,ok:=r.world.CombatRuntime.Weapons[item.Definition];!ok{continue}
  at:=behavior.Cell{X:item.Location.At.X,Y:item.Location.At.Y};if !r.combatObserverSees(level,playerActorID,hero.Position,at){continue}
  owner:="";if item.Owner==playerActorID{owner=playerActorID}else{for _,agent:=range msg.SceneAgents{if agent.Id==item.Owner{owner=item.Owner;break}}}
  msg.GroundWeapons=append(msg.GroundWeapons,&pb.PocGroundWeapon{ItemId:id,Definition:item.Definition,X:int32(at.X),Y:int32(at.Y),OwnerId:owner})
 }
}
