// Code generated by ANG. Coarse combat areas over the existing physical navigation.
package behavior

import (
 "errors"
 "fmt"
 "math"
 "sort"
)

// Old saves have no GridReady flag and retain their valid physical positions.
// New encounters, joins and the load migration must clear shared tactical cells
// with ordinary, paid path steps before setting the stricter invariant.
func(s CombatState) ValidateGridOccupancy(space CombatSpace)error{
 if !s.Active||space.Grid==nil{return nil}
 occupied:=map[Cell]string{}
 for _,a:=range s.Actors{key,ok:=space.Grid.Tile[a.Position];if !ok{return fmt.Errorf("combatant %s outside grid",a.ID)};if other:=occupied[key];other!=""{return fmt.Errorf("combat cell shared by %s and %s",other,a.ID)};occupied[key]=a.ID}
 return nil
}
// Only newly joining participants may borrow clearance AP from their first
// turn. Existing participants still need their own current/reserved AP.
func(s *CombatState) ResolveGridConflicts(space CombatSpace,r CombatRules,joiners ...string)error{
 if space.Grid==nil||!s.Active{s.GridReady=true;return nil}
 draft:=s.Clone();current:=draft.CurrentIndex;draft.arranging=true;draft.GridReady=false
 for pass:=0;pass<len(draft.Actors);pass++{
  keeper:=map[Cell]int{};left,right:=-1,-1
  for i,a:=range draft.Actors{key,ok:=space.Grid.Tile[a.Position];if !ok{return errors.New("combat body outside tactical grid")};if k,exists:=keeper[key];exists{left,right=k,i;break};keeper[key]=i}
  if left<0{draft.arranging=false;draft.GridReady=true;draft.CurrentIndex=current;if a:=draft.Current();a!=nil&&(a.AP==0||!a.Able()||a.StunTurns>0){draft.nextTurn(r,space)};if err:=draft.ValidateGridOccupancy(space);err!=nil{return err};*s=draft;return nil}
  moved:=false
  // Preserve the first body's place where possible; an immobile body keeps its
  // cell and the other participant makes the same checked clearance move.
  order:=[]int{right,left};if current==left{order=[]int{left,right}}
  for _,i:=range order{
   a:=draft.Actors[i];if !a.Able()||a.StunTurns>0||len(a.Body)>0&&!a.BodyCanWalk{continue}
   if a.AP==0&&a.ReservedAP>0{a.AP=a.ReservedAP;a.ReservedAP=0;a.Guarding=false;a.Overwatch=false;draft.Actors[i]=a}
   borrowed:=false
   if a.AP==0&&i!=current{for _,id:=range joiners{if a.ID==id{
    penalty:=a.WoundAPPenalty();if r.SuppressionPerAP>0{penalty+=a.Suppression/r.SuppressionPerAP}
    a.AP=max(0,max(1,r.APPerTurn-penalty)-a.GridSetupAP)
    borrowed=a.AP>0;draft.Actors[i]=a;break
   }}}
   if a.AP<1{continue}
   draft.Observe(space,r)
   options,_:=draft.reachable(space,r,a,a.AP,false)
   contact:=map[Cell]bool{};for _,p:=range options{for _,c:=range a.Contacts{if !c.Visible||c.Checked||c.Team==a.Team{continue};target:=draft.Actor(c.SubjectID);if target!=nil&&space.rangeMM(p.At,c.Position)<=a.Weapon.RangeMM&&space.ballisticClear(p.At,c.Position,a,*target,"torso"){contact[p.At]=true}}}
   sort.SliceStable(options,func(x,y int)bool{p,q:=options[x],options[y];if p.AP!=q.AP{return p.AP<q.AP};if contact[p.At]!=contact[q.At]{return contact[p.At]};dp,dq:=space.rangeMM(a.Position,p.At),space.rangeMM(a.Position,q.At);if dp!=dq{return dp<dq};if p.At.Y!=q.At.Y{return p.At.Y<q.At.Y};return p.At.X<q.At.X})
   for _,at:=range options{if space.Grid.Same(a.Position,at.At){continue};draft.CurrentIndex=i;seq:=draft.EventSeq
    if err:=draft.Execute(space,r,a.ID,CombatAction{Type:"move",To:at.At});err!=nil{continue}
    if space.Grid.Same(a.Position,draft.Actor(a.ID).Position){continue}
    if i!=current{draft.Actor(a.ID).GridSetupAP+=max(0,a.AP-draft.Actor(a.ID).AP)}
    for n:=range draft.Events{if draft.Events[n].Sequence>seq&&draft.Events[n].Type=="move"{draft.Events[n].Reason="physical clearance of a shared combat cell"}}
    moved=true;break
   }
   // Unspent credit is never usable for an attack or another free action.
   // Charge only the checked move; beginTurn repays GridSetupAP exactly once.
   if borrowed{draft.Actor(a.ID).AP=0}
   if moved{break}
  }
  if !moved{return errors.New("no physical path to separate combat cells")}
 }
 return errors.New("combat cell separation did not converge")
}

type CombatGridRules struct {
 CellMM int `json:"cell_mm"`
 Diagonal string `json:"diagonal"`
}
type CombatCoverRules struct {
 HalfPenalty float64 `json:"half_penalty"`
 FullPenalty float64 `json:"full_penalty"`
 CrouchBonus float64 `json:"crouch_bonus"`
 ProneBonus float64 `json:"prone_bonus"`
 FlankBonus float64 `json:"flank_bonus"`
 RearBonus float64 `json:"rear_bonus"`
 ProbeCells int `json:"probe_cells"`
 RaysMM []int `json:"rays_mm"`
 HalfRays int `json:"half_rays"`
 FullRays int `json:"full_rays"`
}
func(r CombatRules) ValidateGridCover()error{
 g,c:=r.Grid,r.CoverRules
 if g.CellMM!=0&&(g.CellMM!=1000&&g.CellMM!=1500||g.Diagonal!="orthogonal"){return errors.New("invalid combat grid")}
 for _,n:=range []float64{c.HalfPenalty,c.FullPenalty,c.CrouchBonus,c.ProneBonus,c.FlankBonus,c.RearBonus}{if math.IsNaN(n)||math.IsInf(n,0)||n<0||n>1{return errors.New("invalid cover bonus")}}
 if c.FullPenalty==0{return nil} // independent legacy algorithm fixtures
 if c.FullPenalty<c.HalfPenalty||c.RearBonus<c.FlankBonus||c.ProneBonus<c.CrouchBonus||c.ProbeCells<1||c.ProbeCells>3||len(c.RaysMM)!=3||c.HalfRays<1||c.FullRays<=c.HalfRays||c.FullRays>3{return errors.New("invalid cover classes")}
 for i,h:=range c.RaysMM{if h<1||i>0&&h<=c.RaysMM[i-1]{return errors.New("invalid cover rays")}}
 return nil
}
// Members of a tile are connected navigation cells in one metric bucket, on one
// surface. Stairs retain their authored links. A wall dividing a bucket splits
// it, so grouping never bridges a wall or joins stacked decks.
type CombatGrid struct {
 CellMM int
 Tile map[Cell]Cell
 Members map[Cell][]Cell
}
func DeriveCombatGrid(space Space,navMM int,r CombatGridRules,locate func(Cell)(Cell,int,int,bool))*CombatGrid{
 if r.CellMM==0||navMM<1||r.CellMM%navMM!=0{return nil}
 stride:=r.CellMM/navMM
 type bucket struct{x,y,layer int}
 buckets:=map[Cell]bucket{}
 cells:=[]Cell{}
 for y:=0;y<space.Height;y++{for x:=0;x<space.Width;x++{p:=Cell{x,y};if space.Walkable==nil||!space.Walkable(p)||space.Blocked[p]{continue};plan,layer:=p,0
 if locate!=nil{var ok bool;plan,_,layer,ok=locate(p);if !ok{continue}}
 buckets[p]=bucket{plan.X/stride,plan.Y/stride,layer};cells=append(cells,p)
 }}
 g:=&CombatGrid{r.CellMM,map[Cell]Cell{},map[Cell][]Cell{}}
 for _,start:=range cells{if _,ok:=g.Tile[start];ok{continue};key:=start;g.Tile[start]=key;queue:=[]Cell{start}
 for len(queue)>0{at:=queue[0];queue=queue[1:];g.Members[key]=append(g.Members[key],at)
 ns:=[]Cell{{at.X+1,at.Y},{at.X,at.Y+1},{at.X-1,at.Y},{at.X,at.Y-1}};ns=append(ns,space.Links[at]...)
 for _,next:=range ns{b,ok:=buckets[next];if !ok||b!=buckets[start]{continue};if _,seen:=g.Tile[next];seen{continue};g.Tile[next]=key;queue=append(queue,next)}
 }
 sort.Slice(g.Members[key],func(i,j int)bool{a,b:=g.Members[key][i],g.Members[key][j];return a.Y<b.Y||a.Y==b.Y&&a.X<b.X})
 }
 return g
}
func(g *CombatGrid) Same(a,b Cell)bool{ka,oa:=g.Tile[a];kb,ob:=g.Tile[b];return oa&&ob&&ka==kb}
func(s CombatSpace) moveMM(a,b Cell)int{
 if s.Grid==nil{return s.rangeMM(a,b)}
 if s.Grid.Same(a,b){return 0}
 return max(s.Grid.CellMM,s.rangeMM(a,b))
}
func(s CombatSpace) movementHeading(from,to Cell)Cell{
 if s.GridDirection!=nil{x,y:=s.GridDirection(to,from);return Cell{X:x,Y:y}}
 return Cell{X:to.X-from.X,Y:to.Y-from.Y}
}
// A tile's contact anchor uses ONLY personally seen hostile positions. It never
// raises a weapon's reach: a knife still needs a clear 900 mm physical strike.
// This is body placement inside an area, not a second fine movement grid.
func(s CombatState) gridAnchor(space CombatSpace,r CombatRules,a Combatant,key Cell,planning bool)(Cell,bool){
 if space.Grid==nil{return key,true}
 reference:=key
 if space.Grid.Same(key,a.Position){reference=a.Position}
 members:=space.Grid.Members[key]
 best,score,found:=Cell{},math.Inf(1),false
 for _,at:=range members{
 if !space.standable(at)||s.occupied(at,a.ID,space,r,a.Position,planning)||space.occupiedAt(a,at,r,planning)||s.crowded(space,r,a,at,planning)||space.EndPositionClear!=nil&&!space.EndPositionClear(a,at){continue}
 value:=float64(space.rangeMM(reference,at))
 if combatWeaponKind(a.Weapon)!="firearm"{for _,c:=range a.Contacts{if !c.Visible||c.Checked||c.Team==a.Team{continue};distance:=space.rangeMM(at,c.Position);target:=Combatant{ID:c.SubjectID,Position:c.Position};if known:=s.Actor(c.SubjectID);known!=nil{target=*known;target.Position=c.Position};if distance<=a.Weapon.RangeMM&&space.ballisticClear(at,c.Position,a,target,"torso"){value-=100000-float64(distance)}}}
 if value<score{best,score,found=at,value,true}
 }
 return best,found
}
func(s CombatState) gridEndpoints(space CombatSpace,r CombatRules,a Combatant,planning bool)func(Cell)bool{
 cache:=map[Cell]Cell{};checked:=map[Cell]bool{};valid:=map[Cell]bool{}
 return func(at Cell)bool{if space.Grid==nil{return true};key,exists:=space.Grid.Tile[at];if !exists{return false};if !checked[key]{cache[key],valid[key]=s.gridAnchor(space,r,a,key,planning);checked[key]=true};return valid[key]&&cache[key]==at}
}
func(s CombatState) SnapCombatCell(space CombatSpace,r CombatRules,a Combatant,to Cell,planning bool)Cell{
 if space.Grid==nil{return to}
 key,ok:=space.Grid.Tile[to];if !ok{return to}
 if at,valid:=s.gridAnchor(space,r,a,key,planning);valid{return at}
 return to
}
// Existing server obstacle bounds include low counters deliberately marked
// blocks_sight=false. They still provide ballistic cover; no geometry is invented.
type CombatCoverObstacle struct{
 ID string `json:"id"`
 Rect DeckRect `json:"rect"`
 BottomMM int `json:"bottom_mm"`
 TopMM int `json:"top_mm"`
 BlocksMovement bool `json:"blocks_movement"`
}
func(v *DeckVolume)coverObstacleAt(at Cell,z int)bool{
 for _,o:=range v.Obstacles{if o.BlocksMovement&&at.X>=o.Rect.X&&at.X<o.Rect.X+o.Rect.W&&at.Y>=o.Rect.Y&&at.Y<o.Rect.Y+o.Rect.H&&z>=o.BottomMM&&z<=o.TopMM{return true}}
 return false
}
// Side order is east, south, west, north in the physical plan, never nav bands.
func(v *DeckVolume) CombatCoverSides(at Cell,r CombatCoverRules)[4]int{
 var out [4]int
 p,h,_,ok:=v.Locate(at);if !ok{return out}
 for i,d:=range []Cell{{1,0},{0,1},{-1,0},{0,-1}}{
 count:=0
 for _,height:=range r.RaysMM{
 blocked:=false
 for step:=1;step<=r.ProbeCells;step++{to:=Cell{p.X+d.X*step,p.Y+d.Y*step};if to.X<0||to.Y<0||to.X>=v.PlanWidth||to.Y>=v.PlanDepth{break};if v.coverObstacleAt(to,h+height)||!v.combatPhysicalClear(p,float64(h+height),to,float64(h+height)){blocked=true;break}}
 if blocked{count++}
 }
 if count>=r.FullRays{out[i]=2}else if count>=r.HalfRays{out[i]=1}
 }
 return out
}
func(s CombatSpace) directionalClass(from,to Cell)int{
 if s.CoverSides==nil{return 0};sides:=s.CoverSides(to)
 // Host returns the direction in physical coordinates even on stacked decks.
 dx,dy:=from.X-to.X,from.Y-to.Y
 if s.GridDirection!=nil{dx,dy=s.GridDirection(from,to)}
 if dx==0&&dy==0{return 0}
 side:=0;if combatAbs(dy)>combatAbs(dx){side=1;if dy<0{side=3}}else if dx<0{side=2}
 return sides[side]
}
func(s CombatSpace) coverPenalty(r CombatRules,from Cell,target Combatant)float64{
 class:=s.directionalClass(from,target.Position)
 if class==0{return 0} // a shot from the open side is a flank
 value:=r.CoverRules.HalfPenalty;if class==2{value=r.CoverRules.FullPenalty}
 if target.Prone{value+=r.CoverRules.ProneBonus}else if target.Crouched{value+=r.CoverRules.CrouchBonus}
 return math.Min(1,value)
}
func(s CombatSpace) attackSide(a,b Combatant)string{if s.AttackAngle!=nil{return s.AttackAngle(a,b)};dx,dy:=a.Position.X-b.Position.X,a.Position.Y-b.Position.Y;if s.GridDirection!=nil{dx,dy=s.GridDirection(a.Position,b.Position)};norm:=math.Hypot(float64(dx),float64(dy))*math.Hypot(float64(b.Facing.X),float64(b.Facing.Y));if norm==0{return "front"};dot:=float64(dx*b.Facing.X+dy*b.Facing.Y)/norm;if dot< -0.5{return "rear"};if dot<0.5{return "flank"};return "front"}
// AttackReason is a public geometric explanation, without the target's private AP.
func(s CombatState) AttackReason(space CombatSpace,r CombatRules,actorID,targetID string,from Cell)string{
 a,b:=s.Actor(actorID),s.Actor(targetID);if a==nil||b==nil{return ""}
 if combatWeaponKind(a.Weapon)!="firearm"{at:=*a;at.Position=from;return space.attackSide(at,*b)}
 switch space.directionalClass(from,b.Position){case 1:return "half";case 2:return "full"}
 if space.CoverSides!=nil{for _,n:=range space.CoverSides(b.Position){if n>0{return "flanked"}}}
 return "open"
}
// Reach costs are also used for the two movement tints. Keep AP for the selected
// weapon's ordinary attack, including the mover's wound/suppression movement scale.
func(s CombatState) MoveReachCosts(space CombatSpace,r CombatRules,id string)map[Cell]int{out,_:=s.MoveReachCostSearch(space,r,id);return out}
// MoveReachCostSearch also reports whether the bounded observed search was cut.
// A truncated preview cannot safely exclude a destination from execution probes.
func(s CombatState) MoveReachCostSearch(space CombatSpace,r CombatRules,id string)(map[Cell]int,bool){
 seen:=s.Clone();seen.Observe(space,r);a:=seen.Actor(id);out:=map[Cell]int{};if a==nil||!a.Able()||a.StunTurns>0||a.AP<1{return out,false}
 options,cut:=seen.reachable(space,r,*a,a.AP,true);for _,p:=range options{out[p.At]=p.AP};return out,cut
}

// Planning sees only individually observed ambient bodies. Coarse occupancy must
// not turn a visible corner of an area into a radar for its hidden occupant.
func(s CombatSpace)occupiedAt(a Combatant,at Cell,r CombatRules,planning bool)bool{
 if planning&&s.PlanningOccupied!=nil{return s.PlanningOccupied(a,at)}
 if !planning&&s.ExecutionOccupied!=nil{return s.ExecutionOccupied(a,at)}
 return s.Space.Occupied!=nil&&(!planning||s.visible(a.Position,at,r))&&s.Space.Occupied(at)
}

func(v *DeckVolume)coverSegmentClear(from,to DeckPointMM)bool{
 for _,o:=range v.Obstacles{if !o.BlocksMovement{continue};box:=DeckRayBox{Min:DeckPointMM{X:float64(o.Rect.X)*deckCellMM,Y:float64(o.Rect.Y)*deckCellMM,Z:float64(o.BottomMM)},Max:DeckPointMM{X:float64(o.Rect.X+o.Rect.W)*deckCellMM,Y:float64(o.Rect.Y+o.Rect.H)*deckCellMM,Z:float64(o.TopMM)}};if illuminationBoxHit(from,to,box){return false}}
 return true
}
// Moving door leaves and static low cover use the same physical body ray.
func(v *DeckVolume)CombatRayClearMM(from,to DeckPointMM,dynamic []DeckRayBox)bool{
 return v.coverSegmentClear(from,to)&&v.RayClearMM(from,to,dynamic)
}
