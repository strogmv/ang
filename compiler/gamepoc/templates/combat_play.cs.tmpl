   float target=!string.IsNullOrEmpty(body.clutchZone)&&now>=body.clutchAt&&now<body.clutchUntil?1:0;body.clutchWeight=Mathf.MoveTowards(body.clutchWeight,target,CombatDt/(target>0?.14f:.3f));
   rig.clutch.weight=body.clutchWeight;
   if(body.clutchWeight>0){Vector3 p,n;if(CombatZonePoint(h,look,body.clutchZone,body.clutchSide,out p,out n)){var hand=h.animator.GetBoneTransform(HumanBodyBones.LeftHand);rig.clutchGoal.SetPositionAndRotation(p+n*.05f,Quaternion.LookRotation(-n,Vector3.up)*Quaternion.Euler(0,0,90));}}
  }
  // The blow: the clip carries the body and the hand; near the contact the arm goes to the server's point. True when this body is done for the frame.
  bool CombatStrikeIK(CombatBeat beat,LocationSDKHumanoid h,PocCombatContactRig rig,PocCombatLook look){
