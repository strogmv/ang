  env.Occupied[a.Level][a.Position]=true;if len(a.Path)>0{env.Occupied[a.Level][a.Path[0]]=true}
 };return env
}
// Named actors advance first against the previous crowd reservations. The
// population then receives their resulting positions, reservations and seats.
func(s *LifeState)AdvancePopulation(m LifeModel,observerID string)error{
