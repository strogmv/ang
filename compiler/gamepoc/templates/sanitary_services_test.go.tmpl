func TestSanitaryCommonEntranceTopology(t *testing.T) {
	r, _ := sanitaryFixture(t, "wc")
	cfg := r.world.SanitaryServices
	m := r.state.Life.GateModel(r.world.Life)
	level := "level.c7_market"
	for _, u := range cfg.Units {
		path := m.Space(level, nil).Path(cfg.CommonEntryCell, u.EntryCell, behavior.Cell{}, 0)
		if len(path) == 0 {
			t.Fatalf("unit unreachable from shared entrance: %s", u.ID)
		}
		portal := false
		for _, c := range path {
			if c.X == 10 && (c.Y == 44 || c.Y == 45) {
				portal = true
			}
		}
		if !portal {
			t.Fatalf("route bypassed common entry: %s %v", u.ID, path)
		}
		blocked := map[behavior.Cell]bool{{X: 10, Y: 44}: true, {X: 10, Y: 45}: true}
		if p := m.Space(level, blocked).Path(cfg.CommonEntryCell, u.EntryCell, behavior.Cell{}, 0); len(p) > 0 {
			t.Fatalf("unintended exterior access to %s: %v", u.ID, p)
		}
	}
}
func TestSanitaryWoundsAdvanceAndStaffBudget(t *testing.T) {
	r, u := sanitaryFixture(t, "shower")
	sanitaryUsing(t, r, u)
	medicalInjure(t, r, playerActorID, true)
	before := combatBody(r.state.CombatRoster[playerActorID])
	count := len(r.state.Life.Actors)
	for i := 0; i < 10; i++ {
		r.state.Tick++
		r.state.Inventory.Advance(r.state.Tick)
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	after := combatBody(r.state.CombatRoster[playerActorID])
	if after.Clock-before.Clock != 10 || after.Care != nil || len(r.state.Life.Actors) != count || !r.sanitaryAttached(playerActorID) {
		t.Fatal("sanitary service froze wounds, created care/body or lost actor")
	}
	id := "char.market_granny"
	npc := r.state.Life.Actor(id)
	npc.Level = u.LevelID
	npc.Trip = nil
	npc.ResidenceID = ""
	npc.Position = behavior.Cell{X: 12, Y: 44}
	npc.Goal = npc.Position
	npc.Path = nil
	npc.Body = nil
	npc.Manual = false
	npc.CombatHold = false
	npc.Brain.Place = behavior.LifeAffordance{ID: r.world.SanitaryServices.ManagedAffordance, Kind: "hygiene"}
	npc.Brain.BreakKind = "hygiene"
	npc.Brain.BreakReturnAt = r.state.Life.Seconds + 1
	r.world.SanitaryServices.NPCHygiene = true
	needs, position, deadline := npc.Brain.Needs, npc.Position, npc.Brain.BreakReturnAt
	r.sanitaryNPCRequests()
	if r.sanitaryReserved(id) {
		t.Fatal("service exceeded existing staff break budget")
	}
	if !npc.Brain.Returning || npc.Brain.Needs != needs || npc.Position != position || npc.Brain.BreakReturnAt != deadline {
		t.Fatal("unavailable duty service must return normally without recovery, teleport or a new budget")
	}
	npc.Brain.Returning = false
	r.world.SanitaryServices.ServiceAvailable = false
	r.sanitaryNPCRequests()
	if !npc.Brain.Returning || r.sanitaryReserved(id) || npc.Brain.Needs != needs || npc.Position != position || npc.Brain.BreakReturnAt != deadline {
		t.Fatal("closed water service must preserve needs and the existing physical return budget")
	}
}

