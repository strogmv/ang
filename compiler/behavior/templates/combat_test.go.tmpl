func TestCombatSustainedExposureReducesHealingUtility(t *testing.T) {
	r, space := combatFixtureRules(), combatFixtureSpace()
	a, b := combatFixtureActor("a", "blue", Cell{1, 1}), combatFixtureActor("b", "red", Cell{8, 1})
	a.HP, a.Medkits, b.Weapon.Damage = 20, 1, 150
	s := combatFixture(t, space, a, b)
	exposed := s.Decide(space, r)
	healScore := func(d CombatDecision) float64 {
		for _, c := range d.Candidates {
			if c.Action.Type == "heal" {
				return c.Score
			}
		}
		t.Fatal("missing legal treatment")
		return 0
	}
	space.Cover = func(from, to Cell) float64 {
		if to == (Cell{1, 1}) {
			return .95
		}
		return 0
	}
	protected := s.Decide(space, r)
	if healScore(protected) <= healScore(exposed) {
		t.Fatal("sustained known exposure did not affect treatment utility")
	}
	space.Cover = func(from, to Cell) float64 {
		if to == (Cell{3, 1}) {
			return .95
		}
		return 0
	}
	d := s.Decide(space, r)
	if d.Chosen.Action.Type != "move" || d.Chosen.Action.To != (Cell{3, 1}) {
		t.Fatalf("did not seek reachable cover before treatment: %+v", d.Chosen)
	}
	combatDo(t, &s, space, r, "a", d.Chosen.Action)
	if s.Decide(space, r).Chosen.Action.Type != "heal" {
		t.Fatal("did not execute planned treatment from cover")
	}
}

func TestCombatHiddenAmbientBodyOnlyBlocksExecutionAndAIYields(t *testing.T) {
