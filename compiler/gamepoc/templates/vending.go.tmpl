// vendingShelfRows: what every shelf of a unit shows now — the stock of its thing against its share of the par level.
func (r *Runtime) vendingShelfRows(u vendingUnit) []*pb.PocCraftHeap {
	v := r.world.Vending
	stock := map[string]int64{}
	for _, sh := range u.Shelves {
		if _, ok := stock[sh.Item]; !ok {
			stock[sh.Item] = r.vendingStock(u.DisplayStore, sh.Item)
		}
	}
	used := map[string]int64{}
	rows := make([]*pb.PocCraftHeap, 0, len(u.Shelves))
	for _, sh := range u.Shelves {
		q := stock[sh.Item] - used[sh.Item]
		if q < 0 {
			q = 0
		}
		if q > sh.Units {
			q = sh.Units
		}
		used[sh.Item] += sh.Units
		fill := craftHeapLevel(q, sh.Units)
		m := v.Models[sh.Item]
		scene := map[string]string{"full": m.Full, "half": m.Half, "few": m.Few}[fill]
		rows = append(rows, &pb.PocCraftHeap{Id: sh.ID, Fill: fill, X: sh.At.X, Y: sh.At.Y, Z: sh.At.Z, YawDegrees: sh.YawDegrees, HeapResource: scene})
	}
	return rows
}
