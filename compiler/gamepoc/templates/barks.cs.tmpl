    if(alpha<=0)continue;
    float lx=origin.x+(blockW-lay.lineW[gl.line]*em)/2+gl.x*em;
    float top=origin.y+gl.line*lineH+(gl.line>=gapLine?lineGap:0),baseline=top+f.cap*em;
    float x0=lx+q.x*em+off.x,x1=lx+q.z*em+off.x,y0=baseline-q.w*em+off.y,y1=baseline-q.y*em+off.y;
    if(k!=1){float cx=(x0+x1)/2,cy=(y0+y1)/2;x0=cx+(x0-cx)*k;x1=cx+(x1-cx)*k;y0=cy+(y0-cy)*k;y1=cy+(y1-cy)*k;}
    var uv=gl.g.uv;var c=colour;c.a*=alpha;
    Graphics.DrawTexture(new Rect(x0,y0,x1-x0,y1-y0),f.atlas,new Rect(uv.x,uv.y,uv.z-uv.x,uv.w-uv.y),0,0,0,0,c,mat);
   }
  }
  static int BarkVisible(BarkLayout lay,float t){int n=0;for(int i=0;i<lay.glyphs.Count;i++)if(lay.at[i]<=t)n=i+1;return n;}
  // A beast's sign or a silent answer: a short mark over the head, no letters.
  void BarkMark(string kind,Vector2 at,float s,Color c,float t){
   float w=Mathf.Max(1.6f,2*s);
   switch(kind){
    case "smile":for(int i=0;i<6;i++){float a0=Mathf.Lerp(-.9f,.9f,i/6f),a1=Mathf.Lerp(-.9f,.9f,(i+1)/6f);BarkSeg(at+new Vector2(Mathf.Sin(a0)*7*s,-Mathf.Cos(a0)*3.5f*s+3*s),at+new Vector2(Mathf.Sin(a1)*7*s,-Mathf.Cos(a1)*3.5f*s+3*s),w,c);}break;
    case "nod":BarkSeg(at+new Vector2(-4*s,-4*s),at+new Vector2(0,2*s),w,c);BarkSeg(at+new Vector2(0,2*s),at+new Vector2(4*s,-4*s),w,c);break;
    case "shrug":BarkSeg(at+new Vector2(-8*s,0),at+new Vector2(-3*s,-3*s),w,c);BarkSeg(at+new Vector2(3*s,-3*s),at+new Vector2(8*s,0),w,c);break;
    default: // growl / bark / howl: three strokes out of the head, the howl longer and slower
     float len=(kind=="howl"?13:kind=="bark"?9:7)*s*(1+.15f*Mathf.Sin(t*(kind=="howl"?.006f:.02f)));
     for(int i=-1;i<=1;i++){float a=(i*28-90)*Mathf.Deg2Rad;var d=new Vector2(Mathf.Cos(a),Mathf.Sin(a));BarkSeg(at+d*5*s,at+d*(5*s+len),(kind=="growl"?3:2)*s,c);}break;
   }
  }
  // Placement order: lines already on screen keep their slot, then answers in a chain, fight shouts, the nearest voices.
  int BarkPriority(PocBark b){
   BarkLive live;int p=0;if(barkLive.TryGetValue(b.Serial,out live)&&live.started)p+=100000;if(b.Kind=="reply")p+=50000;if(b.Kind=="combat"||b.Kind=="sign")p+=20000;
   if(state!=null){int dx=b.X-state.PlayerX,dy=b.Y-state.PlayerY;p+=Mathf.Max(0,9999-(dx*dx+dy*dy));}
   return p;
  }
  // Called in the game page right after the world is drawn and before the HUD.
  void DrawBarks(){
   BarkDrawnCount=0;
   if(Event.current.type!=EventType.Repaint||state==null||state.Life==null){return;}
   var list=new List<PocBark>();if(state.Life.Barks!=null)list.AddRange(state.Life.Barks);list.AddRange(BarkPreview);
   var wantGlow=new Dictionary<string,Color>(StringComparer.Ordinal);
   if(list.Count==0){barkLive.Clear();BarkDrawnText="";BarkDrawnRects.Clear();BarkGlowApply(wantGlow);return;}
   var vp=SpatialViewport();float scale=Mathf.Min(Screen.width/1280f,Screen.height/800f);Vector2 off=new Vector2((Screen.width-1280*scale)/2,(Screen.height-800*scale)/2);
   Func<Vector2,Vector2> px=v=>off+v*scale;
   // the safe area in GUI space: the world viewport less the screen edge; the HUD frames of this moment
   var safe=Rect.MinMaxRect(Mathf.Max(vp.xMin,0)+BarkEdge,Mathf.Max(vp.yMin,0)+BarkEdge,Mathf.Min(vp.xMax,1280)-BarkEdge,Mathf.Min(vp.yMax,800)-BarkEdge);
   barkHudNow.Clear();bool combatOpen=combatPanelOpen||HeroCombatActive();
   foreach(var hr in BarkHud){if(hr.when=="combat_panel"&&!combatOpen||hr.when=="debug"&&!hudDebugOpen)continue;var r=hr.r;barkHudNow.Add(Rect.MinMaxRect(r.xMin-BarkHudGap,r.yMin-BarkHudGap,r.xMax+BarkHudGap,r.yMax+BarkHudGap));}
   BarkCollectSigns(vp);
   float zoom=locationSDKZoomOrigin>0?Mathf.Clamp(Mathf.Pow(Mathf.Max(.01f,locationSDKZoom/locationSDKZoomOrigin),BarkZoomPower),BarkZoomMin,BarkZoomMax):1;
   double now=renderedSimNS;
   var keepMatrix=GUI.matrix;GUI.matrix=Matrix4x4.identity;
   barkPlaced.Clear();BarkDrawnRects.Clear();var alive=new HashSet<ulong>();int drawn=0;string lastText="";
   try{
    var order=new List<KeyValuePair<int,PocBark>>();foreach(var b in list)order.Add(new KeyValuePair<int,PocBark>(BarkPriority(b),b));
    order.Sort((x,y)=>x.Key!=y.Key?y.Key.CompareTo(x.Key):x.Value.Serial.CompareTo(y.Value.Serial));
    foreach(var entry in order){
     var b=entry.Value;alive.Add(b.Serial);BarkLive live;if(!barkLive.TryGetValue(b.Serial,out live)){live=new BarkLive{serial=b.Serial};barkLive[b.Serial]=live;}
     if(live.skipped)continue;
     float t=(float)((now-b.StartedNs)/1e6);if(t<0)continue;
     float total=b.RevealMs+b.FixMs+b.HoldMs,life=total+b.FadeMs;
     if(b.Kind=="thought"){DrawBarkThought(b,live,t,total,life,scale,zoom,safe,px);continue;}
     Vector2 head;bool inFrame,onScreen,body;if(!BarkHead(b,vp,out head,out inFrame,out onScreen,out body)){live.skipped=!live.started;continue;}
     bool loud=b.To=="hall"||b.Kind=="combat"||b.Kind=="sign";
     if(!live.started){
      // owner 02.11: a line of somebody out of the frame is not started; a shout to the hall or in a fight is pinned
      if(!inFrame&&!loud){live.skipped=true;continue;}
      if(drawn>=BarkMaxOnScreen)continue; // queued: waits for a free slot while it lives
      live.started=true;
     }
     if(drawn>=BarkMaxOnScreen)continue;
     if(!inFrame&&!loud&&live.leftAt<0)live.leftAt=now;
     if(inFrame)live.leftAt=-1;
     float alpha=1,clock=t;
     if(live.leftAt>=0){float gone=(float)((now-live.leftAt)/1e6);float off3=Mathf.Max(1,b.OffscreenFadeMs);if(gone>=off3)continue;clock=t+gone*4;alpha=1-gone/off3;}
     else if(t>total)alpha=1-(t-total)/Mathf.Max(1,b.FadeMs);
     if(alpha<=0||t>life)continue;
     bool pinned=!inFrame&&loud&&!onScreen;
     Color colour;if(!ColorUtility.TryParseHtmlString(string.IsNullOrEmpty(b.Colour)?"#d8d2c4":b.Colour,out colour))colour=Color.white;
     if(body)wantGlow[b.SpeakerId]=new Color(colour.r,colour.g,colour.b,alpha);
     if(b.Kind=="gesture"||b.Kind=="sign"){
      if(pinned)head=new Vector2(Mathf.Clamp(head.x,safe.xMin+20,safe.xMax-20),Mathf.Clamp(head.y,safe.yMin+20,safe.yMax-20));
      var markAt=px(new Vector2(head.x,head.y-12));var mc=b.Kind=="sign"?new Color(.86f,.62f,.36f,alpha*.95f):new Color(colour.r,colour.g,colour.b,alpha*.9f);
      BarkShade(new Rect(markAt.x-8*scale,markAt.y-8*scale,16*scale,16*scale),10*scale,.4f*alpha);BarkMark(b.Kind=="sign"?b.Sign:b.Gesture,markAt,scale,mc,t);drawn++;continue;
     }
     if(string.IsNullOrEmpty(b.Text)||string.IsNullOrEmpty(b.Face))continue;
     if(live.body!=null&&(live.body.text!=b.Text||live.body.face!=b.Face)){live.body=null;live.fix=null;live.name=null;} // the locale changed
     if(live.body==null){
      try{live.body=BarkLay(b.Text,b.Face,b.Reveal,b.RevealMs,b.Serial);
       if(b.FixTo>b.FixFrom&&!string.IsNullOrEmpty(b.FixText))live.fix=BarkLay(b.FixText,b.Face,b.Reveal=="set"?"set":b.Reveal,Mathf.Max(1,b.FixMs-BarkFixPauseMS-BarkStrikeMS),b.Serial+7);
       var who=BarkSpeakerName(b.SpeakerId);if(who!=null)live.name=BarkLay(who,"stencil","none",0,0);}
      catch(Exception e){Debug.LogError("ANG barks: "+e.Message);live.skipped=true;continue;}
     }
     var lay=live.body;
     // sizes in GUI space: the face's em at this zoom, never under the minimum
     float em=Mathf.Max(BarkMinEM,BarkFaceEM(b.Face)*zoom),lineH=em*BarkFacePitch(b.Face);
     int fixLine=-1,fixFrom=-1,fixTo=-1;
     if(live.fix!=null)for(int gi=0;gi<lay.glyphs.Count;gi++){int src=lay.glyphs[gi].src;if(src>=b.FixFrom&&src<b.FixTo){if(fixFrom<0){fixFrom=gi;fixLine=lay.glyphs[gi].line;}fixTo=gi+1;}}
     float fixH=fixLine>=0?em*.86f:0,capEM=Mathf.Max(BarkMinEM,BarkCaptionEM*Mathf.Min(1,zoom)),capH=live.name!=null?capEM*1.05f:0;
     float w=Mathf.Max(lay.width*em,live.name!=null?live.name.width*capEM:0),h=lay.lines*lineH+(fixLine>=1?fixH:0),above=(fixLine==0?fixH:0)+capH;
     Rect rect;
     if(pinned){float room=BarkArrowPx+16;rect=BarkPinned(head,w,h,above,Rect.MinMaxRect(safe.xMin+room,safe.yMin+room*.5f,safe.xMax-room,safe.yMax-room*.5f));live.spot=-1;} // room for the arrow
     else{int spot;rect=BarkPlace(head,w,h,above,em,zoom,safe,live.spot,out spot);live.spot=spot;}
     barkPlaced.Add(new Rect(rect.x-6,rect.y-4,rect.width+12,rect.height+8));BarkDrawnRects.Add(rect);
     var block=new Rect(rect.x,rect.y+above,w,h); // the text (+ the gap of a correction on the second line)
     // one soft shade under the whole block
     var inner=new Rect(px(new Vector2(rect.x-em*.4f,rect.y-em*.12f)),new Vector2((rect.width+em*.8f)*scale,(rect.height+em*.2f)*scale));
     BarkShade(inner,BarkShadePx*scale,BarkShadeAlpha*alpha);
     var threadC=new Color(colour.r,colour.g,colour.b,.85f*alpha);
     if(pinned){
      // the arrow: a chevron beside the block toward the speaker
      var c0=rect.center;var dir=(head-c0).normalized;if(dir.sqrMagnitude<.5f)dir=Vector2.right;
      var edge=new Vector2(Mathf.Clamp(c0.x+dir.x*(rect.width/2+12),rect.xMin-12,rect.xMax+12),Mathf.Clamp(c0.y+dir.y*(rect.height/2+12),rect.yMin-12,rect.yMax+12));
      var tip=px(edge+dir*BarkArrowPx*.6f);var back=px(edge-dir*BarkArrowPx*.4f);var nrm=new Vector2(-dir.y,dir.x)*BarkArrowPx*.55f*scale;
      var arrowC=new Color(colour.r,colour.g,colour.b,alpha);BarkSeg(back+nrm,tip,BarkThreadPx*1.8f*scale,arrowC);BarkSeg(back-nrm,tip,BarkThreadPx*1.8f*scale,arrowC);
     }else{
      // the thread from under the line (or its side, when the line stands beside the head) to the head, a knot on it;
      // a voice without a drawn body (behind a machine) gets a fainter knot where it comes from
      Vector2 from;
      if(rect.xMin>head.x+4)from=new Vector2(rect.xMin-3,Mathf.Clamp(head.y,block.yMin+lineH*.4f,block.yMax));
      else if(rect.xMax<head.x-4)from=new Vector2(rect.xMax+3,Mathf.Clamp(head.y,block.yMin+lineH*.4f,block.yMax));
      else if(rect.yMin>head.y)from=new Vector2(Mathf.Clamp(head.x,rect.xMin+em*.3f,rect.xMax-em*.3f),rect.yMin-3);
      else from=new Vector2(Mathf.Clamp(head.x,rect.xMin+em*.3f,rect.xMax-em*.3f),block.yMax+3);
      var to=head;var d=to-from;float len=d.magnitude;
      if(len>8){to=from+d*((len-BarkKnotPx-1)/len);BarkSeg(px(from),px(to),BarkThreadPx*scale,threadC);}
      BarkKnot(px(head),(body?BarkKnotPx:BarkKnotPx*.8f)*scale,body?threadC:new Color(threadC.r,threadC.g,threadC.b,threadC.a*.6f));
     }
     // the text: reveal by face, the correction after it, then the hold
     var origin=px(new Vector2(block.x,block.y));
     int count=b.Reveal=="set"?lay.glyphs.Count:BarkVisible(lay,clock);
     colour.a=alpha;
     BarkGlyphs(lay,origin,em*scale,lineH*scale,w*scale,count,colour,fixLine>=1?fixH*scale:0,fixLine>=1?fixLine:99,clock,b.Reveal,b.Serial,scale,b.Face);
     if(live.fix!=null&&fixFrom>=0&&clock>b.RevealMs){
      float ft=clock-b.RevealMs-BarkFixPauseMS;
      if(ft>0){
       var g0=lay.glyphs[fixFrom];var g1=lay.glyphs[fixTo-1];float k=Mathf.Clamp01(ft/BarkStrikeMS);var face=WorldTextFaceOf(b.Face);
       float lineX=block.x+(w-lay.lineW[g0.line]*em)/2,top=block.y+g0.line*lineH+(fixLine>=1&&g0.line>=fixLine?fixH:0);
       float x0=lineX+g0.x*em,x1=lineX+(g1.x+g1.g.adv)*em,y=top+face.cap*em*.62f;
       bool restamp=b.Correction=="restamp";var strike=new Color(colour.r*.95f,colour.g*.93f,colour.b*.9f,alpha);
       // chalk strikes with a slanted hand stroke; a restamp is a heavy bar
       float slant=restamp?0:em*.10f;
       BarkSeg(px(new Vector2(x0-2,y+slant*.5f)),px(new Vector2(Mathf.Lerp(x0,x1,k)+2,y+slant*.5f-slant*k)),(restamp?BarkStrikePx*1.8f:BarkStrikePx)*scale,strike);
       float ct=ft-BarkStrikeMS;
       if(ct>0){
        var fl=live.fix;float fem=em*.82f;int fc=b.Reveal=="set"?fl.glyphs.Count:BarkVisible(fl,ct);
        var fo=px(new Vector2((x0+x1)/2-fl.width*fem/2,top-fixH*.98f));
        BarkGlyphs(fl,fo,fem*scale,fem*BarkFacePitch(b.Face)*scale,fl.width*fem*scale,fc,colour,0,99,ct,b.Reveal,b.Serial+7,scale,b.Face);
       }
      }
     }
     // the speaker's name (named people), once the line is written out
     if(live.name!=null){
      float na=Mathf.Clamp01((clock-(b.RevealMs+b.FixMs))/250f)*alpha*BarkCaptionAlpha;
      if(na>0){
       var nl=live.name;float nx=block.x+(w-nl.width*capEM)/2; // centred over the line, like the mock-up
       BarkGlyphs(nl,px(new Vector2(nx,rect.y)),capEM*scale,capEM*1.2f*scale,nl.width*capEM*scale,nl.glyphs.Count,new Color(.80f,.78f,.72f,na),0,99,0,"none",0,scale,"plain");
      }
     }
     live.last=rect;drawn++;lastText=b.Text;
    }
   }finally{GUI.matrix=keepMatrix;}
   BarkDrawnCount=drawn;if(lastText!="")BarkDrawnText=lastText;
   BarkGlowApply(wantGlow);
   if(barkLive.Count>64){var gone=new List<ulong>();foreach(var k in barkLive.Keys)if(!alive.Contains(k))gone.Add(k);foreach(var k in gone)barkLive.Remove(k);}
  }
  // The hero's thought (he saw through a lie): low in the middle of the safe area, never over the enemy or the HUD.
  void DrawBarkThought(PocBark b,BarkLive live,float t,float total,float life,float scale,float zoom,Rect safe,Func<Vector2,Vector2> px){
   if(string.IsNullOrEmpty(b.Text)||string.IsNullOrEmpty(b.Face)||t>life)return;
   if(live.body==null){try{live.body=BarkLay(b.Text,b.Face,b.Reveal,b.RevealMs,b.Serial);}catch(Exception){live.skipped=true;return;}}
   float alpha=t>total?1-(t-total)/Mathf.Max(1,b.FadeMs):1;if(alpha<=0)return;
   var lay=live.body;float em=Mathf.Max(BarkMinEM,BarkFaceEM(b.Face)*zoom),lineH=em*BarkFacePitch(b.Face),w=lay.width*em,h=lay.lines*lineH;
   var r=new Rect(640-w/2,safe.yMax-h,w,h);
   for(int i=0;i<40&&!BarkFree(r,safe);i++)r.y-=12;
   barkPlaced.Add(r);
   BarkShade(new Rect(px(new Vector2(r.x-em*.4f,r.y)),new Vector2((w+em*.8f)*scale,h*scale)),BarkShadePx*scale,(BarkShadeAlpha+.1f)*alpha);
   var colour=new Color(.86f,.9f,.94f,alpha);BarkSeg(px(new Vector2(r.x-em*.9f,r.y+h*.5f)),px(new Vector2(r.x-em*.35f,r.y+h*.5f)),Mathf.Max(1,BarkThreadPx*scale),colour);
   BarkGlyphs(lay,px(new Vector2(r.x,r.y)),em*scale,lineH*scale,w*scale,BarkVisible(lay,t),colour,0,99,t,b.Reveal,b.Serial,scale,b.Face);
  }

  // The speaker's contour (ANG/BarkSpeaker) while his line lives: shells sharing the body's skin, faded with the line.
  sealed class BarkGlow {public LocationSDKHumanoid h;public Material mat;public readonly List<GameObject> shells=new List<GameObject>();public float level,target;public Color colour;}
  readonly Dictionary<string,BarkGlow> barkGlows=new Dictionary<string,BarkGlow>(StringComparer.Ordinal);
  static Shader barkSpeakerShader;float barkGlowClock=-1;
  void BarkGlowApply(Dictionary<string,Color> want){
   float now=Time.realtimeSinceStartup,dt=barkGlowClock<0?0:Mathf.Clamp(now-barkGlowClock,0,.25f);barkGlowClock=now;
   foreach(var kv in want){
    BarkGlow g;
    if(!barkGlows.TryGetValue(kv.Key,out g)){LocationSDKHumanoid h;if(!locationSDKHumanoids.TryGetValue(kv.Key,out h)||h==null||h.go==null)continue;g=BarkGlowMake(h);if(g==null)continue;barkGlows[kv.Key]=g;}
    g.target=kv.Value.a;g.colour=kv.Value;
   }
   List<string> dead=null;
   foreach(var kv in barkGlows){
    var g=kv.Value;if(!want.ContainsKey(kv.Key))g.target=0;
    if(g.h==null||g.h.go==null){if(dead==null)dead=new List<string>();dead.Add(kv.Key);continue;}
    g.level=Mathf.MoveTowards(g.level,g.target,dt*1000f/Mathf.Max(1,BarkGlowFadeMS));
    bool on=g.level>.01f;foreach(var s in g.shells)if(s!=null&&s.activeSelf!=on)s.SetActive(on);
    if(on){var c=g.colour;c.a=g.level*BarkGlowAlpha;g.mat.SetColor("_Color",c);}
   }
   if(dead!=null)foreach(var k in dead){var g=barkGlows[k];foreach(var s in g.shells)if(s!=null)Destroy(s);if(g.mat!=null)Destroy(g.mat);barkGlows.Remove(k);}
  }
  BarkGlow BarkGlowMake(LocationSDKHumanoid h){
   if(barkSpeakerShader==null)barkSpeakerShader=Shader.Find("ANG/BarkSpeaker");if(barkSpeakerShader==null||h.renderers==null)return null;
   var g=new BarkGlow{h=h,mat=new Material(barkSpeakerShader){name="bark speaker / "+h.id}};g.mat.SetFloat("_Width",BarkGlowRim*Mathf.Max(1,Screen.height/800f));
   foreach(var r in h.renderers){
    if(r==null)continue;var skin=r as SkinnedMeshRenderer;var mr=r as MeshRenderer;
    if(skin==null&&mr==null)continue;
    var go=new GameObject("bark contour");go.layer=r.gameObject.layer;go.transform.SetParent(r.transform.parent,false);
    go.transform.localPosition=r.transform.localPosition;go.transform.localRotation=r.transform.localRotation;go.transform.localScale=r.transform.localScale;
    Renderer shell;int subs;
    if(skin!=null){if(skin.sharedMesh==null){Destroy(go);continue;}var s=go.AddComponent<SkinnedMeshRenderer>();s.sharedMesh=skin.sharedMesh;s.bones=skin.bones;s.rootBone=skin.rootBone;s.localBounds=skin.localBounds;s.quality=skin.quality;s.updateWhenOffscreen=false;s.skinnedMotionVectors=false;shell=s;subs=skin.sharedMesh.subMeshCount;}
    else{var mf=r.GetComponent<MeshFilter>();if(mf==null||mf.sharedMesh==null){Destroy(go);continue;}go.AddComponent<MeshFilter>().sharedMesh=mf.sharedMesh;shell=go.AddComponent<MeshRenderer>();subs=mf.sharedMesh.subMeshCount;}
    var mats=new Material[Mathf.Max(1,subs)];for(int i=0;i<mats.Length;i++)mats[i]=g.mat;shell.sharedMaterials=mats;
    shell.shadowCastingMode=UnityEngine.Rendering.ShadowCastingMode.Off;shell.receiveShadows=false;shell.lightProbeUsage=UnityEngine.Rendering.LightProbeUsage.Off;shell.reflectionProbeUsage=UnityEngine.Rendering.ReflectionProbeUsage.Off;
    go.SetActive(false);g.shells.Add(go);
   }
   return g;
  }
 }
