  "danger.avoidable":level.Avoidance.Allowed,"request.pending":a.Task=="considering","sound.heard":soundHeard,"alarm.heard":alarmHeard,"alarm.raised":a.AlarmRaisedTick>0,"network.called":r.networkKnown(a),"post.operator":r.isOperator(a)}
