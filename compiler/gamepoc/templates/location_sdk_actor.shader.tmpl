Shader "ANG/LocationSDKActor" {
 Properties {
  _MainTex ("Original actor atlas", 2D) = "white" {}
  _Color ("Actor tint", Color) = (1,1,1,1)
  _OccludedTint ("Observed actor behind opaque architecture", Color) = (.78,.55,.24,.23)
 }
 SubShader {
  Tags { "RenderType"="Transparent" "Queue"="Transparent" "RenderPipeline"="UniversalPipeline" }
  HLSLINCLUDE
  #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
  TEXTURE2D(_MainTex); SAMPLER(sampler_MainTex);
  CBUFFER_START(UnityPerMaterial)
  half4 _Color;
  half4 _OccludedTint;
  CBUFFER_END
  struct appdata { float4 vertex : POSITION; float2 uv : TEXCOORD0; };
  struct v2f { float4 vertex : SV_POSITION; float2 uv : TEXCOORD0; };
  v2f vert(appdata v) { v2f o;o.vertex=TransformObjectToHClip(v.vertex.xyz);o.uv=v.uv;return o; }
  half4 normalFrag(v2f i) : SV_Target { half4 body=SAMPLE_TEXTURE2D(_MainTex,sampler_MainTex,i.uv);clip(body.a-.02);return body*_Color; }
  half4 occludedFrag(v2f i) : SV_Target { half4 body=SAMPLE_TEXTURE2D(_MainTex,sampler_MainTex,i.uv);clip(body.a-.02);return half4(_OccludedTint.rgb,_OccludedTint.a*body.a*_Color.a); }
  ENDHLSL
  Pass {
   Name "ObservedOccludedSilhouette"
   Tags { "LightMode"="ANGObservedOccluded" }
   ZWrite Off
   ZTest Greater
   Cull Off
   Blend SrcAlpha OneMinusSrcAlpha
   HLSLPROGRAM
   #pragma vertex vert
   #pragma fragment occludedFrag
   ENDHLSL
  }
  Pass {
   Name "NormalDepthTestedBody"
   Tags { "LightMode"="UniversalForward" }
   ZWrite Off
   ZTest LEqual
   Cull Off
   Blend SrcAlpha OneMinusSrcAlpha
   HLSLPROGRAM
   #pragma vertex vert
   #pragma fragment normalFrag
   ENDHLSL
  }
 }
 Fallback Off
}
