func vendingFixture(t *testing.T) (*Runtime, vendingCatalog) {
	t.Helper()
	r := lifeRuntimeFixture(t)
	if len(r.world.Vending.Units) == 0 {
		t.Skip("world has no vending terminals")
	}
	return r, r.world.Vending
}
func vendingUnitByID(t *testing.T, v vendingCatalog, id string) (int, vendingUnit) {
	t.Helper()
	for i, u := range v.Units {
		if u.ID == id {
			return i, u
		}
	}
	t.Fatalf("no vending unit %s", id)
	return -1, vendingUnit{}
}
func vendingPlace(t *testing.T, r *Runtime, id string, at inv.Cell) {
	t.Helper()
	a := r.state.Life.Actor(id)
	if a == nil {
		t.Fatalf("no Life actor %s", id)
	}
	a.Level = r.world.Vending.Level
	a.Position = behavior.Cell{X: at.X, Y: at.Y}
	a.Path = nil
	a.Arrived = true
	if id == playerActorID {
		r.syncLifeHero()
	}
}
func vendingMoney(r *Runtime) int64 {
	var n int64
	for _, a := range r.state.Inventory.Accounts {
		n += a.Balance
	}
	return n
}
func vendingFirst(r *Runtime, store, definition string) inv.Item {
	best := inv.Item{}
	for id, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == store && i.Definition == definition && (best.ID == "" || id < best.ID) {
			best = i
		}
	}
	return best
}
func vendingCarried(r *Runtime, definition string) (inv.Item, int64) {
	best, n := inv.Item{}, int64(0)
	for id, i := range r.state.Inventory.Items {
		if i.Definition == definition && r.carried(i) {
			n += i.Quantity
			if best.ID == "" || id < best.ID {
				best = i
			}
		}
	}
	return best, n
}
func vendingCommandRequest(r *Runtime, action string, item inv.Item, store string) *pb.PocInventoryCommand {
	return &pb.PocInventoryCommand{Epoch: r.state.Epoch, Sequence: r.state.Inventory.Cursors[playerActorID].Sequence + 1, Action: action, ItemId: item.ID, Quantity: 1, ExpectedRevision: item.Revision, StoreId: store}
}

func TestVendingBuyBuybackChargeKeepMoneyAndGoods(t *testing.T) {
	r, v := vendingFixture(t)
	i2, tm2 := vendingUnitByID(t, v, "tm2")
	vendingPlace(t, r, playerActorID, tm2.Panel)
	if r.vendingHeroUnit() != i2 {
		t.Fatal("hero at the panel of TM-2 is not at the unit")
	}
	model := r.inventoryModelFor(true)
	money, goods := vendingMoney(r), commerceTotal(r.state.Inventory)
	hero0, sys0 := r.state.Inventory.Accounts["account.hero.crd"].Balance, r.state.Inventory.Accounts[v.Account].Balance
	// 1. purchase of a tool power pack: the ordinary inventory buy, the price of the definition
	offer := vendingFirst(r, tm2.DisplayStore, "item.vm_tool_cell")
	price, err := inv.Quote(model.Definitions[offer.Definition], 1)
	if offer.ID == "" || err != nil || price < 1 {
		t.Fatal("TM-2 has no priced tool power pack on display")
	}
	stock0 := r.vendingStock(tm2.DisplayStore, offer.Definition)
	req := vendingCommandRequest(r, "buy", offer, "")
	if !inventoryRequest(t, r, req) {
		t.Fatal("purchase at the terminal refused")
	}
	if r.state.Inventory.Accounts["account.hero.crd"].Balance != hero0-price || r.state.Inventory.Accounts[v.Account].Balance != sys0+price {
		t.Fatal("purchase did not move the price from the hero to the system account")
	}
	if r.vendingStock(tm2.DisplayStore, offer.Definition) != stock0-1 {
		t.Fatal("purchase did not take one unit from the showcase")
	}
	if _, n := vendingCarried(r, offer.Definition); n != 1 {
		t.Fatal("bought item is not carried by the hero")
	}
	if !inventoryRequest(t, r, req) || r.state.Inventory.Accounts["account.hero.crd"].Balance != hero0-price {
		t.Fatal("a replayed purchase charged twice")
	}
	if r.vendingStatus(i2) != "serving" {
		t.Fatal("status band does not show the session after a sale")
	}
	// 2. buy-back of a spent cell at the system price
	cell, cells := vendingCarried(r, "item.vm_cell_spent")
	back, accepted := r.vendingBuyPrice(tm2, "item.vm_cell_spent")
	if cell.ID == "" || cells < 1 || !accepted {
		t.Fatal("fixture needs a carried spent cell the equipment unit buys back")
	}
	hero1, sys1 := r.state.Inventory.Accounts["account.hero.crd"].Balance, r.state.Inventory.Accounts[v.Account].Balance
	sell := vendingCommandRequest(r, "sell", cell, tm2.DisplayStore)
	if !inventoryRequest(t, r, sell) {
		t.Fatal("buy-back refused")
	}
	if r.state.Inventory.Accounts["account.hero.crd"].Balance != hero1+back || r.state.Inventory.Accounts[v.Account].Balance != sys1-back {
		t.Fatal("buy-back did not pay the system price")
	}
	if _, n := vendingCarried(r, "item.vm_cell_spent"); n != cells-1 {
		t.Fatal("buy-back did not take exactly one unit")
	}
	if got := vendingFirst(r, tm2.IntakeStore, "item.vm_cell_spent"); got.ID == "" || got.Owner != v.Owner || got.ForSale {
		t.Fatal("bought-back item is not in the intake bin of the system")
	}
	if !inventoryRequest(t, r, sell) || r.state.Inventory.Accounts["account.hero.crd"].Balance != hero1+back {
		t.Fatal("a replayed buy-back paid twice")
	}
	if r.vendingBuybackUsed(playerActorID) != back {
		t.Fatal("daily buy-back ledger not updated")
	}
	// 3. refusals change nothing but the band: a knife is not accepted, charging has no bound gear, the daily limit
	knife, _ := vendingCarried(r, "item.knife_simple")
	before, _ := json.Marshal(r.state.Inventory)
	if knife.ID == "" || inventoryRequest(t, r, vendingCommandRequest(r, "sell", knife, tm2.DisplayStore)) {
		t.Fatal("the system bought a knife")
	}
	if inventoryRequest(t, r, vendingCommandRequest(r, "charge", inv.Item{}, tm2.DisplayStore)) {
		t.Fatal("charging without bound gear succeeded")
	}
	if r.vendingStatus(i2) != "refused" {
		t.Fatal("refusal does not flash the band")
	}
	r.state.Vending.Buyback[playerActorID] = vendingBuyback{Day: r.vendingDayKey(), Minor: v.BuybackDailyLimitMinor - back + 1}
	cell, _ = vendingCarried(r, "item.vm_cell_spent")
	if inventoryRequest(t, r, vendingCommandRequest(r, "sell", cell, tm2.DisplayStore)) {
		t.Fatal("buy-back over the daily limit accepted")
	}
	// the hero standing at another unit cannot use TM-2
	_, tm3 := vendingUnitByID(t, v, "tm3")
	vendingPlace(t, r, playerActorID, tm3.Panel)
	if inventoryRequest(t, r, vendingCommandRequest(r, "sell", cell, tm2.DisplayStore)) {
		t.Fatal("buy-back at a unit the hero does not stand at")
	}
	after, _ := json.Marshal(r.state.Inventory)
	if string(before) != string(after) {
		t.Fatal("a refused command changed the inventory")
	}
	// the next game day the limit is fresh
	vendingPlace(t, r, playerActorID, tm2.Panel)
	r.state.Life.Seconds += 86400
	if !inventoryRequest(t, r, vendingCommandRequest(r, "sell", cell, tm2.DisplayStore)) {
		t.Fatal("buy-back refused on a new day")
	}
	if vendingMoney(r) != money || commerceTotal(r.state.Inventory) != goods {
		t.Fatalf("money %d->%d or goods %d->%d not conserved", money, vendingMoney(r), goods, commerceTotal(r.state.Inventory))
	}
	// 4. the view: offers and buy-back only for the active unit; save/load keeps the ledger and the bands
	view := &pb.PocLifeView{}
	r.appendVending(view, r.state.Life.Actor(playerActorID), &pb.PocObserverView{}, "ru")
	active := 0
	for _, u := range view.Vending {
		if u.Active {
			active++
			if u.Id != "tm2" || len(u.Offers) == 0 || u.StoreId != tm2.DisplayStore {
				t.Fatal("active unit view incomplete")
			}
		} else if len(u.Offers) != 0 || len(u.Buyback) != 0 || u.Queue != 0 {
			t.Fatal("offers or unseen queue leaked for a unit the hero does not stand at")
		}
	}
	if active != 1 || len(view.Vending) != len(v.Units) {
		t.Fatal("vending view does not list every unit with one active")
	}
	saved := r.snapshotState()
	if err := r.writeSave(r.world.Config.SaveSlots[0], saved); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(r.world.Config.SaveSlots[0])
	if err != nil {
		t.Fatal(err)
	}
	if loaded.Vending.Buyback[playerActorID] != r.state.Vending.Buyback[playerActorID] || loaded.Vending.Units["tm2"] != r.state.Vending.Units["tm2"] {
		t.Fatal("save/load lost the vending ledger")
	}
	bad := r.snapshotState()
	bad.Vending.Buyback[playerActorID] = vendingBuyback{Day: 1, Minor: v.BuybackDailyLimitMinor + 1}
	if err := r.writeSave(r.world.Config.SaveSlots[0], bad); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave(r.world.Config.SaveSlots[0]); err == nil {
		t.Fatal("loaded a buy-back ledger over the daily limit")
	}
}

func TestVendingNPCBuysWaterAndTheNightRefill(t *testing.T) {
	r, v := vendingFixture(t)
	i3, tm3 := vendingUnitByID(t, v, "tm3")
	var place behavior.LifeAffordance
	for _, p := range r.world.Life.Brain.Places {
		if p.ID == "vending.tm3" {
			place = p
		}
	}
	// demo-hub v14-traders: water is no food (stage 1 has no thirst) — the water unit is a household purchase of the brain
	// demo-hub v15-fixes: the limit is data (vending.cue, 1 since v15: the second in line waited on the occupied panel cell
	// and missed the yatai lunch); the test only requires that a limit exists
	if place.ID == "" || place.Kind != "market_goods" || place.Store != tm3.DisplayStore || place.QueueLimit < 1 {
		t.Fatal("water unit is not a market goods place of the NPC brain with a queue limit")
	}
	// any named person of the hub floor with an account buys the water as an ordinary NPC purchase
	buyer := ""
	for _, a := range r.state.Life.Actors {
		if a.ID == playerActorID || a.Level != v.Level || !a.OnFloor() {
			continue
		}
		if _, ok := r.npcAccount(a.ID); ok {
			buyer = a.ID
			break
		}
	}
	if buyer == "" {
		t.Fatal("no NPC with an account on the hub floor")
	}
	account, _ := r.npcAccount(buyer)
	account.Balance += 500
	r.state.Inventory.Accounts[account.ID] = account
	vendingPlace(t, r, buyer, tm3.Panel)
	money := vendingMoney(r)
	water0 := r.vendingStock(tm3.DisplayStore, "item.vm_water_1l")
	sys0 := r.state.Inventory.Accounts[v.Account].Balance
	// queue limit: two other people already on the way to the panel hide it from a third one's offers
	others := 0
	for i := range r.state.Life.Actors {
		if a := &r.state.Life.Actors[i]; a.ID != buyer && a.ID != playerActorID && others < 2 {
			a.Brain.Place.ID = place.ID
			others++
		}
	}
	for _, p := range r.npcOffers(buyer, "market_goods", v.Level) {
		if p.ID == place.ID {
			t.Fatal("a panel with two people heading for it is still offered to a third")
		}
	}
	for i := range r.state.Life.Actors {
		if a := &r.state.Life.Actors[i]; a.ID != buyer && a.Brain.Place.ID == place.ID {
			a.Brain.Place.ID = ""
		}
	}
	if !r.npcBuy(buyer, place, false) {
		t.Fatal("NPC could not buy water at the terminal")
	}
	price, _ := inv.Quote(r.world.Inventory.Definitions["item.vm_water_1l"], 1)
	if r.vendingStock(tm3.DisplayStore, "item.vm_water_1l") != water0-1 || r.state.Inventory.Accounts[v.Account].Balance != sys0+price {
		t.Fatal("NPC water purchase did not reach the showcase and the system account")
	}
	if got, _ := r.npcAccount(buyer); got.Balance != account.Balance-price || vendingMoney(r) != money {
		t.Fatal("NPC money not conserved")
	}
	if r.vendingStatus(i3) != "serving" {
		t.Fatal("NPC purchase did not light the band")
	}
	// the lamp: occupied at night = sensor, empty at night = duty
	r.state.Life.Seconds = (r.state.Life.Seconds/86400)*86400 + 2*3600
	if r.vendingLamp(i3, true) != v.Light.SensorPPM || r.vendingLamp(i3, false) != v.Light.NightPPM {
		t.Fatal("panel lamp ignores the presence sensor or the night")
	}
	// night refill from the cassette: nothing created, the showcase back to par
	goods := commerceTotal(r.state.Inventory)
	cassette0 := r.vendingStock(tm3.CassetteStore, "item.vm_water_1l")
	r.state.Life.Seconds = (r.state.Life.Seconds/86400)*86400 + v.Refill.FromSecond + int64(i3)*v.Refill.SecondsPerUnit + 30
	if r.vendingStatus(i3) != "service" || r.vendingServes(tm3.DisplayStore) {
		t.Fatal("unit under the service robot still sells")
	}
	if err := r.advanceVending(); err != nil {
		t.Fatal(err)
	}
	par := int64(0)
	for _, o := range tm3.Sells {
		if o.Item == "item.vm_water_1l" {
			par = o.Par
		}
	}
	if r.vendingStock(tm3.DisplayStore, "item.vm_water_1l") != par || r.vendingStock(tm3.CassetteStore, "item.vm_water_1l") != cassette0-(par-(water0-1)) || commerceTotal(r.state.Inventory) != goods {
		t.Fatal("night refill did not move exactly the missing units from the cassette")
	}
	if err := r.advanceVending(); err != nil || r.vendingUnitState("tm3").Refills != 1 {
		t.Fatal("refill ran twice in one night")
	}
	if err := r.state.Inventory.Validate(r.inventoryModelFor(true)); err != nil {
		t.Fatal(err)
	}
}
