func TestPopulationRuntimeArrivalRespectsHeroAndSharedSaveValidation(t *testing.T) {
	m := sharedPopulationLifeFixture(t)
	s, err := m.StartWithPopulation(1, playerActorID)
	if err != nil {
		t.Fatal(err)
	}
	hero := s.Actor(playerActorID)
	hero.Level = "b"
	hero.Position = m.Edges[0].Entry
	hero.Goal = hero.Position
	hero.Manual = true
	hero.Visits["b"] = 1
	a := &s.Population.Actors[0]
	a.Materialized = false
	a.Path = nil
	a.Level = "a"
	a.Position = m.Edges[0].Exit
	a.Trip = &behavior.PopulationTrip{Edge: "ab", Departure: 0, Arrival: 60}
	a.Activity = "transit"
	s.Advance(m, 1)
	if err = s.AdvancePopulation(m, playerActorID); err != nil {
		t.Fatal(err)
	}
	if !a.Materialized || a.Level != "b" || a.Position == hero.Position || behavior.Distance(a.Position, m.Edges[0].Entry) != 1 {
		t.Fatalf("bad physical arrival: %+v", a)
	}
	if err = s.Validate(m, 1); err != nil {
		t.Fatal(err)
	}
	raw, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var restored behavior.LifeState
	if err = json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	if err = restored.Validate(m, 1); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(s.Clone(), restored.Clone()) {
		t.Fatal("arrival save changed state")
	}
	// Each population subsystem separately admits one seat, but together they overbook.
	a = &restored.Population.Actors[0]
	a.Materialized = false
	a.Level = "a"
	a.Position = m.Edges[0].Exit
	a.Path = nil
	a.Trip = &behavior.PopulationTrip{Edge: "ab", Departure: 60, Arrival: 120}
	hero = restored.Actor(playerActorID)
	hero.Level = "a"
	hero.Position = m.Edges[0].Exit
	hero.Trip = &behavior.LifeTrip{Edge: "ab", Departure: 60, Arrival: 120}
	hero.Path = nil
	if restored.Validate(m, 1) == nil {
		t.Fatal("combined overbooked save accepted")
	}
}
