// The hero is sent straight through the docked cabinet at night: his body stops at its side, then he finds his own way
// round it (he sees the whole body) and gets to the far side; he never stands in its cells.
func TestWalkersTheHeroGoesRoundTheDockedCabinet(t *testing.T) {
	r := visitorsRuntime(t, 30)
	rb := r.world.Vending.Robot
	if rb.OutLeg == nil || r.world.Vending.Level != r.world.Visitors.Level {
		t.Skip("no cabinet on the visitors' level")
	}
	visitorsRun(t, r, (r.world.Vending.Refill.FromSecond+900-r.state.Life.Seconds%86400+86400)%86400, nil)
	r.state.Life.SecondsPerTick = 1
	if p := r.state.Vending.Robot.Phase; p != "load" && p != "couple" {
		t.Fatalf("the cabinet is %q a quarter of an hour into the refill", p)
	}
	body := r.vendingRobotCells()
	x, y0, y1 := body[0].X+1, body[0].Y, body[0].Y
	for _, c := range body {
		y0, y1 = min(y0, c.Y), max(y1, c.Y)
	}
	level := r.world.Vending.Level
	from, to := behavior.Cell{X: x, Y: y1 + 4}, behavior.Cell{X: x, Y: y0 - 3}
	if !r.world.Life.Walks(level, from) || !r.world.Life.Walks(level, to) {
		t.Skip("no open floor across the port")
	}
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || hero.Body == nil || hero.Level != level {
		t.Skip("the hero has no body here")
	}
	cell := float64(r.world.Life.Locations[level].CellMM)
	hero.Position, hero.Goal, hero.Path, hero.PendingPath = from, from, nil, nil
	hero.Body.X, hero.Body.Y, hero.Body.Mode, hero.Body.Route, hero.Body.Cells = (float64(from.X)+.5)*cell, (float64(from.Y)+.5)*cell, "", nil, []behavior.Cell{from}
	if !r.state.Life.HeroBodyRouteTo(r.state.Life.GateModel(r.world.Life), to) {
		t.Fatal("no route for the hero")
	}
	for i := 0; i < 400; i++ {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
		if err := walkersCheck(r, level); err != nil {
			t.Fatalf("tick %d: %v", i, err)
		}
		if r.state.Life.Actor(playerActorID).Position.Y < y0 {
			return
		}
	}
	t.Fatalf("the hero is stuck at %v before the cabinet", r.state.Life.Actor(playerActorID).Position)
}
