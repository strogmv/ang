// craftHeapLevel: what a heap slot shows for q units left of a full stock: more than two thirds is full, more than a
// third is half, anything is few, nothing is the empty tare.
func craftHeapLevel(q, full int64) string {
	switch {
	case q <= 0:
		return "empty"
	case 3*q > 2*full:
		return "full"
	case 3*q > full:
		return "half"
	}
	return "few"
}

// craftHeapPacked: the slots of a stall are packed away one by one in the closing phase from its east end and laid out
// one by one in the opening phase from its west end (i of n slots, west to east; ppm of the phase).
func craftHeapPacked(phase string, ppm int64, i, n int) bool {
	switch phase {
	case "open":
		return false
	case "closing":
		return ppm*int64(n+1) >= int64(n-i)*1000000
	case "opening":
		return ppm*int64(n+1) < int64(i+1)*1000000
	}
	return true
}

func (r *Runtime) craftStock(store, definition string) int64 {
	var n int64
	for _, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == store && i.Definition == definition && !i.Hidden {
			n += i.Quantity
		}
	}
	return n
}

// craftHeaps: the heap slots of a stall for the view — the pose from the island and the stall frame, the fill from the
// real stock of the slot's item in the stall's display store. A shut stall has every slot packed.
func (r *Runtime) craftHeaps(s craftStallDef, display, phase string, ppm int64) []*pb.PocCraftHeap {
	g := r.world.Craft
	var island *craftCounterDef
	for i := range g.Counters {
		if g.Counters[i].Place == s.Place {
			island = &g.Counters[i]
		}
	}
	if island == nil || len(s.Heaps) == 0 {
		return nil
	}
	out := make([]*pb.PocCraftHeap, 0, len(s.Heaps))
	for i, h := range s.Heaps {
		row := &pb.PocCraftHeap{Id: h.ID, Fill: "packed", X: float64(island.At.X)*0.5 + float64(s.XMM[0]+h.XMM)/1000, Z: float64(h.ZMM) / 1000}
		if s.Face == "south" {
			row.Y = float64(island.At.Y)*0.5 + float64(g.Passport.SizeMM.D-h.DMM)/1000
		} else {
			row.Y, row.YawDegrees = float64(island.At.Y)*0.5+float64(h.DMM)/1000, 180
		}
		if !craftHeapPacked(phase, ppm, i, len(s.Heaps)) {
			row.Fill = craftHeapLevel(r.craftStock(display, h.Item), h.Full)
			row.TareResource = g.Models[h.Tare].Scene
			switch row.Fill {
			case "full":
				row.HeapResource = g.Models[h.Heaps.Full].Scene
			case "half":
				row.HeapResource = g.Models[h.Heaps.Half].Scene
			case "few":
				row.HeapResource = g.Models[h.Heaps.Few].Scene
			}
		}
		out = append(out, row)
	}
	return out
}

// advanceCraftSupply: while the owner of a supplied stall lays out (the supply window at the start of his hours, the
// stall open), every heap slot is topped up to its full stock from the stall's locked consignment (the farm's cull on a
// waybill). Goods only move: the consignment is finite, and a slot it cannot fill stays as it is.
func (r *Runtime) advanceCraftSupply() error {
	g := r.world.Craft
	if len(g.Stalls) == 0 || !r.state.Life.Enabled {
		return nil
	}
	day := ((r.state.Life.Seconds % 86400) + 86400) % 86400
	for _, s := range g.Stalls {
		if s.Supply == nil || len(s.Heaps) == 0 {
			continue
		}
		var front *inv.Shopfront
		for i := range r.world.Inventory.Shopfronts {
			if r.world.Inventory.Shopfronts[i].ID == s.Shop {
				front = &r.world.Inventory.Shopfronts[i]
			}
		}
		// cargo to the market v1: a lot that reached the stall's locker after opening is laid out when it comes
		start := int64(0)
		if front != nil {
			start = front.OpenSecond
			if landed := r.cargoLotLanded(s.Shop); landed > 0 && landed%86400 > start {
				start = landed % 86400
			}
		}
		if front == nil || day < start || day >= start+s.Supply.WindowMinutes*60 || !r.storefrontOpen(s.Shop) {
			continue
		}
		ids := make([]string, 0)
		for id, i := range r.state.Inventory.Items {
			if i.Location.Kind == "store" && i.Location.Store == s.Supply.Store && i.Owner == front.Owner {
				ids = append(ids, id)
			}
		}
		sort.Strings(ids)
		var moves []inv.Move
		for _, h := range s.Heaps {
			need := h.Full - r.craftStock(front.DisplayStore, h.Item) - r.craftStock(front.ReserveStore, h.Item)
			for _, id := range ids {
				if need <= 0 {
					break
				}
				i := r.state.Inventory.Items[id]
				if i.Definition != h.Item {
					continue
				}
				q := min(i.Quantity, need)
				moves = append(moves, inv.Move{Item: id, Quantity: q, ExpectedRevision: i.Revision, To: inv.Location{Kind: "store", Store: front.DisplayStore}})
				need -= q
			}
		}
		if len(moves) == 0 {
			continue
		}
		tx := inv.Transaction{Actor: front.Owner, Sequence: r.state.Inventory.Cursors[front.Owner].Sequence + 1, RequestTag: "craft/supply/" + s.Place, Moves: moves}
		if _, err := r.vendingApplyUnlocked(r.inventoryModelFor(true), tx, s.Supply.Store); err != nil {
			return err
		}
	}
	return nil
}

func craftHash(s string) uint32 { h := fnv.New32a(); _, _ = h.Write([]byte(s)); return h.Sum32() }

// craftPick: one action of the list by weight for slot k of a stable key (no random state: replays and saves agree).
func craftPick(actions []craftActionDef, key string, k int64, skip string) (craftActionDef, bool) {
	total := 0.0
	for _, a := range actions {
		if a.ID != skip && a.Weight > 0 {
			total += a.Weight
		}
	}
	if total <= 0 {
		return craftActionDef{}, false
	}
	r := float64(craftHash(key+"#"+itoa64(k))%100000) / 100000 * total
	for _, a := range actions {
		if a.ID == skip || a.Weight <= 0 {
			continue
		}
		if r -= a.Weight; r < 0 {
			return a, true
		}
	}
	for i := len(actions) - 1; i >= 0; i-- {
		if actions[i].ID != skip && actions[i].Weight > 0 {
			return actions[i], true
		}
	}
	return craftActionDef{}, false
}

func itoa64(v int64) string {
	if v == 0 {
		return "0"
	}
	neg := v < 0
	if neg {
		v = -v
	}
	b := [24]byte{}
	i := len(b)
	for v > 0 {
		i--
		b[i] = byte('0' + v%10)
		v /= 10
	}
	if neg {
		i--
		b[i] = '-'
	}
	return string(b[i:])
}

// craftSlot: the length of one action slot of a list (the mean of the actions' own lengths, at least 4 s).
func craftSlot(actions []craftActionDef) int64 {
	if len(actions) == 0 {
		return 10
	}
	s := 0.0
	for _, a := range actions {
		s += a.Seconds
	}
	return int64(math.Max(4, math.Round(s/float64(len(actions)))))
}

func (r *Runtime) appendCraft(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView) {
	g := r.world.Craft
	if len(g.Stalls) == 0 || hero == nil || !hero.OnFloor() || hero.Level != g.Level {
		return
	}
	kits := map[string]craftKitDef{}
	for _, k := range g.Kits {
		kits[k.ID] = k
	}
	places := map[string]behavior.LifeAffordance{}
	for _, p := range r.world.Life.Brain.Places {
		places[p.ID] = p
	}
	now := r.state.Life.Seconds
	day := ((now % 86400) + 86400) % 86400
	// v26: a clip's slot runs on real seconds (the tick), not on the calendar: at the slowest calendar 10 game seconds pass in a real one, and a seller changed his clip every second
	clock := r.state.Tick / int64(max(r.world.Config.TickHz, 1))
	for _, s := range g.Stalls {
		var openS, closeS int64
		var service behavior.Cell
		display, found := "", false
		for _, sh := range r.world.Inventory.Shopfronts {
			if sh.ID == s.Shop {
				openS, closeS, service, display, found = sh.OpenSecond, sh.CloseSecond, behavior.Cell{X: sh.Service.At.X, Y: sh.Service.At.Y}, sh.DisplayStore, true
				break
			}
		}
		if !found || !viewSees(perception, int32(service.X), int32(service.Y)) {
			continue
		}
		kit := kits[s.Kit]
		open := r.storefrontOpen(s.Shop)
		out := &pb.PocCraftStall{Place: s.Place, Kit: s.Kit, Open: open, Phase: "closed", ChargePpm: -1, Seller: s.Trader}
		D := kit.Closure.PhaseMinutes * 60
		if D < 60 {
			D = 600
		}
		if open {
			switch {
			case day >= closeS-D && day < closeS:
				out.Phase, out.PhasePpm = "closing", int32((day-(closeS-D))*1000000/D)
			case day >= openS && day < openS+D:
				out.Phase, out.PhasePpm = "opening", int32((day-openS)*1000000/D)
			default:
				out.Phase = "open"
			}
		}
		out.Heaps = r.craftHeaps(s, display, out.Phase, int64(out.PhasePpm))
		for _, name := range s.Replaces {
			out.ReplacedNodes = append(out.ReplacedNodes, "island."+s.Island+":"+name)
		}
		if kit.Charge != nil && kit.Charge.FullHours > 0 {
			t := day
			if t >= closeS {
				t = closeS
			}
			f := 0.0
			if t > openS {
				f = math.Min(1, float64(t-openS)/(kit.Charge.FullHours*3600))
			}
			out.ChargePpm = int32(float64(kit.Charge.StartPPM) + (1000000-float64(kit.Charge.StartPPM))*f)
		}
		if open {
			L := craftSlot(s.Seller)
			k := clock / L
			phaseActions := []craftActionDef(nil)
			switch out.Phase {
			case "closing":
				phaseActions = g.ClosingActions
			case "opening":
				phaseActions = g.OpeningActions
			}
			if len(phaseActions) > 0 {
				// v26: the last and the first minutes of a place: he packs up or lays out (the clip of a slot, a stable hash of place and slot)
				pl := max(int64(r.world.HallClosing.SlotSeconds), 1)
				pk := clock / pl
				if a, ok := craftPick(phaseActions, s.Place+"#phase", pk, ""); ok {
					out.SellerAction, out.ActionSinceSeconds = a.ID, pk*pl
				}
			} else if id, since, ok := r.craftingSellerWork(s.Trader); ok {
				out.SellerAction, out.ActionSinceSeconds = id, since // crafting: the master works an order (doc 93)
			} else if a, ok := craftPick(s.Seller, s.Place+"#seller", k, ""); ok {
				out.SellerAction, out.ActionSinceSeconds = a.ID, k*L
			}
		}
		if p, ok := places[s.BrainPlace]; ok && s.BrainPlace != "" {
			L := craftSlot(s.Buyer)
			buyer := func(id string, level string, at behavior.Cell, still bool) {
				if level != p.Level {
					return
				}
				out.Queue++
				d := at.X - p.At.X
				if d < 0 {
					d = -d
				}
				e := at.Y - p.At.Y
				if e < 0 {
					e = -e
				}
				if d+e > 4 || !still {
					return
				}
				b := &pb.PocCraftBuyer{Actor: id, AtCounter: at == p.At}
				k := clock / L
				if b.AtCounter {
					if a, ok := craftPick(s.Buyer, s.Place+"#"+id, k, "queue"); ok {
						b.Action, b.SinceSeconds = a.ID, k*L
					}
				} else {
					b.Action, b.SinceSeconds = "queue", k*L
				}
				out.Buyers = append(out.Buyers, b)
			}
			for _, a := range r.state.Life.Actors {
				if a.ID != playerActorID && a.Brain.Place.ID == s.BrainPlace && a.OnFloor() {
					buyer(a.ID, a.Level, a.Position, a.Arrived && len(a.Path) == 0)
				}
			}
			for _, a := range r.state.Life.Population.Actors {
				if a.Brain.Place.ID == s.BrainPlace && a.Trip == nil {
					buyer(a.ID, a.Level, a.Position, a.Arrived && len(a.Path) == 0)
				}
			}
		}
		view.CraftStalls = append(view.CraftStalls, out)
	}
}

// appendGoodsDress: the dressed selling places the hero sees (phase 3d). For every prop the server says whether it is
// there now and which model stands for it: by the state of the storefront (open / shut), by the real stock of the shop's
// showcase for a prop that follows a stock (a level of three, nothing when sold out), and whether its lamp burns.
// The pose is plan metres like a heap slot's; a prop that is not there is sent with an empty scene.
func (r *Runtime) appendGoodsDress(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView) {
	g := r.world.Craft
	if len(g.Dress) == 0 || hero == nil || !hero.OnFloor() || hero.Level != g.Level {
		return
	}
	for _, d := range g.Dress {
		var front *inv.Shopfront
		for i := range r.world.Inventory.Shopfronts {
			if r.world.Inventory.Shopfronts[i].ID == d.Shop {
				front = &r.world.Inventory.Shopfronts[i]
			}
		}
		// market goods stage 2: a shuttered island place has no shop — never open, seen through the cells of its counter
		if d.Shop == "" {
			seen := false
			for _, k := range g.Counters {
				if k.Place != d.Place || len(k.Units) == 0 {
					continue
				}
				y := int32(k.At.Y)
				if k.Side == "south" {
					y += int32(g.Passport.SizeMM.D/500) - 1
				}
				for _, u := range k.Units {
					for dx := int32(0); dx < 3 && !seen; dx++ {
						seen = viewSees(perception, int32(k.At.X)+int32(u)*3+dx, y)
					}
				}
			}
			if !seen {
				continue
			}
		} else if front == nil || !viewSees(perception, int32(front.Service.At.X), int32(front.Service.At.Y)) {
			continue
		}
		open := d.Shop != "" && r.storefrontOpen(d.Shop)
		out := &pb.PocGoodsDress{Place: d.Place, Open: open}
		// the frame of the place: its origin in plan metres, the direction of its x axis and of the way inwards
		var x0, y0, z0, yaw float64
		along, inwards := 1.0, -1.0
		if d.Frame == "bay" {
			x0, y0, z0, yaw = float64(d.AtMM[0])/1000, float64(d.AtMM[1])/1000, float64(d.AtMM[2])/1000, float64(d.Yaw)
			out.ReplacedNodes = append(out.ReplacedNodes, d.Replaces...)
			out.ShutNodes = append(out.ShutNodes, d.Shut...)
		} else {
			for _, k := range g.Counters {
				if k.Place != d.Place || len(k.Units) == 0 {
					continue
				}
				x0 = float64(k.At.X)*0.5 + float64(k.Units[0])*1.5
				if k.Side == "south" {
					y0 = float64(k.At.Y)*0.5 + float64(g.Passport.SizeMM.D)/1000
				} else {
					y0, yaw, inwards = float64(k.At.Y)*0.5, 180, 1
				}
				island := k.Island
				for _, name := range d.Replaces {
					out.ReplacedNodes = append(out.ReplacedNodes, island+":"+name)
				}
			}
		}
		for _, q := range d.Props {
			row := &pb.PocCraftHeap{Id: q.ID, Fill: "packed", YawDegrees: yaw + float64(q.Yaw), Z: z0 + float64(q.ZMM)/1000}
			if d.Frame == "bay" {
				row.X, row.Y = x0+float64(q.XMM)/1000, y0-float64(q.DMM)/1000
			} else {
				row.X, row.Y = x0+along*float64(q.XMM)/1000, y0+inwards*float64(q.DMM)/1000
			}
			shown := q.Show == "always" || (q.Show == "open") == open
			if shown {
				row.Fill, row.HeapResource = "full", g.Models[q.Model].Scene
				if st := q.Stock; st != nil {
					var n int64
					if len(st.Items) == 0 {
						for _, i := range r.state.Inventory.Items {
							if i.Location.Kind == "store" && i.Location.Store == front.DisplayStore && i.ForSale && !i.Hidden {
								n += i.Quantity
							}
						}
					} else {
						for _, item := range st.Items {
							n += r.craftStock(front.DisplayStore, item)
						}
					}
					row.Fill = craftHeapLevel(n, st.Full)
					switch row.Fill {
					case "half":
						row.HeapResource = g.Models[st.Half].Scene
					case "few":
						row.HeapResource = g.Models[st.Few].Scene
					case "empty":
						row.HeapResource = ""
					}
				}
				row.Lit = q.Lit && open
			}
			out.Props = append(out.Props, row)
		}
		view.GoodsDress = append(view.GoodsDress, out)
	}
}
