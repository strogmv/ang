   if(id=="char.hero"&&state.PlayerCondition!=null&&!string.IsNullOrEmpty(state.PlayerCondition.WeaponId))return state.PlayerCondition.WeaponId;
   if(id!="char.hero"&&state!=null)foreach(var agent in state.SceneAgents)if(agent.Id==id)return string.IsNullOrEmpty(agent.HeldItem)?"unarmed":agent.HeldItem;
