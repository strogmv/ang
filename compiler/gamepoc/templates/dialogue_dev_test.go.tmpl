		if err != nil || v.Developer != nil || bytes.Contains(raw, []byte(`"developer"`)) || bytes.Contains(raw, []byte("quests/")) {
			t.Fatalf("developer data leaked: %v %s", err, raw)
		}
		pbWire, err := proto.Marshal(v)
		if err != nil { t.Fatal(err) }
		baseline, err := proto.Marshal(want)
		if err != nil || !bytes.Equal(pbWire, baseline) { t.Fatal("ordinary wire changed") }
	}
	var ordinary pb.PocGameState
	if allocs := testing.AllocsPerRun(100, func() { r.appendDeveloper(&ordinary) }); allocs != 0 {
		t.Fatalf("off diagnostics allocated %v per publish", allocs)
	}

	assertAbsent()
	if r.lifeCommand(&pb.PocLifeCommand{Action: "developer_view", Destination: "on"}) == nil {
		t.Fatal("ordinary server accepted a developer switch")
	}
	assertAbsent()
	r.SetDeveloperMode(true)
	if v := developerTalkView(r); v.GetDeveloper().GetDialogue().GetStoryFile() != "quests/акт-1/scene-03/scene.twee" {
		t.Fatalf("missing designer view: %v", v.GetDeveloper())
