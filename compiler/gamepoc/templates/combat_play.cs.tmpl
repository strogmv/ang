   if(!fight.Active&&fight.Winner!=""){var marked=new HashSet<string>();for(int i=combatQueue.Count-1;i>=0;i--){var b=combatQueue[i];if(b.kind=="attack"&&b.hit&&!string.IsNullOrEmpty(b.target)&&marked.Add(b.target)&&CombatFinalDown(b.target))b.targetDown=true;}}
