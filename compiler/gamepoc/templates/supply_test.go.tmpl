func commerceQuantity(s inv.State,store string)int64{var n int64;for _,i:=range s.Items{if i.Location.Kind=="store"&&i.Location.Store==store{n+=i.Quantity}};return n}
// The finite source may be below in Copper, in a trailer of the cargo convoy, or landed in the stall's locker (cargo to
// the market v1); loose deck freight may be below, on the deck or at receiving. These are the same units; none are
// replenished by a calendar event.
func commerceIncomingQuantity(r *Runtime,d inv.Delivery)int64{n:=commerceQuantity(r.state.Inventory,d.SourceStore);if r.world.LiftingDecks!=nil{for _,deck:=range r.world.LiftingDecks.Decks{if deck.Freight==nil{continue};for _,route:=range deck.Freight.Routes{if route.DeliveryID==d.ID{n+=commerceQuantity(r.state.Inventory,route.CopperStore)+commerceQuantity(r.state.Inventory,route.DeckStore)}}}}
 if r.world.CargoConvoys!=nil{for _,lot:=range r.world.CargoConvoys.Lots{if lot.Delivery!=d.ID{continue};n+=commerceQuantity(r.state.Inventory,lot.CopperStore);for _,store:=range lot.TrailerStores{n+=commerceQuantity(r.state.Inventory,store)}}};return n}
func commerceTotal(s inv.State)int64{var n int64;for _,i:=range s.Items{n+=i.Quantity};return n}
type merchantHostDelivery struct{ID,Carrier string;Pickup,Dropoff int64;SourceBefore,SourceAfter,ShopBefore,ShopAfter int64;Cargo []inv.Cargo}
type merchantHostProof struct{Pass bool;Scope,ContentHash string;Start,End,Rate,InitialTotal,FinalTotal int64;PopulationIDs,ReplayTicks,PrivateHomes,Packed,Protected int;Deliveries []merchantHostDelivery}
func TestMarketDeliveriesActualNightLife100(t *testing.T){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 if len(r.world.Inventory.Deliveries)==0{t.Skip("fixture has no merchant deliveries")};if len(r.world.Inventory.Deliveries)!=8||len(r.world.Inventory.Shopfronts)<8{t.Fatal("incomplete eight-shop fixture")} // unsupplied tenant stalls may add shopfronts
 // This regression isolates delivery/packing conservation; stage-1 day tests include consumers.
 r.world.Life.Brain.Enabled=false
 // ...and so do the visitors' tests: the hall's visitors (and the stalls' morning lay-out with them) are consumers too.
 r.world.Visitors.Level=""
 life,err:=r.world.Life.StartWithPopulation(100,playerActorID);if err!=nil{t.Fatal(err)}
 r.state.Active=true;r.state.Speed=1;r.initLifeState(life);r.state.Life.SecondsPerTick=1;r.state.Life.Actor(playerActorID).Manual=true
 if r.state.Life.Seconds!=7*3600{t.Fatal("overnight fixture must start at07:00")}
 report:=merchantHostProof{Scope:"actual Runtime.advanceLifeFrameBy + inventory, continuous Life100 day1 07:00 to day2 12:00; no Unity/network-frame/FPS claim",ContentHash:r.world.ContentHash,Start:r.state.Life.Seconds,Rate:1,InitialTotal:commerceTotal(r.state.Inventory)}
 defer func(){report.Pass=!t.Failed();report.End=r.state.Life.Seconds;report.FinalTotal=commerceTotal(r.state.Inventory);report.PopulationIDs=r.state.Life.Population.Count;b,_:=json.MarshalIndent(report,"","  ");t.Logf("MERCHANT_HOST_PROOF %s",b);if file:=os.Getenv("ANG_MARKET_SUPPLY_REPORT");file!=""{if err:=os.MkdirAll(filepath.Dir(file),0700);err!=nil{t.Error(err)}else if err=os.WriteFile(file,b,0600);err!=nil{t.Error(err)}}}()
 initialItems:=r.state.Inventory.Clone().Items
 initialSource,initialDisplay,initialReserve:=map[string]int64{},map[string]int64{},map[string]int64{}
 shops:=map[string]inv.Shopfront{};for _,sh:=range r.world.Inventory.Shopfronts{shops[sh.Owner]=sh;initialDisplay[sh.ID]=commerceQuantity(r.state.Inventory,sh.DisplayStore);initialReserve[sh.ID]=commerceQuantity(r.state.Inventory,sh.ReserveStore)}
 records:=map[string]*merchantHostDelivery{};for _,d:=range r.world.Inventory.Deliveries{initialSource[d.ID]=commerceIncomingQuantity(r,d);if d.Quantity!=3||initialSource[d.ID]<3{t.Fatal("fixture requires finite three-unit consignments")};sh:=shops[d.Carrier];records[d.ID]=&merchantHostDelivery{ID:d.ID,Carrier:d.Carrier,SourceBefore:initialSource[d.ID],ShopBefore:initialDisplay[sh.ID]+initialReserve[sh.ID]}}
 picked,delivered,inside:=map[string]bool{},map[string]bool{},map[string]bool{};closed,saved:=false,false;var replay *Runtime
 for r.state.Life.Seconds<86400+12*3600 {
  r.state.Tick++;if err=r.advanceLifeFrameBy(1);err!=nil{t.Fatal(err)}
  if replay!=nil{replay.state.Tick++;if err=replay.advanceLifeFrameBy(1);err!=nil{t.Fatal(err)};if !reflect.DeepEqual(r.state.Inventory,replay.state.Inventory)||!reflect.DeepEqual(r.state.Life.Clone(),replay.state.Life.Clone()){t.Fatal("in-flight delivery diverged after disk save")};report.ReplayTicks++}
  if r.state.Life.Seconds==22*3600 {
   closed=true
   for _,sh:=range r.world.Inventory.Shopfronts{
    // An around-the-clock counter (the hub yatai, demo-hub v5-yatai) has no night closing to check.
    if sh.OpenSecond==0&&sh.CloseSecond==86400{continue}
    if open,_:=r.state.Inventory.ShopStatus(sh);open||r.state.Inventory.ShopAccess(r.world.Inventory,playerActorID,sh.DisplayStore,r.state.Life.Seconds){t.Fatal("night shop stayed open")}
    display,reserve:=commerceQuantity(r.state.Inventory,sh.DisplayStore),commerceQuantity(r.state.Inventory,sh.ReserveStore)
    for id,old:=range initialItems{if old.Location!=(inv.Location{Kind:"store",Store:sh.DisplayStore}){continue};now,ok:=r.state.Inventory.Items[id];target:=sh.DisplayStore;if sh.PackAway{target=sh.ReserveStore};if !ok||now.ID!=old.ID||now.Owner!=old.Owner||now.Definition!=old.Definition||now.Quantity!=old.Quantity||now.Location!=(inv.Location{Kind:"store",Store:target}){t.Fatal("night closure replaced or lost an existing physical item")}}
    if sh.PackAway{report.Packed++;if display!=0||reserve!=initialDisplay[sh.ID]+initialReserve[sh.ID]{t.Fatal("night packing failed to transfer the same finite stock")}}else{report.Protected++;if display!=initialDisplay[sh.ID]||reserve!=initialReserve[sh.ID]{t.Fatal("protected display moved or lost its stock")}}
   }
  }
  for _,d:=range r.world.Inventory.Deliveries{
   p:=r.state.Inventory.Deliveries[d.ID];a:=r.state.Life.Actor(d.Carrier);rec:=records[d.ID];sh:=shops[d.Carrier]
   if a.ResidenceID!=""{inside[a.ID]=true;if a.OnFloor(){t.Fatal("private resident is still a physical actor")}}
   if p.Phase=="carrying"&&!picked[d.ID]{
    picked[d.ID]=true;rec.Pickup=r.state.Life.Seconds;rec.SourceAfter=commerceIncomingQuantity(r,d);rec.Cargo=append([]inv.Cargo(nil),p.Cargo...)
    if !a.OnFloor()||len(a.Path)!=0||a.Level!=d.Pickup.Level||a.Position.X!=d.Pickup.At.X||a.Position.Y!=d.Pickup.At.Y||rec.SourceAfter!=rec.SourceBefore-3{t.Fatal("pickup not a physical finite transfer")}
    qty:=int64(0);for _,cargo:=range p.Cargo{item,ok:=r.state.Inventory.Items[cargo.Item];if !ok||item.ID!=cargo.Item||item.Quantity!=cargo.Quantity||item.Definition!=d.Definition||item.Owner!=d.Carrier||item.Location!=(inv.Location{Kind:"store",Store:inv.ActorStore(d.Carrier)}){t.Fatal("manifest does not name the actual carried items")};qty+=cargo.Quantity};if qty!=3{t.Fatal("physical cargo is not exactly three units")}
    if commerceTotal(r.state.Inventory)!=report.InitialTotal{t.Fatal("pickup minted or lost stock")}
    if !saved{snapshot:=r.snapshotState();slot:=r.world.Config.SaveSlots[0];if err=r.writeSave(slot,snapshot);err!=nil{t.Fatal(err)};restored,_,e:=r.readSave(slot);if e!=nil{t.Fatal(e)};if !reflect.DeepEqual(snapshot.Inventory,restored.Inventory)||!reflect.DeepEqual(snapshot.Life.Clone(),restored.Life.Clone()){t.Fatal("saved cargo/actor identity changed")};replay=&Runtime{world:r.world,canonicalWorld:r.canonicalWorld,sdkWorlds:r.sdkWorlds,state:restored};saved=true}
   }
   if p.Cycle==1&&!delivered[d.ID]{
    delivered[d.ID]=true;rec.Dropoff=r.state.Life.Seconds;rec.ShopAfter=commerceQuantity(r.state.Inventory,sh.DisplayStore)+commerceQuantity(r.state.Inventory,sh.ReserveStore)
    if !picked[d.ID]||p.Phase!=""||len(p.Cargo)!=0||!a.OnFloor()||len(a.Path)!=0||a.Level!=d.Dropoff.Level||a.Position.X!=d.Dropoff.At.X||a.Position.Y!=d.Dropoff.At.Y||rec.ShopAfter!=rec.ShopBefore+3{t.Fatal("dropoff did not physically add exactly the carried consignment")}
    // Opening can move a just-delivered item from reserve to display in the same tick.
    for _,cargo:=range rec.Cargo{item,ok:=r.state.Inventory.Items[cargo.Item];if !ok||item.ID!=cargo.Item||item.Quantity!=cargo.Quantity||item.Definition!=d.Definition||item.Owner!=d.Carrier||item.Location.Kind!="store"||(item.Location.Store!=sh.DisplayStore&&item.Location.Store!=sh.ReserveStore){t.Fatal("delivered physical cargo identity changed")}}
    if commerceTotal(r.state.Inventory)!=report.InitialTotal{t.Fatal("dropoff minted or lost stock")}
   }
  }
 }
 report.PrivateHomes=len(inside);for _,d:=range r.world.Inventory.Deliveries{report.Deliveries=append(report.Deliveries,*records[d.ID]);if commerceIncomingQuantity(r,d)!=initialSource[d.ID]-3{t.Fatal("source was reused or replenished without a transaction")}}
 if !closed||report.Packed==0||report.Protected==0||len(picked)!=8||len(delivered)!=8||len(inside)!=8||!saved||report.ReplayTicks<1000||r.state.Life.Population.Count!=100{t.Fatalf("incomplete real commerce: closed%v pickup%d delivered%d private%d save%v replay%d",closed,len(picked),len(delivered),len(inside),saved,report.ReplayTicks)}
 if commerceTotal(r.state.Inventory)!=report.InitialTotal{t.Fatal("overall physical quantity changed")}
 if err=r.validateLifeSave(r.state);err!=nil{t.Fatal(err)}
}
func TestStorefrontProjectionHidesClosedStockAndOffscreenShops(t *testing.T){
 r:=lifeRuntimeFixture(t);if len(r.world.Inventory.Shopfronts)==0{t.Skip("no authored shopfront")};hero:=r.state.Life.Actor(playerActorID);shop:=r.world.Inventory.Shopfronts[0]
 view:=&pb.PocLifeView{};r.appendStorefrontState(view,hero,&pb.PocObserverView{});if len(view.Storefronts)!=0{t.Fatal("offscreen stock leaked")}
 perception:=&pb.PocObserverView{};terrain:=r.world.Life.Locations[shop.Service.Level].Terrain;for _,line:=range terrain{perception.Cells=append(perception.Cells,strings.Repeat("0",len(line)))};row:=[]byte(perception.Cells[shop.Service.At.Y]);row[shop.Service.At.X]='2';perception.Cells[shop.Service.At.Y]=string(row)
 base:=r.state.Inventory.Clone()
 for _,kind:=range []string{"closed_stocked","closed_empty","open_empty","open_hidden_only","open_stocked"}{t.Run(kind,func(t *testing.T){
  r.state.Inventory=base.Clone();open:=strings.HasPrefix(kind,"open_");r.state.Inventory.Shopfronts[shop.ID]=inv.ShopProgress{Open:open}
  for id,item:=range r.state.Inventory.Items{if item.Location.Kind!="store"||item.Location.Store!=shop.DisplayStore{continue};if strings.HasSuffix(kind,"empty"){item.Location.Store=shop.ReserveStore};if kind=="open_hidden_only"{item.Hidden=true};r.state.Inventory.Items[id]=item}
  view:=&pb.PocLifeView{};r.appendStorefrontState(view,hero,perception);stocked:=kind=="open_stocked"
  if len(view.Storefronts)!=1||view.Storefronts[0].Open!=open||view.Storefronts[0].Stocked!=stocked{t.Fatal("public shop state exposed closed, reserve or hidden stock")}
  key:="";if !open{key="market.stall.closed"}else if !stocked{key="market.stall.empty"}
  ru,en:="",""
  for _,locale:=range []string{"ru","en"}{msg:=&pb.PocGameState{Life:&pb.PocLifeView{Storefronts:view.Storefronts,Inspections:[]*pb.PocInspectionObject{{Id:shop.InspectionID,TextKey:"authored.stall",BaseText:"VISIBLE_GOODS"}}}};r.appendStorefrontInspection(msg,locale);object:=msg.Life.Inspections[0]
   if key==""{if object.BaseText!="VISIBLE_GOODS"||object.TextKey!="authored.stall"{t.Fatal("open stocked description replaced")};continue}
   want:=r.localText(locale,key,"");if want==""||want==key||object.TextKey!=key||object.BaseText!=want{t.Fatal("closed/empty inspection is missing, untranslated or exposes goods")};if locale=="ru"{ru=object.BaseText}else{en=object.BaseText}
  }
  if key!=""&&ru==en{t.Fatal("RU/EN inspection did not select distinct localized text")}
 })}
}

func TestMarketIncomingHoldWaitsForLandingWithoutHijackingFutureStall(t *testing.T){
 r:=lifeRuntimeFixture(t);if r.world.CargoConvoys==nil||len(r.world.CargoConvoys.Convoys)==0{t.Skip("no cargo lots")}
 v:=r.world.CargoConvoys.Convoys[0];run:=v.Runs[0];unload:=-1;for i,leg:=range run.Legs{if leg.Kind=="unload"{unload=i}};if unload<0{t.Fatal("the cargo run has no unloading")}
 for _,lot:=range r.world.CargoConvoys.Lots{if lot.Kind!="delivery"{continue};var delivery inv.Delivery;for _,d:=range r.world.Inventory.Deliveries{if d.ID==lot.Delivery{delivery=d}};a:=r.state.Life.Actor(delivery.Carrier);if a==nil{t.Fatal("missing existing merchant")};wanted:=behavior.LifeStep{Level:delivery.Dropoff.Level,At:behavior.Cell{X:delivery.Dropoff.At.X,Y:delivery.Dropoff.At.Y},Activity:"service"}
  if _,active:=r.commerceRouteDetour(a,wanted);active{t.Fatal("07:00 new game was hijacked by tomorrow's Copper lot")}
  // tomorrow 06:30: the run of the day is on its way and has not unloaded yet, the lot rides in the hitched trailer
  r.state.Life.Seconds=86400+6*3600+30*60;c:=r.state.CargoConvoys.Convoys[v.ID];c.Run,c.Day,c.Leg,c.Phase=run.ID,2,unload-2,"go";r.state.CargoConvoys.Convoys[v.ID]=c
  if _,err:=r.state.Inventory.MoveMachineConsignment(r.inventoryModelFor(true),lot.Owner,lot.CopperStore,lot.TrailerStores[c.Hitched],lot.Definition,lot.Quantity,"test/load/"+lot.Shop);err!=nil{t.Fatal(err)}
  held,active:=r.commerceRouteDetour(a,wanted);if !active||held.Level!=delivery.Pickup.Level||held.At!=(behavior.Cell{X:delivery.Pickup.At.X,Y:delivery.Pickup.At.Y}){t.Fatal("a late lot did not hold the overdue collecting duty at the locker")}
  poses:=map[string]inv.DeliveryPose{a.ID:{Level:delivery.Pickup.Level,At:delivery.Pickup.At,Present:true}};r.holdUnreadyCargoPickups(poses);if poses[a.ID].Present{t.Fatal("an empty locker during the run counted as the day's failed pickup")}
  if _,active=r.commerceRouteDetour(a,behavior.LifeStep{Level:a.Level,At:a.Position,Activity:"eat"});active{t.Fatal("cargo waiting overrode an ordinary urgent need")}
  // Once pickup succeeds, the ordinary proprietor route resumes.
  progress:=r.state.Inventory.Deliveries[delivery.ID];progress.Phase="carrying";r.state.Inventory.Deliveries[delivery.ID]=progress
  if _,active=r.commerceRouteDetour(a,wanted);active{t.Fatal("holding continued after real pickup")}
  return
 }
 t.Fatal("no delivery lot")
}

// The whole morning with the real brain: carriers sleep on another level, come through gate 7 when it rises and take
// from their locker only what the convoy has physically put there. The earlier isolated checks moved the carrier by
// hand and missed a person who never left home.
func TestMarketIncomingCarriersTravelFromHomeAndCollectLandedCargo(t *testing.T){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 if r.world.CargoConvoys==nil||len(r.world.CargoConvoys.Lots)==0{t.Skip("no cargo lots")}
 if !r.world.Life.Brain.Enabled{t.Skip("content has no enabled brain")}
 cellHero(r);r.state.Active=true;r.state.Speed=1;r.initLife()
 lots:=map[string]cargoLotDefinition{};for _,lot:=range r.world.CargoConvoys.Lots{if lot.Kind=="delivery"{lots[lot.Delivery]=lot}}
 incoming:=func(lot cargoLotDefinition)int64{n:=commerceQuantity(r.state.Inventory,lot.CopperStore)+commerceQuantity(r.state.Inventory,lot.LockerStore);for _,s:=range lot.TrailerStores{n+=commerceQuantity(r.state.Inventory,s)};return n}
 before:=map[string]int64{};for id,lot:=range lots{before[id]=incoming(lot)}
 day:=r.state.Life.Seconds/86400+1;morning:=day*86400
 r.state.Life.SecondsPerTick=30;for r.state.Life.Seconds<morning+4*3600{r.step()}
 r.state.Life.SecondsPerTick=1
 collected:=map[string]int64{}
 for r.state.Life.Seconds<morning+8*3600&&len(collected)<len(lots){
  r.step()
  for id,lot:=range lots{
   if _,done:=collected[id];done{continue}
   if r.state.Inventory.Deliveries[id].Phase==""{if incoming(lot)!=before[id]{t.Fatalf("%s: the lot's stores changed before any pickup",id)};continue}
   if r.cargoLotLanded(lot.Shop)==0{t.Fatalf("%s collected before the lot reached the locker",id)}
   if incoming(lot)!=before[id]-lot.Quantity{t.Fatalf("%s: pickup did not take exactly its lot",id)}
   collected[id]=r.state.Life.Seconds-morning
  }
 }
 if len(collected)!=len(lots){
  for id,lot:=range lots{if _,done:=collected[id];!done{a:=r.state.Life.Actor(lot.Owner);t.Errorf("%s not collected by 08:00: carrier on %s at %v doing %s",id,a.Level,a.Position,a.Activity)}}
  t.FailNow()
 }
 t.Logf("carriers collected their lots from the lockers, game seconds after midnight: %v",collected)
}
