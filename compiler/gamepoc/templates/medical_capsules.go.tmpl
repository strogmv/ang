		if id != except && p.UnitID == unit && p.Phase != "queued" {
			return true
		}
	}
	return false
}

// The oldest reservation keeps its place while its real approach is blocked.
// A later queued patient may not take the now-empty capsule ahead of it.
func (r *Runtime) medicalQueuedAhead(p medicalPatient) bool {
	for _, other := range r.state.Medical.Patients {
		if other.UnitID == p.UnitID && other.Phase == "queued" && other.Serial < p.Serial {
			return true
		}
	}
	return false
}
func (r *Runtime) medicalHoldPatients() {
	for id, p := range r.state.Medical.Patients {
		if p.Phase == "approach" {
			continue
		}
		if a := r.state.Life.Actor(id); a != nil {
			a.CombatHold = true
			a.Manual = true
			a.Body = nil
			a.Path = nil
			a.PendingPath = nil
			a.Goal = a.Position
			a.OverrideLevel = ""
			a.OverrideEdge = ""
			a.Brain.InterruptService()
		}
	}
}
func (r *Runtime) medicalApproach(p *medicalPatient, u medicalUnit) error {
	a := r.state.Life.Actor(p.ActorID)
	if a == nil || !a.OnFloor() || a.Level != u.LevelID {
		return textError{Key: "medical.error.unavailable"}
	}
	model := r.state.Life.GateModel(r.world.Life)
	blocked := r.state.Life.BlockedCells(a.Level, a.ID)
	path := model.Space(a.Level, blocked).Path(a.Position, u.ScanCell, behavior.Cell{}, 0)
	if a.Position != u.ScanCell && len(path) == 0 {
		return textError{Key: "medical.error.path"}
	}
	beforeLife := r.state.Life.Clone()
	a.CombatHold = false
	a.RestFootprint = nil
	a.Manual = true
	a.OverrideLevel = a.Level
	a.OverrideAt = u.ScanCell
	a.OverrideEdge = ""
	a.Arrived = false
	a.PendingPath = nil
	a.Path = path
	a.Goal = u.ScanCell
	a.MoveStartTick = r.lifeMotionTick()
	a.Activity = "walking"
	a.Label = "medical.phase.approach"
	if a.ID == playerActorID && model.BodyCapable(a.Level) {
		r.state.Life.EnsureHeroBody(model)
		if !r.state.Life.HeroBodyRouteTo(model, u.ScanCell) {
			r.state.Life = beforeLife
			return textError{Key: "medical.error.path"}
		}
	}
	r.medicalSetPhase(p, "approach", 0)
	return nil
}
func (r *Runtime) medicalRequest(actorID, unitID string) error {
	cfg := r.world.MedicalCapsules
	u := cfg.unit(unitID)
	a := r.state.Life.Actor(actorID)
	if old, ok := r.state.Medical.Patients[actorID]; ok {
		if old.UnitID == unitID {
			return nil
		}
		return textError{Key: "medical.error.busy"}
	}
	if r.sanitaryReserved(actorID) || u == nil || a == nil || !a.OnFloor() || a.Level != u.LevelID || r.state.Paused || r.state.Combat.Active && r.state.Combat.Actor(actorID) != nil {
		return textError{Key: "medical.error.unavailable"}
	}
	c := r.combatant(actorID, "player")
	b := combatBody(c)
	status := combatWounds.Status(b)
	if b.Dead {
		return textError{Key: "wounds.care.dead"}
	}
	if !status.CanWalk {
		return textError{Key: "medical.error.cannot_walk"}
	}
	count := 0
	for _, p := range r.state.Medical.Patients {
		if p.UnitID == unitID {
			count++
		}
	}
	if count >= cfg.QueueLimit {
		return textError{Key: "medical.error.busy"}
	}
	if len(r.state.Medical.Receipts) >= 4096 || r.state.Medical.Serial == ^uint64(0) {
		return textError{Key: "medical.error.busy"}
	}
	if r.state.Medical.Patients == nil {
		r.state.Medical.Patients = map[string]medicalPatient{}
	}
	p := medicalPatient{ActorID: actorID, UnitID: unitID, Serial: r.state.Medical.Serial + 1, PriorManual: a.Manual, LeaseUntilNS: r.simNS() + cfg.LeaseSeconds*1e9}
	r.medicalSetPhase(&p, "queued", 0)
	if count == 0 && !r.medicalBusy(unitID, actorID) {
		if err := r.medicalApproach(&p, *u); err != nil {
			return err
		}
	}
	r.state.Medical.Serial = p.Serial
	a.Manual = true
	r.state.Medical.Patients[actorID] = p
	r.medicalHoldPatients()
	return nil
}
func (r *Runtime) medicalOffer(p *medicalPatient, u medicalUnit) error {
	q, err := r.medicalQuote(p.ActorID, u)
	if err != nil {
		return err
	}
	p.Quote = q
	p.Accepted = false
	p.OfferRevision++
	p.OfferID = fmt.Sprintf("medical:%s:%d:%d", p.ActorID, p.Serial, p.OfferRevision)
	p.Reason = q.Reason
	r.medicalSetPhase(p, "offer", 0)
	p.LeaseUntilNS = r.simNS() + r.world.MedicalCapsules.LeaseSeconds*1e9
	return nil
}
func (r *Runtime) medicalAccept(actorID, unitID, offer string) error {
	if receipt, ok := r.state.Medical.Receipts[offer]; ok && receipt.ActorID == actorID && receipt.UnitID == unitID {
		return nil
	}
	p, ok := r.state.Medical.Patients[actorID]
	if !ok || p.UnitID != unitID || offer == "" || p.OfferID != offer {
		return textError{Key: "medical.error.offer"}
	}
	if p.Accepted && (p.Phase == "entry" || p.Phase == "treatment") {
		return nil
	}
	if p.Phase != "offer" || r.state.Paused {
		return textError{Key: "medical.error.scan"}
	}
	u := r.world.MedicalCapsules.unit(p.UnitID)
	q, err := r.medicalQuote(actorID, *u)
	if err != nil {
		return err
	}
	if q.Mode == "refused" {
		return textError{Key: q.Reason}
	}
	if !medicalSameTerms(p.Quote, q) {
		if err := r.medicalOffer(&p, *u); err != nil {
			return err
		}
		r.state.Medical.Patients[actorID] = p
		return textError{Key: "medical.error.offer"}
	}
	// Admission must remain physically walkable until canonical care begins.
	// Forecast uses the same wound model and current saved calendar rate; it
	// neither changes this body nor freezes bleeding during scan/entry.
	body := combatBody(r.combatant(actorID, "player"))
	future := body.Clone()
	combatWounds.Tick(&future, int64(math.Ceil(r.world.MedicalCapsules.EntrySeconds*float64(r.world.Config.TickHz)))*r.state.Life.SecondsPerTick)
	if !combatWounds.Status(body).CanWalk || !combatWounds.Status(future).CanWalk {
		return textError{Key: "medical.error.cannot_walk"}
	}
	a := r.state.Life.Actor(actorID)
	if a == nil || !a.OnFloor() || a.Position != u.ScanCell || len(a.Path) > 0 {
		return textError{Key: "medical.error.unavailable"}
	}
	p.Accepted = true
	r.medicalSetPhase(&p, "entry", r.world.MedicalCapsules.EntrySeconds)
	a.ServiceAttachment = u.ID
	a.Body = nil
	a.CombatHold = true
	r.state.Medical.Patients[actorID] = p
	return nil
}

// Commit the real body and CRD transfer together. Caller never accepts a client quote.
func (r *Runtime) medicalStartCare(actorID string) error {
	// The transaction needs immutable catalogs and a private gameplay snapshot.
	// Never copy Runtime: it owns atomic connection state and transport workers.
	next := &Runtime{world: r.world, canonicalWorld: r.canonicalWorld, state: r.snapshotState()}
	p := next.state.Medical.Patients[actorID]
	u := next.world.MedicalCapsules.unit(p.UnitID)
	if u == nil || p.Phase != "entry" || !p.Accepted || next.simNS() < p.PhaseEndNS || !next.medicalAttached(actorID) {
		return textError{Key: "medical.error.scan"}
	}
	q, err := next.medicalQuote(actorID, *u)
	if err != nil {
		return err
	}
	if q.Mode == "refused" {
		return textError{Key: q.Reason}
	}
	if !medicalSameTerms(p.Quote, q) {
		return textError{Key: "medical.error.offer"}
	}
	c := next.combatant(actorID, "player")
	b := combatBody(c)
	if b.Care != nil {
		return textError{Key: "medical.error.busy"}
	}
	if q.PriceMinor > 0 {
		payer, ok := next.medicalAccount(actorID)
		receiver, receiverOK := next.state.Inventory.Accounts[next.world.MedicalCapsules.ReceiverAccount]
		if !ok || !receiverOK {
			return textError{Key: "wounds.care.money"}
		}
		_, err = next.state.Inventory.Apply(next.inventoryModelFor(true), inv.Transaction{Actor: actorID, Sequence: next.state.Inventory.Cursors[actorID].Sequence + 1, RequestTag: p.OfferID, Payments: []inv.Payment{{From: payer.ID, To: receiver.ID, Currency: next.world.MedicalCapsules.Currency, Amount: q.PriceMinor, FromRevision: payer.Revision, ToRevision: receiver.Revision}}})
		if err != nil {
			return textError{Key: "wounds.care.money"}
		}
	}
	events, err := combatWounds.StartCare(&b, q, next.state.Seed)
	if err != nil {
		return err
	}
	projectWoundBody(&c, b)
	c.Aid = nil
	if next.state.CombatRoster == nil {
		next.state.CombatRoster = map[string]behavior.Combatant{}
	}
	next.state.CombatRoster[actorID] = c
	next.storeWoundBody(c)
	next.combatCareTrack()
	next.state.CombatCare.Clocks[actorID] = next.state.Life.Seconds
	p.ReceiptID = p.OfferID
	p.Quote = q
	p.Reason = ""
	next.medicalSetPhase(&p, "treatment", 0)
	next.state.Medical.Patients[actorID] = p
	if next.state.Medical.Receipts == nil {
		next.state.Medical.Receipts = map[string]medicalReceipt{}
	}
	next.state.Medical.Receipts[p.ReceiptID] = medicalReceipt{ID: p.ReceiptID, ActorID: actorID, UnitID: u.ID, Mode: q.Mode, PriceMinor: q.PriceMinor, Seconds: q.Seconds, BodyStart: b.Clock, InventorySequence: next.state.Inventory.Cursors[actorID].Sequence, Journal: append([]string(nil), q.Journal...)}
	next.recordWoundEvents(events)
	r.state = next.state
	return nil
}
func (r *Runtime) medicalRelease(actorID string) bool {
	p, ok := r.state.Medical.Patients[actorID]
	if !ok {
		return true
	}
	a := r.state.Life.Actor(actorID)
	u := r.world.MedicalCapsules.unit(p.UnitID)
	if a == nil || u == nil {
		return false
	}
	if a.ServiceAttachment != "" && r.state.Life.BlockedCells(u.LevelID, a.ID)[u.ScanCell] {
		return false
	}
	a.ServiceAttachment = ""
	a.CombatHold = false
	a.Manual = p.PriorManual
	a.OverrideLevel = ""
	a.OverrideEdge = ""
	a.Path = nil
	a.PendingPath = nil
	a.Goal = a.Position
	a.Body = nil
	a.Arrived = a.ID == playerActorID
	a.Activity = "rest"
	a.Label = "wounds.care.done"
	a.Brain.NextDecision = 0
	if p.Phase != "queued" {
		r.medicalDoorTarget(p.UnitID, 0)
	}
	delete(r.state.Medical.Patients, actorID)
	if c, ok := r.state.CombatRoster[actorID]; ok {
		r.combatCareHold(c)
	}
	return true
}
func (r *Runtime) medicalCommand(q *pb.PocLifeCommand) error {
	defer r.syncLifeHero()
	if r.world.MedicalCapsules == nil || !r.state.Active || !r.state.Life.Enabled {
		return textError{Key: "medical.error.unavailable"}
	}
	switch q.Action {
	case "medical_request":
		return r.medicalRequest(playerActorID, q.Destination)
	case "medical_accept":
		return r.medicalAccept(playerActorID, q.Destination, q.MedicalOfferId)
	case "medical_cancel":
		p, ok := r.state.Medical.Patients[playerActorID]
		if !ok {
			return nil
		}
		if p.Phase == "entry" || p.Phase == "treatment" || p.Phase == "exit" {
			return textError{Key: "medical.error.busy"}
		}
		r.medicalRelease(playerActorID)
		return nil
	}
	return textError{Key: "medical.error.unavailable"}
}
func (r *Runtime) advanceMedicalCapsules() error {
	cfg := r.world.MedicalCapsules
	if cfg == nil || r.state.Paused {
		return nil
	}
	now := r.simNS()
	ids := []string{}
	for id := range r.state.Medical.Patients {
		ids = append(ids, id)
	}
	sort.Slice(ids, func(i, j int) bool {
		return r.state.Medical.Patients[ids[i]].Serial < r.state.Medical.Patients[ids[j]].Serial
	})
	for _, id := range ids {
		p := r.state.Medical.Patients[id]
		u := cfg.unit(p.UnitID)
		a := r.state.Life.Actor(id)
		if a == nil || u == nil {
			return fmt.Errorf("orphaned medical patient")
		}
		if p.Phase != "entry" && p.Phase != "treatment" && p.Phase != "exit" && now >= p.LeaseUntilNS {
			// An unused expired reservation may rejoin at the tail later; it
			// must not become a permanent "already treated" injury lock.
			if id != playerActorID && p.ReceiptID == "" {
				delete(r.state.Medical.NPCAttempts, id)
			}
			r.medicalRelease(id)
			continue
		}
		switch p.Phase {
		case "queued":
			if !r.medicalBusy(u.ID, id) && !r.medicalQueuedAhead(p) {
				if err := r.medicalApproach(&p, *u); err != nil {
					// The exiting patient still occupies the shared scan/exit
					// anchor. Wait for ordinary movement, then retry actual
					// navigation. Keep the original serial and finite lease.
					p.Reason = "medical.error.path"
				} else {
					p.Reason = ""
				}
			}
		case "approach":
			if a.Position == u.ScanCell && len(a.Path) == 0 && (a.Body == nil || !a.Body.Moving) {
				a.Body = nil
				a.CombatHold = true
				a.OverrideLevel = ""
				a.OverrideEdge = ""
				r.medicalSetPhase(&p, "scan", cfg.ScanSeconds)
			}
		case "scan":
			if now >= p.PhaseEndNS {
				if err := r.medicalOffer(&p, *u); err != nil {
					return err
				}
			}
		case "offer":
			if id != playerActorID && p.Quote.Mode != "refused" {
				r.state.Medical.Patients[id] = p
				if err := r.medicalAccept(id, u.ID, p.OfferID); err != nil {
					continue
				}
				continue
			}
		case "entry":
			if now >= p.PhaseEndNS {
				if err := r.medicalStartCare(id); err != nil {
					p.Reason = "medical.error.offer"
					if reason, ok := err.(textError); ok {
						p.Reason = reason.Key
					}
					r.medicalSetPhase(&p, "exit", cfg.ExitSeconds)
				} else {
					continue
				}
			}
		case "treatment":
			c, ok := r.state.CombatRoster[id]
			if !ok {
				return fmt.Errorf("missing cared body")
			}
			if combatBody(c).Care == nil {
				r.medicalSetPhase(&p, "exit", cfg.ExitSeconds)
			}
		case "exit":
			if r.state.Life.BlockedCells(u.LevelID, id)[u.ScanCell] {
				p.ExitBlocked = true
				r.medicalSetPhase(&p, "exit", cfg.ExitSeconds)
			} else {
				if p.ExitBlocked {
					p.ExitBlocked = false
					r.medicalSetPhase(&p, "exit", cfg.ExitSeconds)
				}
				if now >= p.PhaseEndNS {
					if r.medicalRelease(id) {
						continue
					}
				}
			}
		}
		r.state.Medical.Patients[id] = p
	}
	r.medicalHoldPatients()
	r.medicalNPCRequests()
	return nil
}
func medicalInjuryKey(b wounds.Body) string {
	keys := []string{}
	for _, w := range b.Wounds {
		keys = append(keys, w.ID)
	}
	for _, c := range b.Conditions {
		// Condition IDs name a kind, not an episode. At is persisted by the
		// canonical wound engine and stays stable as that same incident ages.
		keys = append(keys, fmt.Sprintf("%s@%d", c.ID, c.At))
	}
	sort.Strings(keys)
	return strings.Join(keys, "|")
}
func (r *Runtime) medicalNPCRequests() {
	cfg := r.world.MedicalCapsules
	if cfg == nil || !cfg.NPCSelfCare {
		return
	}
	if r.state.Medical.NPCAttempts == nil {
		r.state.Medical.NPCAttempts = map[string]string{}
	}
	ids := []string{}
	for id := range r.state.CombatRoster {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		if id == playerActorID {
			continue
		}
		if _, ok := r.state.Medical.Patients[id]; ok {
			continue
		}
		a := r.state.Life.Actor(id)
		if a == nil || !a.OnFloor() || a.CombatHold || a.Manual || r.state.Combat.Active && r.state.Combat.Actor(id) != nil {
			continue
		}
		b := combatBody(r.state.CombatRoster[id])
		key := medicalInjuryKey(b)
		if key == "" {
			delete(r.state.Medical.NPCAttempts, id)
			continue
		}
		if key == r.state.Medical.NPCAttempts[id] || !combatWounds.Status(b).CanWalk {
			continue
		}
		units := append([]medicalUnit(nil), cfg.Units...)
		sort.SliceStable(units, func(i, j int) bool { return !r.medicalBusy(units[i].ID, id) && r.medicalBusy(units[j].ID, id) })
		for _, u := range units {
			if u.LevelID != a.Level {
				continue
			}
			q, err := r.medicalQuote(id, u)
			if err != nil || q.Mode == "refused" {
				continue
			}
			if r.medicalRequest(id, u.ID) == nil {
				r.state.Medical.NPCAttempts[id] = key
				break
			}
		}
	}
}
