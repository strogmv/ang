					ep.trigger(rt, room)
				}
			}); err != nil {
				return nil, fmt.Errorf("trigger %s for %s: %w", event, ep.name, err)
			}
		}
	}
	return rt, nil
}

// liveSweep forgets rooms nobody watched for a while.
func liveSweep(ctx context.Context, eps []*liveEndpoint) {
	ticker := time.NewTicker(time.Minute)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
		}
		cutoff := time.Now().Add(-15 * time.Minute)
		for _, ep := range eps {
			ep.mu.Lock()
			for id, r := range ep.rooms {
				r.mu.Lock()
				idle := len(r.clients) == 0 && r.touched.Before(cutoff)
				if idle && r.timer != nil {
					r.timer.Stop()
				}
				r.mu.Unlock()
				if idle {
					delete(ep.rooms, id)
				}
			}
			ep.mu.Unlock()
		}
	}
}

func (ep *liveEndpoint) subject(room string) string {
	return liveSubjectPrefix + ep.name + "." + room
}

func (ep *liveEndpoint) room(id string) *liveRoom {
	ep.mu.Lock()
	defer ep.mu.Unlock()
	r := ep.rooms[id]
	if r == nil {
		r = &liveRoom{clients: map[*wsClient]struct{}{}, touched: time.Now()}
		ep.rooms[id] = r
	}
	return r
}

// fetchLatest reads the room's last stored state from the stream (nil when
// there is none).
func (ep *liveEndpoint) fetchLatest(rt *liveRuntime, room string) (*liveState, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	msg, err := rt.stream.GetLastMsgForSubject(ctx, ep.subject(room))
	if err != nil {
		if errors.Is(err, jetstream.ErrMsgNotFound) {
			return nil, nil
		}
		return nil, err
	}
	prev, _ := strconv.ParseUint(msg.Header.Get(livePrevSeqHeader), 10, 64)
	data := string(msg.Data)
	return &liveState{seq: msg.Sequence, prev: prev, data: data, hash: liveHash(data)}, nil
}

// onStored takes a state the stream holds. Older than the room's latest: ignored.
func (ep *liveEndpoint) onStored(rt *liveRuntime, room string, st *liveState, live bool) {
	r := ep.room(room)
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.latest != nil && st.seq <= r.latest.seq {
		return
	}
	r.latest = st
	r.fromLive = r.fromLive || live
	r.touched = time.Now()
	if len(r.clients) > 0 {
		ep.fanoutLocked(rt, room, r)
	}
}

// ── building ────────────────────────────────────────────────────────────────

// trigger asks for a new state of the room: one build at a time per room on
// this replica; triggers arriving meanwhile coalesce into one more build.
func (ep *liveEndpoint) trigger(rt *liveRuntime, room string) {
	ep.mu.Lock()
	b := ep.builds[room]
	if b == nil {
		b = &liveBuild{}
		ep.builds[room] = b
	}
	if b.running {
		b.dirty = true
		ep.mu.Unlock()
		return
	}
	b.running = true
	ep.mu.Unlock()
	go func() {
		for {
			ep.buildAndPublish(rt, room)
			ep.mu.Lock()
			if b.dirty {
				b.dirty = false
				ep.mu.Unlock()
				continue
			}
			delete(ep.builds, room)
			ep.mu.Unlock()
			return
		}
	}()
}

// buildAndPublish reads the room from the database and appends it to the
// stream unless it equals the last stored state. The publish expects the
// subject's last sequence to be the one read BEFORE the database: when
// another replica published in between, the state is read again, so a state
// never lands after one that was read later.
func (ep *liveEndpoint) buildAndPublish(rt *liveRuntime, room string) {
	defer func() {
		if r := recover(); r != nil {
			rt.log.Error("live room build panic recovered", "endpoint", ep.name, "room", room, "panic", r)
		}
	}()
	r := ep.room(room)
	r.mu.Lock()
	last := r.latest
	r.mu.Unlock()
	if last == nil {
		fetched, err := ep.fetchLatest(rt, room)
		if err != nil {
			rt.log.Warn("live room: last state unavailable", "endpoint", ep.name, "room", room, "error", err)
			return
		}
		if fetched != nil {
			ep.onStored(rt, room, fetched, false)
			last = fetched
		}
	}
	for attempt := 0; attempt < 6; attempt++ {
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		started := time.Now()
		data, err := ep.build(ctx, room)
		cancel()
		LiveBuilds.Add(1)
		if took := time.Since(started); took > time.Second {
			rt.log.Warn("live room build slow", "endpoint", ep.name, "room", room, "ms", took.Milliseconds(), "bytes", len(data))
		}
		if err != nil {
			LiveBuildErrors.Add(1)
			rt.log.Warn("live room build failed", "endpoint", ep.name, "room", room, "error", err)
			return
		}
		hash := liveHash(data)
		if last != nil && last.hash == hash && last.data == data {
			LiveUnchanged.Add(1)
			// The stream is up to date with the database: later sockets of this
			// room need no check build.
			r.mu.Lock()
			r.fromLive = true
			r.mu.Unlock()
			return
		}
		var lastSeq uint64
		if last != nil {
			lastSeq = last.seq
		}
		msg := nats.NewMsg(ep.subject(room))
		msg.Data = []byte(data)
		msg.Header.Set(livePrevSeqHeader, strconv.FormatUint(lastSeq, 10))
		pubCtx, pubCancel := context.WithTimeout(context.Background(), 5*time.Second)
		ack, err := rt.js.PublishMsg(pubCtx, msg, jetstream.WithExpectLastSequencePerSubject(lastSeq))
		pubCancel()
		if err == nil {
			LivePublishes.Add(1)
			ep.onStored(rt, room, &liveState{seq: ack.Sequence, prev: lastSeq, data: data, hash: hash}, true)
			return
		}
		var apiErr *jetstream.APIError
		if errors.As(err, &apiErr) && (apiErr.ErrorCode == jetstream.JSErrCodeStreamWrongLastSequence || apiErr.ErrorCode == jetstream.JSErrCodeStreamWrongLastSequenceConstant) {
			LiveCASConflicts.Add(1)
			fresh, ferr := ep.fetchLatest(rt, room)
			if ferr != nil {
				rt.log.Warn("live room: last state unavailable", "endpoint", ep.name, "room", room, "error", ferr)
				return
			}
			if fresh != nil {
				ep.onStored(rt, room, fresh, false)
			}
			last = fresh
			continue
		}
		rt.log.Warn("live room publish failed", "endpoint", ep.name, "room", room, "error", err)
		return
	}
	rt.log.Warn("live room: gave up after repeated conflicts", "endpoint", ep.name, "room", room)
}

// ── views and frames ────────────────────────────────────────────────────────

func liveSnapshotFrame(seq uint64, at time.Time, reset bool, view string) []byte {
	var b strings.Builder
	b.Grow(len(view) + 96)
	b.WriteString(`{"type":"RoomSnapshot","payload":{"seq":`)
	b.WriteString(strconv.FormatUint(seq, 10))
	b.WriteString(`,"at":`)
	b.WriteString(strconv.FormatInt(at.UnixMilli(), 10))
	if reset {
		b.WriteString(`,"reset":true`)
	}
	b.WriteString(`,"view":`)
	b.WriteString(view)
	b.WriteString(`}}`)
	return []byte(b.String())
}

func liveSyncFrame(seq uint64, at time.Time) []byte {
	return []byte(`{"type":"RoomSync","payload":{"seq":` + strconv.FormatUint(seq, 10) + `,"at":` + strconv.FormatInt(at.UnixMilli(), 10) + `}}`)
}

// viewsFor derives the view of st for each company.
func (ep *liveEndpoint) viewsFor(st *liveState, companies []string, now time.Time) (map[string]string, map[string]bool, time.Time, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	snapshots, denied, refreshAt, err := ep.view(ctx, st.data, companies, now)
	if err != nil {
		return nil, nil, time.Time{}, err
	}
	views := make(map[string]string, len(companies))
	deniedBy := make(map[string]bool)
	for _, company := range denied {
		deniedBy[company] = true
	}
	for i, company := range companies {
		if deniedBy[company] {
			continue
		}
		if i < len(snapshots) && snapshots[i] != "" {
			views[company] = snapshots[i]
		}
	}
	return views, deniedBy, refreshAt, nil
}

// fanoutLocked sends every socket of the room the current view of the latest
// state, when it differs from what that socket was sent last. r.mu is held.
func (ep *liveEndpoint) fanoutLocked(rt *liveRuntime, room string, r *liveRoom) {
	if r.latest == nil || len(r.clients) == 0 {
		return
	}
	companies := make([]string, 0, 4)
	seen := map[string]bool{}
	for c := range r.clients {
		if !seen[c.live.companyID] {
			seen[c.live.companyID] = true
			companies = append(companies, c.live.companyID)
		}
	}
	now := time.Now()
	views, denied, refreshAt, err := ep.viewsFor(r.latest, companies, now)
	if err != nil {
		rt.log.Warn("live room view failed", "endpoint", ep.name, "room", room, "error", err)
		return
	}
	if took := time.Since(now); took > 250*time.Millisecond {
		rt.log.Warn("live room views slow", "endpoint", ep.name, "room", room, "viewers", len(companies), "ms", took.Milliseconds(), "state_bytes", len(r.latest.data))
	}
	for c := range r.clients {
		if denied[c.live.companyID] {
			delete(r.clients, c)
			c.closeCode.Store(liveAccessRevoked)
			go func(c *wsClient) { c.hub.unregister <- c }(c)
			continue
		}
		view, ok := views[c.live.companyID]
		if !ok {
			continue
		}
		hash := liveHash(view)
		if c.live.hasHash && c.live.lastHash == hash {
			continue
		}
		if ep.hub.sendDirect(c, liveSnapshotFrame(r.latest.seq, now, false, view)) {
			LiveFrames.Add(1)
			c.live.lastHash = hash
			c.live.hasHash = true
		}
	}
	ep.scheduleRefreshLocked(rt, room, r, refreshAt)
}

// scheduleRefreshLocked re-derives the room's views at refreshAt (a Dutch
// price drop, a round end): time changes a view without any new state.
func (ep *liveEndpoint) scheduleRefreshLocked(rt *liveRuntime, room string, r *liveRoom, at time.Time) {
	if at.IsZero() {
		return
	}
	if r.timer != nil && !r.refreshAt.IsZero() && !at.Before(r.refreshAt) && r.refreshAt.After(time.Now()) {
		return
	}
	if r.timer != nil {
		r.timer.Stop()
	}
	r.refreshAt = at
	delay := time.Until(at) + 20*time.Millisecond
	if delay < 20*time.Millisecond {
		delay = 20 * time.Millisecond
	}
	r.timer = time.AfterFunc(delay, func() {
		r.mu.Lock()
		defer r.mu.Unlock()
		r.timer = nil
		r.refreshAt = time.Time{}
		ep.fanoutLocked(rt, room, r)
	})
}

// replayLocked returns the states after since up to the latest, when the
// stream still holds all of them and they are at most replayMax; ok=false
// means only the latest can be sent.
func (ep *liveEndpoint) replay(rt *liveRuntime, room string, since uint64, latest *liveState) ([]*liveState, bool) {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	var out []*liveState
	next := since + 1
	for len(out) <= rt.replayMax {
		msg, err := rt.stream.GetMsg(ctx, next, jetstream.WithGetMsgSubject(ep.subject(room)))
		if err != nil {
			return nil, false
		}
		prev, _ := strconv.ParseUint(msg.Header.Get(livePrevSeqHeader), 10, 64)
		if len(out) == 0 && prev != since {
			return nil, false // part of the gap is no longer stored
		}
		data := string(msg.Data)
		st := &liveState{seq: msg.Sequence, prev: prev, data: data, hash: liveHash(data)}
		if st.seq >= latest.seq {
			out = append(out, latest)
			return out, true
		}
		out = append(out, st)
		next = msg.Sequence + 1
	}
	return nil, false
}

// attach joins a socket to its live room before its pumps start: it queues
// the replay (or the latest state, or a RoomSync) on the socket and from then
// on the socket gets every change. It returns false when the viewer is
// denied; the caller closes the socket.
func (ep *liveEndpoint) attach(rt *liveRuntime, c *wsClient, since uint64) bool {
	room := c.live.room
	r := ep.room(room)
	r.mu.Lock()
	latest := r.latest
	fromLive := r.fromLive
	r.mu.Unlock()
	if latest == nil {
		if fetched, err := ep.fetchLatest(rt, room); err == nil && fetched != nil {
			ep.onStored(rt, room, fetched, false)
		}
	}
	if !fromLive {
		// First socket of this room on this replica: the stream may be behind
		// the database (states published while nobody listened, a room that
		// never had one). One build brings it up to date; unchanged states are
		// not published again.
		ep.trigger(rt, room)
	}

	r.mu.Lock()
	defer r.mu.Unlock()
	now := time.Now()
	latest = r.latest
	var frames [][]byte
	var lastHash uint64
	hasHash := false
	if latest == nil {
		frames = append(frames, liveSyncFrame(0, now))
	} else {
		states := []*liveState{latest}
		reset := false
		switch {
		case since == 0 || since == latest.seq:
		case since > latest.seq:
			reset = true
		default:
			if replayed, ok := ep.replay(rt, room, since, latest); ok {
				states = replayed
				LiveReplays.Add(1)
			} else {
				reset = true
				LiveResets.Add(1)
			}
		}
		var refreshAt time.Time
		for i, st := range states {
			views, denied, at, err := ep.viewsFor(st, []string{c.live.companyID}, now)
			if err != nil {
				rt.log.Warn("live room view failed", "endpoint", ep.name, "room", room, "error", err)
				return true
			}
			if denied[c.live.companyID] {
				return false
			}
			view, ok := views[c.live.companyID]
			if !ok {
				continue
			}
			hash := liveHash(view)
			if hasHash && hash == lastHash {
				continue
			}
			frames = append(frames, liveSnapshotFrame(st.seq, now, reset && i == len(states)-1, view))
			lastHash, hasHash = hash, true
			if i == len(states)-1 {
				refreshAt = at
			}
		}
		ep.scheduleRefreshLocked(rt, room, r, refreshAt)
	}
	for _, frame := range frames {
		select {
		case c.send <- frame:
			LiveFrames.Add(1)
		default:
			return true // cannot happen: the queue is empty and larger than a replay
		}
	}
	c.live.lastHash, c.live.hasHash = lastHash, hasHash
	r.clients[c] = struct{}{}
	r.touched = now
	return true
}

// detach removes a closed socket from its live room.
func (ep *liveEndpoint) detach(c *wsClient) {
	if c.live == nil {
		return
	}
	ep.mu.Lock()
	r := ep.rooms[c.live.room]
	ep.mu.Unlock()
	if r == nil {
		return
	}
	r.mu.Lock()
	delete(r.clients, c)
	r.touched = time.Now()
	r.mu.Unlock()
}
