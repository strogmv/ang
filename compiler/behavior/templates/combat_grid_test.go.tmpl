func TestCombatDirectionalCoverFlankAndMeleeBonuses(t *testing.T){
 r:=gridCoverRules();space:=combatFixtureSpace();class:=0;space.CoverSides=func(Cell)[4]int{return [4]int{class,0,0,0}}
 a,b:=combatFixtureActor("a","blue",Cell{6,2}),combatFixtureActor("b","red",Cell{4,2});b.Facing=Cell{1,0};a.Controlled=true;s,err:=NewCombat("cover","fixture",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)}
 chance:=func()float64{p,_:=s.AttackChance(space,r,"a",CombatAction{Type:"attack",TargetID:"b"},s.Actor("a").Position);return p}
 open:=chance();class=1;half:=chance();class=2;full:=chance();if math.Abs(half/open-.8)>1e-8||math.Abs(full/open-.6)>1e-8{t.Fatalf("open/half/full %f %f %f",open,half,full)}
 s.Actor("b").Crouched=true;if chance()>=full{t.Fatal("crouch did not improve cover")};s.Actor("b").Prone=true;if chance()>=full{t.Fatal("prone did not improve cover")};s.Actor("b").Prone=false;s.Actor("b").Crouched=false
 s.Actor("a").Position=Cell{2,2};if s.AttackReason(space,r,"a","b",Cell{2,2})!="flanked"||math.Abs(chance()-open)>1e-8{t.Fatal("open side retained cover")}
 s.Actor("a").Weapon=CombatWeapon{ID:"knife",Kind:"blade",Damage:12,RangeMM:900,AttackAP:2};s.Actor("a").Position=Cell{5,2};front:=chance();class=0;if chance()!=front{t.Fatal("cover reduced a melee strike")};s.Actor("b").Facing=Cell{0,1};flank:=chance();s.Actor("b").Facing=Cell{-1,0};rear:=chance();if math.Abs(flank-front-.1)>1e-8||math.Abs(rear-front-.2)>1e-8{t.Fatalf("front/flank/rear %f %f %f",front,flank,rear)}
}
