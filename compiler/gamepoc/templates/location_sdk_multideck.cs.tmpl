    if(g.surfaces==null)continue;
    if(g.policy=="building"){bool inside=heroMM>=g.bottom_mm-1&&heroMM<g.top_mm&&LocationSDKRectContains(g.interior,px,py);if(inside)foreach(var id in g.surfaces){var s=LocationSDKNavSurfaceByID(id);if(s!=null&&s.elevation_mm>heroMM+2100)locationSDKCutawayHidden.Add(id);}}
