   var nodes=RegionDeckNodes(map,hudRegionDeckID);Rect bounds=RegionModelBounds(nodes);RegionHandleMapInput(nodes,bounds);
   Fill(hudRegionCanvas,new Color(.075f,.085f,.09f));
