func TestValidateCallback_andFinish(t *testing.T) {
	t.Parallel()
	pp := setupTest{{ .StructName }}(providers.MockObjects{
		TxPathLogger: &providers.MockTxPathLogger{},
	})
	mc := testMacanMerchantCreds()
	tx := testMacanPayTx(types.CardP2PMethod.String(), 100000)

	payInID := "23a76e55-7a84-4b22-a703-65c5e0fe5833"
	cbAmount := helpers.FloatAmount(tx.Amount, tx.Currency)
	cb := &cbData{
		ID:         payInID,
		ExternalID: tx.Id,
		Status:     "completed",
		Amount:     cbAmount,
	}
{{- if .CallbackSignature }}
	sig := computeCallbackSignature(testMacanSigKey, cb)
	cb.{{ .CallbackSignature.SignatureField }} = sig
{{- else }}
	sig := computeMacanCallbackSignature(testMacanSigKey, cbAmount, payInID, "completed", "", tx.Id)
	cb.Signature = sig
{{- end }}
	body, _ := json.Marshal(map[string]any{
		"id":             payInID,
		"external_id":    tx.Id,
		"status":         "completed",
		"status_details": "",
		"amount":         cbAmount,
		"signature":      sig,
	})

	req, _ := http.NewRequest(http.MethodPost, "/callback", bytes.NewReader(body))
	cd, err := pp.ParseCallback(req)
	require.NoError(t, err)
	require.Equal(t, tx.Id, cd.TnxId)

	err = pp.ValidateCallback(mc, tx, cd)
	require.NoError(t, err)

	mocks := providers.MockObjects{TxPathLogger: &providers.MockTxPathLogger{}}
	pp.txPathLogger = mocks.TxPathLogger
	mocks.TxPathLogger.On("Log", tx, model.LogActionTypeCallback, providers.LogActionTypeReceived, mock.Anything).Return()

	st, err := pp.FinishCallback(mc, tx, cd)
	require.NoError(t, err)
	assert.Equal(t, tnxStatusSuccess, st.Status)
}

