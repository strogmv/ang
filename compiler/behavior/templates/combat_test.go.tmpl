func TestCombatMeleeGuardParryAndRiposteUseActualReserve(t *testing.T) {
	r, space := combatAdvancedRules(), combatFixtureSpace()
	r.MinHit = 1
	r.MaxHit = 1
	r.DamageMin = 1
	r.DamageMax = 1
	a, b := combatClub("a", "blue", Cell{2, 2}), combatClub("b", "red", Cell{3, 2})
	a.Initiative = 30
	b.Initiative = 20
	s := combatNewAdvanced(t, r, space, a, b)
	combatDo(t, &s, space, r, "a", CombatAction{Type: "guard"})
	if !s.Actor("a").Guarding || s.Actor("a").ReservedAP != 7 || s.Current().ID != "b" {
		t.Fatal("guard did not reserve the actual remaining AP and yield")
	}
	combatDo(t, &s, space, r, "b", CombatAction{Type: "attack", TargetID: "a", Mode: "quick"})
	if s.Actor("a").HP != 86 || s.Actor("b").HP != 80 || s.Actor("a").ReservedAP != 3 || s.Actor("b").AP != 6 {
		t.Fatalf("melee AP/impact/riposte wrong: a=%+v b=%+v", *s.Actor("a"), *s.Actor("b"))
	}
	parries, replies := 0, 0
	for _, e := range s.Events {
		if e.Type == "parry" {
			parries++
			if e.AP != 1 || e.WeaponUses != 1 {
				t.Fatal("parry did not consume AP and a physical use")
			}
		}
		if e.Type == "reaction" {
			replies++
			if e.AP != 3 || e.AmmoSpent != 0 || e.WeaponUses != 1 {
				t.Fatal("riposte used firearm ammo or free AP")
			}
		}
	}
	if parries != 1 || replies != 1 {
		t.Fatal("guard failed to execute an actual parry attempt and single riposte")
	}
	if err := s.Validate(r, space); err != nil {
		t.Fatal(err)
	}
}
