func TestCraftingSampleTeardownTeachesOnlyWithLuck(t *testing.T) {
	m := craftingFixture(t).world.Crafting
	w := m.NewState().Actors[m.Hero.Actor].Worker(m.Hero.Actor)
	sample := &crafting.Stack{ID: "x", Definition: "item.earphones", Quantity: 1, Condition: 1000000}
	tools := []crafting.Stack{{ID: "i", Definition: "item.tool.soldering_iron", Quantity: 1, Condition: 1000000}}
	learnt, failed := false, false
	for seed := int64(1); seed < 200; seed++ {
		p, err := m.Plan(w, crafting.Request{Recipe: "disassemble.earphones", Target: "x", JobID: "job.1", Seed: seed}, tools, sample, crafting.Bench{})
		if err != nil {
			t.Fatal(err)
		}
		learnt = learnt || p.Learn == "craft.earphones"
		failed = failed || p.Outcome != "success" && p.Learn == ""
		if p.Outcome != "success" && p.Learn != "" {
			t.Fatal("a failed teardown taught the schematic")
		}
	}
	if !learnt || !failed {
		t.Fatal("teardown must sometimes teach and sometimes fail")
	}
}

func TestCraftingMasterSwapsAPartForAStrangerAndIsCaughtOnInspection(t *testing.T) {
	for seed := int64(1); seed < 120; seed++ {
		r := craftingFixture(t)
		r.state.Seed = seed
		craftingOpen(t, r, craftingTaya)
		craftingStand(t, r, craftingTaya)
		craftingSetMoney(r, 100000)
		if err := craftingDo(r, "order", "craft.power_block", "", ""); err != nil {
			t.Fatal(err)
		}
		j := r.state.Crafting.Jobs[0]
		if j.Swap.Class == "" || j.Plan.Outcome != "success" {
			continue
		}
		if j.Swap.From == "handmade" || j.Swap.Paid != j.PaidMinor {
			t.Fatalf("a swap must replace a better part and charge for it: %+v", j.Swap)
		}
		craftingRun(t, r, j.Plan.Seconds+60)
		if err := craftingDo(r, "collect", "", "", j.ID); err != nil {
			t.Fatal(err)
		}
		block := craftingHeroItem(r, "item.power_block")
		rel0, own0 := r.craftingRelation(craftingTaya, playerActorID), r.craftingRelation(playerActorID, craftingTaya)
		hero0 := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance
		if err := craftingDo(r, "inspect", "", block.ID, ""); err != nil {
			t.Fatal(err)
		}
		if !r.state.Crafting.Market.Swaps[block.ID].Seen || r.craftingRelation(craftingTaya, playerActorID) >= rel0 || r.craftingRelation(playerActorID, craftingTaya) >= own0 || r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance <= hero0 {
			t.Fatal("the caught swap did not cost Taya the relation and part of the price")
		}
		return
	}
	t.Fatal("Taya never swapped a part for a stranger")
}

func TestCraftingOrderCancelRefundsByTheRules(t *testing.T) {
	r := craftingFixture(t)
	craftingOpen(t, r, craftingMatvey)
	craftingStand(t, r, craftingMatvey)
	headset := craftingHeroItem(r, "item.heirloom_headset")
	units, money := craftingUnits(r), craftingMoney(r)
	hero0 := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance
	if err := craftingDo(r, "order", "repair.grandfather_headset", headset.ID, ""); err != nil {
		t.Fatal(err)
	}
	j := r.state.Crafting.Jobs[0]
	if err := craftingDo(r, "cancel", "", "", j.ID); err != nil {
		t.Fatal(err)
	}
	if r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance != hero0 || r.state.Inventory.Items[headset.ID].Location.Store != inv.ActorStore(playerActorID) || craftingMoney(r) != money || len(units) != len(craftingUnits(r)) {
		t.Fatal("a waiting order was not refunded in full with the thing back")
	}
	if err := craftingDo(r, "order", "repair.grandfather_headset", headset.ID, ""); err != nil {
		t.Fatal(err)
	}
	j = r.state.Crafting.Jobs[0]
	craftingRun(t, r, 600)
	share := r.world.Crafting.Market.Refund.WorkingPermille
	if err := craftingDo(r, "cancel", "", "", j.ID); err != nil {
		t.Fatal(err)
	}
	if got := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance; got != hero0-j.PaidMinor+j.PaidMinor*share/1000 {
		t.Fatalf("a started order refunded %d, want the working share %d", got-(hero0-j.PaidMinor), j.PaidMinor*share/1000)
	}
}

func TestCraftingScarcityOfPartsRaisesThePriceByTheLawOfTheMarket(t *testing.T) {
	r := craftingFixture(t)
	craftingOpen(t, r, craftingMatvey)
	craftingStand(t, r, craftingMatvey)
	ms, _ := r.world.Crafting.Master(craftingMatvey)
	headset := craftingHeroItem(r, "item.heirloom_headset")
	_, before, _, err := r.craftingOrderPlan(ms, "repair.grandfather_headset", headset.ID, "p")
	if err != nil {
		t.Fatal(err)
	}
	// the leather on the hub's counters is bought out: only the two in Matvey's box remain
	spend := inv.Transform{}
	for _, id := range sortedItemIDs(r.state.Inventory) {
		i := r.state.Inventory.Items[id]
		if i.Definition == "item.part.leather" && i.Owner != playerActorID && i.ForSale {
			spend.Spend = append(spend.Spend, inv.Spend{Item: id, Quantity: i.Quantity})
		}
		if i.Definition == "item.part.leather" && i.Owner == craftingMatvey && !i.ForSale && i.Quantity > 2 {
			spend.Spend = append(spend.Spend, inv.Spend{Item: id, Quantity: i.Quantity - 2})
		}
	}
	if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), spend); err != nil {
		t.Fatal(err)
	}
	_, after, _, err := r.craftingOrderPlan(ms, "repair.grandfather_headset", headset.ID, "p")
	if err != nil {
		t.Fatal(err)
	}
	if after <= before {
		t.Fatalf("scarce leather did not raise the price (%d → %d)", before, after)
	}
}

func TestCraftingMastersRestockAndResidentsOrderRepairsByTheSameLaw(t *testing.T) {
	r := craftingFixture(t)
	m := r.world.Crafting
	taya, _ := m.Master(craftingTaya)
	craftingOpen(t, r, craftingTaya)
	craftingOpen(t, r, craftingRinat)
	craftingSetAccount(t, r, craftingTaya, 10000)
	// Taya's box of cells runs low: she buys at the system terminal (the ordinary purchase of an NPC)
	spend := inv.Transform{}
	for _, s := range r.craftingMasterStacks(taya) {
		if c, _, ok := m.PartOf(s.Definition); ok && c.ID == "power_cell" && r.state.Inventory.Items[s.ID].Location.Store == taya.Stores[2] {
			spend.Spend = append(spend.Spend, inv.Spend{Item: s.ID, Quantity: s.Quantity})
		}
	}
	if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), spend); err != nil {
		t.Fatal(err)
	}
	money := craftingMoney(r)
	craftingRun(t, r, 60)
	if n := r.craftingBox(taya, "power_cell"); n < 4 || craftingMoney(r) != money {
		t.Fatalf("Taya did not restock her cells by purchase (%d in the box)", n)
	}
	// a resident's filter is clogged: in market hours she orders its flushing at Rinat's and pays from her account
	resident := "char.market_resident_02"
	craftingSetAccount(t, r, resident, 10000)
	var filter inv.Item
	for _, i := range r.craftingResidentThings() {
		if i.Owner == resident {
			filter = i
		}
	}
	if filter.ID == "" {
		t.Fatal("the resident has no worn thing")
	}
	if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Restore: []inv.Restore{{Item: filter.ID, Condition: 300000}}}); err != nil {
		t.Fatal(err)
	}
	craftingRun(t, r, 11*60) // residents look at their things every ten minutes
	outcome := ""
	for _, j := range r.state.Crafting.Jobs {
		if j.Client == resident && j.Worker == craftingRinat && j.PaidMinor > 0 {
			outcome = j.Plan.Outcome
		}
	}
	if outcome == "" {
		t.Fatal("the resident did not order the repair of the worn filter")
	}
	craftingRun(t, r, 3600)
	back := r.state.Inventory.Items[filter.ID]
	if back.Location.Store != inv.ActorStore(resident) || back.Owner != resident || outcome == "success" && back.Condition <= 300000 {
		t.Fatalf("the filter did not come back to the resident worked: %+v", back)
	}
	for _, j := range r.state.Crafting.Jobs {
		if j.Client == resident {
			t.Fatal("a finished resident order waits at the counter")
		}
	}
}

func reflectEqualCrafting(a, b state) bool {
	return craftingJSON(a.Crafting) == craftingJSON(b.Crafting) && craftingJSON(a.Inventory) == craftingJSON(b.Inventory)
}
