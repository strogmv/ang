 for _,id:=range []string{"gate","missing"}{for _,open:=range []bool{true,false}{if s.SetGateRequest(m,id,open)==nil||!reflect.DeepEqual(s.Gates,before){t.Fatal("invalid manual request succeeded or mutated automatic state")}}}
