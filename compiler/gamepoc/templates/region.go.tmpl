  if !r.state.Region.KnownLinks[e.ID]||!known[e.FromNode]||!known[e.ToNode]{continue};next:="";if e.FromNode==at{next=e.ToNode}else if e.ToNode==at{next=e.FromNode};if next==""||seen[next]{continue};if next==to{return true};seen[next]=true;queue=append(queue,next)
 }};return false
