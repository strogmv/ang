func TestPopulationVisibleWalkingUsesNeighborSteps(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 12, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 1, 1, "a", PopulationEnvironment{})
	previous := map[string]PopulationActor{}
	for _, a := range s.Actors {
		previous[a.ID] = a
	}
	moved := false
	for tick := int64(2); tick < 100; tick++ {
		populationAdvance(t, &s, p, l, 28800+tick, tick, "a", PopulationEnvironment{})
		for _, a := range s.Actors {
			old := previous[a.ID]
			if old.Materialized && a.Materialized && old.Level == a.Level && old.Position != a.Position {
				if Distance(old.Position, a.Position) != 1 {
					t.Fatal("visible population teleported")
				}
				moved = true
			}
			previous[a.ID] = a
		}
	}
	if !moved {
		t.Fatal("near population never physically walked")
	}
}
