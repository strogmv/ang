    Quaternion localProp=Quaternion.Inverse(hand.rotation)*prop.go.transform.rotation;Quaternion desiredHand=Quaternion.LookRotation(dir,Vector3.up)*Quaternion.Inverse(localProp);
    Vector3 localTip=Quaternion.Inverse(hand.rotation)*((beat.parried&&prop.kind!="knife"?Vector3.Lerp(prop.go.transform.position,tip.position,look.contact.shaft_fraction):tip.position)-hand.position);Vector3 localGrip=Quaternion.Inverse(hand.rotation)*(prop.go.transform.position-hand.position);
    if(rig==null){rig=h.animator.gameObject.AddComponent<PocCombatContactRig>();rig.Setup(h.animator);}
