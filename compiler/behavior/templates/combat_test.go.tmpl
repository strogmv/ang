		t.Fatal("hidden ambient body leaked into decision")
	}
	before := s.Clone()
	if err := s.Execute(space, r, "a", CombatAction{Type: "attack", TargetID: "b"}); err != ErrCombatExecutionBlocked || !reflect.DeepEqual(before, s) {
		t.Fatal("blocked player shot spent resources or changed state")
	}
	if err := s.StepAI(space, r); err != nil {
		t.Fatal(err)
	}
	if s.Actor("a").Ammo != before.Actor("a").Ammo || s.Actor("b").HP != before.Actor("b").HP || s.Current().ID != "b" {
		t.Fatal("blocked AI shot fired, hurt target or failed to yield")
