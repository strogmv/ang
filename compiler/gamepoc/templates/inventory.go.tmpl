func (r *Runtime) executeActorAction(a inv.Action) (inv.Result, error) {
	if r.state.Paused {
		return inv.Result{}, errors.New("world paused")
	}
	if r.missionActor() == a.Actor && r.state.Demo.Captured {
		return inv.Result{}, errors.New("actor in custody")
	}
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		return inv.Result{}, err
	}
	result, err := r.state.Inventory.Execute(r.inventoryModelFor(r.state.Life.Enabled), a, r.actorAccess(a.Actor))
	if err == nil && !result.Replayed {
		// Reconcile physical equipment in the same command: pause/save may precede
		// the next simulation tick. Failed/replayed actions must not change repair state.
		if r.state.Life.Enabled {
			r.checkLifeEquipment()
		}
		switch a.Kind {
		case "buy", "put", "take", "issue", "equip", "unequip", "use":
			r.focusActor(a.Actor, a.Item)
		}
	}
	return result, err
}
