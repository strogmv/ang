{{ define "main_server_http_router" }}
	r := chi.NewRouter()
	r.Use(middleware.RequestID)
	r.Use(otelhttp.NewMiddleware("ang-service"))
	r.Use(transport.MetricsMiddleware)
	r.Use(transport.LoggingMiddleware)
	r.Use(transport.TestHeadersMiddleware)
	r.Use(transport.SecurityHeadersMiddleware)
	r.Use(transport.ClientContextMiddleware)
	r.Use(transport.SameOriginMiddleware)
	r.Use(transport.RecoverMiddleware)

	// No origins configured means no cross-origin caller is trusted, rather
	// than every one of them. The old default was "*", which is harmless only
	// for as long as credentials stay off — and one day somebody turns them on
	// without noticing what the other half of the setting says.
	corsAllowedOrigins := []string{}
	corsAllowCredentials := false
	if raw := strings.TrimSpace(os.Getenv("CORS_ORIGINS")); raw != "" {
		parts := strings.Split(raw, ",")
		for _, p := range parts {
			if p = strings.TrimSpace(p); p != "" {
				corsAllowedOrigins = append(corsAllowedOrigins, p)
			}
		}
		corsAllowCredentials = true
	}
	if len(corsAllowedOrigins) == 0 {
		log.Warn("CORS_ORIGINS is not set: no cross-origin browser request will be accepted. Set it to the app's origin.")
	}
	// X-Session-* response headers let the app warn before an idle sign-out,
	// so a cross-origin app must be allowed to read them.
	corsMiddleware := cors.New(cors.Options{
		AllowedOrigins:   corsAllowedOrigins,
		AllowedMethods:   []string{"GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"},
		AllowedHeaders:   []string{"*"},
		ExposedHeaders:   []string{"Link", "X-Total-Count", "X-Session-Idle-Timeout", "X-Session-Idle-Remaining", "X-Session-Remaining"},
		AllowCredentials: corsAllowCredentials,
		MaxAge:           300,
	})
	r.Use(corsMiddleware.Handler)
	{{- if .HasSession }}
	r.Use(transport.SessionMiddleware)
	{{- end }}
{{ end }}
