func TestStoryOpeningLoadsMarketWithoutReplay(t *testing.T) {
	r := startFixture(t, nil, "life")
	if source := os.Getenv("LINEUP_PREVIOUS_SAVE"); source != "" {
		raw, err := os.ReadFile(source)
		if err != nil { t.Fatal(err) }
		slot := r.world.Config.SaveSlots[0]
		if err := os.WriteFile(r.slotFile(slot), raw, 0600); err != nil { t.Fatal(err) }
		loaded, _, err := r.readSave(slot)
		if err != nil { t.Fatal(err) }
		r.state = loaded
	}
	r.step()
	if r.state.Memory.Opening || r.state.Memory.OpeningPlayed || r.state.Memory.Open != "" ||
		r.currentLevel() != "level.c7_market" || r.state.Memory.Facts[r.world.Start.StatusFact].Count != 0 {
		t.Fatal("loading the original market start replayed or granted the lineup")
	}
}

