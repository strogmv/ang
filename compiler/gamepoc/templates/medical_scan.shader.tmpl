Shader "ANG/MedicalPatientScan" {
 Properties {
  [HDR] _BandColor ("Projected green line", Color) = (.035,1.5,.14,1)
  _BandHalfWidth ("Line half width in metres", Float) = .018
  _ScanHeight ("Server scan height", Float) = 2.05
  _ProjectorWS ("Actual projector socket", Vector) = (0,0,0,1)
  _ScanCentreWS ("Patient band centre", Vector) = (0,0,0,1)
 }
 SubShader {Tags {"RenderPipeline"="UniversalPipeline" "RenderType"="Transparent"}
  Pass {Name "PatientSurfaceScan"
   Cull Back ZTest LEqual ZWrite Off Blend One One ColorMask RGB
   HLSLPROGRAM
   #pragma vertex vert
   #pragma fragment frag
   #pragma target 3.5
   #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
   CBUFFER_START(UnityPerMaterial)
   float4 _BandColor,_ProjectorWS,_ScanCentreWS;
   float _BandHalfWidth,_ScanHeight;
   CBUFFER_END
   struct Attributes {float4 positionOS:POSITION;float3 normalOS:NORMAL;};
   struct Varyings {float4 positionCS:SV_POSITION;float3 positionWS:TEXCOORD0;float3 normalWS:TEXCOORD1;};
   Varyings vert(Attributes input){Varyings output;output.positionWS=TransformObjectToWorld(input.positionOS.xyz);output.positionCS=TransformWorldToHClip(output.positionWS);output.normalWS=TransformObjectToWorldNormal(input.normalOS);return output;}
   half4 frag(Varyings input):SV_Target {
    float aa=max(fwidth(input.positionWS.y),.0005);
    float band=1-smoothstep(_BandHalfWidth,_BandHalfWidth+aa,abs(input.positionWS.y-_ScanHeight));clip(band-.001);
    float3 toProjector=normalize(_ProjectorWS.xyz-input.positionWS);
    float facing=dot(normalize(input.normalWS),toProjector);clip(facing-.03);
    float3 projectorAxis=normalize(_ScanCentreWS.xyz-_ProjectorWS.xyz);
    float cone=dot(-toProjector,projectorAxis);clip(cone-.5);
    return half4(_BandColor.rgb*band*(.25+.75*saturate(facing)),0);
   }
   ENDHLSL
  }
 }
 Fallback Off
}
