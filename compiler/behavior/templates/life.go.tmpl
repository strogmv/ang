 for _,a:=range s.Population.Actors{if a.Trip!=nil{seats[departure{a.Trip.Edge,a.Trip.Departure}]++}}
 for _,trip:=range env.Trips{seats[departure{trip.Edge,trip.Departure}]++}
 for slot,count:=range seats{edge:=m.Edge(slot.edge);if edge==nil||count>edge.Seats{return fmt.Errorf("shared departure capacity exceeded")}}
