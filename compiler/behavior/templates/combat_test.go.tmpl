 space.ApplyImpact=func(state *CombatState,source,target,part,mode string)int{n:=combatFixtureImpact(state,source,target,part,mode);b:=state.Actor(target);b.HP=0;b.BodyState="down";b.Prone=true;b.AP=0;return n}
 s:=combatFixture(t,space,a,b,c)
 s.ApplyDamage(space,rules,"a","a",1000,1,0,"arms");s.ResolveCasualties(rules)
 if s.Active&&s.Current()!=nil&&!s.Current().Able(){t.Fatal("host injury left a down current actor")}
 s.ApplyDamage(space,rules,"b","b",1000,0,0,"torso");s.ApplyDamage(space,rules,"c","c",1000,0,0,"torso");s.ResolveCasualties(rules)
 if s.Active||s.Winner!="draw"{t.Fatal("simultaneous final casualties kept a winner or active encounter")}
 if err:=s.Validate(rules,space);err!=nil{t.Fatal(err)}
}

func TestCombatPlannerValuesUsableCarriedGunOverInterlockedEquipment(t *testing.T){
 rules:=combatFixtureRules();rules.EquipAP=2
 space:=combatFixtureSpace();a,b:=combatFixtureActor("a","blue",Cell{1,1}),combatFixtureActor("b","red",Cell{5,1})
 a.Controlled=true;a.Weapon.Damage=200
 own:=a.Weapon;own.ID="gun.own";own.Damage=20
 space.CanUseWeapon=func(c Combatant)bool{return c.Weapon.ID==own.ID}
 space.Equipment=func(id string)[]CombatEquipmentOption{if id!="a"{return nil};return []CombatEquipmentOption{{ID:"physical.own",Weapon:own,Ammo:2,UsesRemaining:100}}}
 s:=combatFixture(t,space,a,b)
 decision:=s.Decide(space,rules)
 if decision.Chosen.Action.Type!="equip"||decision.Chosen.Action.ItemID!="physical.own"{t.Fatalf("usable carried gun was devalued by equipped interlock: %+v",decision)}
}

