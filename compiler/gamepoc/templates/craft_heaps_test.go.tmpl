	}{{22, 22, "full"}, {15, 22, "full"}, {14, 22, "half"}, {8, 22, "half"}, {7, 22, "few"}, {1, 22, "few"}, {0, 22, "empty"}, {30, 22, "full"}, {1, 1, "full"}, {2, 6, "few"}, {3, 6, "half"}, {5, 6, "full"}} {
		if got := craftHeapLevel(c.q, c.full); got != c.want {
			t.Fatalf("%d of %d: %s, want %s", c.q, c.full, got, c.want)
		}
	}
	// closing: the east end first; opening: the west end first; each slot changes once
	n := 5
	for i := 0; i < n; i++ {
		if craftHeapPacked("open", 0, i, n) || !craftHeapPacked("closed", 0, i, n) {
			t.Fatalf("slot %d: open stall packed or shut stall laid out", i)
		}
		if craftHeapPacked("closing", 0, i, n) || !craftHeapPacked("closing", 999999, i, n) {
			t.Fatalf("slot %d: the closing phase must begin laid out and end packed", i)
		}
		if !craftHeapPacked("opening", 0, i, n) || craftHeapPacked("opening", 999999, i, n) {
			t.Fatalf("slot %d: the opening phase must begin packed and end laid out", i)
		}
	}
	for ppm := int64(0); ppm < 1000000; ppm += 5000 {
		for i := 1; i < n; i++ {
			if craftHeapPacked("closing", ppm, i-1, n) && !craftHeapPacked("closing", ppm, i, n) {
				t.Fatalf("closing at %d: slot %d is packed before its east neighbour", ppm, i-1)
			}
			if !craftHeapPacked("opening", ppm, i, n) && craftHeapPacked("opening", ppm, i-1, n) {
				t.Fatalf("opening at %d: slot %d is laid out before its west neighbour", ppm, i)
			}
		}
