func TestScene19OmittedObservationsHaveNoActiveGraph(t *testing.T) {
	r := hub19Start(t, nil, 1)
	omitted := map[string]bool{
		"voice.hub.door_six": true, "voice.hub.blind": true,
		"voice.hub.bolt": true, "voice.hub.wall": true,
		"voice.hub.door_pocket": true, "dlg.hub.n_l1": true,
		"voice.hub.car": true, "voice.hub.car_prokhor": true,
		"voice.hub.car_sister": true,
	}
	checkLines := func(lines []convLine) {
		for _, line := range lines {
			if omitted[line.Text] {
				t.Fatalf("unbuilt observation is active: %s", line.Text)
			}
			for _, variant := range line.Variants {
				if omitted[variant.Text] {
					t.Fatalf("unbuilt observation variant is active: %s", variant.Text)
				}
			}
		}
	}
	for _, graph := range r.world.Conversations {
		for _, entry := range graph.Entries {
			checkLines(entry.Lines)
		}
		for _, node := range graph.Nodes {
			checkLines(node.Lines)
			checkLines(node.TailLines)
			for _, voice := range node.Voices {
				if omitted[voice.Text] {
					t.Fatalf("unbuilt observation is voiced: %s", voice.Text)
				}
			}
			for _, option := range node.Options {
				if omitted[option.Text] {
					t.Fatalf("unbuilt observation answer is exposed: %s", option.Text)
				}
				checkLines(option.Reply)
				if option.Fail != nil {
					checkLines(option.Fail.Reply)
				}
			}
		}
	}
}

