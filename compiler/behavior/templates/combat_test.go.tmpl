		// An actor at the actual x=1 position cannot see beyond the corner.
		// Reachable hypothetical x>=3 positions would see either hidden area.
		return from == to || from.X >= 3 || to.X <= 2
	}
	a, b := combatFixtureActor("a", "blue", Cell{1, 2}), combatFixtureActor("b", "red", Cell{7, 2})
	s := combatFixture(t, space, a, b)
	if len(s.Actor("a").Contacts) != 0 {
		t.Fatal("hidden target was initially known")
	}
	one := s.Decide(space, r)
	s.Actor("b").Position = Cell{8, 5}
	two := s.Decide(space, r)
	if !reflect.DeepEqual(one, two) {
		t.Fatalf("hypothetical sight peeked into hidden target position: %+v / %+v", one.Chosen, two.Chosen)
	}
