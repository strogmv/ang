# Generated by ANG. Targets, selection destinations and shortcuts belong to CUE.
extends RefCounted
const C = preload("res://generated/game_contract.gd")
const Catalog = preload("res://generated/screens/catalog.gd")
var host
var targets: Array[Dictionary] = []
var highlighted := ""
var pending := ""
var own_move := false
var last_walk := Vector2i(-1, -1)
var pending_sequence := -1
var retry_after_us := 0
var epoch := ""
var pointer_active := false
var pointer := Vector2.ZERO
var visual
## A target the HUD's «inspect» pointed at (host.world inspect): highlighted instead of the nearest until the pointer moves.
var pinned := ""

func _init(context) -> void:
	host = context
	visual = host.world_target_visual()

func read(binding: Dictionary, row: C.ProtoMessage = null) -> Variant:
	return Catalog.read(binding.ref, host.game_state, row, {})

func accept() -> void:
	var state: C.PocGameState = host.game_state
	if state == null:
		return
	if epoch != state.epoch:
		cancel()
		epoch = state.epoch
	targets.clear()
	for kind in Catalog.specification().get("targets", []):
		var rows = read(kind.source)
		if not rows is Array:
			continue
		for row in rows:
			if not read(kind.bind.visible, row):
				continue
			var target := {"kind": kind, "row": row}
			for field in kind.bind:
				target[field] = read(kind.bind[field], row)
			target.uid = kind.id + "/" + str(target.id)
			targets.append(target)
	if not pending.is_empty():
		var target := find(pending)
		if target.is_empty():
			cancel()
		elif target.reachable:
			pending = ""
			open(target)
		else:
			var body: C.PocHeroBody = state.hero_body
			if body != null and not body.moving and body.route.is_empty() and body.input_seq == pending_sequence:
				last_walk = Vector2i(-1, -1)
				pending_sequence = -1
				retry_after_us = Time.get_ticks_usec() + 300000
			route(target)

func find(uid: String) -> Dictionary:
	for target in targets:
		if target.uid == uid:
			return target
	return {}

func cancel() -> void:
	if not own_move:
		pending = ""
		last_walk = Vector2i(-1, -1)
		pending_sequence = -1
		retry_after_us = 0

func route(target: Dictionary) -> void:
	if not target.routable:
		last_walk = Vector2i(-1, -1)
		return
	if Time.get_ticks_usec() < retry_after_us:
		return
	var cell := Vector2i(target.walk_x, target.walk_y)
	if cell == last_walk:
		return
	last_walk = cell
	own_move = true
	host.link.controls.move(cell.x, cell.y, false, int(target.walk_deck))
	pending_sequence = host.link.controls.sequence
	own_move = false

func open(target: Dictionary) -> void:
	if target.kind.get("action", "") == "life_enter":
		if target.get("enabled", false):
			host.link.controls.life("enter", str(target.id), 0, host.request_id())
		return
	# a person who has something to say: the server opens the conversation, its column opens by the state
	if target.kind.get("action", "") == "talk":
		host.link.controls.life("conversation_open", str(target.id), 0, host.request_id())
		return
	host.open_game_screen(target.kind.screen)
	host.game_ui.select_key(target.kind.list, target.kind.row_key, target.id)

func peaceful(target: Dictionary) -> bool:
	if target.is_empty():
		return false
	if target.kind.get("action", "") == "life_enter":
		if target.get("enabled", false):
			cancel()
			open(target)
		return true
	if target.kind.get("screen", "").is_empty() and target.kind.get("action", "") != "talk":
		return false
	pending = target.uid
	last_walk = Vector2i(-1, -1)
	if target.reachable:
		pending = ""
		open(target)
	else:
		route(target)
	return true

func process() -> void:
	if not host.playing or host.screen_open or not host.link.input_enabled:
		visual.show_target({})
		return
	var selected := pointed(pointer) if pointer_active else find(pinned)
	if selected.is_empty() and not pointer_active:
		selected = nearest()
	highlighted = selected.get("uid", "")
	visual.show_target(selected)

func pointed(at: Vector2) -> Dictionary:
	var selected: Dictionary = {}
	var score := INF
	var floor_selected: Dictionary = {}
	var floor_score := INF
	for target in targets:
		var distance: float = visual.pointer_distance(target, at)
		if distance > target.kind.radius_px:
			continue
		var candidate: float = distance - float(target.kind.priority) * 0.001
		# Floor exits are a fallback. A real person, control or inspection keeps
		# its existing hit test and operator relation even inside an exit zone.
		if target.kind.get("position", "") == "zone":
			if candidate < floor_score:
				floor_score = candidate
				floor_selected = target
			continue
		if candidate < score:
			score = candidate
			selected = target
	if selected.is_empty():
		selected = floor_selected
	# A public operator relation gives a person the same action as their counter.
	if not selected.is_empty() and selected.kind.get("screen", "").is_empty() and selected.kind.get("action", "").is_empty():
		var actor: String = selected.get("actor", "")
		if not actor.is_empty():
			for target in targets:
				if target.get("actor", "") == actor and not target.kind.get("screen", "").is_empty():
					return target
	return selected

func nearest() -> Dictionary:
	var selected: Dictionary = {}
	var score := INF
	for target in targets:
		if not target.reachable or (target.kind.get("screen", "").is_empty() and not target.kind.get("action", "") in ["life_enter", "talk"]):
			continue
		# a talk and a trade on the same person: the higher priority wins at the same distance
		var distance: float = visual.hero_distance(target) - float(target.kind.get("priority", 0)) * 0.001
		if distance < score:
			score = distance
			selected = target
	return selected

func matches(event: InputEvent, shortcut: Dictionary) -> bool:
	if event is InputEventKey and event.pressed and not event.echo:
		return event.physical_keycode == OS.find_keycode_from_string(shortcut.key)
	if event is InputEventJoypadButton and event.pressed:
		var pads := {"X": JOY_BUTTON_X, "Y": JOY_BUTTON_Y, "Start": JOY_BUTTON_START,
	"Back":
		JOY_BUTTON_BACK, "L1": JOY_BUTTON_LEFT_SHOULDER, "R1": JOY_BUTTON_RIGHT_SHOULDER}
		return event.button_index == pads.get(shortcut.pad, -1)
	return false

func input(event: InputEvent) -> bool:
	if not host.playing or host.screen_open:
		return false
	var config: Dictionary = Catalog.specification().get("world_input", {})
	if config.is_empty():
		return false
	if event is InputEventMouse:
		var gui: Control = host.get_viewport().gui_get_hovered_control()
		if gui != null and gui.is_visible_in_tree() and gui.get_global_rect().has_point(event.position):
			pointer_active = false
			return false
	if event is InputEventMouseMotion:
		pinned = ""
		pointer_active = true
		pointer = event.position
		process()
	elif event is InputEventJoypadButton or event is InputEventJoypadMotion:
		pointer_active = false
		process()
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		pointer_active = true
		pointer = event.position
		process()
		return peaceful(find(highlighted))
	if matches(event, config.peaceful):
		process()
		if not peaceful(find(highlighted)):
			host.open_game_screen(config.fallback)
		return true
	if matches(event, config.hostile):
		var target := find(highlighted)
		host.open_game_screen(config.engage_screen)
		if not target.is_empty() and target.kind.get("person", false):
			host.game_ui.select_key(config.engage_list, config.engage_key, target.get("actor", target.id))
		return true
	return false

## The HUD's touches of the world (host.world, doc 09 «Касание мира»), through the same targets as the pointer and E/X:
## use and talk are the peaceful action (on the pointed or nearest target; on the nearest person), approach walks to the
## target without using it, inspect points at the next target near the hero so its server text shows, hostile is the
## choice of whom to engage (as F/R1). Nothing here decides a rule: the server answers every command.
func verb(name: String) -> void:
	var config: Dictionary = Catalog.specification().get("world_input", {})
	process()
	match name:
		"use":
			if not peaceful(find(highlighted)) and not config.is_empty():
				host.open_game_screen(config.fallback)
		"talk":
			# the nearest person the server lets the hero talk to: his conversation column, never another screen
			peaceful(_nearest_where(func(t): return t.kind.get("action", "") == "talk"))
		"approach":
			var target := find(highlighted)
			if target.is_empty():
				target = _nearest_where(func(t): return t.kind.get("position", "") != "zone")
			if not target.is_empty() and not target.reachable:
				pending = ""
				route(target)
		"inspect":
			var near: Array = targets.filter(func(t): return t.kind.get("position", "") != "zone")
			near.sort_custom(func(a, b): return visual.hero_distance(a) < visual.hero_distance(b))
			near = near.slice(0, 6)
			if near.is_empty():
				return
			var at := -1
			for i in range(near.size()):
				if near[i].uid == pinned:
					at = i
			pinned = near[(at + 1) % near.size()].uid
			pointer_active = false
			process()
		"hostile":
			if not config.is_empty():
				var target := find(highlighted)
				host.open_game_screen(config.engage_screen)
				if not target.is_empty() and target.kind.get("person", false):
					host.game_ui.select_key(config.engage_list, config.engage_key, target.get("actor", target.id))

func _nearest_where(keep: Callable) -> Dictionary:
	var selected: Dictionary = {}
	var score := INF
	for target in targets:
		if not keep.call(target):
			continue
		var distance: float = visual.hero_distance(target)
		if distance < score:
			score = distance
			selected = target
	return selected

func move_result(result: C.PocMoveResult) -> void:
	if not pending.is_empty() and result.input_seq == pending_sequence and not result.ok:
		last_walk = Vector2i(-1, -1)
		retry_after_us = Time.get_ticks_usec() + 300000
