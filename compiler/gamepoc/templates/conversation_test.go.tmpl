func TestMemoryMigrationWithoutFactEffectsRunsOnce(t *testing.T) {
	r := encounterFixture(t)
	e := r.world.CalendarEncounter
	editConversation(t, r, e.Talk.Custody, func(d *conversationDef) {
		d.Events["timeout"].Do = []memDo{{Trust: &struct {
