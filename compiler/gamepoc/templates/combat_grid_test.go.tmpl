func TestCombatMarketCounterProneOcclusionAlsoUsesMovingGateRayPath(t *testing.T){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)};v:=r.world.Decks["level.c7_market"]
 for _,o:=range v.Obstacles{if !strings.Contains(o.ID,"counter")||!o.BlocksMovement||o.TopMM-o.BottomMM>1200{continue}
  var from,to behavior.Cell;foundA,foundB:=false,false
