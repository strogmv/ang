 for {
  if (x!=from.X||y!=from.Y)&&(x!=to.X||y!=to.Y)&&!r.walkable(point{x,y}){return false}
  if x==to.X&&y==to.Y{return true};twice:=2*err;if twice>-dy{err-=dy;x+=sx};if twice<dx{err+=dx;y+=sy}
 }
}
