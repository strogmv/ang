     h.sitYawOffset=0;if(near!=null&&cast.sit_roles[h.sitVariant]=="talk"){float yr=(float)spot.YawDeg*Mathf.Deg2Rad;var right=new Vector3(Mathf.Cos(yr),0,-Mathf.Sin(yr));h.sitYawOffset=Vector3.Dot(near.sitAnchor-anchor,right)>0?14:-14;}}
    want=cast.sit_states[h.sitVariant];len=cast.sit_cycle_seconds[h.sitVariant];w=1;wh=1;props=1;
   }
   // Yaw: turn to the counter while still standing (about 180 degrees in the turn share), then a slow turn to a talk
   // partner and back.
   if(phase<0)yawTarget+=h.sitYawOffset;h.yaw=jump?yawTarget:Mathf.MoveTowardsAngle(h.yaw,yawTarget,(phase<0?60f:Mathf.Max(400f,180f/Mathf.Max(.05f,turn*trans)))*(float)Math.Max(0,dt));
   var rot=Quaternion.Euler(0,h.yaw,0);h.go.transform.SetPositionAndRotation(feet+h.sitApplied,rot);
   // Animator: transitions posed at Go's phase every frame (speed 0); seated loops run at the simulation rate.
   int hash=Animator.StringToHash(want);if(!an.HasState(0,hash)){Debug.LogError("ANG humanoid cast "+cast.cast_id+" has no seated state "+want+"; bodies stand on seats");locationSDKHumanoidSitBroken=true;LocationSDKHumanoidStand(h);return;}
   bool fading=an.IsInTransition(0);
   if(h.sitState!=want){
    if(phase>=0){if(h.sitState==null&&(h.state==null||jump||h.rate<=0))an.Play(hash,0,phase);else{an.CrossFadeInFixedTime(hash,.2f,0,phase*len);fading=true;}}
    else{float start=LocationSDKHumanoidMix(LocationSDKHumanoidHash(agent.Id),(uint)(h.sitSlot+7))/4294967296f*len;if(h.sitState==null&&jump)an.Play(hash,0,start/len);else{an.CrossFadeInFixedTime(hash,h.sitState==null?.3f:cast.sit_crossfade_seconds,0,start);fading=true;}}
    h.sitState=want;h.switches++;
   }
   else if(phase>=0&&!fading)an.Play(hash,0,phase);
   an.speed=phase>=0?(fading?h.rate*len/trans:0):h.rate;
   if(h.ik!=null){h.ik.weight=w;h.ik.floorY=feet.y;}
   if(phase>=0&&!fading)an.Update(0);
   h.state=null;h.walking=false;h.phase=phase;h.drift=fading?-1:0;
   // Pelvis pin: the offset that puts the hips on the seat anchor this frame, applied by the seated weight.
   float above=cast.sit_hips_above_seat_m[Mathf.Clamp(h.body,0,cast.sit_hips_above_seat_m.Length-1)];
   var full=h.sitApplied+(anchor+Vector3.up*above-h.hips.position);
   // horizontal and vertical weights apart (the hips reach the stool centre with the descent, leave it after rising)
   var applied=new Vector3(full.x*wh,full.y*w,full.z*wh);
   // no hips capsule in the stool: over the seat disc (radius + hips radius) the hips stay at least `above` over its top
   var hipsNow=h.hips.position+(applied-h.sitApplied);var dh=hipsNow-anchor;dh.y=0;
   if(dh.magnitude<locationSDKSeatRadiusM+.12f&&hipsNow.y<anchor.y+above){applied.y+=anchor.y+above-hipsNow.y;h.sitClamps++;}
   h.sitPin=full;h.sitWeight=w;h.sitApplied=applied;h.go.transform.position=feet+applied;
   // The contact blob stays on the floor under the pinned body.
   if(h.contact!=null)h.contact.localPosition=new Vector3(0,.012f-applied.y,0);
   bool full3=GraphicsFull;if(h.shadows!=full3){foreach(var r in h.renderers)r.shadowCastingMode=full3?UnityEngine.Rendering.ShadowCastingMode.On:UnityEngine.Rendering.ShadowCastingMode.Off;h.shadows=full3;}
   // Props: the bowl on the counter in front of the seat; the mug beside it, in the right hand while drinking.
   if(spot.TableZMm>0){
    LocationSDKHumanoidProps(h);var table=LocationSDKHumanoidSpotWorld(feet,spot,spot.TableXMm,spot.TableYMm,spot.TableZMm);
    h.bowl.gameObject.SetActive(props>0);h.bowl.SetPositionAndRotation(table,Quaternion.Euler(0,h.yaw,0));
    bool drinking=phase<0&&cast.sit_roles[h.sitVariant]=="drink"&&(!fading||an.GetNextAnimatorStateInfo(0).shortNameHash==hash&&an.GetAnimatorTransitionInfo(0).normalizedTime>.5f);h.drinking=drinking;
    var right=rot*Vector3.right;
    if(drinking&&h.hand!=null){var grip=h.handTip!=null?Vector3.Lerp(h.hand.position,h.handTip.position,.9f):h.hand.position+h.hand.up*.07f;h.mug.SetPositionAndRotation(grip+Vector3.down*.03f,rot);}
    else h.mug.SetPositionAndRotation(table+right*.15f,rot);
    h.mug.gameObject.SetActive(props>0);
   }
  }
  void LocationSDKHumanoidStand(LocationSDKHumanoid h){
   h.seated=false;h.sitKey=null;h.sitPin=Vector3.zero;h.sitApplied=Vector3.zero;h.sitWeight=0;h.sitSlot=-1;h.sitVariant=-1;h.drinking=false;
   if(h.contact!=null)h.contact.localPosition=new Vector3(0,.012f,0);
   // The next idle / walk state cross-fades from the last seated pose.
   if(h.sitState!=null){h.state=h.sitState;h.sitState=null;}
   if(h.ik!=null)h.ik.weight=0;if(h.bowl!=null)h.bowl.gameObject.SetActive(false);if(h.mug!=null)h.mug.gameObject.SetActive(false);
  }
  // A lathe mesh (profile of radius / height pairs, outside then inside) with an optional food disc as submesh 1.
  static Mesh LocationSDKHumanoidLathe(string name,Vector2[] profile,float discR,float discY){
   const int n=20;var v=new List<Vector3>();var nr=new List<Vector3>();var t0=new List<int>();var t1=new List<int>();
   for(int j=0;j<profile.Length;j++)for(int i=0;i<=n;i++){float a=i*Mathf.PI*2/n;var d=new Vector3(Mathf.Sin(a),0,Mathf.Cos(a));v.Add(d*profile[j].x+Vector3.up*profile[j].y);nr.Add((d+Vector3.up*.3f).normalized);}
   for(int j=0;j+1<profile.Length;j++)for(int i=0;i<n;i++){int a=j*(n+1)+i,b=a+n+1;t0.AddRange(new[]{a,b,a+1,a+1,b,b+1});t0.AddRange(new[]{a,a+1,b,a+1,b+1,b});}
   int c=v.Count;v.Add(Vector3.up*discY);nr.Add(Vector3.up);for(int i=0;i<=n;i++){float a=i*Mathf.PI*2/n;v.Add(new Vector3(Mathf.Sin(a)*discR,discY,Mathf.Cos(a)*discR));nr.Add(Vector3.up);}
   for(int i=0;i<n;i++)t1.AddRange(new[]{c,c+1+i,c+2+i});
   var m=new Mesh{name=name};m.SetVertices(v);m.SetNormals(nr);m.subMeshCount=2;m.SetTriangles(t0,0);m.SetTriangles(t1,1);m.RecalculateBounds();return m;
  }
  Material LocationSDKHumanoidPropMaterial(string name,Color color,float smoothness){var m=new Material(Shader.Find("Universal Render Pipeline/Lit")){name=name,enableInstancing=true};m.SetColor("_BaseColor",color);m.SetFloat("_Smoothness",smoothness);m.SetFloat("_Metallic",0);locationSDKHumanoidOwned.Add(m);return m;}
  Transform LocationSDKHumanoidProp(string name,Mesh mesh,Material[] materials){
   var go=new GameObject(name){layer=LocationSDKLayer};go.transform.SetParent(locationSDKRoot.transform,false);go.AddComponent<MeshFilter>().sharedMesh=mesh;var r=go.AddComponent<MeshRenderer>();r.sharedMaterials=materials;
   r.shadowCastingMode=UnityEngine.Rendering.ShadowCastingMode.Off;r.lightProbeUsage=UnityEngine.Rendering.LightProbeUsage.Off;r.reflectionProbeUsage=UnityEngine.Rendering.ReflectionProbeUsage.Off;go.SetActive(false);return go.transform;
  }
  void LocationSDKHumanoidProps(LocationSDKHumanoid h){
   var cast=locationSDKHumanoidCast;
   if(locationSDKHumanoidBowl==null){
    // Enamel bowl 150 mm with porridge; enamel mug 80 mm with tea (proposal props, no asset).
    locationSDKHumanoidBowl=LocationSDKHumanoidLathe("yatai bowl",new[]{new Vector2(.035f,0),new Vector2(.06f,.02f),new Vector2(.075f,.055f),new Vector2(.07f,.055f),new Vector2(.055f,.022f),new Vector2(.03f,.008f)},.066f,.042f);
    locationSDKHumanoidMug=LocationSDKHumanoidLathe("yatai mug",new[]{new Vector2(.036f,0),new Vector2(.04f,.004f),new Vector2(.04f,.09f),new Vector2(.035f,.09f),new Vector2(.035f,.008f)},.035f,.07f);
    locationSDKHumanoidOwned.Add(locationSDKHumanoidBowl);locationSDKHumanoidOwned.Add(locationSDKHumanoidMug);
    locationSDKHumanoidBowlMaterials=new[]{LocationSDKHumanoidPropMaterial("bowl enamel",cast.prop_bowl_color,.55f),LocationSDKHumanoidPropMaterial("porridge",new Color(.78f,.69f,.52f,1),.25f)};
    locationSDKHumanoidMugMaterials=new[]{LocationSDKHumanoidPropMaterial("mug enamel",cast.prop_mug_color,.6f),LocationSDKHumanoidPropMaterial("tea",new Color(.30f,.16f,.06f,1),.8f)};
