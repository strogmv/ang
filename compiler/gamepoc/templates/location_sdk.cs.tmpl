   if(sheet.rows!=null&&sheet.rows.Length>0){if(walking){Vector2 direction=new Vector2(path[0].X-position.x,path[0].Y-position.y);float angle=Mathf.Atan2(direction.x-direction.y,direction.x+direction.y)*Mathf.Rad2Deg;row=sheet.rows[(((int)Mathf.Round(-angle/45))+8)%8];characterDirections[id]=row;}else if(!characterDirections.TryGetValue(id,out row))row=sheet.rows[0];}
