   nearest:=1<<30
   for _,c:=range d.Candidates{if !c.Selected{continue};hunter:=d.Agents[r.demoAgentIndex(c.AgentID)];distance:=manhattan(a.Position,hunter.Position)
    if distance<nearest&&distance<=p.SightRange&&r.sceneVisible(cell(a.Position),cell(hunter.Position)){nearest=distance;a.Reaction.HasLookTarget=true;a.Reaction.LookAt=cell(hunter.Position);a.Reaction.WatchSubjectID=hunter.ID}
   }
  }
 }
}
// socialStep: perception and personal decisions run every pass, before any network call exists;
// group coordination starts only once the dispatcher has issued the call.
func(r *Runtime) socialStep(){
 d:=&r.state.Demo;r.updateSceneAwareness()
 controlled:=map[string]bool{}
 if d.Issued{
