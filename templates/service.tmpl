package port

import (
        "context"
        "log/slog"
        "fmt"
        {{- if ServiceHasFileOutput .Service }}
        "io"
        {{- end }}
        {{- if or (HasEventMethods .Service) (HasDomainTypes .Service) }}
        "{{ .GoModule }}/internal/domain"
        {{- end }}
)

{{- define "validator" }}
func (d *{{ .Name }}) Validate() error {
        return nil
}
{{- end }}

{{ ServiceInterfaceDecl .Service }}

// Request/Response DTOs
{{- range .Service.Methods }}
{{- if not (EventForMethod $.Service .) }}
type {{ .Input.Name }} struct {
        {{- range .Input.Fields }}
        {{ .Name | ExportName }} {{ GoFieldType . }} `json:"{{ JSONName .Name }}"`
        {{- end }}
}
{{ template "validator" .Input }}
{{- end }}
{{- if and .Output.Name (not (EventForMethod $.Service .)) (FileOutput .) }}
// {{ .Output.Name }} is a file: the handler writes it as is, not as JSON.
type {{ .Output.Name }} struct {
        // Body is streamed to the client and closed; when nil, Content is written.
        Body io.ReadCloser
        Content []byte
        // ContentType and Filename replace the declared ones when set.
        ContentType string
        Filename string
        // Size is the length of Body when known (Content-Length).
        Size int64
}
{{ template "validator" .Output }}
{{- else if and .Output.Name (not (EventForMethod $.Service .)) }}
type {{ .Output.Name }} struct {
        {{- range .Output.Fields }}
        {{ .Name | ExportName }} {{ GoFieldType . }} `json:"{{ JSONName .Name }}"`
        {{- end }}
}
{{ template "validator" .Output }}
{{- end }}
{{- end }}

{{- range ServiceNestedTypes .Service }}
type {{ .Name }} struct {
        {{- range .Fields }}
        {{ .Name | ExportName }} {{ GoFieldType . }} `json:"{{ JSONName .Name }}"`
        {{- end }}
}
{{ template "validator" . }}
{{- end }}
