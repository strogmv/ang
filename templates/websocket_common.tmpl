		raw = strings.TrimSpace(raw[7:])
	} else {
		raw = strings.TrimSpace(r.URL.Query().Get("token"))
	}
	if raw != "" {
		claims, err := parseAndVerifyJWT(raw)
		if err != nil {
			return wsIdentity{}, fmt.Errorf("ws auth: %w", err)
		}
		ident := wsIdentity{UserID: getStringClaim(claims, authUserClaim), CompanyID: getStringClaim(claims, authCompanyClaim)}
		if ident.UserID == "" {
			return wsIdentity{}, fmt.Errorf("ws auth: token has no user")
		}
		return ident, nil
