func TestPopulationTransitSaveReplay(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 30, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 28800, 1, "", PopulationEnvironment{})
	populationAdvance(t, &s, p, l, 28810, 2, "", PopulationEnvironment{})
	aboard := 0
	for _, a := range s.Actors {
		if a.Trip != nil {
			aboard++
		}
	}
	if aboard == 0 {
		t.Fatal("fixture has no active journey")
	}
	raw, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var restored PopulationState
	if err := json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	for tick := int64(3); tick < 50; tick++ {
		level := ""
		if tick > 20 {
			level = "b"
		}
		seconds := 28800 + tick*10
		populationAdvance(t, &s, p, l, seconds, tick, level, PopulationEnvironment{})
		populationAdvance(t, &restored, p, l, seconds, tick, level, PopulationEnvironment{})
		if !reflect.DeepEqual(s.Clone(), restored.Clone()) {
			t.Fatal("transit replay diverged")
		}
	}
}
func TestPopulationRejectsExternalCollisionBeforeMutation(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 3, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 1, 1, "a", PopulationEnvironment{})
	at := s.Actors[0].Position
	before := s.Clone()
	env := PopulationEnvironment{Occupied: map[string]map[Cell]bool{"a": {at: true}}}
	if err := s.Advance(p, l, 2, 2, "a", env); err == nil || !reflect.DeepEqual(before, s.Clone()) {
		t.Fatal("conflicting host occupancy accepted or mutated population")
	}
	bad := s.Clone()
	bad.Actors = bad.Actors[:2]
	if bad.Validate(p, l, 1, 1) == nil {
		t.Fatal("truncated identity registry accepted")
	}
}
func BenchmarkPopulationShiftChange(b *testing.B) {
	for _, count := range []int{100, 300} {
		b.Run(fmt.Sprintf("actors=%d", count), func(b *testing.B) {
			p, l := populationFixture()
			initial, err := p.Start(l, count, 0, 0)
			if err != nil {
				b.Fatal(err)
			}
			if err := initial.Advance(p, l, 1, 1, "a", PopulationEnvironment{}); err != nil {
