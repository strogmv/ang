func chipHudOf(r *Runtime) *pb.PocHudView {
	msg := &pb.PocGameState{Life: &pb.PocLifeView{LevelId: r.state.Life.Actor(playerActorID).Level}}
	r.appendChipHud(msg, "ru")
	return msg.Hud
}

// The medmonitor reads the wound model: a whole hero shows all his blood and no wound; after a blow from a world source
// (the general rule, applyWorldHit) the blood is the model's own (1000 − the loss in permille), every wound stands by
// its zone, the state is the model's. Building the HUD changes nothing of the state.
func TestChipHudShowsTheHerosBodyFromTheWoundModel(t *testing.T) {
	r, h := worldHitFixture(t)
	if r.world.Hud == nil {
		t.Skip("content has no world.hud")
	}
	v := chipHudOf(r)
	if v == nil || v.BloodPermille != 1000 || v.State != "ok" || len(v.Wounds) != 0 || v.StateText == "" {
		t.Fatalf("a whole hero: %+v", v)
	}
	if len(v.Functions) != len(r.world.Hud.Functions) || v.Link == nil || v.Link.Text == "" {
		t.Fatalf("the chip's functions and link: %+v", v)
	}
	for _, f := range v.Functions {
		if f.Title == "" || (!f.Open && f.Reason == "") {
			t.Fatalf("a function without its words: %+v", f)
		}
	}
	for i := 0; i < 12; i++ {
		if body, known := r.biomonitorBody(playerActorID); known && len(body.Wounds) > 0 {
			break
		}
		h.Seed++
		if _, err := r.applyWorldHit(playerActorID, h); err != nil {
			t.Fatal(err)
		}
	}
	body, known := r.biomonitorBody(playerActorID)
	if !known || len(body.Wounds) == 0 {
		t.Skip("the source left no wound in twelve blows")
	}
	before, _ := json.Marshal(r.state)
	v = chipHudOf(r)
	after, _ := json.Marshal(r.state)
	if !reflect.DeepEqual(before, after) {
		t.Fatal("building the HUD changed the state")
	}
	if want := int32(1000 - body.LostPermille()); v.BloodPermille != min(1000, max(0, want)) {
		t.Fatalf("blood %d, the wound model has %d", v.BloodPermille, want)
	}
	if len(v.Wounds) != len(body.Wounds) {
		t.Fatalf("%d wounds shown, the body has %d", len(v.Wounds), len(body.Wounds))
	}
	for i, w := range body.Wounds {
		if v.Wounds[i].Zone != w.Zone || v.Wounds[i].Limb != w.Limb {
			t.Fatalf("wound %d shown at %s/%s, it is at %s/%s", i, v.Wounds[i].Zone, v.Wounds[i].Limb, w.Zone, w.Limb)
		}
	}
	if state := combatWounds.ViewSelf(body, 0).State; "wounds.state."+v.State != state {
		t.Fatalf("state %s, the model's %s", v.State, state)
	}
}

// The needs are the brain's own (fullness in permille), one row per world.hud.needs.
func TestChipHudNeedsAreTheBrainsOwn(t *testing.T) {
	r := lifeRuntimeFixture(t)
	if r.world.Hud == nil {
		t.Skip("content has no world.hud")
	}
	hero := r.state.Life.Actor(playerActorID)
	v := chipHudOf(r)
	if len(v.Needs) != len(r.world.Hud.Needs) {
		t.Fatalf("%d needs shown, world.hud has %d", len(v.Needs), len(r.world.Hud.Needs))
	}
	for i, n := range r.world.Hud.Needs {
		want := int32(max(0, min(1000, 1000-hero.Brain.Needs[n.BrainIndex]/1000)))
		if v.Needs[i].Id != n.ID || v.Needs[i].Permille != want || v.Needs[i].Text == "" {
			t.Fatalf("need %s: %+v, the brain has %d", n.ID, v.Needs[i], want)
		}
	}
}

// The HUD's chance of a blow is the blow's own rule (owner 20.11, HUD review): in a real fight every attack option
// carries what AttackChance gives from the cell it strikes from (the hero's when it can strike, else where the panel's
// approach ends), a held technique 1000 (it always lands), may_parry only with that rule; other options carry none.
func TestChipHudBlowChancesAreTheRulesOwn(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_knife", "ru")
	combatEpisodeEngage(t, r, c, d)
	if !combatEpisodeHeroTurn(r) {
		t.Fatal("the hero never got a turn")
	}
	view := combatEpisodeView(r, c)
	if view == nil || view.Combat == nil {
		t.Fatal("no view of the fight")
	}
	rules := r.world.CombatRuntime.Rules
	approach := map[string]behavior.Cell{}
	for _, o := range view.Combat.Options {
		if o.Action == "move" && o.Enabled && strings.HasPrefix(o.Id, "move.approach.") {
			approach[strings.TrimPrefix(o.Id, "move.approach.")] = behavior.Cell{X: int(o.X), Y: int(o.Y)}
		}
	}
	hero := r.state.Combat.Actor(playerActorID)
	space := r.combatSpace(r.state.Combat)
	blows, certain := 0, 0
	for _, o := range view.Combat.Options {
		if o.Action != "attack" {
			if o.ChancePermille != 0 || o.MayParry {
				t.Fatalf("a chance on a command that is no blow: %+v", o)
			}
			continue
		}
		blows++
		if o.ChancePermille < 0 || o.ChancePermille > 1000 {
			t.Fatalf("a chance outside 0..1000: %+v", o)
		}
		// a held technique always lands; one the hero's weapon cannot make has no chance at all (and is refused)
		if _, technique := rules.Techniques[o.Mode]; technique {
			if o.ChancePermille == 1000 {
				certain++
			} else if o.ChancePermille != 0 || o.Enabled {
				t.Fatalf("a held technique always lands, the HUD says %d‰: %+v", o.ChancePermille, o)
			}
		}
		from := hero.Position
		if at, ok := approach[o.TargetId]; ok && !o.Enabled {
			from = at
		}
		want, parry := r.state.Combat.AttackChance(space, rules, playerActorID, behavior.CombatAction{Type: "attack", TargetID: o.TargetId, Mode: o.Mode, BodyPart: o.BodyPart, Aim: int(o.Aim)}, from)
		if o.ChancePermille != int32(math.Round(want*1000)) || o.MayParry != parry {
			t.Fatalf("option %s shows %d‰ (parry %v), the rule gives %.0f‰ (parry %v)", o.Id, o.ChancePermille, o.MayParry, want*1000, parry)
		}
	}
	if blows == 0 || certain == 0 {
		t.Fatalf("the fight offers %d blows, %d held techniques the hero's weapon can make", blows, certain)
	}
	// a defender who visibly stands ready (guarding, a reserve held: his readiness sign) may deflect a hand blow
	if rules.GuardAP > 0 {
		for i := range r.state.Combat.Actors {
			if a := &r.state.Combat.Actors[i]; a.ID != playerActorID {
				a.Guarding, a.ReservedAP = true, rules.GuardAP
			}
		}
		r.combatPanel = combatPanelCache{}
		parry := 0
		for _, o := range combatEpisodeView(r, c).Combat.Options {
			if o.Action == "attack" && o.MayParry {
				parry++
			}
		}
		if parry == 0 {
			t.Fatal("the defender guards with a reserve, and no blow says he may parry")
		}
	}
}

// The ПРЕДМЕТЫ deck's slots (review 21.11): an item keeps its slot while carried, a newly carried one takes the first
// empty slot, a slot whose item is gone is empty again; the tick saves them, the view shows the same; a loaded slot
// naming an item the save no longer holds is empty.
func TestChipHudItemSlotsKeepTheirPlace(t *testing.T) {
	r := lifeRuntimeFixture(t)
	if r.world.Hud == nil || !r.state.Life.Enabled {
		t.Skip("no HUD or no Life")
	}
	if _, ok := r.world.Inventory.Definitions["item.med_patch"]; !ok {
		t.Skip("no dressing in the content")
	}
	add := func(id string) {
		r.state.Inventory.Items[id] = inv.Item{ID: id, Definition: "item.med_patch", Quantity: 1, Condition: 1000000,
			Owner: playerActorID, Location: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, Origin: "test.hud"}
		r.state.Inventory.Revision++
	}
	firstEmpty := func(slots []string) int {
		for i, id := range slots {
			if id == "" {
				return i
			}
		}
		return -1
	}
	same := func(before, after []string, except int) {
		t.Helper()
		for i := range before {
			if i != except && before[i] != after[i] {
				t.Fatalf("slot %d moved: %q became %q (%v -> %v)", i, before[i], after[i], before, after)
			}
		}
	}
	r.advanceChipHudSlots()
	start := append([]string(nil), r.state.HudSlots...)
	if len(start) != r.world.Hud.ItemSlots {
		t.Fatalf("%d slots, the content has %d", len(start), r.world.Hud.ItemSlots)
	}
	// make room: the test's own items need an empty slot
	for firstEmpty(start) < 0 {
		delete(r.state.Inventory.Items, start[len(start)-1])
		r.state.Inventory.Revision++
		r.advanceChipHudSlots()
		start = append([]string(nil), r.state.HudSlots...)
	}
	k := firstEmpty(start)
	add("test.hud.a")
	r.advanceChipHudSlots()
	if r.state.HudSlots[k] != "test.hud.a" {
		t.Fatalf("a new item did not take the first empty slot %d: %v", k, r.state.HudSlots)
	}
	same(start, r.state.HudSlots, k)
	view, _ := r.chipHudItemSlots()
	if !reflect.DeepEqual(view, r.state.HudSlots) {
		t.Fatalf("the view %v differs from the saved slots %v", view, r.state.HudSlots)
	}
	// the item goes: its slot is empty again, the others stay; the next new item takes the first empty slot
	before := append([]string(nil), r.state.HudSlots...)
	delete(r.state.Inventory.Items, "test.hud.a")
	r.state.Inventory.Revision++
	r.advanceChipHudSlots()
	if r.state.HudSlots[k] != "" {
		t.Fatalf("the slot of a used-up item stayed taken: %v", r.state.HudSlots)
	}
	same(before, r.state.HudSlots, k)
	emptied := append([]string(nil), r.state.HudSlots...)
	add("test.hud.b")
	r.advanceChipHudSlots()
	if at := firstEmpty(emptied); r.state.HudSlots[at] != "test.hud.b" {
		t.Fatalf("the next new item did not take the first empty slot %d: %v", at, r.state.HudSlots)
	}
	same(emptied, r.state.HudSlots, firstEmpty(emptied))
	// a save made before the tick that emptied a slot still names the item; the load empties that slot
	saved := r.state
	saved.HudSlots = append([]string(nil), r.state.HudSlots...)
	saved.HudSlots[0] = "test.hud.gone"
	loadChipHudSlots(&saved)
	if saved.HudSlots[0] != "" {
		t.Fatalf("a loaded slot kept an item the save does not hold: %v", saved.HudSlots)
	}
}

var chipHudProof = flag.String("chip-hud-proof", "", "directory with base/<slot>.json of the HUD proof; writes wounded/<slot>.json")

// TestChipHudPrepareProofSaves (opt-in, design/hud/v1): the HUD proof's wounded hero. The base save of a proof run (the
// hero in the market) is loaded, the hero takes blows of the turret posts' fire profile at the arms from a test source
// through the general rule (applyWorldHit) until a wound bleeds, and bleeds through the ordinary after-care until about a
// tenth of his blood is lost (never past weakness); the save is written as wounded/<slot>.json for the next proof run.
func TestChipHudPrepareProofSaves(t *testing.T) {
	if *chipHudProof == "" {
		t.Skip("opt-in native proof preparation")
	}
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	slot := ""
	for _, s := range r.world.Config.SaveSlots {
		if _, err := os.Stat(filepath.Join(*chipHudProof, "base", s+".json")); err == nil {
			slot = s
			break
		}
	}
	if slot == "" {
		t.Fatalf("no base save in %s/base", *chipHudProof)
	}
	r.data = filepath.Join(*chipHudProof, "base")
	s, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	r.state = s
	if r.world.TurretWatch == nil || r.world.TurretWatch.Rule.Fire == nil {
		t.Fatal("the content has no world source with a fire profile")
	}
	hero := r.state.Life.Actor(playerActorID)
	fire := r.world.TurretWatch.Rule.Fire
	h := worldHit{Source: "world.test_chip_hud", Fire: fire.WorldSource, Target: "arms", From: behavior.Cell{X: hero.Position.X + 4, Y: hero.Position.Y}, Seed: 7}
	// bleed five game seconds a tick (the proof sets the world's rate back with the game's own command after the load)
	r.state.Life.SecondsPerTick = 5
	start := r.state.Life.Seconds
	for i := 0; i < 8; i++ {
		if body, known := r.biomonitorBody(playerActorID); known && len(body.Wounds) > 0 && body.LostPermille() > 0 || i > 0 && r.woundBodyDead(playerActorID) {
			break
		}
		h.Seed++
		if _, err := r.applyWorldHit(playerActorID, h); err != nil {
			t.Fatal(err)
		}
		worldHitBleed(t, r, playerActorID, 5)
	}
	for r.state.Life.Seconds-start < 900 {
		body, _ := r.biomonitorBody(playerActorID)
		if body.LostPermille() >= 110 || combatWounds.Status(body).State != "ok" {
			break
		}
		worldHitBleed(t, r, playerActorID, 5)
	}
	// two dressings in his pocket (fixture only), made by the inventory's own transform so the save stays valid: the
	// HUD's quick slot uses one
	if _, ok := r.world.Inventory.Definitions["item.med_patch"]; ok {
		var made []inv.Make
		for _, id := range []string{"proof.hud.med_patch.1", "proof.hud.med_patch.2"} {
			made = append(made, inv.Make{ID: id, Definition: "item.med_patch", Quantity: 1, Condition: 1000000, Owner: playerActorID,
				Origin: "proof.hud", Location: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}})
		}
		if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Make: made}); err != nil {
			t.Fatalf("the fixture's dressings: %v", err)
		}
	}
	// the old wounds have stopped bleeding: one more hit leaves a fresh one, so the quick dressing has a wound to take
	dressable := func() bool {
		for _, o := range r.outsideWoundAidOptions(r.combatant(playerActorID, "player"), "ru") {
			if o.ItemId == "item.med_patch" && o.Enabled {
				return true
			}
		}
		return false
	}
	for i := 0; i < 6 && !dressable(); i++ {
		h.Seed++
		if _, err := r.applyWorldHit(playerActorID, h); err != nil {
			t.Fatal(err)
		}
	}
	if !dressable() {
		t.Log("no wound a dressing can take: the proof's quick-item frame will show the dressing idle")
	}
	body, known := r.biomonitorBody(playerActorID)
	if !known || len(body.Wounds) == 0 || body.Dead {
		t.Fatalf("the hero has no living wounded body after the blows: %+v", body)
	}
	out := filepath.Join(*chipHudProof, "wounded")
	if err := os.MkdirAll(out, 0o755); err != nil {
		t.Fatal(err)
	}
	r.data = out
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	// the game must load it as it loads any save of this build
	if _, _, err := r.readSave(slot); err != nil {
		t.Fatalf("the wounded fixture does not load: %v", err)
	}
	meta, _ := json.MarshalIndent(map[string]any{"slot": slot, "state": combatWounds.Status(body).State,
		"lost_permille": body.LostPermille(), "wounds": len(body.Wounds), "bled_seconds": r.state.Life.Seconds - start,
		"content_hash": r.world.ContentHash, "dressable": dressable(),
		"setup": "Real save of the HUD proof in the market; the hero is hit at the arms by the test source world.test_chip_hud with the turret posts' fire profile through applyWorldHit and bleeds through advanceWoundCare. Proof fixture only."}, "", " ")
	if err := os.WriteFile(filepath.Join(out, "setup.json"), meta, 0o644); err != nil {
		t.Fatal(err)
	}
}
