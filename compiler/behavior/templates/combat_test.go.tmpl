	combatDo(t, &s, space, r, "scout", CombatAction{Type: "end"})
	combatDo(t, &s, space, r, "relay", CombatAction{Type: "report", TargetID: "receiver"})
	got := *combatContact(s.Actor("receiver"), "enemy")
	if !got.Checked || got.Position != cleared.Position || got.ObservedTurn != cleared.ObservedTurn || got.ObservedAction != cleared.ObservedAction || got.CheckedTurn != cleared.CheckedTurn || got.CheckedAction != cleared.CheckedAction || got.SourceID != "scout" || got.ReporterID != "relay" {
