// heroFileFirstNightEnd: the life second the first review lapses — the end (night_to_h) of the first night window that
// begins after the game's start.
func (r *Runtime) heroFileFirstNightEnd() int64 {
	w := r.world.HeroFile
	start := r.world.Life.StartSeconds
	from := start/86400*86400 + int64(w.Recheck.NightFromH)*3600
	if from < start {
		from += 86400
	}
	end := from/86400*86400 + int64(w.Recheck.NightToH)*3600
	if end <= from {
		end += 86400
	}
	return end
}

func heroFileNight(hour, from, to int) bool {
	if from < to {
		return hour >= from && hour < to
	}
	return hour >= from || hour < to
}

// appendHeroFileOffer: the chip's notice of the first check while it is offered.
func (r *Runtime) appendHeroFileOffer(msg *pb.PocGameState, locale string) {
	f, w := r.state.HeroFile, r.world.HeroFile
	if f == nil || w == nil || f.Recheck != "offered" {
		return
	}
	text := func(key string) string { return r.localText(locale, key, key) }
	msg.HeroFileOffer = &pb.PocHeroFileOffer{Title: text(w.Recheck.Title), Body: text(w.Recheck.Body), Do: text(w.Recheck.Do), Skip: text(w.Recheck.Skip)}
}

// heroFileCommand: the first check — apply a new profile, strengths and trait (the past and the portrait stay), or skip.
func (r *Runtime) heroFileCommand(cmd *pb.PocHeroFileCommand) error {
	f, w := r.state.HeroFile, r.world.HeroFile
	if w == nil {
		return errors.New("the world has no hero file")
	}
	if f == nil || f.Legacy || f.Recheck != "offered" || !r.state.Active || r.heroInDanger() {
		return textError{Key: w.Text.NoRecheck}
	}
	switch cmd.Action {
	case "skip":
		f.Recheck = "skipped"
		return nil
	case "apply":
		c, err := w.read(cmd.Choice)
		if err != nil {
			return err
		}
		if cmd.Choice == nil || cmd.Choice.Profile == "" {
			return textError{Key: w.Text.Invalid}
		}
		if !reflect.DeepEqual(c.Episodes, f.Choice.Episodes) || c.Portrait != f.Choice.Portrait {
			return textError{Key: w.Text.PastLocked}
		}
		if err := w.complete(c); err != nil {
			return err
		}
		next := f.clone()
		next.Choice, next.Recheck = c, "done"
		previous := r.state.HeroFile
		r.state.HeroFile = next
		if err := r.heroFileSetOwn(c); err != nil {
			r.state.HeroFile = previous
			return err
		}
		r.heroFileSyncCombat()
		return nil
	}
	return textError{Key: w.Text.Invalid}
}

// heroFileAction answers a first-check command: a refusal in the player's words, or the chip's confirmation.
func (r *Runtime) heroFileAction(c *connection, id string, err error) {
	if err != nil {
		r.action(c, id, "hero_file", "", err)
		return
	}
	result := &pb.PocActionResult{RequestId: id, Action: "hero_file", Ok: true, Message: r.localText(c.locale, r.world.HeroFile.Recheck.Done, "")}
	if rec := r.receipts[id]; rec != nil {
		rec.result = result
	}
	r.send(c, &pb.ServerMessage{Msg: &pb.ServerMessage_ActionResult{ActionResult: result}})
}

