func TestCombatAimedBurstHaveFiniteAPAmmoConditionAndOrderedEvents(t *testing.T) {
	r, space := combatAdvancedRules(), combatFixtureSpace()
	r.MinHit = 1
	r.MaxHit = 1
	r.DamageMin = 1
	r.DamageMax = 1
	a, b := combatFixtureActor("a", "blue", Cell{1, 1}), combatFixtureActor("b", "red", Cell{4, 1})
	a.Initiative = 30
	b.Initiative = 20
	a.Weapon.Kind = "firearm"
	a.Weapon.Damage = 12
	a.Weapon.Magazine = 3
	a.Ammo = 3
	a.Weapon.AimAP = 1
	a.Weapon.AimBonus = 15
	a.Weapon.BurstAP = 1
	a.Weapon.BurstSize = 3
	a.Weapon.BurstPenalty = 8
	a.WeaponUsesRemaining = 4
	s := combatNewAdvanced(t, r, space, a, b)
	combatDo(t, &s, space, r, "a", CombatAction{Type: "attack", TargetID: "b", Mode: "aimed", Aim: 2})
	if s.Actor("a").AP != 3 || s.Actor("a").Ammo != 2 || s.Actor("a").WeaponUsesRemaining != 3 {
		t.Fatal("aimed shot did not spend its actual AP/ammo/use")
	}
	before := s.Clone()
	if err := s.Execute(space, r, "a", CombatAction{Type: "attack", TargetID: "b", Mode: "burst"}); err == nil || !reflect.DeepEqual(before, s) {
		t.Fatal("underfilled burst changed state")
	}
	combatDo(t, &s, space, r, "a", CombatAction{Type: "reload"})
	combatDo(t, &s, space, r, "a", CombatAction{Type: "end"})
	combatDo(t, &s, space, r, "b", CombatAction{Type: "end"})
	seq := s.EventSeq
	combatDo(t, &s, space, r, "a", CombatAction{Type: "attack", TargetID: "b", Mode: "burst"})
	n, ammo, uses, ap := 0, 0, 0, 0
	for _, e := range s.Events {
		if e.Sequence > seq && e.Type == "attack" {
			n++
			ammo += e.AmmoSpent
			uses += e.WeaponUses
			ap += e.AP
		}
	}
	if n != 3 || ammo != 3 || uses != 3 || ap != 4 || s.Actor("a").Ammo != 0 || s.Actor("a").WeaponUsesRemaining != 0 || !s.Actor("a").WeaponUsesLimited {
		t.Fatal("burst did not resolve three finite projectiles")
	}
	previous := uint64(0)
	for _, e := range s.Events {
		if e.Sequence <= previous {
			t.Fatal("projectile events lost unique ordering")
		}
		previous = e.Sequence
	}
	if err := s.Validate(r, space); err != nil {
		t.Fatal(err)
	}
}
