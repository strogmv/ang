func (r *Runtime) memoryDay() int64 { return r.state.Life.Seconds/86400 + 1 }

// afterDecision identifies the follow-up to an outcome the owner has already applied.
func (c talkCtx) afterDecision() bool {
	n := c.conv.Nodes[c.t.Node]
	return n != nil && n.AfterDecision
}

// person resolves "self" to the person the hero addressed.
func (c talkCtx) person(id string) string {
	if id == "self" {
		return c.self
	}
	return id
}

// memoryKnows (step 1): the person was a witness of the fact (it is still in his memory), or the fact is in the dome's
// record and he is silver; belief 1. Rumours with a belief below 1 are step 2.
func (r *Runtime) memoryKnows(who, fact string) bool {
    return r.storyBelief(who, fact) == 1
}

func (r *Runtime) memoryWitnessBelief(who, fact string) float64 {
	m := r.world.Memory
	if m == nil {
		return 0
	}
	def, rec := m.Facts[fact], r.state.Memory.Facts[fact]
	if def == nil || rec.Count == 0 || r.state.Life.Seconds-rec.Second > def.MemoryDays*86400 {
		return 0
	}
	for _, w := range rec.Witnesses {
		if w == who {
			return 1
		}
	}
    if def.Recorded && barkCatalog.Castes[who] == "silver" {
        return 1
    }
    return 0
}

// memoryWitnesses: who knows the fact at once — the named people, everyone on the hero's level for a public fact, whoever
// stands within hearing, whoever sees the hero within sight (the fight's sight model).
func (r *Runtime) memoryWitnesses(def *memoryFactDef, c talkCtx) []string {
	out := []string{}
	add := func(id string) {
		for _, w := range out {
			if w == id {
				return
			}
		}
		out = append(out, id)
	}
	for _, id := range def.KnownBy {
		if p := c.person(id); p != "" {
			add(p)
		}
	}
	hero := r.state.Life.Actor(playerActorID)
	level := c.level
	if level == "" && hero != nil {
		level = hero.Level
	}
	if c.quiet || level == "" {
		sort.Strings(out)
		return out
	}
    origin := c.origin
    if origin == nil && !c.worldOnly && hero != nil && hero.OnFloor() && hero.Level == level {
        origin = &hero.Position
    }
    for i := range r.state.Life.Actors {
        a := &r.state.Life.Actors[i]
        if a.ID == playerActorID || a.Level != level || !a.OnFloor() {
			continue
		}
		if def.Visibility == "public" {
			add(a.ID)
			continue
		}
        if origin != nil && r.storyWitnesses(a.ID, level, a.Position, *origin, def) {
            add(a.ID)
        }
	}
	sort.Strings(out)
	return out
}

// memoryWrite stores a fact once: its first and last time, where, its arguments, who knew it.
func (r *Runtime) memoryWrite(fact string, args map[string]string, c talkCtx) {
	m := r.world.Memory
	if m == nil || m.Facts[fact] == nil {
		return
	}
	if r.state.Memory.Facts == nil {
		r.state.Memory.Facts = map[string]memoryFact{}
	}
	rec, ok := r.state.Memory.Facts[fact]
    changed := false
    rec.Revision = max(1, rec.Revision)
	if !ok {
		rec.First = r.state.Life.Seconds
	}
	rec.Second = r.state.Life.Seconds
	rec.Level = c.level
	if hero := r.state.Life.Actor(playerActorID); hero != nil && rec.Level == "" {
		rec.Level = hero.Level
	}
	if len(args) > 0 {
		if rec.Args == nil {
			rec.Args = memoryArgs{}
		}
		for k, v := range args {
			if !memoryIn(rec.Args[k], v) {
                changed = ok
				if m.Facts[fact].ReplaceArgs {
					rec.Args[k] = nil
				}
				rec.Args[k] = append(rec.Args[k], v)
				sort.Strings(rec.Args[k])
			}
		}
	}
	known := map[string]bool{}
	for _, w := range rec.Witnesses {
		known[w] = true
	}
	for _, w := range r.memoryWitnesses(m.Facts[fact], c) {
		if !known[w] {
			rec.Witnesses = append(rec.Witnesses, w)
		}
	}
	sort.Strings(rec.Witnesses)
    if changed { rec.Revision++ }
	rec.Count++
	r.state.Memory.Facts[fact] = rec
 r.story.dirty = true
 r.story.meetingNext = 0
    def := m.Facts[fact]
    switch {
    case !c.worldOnly:
        r.learnStoryFact(&r.state, fact, storySaw, 1, rec.Second)
    case !c.quiet && c.origin != nil:
        if hero := r.state.Life.Actor(playerActorID); hero != nil && hero.OnFloor() && hero.Level == rec.Level &&
            r.storyWitnesses(hero.ID, rec.Level, hero.Position, *c.origin, def) {
            r.learnStoryFact(&r.state, fact, storySaw, 1, rec.Second)
        }
    }
}

func (r *Runtime) memoryTopic(topic string) {
    r.memoryTopicFrom(topic, storyTold)
}

func (r *Runtime) memoryTopicFrom(topic, source string) {
	if m := r.world.Memory; m == nil || m.Topics[topic] == nil {
		return
	}
	if r.state.Memory.Topics == nil {
		r.state.Memory.Topics = map[string]int64{}
	}
	if _, ok := r.state.Memory.Topics[topic]; !ok {
		r.state.Memory.Topics[topic] = r.state.Life.Seconds
		r.story.dirty = true
		r.story.meetingNext = 0
        r.addStoryJournal(&r.state, topic, source, "", r.state.Life.Seconds)
	}
}

// memoryShown: the instance of the definition a person shows now — on his tray or his shop's display, for sale and not
// hidden; his stock is never a talk's thing; deterministic (the smaller stack, then by id).
func (r *Runtime) memoryShown(owner, definition string) (inv.Item, bool) {
	display := map[string]bool{}
	for _, p := range r.world.Peddlers.Peddlers {
		display[p.Tray] = true
	}
	for _, sh := range r.world.Inventory.Shopfronts {
		display[sh.DisplayStore] = true
	}
	ids := make([]string, 0)
	for id, i := range r.state.Inventory.Items {
		if i.Owner == owner && i.Definition == definition && i.Quantity > 0 && i.ForSale && !i.Hidden && i.Location.Kind == "store" && display[i.Location.Store] {
			ids = append(ids, id)
		}
	}
	if len(ids) == 0 {
		return inv.Item{}, false
	}
	sort.Slice(ids, func(a, b int) bool {
		x, y := r.state.Inventory.Items[ids[a]], r.state.Inventory.Items[ids[b]]
		if x.Quantity != y.Quantity {
			return x.Quantity < y.Quantity
		}
		return ids[a] < ids[b]
	})
	return r.state.Inventory.Items[ids[0]], true
}

// memoryCarried: an instance of the definition the hero has (any, by id).
func (r *Runtime) memoryCarried(definition string) (inv.Item, bool) {
	ids := make([]string, 0)
	for id, i := range r.state.Inventory.Items {
		if i.Owner == playerActorID && i.Definition == definition && i.Quantity > 0 {
			ids = append(ids, id)
		}
	}
	if len(ids) == 0 {
		return inv.Item{}, false
	}
	sort.Strings(ids)
	return r.state.Inventory.Items[ids[0]], true
}

// talkThings binds the things a talk is about when it opens (doc 09, 21.11): every item its conditions or effects name
// with an owner other than the hero is the exact instance he shows then; an effect acts on that one, and a line about it
// is hidden once it is gone. The trader's stock is never touched.
func (r *Runtime) talkThings(c talkCtx) {
	c.t.Things = nil
	var when func(w *memWhen)
	bind := func(owner, item string) {
		if owner == "hero" || owner == "" {
			return
		}
		who := c.person(owner)
		if it, ok := r.memoryShown(who, item); ok {
			if c.t.Things == nil {
				c.t.Things = map[string]string{}
			}
			c.t.Things[who+"|"+item] = it.ID
		}
	}
	when = func(w *memWhen) {
		if w == nil {
			return
		}
		if w.Item != nil {
			bind(w.Item.Owner, w.Item.Item)
		}
		for i := range w.Any {
			when(&w.Any[i])
		}
		when(w.Not)
	}
	do := func(list []memDo) {
		for _, d := range list {
			when(d.When)
			if d.GiveItem != nil {
				bind(d.GiveItem.From, d.GiveItem.Item)
			}
			if d.ItemCondition != nil {
				bind(d.ItemCondition.Owner, d.ItemCondition.Item)
			}
		}
	}
	for _, e := range c.conv.Entries {
		when(e.When)
	}
	for _, n := range c.conv.Nodes {
		for _, v := range n.Voices {
			when(v.When)
			do(v.Do)
		}
		for _, o := range n.Options {
			when(o.When)
			do(o.Do)
			if o.Fail != nil {
				do(o.Fail.Do)
			}
		}
	}
}

// memoryItem: the talk's thing of this owner and definition (the exact instance bound when the talk opened, still his), or
// the hero's own; without a talk, the instance the owner shows.
func (r *Runtime) memoryItem(c talkCtx, owner, definition string) (inv.Item, bool) {
	if owner == playerActorID {
		return r.memoryCarried(definition)
	}
	if c.t == nil {
		return r.memoryShown(owner, definition)
	}
	id := c.t.Things[owner+"|"+definition]
	it, ok := r.state.Inventory.Items[id]
	if id == "" || !ok || it.Owner != owner || it.Definition != definition || it.Quantity < 1 {
		return inv.Item{}, false
	}
	return it, true
}

// memoryOne: one unit of the instance as its own item (split off a stack), for an effect on one thing.
func (r *Runtime) memoryOne(item inv.Item) (string, []inv.Relocate) {
	if item.Quantity <= 1 {
		return item.ID, nil
	}
	split := fmt.Sprintf("%s.one.%d", item.ID, r.state.Inventory.Revision)
	return split, []inv.Relocate{{Item: item.ID, Quantity: 1, Split: split, To: item.Location}}
}

// memoryHolds: the condition holds now (nil holds).
func (r *Runtime) memoryHolds(c talkCtx, w *memWhen) bool {
	if w != nil && (w.FileTrait != "" || w.FileStrength != "") {
		f := r.state.HeroFile
		if f == nil || w.FileTrait != "" && f.Choice.Trait != w.FileTrait ||
			w.FileStrength != "" && !memoryIn(f.Choice.Strengths, w.FileStrength) {
			return false
		}
	}
	if w == nil {
		return true
	}
	now := r.state.Life.Seconds
	facts := r.state.Memory.Facts
	if f := w.Fact; f != nil {
		rec, ok := facts[f.ID]
		if !ok {
			return false
		}
		for k, v := range f.Args {
			if !memoryIn(rec.Args[k], v) {
				return false
			}
		}
		if f.WithinHours > 0 && now-rec.Second > f.WithinHours*3600 {
			return false
		}
		if f.CalendarDaysSince > 0 && now/86400-rec.First/86400 < f.CalendarDaysSince ||
			f.HoursSince > 0 && now-rec.First < f.HoursSince*3600 {
			return false
		}
		if f.Today && rec.Second/86400 != now/86400 { return false }
		if f.BeforeToday && rec.First >= now/86400*86400 {
			return false
		}
	}
	if _, ok := facts[w.NotFact]; w.NotFact != "" && ok {
		return false
	}
	if _, ok := r.state.Memory.Topics[w.Topic]; w.Topic != "" && !ok {
		return false
	}
	if _, ok := r.state.Memory.Topics[w.NotTopic]; w.NotTopic != "" && ok {
		return false
	}
    if k := w.Knows; k != nil {
        belief := r.storyBelief(c.person(k.Who), k.Fact)
        threshold := k.AtLeast
        if threshold == 0 && k.Who != "hero" {
            threshold = 1 // the existing NPC form asked for firsthand knowledge
        }
        if belief <= 0 || belief < threshold {
            return false
        }
    }
	if t := w.Trust; t != nil {
		v := r.state.Life.RelationTo(r.world.Life, c.person(t.Who), playerActorID)
		if t.AtLeast != nil && v < *t.AtLeast || t.Below != nil && v >= *t.Below {
			return false
		}
	}
	if w.Skill != nil && r.dialogueSkill(w.Skill.ID) < w.Skill.AtLeast {
		return false
	}
	if d := w.Day; d != nil {
		day := r.memoryDay()
		if d.From > 0 && day < d.From || d.To > 0 && day > d.To {
			return false
		}
	}
	if q := w.Quest; q != nil && r.state.Memory.QuestSteps[q.ID].Step != q.Step {
		return false
	}
	if h := w.Hour; h != nil {
		hour := r.state.Life.Seconds % 86400 / 3600
		if hour < h.From || hour >= h.To {
			return false
		}
	}
	if w.HeroAt != nil && !r.storyActorAt(playerActorID, *w.HeroAt) {
		return false
	}
	if p := w.Present; p != nil {
		for _, id := range p.People {
			if !r.storyActorAt(id, p.storyLocation) || !r.bodyCanSpeak(id) {
				return false
			}
		}
	}
	if w.CRDMinor > 0 {
		account, ok := r.peddlerAccount(playerActorID)
		if !ok || account.Balance < w.CRDMinor {
			return false
		}
	}
	if w.Placement != "" && r.storyPlacementItem(w.Placement).ID == "" {
		return false
	}
	if t := c.t; t != nil {
		if w.Asked != "" && !t.chose(w.Asked) || w.NotAsked != "" && t.chose(w.NotAsked) {
			return false
		}
		if w.Voiced != "" && !t.voiced(w.Voiced) || w.Entry != "" && t.Entry != w.Entry {
			return false
		}
		if w.Interjected != nil && t.Interjected != *w.Interjected {
			return false
		}
	} else if w.Asked != "" || w.Voiced != "" || w.Entry != "" || w.Interjected != nil && *w.Interjected {
		return false
	}
	if len(w.Speaker) > 0 && !memoryIn(w.Speaker, c.self) || len(w.Caste) > 0 && !memoryIn(w.Caste, barkCatalog.Castes[c.self]) {
		return false
	}
	if it := w.Item; it != nil {
		owner := c.person(it.Owner)
		if it.Owner == "hero" {
			owner = playerActorID
		}
		var item inv.Item
		var ok bool
		if it.Held {
			item,ok=r.memoryHeld(it.Item)
		} else {
			item,ok=r.memoryItem(c, owner, it.Item)
		}
		if !ok {
			return false
		}
		if it.ConditionBelow != nil && item.Condition >= int64(*it.ConditionBelow*1000000) || it.ConditionAtLeast != nil && item.Condition < int64(*it.ConditionAtLeast*1000000) {
			return false
		}
	}
	if w.TrainBerth != "" && !r.storyTrainStopped(c.level) {
		return false
	}
	if p := w.DeckPhase; p != nil && !memoryIn(p.Phases, r.state.LiftingDecks[p.Deck].Phase) {
		return false
	}
	switch w.World {
	case "passage_open":
		if !r.encounterPassageOpen() {
			return false
		}
	case "self_trades":
		if !r.talkSelfTrades(c.self) {
			return false
		}
	}
	if w.SeenBy != "" && !r.memorySeenBy(c, w.SeenBy) || w.NotSeenBy != "" && r.memorySeenBy(c, w.NotSeenBy) {
		return false
	}
	if len(w.Any) > 0 {
		any := false
		for i := range w.Any {
			any = any || r.memoryHolds(c, &w.Any[i])
		}
		if !any {
			return false
		}
	}
	return w.Not == nil || !r.memoryHolds(c, w.Not)
}

func memoryIn(list []string, v string) bool {
	for _, x := range list {
		if x == v {
			return true
		}
	}
	return false
}

// memorySeenBy: the person identifies the hero now (the fight's sight and identification), or did, as saved.
func (r *Runtime) memorySeenBy(c talkCtx, id string) bool {
	if c.seen != nil {
		return c.seen[id]
	}
	a := r.state.Life.Actor(id)
	return a != nil && a.OnFloor() && r.combatWorldIdentifies(combatLifeObserver{ID: id, Level: a.Level, At: a.Position}, playerActorID)
}

// memoryDo applies effects in order; an effect whose thing is gone (a sold lamp) does nothing.
func (r *Runtime) memoryDo(c talkCtx, list []memDo) error {
	if len(list) > 0 { r.story.dirty = true; r.story.meetingNext = 0 }
	for _, d := range list {
		if !r.memoryHolds(c, d.When) {
			continue
		}
		if err := r.storyEffect(d); err != nil {
			return err
		}
		if r.dev != nil { r.devEffect(d) }
		switch {
		case d.Fact != "":
			r.memoryWrite(d.Fact, d.Args, c)
		case d.Topic != "":
            r.memoryTopic(d.Topic)
        case d.Learn != "":
            r.learnStoryFromSpeaker(c.self, d.Learn)
		case d.Trust != nil:
			who := c.person(d.Trust.Who)
			old := r.state.Life.RelationTo(r.world.Life, who, playerActorID)
			if r.state.Life.RelationOverrides == nil {
				r.state.Life.RelationOverrides = map[string]map[string]float64{}
			}
			if r.state.Life.RelationOverrides[who] == nil {
				r.state.Life.RelationOverrides[who] = map[string]float64{}
			}
			r.state.Life.RelationOverrides[who][playerActorID] = max(-1, min(1, old+d.Trust.Delta))
		case d.GiveItem != nil:
			if item, ok := r.memoryItem(c, c.person(d.GiveItem.From), d.GiveItem.Item); ok {
				split := fmt.Sprintf("%s.given.%d", item.ID, r.state.Inventory.Revision)
				_, _ = r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: []inv.Relocate{{Item: item.ID, Quantity: 1, Split: split, To: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, Owner: playerActorID}}})
			}
		case d.ItemCondition != nil:
			// one thing mended or broken, not its whole stack
			if item, ok := r.memoryItem(c, c.person(d.ItemCondition.Owner), d.ItemCondition.Item); ok {
				one, moves := r.memoryOne(item)
				if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: moves, Restore: []inv.Restore{{Item: one, Condition: int64(d.ItemCondition.Set * 1000000)}}}); err == nil && c.t != nil && c.t.Things != nil {
					// the talk's thing is the one mended or broken (split off a stack, it has its own id)
					c.t.Things[c.person(d.ItemCondition.Owner)+"|"+d.ItemCondition.Item] = one
				}
			}
		}
	}
	return nil
}

// memoryOnTrade: the hero bought from this person; facts that a purchase writes (Prokhor: met{bought}).
func (r *Runtime) memoryOnTrade(seller string) {
	m := r.world.Memory
	if m == nil {
		return
	}
	ids := make([]string, 0)
	for id, f := range m.Facts {
		if f.OnTrade != nil && f.OnTrade.Seller == seller {
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	for _, id := range ids {
		r.memoryWrite(id, m.Facts[id].OnTrade.Args, talkCtx{self: seller})
	}
}

// lineText: the first variant whose condition holds, or the line's own text.
func (r *Runtime) lineText(c talkCtx, text string, variants []convVariant) string {
	for i := range variants {
		if r.memoryHolds(c, &variants[i].When) {
			return variants[i].Text
		}
	}
	return text
}

// talkSpeak writes the lines whose condition holds to the log, each with the text of its first holding variant.
func (r *Runtime) talkSpeak(c talkCtx, lines []convLine) {
	for _, l := range lines {
		if !r.memoryHolds(c, l.When) {
			continue
		}
		line := dialogueEntry{Kind: "line", Speaker: c.person(l.Speaker), Text: r.lineText(c, l.Text, l.Variants),
			NameKey: c.conv.NamedSpeakers[l.Speaker], Actors: l.Actors}
		if l.Speaker == "narrator" {
			line.Kind, line.Speaker = "narration", ""
		}
		index := len(c.t.Lines)
		r.dialogueSay(&c.t.dialogueSession, line)
		if r.dev != nil { r.devLine(c, index, l.Text, line.Text, l.When, l.Variants) }
	}
}

// talkEnter: the node's lines once per talk, then the hero's voices that have not spoken with this person and hold.
func (r *Runtime) talkEnter(c talkCtx, node string) {
	n := c.conv.Nodes[node]
	if n == nil {
		return
	}
	c.t.Node = node
	if len(n.Stage) > 0 {
		c.t.Staging = true
		return
	}
	r.talkArrive(c, n)
}

func (r *Runtime) talkArrive(c talkCtx, n *convNode) {
	c.t.Staging = false
	node := c.t.Node
	for _, seen := range c.t.Nodes {
		if seen == node {
			return
		}
	}
	c.t.Nodes = append(c.t.Nodes, node)
	_ = r.memoryDo(c, n.Do)
	r.talkSpeak(c, n.Lines)
	for _, v := range n.Voices {
		reason := "fired"
		switch {
		case c.t.voiced(v.ID): reason = "said"
		case r.dialogueSkill(v.Skill) < v.AtLeast: reason = "skill"
		case !r.memoryHolds(c, v.When): reason = "condition"
		}
		if r.dev != nil { r.devRule(c, v.ID, reason, fmt.Sprintf("%s %d / %d", v.Skill, r.dialogueSkill(v.Skill), v.AtLeast), v.When) }
		if reason != "fired" { continue }
		text, index := r.lineText(c, v.Text, v.Variants), len(c.t.Lines)
		r.dialogueSay(&c.t.dialogueSession, dialogueEntry{Kind: "voice", Skill: v.Skill, Text: text})
		if r.dev != nil { r.devLine(c, index, v.Text, text, v.When, v.Variants) }
		c.t.Voiced = append(c.t.Voiced, v.ID)
		r.memoryDo(c, v.Do)
	}
	r.talkSpeak(c, n.TailLines)
}

func (r *Runtime) storyOfficialStatus() string {
	if d := r.world.Start; d != nil {
		if status := r.state.Memory.Facts[d.StatusFact].Args["status"]; len(status) == 1 {
			return status[0]
		}
	}
	return ""
}

// startStory is called only by the configured New Game entry point. Save loads
// restore the conversation and the Life positions through the usual state.
func (r *Runtime) startStory() error {
	d := r.world.Start
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || !r.world.Life.WalksFor(d.Level, d.At, playerActorID) || r.state.Life.BlockedCells(d.Level, hero.ID)[d.At] {
		return fmt.Errorf("story opening: hero cannot stand at %s %+v", d.Level, d.At)
	}
	hero.Level, hero.Position, hero.Goal = d.Level, d.At, d.At
	hero.Path, hero.PendingPath, hero.Body, hero.Trip = nil, nil, nil, nil
	hero.Manual, hero.Arrived = true, true
	r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
	r.syncLifeHero()
	r.updateLifeExploration()
	r.syncRegionKnowledge()
	r.state.Memory.Opening = true
	r.state.Memory.OpeningPlayed = true
	return r.talkOpen(d.Conversation, d.Speaker)
}

func (r *Runtime) openingTalk(c talkCtx) bool {
	d := r.world.Start
	return r.state.Memory.Opening && d != nil && c.conv.ID == d.Conversation && c.self == d.Speaker
}

// The next authored beat becomes visible after each walker has actually
// reached its mark. Stations are temporary Life goals and use normal collision.
func (r *Runtime) talkStage(c talkCtx) func(string) (behavior.LifeStep, bool) {
	n := c.conv.Nodes[c.t.Node]
	level := c.conv.StageLevel
	return func(actor string) (behavior.LifeStep, bool) {
		at, ok := n.Stage[actor]
		return behavior.LifeStep{Level: level, At: at, Activity: "post"}, ok
	}
}

func (r *Runtime) talkBeforeFrame() {
	if r.state.Memory.Open == "" { return }
	t := r.state.Memory.Talks[r.state.Memory.Open]
	if t == nil || !t.Staging { return }
	c, ok := r.talkOpenNow()
	if !ok || !r.talkAllowed(c) { return }
	stage := r.talkStage(c)
	other := r.state.Life.BrainServices.StoryTarget
	r.state.Life.BrainServices.StoryTarget = func(actor string) (behavior.LifeStep, bool) {
		if step, ok := stage(actor); ok { return step, true }
		if other != nil { return other(actor) }
		return behavior.LifeStep{}, false
	}
	if step, ok := stage(playerActorID); ok {
		hero := r.state.Life.Actor(playerActorID)
		if hero.Position != step.At && (hero.Body == nil || hero.Body.Mode == "") {
			r.lifeWalkToPoint(step.At, 0, 0, false, false, 0)
		}
	}
}

func (r *Runtime) talkStageAfterFrame(c talkCtx) {
	n := c.conv.Nodes[c.t.Node]
	level := c.conv.StageLevel
	for id, at := range n.Stage {
		a := r.state.Life.Actor(id)
		if a == nil || !a.OnFloor() || a.Level != level || a.Position != at || !a.Arrived {
			return
		}
	}
	if n.KeepStage {
		for id, at := range n.Stage {
			a := r.state.Life.Actor(id)
			step := behavior.LifeStep{Level: level, At: at, Activity: "post"}
			if person := r.world.Life.Person(id); person != nil && a.Step >= 0 && a.Step < len(person.Steps) {
				step.Label = person.Steps[a.Step].Label
			}
			a.RoutineOverride = &step
		}
	}
	r.talkArrive(c, n)
}

// talkInterjection: the freshest fact the person knows himself (belief 1), fresh enough, not yet said by him, whose
// condition holds — his first line in any conversation of his (doc 103 §4.3).
func (r *Runtime) talkInterjection(c talkCtx) *interjectionDef {
	m := r.world.Memory
	if m == nil {
		return nil
	}
	var best *interjectionDef
	bestAt := int64(-1)
	for i := range m.Interjections {
		in := &m.Interjections[i]
		if in.Speaker != c.self {
			continue
		}
		if _, said := r.state.Memory.Said[c.self+"|"+in.Fact]; said {
			continue
		}
		rec, ok := r.state.Memory.Facts[in.Fact]
		if !ok || r.state.Life.Seconds-rec.Second > m.InterjectionRules.FreshDays*86400 || !r.storyLineBelief(c.self, in.Fact, in.Belief) || !r.memoryHolds(c, in.When) {
			continue
		}
		if rec.Second > bestAt || rec.Second == bestAt && best != nil && in.ID < best.ID {
			best, bestAt = in, rec.Second
		}
	}
	return best
}

// talkEntry: the first entry whose condition holds.
func (r *Runtime) talkEntry(c talkCtx) *convEntryDef {
	for i := range c.conv.Entries {
		if r.memoryHolds(c, c.conv.Entries[i].When) {
			return &c.conv.Entries[i]
		}
	}
	return nil
}

func (r *Runtime) talkState(key string) *talkState {
	if r.state.Memory.Talks == nil {
		r.state.Memory.Talks = map[string]*talkState{}
	}
	t := r.state.Memory.Talks[key]
	if t == nil {
		t = &talkState{}
		r.state.Memory.Talks[key] = t
	}
	if h, ok := r.state.Memory.Once[key]; ok {
		t.Chosen, t.Checks = h.Chosen, h.Checks
	}
	return t
}

// talkOpen opens a talk with a person: his interjection, the entry, its node. Another open talk ends without a word.
func (r *Runtime) talkOpen(conv, self string) error {
	d := r.world.Conversations[conv]
	if d == nil || d.StageLevel != "" && d.StageLevel != r.currentLevel() {
		return textError{Key: "error.encounter.unavailable"}
	}
	key := talkKey(conv, self)
	r.talkDrop()
	t := r.talkState(key)
	r.state.Memory.Serial++
	t.Lines, t.Nodes, t.Interjected, t.Until, t.Close, t.Entry, t.Node, t.Ticks, t.Hidden = nil, nil, false, 0, "", "", "", 0, false
	t.Trade = talkTrade{}
	t.Staging = false
	t.Opened, t.Serial = r.state.Life.Seconds, r.state.Memory.Serial
	r.state.Memory.Open = key
	c := talkCtx{conv: d, key: key, self: self, t: t}
	r.talkThings(c)
	preferred := r.talkEntry(c)
	in := r.talkInterjection(c)
	if r.dev != nil && r.world.Memory != nil { r.devInterjections(c, in, preferred) }
	if in != nil && (preferred == nil || !preferred.NoInterjection) {
		if r.state.Memory.Said == nil {
			r.state.Memory.Said = map[string]int64{}
		}
		r.state.Memory.Said[self+"|"+in.Fact] = r.state.Life.Seconds
		t.Interjected = true
		r.learnStoryFromSpeaker(self, in.Fact)
		r.dialogueSay(&t.dialogueSession, dialogueEntry{Kind: "line", Speaker: self, Text: in.Text})
		if v := in.Voice; v != nil {
			reason := "fired"
			if r.dialogueSkill(v.Skill) < v.AtLeast { reason = "skill" } else if !r.memoryHolds(c, v.When) { reason = "condition" }
			if r.dev != nil { r.devRule(c, in.ID+"/voice", reason, fmt.Sprintf("%s %d / %d", v.Skill, r.dialogueSkill(v.Skill), v.AtLeast), v.When) }
			if reason == "fired" { r.dialogueSay(&t.dialogueSession, dialogueEntry{Kind: "voice", Skill: v.Skill, Text: v.Text}) }
		}
		r.memoryDo(c, in.Do)
	}
	e := r.talkEntry(c)
	if r.dev != nil { r.devEntry(c,e) }
	if e == nil {
		r.talkDrop()
		return textError{Key: "error.encounter.unavailable"}
	}
	t.Entry = e.ID
	_ = r.memoryDo(c, e.Do)
	r.talkSpeak(c, e.Lines)
	r.talkEnter(c, e.Node)
	return nil
}

// talkOpenNow: the talk on now (not lingering), with its context.
func (r *Runtime) talkOpenNow() (talkCtx, bool) {
	key := r.state.Memory.Open
	t := r.state.Memory.Talks[key]
	if key == "" || t == nil || t.Until > 0 {
		return talkCtx{}, false
	}
	conv, self, _ := strings.Cut(key, "|")
	d := r.world.Conversations[conv]
	if d == nil {
		return talkCtx{}, false
	}
	return talkCtx{conv: d, key: key, self: self, t: t}, true
}

// talkDrop ends the open talk without a word (the hero walked away, a fight began, another talk opened).
func (r *Runtime) talkDrop() {
	if t := r.state.Memory.Talks[r.state.Memory.Open]; t != nil {
		t.Lines, t.Nodes, t.Until = nil, nil, 0
		t.Trade = talkTrade{}
	}
	r.state.Memory.Open = ""
}

// talkClose: the talk closed with a word; its log stays for the conversation's linger (real seconds: server ticks).
func (r *Runtime) talkClose(c talkCtx, word string) {
	c.t.Close = word
	c.t.Until = r.state.Tick + max(1, c.conv.LingerSeconds*int64(r.world.Config.TickHz))
}

// talkHolds: a talk is on, shown and held by its owner — the world waits for the hero's answer (owner 21.11: the
// player must have time to read; conversation.go counts the talk's own time instead).
func (r *Runtime) talkHolds() bool {
	c, ok := r.talkOpenNow()
	return ok && !c.t.Staging && !c.t.Hidden && r.talkAllowed(c)
}

// talkTick: one server tick of the open talk while the world waits; a talk that waits for an answer only so long hands
// its timeout to its owner.
func (r *Runtime) talkTick() {
	c, ok := r.talkOpenNow()
	if !ok {
		return
	}
	if c.afterDecision() {
		return
	}
	c.t.Ticks++
	if c.conv.AnswerSeconds > 0 && c.t.Ticks >= c.conv.AnswerSeconds*int64(r.world.Config.TickHz) {
		if word := r.talkEvent("timeout"); word != "" {
			r.talkClosed(c, word, false)
		}
	}
}

// optionShown: an answer of the node the hero may pick now (a locked retry check is shown, locked); an answer another
// shown answer replaces is not.
func (r *Runtime) optionShown(c talkCtx, o convOption) bool {
	return r.optionOwn(c, o) && r.optionReplacement(c, o.ID) == ""
}

func (r *Runtime) optionReplacement(c talkCtx, id string) string {
	if n := c.conv.Nodes[c.t.Node]; n != nil {
		for _, other := range n.Options {
			if other.Replaces == id && r.optionOwn(c, other) {
				return other.ID
			}
		}
	}
	return ""
}

// optionOwn: the answer's own condition, once and check.
func (r *Runtime) optionOwn(c talkCtx, o convOption) bool {
	if o.Once && c.t.chose(o.ID) || !r.memoryHolds(c, o.When) {
		return false
	}
	if o.Check != nil {
		if open, locked := r.dialogueCheckOpen(&c.t.dialogueSession, o.ID, *o.Check); !open && !locked && !o.KeepUsedCheck {
			return false
		}
	}
	return true
}

// talkChoose: the hero's answer in the open talk. It returns the closing word ("" when the talk goes on) and whether the
// answer's check failed; an answer that asks for the person's goods keeps the talk open and shows them (talkTrade).
func (r *Runtime) talkChoose(id string) (string, bool, error) {
	c, ok := r.talkOpenNow()
	if !ok {
		return "", false, textError{Key: "error.encounter.unavailable"}
	}
	defer func() { r.state.Memory.rememberTalk(c.key, c.t) }()
	n := c.conv.Nodes[c.t.Node]
	if n == nil || c.t.Staging {
		return "", false, textError{Key: "error.encounter.unavailable"}
	}
	// the goods are shown: the node's answers are not, until the hero is done with them
	if c.t.Trade.On && r.talkSelfTrades(c.self) {
		return "", false, textError{Key: "error.encounter.condition"}
	}
	c.t.Trade = talkTrade{}
	for index, o := range n.Options {
		if o.ID != id {
			continue
		}
		if !r.optionShown(c, o) {
			return "", false, textError{Key: "error.encounter.condition"}
		}
		if index >= dialogueAnswerLimit {
			shown := 0
			for _, earlier := range n.Options[:index] {
				if r.optionShown(c, earlier) { shown++ }
			}
			if shown >= dialogueAnswerLimit { return "", false, textError{Key: "error.encounter.condition"} }
		}
		if o.Check != nil {
			if open, _ := r.dialogueCheckOpen(&c.t.dialogueSession, o.ID, *o.Check); !open {
				return "", false, textError{Key: "error.dialogue.closed"}
			}
		}
		// asked before (no check to try again): the answer is in the log already, nothing is written twice
		if o.question() && o.Check == nil && c.t.chose(o.ID) {
			return "", false, nil
		}
		previous := c.t.dialogueSession.clone()
		if o.Continue {
			c.t.recordChoice(o.ID)
		} else {
			text, index := r.lineText(c, o.Text, o.Variants), len(c.t.Lines)
			r.dialogueAnswer(&c.t.dialogueSession, o.ID, text)
			if r.dev != nil { r.devLine(c, index, o.Text, text, o.When, o.Variants) }
		}
		if o.Trade {
			// the person's word about his goods, then the goods in place of the answers
			r.talkSpeak(c, o.Reply)
			if err := r.memoryDo(c, o.Do); err != nil {
				c.t.dialogueSession = previous
				return "", false, err
			}
			goods := r.talkGoods("", c.self, false)
            layout := r.world.Memory.Trade
            c.t.Trade = talkTrade{On: true, Screen: len(goods.rows) > layout.ColumnMax || goods.buys && layout.BuybackScreen}
			return "", false, nil
		}
		reply, do, next, word := o.Reply, o.Do, o.Next, o.Close
		failed := false
		if o.Check != nil && !r.dialogueRoll(&c.t.dialogueSession, c.key, o.ID, *o.Check) {
			failed = true
			reply, do, next, word = o.Fail.Reply, o.Fail.Do, o.Fail.Next, o.Fail.Close
		}
		r.talkSpeak(c, reply)
		if err := r.memoryDo(c, do); err != nil {
			c.t.dialogueSession = previous
			return "", false, err
		}
		switch {
		case !failed && o.FollowUp != "":
			r.talkClosed(c, word, false)
			r.talkEnter(c, o.FollowUp)
			return "", false, nil
		case next != "":
			r.talkEnter(c, next)
		case word != "":
			if r.openingTalk(c) {
				r.state.Memory.Opening = false
				r.talkDrop()
			} else {
				r.talkClose(c, word)
			}
		}
		return word, failed, nil
	}
	return "", false, textError{Key: "error.encounter.unavailable"}
}

// talkEvent: an event of the owner (the custody's timeout): its lines, effects and closing word.
func (r *Runtime) talkEvent(event string) string {
	c, ok := r.talkOpenNow()
	if !ok {
		return ""
	}
	e := c.conv.Events[event]
	if e == nil {
		return ""
	}
	var finish func(string)
	if r.dev != nil { finish = r.devStep(c, "event."+event) }
	r.talkSpeak(c, e.Lines)
	r.memoryDo(c, e.Do)
	r.talkClose(c, e.Close)
	if finish != nil { finish("fired") }
	return e.Close
}

// talkOf: the conversation a person opens now through world.memory.talks (not the encounter's).
func (r *Runtime) talkOf(person string) (*memoryTalkDef, bool) {
	m := r.world.Memory
	if m == nil {
		return nil, false
	}
	for i := range m.Talks {
		for _, p := range m.Talks[i].People {
			if p == person && r.memoryHolds(talkCtx{self:person},m.Talks[i].When) {
				return &m.Talks[i], true
			}
		}
	}
	// everyone else the hero can address: the shared talk that takes the others
	// (a person the content gives no name yet is not addressed: the column never shows a text key for a name)
	if person != playerActorID && r.state.Life.Actor(person) != nil && r.talkNamed(person) {
		for i := range m.Talks {
			if m.Talks[i].Others && r.memoryHolds(talkCtx{self:person},m.Talks[i].When) {
				return &m.Talks[i], true
			}
		}
	}
	return nil, false
}

// talkNamed: the content has the person's name.
func (r *Runtime) talkNamed(person string) bool {
	return r.dialogueText("ru", "actor."+person+".name") != "" || r.dialogueText("en", "actor."+person+".name") != ""
}

// talkSelfTrades: the person trades now (a peddler on his round, a stall keeper at his counter).
func (r *Runtime) talkSelfTrades(self string) bool {
	_, _, trades := r.talkSeller(self)
	return trades
}

// talkSeller: what the person sells from now — a peddler's tray at his stop, or the stalls he keeps and stands at.
func (r *Runtime) talkSeller(self string) (peddlerDef, []inv.Shopfront, bool) {
	if p, ok := r.peddlerOfActor(self); ok {
		return p, nil, r.encounterTradeAllowed(self) && r.peddlerStopNow(p) != ""
	}
	a := r.state.Life.Actor(self)
	if a == nil || !a.OnFloor() {
		return peddlerDef{}, nil, false
	}
	var shops []inv.Shopfront
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.Owner == self && sh.ServesCell(a.Level, inv.Cell{X: a.Position.X, Y: a.Position.Y}) {
			shops = append(shops, sh)
		}
	}
	return peddlerDef{}, shops, len(shops) > 0
}

// talkAtCounter: the hero stands where he can buy from the person (the customer's cell of his stall, a peddler's reach).
func (r *Runtime) talkAtCounter(self string) bool {
	p, shops, trades := r.talkSeller(self)
	if !trades {
		return false
	}
	if p.Actor != "" {
		return r.peddlerHeroNear(p)
	}
	for _, sh := range shops {
		if r.inventoryReach(inv.Location{Kind: "store", Store: sh.DisplayStore}) {
			return true
		}
	}
	return false
}

// talkWithin: the hero is within the conversation's reach of the person — or across his counter, where trade is done.
func (r *Runtime) talkWithin(self string, reach int) bool {
	return r.talkNear(self, reach) || r.talkNear(self, 24) && r.talkAtCounter(self)
}

// talkNear: the hero and the person stand on one level within the conversation's reach, both on their feet, no fight.
func (r *Runtime) talkNear(self string, reach int) bool {
	h, a := r.state.Life.Actor(playerActorID), r.state.Life.Actor(self)
	return h != nil && a != nil && h.OnFloor() && a.OnFloor() && !a.CombatHold && h.Level == a.Level && behavior.Distance(h.Position, a.Position) <= reach && !r.heroInCombat() && r.bodyCanSpeak(self)
}

// talkNews: a person with something to say — an interjection he has not said, or a question not yet asked of him.
func (r *Runtime) talkNews(conv, self string) bool {
	d := r.world.Conversations[conv]
	if d == nil {
		return false
	}
	key := talkKey(conv, self)
	t := r.state.Memory.Talks[key]
	probe := &talkState{}
	if t != nil {
		probe.dialogueSession = t.dialogueSession.clone()
		probe.Voiced = t.Voiced
	}
	if h, ok := r.state.Memory.Once[key]; ok {
		probe.Chosen, probe.Checks = h.Chosen, h.Checks
	}
	c := talkCtx{conv: d, key: key, self: self, t: probe}
	r.talkThings(c)
	if r.talkInterjection(c) != nil {
		return true
	}
	e := r.talkEntry(c)
	if e == nil {
		return false
	}
	probe.Entry = e.ID
	for _, o := range d.Nodes[e.Node].Options {
		if o.question() && !probe.chose(o.ID) && r.optionShown(c, o) {
			return true
		}
	}
	return false
}

// talkAvailable: the conversation a person would open now with the hero, by its owner (the encounter first).
func (r *Runtime) talkAvailable(person string) (string, bool) {
	if conv, ok := r.encounterTalkOf(person); ok {
		return conv, true
	}
	t, ok := r.talkOf(person)
	if !ok || !r.talkNear(person, 24) {
		return "", false
	}
	if t.Open == "news" && !r.talkNews(t.Conversation, person) {
		return "", false
	}
	return t.Conversation, true
}

// conversationCommand: the hero opens a talk with a person, or answers in the one open.
func (r *Runtime) conversationCommand(q *pb.PocLifeCommand) error {
	switch q.Action {
	case "conversation_open":
		conv, ok := r.talkAvailable(q.Destination)
		if !ok || !r.talkWithin(q.Destination, r.world.Conversations[conv].Reach) {
			return textError{Key: "error.encounter.unavailable"}
		}
		// the talk the hero stepped away from comes back as it was
		if key := talkKey(conv, q.Destination); r.state.Memory.Open == key {
			if t := r.state.Memory.Talks[key]; t != nil && t.Hidden && t.Until == 0 {
				t.Hidden = false
				return nil
			}
		}
		// an event talk on now (the custody, even stepped away from) is not left for another
		if c, on := r.talkOpenNow(); on && c.conv.Event {
			return textError{Key: "error.encounter.unavailable"}
		}
		return r.talkOpen(conv, q.Destination)
	case "conversation_leave":
		if r.state.Memory.Opening { return nil }
		// the hero closed the column: an ordinary talk ends, a talk that waits for its owner steps aside, last words go
		if c, ok := r.talkOpenNow(); ok && c.conv.Event && !c.afterDecision() {
			c.t.Hidden = true
			return nil
		}
		r.talkDrop()
		return nil
	case "conversation_choice", "encounter_choice":
		c, ok := r.talkOpenNow()
		if !ok || !r.talkAllowed(c) {
			return textError{Key: "error.encounter.unavailable"}
		}
		var finish func(string)
		if r.dev != nil { finish = r.devStep(c, q.Destination) }
		word, failed, err := r.talkChoose(q.Destination)
		if err != nil {
			if finish != nil { finish("refused") }
			return err
		}
		if word != "" {
			r.talkClosed(c, word, failed)
		}
		if finish != nil {
			outcome := "chosen"
			if failed { outcome = "failed" }
			finish(outcome)
		}
		return nil
	case "conversation_buy", "conversation_sell", "conversation_trade":
		c, ok := r.talkOpenNow()
		if !ok || !r.talkAllowed(c) || !c.t.Trade.On {
			return textError{Key: "error.encounter.unavailable"}
		}
		if r.dev == nil { return r.conversationTradeCommand(c, q) }
		finish := r.devStep(c, q.Destination)
		err := r.conversationTradeCommand(c, q)
		outcome := "chosen"
		if err != nil { outcome = "refused" }
		finish(outcome)
		return err
	}
	return textError{Key: "error.encounter.unavailable"}
}

func (r *Runtime) conversationTradeCommand(c talkCtx, q *pb.PocLifeCommand) error {
	if c.t.Trade.Screen { return r.tradeScreenCommand(c, q.Action, q.Destination) }
	if !r.talkSelfTrades(c.self) { return textError{Key: "error.encounter.unavailable"} }
	return r.talkTradeCommand(c, q.Action, q.Destination)
}

// talkAllowed: the open talk may go on — its owner still holds it (the encounter's phase and guard) and the hero stands
// within the conversation's reach.
func (r *Runtime) talkAllowed(c talkCtx) bool {
	if r.openingTalk(c) { return r.currentLevel() == r.world.Start.Level }
	if owned, ok := r.encounterTalkAllowed(c); owned {
		return ok
	}
	if c.conv.StageLevel != "" { return c.conv.StageLevel == r.currentLevel() }
	talk, available := r.talkOf(c.self)
	return available && talk.Conversation==c.conv.ID && r.talkWithin(c.self, c.conv.Reach)
}

// talkClosed hands the closing word to the conversation's owner (the encounter turns the custody's into an outcome).
func (r *Runtime) talkClosed(c talkCtx, word string, failed bool) {
	r.encounterTalkClosed(c.conv.ID, c.self, word, failed)
}

// memoryAfterFrame: topics from heard barks; the lingering log goes when its time is up; a talk whose owner or reach is
// gone ends without a word.
func (r *Runtime) memoryAfterFrame() {
	m := r.world.Memory
	if m == nil {
		return
	}
	r.storyTopicsFromBarks()
	key := r.state.Memory.Open
	t := r.state.Memory.Talks[key]
	switch {
	case key == "":
	case t == nil:
		r.state.Memory.Open = ""
	case t.Until > 0:
		if r.state.Tick >= t.Until {
			r.talkDrop()
		}
	default:
		if t.Staging {
			if c, ok := r.talkOpenNow(); ok && r.talkAllowed(c) { r.talkStageAfterFrame(c) }
		}
		// an ordinary talk ends when the hero walks away; an event talk (the custody) waits for its owner
		if c, ok := r.talkOpenNow(); !ok || (!c.conv.Event || c.afterDecision()) && !r.talkAllowed(c) {
			r.talkDrop()
		}
	}
}

// appendTalkTargets: the people of the hero's level who have something to say now (the world action «Talk»).
func (r *Runtime) appendTalkTargets(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView, locale string) {
	if hero == nil || !hero.OnFloor() || r.world.Memory == nil || r.heroInCombat() {
		return
	}
	if _, on := r.talkOpenNow(); on {
		return
	}
	people := []string{}
	if e := r.world.CalendarEncounter; e != nil {
		people = append(people, e.Actor)
	}
	others := false
	for _, t := range r.world.Memory.Talks {
		people = append(people, t.People...)
		others = others || t.Others
	}
	if others {
		// everyone on the hero's level, once each, in the world's own order
		listed := map[string]bool{playerActorID: true}
		for _, id := range people {
			listed[id] = true
		}
		for i := range r.state.Life.Actors {
			if a := &r.state.Life.Actors[i]; a.Level == hero.Level && !listed[a.ID] {
				people = append(people, a.ID)
			}
		}
	}
	for _, id := range people {
		a := r.state.Life.Actor(id)
		if a == nil || a.Level != hero.Level || !a.OnFloor() || !viewSees(perception, int32(a.Position.X), int32(a.Position.Y)) {
			continue
		}
		if _, ok := r.talkAvailable(id); ok {
			view.TalkTargets = append(view.TalkTargets, &pb.PocTalkTarget{Id: id, Name: r.craftingActorName(locale, id)})
		}
	}
}

// appendConversation: the talk on now (or its last words while they linger) as the conversation column shows it.
func (r *Runtime) appendConversation(msg *pb.PocGameState, locale string) {
	key := r.state.Memory.Open
	t := r.state.Memory.Talks[key]
	if key == "" || t == nil {
		return
	}
	conv, self, _ := strings.Cut(key, "|")
	d := r.world.Conversations[conv]
	if d == nil {
		return
	}
	c := talkCtx{conv: d, key: key, self: self, t: t}
	// a talk its owner does not hold now (the guard stepped away), or one the hero stepped away from, is not shown; it is kept
	if t.Until == 0 && (t.Hidden || !r.talkAllowed(c)) {
		return
	}
	speaker, text, nameKey := self, "", ""
	for _, l := range t.Lines {
		if l.Kind == "line" {
			speaker, text, nameKey = l.Speaker, r.dialogueEntryText(locale, l), l.NameKey
		}
	}
	v := &pb.PocConversation{Required: r.openingTalk(c), Kind: "talk", Id: fmt.Sprintf("%s#%d", key, t.Serial), Speaker: speaker, Text: text, Lines: r.dialogueLog(locale, t.dialogueSession)}
	if t.Until > 0 {
		v.Kind, v.Leave = "reply", true
	} else if t.Trade.On && t.Trade.Screen {
		v.Trade = &pb.PocConversationTrade{Screen: r.tradeScreen(c, locale)}
	} else if t.Trade.On && r.talkSelfTrades(self) {
		r.appendTalkTrade(v, c, locale)
	} else if n := d.Nodes[t.Node]; n != nil && !t.Staging {
		for _, o := range n.Options {
			if !r.optionShown(c, o) {
				continue
			}
			choice := r.dialogueChoice(locale, t.dialogueSession, o.ID, r.lineText(c, o.Text, o.Variants), o.Check)
			if o.KeepUsedCheck {
				_, choice.Locked = t.Checks[o.ID]
			}
			choice.Action = "conversation_choice"
			v.Choices = append(v.Choices, choice)
			if len(v.Choices) == dialogueAnswerLimit { break }
		}
	}
	if v.Required {
		for _, at := range r.world.Start.Marks {
			v.StageMarks = append(v.StageMarks, &pb.PocStoryStageMark{X: int32(at.X), Y: int32(at.Y)})
		}
	}
	v.SpeakerName = r.craftingActorName(locale, v.Speaker)
	if nameKey != "" { v.SpeakerName = r.dialogueText(locale, nameKey) }
	v.Skin = barkCatalog.Castes[v.Speaker]
	if v.Skin != "copper" && v.Skin != "silver" && v.Skin != "gold" {
		v.Skin = "copper"
	}
	v.CasteName = r.localText(locale, "ui.caste."+v.Skin, "")
	v.SpeakerColour = r.dialogueCasteColour(v.Speaker)
	msg.Conversation = v
	if r.dev != nil {
		if msg.Developer == nil { r.appendDeveloper(msg) }
		r.appendDialogueDev(msg,c,v)
	}
}

// ---------------------------------------------------------------------------------------------------------------------
// Trade inside the talk (owner 21.11, design/dialogue/talk-trade-v1). The answer that asks for the person's goods keeps the
// talk open and lists them as numbered rows of the same column — no other window. A row buys one piece through the server
// paths that were there before (a peddler's tray: peddlerCommand; a stall: the ordinary inventory purchase), so prices
// and refusals are theirs; what came of it is a note in the talk's log. At most world.memory.trade.rows rows are shown:
// a longer list pages with «more» and «back»; the last row always goes back to the talk.

// talkGoods: what the person shows now (or what he would take from the hero), from the same lists as his own screen.
type talkGoods struct {
	rows    []*pb.PocVendingOffer
	message string // why there is nothing to pick: a text key (closed, too far, empty)
	buys    bool   // the person also buys from the hero
	cash    string
}

func (r *Runtime) talkGoods(locale, self string, sell bool) talkGoods {
	k := r.world.Memory.Trade
	p, shops, trades := r.talkSeller(self)
	out := talkGoods{}
	if !trades {
		out.message = k.Closed
		return out
	}
	if p.Actor != "" {
		out.buys = p.Buys != nil
		if !r.peddlerHeroNear(p) {
			out.message = k.Away
			return out
		}
		offers, buyback, cash := r.peddlerOffers(locale, p)
		out.cash = cash
		if sell && out.buys {
			if out.rows = buyback; len(out.rows) == 0 {
				out.message = k.Nothing
			}
		} else if out.rows = offers; len(out.rows) == 0 {
			out.message = k.Empty
		}
		return out
	}
	for _, shop := range shops {
		switch {
		case !r.storefrontOpen(shop.ID):
			out.message = k.Closed
		case !r.inventoryReach(inv.Location{Kind: "store", Store: shop.DisplayStore}):
			out.message = k.Away
		default:
			out.rows = append(out.rows, r.storefrontOffers(locale, shop)...)
		}
	}
	if len(out.rows) > 0 {
		out.message = ""
	} else if out.message == "" {
		out.message = k.Empty
	}
	return out
}

// storefrontOffers: what a stall shows for sale now, with the price and whether the hero can pay — one list for the
// stall's own screen and for the trade inside a talk.
func (r *Runtime) storefrontOffers(locale string, shop inv.Shopfront) []*pb.PocVendingOffer {
	var out []*pb.PocVendingOffer
	for _, id := range sortedCraftingItems(r.state.Inventory) {
		item := r.state.Inventory.Items[id]
		if item.Hidden || !item.ForSale || item.Quantity < 1 || item.Location.Kind != "store" || item.Location.Store != shop.DisplayStore {
			continue
		}
		definition := r.world.Inventory.Definitions[item.Definition]
		price, err := inv.Quote(definition, 1)
		if err != nil {
			continue
		}
		from, _, ok := r.tradeAccounts(item.Owner, definition.PriceUnit)
		scale := r.world.Inventory.Currencies[definition.PriceUnit].Scale
		o := &pb.PocVendingOffer{
			ItemId:     item.ID,
			Name:       r.localText(locale, definition.Name, definition.Name),
			Quantity:   item.Quantity,
			Revision:   item.Revision,
			Definition: item.Definition,
			Price:      inv.FormatMoney(price, scale),
			PriceText:  r.talkMoney(locale, inv.FormatMoney(price, scale), definition.PriceUnit),
			Ok:         ok && from.Balance >= price,
		}
		if !o.Ok {
			o.Reason = r.localText(locale, "ui.peddler.refused.funds", "ui.peddler.refused.funds")
		}
		out = append(out, o)
	}
	return out
}

// talkMoney: an amount with its currency as the screens write it (ui.screen.money, the locale's decimal separator).
func (r *Runtime) talkMoney(locale, amount, currency string) string {
	text := r.localText(locale, "ui.screen.money", "{amount} {currency}")
	amount = strings.ReplaceAll(amount, ".", r.localText(locale, "ui.format.decimal_separator", "."))
	return strings.NewReplacer("{amount}", amount, "{currency}", currency).Replace(text)
}

// talkTradePages: how the rows page — goods per page, pages, and the page shown (within range).
func (r *Runtime) talkTradePages(c talkCtx, g talkGoods) (per, pages, page int) {
	rows := r.world.Memory.Trade.Rows
	if rows < 5 {
		rows = 9
	}
	// the last row goes back to the talk; a person who also buys has a row to turn the list over
	nav := 1
	if g.buys {
		nav++
	}
	per, pages = rows-nav, 1
	if len(g.rows) > per {
		// «more» and «back» keep their rows on every page, so a number never moves under the finger
		per = rows - nav - 2
		pages = (len(g.rows) + per - 1) / per
	}
	page = min(max(c.t.Trade.Page, 0), pages-1)
	return per, pages, page
}

// appendTalkTrade: the goods as the column's numbered rows, the hero's money and load above them.
func (r *Runtime) appendTalkTrade(v *pb.PocConversation, c talkCtx, locale string) {
	k := r.world.Memory.Trade
	g := r.talkGoods(locale, c.self, c.t.Trade.Sell)
	sell := c.t.Trade.Sell && g.buys
	per, pages, page := r.talkTradePages(c, g)
	text := func(key string) string { return r.localText(locale, key, key) }
	decimal := r.localText(locale, "ui.format.decimal_separator", ".")
	trade := &pb.PocConversationTrade{Mode: "buy", Page: int32(page + 1), Pages: int32(pages)}
	if sell {
		trade.Mode = "sell"
	}
	if g.message != "" {
		trade.Message = text(g.message)
	}
	scale := r.world.Inventory.Currencies["CRD"].Scale
	if hero, ok := r.peddlerAccount(playerActorID); ok {
		trade.Summary = append(trade.Summary, strings.ReplaceAll(text(k.Balance), "{crd}", strings.ReplaceAll(inv.FormatMoney(hero.Balance, scale), ".", decimal)))
	}
	if sell && g.cash != "" {
		trade.Summary = append(trade.Summary, strings.ReplaceAll(text(k.Cash), "{crd}", strings.ReplaceAll(g.cash, ".", decimal)))
	}
	m := r.inventoryModelFor(r.state.Life.Enabled)
	if load, err := r.state.Inventory.ActorLoad(m, playerActorID); err == nil {
		kg := func(grams int64) string { return strings.ReplaceAll(fmt.Sprintf("%.2f", float64(grams)/1000), ".", decimal) }
		trade.Summary = append(trade.Summary, strings.NewReplacer("{mass}", kg(load.Mass), "{capacity}", kg(m.Stores[inv.ActorStore(playerActorID)].Capacity.Mass)).Replace(text(k.Load)))
	}
	v.Trade = trade
	action := "conversation_buy"
	if sell {
		action = "conversation_sell"
	}
	from, to := min(page*per, len(g.rows)), min(page*per+per, len(g.rows))
	for _, o := range g.rows[from:to] {
		item := r.state.Inventory.Items[o.ItemId]
		d := r.world.Inventory.Definitions[item.Definition]
		row := &pb.PocConversationChoice{Id: o.ItemId, Action: action, Kind: "good", Text: o.Name, PriceText: o.PriceText, Unavailable: !o.Ok}
		if row.PriceText == "" {
			row.PriceText = r.talkMoney(locale, o.Price, "CRD")
		}
		row.Stock = strings.ReplaceAll(text(k.Count), "{n}", fmt.Sprint(o.Quantity))
		// what the server knows of the piece: why it cannot be had, its grade, its weight
		detail := []string{}
		if !o.Ok && o.Reason != "" {
			detail = append(detail, o.Reason)
		}
		if grade := r.peddlerGradeText(locale, item); grade != "" && !sell {
			detail = append(detail, grade)
		}
		detail = append(detail, strings.ReplaceAll(text(k.Mass), "{g}", fmt.Sprint(d.Mass)))
		row.Detail = strings.Join(detail, " · ")
		v.Choices = append(v.Choices, row)
	}
	nav := func(id, key string) {
		v.Choices = append(v.Choices, &pb.PocConversationChoice{Id: id, Action: "conversation_trade", Kind: id, Text: text(key)})
	}
	if page < pages-1 {
		nav("more", k.More)
	}
	if page > 0 {
		nav("prev", k.Prev)
	}
	if g.buys {
		if sell {
			nav("buy", k.Buy)
		} else {
			nav("sell", k.Sell)
		}
	}
	nav("done", k.Done)
}

// talkTradeNote: what came of a deal, as a note in the talk's log (the server's wording, with the piece and the price).
func (r *Runtime) talkTradeNote(c talkCtx, key, definition string, minor int64, ok bool) {
	r.dialogueSay(&c.t.dialogueSession, dialogueEntry{Kind: "note", Text: key, Item: definition, Minor: minor, Success: ok})
}

// talkTradeCommand: a row of the goods — turn the page, turn the list over, go back to the talk, or one piece bought or
// sold through the server's own trade.
func (r *Runtime) talkTradeCommand(c talkCtx, action, id string) error {
	k := r.world.Memory.Trade
	g := r.talkGoods("", c.self, c.t.Trade.Sell)
	if action == "conversation_trade" {
		_, pages, page := r.talkTradePages(c, g)
		switch id {
		case "more":
			c.t.Trade.Page = min(page+1, pages-1)
		case "prev":
			c.t.Trade.Page = max(page-1, 0)
		case "sell", "buy":
			if !g.buys {
				return textError{Key: "error.encounter.condition"}
			}
			c.t.Trade.Sell, c.t.Trade.Page = id == "sell", 0
		case "done":
			c.t.Trade = talkTrade{}
		default:
			return textError{Key: "error.encounter.unavailable"}
		}
		return nil
	}
	sell := c.t.Trade.Sell && g.buys
	if sell != (action == "conversation_sell") {
		return textError{Key: "error.encounter.condition"}
	}
	listed := false
	for _, o := range g.rows {
		listed = listed || o.ItemId == id
	}
	item, found := r.state.Inventory.Items[id]
	if !listed || !found {
		r.talkTradeNote(c, k.Gone, "", 0, false)
		return nil
	}
	result := r.talkDeal(c.self, item, sell)
	r.talkTradeNote(c, result.key, result.definition, result.minor, result.ok)
	return nil
}

type talkDealResult struct {
	key, definition string
	minor int64
	ok bool
}

// talkDeal is the ordinary single-piece command used by both trade presentations.
func (r *Runtime) talkDeal(self string, item inv.Item, sell bool) talkDealResult {
    k := r.world.Memory.Trade
	q := &pb.PocInventoryCommand{Epoch: r.state.Epoch, Action: "buy", ItemId: item.ID, Quantity: 1, ExpectedRevision: item.Revision, Sequence: r.state.Inventory.Cursors[playerActorID].Sequence + 1}
	p, _, _ := r.talkSeller(self)
	if sell {
		q.Action, q.StoreId = "sell", p.Tray
	} else if item.Location.Kind == "store" {
		q.StoreId = item.Location.Store
	}
	tag, err := inventoryTag(q)
	if err != nil {
		return talkDealResult{key: k.Failed}
	}
	if p.Actor != "" {
		result := &pb.PocInventoryResult{}
		if !r.peddlerCommand(nil, q, tag, result) {
			return talkDealResult{key: k.Failed}
		}
		h := r.state.Peddlers.Hero[p.Actor]
		return talkDealResult{key: h.Key, definition: h.Item, minor: h.Minor, ok: result.Ok}
	}
	d := r.world.Inventory.Definitions[item.Definition]
	price, _ := inv.Quote(d, 1)
	from, _, has := r.tradeAccounts(item.Owner, d.PriceUnit)
	if _, err := r.executeActorAction(inv.Action{Actor: playerActorID, Kind: "buy", Item: item.ID, Store: q.StoreId, Quantity: 1, ExpectedRevision: item.Revision, Sequence: q.Sequence, RequestTag: tag}); err != nil {
		key := k.Failed
        if !has || from.Balance < price {
            key = k.Short
        }
        return talkDealResult{key: key, definition: item.Definition}
	}
	return talkDealResult{key: k.Bought, definition: item.Definition, minor: price, ok: true}
}

// sanitizeMemory: a saved memory keeps only what the content still has (a fact, topic, person, conversation, answer,
// voice or node that is gone is dropped); an older save gets the facts its calendar encounter already settled.
func (r *Runtime) sanitizeMemory(s *state) {
	m := r.world.Memory
	if m == nil {
        r.sanitizeStoryBarks(s)
		s.Memory = memoryState{}
		return
	}
	r.migrateStoryPlacements(s)
	people := map[string]bool{}
	for _, a := range s.Life.Actors {
		people[a.ID] = true
	}
	for id, f := range s.Memory.Facts {
		if m.Facts[id] == nil {
			delete(s.Memory.Facts, id)
			continue
		}
		keep := f.Witnesses[:0]
		for _, w := range f.Witnesses {
			if people[w] {
				keep = append(keep, w)
			}
		}
		f.Witnesses = keep
		for k, values := range f.Args {
			keep := values[:0]
			for _, v := range values {
				if memoryIn(m.Facts[id].Args[k], v) && !memoryIn(keep, v) {
					keep = append(keep, v)
				}
			}
			if len(keep) == 0 {
				delete(f.Args, k)
			} else {
				sort.Strings(keep)
				f.Args[k] = keep
			}
		}
		s.Memory.Facts[id] = f
	}
	for id := range s.Memory.Topics {
		if m.Topics[id] == nil {
			delete(s.Memory.Topics, id)
		}
	}
	for id := range s.Memory.Said {
		person, fact, _ := strings.Cut(id, "|")
		if !people[person] || m.Facts[fact] == nil {
			delete(s.Memory.Said, id)
		}
	}
	if s.Memory.Migrated < memoryMigrationVersion {
		for key, t := range s.Memory.Talks {
			s.Memory.rememberTalk(key, t)
		}
	}
	resetFlows := map[string]bool{}
	for key, h := range s.Memory.Once {
		conv, self, _ := strings.Cut(key, "|")
		d := r.world.Conversations[conv]
		if d == nil || !people[self] {
			delete(s.Memory.Once, key)
			continue
		}
		options := map[string]bool{}
		for _, n := range d.Nodes {
			for _, o := range n.Options {
				options[o.ID] = true
			}
		}
		keep := h.Chosen[:0]
		for _, id := range h.Chosen {
			if options[id] && !memoryIn(keep, id) {
				keep = append(keep, id)
			} else if !options[id] {
				resetFlows[key] = true
			}
		}
		h.Chosen = keep
		for id := range h.Checks {
			if !options[id] {
				delete(h.Checks, id)
				resetFlows[key] = true
			}
		}
		if len(h.Chosen)+len(h.Checks) == 0 {
			delete(s.Memory.Once, key)
		} else {
			s.Memory.Once[key] = h
		}
	}
	for key, t := range s.Memory.Talks {
		conv, self, _ := strings.Cut(key, "|")
		d := r.world.Conversations[conv]
		if d == nil || !people[self] || t == nil {
			delete(s.Memory.Talks, key)
			continue
		}
		options, nodes, voices := map[string]bool{}, map[string]bool{}, map[string]bool{}
		for id, n := range d.Nodes {
			nodes[id] = true
			for _, o := range n.Options {
				options[o.ID] = true
			}
			for _, v := range n.Voices {
				voices[v.ID] = true
			}
		}
		speakers := map[string]bool{self: true}
		for sp := range d.NamedSpeakers { speakers[sp] = true }
		for _, sp := range d.Speakers {
			speakers[sp] = true
		}
		invalid := resetFlows[key] || r.validateDialogueSession(t.dialogueSession, options, nodes, speakers) != nil || t.Node != "" && !nodes[t.Node]
		t.Chosen, t.Checks = nil, nil
		if h, ok := s.Memory.Once[key]; ok {
			t.Chosen, t.Checks = h.Chosen, h.Checks
		}
		if invalid {
			// The log names removed content: reset its flow; the independent once ledger survives.
			if key == s.Memory.Open {
				s.Memory.Open = ""
			}
			delete(s.Memory.Talks, key)
			continue
		}
		keep := t.Voiced[:0]
		for _, v := range t.Voiced {
			if voices[v] {
				keep = append(keep, v)
			}
		}
		t.Voiced = keep
	}
	if s.Memory.Talks[s.Memory.Open] == nil {
		s.Memory.Open = ""
	}
	r.migrateEncounterMemory(s)
	r.sanitizeStory(s, people)
	r.sanitizeStoryBarks(s)
}

// validateMemorySave: times within the game's clock and sizes within the content.
func (r *Runtime) validateMemorySave(s state) error {
	if s.Memory.Opening {
		d := r.world.Start
		if d == nil { return errors.New("saved story opening has no definition") }
		hero := s.Life.Actor(playerActorID)
		t := s.Memory.Talks[s.Memory.Open]
		if !s.Memory.OpeningPlayed || hero == nil || hero.Level != d.Level || t == nil ||
			s.Memory.Open != talkKey(d.Conversation, d.Speaker) || t.Hidden || t.Until != 0 {
			return errors.New("invalid saved story opening")
		}
	}
	if err := r.validateStoryProgress(s); err != nil {
		return err
	}
	if r.world.Memory == nil {
		return nil
	}
	now := s.Life.Seconds
	for id, f := range s.Memory.Facts {
		if f.First < 0 || f.Second < f.First || f.Second > now || f.Count < 1 || len(f.Witnesses) > len(s.Life.Actors) {
			return fmt.Errorf("saved memory: invalid fact %s", id)
		}
	}
	for id, at := range s.Memory.Topics {
		if at < 0 || at > now {
			return fmt.Errorf("saved memory: invalid topic %s", id)
		}
	}
	for id, at := range s.Memory.Said {
		if at < 0 || at > now {
			return fmt.Errorf("saved memory: invalid interjection %s", id)
		}
	}
	for key, t := range s.Memory.Talks {
		if t.Opened < 0 || t.Opened > now || t.Serial < 0 || t.Serial > s.Memory.Serial || t.Ticks < 0 || t.Until < 0 || t.Trade.Page < 0 || t.Trade.Page > 4096 {
			return fmt.Errorf("saved memory: invalid talk %s", key)
		}
	}
	for key, h := range s.Memory.Once {
		conv, _, _ := strings.Cut(key, "|")
		options := map[string]bool{}
		for _, n := range r.world.Conversations[conv].Nodes {
			for _, o := range n.Options {
				options[o.ID] = true
			}
		}
		if err := r.validateDialogueSession(dialogueSession{Chosen: h.Chosen, Checks: h.Checks}, options, nil, nil); err != nil {
			return err
		}
	}
	if s.Memory.Migrated < 0 || s.Memory.Migrated > memoryMigrationVersion {
		return errors.New("saved memory: invalid migration version")
	}
	if len(s.Memory.Once) > 4096 {
		return errors.New("saved memory: too many once histories")
	}
	if len(s.Memory.Talks) > 4096 || len(s.Memory.Said) > 4096 {
		return errors.New("saved memory: too large")
	}
	return r.validateStory(s)
}
