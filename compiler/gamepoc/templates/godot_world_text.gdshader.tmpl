// Generated by ANG. Atlas distances and per-glyph data are linear, not colour textures.
shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, shadows_disabled;
uniform sampler2D atlas : filter_linear_mipmap_anisotropic, repeat_disable;
uniform sampler2D glyph_data : filter_nearest, repeat_disable;
uniform sampler2D surface_poses : filter_nearest, repeat_disable;
uniform bool surface_mesh = false;
uniform int style = 0;
uniform bool debug_coverage = false;
uniform float deformation_times[64];
#include "world_text_deformation.gdshaderinc"
// the see-through circle around the hero (owner 16.11; client-godot/shaders/see_through.gdshaderinc): letters in front of
// him dissolve with the thing they are painted on
#include "res://shaders/see_through.gdshaderinc"
varying vec2 slot_mm;
varying vec4 params;
varying vec4 ink;
void vertex() {
 int row=surface_mesh?int(UV2.x+0.5):int(INSTANCE_CUSTOM.r+0.5);
 vec4 rect=texelFetch(glyph_data,ivec2(0,row),0);
 vec4 q=texelFetch(glyph_data,ivec2(1,row),0);
 params=texelFetch(glyph_data,ivec2(2,row),0);
 ink=texelFetch(glyph_data,ivec2(3,row),0);
 if(surface_mesh) {
  int node=int(texelFetch(glyph_data,ivec2(4,row),0).x+0.5);
  vec4 origin=texelFetch(surface_poses,ivec2(0,node),0);
  mat3 basis=mat3(texelFetch(surface_poses,ivec2(1,node),0).xyz,texelFetch(surface_poses,ivec2(2,node),0).xyz,texelFetch(surface_poses,ivec2(3,node),0).xyz);
  vec4 point=texelFetch(glyph_data,ivec2(6,row),0);
  // cloth v2: x the deformation source (its clock, -1: none), y the hinge height, z the length, w the clamp; the drift
  // (radians, period) in column 7; the swing (hinge angle, bend) and the swing direction of the node in the poses.
  vec4 deform=texelFetch(glyph_data,ivec2(5,row),0);
  vec3 offset=vec3(0.0);
  vec3 axis=vec3(0.0,0.0,1.0);
  float turn=0.0;
  if(deform.x>=0.0) {
   vec2 drift=texelFetch(glyph_data,ivec2(7,row),0).xy;
   vec4 swing=texelFetch(surface_poses,ivec2(4,node),0);
   axis=texelFetch(surface_poses,ivec2(5,node),0).xyz;
   float time=deformation_times[int(deform.x+0.5)];
   vec3 weights=texelFetch(glyph_data,ivec2(24,row),0).xyz;
   vec3 surface=vec3(0.0);
   for(int j=0;j<3;j++) {
    vec3 p=texelFetch(glyph_data,ivec2(18+j,row),0).xyz;
    surface+=weights[j]*p;
    offset+=weights[j]*ang_cloth_offset(p,axis,UV,0.0,point.w,time,swing,deform.yzw,drift,false);
    turn+=weights[j]*ang_cloth_angle(p,0.0,point.w,time,swing,deform.yzw,drift,false);
   }
   // the paint stands off the turned surface, not off its rest pose
   vec3 standoff=point.xyz-surface;
   offset+=ang_cloth_turn(standoff,axis,turn)-standoff;
  }
  VERTEX=basis*(point.xyz+offset)+origin.xyz;
  NORMAL=normalize(basis*ang_cloth_turn(texelFetch(glyph_data,ivec2(10,row),0).xyz,axis,turn));
  UV=rect.xy;
  slot_mm=q.xy;
  if(origin.w<0.5){VERTEX=origin.xyz;}
 } else {
  slot_mm=q.xy+vec2(UV.x,1.0-UV.y)*q.zw;
  UV=rect.xy+UV*rect.zw;
 }
}
float hash21(vec2 v) {vec2 p=fract(v*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}
float noise21(vec2 p) {vec2 i=floor(p),f=fract(p),w=f*f*(3.0-2.0*f);return mix(mix(hash21(i),hash21(i+vec2(1,0)),w.x),mix(hash21(i+vec2(0,1)),hash21(i+1.0),w.x),w.y);}
float fbm(vec2 v) {vec2 p=v;float s=0.0,a=0.5;for(int k=0;k<4;k++){s+=a*noise21(p);p=p*2.03+17.1;a*=0.5;}return s;}
void fragment() {
 // an opaque board's back shows no letters (owner 16.11: a half-island's sign read mirrored through the see-through circle);
 // clear PVC (surface 0) shows them from both sides, as the sheet does
 if(!FRONT_FACING&&params.y>0.5) discard;
 {float st_rim;float st_cut=st_zone((INV_VIEW_MATRIX*vec4(VERTEX,1.0)).xyz,INV_VIEW_MATRIX,st_rim);if(st_cut>st_bayer(FRAGCOORD.xy)) discard;}
 float d=texture(atlas,UV).r;
 float aa=max(fwidth(d),0.0001)*0.8;
 float wear=params.x,surface=params.y;
 vec2 p=slot_mm*0.001+params.z;
 float grain=noise21(p*220.0),patch=fbm(p*11.0),alpha=0.0;
 ALBEDO=ink.rgb;ROUGHNESS=0.9;
 if(style==0) {
  float edge=0.5+(grain-0.5)*0.07;
  float cov=smoothstep(edge-aa,edge+aa,d);
  float spray=smoothstep(edge-0.26,edge,d)*0.16*(0.5+0.5*noise21(p*60.0));
  float loss;
  if(surface<0.5){float crack=noise21(vec2(p.x*25.0,p.y*300.0));loss=smoothstep(0.60,0.80,patch)*0.85+smoothstep(0.80,0.90,crack)*0.9;}
  else if(surface<1.5){loss=smoothstep(0.56,0.74,patch)*0.95+smoothstep(0.9,0.97,grain)*0.5;}
  else{loss=smoothstep(0.50,0.85,patch*0.55+grain*0.45)*0.95;}
  loss=clamp(loss*clamp(wear*1.7,0.0,1.0),0.0,1.0);
  alpha=clamp(max(cov,spray)*(1.0-loss),0.0,1.0);
 } else if(style==1) {
  float edge=0.5+(grain-0.5)*0.14;
  float cov=smoothstep(edge-aa*1.6,edge+aa*1.6,d);
  float streak=noise21(vec2(p.x*6.0,p.y*80.0));
  float fill=mix(0.5,1.0,smoothstep(0.2,0.75,grain))*(1.0-0.5*smoothstep(0.5,0.8,streak)*clamp(wear*2.0,0.0,1.0));
  float haze=smoothstep(edge-0.3,edge,d)*0.10*clamp(wear*3.0,0.0,1.0);
  alpha=clamp(max(cov*fill,haze),0.0,1.0);
 } else {
  vec2 cell=fract(slot_mm/max(params.w,1.0))-0.5;
  float dot_mask=1.0-smoothstep(0.30,0.46,length(cell));
  float cov=smoothstep(0.5-aa,0.5+aa,d);
  float halo=smoothstep(0.22,0.5,d)*0.35;
  EMISSION=ink.rgb*(1.0+2.4*cov*dot_mask);
  ALBEDO=vec3(0.0);
  alpha=clamp(max(cov*mix(0.35,1.0,dot_mask),halo),0.0,1.0);
 }
 ALPHA=alpha*ink.a;
 if(debug_coverage){ALBEDO=vec3(1,0,1);EMISSION=vec3(1,0,1);ALPHA=0.8;}
}
