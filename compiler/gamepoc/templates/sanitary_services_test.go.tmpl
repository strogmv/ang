// Exercise the actual publication path and canonical compiled translations, not
// a client key lookup. Another occupant cannot populate the hero's status text.
func TestSanitaryHeroPhaseTextLocalizedAndPrivate(t *testing.T) {
	r, u := sanitaryFixture(t, "shower")
	hero := r.state.Life.Actor(playerActorID)
	npcID := "char.market_granny"
	private := r.world.SanitaryServices.Units[0]
	r.state.Sanitary.Users = map[string]sanitaryUser{}
	r.state.Sanitary.Users[npcID] = sanitaryUser{ActorID: npcID, UnitID: private.ID, Phase: "using"}
	type view struct {
		HeroPhase     string             `json:"hero_phase"`
		HeroPhaseText string             `json:"hero_phase_text"`
		Units         []sanitaryUnitView `json:"units"`
	}
	publish := func(locale string) view {
		t.Helper()
		msg := &pb.PocGameState{Life: &pb.PocLifeView{}, SceneAgents: []*pb.PocAgentState{{Id: npcID}}}
		r.appendSanitaryServices(msg, hero, locale)
		if len(msg.SceneAgents) != 0 || strings.Contains(msg.Life.SanitaryServicesJson, npcID) {
			t.Fatal("private NPC identity escaped publication")
		}
		var v view
		if err := json.Unmarshal([]byte(msg.Life.SanitaryServicesJson), &v); err != nil {
			t.Fatal(err)
		}
		return v
	}
	for _, tt := range []struct{ phase, ru, en string }{
		{"queued", "Очередь", "Queued"}, {"approach", "Подход", "Approaching"}, {"opening", "Открытие двери", "Opening door"},
		{"entry", "Вход", "Entering"}, {"sealing", "Закрытие двери", "Closing door"}, {"using", "Занято", "In use"},
		{"opening_exit", "Открытие для выхода", "Opening for exit"}, {"exit", "Выход", "Exiting"}, {"closing", "Закрытие двери", "Closing door"},
	} {
		r.state.Sanitary.Users[playerActorID] = sanitaryUser{ActorID: playerActorID, UnitID: u.ID, Phase: tt.phase}
		for locale, want := range map[string]string{"ru": tt.ru, "en": tt.en} {
			v := publish(locale)
			if v.HeroPhase != tt.phase || v.HeroPhaseText != want || strings.HasPrefix(v.HeroPhaseText, "sanitary.") {
				t.Fatalf("%s/%s got %q, want %q", locale, tt.phase, v.HeroPhaseText, want)
			}
		}
	}
	delete(r.state.Sanitary.Users, playerActorID)
	for _, locale := range []string{"ru", "en"} {
		v := publish(locale)
		if v.HeroPhase != "" || v.HeroPhaseText != "" {
			t.Fatalf("NPC phase leaked into hero status: %+v", v)
		}
	}
	for locale, expected := range map[string][2]string{"ru": {"Отменить", "Завершить"}, "en": {"Cancel", "Finish"}} {
		if r.localText(locale, "ui.sanitary.cancel", "") != expected[0] || r.localText(locale, "ui.sanitary.finish", "") != expected[1] {
			t.Fatalf("short action labels missing in %s", locale)
		}
	}
}

func TestSanitaryDutyBreakSurvivesServiceSaveAndPhysicalReturn(t *testing.T) {
	r, u := sanitaryFixture(t, "basin")
	r.state.Life.SecondsPerTick = 1
	id := "char.market_resident_09"
	a := r.state.Life.Actor(id)
	hero := r.state.Life.Actor(playerActorID)
	hero.Position = behavior.Cell{X: 12, Y: 44}
	hero.Goal = hero.Position
	hero.Body = nil
	r.syncLifeHero()
	post := behavior.LifeStep{}
	for _, step := range r.world.Life.Person(id).Steps {
		if step.Level == u.LevelID && step.Activity == "service" {
			post = step
			break
		}
	}
	if post.Level == "" {
		t.Fatal("missing authored shop post")
	}
	a.Level = u.LevelID
	a.Position = behavior.Cell{X: 11, Y: 43}
	a.Goal = a.Position
	a.Path = nil
	a.PendingPath = nil
	a.Trip = nil
	a.ResidenceID = ""
	a.Body = nil
	a.Manual = false
	a.CombatHold = false
	a.RoutineOverride = &post
	a.Brain.AdvanceServiceNeeds(r.world.Life.Brain, id, r.state.Life.Seconds, r.state.Seed, 0)
	a.Brain.Needs[2] = 800000
	a.Brain.BreakKind = "hygiene"
	a.Brain.BreakStarted = r.state.Life.Seconds
	a.Brain.BreakUntil = r.state.Life.Seconds + r.world.Life.Brain.HygieneSeconds
	a.Brain.BreakReturnAt = a.Brain.BreakUntil - 120
	a.Brain.BreakPost = post
	a.Brain.Returning = false
	a.Brain.HygieneAt = a.Brain.BreakStarted
	started, until, returnAt := a.Brain.BreakStarted, a.Brain.BreakUntil, a.Brain.BreakReturnAt
	if err := r.sanitaryRequest(id, u.ID); err != nil {
		t.Fatal(err)
	}
	if a.Brain.BreakKind != "hygiene" || a.Brain.Returning {
		t.Fatal("service erased the already authorized duty break")
	}
	forged := r.snapshotState()
	forged.Life.Actor(id).Brain.BreakReturnAt++
	if r.validateSanitary(forged) == nil {
		t.Fatal("forged duty return deadline accepted")
	}
	saved, used, released, returned := false, false, false, false
	for r.state.Life.Seconds <= until {
		r.state.Tick++
		if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
			t.Fatal(err)
		}
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
		a = r.state.Life.Actor(id)
		lease, held := r.state.Sanitary.Users[id]
		if held {
			if a.Brain.BreakKind != "hygiene" || a.Brain.BreakStarted != started || a.Brain.BreakUntil != until || a.Brain.BreakReturnAt != returnAt || a.Brain.BreakPost != post {
				t.Fatal("service rewrote the duty budget/post")
			}
			if !r.state.Inventory.Shopfronts["tenant09"].Break {
				t.Fatal("real service is misclassified as unplanned shop closure")
			}
			used = used || lease.UseElapsed == u.ServiceSeconds && lease.WaterML == u.WaterML
			if lease.Phase == "using" && !saved {
				slot := r.world.Config.SaveSlots[0]
				if err := r.writeSave(slot, r.snapshotState()); err != nil {
					t.Fatal(err)
				}
				loaded, _, err := r.readSave(slot)
				if err != nil {
					t.Fatal(err)
				}
				r.state = loaded
				saved = true
			}
		} else {
			if !released {
				if a.Manual || a.CombatHold || a.ServiceAttachment != "" || a.Brain.BreakKind != "hygiene" || !a.Brain.Returning {
					t.Fatal("release lost the ordinary return-to-post obligation")
				}
				released = true
			}
			if a.Position == post.At && a.Arrived && len(a.Path) == 0 && !a.Manual && a.Brain.BreakKind == "" && r.state.Inventory.Shopfronts["tenant09"].Open {
				returned = true
				break
			}
		}
	}
	if !saved || !used || !released || !returned || r.state.Sanitary.Completed[u.ID] != 1 {
		t.Fatalf("incomplete actual duty break: saved=%v used=%v released=%v returned=%v now=%d at=%v post=%+v manual=%v break=%s returning=%v arrived=%v shop=%+v enabled=%v hold=%v goal=%+v last=%d", saved, used, released, returned, r.state.Life.Seconds, a.Position, post, a.Manual, a.Brain.BreakKind, a.Brain.Returning, a.Arrived, r.state.Inventory.Shopfronts["tenant09"], r.world.Life.Brain.Enabled, a.CombatHold, a.Brain.Goal, a.Brain.LastSecond)
	}
}
