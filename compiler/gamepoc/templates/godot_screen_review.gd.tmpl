# Generated by ANG. Native review uses captured authoritative states, never fixtures.
extends SceneTree
const C = preload("res://generated/game_contract.gd")
const Catalog = preload("res://generated/screens/catalog.gd")
var settings
var save_view
const Runtime = preload("res://generated/screens/runtime.gd")
var large_text := false
var reduced_motion := true
var native_proof := true
func _initialize() -> void:
	FileAccess.open(OS.get_environment("ANG_SCREEN_OUT").path_join("started.json"), FileAccess.WRITE).store_string(
		JSON.stringify({"pid":OS.get_process_id()}))
	root.unfocusable = true
	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_MOUSE_PASSTHROUGH, true)
	call_deferred("run")
func run() -> void:
	get_root().get_tree().create_timer(45).timeout.connect(func():
		push_error("screen review timed out")
		quit(2)
	)
	var input := JSON.parse_string(FileAccess.get_file_as_string(OS.get_environment("ANG_SCREEN_STATE"))) as Dictionary
	assert(input.has("game_state"), "review requires a captured server game_state envelope")
	var state := C.PocGameState.from_dict(input.game_state)
	var ground: Control = Catalog.widget(Catalog.specification().background)
	root.add_child(ground)
	ground.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	if ResourceLoader.exists("res://generated/settings.gd"):
		settings = load("res://generated/settings.gd").new()
	var screen := Runtime.new()
	root.add_child(screen)
	var report := {"screen":OS.get_environment("ANG_SCREEN_ID"), "state_tick":state.tick, "frames":[], "pass":true}
	for locale in ["ru", "en"]:
		TranslationServer.set_locale(locale)
		if locale == "en":
			var translated := JSON.parse_string(FileAccess.get_file_as_string(OS.get_environment(
				"ANG_SCREEN_STATE_EN"))) as Dictionary
			assert(translated.has("game_state"), "EN review requires a real localized server state")
			state = C.PocGameState.from_dict(translated.game_state)
		for large in [false, true]:
			large_text = large
			if settings != null:
				for entry in settings.specification().entries:
					if input.get("settings", {}).has(entry.id):
						settings.set_value(entry.id, input.settings[entry.id])
				settings.set_value("language", locale)
				settings.set_value("large_text", large)
			save_view = C.PocSaveSlots.from_dict(input.get("saves", {}))
			if is_instance_valid(screen.content):
				screen.remove_child(screen.content)
				screen.content.queue_free()
				screen.content = null
			screen.selected.clear()
			for entry in Catalog.specification().screens:
				if entry.id != report.screen or not entry.has("opening"):
					continue
				var trigger = Catalog.read(entry.opening.ref, state, null, {})
				assert(trigger != null and (not trigger is bool or trigger),
					"screen " + report.screen + \
						" opening: false server condition; provide contextual --state and --state-en")
			screen.present(report.screen, state, self)
			for i in range(8):
				await process_frame
			RenderingServer.force_draw.call_deferred(false)
			await RenderingServer.frame_post_draw
			var filename: String = locale+("-large" if large else "")+".png"
			var saved := root.get_texture().get_image().save_png(OS.get_environment(
				"ANG_SCREEN_OUT").path_join(filename))
			assert(saved == OK)
			var failures: Array[String] = []
			assert(Rect2(Vector2.ZERO, root.size).encloses(screen.content.get_global_rect()),
				"screen plate exceeds viewport")
			for label in screen.find_children("*", "Label", true, false):
				if label.is_visible_in_tree() and not label.text.is_empty():
					if label.get_theme_font_size("font_size")<12:
						failures.append("text below 12px: "+label.text)
					if label.get_line_count()>label.get_visible_line_count():
						failures.append("clipped text: "+label.text)
			failures.append_array(_guards(screen))
			_negative_guards(screen)
			assert(failures.is_empty(), str(failures))
			assert(not screen.rail.is_empty(), "screen has no reachable controls")
			for device in ["keyboard", "gamepad"]:
				screen.rail[0].grab_focus()
				for index in range(screen.rail.size()):
					assert(screen.rail[index].has_focus(), "unreachable control via "+device+": "+str(index))
					for pressed in [true, false]:
						var event: InputEvent
						if device == "keyboard":
							var key := InputEventKey.new()
							key.keycode = KEY_DOWN
							key.pressed = pressed
							event = key
						else:
							var pad := InputEventJoypadButton.new()
							pad.device = 7
							pad.button_index = JOY_BUTTON_DPAD_DOWN
							pad.pressed = pressed
							event = pad
						event.set_meta("bilibin_proof", true)
						Input.parse_input_event(event)
						await process_frame
			var scroll_checks := 0
			for target in screen.scroll_targets:
				if target.get_v_scroll_bar().max_value <= target.get_v_scroll_bar().page:
					continue
				target.scroll_vertical = 0
				var reachable := false
				for control in screen.rail:
					if target.is_ancestor_of(control):
						control.grab_focus()
						reachable = true
						break
				assert(reachable, "scrolling details have no reachable control")
				var page := InputEventKey.new()
				page.keycode = KEY_PAGEDOWN
				page.pressed = true
				page.set_meta("bilibin_proof", true)
				Input.parse_input_event(page)
				await process_frame
				assert(target.scroll_vertical>0, "keyboard cannot scroll long details")
				page.pressed = false
				Input.parse_input_event(page)
				target.scroll_vertical = 0
				var stick := InputEventJoypadMotion.new()
				stick.device = 7
				stick.axis = JOY_AXIS_RIGHT_Y
				stick.axis_value = 1.0
				stick.set_meta("bilibin_proof", true)
				Input.parse_input_event(stick)
				for i in range(8):
					await process_frame
				assert(target.scroll_vertical>0, "gamepad cannot scroll long details")
				stick.axis_value = 0
				Input.parse_input_event(stick)
				scroll_checks += 1
			report.frames.append({"locale":locale, "large":large, "png":filename, "failures":failures,
				"latency":
					screen.latency, "opening_latency":screen.opening_latency, "keyboard_reachable":screen.rail.size(), \
				"gamepad_reachable":
					screen.rail.size(), "detail_scroll_checks":scroll_checks, "geometry":_geometry_json(screen), \
						"negative_guards":
							true})
	FileAccess.open(OS.get_environment("ANG_SCREEN_OUT").path_join("native.json"), FileAccess.WRITE).store_string(
		JSON.stringify(report, "\t"))
	quit()
func screen_host_action(_command: String, _params: Dictionary, _runtime: Control) -> void:
	pass
func send(_command: C.ClientMessage) -> void:
	assert(false, "review must never send commands")

func _guards(screen: Control) -> Array[String]:
	return preload("res://generated/screens/checks.gd").inspect(screen)

func _negative_guards(screen: Control) -> void:
	var geometry: Dictionary = screen.chrome.guard_geometry()
	if geometry.is_empty():
		return
	var probe := Button.new()
	screen.content.add_child(probe)
	probe.size = Vector2(40, 24)
	probe.global_position = geometry.frame.position + Vector2(3, 3)
	probe.text = "probe"
	assert(_guards(screen).any(func(copy):
		return copy.begins_with("control overlaps corner")
	))
	assert(_guards(screen).any(func(copy):
		return copy.begins_with("control crosses inner")
	))
	probe.global_position = geometry.inner.get_center()
	for raw in ["slot1", "actor.char.test", "item.test", "ui.test"]:
		probe.text = raw
		assert(_guards(screen).any(func(copy):
			return copy.begins_with("raw id rendered")
		))
	screen.content.remove_child(probe)
	probe.queue_free()
	var painted := Control.new()
	painted.set_meta("guard_control", true)
	screen.content.add_child(painted)
	painted.size = Vector2(40, 24)
	painted.global_position = geometry.frame.position + Vector2(3, 3)
	assert(_guards(screen).any(func(copy):
		return copy.begins_with("control overlaps corner")
	))
	screen.content.remove_child(painted)
	painted.queue_free()
	for control in screen.rail:
		if control.has_meta("expected_ordinal"):
			var original: int = control.index
			control.index = original + 1
			assert(_guards(screen).any(func(copy):
				return copy.begins_with("row ordinal")
			))
			control.index = original
			break

func _geometry_json(screen: Control) -> Dictionary:
	var box: Rect2 = screen.content.get_global_rect()
	return {"frame": [box.position.x, box.position.y, box.size.x, box.size.y]}
