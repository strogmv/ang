func TestCombatExplosiveAIRejectsVisibleFriendlyAndAmbientBlastRisk(t *testing.T) {
	r, space := combatAdvancedRules(), combatFixtureSpace()
	a, b := combatBomber("a", "blue", Cell{1, 1}, 1), combatClub("b", "red", Cell{5, 1})
	a.Initiative = 30
	s := combatNewAdvanced(t, r, space, a, b)
	hasThrow := func(d CombatDecision) bool {
		for _, c := range d.Candidates {
			if c.Action.Type == "throw" {
				return true
			}
		}
		return false
	}
	if !hasThrow(s.Decide(space, r)) {
		t.Fatal("clear known hostile area had no legal explosive candidate")
	}
	space.VisibleBystanders = func(Combatant) []Cell { return []Cell{{5, 2}} }
	if hasThrow(s.Decide(space, r)) {
		t.Fatal("AI ignored a visible ambient civilian in the blast")
	}
	space.VisibleBystanders = nil
	ally := combatClub("friend", "blue", Cell{5, 2})
	s = combatNewAdvanced(t, r, space, a, b, ally)
	if hasThrow(s.Decide(space, r)) {
		t.Fatal("AI ignored a visible ally just because contacts contain only hostiles")
	}
}
