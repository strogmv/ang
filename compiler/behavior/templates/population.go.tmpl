// Code generated by ANG. Persistent scheduled population with local physical detail.
package behavior

import "fmt"

type PopulationModel struct {
	MaxActors       int               `json:"max_actors"`
	MaxActive       int               `json:"max_active"`
	MoveTicks       int64             `json:"move_ticks"`
	ColdStepSeconds int64             `json:"cold_step_seconds"`
	ShiftOffsets    []int64           `json:"shift_offsets"`
	Stages          []PopulationStage `json:"stages"`
	Anchors         map[string][]Cell `json:"anchors"`
}
type PopulationStage struct {
	ID       string `json:"id"`
	Level    string `json:"level"`
	Activity string `json:"activity"`
	AtSecond int64  `json:"at_second"`
}
type PopulationTrip struct {
	Edge      string `json:"edge"`
	Departure int64  `json:"departure"`
	Arrival   int64  `json:"arrival"`
}
type PopulationEnvironment struct {
	Occupied map[string]map[Cell]bool
	Trips    []LifeTrip
}

type PopulationActor struct {
 YieldUntil int64 `json:"yield_until,omitempty"`
	ID               string          `json:"id"`
	Name             string          `json:"name"`
	Level            string          `json:"level"`
	Position         Cell            `json:"position"`
	Goal             Cell            `json:"goal"`
	Path             []Cell          `json:"path"`
	MoveStartTick    int64           `json:"move_start_tick"`
	Stage            int             `json:"stage"`
	ShiftSeconds     int64           `json:"shift_seconds"`
	Trip             *PopulationTrip `json:"trip,omitempty"`
	WaitingDeparture int64           `json:"waiting_departure"`
	Materialized     bool            `json:"materialized"`
	Arrived          bool            `json:"arrived"`
	Queued           bool            `json:"queued"`
	QueueReason      string          `json:"queue_reason"`
	Activity         string          `json:"activity"`
	ColdReadyAt      int64           `json:"cold_ready_at"`
	Visits           map[string]int  `json:"visits"`
}
type PopulationState struct {
	Count       int               `json:"count"`
	Actors      []PopulationActor `json:"actors"`
	LastSeconds int64             `json:"last_seconds"`
	LastTick    int64             `json:"last_tick"`
	ActiveLevel string            `json:"active_level"`
	routes      *lifeRouteConnectivity
}

func (p PopulationModel) Validate(l LifeModel) error {
	if p.MaxActors == 0 && len(p.Stages) == 0 && len(p.Anchors) == 0 && len(p.ShiftOffsets) == 0 {
		return nil
	}
	if p.MaxActors < 1 || p.MaxActive < 1 || p.MaxActive > p.MaxActors || p.MoveTicks < 1 || p.ColdStepSeconds < 1 || len(p.Stages) == 0 || len(p.ShiftOffsets) == 0 {
		return fmt.Errorf("invalid population configuration")
	}
	shifts := map[int64]bool{}
	for _, offset := range p.ShiftOffsets {
		if offset < 0 || offset >= 86400 || shifts[offset] {
			return fmt.Errorf("invalid population shift")
		}
		shifts[offset] = true
	}
	ids := map[string]bool{}
	for i, stage := range p.Stages {
		if stage.ID == "" || ids[stage.ID] || stage.Activity == "" || stage.AtSecond < 0 || stage.AtSecond >= 86400 || (i == 0 && stage.AtSecond != 0) || (i > 0 && stage.AtSecond <= p.Stages[i-1].AtSecond) || len(p.Anchors[stage.Level]) == 0 {
			return fmt.Errorf("invalid population stage %s", stage.ID)
		}
		ids[stage.ID] = true
		next := p.Stages[(i+1)%len(p.Stages)]
		if stage.Level != next.Level && l.NextEdge(stage.Level, next.Level) == nil {
			return fmt.Errorf("unreachable population stage %s", stage.ID)
		}
	}
	for level, anchors := range p.Anchors {
		seen := map[Cell]bool{}
		if len(anchors) == 0 {
			return fmt.Errorf("empty population anchor list")
		}
		for _, at := range anchors {
			if !l.Walks(level, at) || seen[at] {
				return fmt.Errorf("invalid population anchor %s", level)
			}
			seen[at] = true
		}
	}
	return nil
}
func (p PopulationModel) stage(seconds, offset int64) int {
	day := (seconds%86400 + offset) % 86400
	stage := 0
	for i, v := range p.Stages {
		if v.AtSecond <= day {
			stage = i
		}
	}
	return stage
}
// CUE lists anchors in a stable geometric order. A contiguous prefix would pack
// a small population into one doorway while leaving most of the level empty.
// A coprime stride spreads that prefix and still visits every authored anchor
// exactly once before repeating, without random retries or new allocations.
func populationAnchorStride(count int) int {
 if count<2{return 1};step:=int(int64(count)*618033/1000000);if step<1{step=1}
 for {a,b:=step,count;for b!=0{a,b=b,a%b};if a==1{return step};step++}
}
func (p PopulationModel) anchor(index int, level string) Cell {
	anchors := p.Anchors[level]
	if len(anchors) == 0 {
		return Cell{}
	}
	return anchors[((index/len(p.ShiftOffsets))*populationAnchorStride(len(anchors)))%len(anchors)]
}
func (p PopulationModel) Start(l LifeModel, count int, seconds, tick int64) (PopulationState, error) {
	if err := p.Validate(l); err != nil {
		return PopulationState{}, err
	}
	if count < 0 || count > p.MaxActors || seconds < 0 || tick < 0 {
		return PopulationState{}, fmt.Errorf("invalid population start")
	}
	s := PopulationState{Count: count, LastSeconds: seconds, LastTick: tick}
	for i := 0; i < count; i++ {
		shift := p.ShiftOffsets[i%len(p.ShiftOffsets)]
		stage := p.stage(seconds, shift)
		cfg := p.Stages[stage]
		at := p.anchor(i, cfg.Level)
		s.Actors = append(s.Actors, PopulationActor{ID: fmt.Sprintf("population.%04d", i+1), Name: fmt.Sprintf("Житель %03d", i+1), Level: cfg.Level, Position: at, Goal: at, MoveStartTick: tick, Stage: stage, ShiftSeconds: shift, Arrived: true, Activity: cfg.Activity, ColdReadyAt: seconds, Visits: map[string]int{cfg.Level: 1}})
	}
	return s, nil
}
func (s PopulationState) Clone() PopulationState {
	out := s
	out.routes = nil
	out.Actors = append([]PopulationActor(nil), s.Actors...)
	for i := range out.Actors {
		a := &out.Actors[i]
		a.Path = append([]Cell(nil), a.Path...)
		if a.Trip != nil {
			trip := *a.Trip
			a.Trip = &trip
		}
		a.Visits = make(map[string]int, len(s.Actors[i].Visits))
		for level, count := range s.Actors[i].Visits {
			a.Visits[level] = count
		}
	}
	return out
}

// Only materialized actors occupy cells. Coarse residents have an abstract
// level/anchor, not hidden physical copies. Their first reserved step also
// blocks other movement kernels so two systems cannot claim the same cell.
func (s PopulationState) Occupied() map[string]map[Cell]bool {
	occupied := map[string]map[Cell]bool{}
	for _, a := range s.Actors {
		if !a.Materialized || a.Trip != nil {
			continue
		}
		if occupied[a.Level] == nil {
			occupied[a.Level] = map[Cell]bool{}
		}
		occupied[a.Level][a.Position] = true
		if len(a.Path) > 0 {
			occupied[a.Level][a.Path[0]] = true
		}
	}
	return occupied
}
func populationCellFree(l LifeModel, level string, at Cell, occupied map[string]map[Cell]string, id string) bool {
	return l.Walks(level, at) && (occupied[level][at] == "" || occupied[level][at] == id)
}
func populationReserve(occupied map[string]map[Cell]string, level string, at Cell, id string) {
	if occupied[level] == nil {
		occupied[level] = map[Cell]string{}
	}
	occupied[level][at] = id
}
func populationUnreserve(occupied map[string]map[Cell]string, level string, at Cell, id string) {
	if occupied[level][at] == id {
		delete(occupied[level], at)
	}
}
func populationLanding(l LifeModel, level string, entry Cell, occupied map[string]map[Cell]string, id string) (Cell, bool) {
	for _, at := range []Cell{entry, {entry.X + 1, entry.Y}, {entry.X, entry.Y + 1}, {entry.X - 1, entry.Y}, {entry.X, entry.Y - 1}} {
		if populationCellFree(l, level, at, occupied, id) {
			return at, true
		}
	}
	return Cell{}, false
}
func (p PopulationModel) freeAnchor(l LifeModel, level string, index int, occupied map[string]map[Cell]string, id string) (Cell, bool) {
	anchors := p.Anchors[level]
	step:=populationAnchorStride(len(anchors));first:=index/len(p.ShiftOffsets)
	for n := range anchors {
		at := anchors[((first+n)*step)%len(anchors)]
		if populationCellFree(l, level, at, occupied, id) {
			return at, true
		}
	}
	return Cell{}, false
}

// Advance keeps coarse identities alive without per-actor vision or offscreen
// pathfinding. environment.Trips includes base actors' current trips to share
// departure capacity. The host advances base actors against Occupied(), then
// calls this method with their resulting occupied cells and next-step reserves.
func (s *PopulationState) Advance(p PopulationModel, l LifeModel, seconds, tick int64, activeLevel string, environment PopulationEnvironment) error {
	if seconds < s.LastSeconds || tick < s.LastTick {
		return fmt.Errorf("population clock moved backwards")
	}
	if activeLevel != "" {
		if _, ok := l.Locations[activeLevel]; !ok {
			return fmt.Errorf("unknown population active level")
		}
	}
	if len(s.Actors) == 0 {
		s.LastSeconds, s.LastTick, s.ActiveLevel = seconds, tick, activeLevel
		return nil
	}
	sameFrame := seconds == s.LastSeconds && tick == s.LastTick && activeLevel == s.ActiveLevel
	if sameFrame {
		return nil
	}
	for _, a := range s.Actors {
		if a.Materialized && a.Level == activeLevel && a.Trip == nil {
			if environment.Occupied[a.Level][a.Position] || (len(a.Path) > 0 && environment.Occupied[a.Level][a.Path[0]]) {
				return fmt.Errorf("population external occupancy conflict")
			}
		}
	}
	levelChanged := activeLevel != s.ActiveLevel
	s.ActiveLevel = activeLevel
	s.LastSeconds, s.LastTick = seconds, tick
	scratch := LifeState{routes: s.routes}
	scratch.ensureLifeRoutes(l)
	s.routes = scratch.routes
	occupied := map[string]map[Cell]string{}
	for level, cells := range environment.Occupied {
		for at, blocked := range cells {
			if blocked {
				populationReserve(occupied, level, at, "external")
			}
		}
	}
	active := 0
	for i := range s.Actors {
		a := &s.Actors[i]
		if a.Materialized && (a.Level != activeLevel || a.Trip != nil) {
			a.Materialized = false
			a.Path = nil
			a.MoveStartTick = tick
		}
		if a.Materialized {
			active++
			populationReserve(occupied, a.Level, a.Position, a.ID)
			if len(a.Path) > 0 {
				populationReserve(occupied, a.Level, a.Path[0], a.ID)
			}
		}
	}
	type departure struct {
		edge string
		at   int64
	}
	seats := map[departure]int{}
	for _, trip := range environment.Trips {
		seats[departure{trip.Edge, trip.Departure}]++
	}
	for _, a := range s.Actors {
		if a.Trip != nil {
			seats[departure{a.Trip.Edge, a.Trip.Departure}]++
		}
	}
	for i := range s.Actors {
		a := &s.Actors[i]
		if !a.Materialized && a.Level != activeLevel && a.Trip == nil {
			a.Queued = false
			a.QueueReason = ""
		}
		if a.Trip != nil {
			edge := l.Edge(a.Trip.Edge)
			if edge == nil {
				return fmt.Errorf("population trip references unknown edge")
			}
			if seconds < a.Trip.Arrival {
				continue
			}
			entry := edge.Entry
			if edge.To == activeLevel {
				var free bool
				entry, free = populationLanding(l, edge.To, edge.Entry, occupied, a.ID)
				if active >= p.MaxActive || !free {
					a.Queued = true
					a.QueueReason = "entry_occupied"
					if active >= p.MaxActive {
						a.QueueReason = "active_limit"
					}
					a.Activity = "waiting_entry"
					continue
				}
				a.Materialized = true
				active++
				populationReserve(occupied, edge.To, entry, a.ID)
			}
			a.Level = edge.To
			a.Position = entry
			a.Goal = entry
			a.Path = nil
			a.MoveStartTick = tick
			a.Trip = nil
			a.WaitingDeparture = 0
			a.ColdReadyAt = seconds + p.ColdStepSeconds
			a.Queued = false
			a.QueueReason = ""
			a.Arrived = false
			a.Visits[edge.To]++
		}
		if !a.Materialized && a.Level == activeLevel {
			if active >= p.MaxActive {
				a.Queued = true
				a.QueueReason = "active_limit"
				a.Activity = "waiting_entry"
				continue
			}
			at, free := a.Position, populationCellFree(l, a.Level, a.Position, occupied, a.ID)
			if !levelChanged {
				free = false
				for _, edge := range l.Edges {
					if edge.To == a.Level {
						at, free = populationLanding(l, a.Level, edge.Entry, occupied, a.ID)
						if free {
							break
						}
					}
				}
			} else if !free {
				at, free = p.freeAnchor(l, a.Level, i, occupied, a.ID)
			}
			if !free {
				a.Queued = true
				a.QueueReason = "entry_occupied"
				a.Activity = "waiting_entry"
				continue
			}
			a.Materialized = true
			a.Position = at
			a.Goal = at
			a.MoveStartTick = tick
			a.Path = nil
			a.Queued = false
			a.QueueReason = ""
			active++
			populationReserve(occupied, a.Level, at, a.ID)
		}
		if !a.Materialized && seconds < a.ColdReadyAt {
			continue
		}
		stage := p.stage(seconds, a.ShiftSeconds)
		if stage != a.Stage {
			a.Stage = stage
			a.Arrived = false
			a.WaitingDeparture = 0
			if len(a.Path) > 1 {
				a.Path = a.Path[:1]
			}
		}
		target := p.Stages[a.Stage]
		if a.Materialized && len(a.Path) > 0 && tick >= a.MoveStartTick+p.MoveTicks {
			next := a.Path[0]
			if populationCellFree(l, a.Level, next, occupied, a.ID) {
				populationUnreserve(occupied, a.Level, a.Position, a.ID)
				a.Position = next
				a.Path = a.Path[1:]
				a.MoveStartTick = tick
				populationReserve(occupied, a.Level, next, a.ID)
				if len(a.Path) > 0 && !populationCellFree(l, a.Level, a.Path[0], occupied, a.ID) {
					a.Path = nil
				}
				if len(a.Path) > 0 {
					populationReserve(occupied, a.Level, a.Path[0], a.ID)
				}
			} else {
				populationUnreserve(occupied, a.Level, next, a.ID)
				a.Path = nil
				a.MoveStartTick = tick
			}
		}
		// A negotiated side step holds its pocket briefly while the waiting actor passes.
		if tick < a.YieldUntil { a.Activity = "yielding"; continue }
		if a.Arrived && a.Level == target.Level && len(a.Path) == 0 {
			a.Activity = target.Activity
			if !a.Materialized {
				a.ColdReadyAt = seconds + p.ColdStepSeconds
			}
			continue
		}
		var edge *LifeEdge
		goal := a.Goal
		if a.Level != target.Level {
			edge = l.NextEdge(a.Level, target.Level)
			if edge == nil {
				a.Activity = "waiting_route"
				a.ColdReadyAt = seconds + p.ColdStepSeconds
				continue
			}
			goal = edge.Exit
		} else if !a.Materialized {
			goal = p.anchor(i, a.Level)
		} else if a.Goal == a.Position || !populationCellFree(l, a.Level, a.Goal, occupied, a.ID) {
			var free bool
			goal, free = p.freeAnchor(l, a.Level, i, occupied, a.ID)
			if !free {
				a.Activity = "waiting_space"
				continue
			}
		}
		if !a.Materialized {
			// A coarse local leg consumes one configured interval. Arrival is not a
			// physical cell movement and never generates an offscreen walking path.
			if a.Position != goal {
				if a.Activity == "walking_coarse" && a.Goal == goal && seconds >= a.ColdReadyAt {
					a.Position = goal
				} else {
					a.Goal = goal
					a.ColdReadyAt = seconds + p.ColdStepSeconds
					a.Activity = "walking_coarse"
					continue
				}
			}
		}
		if a.Position == goal && len(a.Path) == 0 {
			if edge == nil {
				a.Arrived = true
				a.Activity = target.Activity
				a.ColdReadyAt = seconds + p.ColdStepSeconds
				continue
			}
			if a.WaitingDeparture == 0 || a.WaitingDeparture < seconds {
				a.WaitingDeparture = seconds
				if edge.PeriodSeconds > 0 {
					a.WaitingDeparture = ((seconds + edge.PeriodSeconds - 1) / edge.PeriodSeconds) * edge.PeriodSeconds
				}
			}
			if seconds < a.WaitingDeparture {
				a.Activity = "waiting_departure"
				continue
			}
			slot := departure{edge.ID, a.WaitingDeparture}
			if seats[slot] >= edge.Seats {
				a.Activity = "waiting_seat"
				if edge.PeriodSeconds > 0 {
					a.WaitingDeparture += edge.PeriodSeconds
				}
				continue
			}
			seats[slot]++
			if a.Materialized {
				populationUnreserve(occupied, a.Level, a.Position, a.ID)
				a.Materialized = false
				active--
			}
			a.Trip = &PopulationTrip{Edge: edge.ID, Departure: a.WaitingDeparture, Arrival: a.WaitingDeparture + edge.TravelSeconds}
			a.Path = nil
			a.Queued = false
			a.QueueReason = ""
			a.Activity = "transit"
			continue
		}
		if a.Materialized && (a.Goal != goal || len(a.Path) == 0) {
			if len(a.Path) > 0 && tick < a.MoveStartTick+p.MoveTicks {
				a.Path = a.Path[:1]
				a.Activity = "walking"
				continue
			}
			if len(a.Path) > 0 {
				populationUnreserve(occupied, a.Level, a.Path[0], a.ID)
			}
			a.Goal = goal
			a.Path = nil
			if !s.routes.connected(a.Level, a.Position, goal) {
				a.Activity = "waiting_route"
				continue
			}
			blocked := map[Cell]bool{}
			for at, id := range occupied[a.Level] {
				if id != a.ID {
					blocked[at] = true
				}
			}
			a.Path = l.Space(a.Level, blocked).Path(a.Position, goal, Cell{}, 0)
			a.MoveStartTick = tick
			if len(a.Path) > 0 {
				populationReserve(occupied, a.Level, a.Path[0], a.ID)
				a.Activity = "walking"
			} else {
				a.Activity = "waiting_path"
			}
		}
	}
	return nil
}

// Validate checks persisted identity, transitions and physical positions. Coarse
// anchors intentionally do not occupy scene cells. Admission queues never count
// as rendered/physical residents, and no queued actor may carry a walking path.
func (s PopulationState) Validate(p PopulationModel, l LifeModel, seconds, tick int64) error {
	if err := p.Validate(l); err != nil {
		return err
	}
	if seconds < 0 || tick < 0 || s.LastSeconds < 0 || s.LastSeconds > seconds || s.LastTick < 0 || s.LastTick > tick || s.Count < 0 || s.Count > p.MaxActors || len(s.Actors) != s.Count {
		return fmt.Errorf("invalid population clock/count")
	}
	if s.ActiveLevel != "" {
		if _, ok := l.Locations[s.ActiveLevel]; !ok {
			return fmt.Errorf("invalid population active level")
		}
	}
	positions := map[string]map[Cell]string{}
	reserved := map[string]map[Cell]string{}
	active := 0
	type departure struct {
		edge string
		at   int64
	}
	seats := map[departure]int{}
	for i, a := range s.Actors {
		if len(p.ShiftOffsets) == 0 || a.ID != fmt.Sprintf("population.%04d", i+1) || a.Name == "" || a.Stage < 0 || a.Stage >= len(p.Stages) || a.ShiftSeconds != p.ShiftOffsets[i%len(p.ShiftOffsets)] || !l.Walks(a.Level, a.Position) || !l.Walks(a.Level, a.Goal) || a.YieldUntil < 0 || a.YieldUntil > tick+8*p.MoveTicks || a.MoveStartTick < 0 || a.MoveStartTick > tick || a.WaitingDeparture < 0 || a.ColdReadyAt < 0 || a.Activity == "" || a.Visits == nil {
			return fmt.Errorf("invalid population actor %s", a.ID)
		}
		if l.Person(a.ID) != nil {
			return fmt.Errorf("population identity collides with named actor")
		}
		for level, visits := range a.Visits {
			if _, ok := l.Locations[level]; !ok || visits < 1 {
				return fmt.Errorf("invalid population visits")
			}
		}
		if a.Visits[a.Level] < 1 {
			return fmt.Errorf("missing population current visit")
		}
		if a.Queued && (a.Materialized || len(a.Path) > 0 || a.Activity != "waiting_entry" || (a.QueueReason != "active_limit" && a.QueueReason != "entry_occupied")) {
			return fmt.Errorf("invalid population admission queue")
		}
		if !a.Queued && a.QueueReason != "" {
			return fmt.Errorf("stale population queue reason")
		}
		if a.Trip != nil {
			edge := l.Edge(a.Trip.Edge)
			if edge == nil || a.Level != edge.From || a.Position != edge.Exit || a.Trip.Departure < 0 || a.Trip.Departure > s.LastSeconds || a.Trip.Arrival != a.Trip.Departure+edge.TravelSeconds || len(a.Path) > 0 || a.Materialized {
				return fmt.Errorf("invalid population trip")
			}
			slot := departure{a.Trip.Edge, a.Trip.Departure}
			seats[slot]++
			if seats[slot] > edge.Seats {
				return fmt.Errorf("population overbooked departure")
			}
		}
		if a.Materialized {
			if a.Level != s.ActiveLevel || a.Trip != nil {
				return fmt.Errorf("materialized population outside active level")
			}
			active++
			if positions[a.Level] == nil {
				positions[a.Level] = map[Cell]string{}
			}
			if positions[a.Level][a.Position] != "" {
				return fmt.Errorf("population actors overlap")
			}
			positions[a.Level][a.Position] = a.ID
		} else if len(a.Path) > 0 {
			return fmt.Errorf("offscreen population has physical path")
		}
		terrain := l.Locations[a.Level].Terrain
		if len(a.Path) > len(terrain)*len(terrain[0]) {
			return fmt.Errorf("oversized population walking path")
		}
		previous := a.Position
		for _, at := range a.Path {
			if !l.Walks(a.Level, at) || Distance(previous, at) != 1 {
				return fmt.Errorf("invalid population walking path")
			}
			previous = at
		}
		if len(a.Path) > 0 {
			if reserved[a.Level] == nil {
				reserved[a.Level] = map[Cell]string{}
			}
			if reserved[a.Level][a.Path[0]] != "" {
				return fmt.Errorf("population steps share reservation")
			}
			reserved[a.Level][a.Path[0]] = a.ID
		}
	}
	if active > p.MaxActive {
		return fmt.Errorf("population active limit exceeded")
	}
	for level, cells := range reserved {
		for at, id := range cells {
			if other := positions[level][at]; other != "" && other != id {
				return fmt.Errorf("population reservation overlaps resident")
			}
		}
	}
	return nil
}
