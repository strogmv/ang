 proximity:=0.0;immediate:=false
 if known{distance:=behavior.Distance(cell(a.Position),dangerAt);immediate=distance<=p.PanicDistance;proximity=1-float64(distance)/float64(p.SightRange);if proximity<0{proximity=0}}
 _,armedKnowledge:=a.Memory.Lookup("poc.hero","armed");armed:=mp.UnknownThreatValue
