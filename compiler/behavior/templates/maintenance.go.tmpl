// Code generated by ANG. Equipment lifecycle and temporary repair crews.
package behavior

import "fmt"

type MaintenanceAsset struct {
 ID string `json:"id"`; Name string `json:"name"`; Level string `json:"level"`; At Cell `json:"at"`
 Workplaces []Cell `json:"workplaces"`; Skill string `json:"skill"`
 InitialAge int64 `json:"initial_age_seconds"`; ServiceLife int64 `json:"service_life_seconds"`
 RepairSeconds int64 `json:"repair_seconds"`; TestSeconds int64 `json:"test_seconds"`
 PartDefinition string `json:"part_definition"`; InitialSpares int `json:"initial_spares"`
}
type MaintenanceWorker struct {Actor string `json:"actor"`; Skills []string `json:"skills"`}
type MaintenanceModel struct {
 AssignmentTimeout int64 `json:"assignment_timeout_seconds"`; RetrySeconds int64 `json:"retry_seconds"`
 Workers []MaintenanceWorker `json:"workers"`; Assets []MaintenanceAsset `json:"assets"`
}
type MaintenanceUnit struct {
 ID,Phase,Reason string
 Age,Elapsed,AssignedAt,RetryAt,LastReplaced,LastProgressAt int64
 Fault,PartsInstalled bool
 Crew []string
 Replacements int
}
type MaintenanceState struct {Units []MaintenanceUnit}
// Host transaction installs actual inventory parts. A nil hook cannot conjure materials.
type MaintenanceInstall func(asset MaintenanceAsset,leader string) error
func(a MaintenanceAsset)Store(kind string)string{return "maintenance/"+a.ID+"/"+kind}
func(u MaintenanceUnit)Operational()bool{return !u.Fault&&!u.PartsInstalled&&u.Phase!="repairing"&&u.Phase!="testing"}
func(u MaintenanceUnit)Label()string{
 switch u.Phase{case "normal":return "Автоматика работает";case "waiting_crew":return "Ожидает ремонтников";case "assembling":return "Бригада идёт к узлу";case "waiting_parts":return "Нет доступной запчасти";case "repairing":return "Замена модуля";case "testing":return "Проверка после замены"};return u.Phase
}
func(m MaintenanceModel)Validate(l LifeModel)error{
 if len(m.Assets)==0{return nil}
 if m.AssignmentTimeout<=0||m.RetrySeconds<=0{return fmt.Errorf("invalid maintenance policy")}
 workers:=map[string]bool{};for _,w:=range m.Workers{if l.Person(w.Actor)==nil||workers[w.Actor]||len(w.Skills)==0{return fmt.Errorf("invalid maintenance worker %s",w.Actor)};workers[w.Actor]=true}
 ids:=map[string]bool{};for _,a:=range m.Assets{
  if a.ID==""||ids[a.ID]||!l.Walks(a.Level,a.At)||a.Skill==""||a.InitialAge<0||a.ServiceLife<=0||a.RepairSeconds<=0||a.TestSeconds<=0||a.PartDefinition==""||a.InitialSpares<0||len(a.Workplaces)==0{return fmt.Errorf("invalid maintenance asset %s",a.ID)};ids[a.ID]=true
  spots:=map[Cell]bool{};for _,p:=range a.Workplaces{if spots[p]||!l.Walks(a.Level,p)||Distance(p,a.At)!=1{return fmt.Errorf("invalid work position %s",a.ID)};spots[p]=true}
 };return nil
}
func(m MaintenanceModel)Start()MaintenanceState{var s MaintenanceState;for _,a:=range m.Assets{s.Units=append(s.Units,MaintenanceUnit{ID:a.ID,Age:a.InitialAge,Phase:"normal"})};return s}
func(s MaintenanceState)Clone()MaintenanceState{r:=s;r.Units=append([]MaintenanceUnit(nil),s.Units...);for i:=range r.Units{r.Units[i].Crew=append([]string(nil),s.Units[i].Crew...)};return r}
func(s *LifeState)MaintenanceFault(id string)error{
 for i:=range s.Maintenance.Units{u:=&s.Maintenance.Units[i];if u.ID!=id{continue};if u.Phase!="normal"{return fmt.Errorf("узел уже ожидает или проходит ремонт")};u.Fault=true;u.Phase="waiting_crew";u.Reason="Поломка";s.note(id+": обнаружена неисправность");return nil};return fmt.Errorf("неизвестный узел")
}
func(m MaintenanceModel)qualified(actor,skill string)bool{for _,w:=range m.Workers{if w.Actor==actor{for _,s:=range w.Skills{if s==skill{return true}}}};return false}
func(s *LifeState)maintenanceStep(m LifeModel,id string)(LifeStep,bool){
 for i,u:=range s.Maintenance.Units{for slot,worker:=range u.Crew{if worker==id{a:=m.Maintenance.Assets[i];return LifeStep{Level:a.Level,At:a.Workplaces[slot],Activity:"maintenance",Label:u.Label()+": "+a.Name},true}}};return LifeStep{},false
}
func(s *LifeState)resumeRoutine(m LifeModel,id string){
 a:=s.Actor(id);if a==nil||a.Manual||a.OverrideLevel!=""{return};p:=m.Person(id);index:=len(p.Steps)-1;day:=s.Seconds/86400;found:=false
 for i,v:=range p.Steps{if v.AtMinute<=s.Seconds%86400/60{index=i;found=true}};if !found{day--}
 a.Step=index;a.Day=day;a.Arrived=false;a.Path=nil;a.WaitingDeparture=0;a.Label="Возвращается к своим делам"
}
func(s *LifeState)releaseMaintenance(m LifeModel,u *MaintenanceUnit){crew:=u.Crew;u.Crew=nil;for _,id:=range crew{s.resumeRoutine(m,id)}}
func(s *LifeState)maintenanceCrewReady(cfg MaintenanceAsset,u MaintenanceUnit)bool{
 if len(u.Crew)!=len(cfg.Workplaces){return false}
 for k,id:=range u.Crew{a:=s.Actor(id);if a==nil||a.Trip!=nil||a.Level!=cfg.Level||a.Position!=cfg.Workplaces[k]||len(a.Path)>0||!a.Arrived{return false}}
 return true
}
func(s *LifeState)planMaintenance(m LifeModel,delta int64){
 busy:=map[string]bool{};for _,u:=range s.Maintenance.Units{for _,id:=range u.Crew{busy[id]=true}}
 for i:=range s.Maintenance.Units{
  u:=&s.Maintenance.Units[i];cfg:=m.Maintenance.Assets[i];u.Age+=delta
  if u.Phase=="normal"&&u.Age>=cfg.ServiceLife{u.Phase="waiting_crew";u.Reason="Плановая замена";s.note(cfg.Name+": наступил срок замены")}
  if u.Phase=="normal"{continue}
  // Assignment has a deadline until work starts. Repair/testing instead expire
  // only after the physical crew has stopped making progress for that duration.
  // A ready crew may finish arbitrarily long work, even with coarse clock ticks.
  timeoutAt:=u.AssignedAt;stalled:=true
  if u.Phase=="repairing"||u.Phase=="testing"{if u.LastProgressAt>timeoutAt{timeoutAt=u.LastProgressAt};stalled=!s.maintenanceCrewReady(cfg,*u)}
  invalid:=len(u.Crew)>0&&stalled&&s.Seconds-timeoutAt>=m.Maintenance.AssignmentTimeout
  for _,id:=range u.Crew{a:=s.Actor(id);if a==nil||a.Manual||a.OverrideLevel!=""{invalid=true}}
  if invalid{for _,id:=range u.Crew{delete(busy,id)};s.releaseMaintenance(m,u);u.Phase="waiting_crew";u.Elapsed=0;u.LastProgressAt=0;u.RetryAt=s.Seconds+m.Maintenance.RetrySeconds;s.note(cfg.Name+": сбор отложен, участники освобождены")}
  if len(u.Crew)>0||s.Seconds<u.RetryAt{continue}
  var crew []string
  // Catalog order is a stable tie-break. Only available qualified people accept.
  for _,w:=range m.Maintenance.Workers{a:=s.Actor(w.Actor);if a==nil||busy[a.ID]||a.Manual||a.OverrideLevel!=""||a.Trip!=nil||len(a.Path)>0||!a.Arrived||a.Activity=="sleep"||a.Activity=="eat"||a.Activity=="post"||!m.Maintenance.qualified(a.ID,cfg.Skill){continue}
   if a.Level!=cfg.Level&&m.NextEdge(a.Level,cfg.Level)==nil{continue}
   crew=append(crew,a.ID);if len(crew)==len(cfg.Workplaces){break}
  }
  if len(crew)!=len(cfg.Workplaces){u.RetryAt=s.Seconds+m.Maintenance.RetrySeconds;continue}
  u.Crew=crew;u.AssignedAt=s.Seconds;u.LastProgressAt=0;u.Phase="assembling";for _,id:=range crew{busy[id]=true;a:=s.Actor(id);a.Arrived=false;a.Path=nil;a.WaitingDeparture=0};s.note(cfg.Name+": ремонтники приняли задание")
 }
}
func(s *LifeState)finishMaintenanceTick(m LifeModel,delta int64,install MaintenanceInstall){
 for i:=range s.Maintenance.Units{
  u:=&s.Maintenance.Units[i];cfg:=m.Maintenance.Assets[i];if len(u.Crew)!=len(cfg.Workplaces){continue}
  if !s.maintenanceCrewReady(cfg,*u){continue}
  switch u.Phase{
  case "assembling","waiting_parts":
   if s.Seconds<u.RetryAt{continue}
   if !u.PartsInstalled{if install==nil||install(cfg,u.Crew[0])!=nil{if u.Phase!="waiting_parts"{s.note(cfg.Name+": нужна доступная запчасть")};u.Phase="waiting_parts";u.RetryAt=s.Seconds+m.Maintenance.RetrySeconds;continue};u.PartsInstalled=true}
   u.Phase="repairing";u.LastProgressAt=s.Seconds;s.note(cfg.Name+": бригада в сборе, модуль выведен из работы")
  case "repairing":
   u.LastProgressAt=s.Seconds;u.Elapsed+=delta;for _,id:=range u.Crew{s.Actor(id).WorkedSeconds+=delta}
   if u.Elapsed>=cfg.RepairSeconds{u.Elapsed=0;u.Phase="testing";s.note(cfg.Name+": проверка после пересборки")}
  case "testing":
   u.LastProgressAt=s.Seconds;u.Elapsed+=delta;if u.Elapsed>=cfg.TestSeconds{u.Phase="normal";u.Age=0;u.Elapsed=0;u.Fault=false;u.PartsInstalled=false;u.Replacements++;u.LastReplaced=s.Seconds;u.LastProgressAt=0;u.RetryAt=0;u.Reason="";s.releaseMaintenance(m,u);s.note(cfg.Name+": работает; бригада вернулась к своим делам")}
  }
  for _,id:=range u.Crew{a:=s.Actor(id);if a.Arrived{a.Label=u.Label()+": "+cfg.Name}}
 }
}
func(s MaintenanceState)Validate(m LifeModel,now int64)error{
 if len(s.Units)!=len(m.Maintenance.Assets){return fmt.Errorf("maintenance registry mismatch")};assigned:=map[string]bool{}
 for i,u:=range s.Units{cfg:=m.Maintenance.Assets[i]
  if u.ID!=cfg.ID||u.Age<0||u.Elapsed<0||u.AssignedAt<0||u.AssignedAt>now||u.LastReplaced<0||u.LastReplaced>now||u.LastProgressAt<0||u.LastProgressAt>now||u.RetryAt<0||u.Replacements<0{return fmt.Errorf("invalid equipment state")}
  switch u.Phase{case "normal","waiting_crew","assembling","waiting_parts","repairing","testing":default:return fmt.Errorf("invalid maintenance phase")}
  if (len(u.Crew)!=0&&len(u.Crew)!=len(cfg.Workplaces))||(u.Phase=="normal"&&(len(u.Crew)>0||u.Fault||u.PartsInstalled||u.Elapsed!=0))||((u.Phase=="repairing"||u.Phase=="testing")&&(!u.PartsInstalled||len(u.Crew)==0)){return fmt.Errorf("invalid maintenance crew/phase")}
  if (u.Phase=="waiting_crew"&&len(u.Crew)!=0)||((u.Phase=="assembling"||u.Phase=="waiting_parts")&&len(u.Crew)==0){return fmt.Errorf("invalid maintenance assignment")}
  limit:=cfg.RepairSeconds;if cfg.TestSeconds>limit{limit=cfg.TestSeconds};if u.Elapsed>=limit{return fmt.Errorf("invalid maintenance progress")}
  for _,id:=range u.Crew{if assigned[id]||!m.Maintenance.qualified(id,cfg.Skill){return fmt.Errorf("invalid or duplicate repair worker")};assigned[id]=true}
 };return nil
}
