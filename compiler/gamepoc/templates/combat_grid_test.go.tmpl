func TestCombatGridHostPlanningIgnoresHiddenAmbientBodiesInPartlySeenTiles(t *testing.T){
 r,_,foe:=knifeMarketFixture(t)
 // A compact host-backed volume makes the corner/radar regression independent
 // of today's market dressing. One real column occludes part of a metre tile.
 level:="grid.hidden.fixture";terrain:=[]string{"........","........","........","...#....","........","........","........","........"}
 r.world.Life.Locations[level]=behavior.LifeLocation{CellMM:500,Terrain:terrain};r.world.Life.Walkable["."]=true
 v:=&behavior.DeckVolume{Schema:"ang.multideck.v1",PlanWidth:8,PlanDepth:8,NavWidth:8,NavDepth:8,EyeMM:1600,TargetMM:[]int{450,1100,1650},SightRangeCells:24,Surfaces:[]behavior.DeckSurface{{ID:"base",Index:0,Walkable:true,Grounded:true,Slab:[]behavior.DeckRect{{X:0,Y:0,W:8,H:8}}}},Solids:[]behavior.DeckSpan{{Rect:behavior.DeckRect{X:3,Y:3,W:1,H:1},BottomMM:0,TopMM:2200}}}
 if err:=v.Prepare();err!=nil{t.Fatal(err)};r.world.Decks[level]=v;r.world.Life.Decks[level]=v
 h,n:=r.state.Life.Actor(playerActorID),r.state.Life.Actor(foe);h.Level,h.Position,h.Goal,h.Body=level,behavior.Cell{},behavior.Cell{},nil;n.Level,n.Position,n.Goal=level,behavior.Cell{X:7},behavior.Cell{X:7}
 a,b:=r.combatant(playerActorID,"blue"),r.combatant(foe,"red");a.Position=h.Position;b.Position=n.Position
 proposed:=behavior.CombatState{LevelID:level,Actors:[]behavior.Combatant{a,b}}
 built,err:=behavior.NewCombat("hidden-body",level,711,proposed.Actors,r.world.CombatRuntime.Rules,r.combatSpace(proposed));if err!=nil{t.Fatal(err)};r.state.Combat=built;r.syncLifeHero()
 s:=r.state.Combat;hero:=s.Actor(playerActorID);space:=r.combatSpace(s)
 hidden:=[]behavior.Cell{}
 for key,members:=range space.Grid.Members{if space.Grid.Same(key,hero.Position)||space.Grid.Same(key,s.Actor(foe).Position)||space.RangeMM(hero.Position,key)>6000{continue};seen:=false;unseen:=[]behavior.Cell{}
  for _,at:=range members{if r.combatObserverSees(s.LevelID,hero.ID,hero.Position,at){seen=true}else{unseen=append(unseen,at)}}
  if seen&&len(unseen)>0{hidden=append(hidden,unseen...)}
  if len(hidden)>=2{break}
 }
 if len(hidden)<2{t.Fatal("market fixture has fewer than two partially occluded nearby nav members")}
 var ambient *behavior.LifeActor;for i:=range r.state.Life.Actors{p:=&r.state.Life.Actors[i];if s.Actor(p.ID)==nil{ambient=p;break}}
 if ambient==nil{t.Fatal("ordinary world has no bystander")}
 ambient.Level=s.LevelID;ambient.Position=hidden[0];ambient.Path=nil;ambient.PendingPath=nil;ambient.Body=nil;ambient.RestFootprint=nil
 beforeSpace:=r.combatSpace(s);before:=s.Decide(beforeSpace,r.world.CombatRuntime.Rules)
 ambient.Position=hidden[1];afterSpace:=r.combatSpace(s);after:=s.Decide(afterSpace,r.world.CombatRuntime.Rules)
 for at:=range beforeSpace.Grid.Tile{if beforeSpace.PlanningOccupied(*hero,at)!=afterSpace.PlanningOccupied(*hero,at){t.Fatal("partly visible tile exposed a hidden occupant")}}
