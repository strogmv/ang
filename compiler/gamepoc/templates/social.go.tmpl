 if !d.Captured{for _,c:=range d.Candidates{if !c.Selected{continue};hunter:=d.Agents[r.demoAgentIndex(c.AgentID)];if hunter.ID!=a.ID&&behavior.Distance(cell(a.Position),cell(hunter.Position))<=p.SightRange&&r.sceneVisible(cell(a.Position),cell(hunter.Position)){a.Memory.Record(behavior.Fact{Subject:hunter.ID,Kind:"responder",Source:"sight",Value:true,Position:cell(hunter.Position),ObservedTick:tick},mp)}}}
