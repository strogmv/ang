	takes := includesString(b.Items, i.Definition)
	if c, _, ok := r.world.Crafting.PartOf(i.Definition); ok && includesString(b.Classes, c.ID) {
		takes = true
	}
	if !takes {
		return 0, false
	}
	d := r.world.Inventory.Definitions[i.Definition]
	weight := (d.Mass*b.MinorPerKg + 999) / 1000
	floor := r.peddlerLawPrice(i, stock) * b.FloorPermille / 1000
	return max(1, weight, floor), true
}

