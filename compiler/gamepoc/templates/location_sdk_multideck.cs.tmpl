     if(faded&&!swapped){original=new LocationSDKFadeRestore{materials=renderer.sharedMaterials,shadows=renderer.shadowCastingMode};locationSDKFadeOriginal[renderer]=original;var slots=new Material[original.materials.Length];for(int i=0;i<slots.Length;i++)slots[i]=locationSDKInstanceFadeMaterial;renderer.sharedMaterials=slots;renderer.shadowCastingMode=UnityEngine.Rendering.ShadowCastingMode.Off;}
     else if(!faded&&swapped){renderer.sharedMaterials=original.materials;renderer.shadowCastingMode=original.shadows;locationSDKFadeOriginal.Remove(renderer);}
    }
    if(!faded){for(int i=locationSDKInstanceHiddenText.Count-1;i>=0;i--){var r=locationSDKInstanceHiddenText[i];if(r==null){locationSDKInstanceHiddenText.RemoveAt(i);continue;}if(r.transform.IsChildOf(root.transform)){r.enabled=true;locationSDKInstanceHiddenText.RemoveAt(i);}}}
   }
  }
