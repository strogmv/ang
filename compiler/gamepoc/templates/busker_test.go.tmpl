		was[o.Serial] = inFront(o)
	}
	entered, passed := 0, map[int64]bool{}
	visitorsRun(t, r, 2400, func() {
		n := 0
		now := map[int64]bool{}
		for _, o := range r.state.Visitors.Bodies {
			in := inFront(o)
			if in && !was[o.Serial] && r.buskerSetUp() {
				entered++
				t.Logf("walker %d (%s) steps into the clear front at %v (way %v)", o.Serial, o.Phase, o.At, o.Path)
			}
