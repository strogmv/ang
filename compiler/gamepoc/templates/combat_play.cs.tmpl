    Func<Color,float,float,Material> mat=(c,m,s)=>{var x=new Material(shader){enableInstancing=true};x.SetColor("_BaseColor",c);x.SetFloat("_Metallic",m);x.SetFloat("_Smoothness",s);locationSDKHumanoidOwned.Add(x);return x;};
    combatPropDark=mat(new Color(.07f,.07f,.075f),0,.35f);combatPropSteel=mat(new Color(.62f,.64f,.66f),.85f,.6f);combatPropBrass=mat(new Color(.55f,.42f,.2f),.8f,.5f);
