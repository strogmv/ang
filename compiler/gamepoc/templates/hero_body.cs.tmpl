   if(!HeroCombatActive()&&!HeroCombatIncapacitated()&&hbActive&&hasMM&&deck==hbSim.layer){hbSim.mode="route";hbSim.route.Clear();hbSim.route.Add(new PocBodyPoint{XMm=xmm,YMm=ymm,Layer=deck});hbSim.run=run;}
   return true;
  }
  internal void HeroPressBegin(Vector2 gui){hbPress=true;hbFollowing=false;hbPressAt=clock.Elapsed.TotalSeconds;hbPressGui=gui;}
  // Update: keyboard / stick steering and the held-button follow; rate-limited, immediate on start/stop.
  void UpdateHeroControl(){
   // Before the first body sample (an automatic routine) the first steer itself hands control to the player.
   bool ready=page=="game"&&state!=null&&!combatPanelOpen&&!HeroCombatActive()&&!HeroCombatIncapacitated()&&state.Active&&!state.Paused&&!loadingActive&&state.Life!=null&&!state.Life.Transit&&CanSend()&&IsStoryModularLocation()&&locationSDKCamera!=null;
   Vector2 forward,right;if(!ready||!HeroScreenAxes(out forward,out right)){if(hbSteering||hbFollowing){if(ready||CanSend())HeroSend("stop",0,0,false);hbSteering=hbFollowing=false;}hbPress=false;return;}
   double now=clock.Elapsed.TotalSeconds;Vector2 move;bool run,held;Vector2 cursor;
   if(HeroVirtualInput){move=HeroVirtualMove;run=HeroVirtualRun;held=HeroVirtualHold;cursor=HeroVirtualCursorGui;}
   else if(verify)return;
   else{
    bool typing=GUIUtility.keyboardControl!=0;float kx=0,ky=0;
    if(!typing){if(Input.GetKey(KeyCode.W)||Input.GetKey(KeyCode.UpArrow))ky+=1;if(Input.GetKey(KeyCode.S)||Input.GetKey(KeyCode.DownArrow))ky-=1;if(Input.GetKey(KeyCode.D)||Input.GetKey(KeyCode.RightArrow))kx+=1;if(Input.GetKey(KeyCode.A)||Input.GetKey(KeyCode.LeftArrow))kx-=1;}
    bool keys=kx!=0||ky!=0;run=!typing&&(Input.GetKey(KeyCode.LeftShift)||Input.GetKey(KeyCode.RightShift));
    if(keys)move=new Vector2(kx,ky).normalized;
    else{var stick=new Vector2(Input.GetAxisRaw("Horizontal"),Input.GetAxisRaw("Vertical"));float m=stick.magnitude;
     // Analogue: dead zone .18, then proportional; a near-full tilt runs (document 86).
     if(m<.18f)move=Vector2.zero;else{float s=Mathf.Clamp01((m-.18f)/(.9f-.18f));move=stick/m*Mathf.Max(.25f,s);if(m>=.92f){run=true;move=stick/m;}}}
    held=Input.GetMouseButton(0);cursor=HeroGuiMouse();
   }
   // Held button: after .22 s the press becomes "follow the cursor"; releasing stops.
   if(hbPress&&!held){if(hbFollowing)HeroSend("stop",0,0,false);hbPress=hbFollowing=false;}
   if(hbPress&&held&&move==Vector2.zero&&now-hbPressAt>=.22){double tx,ty;if(HeroGroundUnder(cursor,out tx,out ty)){bool moved=!hbFollowing||Math.Abs(tx-hbSentTX)+Math.Abs(ty-hbSentTY)>60;if(moved&&(!hbFollowing||now-hbLastSendAt>=.05)){if(HeroSend("follow",tx,ty,run)){hbFollowing=true;hbSentTX=tx;hbSentTY=ty;locationSDKFollowHero=LocationSDKHeroViewHeight(locationSDKLevel.GetCamera(),true)>0;}}}return;}
   if(move.sqrMagnitude>1e-4f){
    hbPress=hbFollowing=false;Vector2 plan=forward*move.y+right*move.x;float mag=Mathf.Min(1,move.magnitude);if(plan.sqrMagnitude>1e-8f)plan=plan.normalized*mag;
    double ang=Math.Round(Math.Atan2(plan.y,plan.x)*180/Math.PI),q=Math.Round(mag*20)/20;string key=ang+"/"+q+"/"+run;
    if(!hbSteering||key!=hbSentKey&&now-hbLastSendAt>=.03){double rad=ang*Math.PI/180;bool mark=!hbSteering&&HeroInputAt<0;if(mark)HeroMarkInput();if(HeroSend("steer",Math.Cos(rad)*q,Math.Sin(rad)*q,run)){if(mark)HeroInputSeq=hbLocalSeq;hbSteering=true;hbSentKey=key;locationSDKFollowHero=LocationSDKHeroViewHeight(locationSDKLevel.GetCamera(),true)>0;}}
   }
   else if(hbSteering){if(HeroSend("stop",0,0,false)){hbSteering=false;hbSentKey="";}}
  }
  internal void HeroMarkInput(){HeroInputAt=clock.Elapsed.TotalSeconds;HeroFirstPredictedAt=-1;HeroAckAt=-1;HeroInputSeq=0;Vector2 ignored;HeroBodyFeet(out HeroInputFeet,out ignored);}
  void HeroBodyAck(PocMoveResult result){
   if(result==null||state==null||result.Epoch!=state.Epoch)return;
   // A refused input leaves the server's own input in force: adopt it.
   if(!result.Ok&&result.InputSeq==hbLocalSeq&&result.HeroBody!=null)hbLocalSeq=result.HeroBody.InputSeq;
   if(result.HeroBody!=null)HeroBodyReceive(result.HeroBody);
   if(HeroInputSeq!=0&&result.InputSeq==HeroInputSeq&&HeroAckAt<0)HeroAckAt=clock.Elapsed.TotalSeconds;
  }
 }
