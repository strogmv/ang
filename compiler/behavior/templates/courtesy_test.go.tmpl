func courtesyFixture() (LifeModel, LifeState) {
	m := LifeModel{
		StartSeconds: 0, SecondsPerTick: 1, MoveTicks: 3,
		Courtesy: LifeCourtesyPolicy{NoticeCells: 2},
		Walkable: map[string]bool{".": true},
		Locations: map[string]LifeLocation{"hall": {Name: "Hall", Terrain: []string{
			"#######", "###.###", "#.....#", "#######", "#######",
		}}},
		Actors: []LifePerson{
			{ID: "hero", Name: "Hero", Steps: []LifeStep{{Level: "hall", At: Cell{1, 2}, Activity: "rest", Label: "Own task"}}},
			{ID: "friend", Name: "Friend", Relations: []LifeRelation{{To: "hero", Strength: .5}}, Steps: []LifeStep{{Level: "hall", At: Cell{3, 2}, Activity: "rest", Label: "Own task"}}},
		},
	}
	s := m.Start()
	s.ControlledActorID = "hero"
	return m, s
}

// Host admission and later replanning share MoveRoute. Preserve the durable
// target even when admission returns only the free prefix before a friend.
func courtesyAccept(t *testing.T, m LifeModel, s *LifeState, target Cell) {
	t.Helper()
	hero := s.Actor("hero")
	before := s.Clone()
	path, ok := s.MoveRoute(m, hero.ID, hero.Level, hero.Position, target, s.Tick)
	if !ok {
		t.Fatal("friendly corridor command rejected")
	}
	if !reflect.DeepEqual(before, s.Clone()) {
		t.Fatal("route admission changed physical state")
	}
	previous := hero.Position
	for _, at := range path {
		if Distance(previous, at) != 1 || !m.Walks(hero.Level, at) || s.occupied(hero.Level, at, hero.ID) {
			t.Fatalf("admitted prefix includes an occupied, solid or non-neighbor cell: %v", path)
		}
		previous = at
	}
	hero.Manual, hero.Arrived, hero.Goal, hero.Path = true, false, target, path
	hero.MoveStartTick, hero.Activity = s.Tick, "walking"
}

func courtesyAdvance(t *testing.T, m LifeModel, s *LifeState, tick int64) {
	t.Helper()
	before := s.Clone()
	s.Advance(m, tick)
	if err := s.Validate(m, tick); err != nil {
		t.Fatalf("tick %d: %v", tick, err)
	}
	for i, a := range s.Actors {
		old := before.Actors[i]
		if old.Position == a.Position {
			continue
		}
		if Distance(old.Position, a.Position) != 1 || tick < old.MoveStartTick+m.MoveTicks {
			t.Fatalf("tick %d: accelerated or nonlocal movement for %s: %v -> %v (started %d)", tick, a.ID, old.Position, a.Position, old.MoveStartTick)
		}
	}
}

func TestLifeCourtesyAcceptedGoalPassesIdleFriendAndRestoresTask(t *testing.T) {
	m, s := courtesyFixture()
	if err := m.Validate(); err != nil {
		t.Fatal(err)
	}
	origin, goal := s.Actor("friend").Position, Cell{5, 2}
	courtesyAccept(t, m, &s, goal)
	yielded, passed, restored := false, false, false
	for tick := int64(1); tick <= 60; tick++ {
		courtesyAdvance(t, m, &s, tick)
		hero, friend := s.Actor("hero"), s.Actor("friend")
		if hero.Goal != goal || !hero.Manual || friend.Goal != origin || friend.Step != 0 || friend.Manual {
			t.Fatalf("accepted goal or NPC task lost at tick %d", tick)
		}
		if friend.YieldUntil > 0 {
			yielded = true
		}
		passed = passed || hero.Position == goal && hero.Arrived && len(hero.Path) == 0
		restored = restored || passed && friend.Position == origin && friend.Arrived && friend.Activity == "rest" && len(friend.Path) == 0
	}
	if !yielded || !passed || !restored {
		t.Fatalf("ordinary passage/task restoration incomplete: yielded=%v passed=%v restored=%v hero=%+v friend=%+v", yielded, passed, restored, s.Actor("hero"), s.Actor("friend"))
	}
}

func TestLifeCourtesyOnlyPositiveDirectedAttitudeGrantsStationaryPassage(t *testing.T) {
	for _, kind := range []string{"missing", "zero", "negative", "only_reverse", "negative_with_positive_reverse", "wrong_control", "missing_control"} {
		t.Run(kind, func(t *testing.T) {
			m, s := courtesyFixture()
			switch kind {
			case "missing", "only_reverse":
				m.Actors[1].Relations = nil
			case "zero":
				m.Actors[1].Relations[0].Strength = 0
			case "negative", "negative_with_positive_reverse":
				m.Actors[1].Relations[0].Strength = -.2
			case "wrong_control":
				s.ControlledActorID = "friend"
			case "missing_control":
				s.ControlledActorID = ""
			}
			if kind == "only_reverse" || kind == "negative_with_positive_reverse" {
				m.Actors[0].Relations = []LifeRelation{{To: "friend", Strength: 1}}
			}
			before := s.Clone()
			if path, ok := s.MoveRoute(m, "hero", "hall", Cell{1, 2}, Cell{5, 2}, 0); ok || len(path) != 0 {
				t.Fatalf("stationary nonfriend or unauthorized requester admitted: %v", path)
			}
			if s.yieldPopulationFor(m, "hall", Cell{3, 2}, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) {
				t.Fatal("stationary nonfriend or unauthorized requester enlisted")
			}
			if !reflect.DeepEqual(before, s.Clone()) {
				t.Fatal("rejected courtesy changed state")
			}
		})
	}
}

func TestLifeCourtesyProtectsBusyNamedActors(t *testing.T) {
	for _, kind := range []string{"manual", "segment", "work", "post", "eat", "sleep", "maintenance", "workplace", "already_yielding"} {
		t.Run(kind, func(t *testing.T) {
			m, s := courtesyFixture()
			friend := s.Actor("friend")
			switch kind {
			case "manual":
				friend.Manual = true
			case "segment":
				friend.Path = []Cell{{3, 1}}
			case "workplace":
				m.Maintenance.Assets = []MaintenanceAsset{{Level: "hall", Workplaces: []Cell{friend.Position}}}
				s.Maintenance.Units = []MaintenanceUnit{{Crew: []string{"friend"}}}
			case "already_yielding":
				friend.YieldUntil = 3
			default:
				friend.Activity = kind
			}
			before := s.Clone()
			if _, ok := s.MoveRoute(m, "hero", "hall", Cell{1, 2}, Cell{5, 2}, 0); ok != (kind == "segment") {
				t.Fatal("admission must wait for an accepted friendly segment, and reject active duties")
			}
			if s.yieldPopulationFor(m, "hall", friend.Position, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) {
				t.Fatal("friendly relation displaced a protected task or accepted segment")
			}
			if !reflect.DeepEqual(before, s.Clone()) {
				t.Fatal("failed negotiation changed a protected task")
			}
		})
	}
}

func TestLifeCourtesyWaitIntentPreservesMovingFriendsAcceptedSegment(t *testing.T) {
	m, s := courtesyFixture()
	m.Actors[1].Steps[0].At = Cell{3, 1}
	friend := s.Actor("friend")
	friend.Arrived, friend.Activity, friend.Goal = false, "walking", Cell{3, 1}
	friend.Path = []Cell{{3, 1}}
	before := s.Clone()
	courtesyAccept(t, m, &s, Cell{5, 2})
	if !reflect.DeepEqual(friend.Path, before.Actor("friend").Path) || friend.Position != (Cell{3, 2}) {
		t.Fatal("intent admission interrupted the friend's accepted movement")
	}
	for tick := int64(1); tick <= 24; tick++ {
		courtesyAdvance(t, m, &s, tick)
		if tick < m.MoveTicks && s.Actor("friend").Position != (Cell{3, 2}) {
			t.Fatal("friendly movement was accelerated")
		}
		if s.Actor("friend").YieldUntil != 0 {
			t.Fatal("a friend already clearing the route was interrupted")
		}
	}
	if s.Actor("hero").Position != (Cell{5, 2}) || s.Actor("friend").Position != (Cell{3, 1}) {
		t.Fatal("both actors failed to complete ordinary movement")
	}
}

func TestLifeCourtesyArrivedIdleActivitiesCanYield(t *testing.T) {
	for _, activity := range []string{"rest", "market", "waiting", "walking"} {
		t.Run(activity, func(t *testing.T) {
			m, s := courtesyFixture()
			friend := s.Actor("friend")
			friend.Activity = activity
			before := friend.Position
			if !s.yieldPopulationFor(m, "hall", before, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) {
				t.Fatal("idle friendly actor did not accept the free pocket")
			}
			if friend.Position != before || friend.Goal != before || friend.Arrived || len(friend.Path) != 1 || friend.Path[0] != (Cell{3, 1}) {
				t.Fatalf("courtesy moved a body immediately or lost its original task: %+v", friend)
			}
		})
	}
}

func TestLifeCourtesyDistantFriendWaitsForLocalApproach(t *testing.T) {
	for _, radius := range []int{0, 1, 2} {
		m, s := courtesyFixture()
		m.Courtesy.NoticeCells = radius
		m.Locations["hall"] = LifeLocation{Name: "Hall", Terrain: []string{"#######", "####.##", "#.....#", "#######", "#######"}}
		m.Actors[1].Steps[0].At = Cell{4, 2}
		s = m.Start()
		s.ControlledActorID = "hero"
		before := s.Clone()
		if s.yieldPopulationFor(m, "hall", Cell{4, 2}, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) || !reflect.DeepEqual(before, s.Clone()) {
			t.Fatalf("radius %d: distant friend reacted before approach", radius)
		}
		courtesyAccept(t, m, &s, Cell{5, 2})
		yielded := false
		for tick := int64(1); tick <= 60; tick++ {
			courtesyAdvance(t, m, &s, tick)
			if s.Actor("friend").YieldUntil > 0 && !yielded {
				notice := radius
				if notice == 0 {
					notice = 2
				}
				if Distance(s.Actor("hero").Position, Cell{4, 2}) > notice {
					t.Fatalf("radius %d: friend yielded outside local range", radius)
				}
				yielded = true
			}
		}
		if !yielded || s.Actor("hero").Position != (Cell{5, 2}) {
			t.Fatalf("radius %d: approaching hero never received passage", radius)
		}
	}
}

func TestLifeCourtesyWallsAndClosedCornersDoNotRevealHero(t *testing.T) {
	for _, test := range []struct {
		name         string
		rows         []string
		hero, friend Cell
	}{
		{"wall", []string{"#######", "###.###", "#.#...#", "#######", "#######"}, Cell{1, 2}, Cell{3, 2}},
		{"two_corner_walls", []string{"#######", "###..##", "#..####", "#######", "#######"}, Cell{2, 2}, Cell{3, 1}},
		{"one_corner_wall", []string{"#######", "##...##", "#..####", "#######", "#######"}, Cell{2, 2}, Cell{3, 1}},
	} {
		t.Run(test.name, func(t *testing.T) {
			m, _ := courtesyFixture()
			m.Locations["hall"] = LifeLocation{Name: "Hall", Terrain: test.rows}
			m.Actors[0].Steps[0].At, m.Actors[1].Steps[0].At = test.hero, test.friend
			s := m.Start()
			s.ControlledActorID = "hero"
			before := s.Clone()
			if s.courtesyAware(m, "hero", "hall", test.friend) {
				t.Fatal("static wall/closed corner granted awareness")
			}
			if s.yieldPopulationFor(m, "hall", test.friend, 0, "hero", test.friend) || !reflect.DeepEqual(before, s.Clone()) {
				t.Fatal("friend reacted across a wall/closed corner")
			}
		})
	}
}

func TestLifeCourtesyNoPocketDoesNotTeleportOrCancelAcceptedGoal(t *testing.T) {
	m, s := courtesyFixture()
	m.Locations["hall"] = LifeLocation{Name: "Hall", Terrain: []string{"#######", "#######", "#.....#", "#######", "#######"}}
	before := s.Clone()
	if s.yieldPopulationFor(m, "hall", Cell{3, 2}, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) || !reflect.DeepEqual(before, s.Clone()) {
		t.Fatal("invented a free off-route pocket")
	}
	courtesyAccept(t, m, &s, Cell{5, 2})
	for tick := int64(1); tick <= 60; tick++ {
		courtesyAdvance(t, m, &s, tick)
		if s.Actor("friend").Position != (Cell{3, 2}) || s.Actor("friend").YieldUntil != 0 || s.Actor("hero").Goal != (Cell{5, 2}) {
			t.Fatal("full corridor moved the blocker or discarded the command")
