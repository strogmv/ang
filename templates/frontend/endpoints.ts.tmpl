const resolveStreamUrl = (path: string): string => {
  const base = String(apiClient.defaults.baseURL || '').replace(/\/+$/, '');
  if (!base) {
    return path;
  }
  if (!path.startsWith('/')) {
    return `${base}/${path}`;
  }
  return `${base}${path}`;
};

const appendStreamQuery = (url: string, params: Record<string, any>) => {
