// Code generated by ANG. Selection is presentation; only explicit Go sets intent.
package poc

import (
 "reflect"
 "testing"
 "angelsdemons/server/internal/behavior"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

func wayfindingFixture(t *testing.T)(*Runtime,wayfindingDestination){
 t.Helper();r:=lifeRuntimeFixture(t);if len(r.world.Wayfinding.Destinations)==0{t.Skip("no authored wayfinding destinations")};var d wayfindingDestination;for _,candidate:=range r.world.Wayfinding.Destinations{if candidate.EdgeID==""&&candidate.GuideFrom!=nil&&*candidate.GuideFrom!=candidate.At{d=candidate;break}};if d.ID==""{t.Skip("no separate local approach")};hero:=r.state.Life.Actor(playerActorID);hero.Level=d.Level;hero.Trip=nil;hero.Path=nil;hero.PendingPath=nil;hero.Manual=true;hero.OverrideLevel="";hero.OverrideEdge="";hero.Arrived=false;hero.Position=d.At;if d.GuideFrom!=nil{hero.Position=*d.GuideFrom};hero.Goal=hero.Position;r.syncLifeHero()
 rows:=r.world.Life.Locations[d.Level].Terrain;memory:=map[int]seenCell{};for y,row:=range rows{for x:=range len(row){memory[y*len(row)+x]=seenCell{Glyph:string(row[x]),Tick:r.state.Tick}}};r.state.LifeExploration[d.Level]=memory;r.syncRegionKnowledge();r.wayfindingContext();return r,d
}
func wayfindingView(r *Runtime)*pb.PocWayfindingView{view:=&pb.PocLifeView{};r.appendWayfinding(view,"en");return view.Wayfinding}
func TestWayfindingSelectionAndClearPreserveGameState(t *testing.T){
 r,d:=wayfindingFixture(t);before:=r.snapshotState();if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_preview",Destination:d.ID});err!=nil{t.Fatal(err)};v:=wayfindingView(r)
 if !reflect.DeepEqual(before,r.snapshotState()){t.Fatal("preview changed actor intent, inventory, calendar or knowledge")};if v==nil||v.SelectedDestinationId!=d.ID||!v.Reachable||v.Status!="ready"{t.Fatalf("missing preview %+v",v)}
 for i,p:=range v.Path{at:=behavior.Cell{X:int(p.X),Y:int(p.Y)};if !r.world.Life.Walks(d.Level,at)||!r.wayfindingWalks(d.Level,at){t.Fatal("route crossed a wall or unknown cell")};if i>0{q:=v.Path[i-1];if behavior.Distance(at,behavior.Cell{X:int(q.X),Y:int(q.Y)})!=1{t.Fatal("noncardinal preview step")}}}
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_clear"});err!=nil{t.Fatal(err)};if !reflect.DeepEqual(before,r.snapshotState())||wayfindingView(r).SelectedDestinationId!=""{t.Fatal("clearing preview cancelled gameplay intent")}
}
func TestWayfindingExplicitGoPauseStaleAndUnknownTargets(t *testing.T){
 r,d:=wayfindingFixture(t);r.state.Paused=true;if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_preview",Destination:d.ID});err!=nil{t.Fatal("paused preview rejected",err)};before:=r.snapshotState();if r.lifeCommand(&pb.PocLifeCommand{Action:"route_go",Destination:d.ID})==nil||!reflect.DeepEqual(before,r.snapshotState()){t.Fatal("paused explicit Go changed simulation")};r.state.Paused=false
 if r.lifeCommand(&pb.PocLifeCommand{Action:"route_go",Destination:"stale.id"})==nil{t.Fatal("stale selection accepted")};hero:=r.state.Life.Actor(playerActorID);at:=hero.Position;if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_go",Destination:d.ID});err!=nil{t.Fatal(err)};if hero.Position!=at||!hero.Manual||hero.Goal!=d.At{t.Fatal("explicit Go bypassed ordinary intent or teleported")};if wayfindingView(r).SelectedDestinationId!=d.ID{t.Fatal("walking cleared selection")}
 rows:=r.world.Life.Locations[d.Level].Terrain;delete(r.state.LifeExploration[d.Level],d.At.Y*len(rows[d.At.Y])+d.At.X);v:=wayfindingView(r);if v.SelectedDestinationId!=""||v.Reachable{t.Fatal("unknown target retained from preview cache")};for _,target:=range v.Destinations{if target.Id==d.ID{t.Fatal("unknown destination metadata leaked")}}
 before=r.snapshotState();if r.lifeCommand(&pb.PocLifeCommand{Action:"route_preview",Destination:"unknown.hidden.destination"})==nil||!reflect.DeepEqual(before,r.snapshotState()){t.Fatal("unknown selection changed actor or knowledge")}
}

func TestWayfindingCompiledReservationsDriveGuidesWithoutRevealingUnknownFloor(t *testing.T){
 r:=sdkHostRuntime(t)
 l:=&r.world.LocationSDK.Levels[0]
 // A U-shaped reservation is deliberately longer than the direct floor path.
 // This JSON subset is exactly the compiled SDK cells field consumed by host.
 l.Terrain=[]string{"#######","#.....#","#.....#","#.....#","#######"}
 l.ReservedPaths=[]sdkReservedPath{{ID:"public",Cells:[]behavior.Cell{{X:1,Y:1},{X:1,Y:2},{X:1,Y:3},{X:2,Y:3},{X:3,Y:3},{X:4,Y:3},{X:5,Y:3},{X:5,Y:2},{X:5,Y:1}}}}
 r.world.ModularLocations=nil
 if err:=r.prepareLocationSDK();err!=nil{t.Fatal(err)}
 if v:=sdkHostNew(t,r,"sdk:"+sdkHostTestID,"reserved-start");!v.Ok{t.Fatal(v)}
 from,to:=behavior.Cell{X:1,Y:1},behavior.Cell{X:5,Y:1}
 r.world.Wayfinding=wayfindingCatalog{Destinations:[]wayfindingDestination{{ID:"way.test",NameKey:"wayfinding.test",Level:l.ID,At:to,GuideFrom:&from,Kind:"landmark",Color:"#83A7BD"}}}
 memory:=map[int]seenCell{};for y,row:=range l.Terrain{for x:=range row{memory[y*l.Width+x]=seenCell{Glyph:string(row[x])}}};r.state.LifeExploration[l.ID]=memory
 v:=wayfindingView(r);if len(v.Guides)!=1||len(v.Guides[0].Path)!=9{t.Fatalf("compiled reservation not used on wire: %v",v.Guides)}
 for _,p:=range v.Guides[0].Path{if !r.world.FloorReservations[l.ID][behavior.Cell{X:int(p.X),Y:int(p.Y)}]{t.Fatal("guide left compiled reservation")}}
 delete(memory,3*l.Width+3);v=wayfindingView(r)
 for _,g:=range v.Guides{for _,p:=range g.Path{if p.X==3&&p.Y==3{t.Fatal("reserved geometry bypassed chip memory")}}}
 if len(r.world.Wayfinding.Destinations)!=1{t.Fatal("reservation manufactured destinations")}
 // A malformed imported reservation cannot bypass final floor validation.
 r.world=r.canonicalWorld;r.world.LocationSDK.Levels[0].ReservedPaths[0].Cells=append(l.ReservedPaths[0].Cells,behavior.Cell{X:0,Y:0})
 if err:=r.prepareLocationSDK();err==nil{t.Fatal("reserved wall accepted by host")}
}
