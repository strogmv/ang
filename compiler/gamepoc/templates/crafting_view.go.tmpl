	for _, sh := range r.world.Inventory.Shopfronts {
		displays[sh.DisplayStore] = sh.Owner
	}
	vending := map[string]bool{}
	for _, u := range r.world.Vending.Units {
		vending[u.DisplayStore] = true
	}
	sellers, machine := map[string][]string{}, map[string]bool{}
	for _, i := range r.state.Inventory.Items {
		if !i.ForSale || i.Location.Kind != "store" {
			continue
		}
		if owner, ok := displays[i.Location.Store]; ok {
			found := false
			for _, o := range sellers[i.Definition] {
				found = found || o == owner
			}
			if !found {
				sellers[i.Definition] = append(sellers[i.Definition], owner)
			}
		}
		if vending[i.Location.Store] {
			machine[i.Definition] = true
		}
	}
	for d := range sellers {
		sort.Strings(sellers[d])
	}
	return sellers, machine
}
