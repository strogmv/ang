    if(!new Plane(Vector3.up,new Vector3(0,s.elevation_mm*.001f,0)).Raycast(ray,out enter)||enter>=best)continue;var p=ray.GetPoint(enter);
    int px=(int)Math.Floor(p.x/meters),py=(int)Math.Floor(p.z/meters);if(px<0||py<0||px>=locationSDKNav.plan_width||py>=locationSDKNav.plan_depth||!LocationSDKSlabAt(s,px,py))continue;
