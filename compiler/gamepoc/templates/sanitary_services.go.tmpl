		return textError{Key: "sanitary.error.unavailable"}
	}
	m := r.state.Life.GateModel(r.world.Life)
	path := m.Space(a.Level, r.state.Life.BlockedCells(a.Level, a.ID)).Path(a.Position, u.EntryCell, behavior.Cell{}, 0)
	if a.Position != u.EntryCell && len(path) == 0 {
		return textError{Key: "sanitary.error.path"}
	}
	before := r.state.Life.Clone()
	a.CombatHold = false
	a.Manual = true
	a.RestFootprint = nil
	a.OverrideLevel = a.Level
	a.OverrideAt = u.EntryCell
	a.OverrideEdge = ""
	a.Arrived = false
	a.Path = path
	a.PendingPath = nil
	a.Goal = u.EntryCell
	a.MoveStartTick = r.lifeMotionTick()
	a.Activity = "walking"
	a.Label = "sanitary.phase.approach"
	if a.ID == playerActorID && m.BodyCapable(a.Level) {
		r.state.Life.EnsureHeroBody(m)
		if !r.state.Life.HeroBodyRouteTo(m, u.EntryCell) {
			r.state.Life = before
			return textError{Key: "sanitary.error.path"}
		}
