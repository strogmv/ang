		r.autosaveWhenDue()
		if len(r.jobs) != 1 || r.saves.pending != 1 {
			t.Fatalf("%q save: %d jobs, %d pending", kind, len(r.jobs), r.saves.pending)
		}
		drainDisk(r)
		if r.saves.playedNS != 0 || r.saves.pending != 0 {
			t.Fatalf("a %q save did not restart the autosave clock", kind)
		}
	}
	r.saves.playedNS = 42
	r.testCommand(c, loadRequest(r, "load", manual[0], ""))
	if a := answer(t, c, "load"); !a.Ok || r.saves.playedNS != 0 {
		t.Fatalf("a load did not restart the autosave clock (%s)", a.Message)
	}
	r.saves.playedNS = 42
	r.testCommand(c, input{msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "new"}}}})
	if a := answer(t, c, "new"); !a.Ok || r.saves.playedNS != 0 {
		t.Fatalf("a new game did not restart the autosave clock (%s)", a.Message)
	}
	// with no game the clock stands
	r.state.Active = false
	start := time.Now()
	r.advance(start)
	r.advance(start.Add(time.Second))
	if r.saves.playedNS != 0 || len(r.jobs) != 0 {
		t.Fatal("the autosave clock ran with no game")
	}
	if r.localText("en", "ui.save.quick_done", "") != "Quick save" {
