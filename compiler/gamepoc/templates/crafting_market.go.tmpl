}

// ---------------------------------------------------------------- time: restock and residents
func (r *Runtime) advanceCraftingMarket() {
	m := r.world.Crafting
	now := r.state.Life.Seconds
	ms := &r.state.Crafting.Market
	// each master looks into the box every half hour of the world (a closed stall waits for the next look)
	for _, rule := range m.Market.Restock {
		key := rule.Master + "/" + rule.Class
		if now-ms.Restocked[key] < 1800 {
			continue
		}
		if ms.Restocked == nil {
			ms.Restocked = map[string]int64{}
		}
		ms.Restocked[key] = now
		if master, _ := m.Master(rule.Master); r.storefrontOpen(master.Shop) {
			r.craftingRestock(master, rule)
		}
	}
	day := now / 86400
	if day > ms.WearDay {
		r.craftingResidentWear(day - ms.WearDay)
		ms.WearDay = day
	}
	// residents look at their things every ten minutes of the market hours (not every tick)
	hour := (now % 86400) / 3600
	if hour >= m.Market.ResidentRule.FromHour && hour < m.Market.ResidentRule.ToHour && now-ms.Restocked["residents"] >= 600 {
		if ms.Restocked == nil {
			ms.Restocked = map[string]int64{}
		}
		ms.Restocked["residents"] = now
		r.craftingResidentOrders(day)
	}
}

// craftingBox: the units of a class in a master's working box.
func (r *Runtime) craftingBox(ms crafting.Master, class string) int64 {
	var n int64
	for _, s := range r.craftingMasterStacks(ms) {
		if c, _, ok := r.world.Crafting.PartOf(s.Definition); ok && c.ID == class && r.state.Inventory.Items[s.ID].Location.Store == ms.Stores[len(ms.Stores)-1] {
			n += s.Quantity
		}
	}
	return n
}

// craftingRestock: below the mark the master takes from the own counter, buys at another stall or the system terminal
// (the ordinary purchase of an NPC), or buys a thing whose salvage yields the class and takes it apart in the box.
func (r *Runtime) craftingRestock(ms crafting.Master, rule crafting.Restock) {
	m := r.world.Crafting
	box := ms.Stores[len(ms.Stores)-1]
	need := rule.Buy
	if r.craftingBox(ms, rule.Class) >= rule.Below {
		return
	}
	vending := map[string]bool{}
	for _, u := range r.world.Vending.Units {
		vending[u.DisplayStore] = true
	}
	shopOf := map[string]string{}
	for _, sh := range r.world.Inventory.Shopfronts {
		shopOf[sh.DisplayStore] = sh.Owner
	}
	salvage := map[string]bool{}
	for _, rec := range m.Recipes {
		for _, y := range rec.Yields {
			if rec.Kind == "disassemble" && y.Class == rule.Class && y.Max > 0 && m.Knows(r.craftingWorker(ms.Actor), rec) {
				salvage[rec.Target] = true
			}
		}
	}
	for _, from := range rule.From {
		for _, id := range sortedCraftingItems(r.state.Inventory) {
			if need <= 0 {
				return
			}
			i := r.state.Inventory.Items[id]
			class, _, isPart := m.PartOf(i.Definition)
			if !i.ForSale || i.Location.Kind != "store" || i.Quantity < 1 {
				continue
			}
			wanted := isPart && class.ID == rule.Class
			switch from {
			case "own":
				if !wanted || i.Owner != ms.Actor || i.Location.Store != ms.Stores[0] {
					continue
				}
				n := min(need, i.Quantity)
				mv := inv.Relocate{Item: id, Quantity: n, To: inv.Location{Kind: "store", Store: box}, Owner: ms.Actor}
				if n < i.Quantity {
					mv.Split = fmt.Sprintf("instance:craft:restock:%s:%d", ms.Actor, r.state.Crafting.Serial+1)
					r.state.Crafting.Serial++
				}
				if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: []inv.Relocate{mv}}); err == nil {
					need -= n
				}
			case "market", "vending", "salvage":
				seller, atStall := shopOf[i.Location.Store]
				if from == "market" && (!wanted || !atStall || seller == ms.Actor) || from == "vending" && (!wanted || !vending[i.Location.Store]) || from == "salvage" && !salvage[i.Definition] {
					continue
				}
				for need > 0 {
					cur, ok := r.state.Inventory.Items[id]
					if !ok || cur.Quantity < 1 || !cur.ForSale {
						break
					}
					bought, ok := r.craftingNPCBuy(ms.Actor, cur)
					if !ok {
						break
					}
					if from == "salvage" {
						r.craftingMasterSalvage(ms, bought)
						need = 0
						break
					}
					if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: []inv.Relocate{{Item: bought, Quantity: 1, To: inv.Location{Kind: "store", Store: box}, Owner: ms.Actor}}}); err != nil {
						break
					}
					need--
				}
			}
		}
	}
}

