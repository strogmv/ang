	if !ok || acc.Balance < price {
		return textError{Key: "crafting.error.no_money"}
	}
	if client == r.world.Crafting.Hero.Actor && r.state.Crafting.Law.Frozen && price > 0 {
		return textError{Key: "crafting.error.frozen"}
	}
	t := inv.Transform{Relocate: r.craftingHold(job, &p, ms.OrderStore, "")}
	if price > 0 {
		t.Payments = append(t.Payments, r.craftingPayment(acc.ID, ms.Account, price))
	}
