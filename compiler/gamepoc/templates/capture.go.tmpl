 r.expireSounds();r.hearSounds();r.cameraStep()
 for i:=range d.Agents{
  a:=&d.Agents[i];if a.Task=="extra_work"&&r.state.Tick>=a.BusyUntil{a.Task="patrol";r.demoEvent(a.Name+": дополнительная работа закончена")}
  r.thinkAgent(i)
 }
