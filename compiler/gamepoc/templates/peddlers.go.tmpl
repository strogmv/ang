// peddlerSell: one unit of a tray piece to a buyer (the hero, or a master restocking) at the law's price, in one atomic
// inventory transaction of the buyer: the piece into the buyer's own store, the price from his CRD account to the
// peddler's. It returns the instance id the buyer holds now and the price.
func (r *Runtime) peddlerSell(p peddlerDef, buyer string, item inv.Item, to inv.Location, sequence uint64, tag string) (string, int64, error) {
	if !item.ForSale || item.Owner != p.Actor || item.Location != (inv.Location{Kind: "store", Store: p.Tray}) || item.Quantity < 1 {
		return "", 0, errors.New("not on the tray")
	}
	price := r.peddlerLawPrice(item, r.craftingClassStock())
	from, ok1 := r.peddlerAccount(buyer)
	into, ok2 := r.peddlerAccount(p.Actor)
	if price < 1 || !ok1 || !ok2 || from.Balance < price {
		return "", price, errors.New("funds")
	}
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		return "", price, err
	}
	if sequence == 0 {
		sequence = r.state.Inventory.Cursors[buyer].Sequence + 1
	}
	tx := inv.Transaction{Actor: buyer, Sequence: sequence, RequestTag: tag,
		Moves:    []inv.Move{{Item: item.ID, Quantity: 1, ExpectedRevision: item.Revision, To: to, ChangeOwner: true, Owner: buyer}},
		Payments: []inv.Payment{{From: from.ID, To: into.ID, Currency: "CRD", Amount: price, FromRevision: from.Revision, ToRevision: into.Revision}}}
	res, err := r.state.Inventory.Apply(r.inventoryModelFor(true), tx)
	if err != nil {
		return "", price, err
	}
	if len(res.Created) > 0 {
		return res.Created[0], price, nil
	}
	return item.ID, price, nil
}

// peddlerCommand takes the hero's inventory commands that concern a peddler: "buy" of a piece on a tray, "sell" of a
// carried thing to a peddler who buys (store_id = his tray). It returns false for every other command.
func (r *Runtime) peddlerCommand(c *connection, q *pb.PocInventoryCommand, tag string, result *pb.PocInventoryResult) bool {
	if len(r.world.Peddlers.Peddlers) == 0 || !r.state.Life.Enabled {
		return false
	}
	locale := ""
	if c != nil {
		locale = c.locale
	}
	var p peddlerDef
	var ok bool
	switch q.Action {
	case "buy":
		item, found := r.state.Inventory.Items[q.ItemId]
		if !found || item.Location.Kind != "store" {
			return false
		}
		if p, ok = r.peddlerOfStore(item.Location.Store); !ok {
			return false
		}
	case "sell":
		if p, ok = r.peddlerOfStore(q.StoreId); !ok {
			return false
		}
	default:
		return false
	}
	refuse := func(key, item string) bool {
		r.peddlerHeroResult(p, key, item, 0)
		r.peddlerNote(peddlerDeal{Peddler: p.Actor, Kind: "refused", Item: item, Buyer: playerActorID, Second: r.state.Life.Seconds})
		result.Ok = false
		result.Message = r.peddlerText(locale, key, item, 0)
		return true
	}
	if r.state.Paused {
		return refuse("ui.peddler.refused.closed", "")
	}
	if !r.peddlerHeroNear(p) {
		return refuse("ui.peddler.refused.away", "")
	}
	stock := r.craftingClassStock()
	if q.Action == "buy" {
		item := r.state.Inventory.Items[q.ItemId]
		if item.Location.Store != p.Tray || !item.ForSale || item.Revision != q.ExpectedRevision {
			return refuse("ui.peddler.refused.stock", item.Definition)
		}
		price := r.peddlerLawPrice(item, stock)
		if hero, ok := r.peddlerAccount(playerActorID); !ok || hero.Balance < price {
			return refuse("ui.peddler.refused.funds", item.Definition)
		}
		if _, paid, err := r.peddlerSell(p, playerActorID, item, inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, q.Sequence, tag); err != nil {
			return refuse("ui.peddler.refused.stock", item.Definition)
		} else {
			price = paid
		}
		r.peddlerHeroResult(p, "ui.peddler.result.bought", item.Definition, price)
		r.peddlerNote(peddlerDeal{Peddler: p.Actor, Kind: "sold", Item: item.Definition, Buyer: playerActorID, Minor: price, Second: r.state.Life.Seconds})
		r.focusActor(playerActorID, item.ID)
		result.Ok = true
		result.Message = r.peddlerText(locale, "ui.peddler.result.bought", item.Definition, price)
		return true
	}
	// sell: one unit of a carried thing the peddler takes, paid from his account, onto his tray for sale
	item, found := r.state.Inventory.Items[q.ItemId]
	if !found || item.Revision != q.ExpectedRevision || !r.carried(item) || item.Quantity < 1 {
		return refuse("ui.peddler.refused.not_accepted", "")
	}
	price, takes := r.peddlerBuyPrice(p, item, stock)
	if !takes {
		return refuse("ui.peddler.refused.not_accepted", item.Definition)
	}
	hero, ok1 := r.peddlerAccount(playerActorID)
	cash, ok2 := r.peddlerAccount(p.Actor)
	if !ok1 || !ok2 || cash.Balance < price {
		return refuse("ui.peddler.refused.cash", item.Definition)
	}
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		return refuse("ui.peddler.refused.not_accepted", item.Definition)
	}
	tx := inv.Transaction{Actor: playerActorID, Sequence: q.Sequence, RequestTag: tag,
		Moves:    []inv.Move{{Item: item.ID, Quantity: 1, ExpectedRevision: item.Revision, To: inv.Location{Kind: "store", Store: p.Tray}, ChangeOwner: true, Owner: p.Actor, Sell: true}},
		Payments: []inv.Payment{{From: cash.ID, To: hero.ID, Currency: "CRD", Amount: price, FromRevision: cash.Revision, ToRevision: hero.Revision}}}
	if _, err := r.state.Inventory.Apply(r.inventoryModelFor(true), tx); err != nil {
		return refuse("ui.peddler.refused.not_accepted", item.Definition)
	}
	r.peddlerHeroResult(p, "ui.peddler.result.sold", item.Definition, price)
	r.peddlerNote(peddlerDeal{Peddler: p.Actor, Kind: "bought", Item: item.Definition, Buyer: playerActorID, Minor: price, Second: r.state.Life.Seconds})
	result.Ok = true
	result.Message = r.peddlerText(locale, "ui.peddler.result.sold", item.Definition, price)
	return true
}

// peddlerTray: the store is a peddler's tray (the masters' restock buys off it only through peddlerNPCBuy).
func (r *Runtime) peddlerTray(store string) bool { _, ok := r.peddlerOfStore(store); return ok }

// peddlerNPCBuy: a master restocks off a peddler whose stop is within deal_cells of his counter approach, at the law's
// price, into his hands (the restock then moves it into his working box).
func (r *Runtime) peddlerNPCBuy(ms crafting.Master, item inv.Item) (string, bool) {
	p, ok := r.peddlerOfStore(item.Location.Store)
	if !ok || r.peddlerStopNow(p) == "" {
		return "", false
	}
	a := r.state.Life.Actor(p.Actor)
	if a == nil || a.Level != ms.Level || manhattan(location(a.Position), point{ms.Approach.X, ms.Approach.Y}) > r.world.Peddlers.DealCells {
		return "", false
	}
	id, price, err := r.peddlerSell(p, ms.Actor, item, inv.Location{Kind: "store", Store: inv.ActorStore(ms.Actor)}, 0, fmt.Sprintf("peddler/%s/%s/%d", p.Shop, ms.Actor, r.state.Life.Seconds))
	if err != nil {
		return "", false
	}
	r.peddlerNote(peddlerDeal{Peddler: p.Actor, Kind: "master", Item: item.Definition, Buyer: ms.Actor, Minor: price, Second: r.state.Life.Seconds})
	return id, true
}

// peddlerRareMoment: the Life second the rare piece comes out of the bag in this game (by the seed), or -1 if not in this
// game (the chance) — one day of the first week, between the window's hours.
func (r *Runtime) peddlerRareMoment(p peddlerDef) int64 {
	w := r.world.Peddlers.RareWindow
	roll := func(stream string) uint64 { return barks.Roll(r.state.Seed, "peddlers."+stream, p.Shop, 0) }
	if int64(roll("chance")%1000) >= p.Rare.ChancePermille {
		return -1
	}
	day := w.FirstDay + int64(roll("day")%uint64(w.LastDay-w.FirstDay+1))
	second := w.FromHour*3600 + int64(roll("hour")%uint64((w.ToHour-w.FromHour)*3600))
	return (day-1)*86400 + second
}

// advancePeddlers: the rare piece comes out onto the tray when its moment has come and the peddler stands at a stop
// (the bag opens only inside this transaction); the journal forgets old deals.
func (r *Runtime) advancePeddlers() error {
	if len(r.world.Peddlers.Peddlers) == 0 || !r.state.Life.Enabled {
		return nil
	}
	now := r.state.Life.Seconds
	for _, p := range r.world.Peddlers.Peddlers {
		if r.state.Peddlers.Rare[p.Shop] > 0 {
			continue
		}
		at := r.peddlerRareMoment(p)
		if at < 0 || now < at || r.peddlerStopNow(p) == "" {
			continue
		}
		moves := []inv.Move{}
		for _, id := range sortedCraftingItems(r.state.Inventory) {
			if i := r.state.Inventory.Items[id]; i.Location == (inv.Location{Kind: "store", Store: p.Bag}) && i.Owner == p.Actor {
				moves = append(moves, inv.Move{Item: id, Quantity: i.Quantity, ExpectedRevision: i.Revision, To: inv.Location{Kind: "store", Store: p.Tray}})
			}
		}
		if r.state.Peddlers.Rare == nil {
			r.state.Peddlers.Rare = map[string]int64{}
		}
		r.state.Peddlers.Rare[p.Shop] = max(now, 1)
		if len(moves) == 0 {
			continue
		}
		if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
			return err
		}
		tx := inv.Transaction{Actor: p.Actor, Sequence: r.state.Inventory.Cursors[p.Actor].Sequence + 1, RequestTag: fmt.Sprintf("peddler/%s/rare", p.Shop), Moves: moves}
		if _, err := r.vendingApplyUnlocked(r.inventoryModelFor(true), tx, p.Bag); err != nil {
			return err
		}
	}
	keep := r.state.Peddlers.Journal[:0]
	for _, d := range r.state.Peddlers.Journal {
		if now-d.Second <= 4*r.world.Peddlers.FactSeconds {
			keep = append(keep, d)
		}
	}
	r.state.Peddlers.Journal = keep
	if len(keep) == 0 {
		r.state.Peddlers.Journal = nil
	}
	for id, h := range r.state.Peddlers.Hero {
		if h.Until <= r.state.Tick {
			delete(r.state.Peddlers.Hero, id)
		}
	}
	if len(r.state.Peddlers.Hero) == 0 {
		r.state.Peddlers.Hero = nil
	}
	return nil
}

// peddlerDealNow: the last deal of the peddler within the fact window (sold, bought, refused, master), else "".
func (r *Runtime) peddlerDealNow(actor string) string {
	now := r.state.Life.Seconds
	for i := len(r.state.Peddlers.Journal) - 1; i >= 0; i-- {
		if d := r.state.Peddlers.Journal[i]; d.Peddler == actor && now-d.Second <= r.world.Peddlers.FactSeconds {
			return d.Kind
		}
	}
	return ""
}

// peddlerFacts: the barks facts of the hero's deals with the peddlers of the level (speaker scope: the peddler).
func (r *Runtime) peddlerFacts(level string) []barks.Fact {
	if r.world.Peddlers.Level != level {
		return nil
	}
	now := r.state.Life.Seconds
	latest := map[string]int64{}
	for _, d := range r.state.Peddlers.Journal {
		if d.Buyer != playerActorID || now-d.Second > r.world.Peddlers.FactSeconds {
			continue
		}
		k := "peddler." + d.Kind + "|" + d.Peddler
		latest[k] = max(latest[k], max(d.Second, 1))
	}
	out := []barks.Fact{}
	for _, k := range peddlerKeys(latest) {
		parts := strings.SplitN(k, "|", 2)
		out = append(out, barks.Fact{Event: parts[0], Subject: parts[1], Level: level, Since: latest[k]})
	}
	return out
}

func (r *Runtime) peddlerGradeText(locale string, i inv.Item) string {
	q, o := r.peddlerGrade(i)
	if q < 1 {
		return ""
	}
	t := r.localText(locale, "ui.peddler.grade", "q{q} · {origin}")
	t = strings.ReplaceAll(t, "{q}", fmt.Sprint(q))
	return strings.ReplaceAll(t, "{origin}", r.localText(locale, "ui.peddler.origin."+o, o))
}

// appendPeddlers: every peddler the hero sees (what he carries, at a stop or walking, his last deal) and, for the one the
// hero stands next to at a stop, the tray with the law's prices and what he would buy from the hero.
func (r *Runtime) appendPeddlers(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView, locale string) {
	if hero == nil || !hero.OnFloor() || len(r.world.Peddlers.Peddlers) == 0 {
		return
	}
	scale := r.world.Inventory.Currencies["CRD"].Scale
	day := r.state.Life.Seconds % 86400
	for _, p := range r.world.Peddlers.Peddlers {
		a := r.state.Life.Actor(p.Actor)
		if a == nil || a.Level != hero.Level || !a.OnFloor() || !viewSees(perception, int32(a.Position.X), int32(a.Position.Y)) {
			continue
		}
		stop := r.peddlerStopNow(p)
		phase := "walk"
		switch {
		case stop != "":
			phase = "stop"
		case day < p.OpenSecond || day >= p.CloseSecond:
			phase = "off"
		}
		out := &pb.PocPeddler{Id: p.Actor, Kind: p.Kind, Phase: phase, Deal: r.peddlerDealNow(p.Actor), Name: r.localText(locale, p.Name, p.Name), StoreId: p.Tray, Permit: p.Permit, Stop: stop}
		if h, ok := r.state.Peddlers.Hero[p.Actor]; ok && h.Until > r.state.Tick {
			out.Message = r.peddlerText(locale, h.Key, h.Item, h.Minor)
		}
		if r.peddlerHeroNear(p) && !r.heroInCombat() {
			out.Active = true
			stock := r.craftingClassStock()
			heroCRD, _ := r.peddlerAccount(playerActorID)
			for _, id := range sortedCraftingItems(r.state.Inventory) {
				i := r.state.Inventory.Items[id]
				if i.Location != (inv.Location{Kind: "store", Store: p.Tray}) || !i.ForSale || i.Hidden {
					continue
				}
				d := r.world.Inventory.Definitions[i.Definition]
				price := r.peddlerLawPrice(i, stock)
				o := &pb.PocVendingOffer{ItemId: i.ID, Name: r.localText(locale, d.Name, d.Name), Quantity: i.Quantity, Price: inv.FormatMoney(price, scale), Revision: i.Revision, Ok: heroCRD.Balance >= price, Definition: i.Definition, Reason: r.peddlerGradeText(locale, i)}
				if !o.Ok {
					o.Reason = r.localText(locale, "ui.peddler.refused.funds", "ui.peddler.refused.funds")
				}
				out.Offers = append(out.Offers, o)
			}
			sort.SliceStable(out.Offers, func(x, y int) bool { return out.Offers[x].Name < out.Offers[y].Name })
			if p.Buys != nil {
				cash, _ := r.peddlerAccount(p.Actor)
				out.Cash = inv.FormatMoney(cash.Balance, scale)
				for _, id := range sortedCraftingItems(r.state.Inventory) {
					i := r.state.Inventory.Items[id]
					if !r.carried(i) || i.Hidden {
						continue
					}
					price, takes := r.peddlerBuyPrice(p, i, stock)
					if !takes {
						continue
					}
					d := r.world.Inventory.Definitions[i.Definition]
					o := &pb.PocVendingOffer{ItemId: i.ID, Name: r.localText(locale, d.Name, d.Name), Quantity: i.Quantity, Price: inv.FormatMoney(price, scale), Revision: i.Revision, Ok: cash.Balance >= price, Definition: i.Definition}
					o.Reason = strings.ReplaceAll(r.localText(locale, "ui.peddler.weight", "{g} g"), "{g}", fmt.Sprint(d.Mass))
					if !o.Ok {
						o.Reason = r.localText(locale, "ui.peddler.refused.cash", "ui.peddler.refused.cash")
					}
					out.Buyback = append(out.Buyback, o)
				}
			}
		}
		view.Peddlers = append(view.Peddlers, out)
	}
}

func (r *Runtime) validatePeddlerSave(s state) error {
 if err:=r.validateCartParkingSave(s);err!=nil{return err}
	if len(s.Peddlers.Journal) > peddlerJournalMax {
		return errors.New("peddler journal too long")
	}
	shops := map[string]bool{}
	actors := map[string]bool{}
	for _, p := range r.world.Peddlers.Peddlers {
		shops[p.Shop], actors[p.Actor] = true, true
	}
	for _, d := range s.Peddlers.Journal {
		if !actors[d.Peddler] || d.Second < 0 || d.Second > s.Life.Seconds || d.Minor < 0 {
			return errors.New("invalid peddler deal")
		}
	}
	for shop, at := range s.Peddlers.Rare {
		if !shops[shop] || at < 1 || at > s.Life.Seconds {
			return errors.New("invalid peddler rare piece")
		}
	}
	for actor := range s.Peddlers.Hero {
		if !actors[actor] {
			return errors.New("invalid peddler result")
		}
	}
	return nil
}

func peddlerKeys[T any](m map[string]T) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	sort.Strings(out)
	return out
}
