// Code generated by ANG. Visible boarding is separate from elapsed travel.
package poc

import (
 "fmt"
 "angelsdemons/server/internal/behavior"
)

type trainPassenger struct {Edge string; Run int64; BoardNS,DepartNS int64; Paid bool}
func cloneTrainPassengers(in map[string]trainPassenger)map[string]trainPassenger{if in==nil{return nil};out:=make(map[string]trainPassenger,len(in));for k,v:=range in{out[k]=v};return out}
func(r *Runtime)isVisibleRailEdge(e behavior.LifeEdge)bool{c:=r.world.TrainMotion;return c!=nil&&c.BerthEdgeID!=""&&e.ID==c.BerthEdgeID&&e.From==c.BerthLevelID&&e.Mode=="rail"}
func(r *Runtime)lifeTravelModel()behavior.LifeModel{m:=r.world.Life;m.TravelOverride=r.observedRailTravel;m.ArrivalHold=r.liftingDeckArrivalHeld;return m}
func(r *Runtime)populationTrainActor(id string)*behavior.PopulationActor{for i:=range r.state.Life.Population.Actors{a:=&r.state.Life.Population.Actors[i];if a.ID==id{return a}};return nil}
func(r *Runtime)observingRailLevel(level string)bool{h:=r.state.Life.Actor(playerActorID);return r.client!=nil&&h!=nil&&h.Trip==nil&&h.Level==level}
// The behavior kernel calls this at the real exit, before its timetable branch.
// Unobserved NPCs retain their original Life slots and accounting.
func(r *Runtime)observedRailTravel(id string,e behavior.LifeEdge)(bool,bool){
 if !r.isVisibleRailEdge(e){return false,false}
 if _,boarded:=r.state.TrainPassengers[id];boarded{return true,false}
 if id!=playerActorID&&!r.observingRailLevel(e.From){return false,false}
 a:=r.state.Life.Actor(id);p:=r.populationTrainActor(id)
 if a==nil&&p==nil{return false,false}
 waiting:=func(label string){if a!=nil{a.Activity="waiting";a.Label=label}else{p.Activity="waiting_departure"}}
 s:=r.state.TrainDispatch;c:=r.world.TrainMotion;ns:=r.simNS()
 _,_,phase,doors:=c.dispatchPose(s,ns)
 if s.Active!=1||phase!="berthed"||!doors{waiting("ui.train.wait_visible");return true,false}
 seats:=0;for _,v:=range r.state.TrainPassengers{if v.Run==s.Run{seats++}}
 if seats>=e.Seats{waiting("ui.train.full");return true,false}
 paid:=false
 if id==playerActorID{
  if a.AdmissionDeniedEdge==e.ID{return true,false}
  if !r.admitLifeTravel(id,e){a.AdmissionDeniedEdge=e.ID;waiting("transit.fare_denied");return true,false};paid=true
 }
 if r.state.TrainPassengers==nil{r.state.TrainPassengers=map[string]trainPassenger{}}
 r.state.TrainPassengers[id]=trainPassenger{Edge:e.ID,Run:s.Run,BoardNS:ns,DepartNS:s.DepartNS+int64(c.DoorCloseSeconds*1e9),Paid:paid}
 if a!=nil{a.BoardedEdge=e.ID;a.Path=nil;a.PendingPath=nil;a.Body=nil;a.Activity="boarding";a.Label="ui.train.boarded";a.AdmissionDeniedEdge=""}else{p.BoardedEdge=e.ID;p.Path=nil;p.Queued=false;p.QueueReason="";p.Activity="boarding"}
 return true,false
}
func(r *Runtime)advanceTrainPassengers(delta int64){
 ns:=r.state.Tick*r.tickNS()
 for id,p:=range r.state.TrainPassengers{
  if ns<p.DepartNS{continue}
  e:=r.world.Life.Edge(p.Edge);if e==nil{continue}
  departure:=r.state.Life.Seconds+delta
  if a:=r.state.Life.Actor(id);a!=nil{a.BoardedEdge="";a.Trip=&behavior.LifeTrip{Edge:e.ID,Departure:departure,Arrival:departure+e.TravelSeconds};a.WaitingDeparture=departure;a.Path=nil;a.PendingPath=nil;a.Body=nil;a.Activity="transit";a.Label="Едет на монорельсе"}else if a:=r.populationTrainActor(id);a!=nil{a.BoardedEdge="";a.Materialized=false;a.Trip=&behavior.PopulationTrip{Edge:e.ID,Departure:departure,Arrival:departure+e.TravelSeconds};a.WaitingDeparture=departure;a.Activity="transit"}
  delete(r.state.TrainPassengers,id)
 }
}
func(r *Runtime)validateTrainPassengers(s state)error{
 for id,p:=range s.TrainPassengers{
  e:=r.world.Life.Edge(p.Edge);if e==nil||!r.isVisibleRailEdge(*e)||p.DepartNS<=s.Tick*r.tickNS()||p.Run!=s.TrainDispatch.Run||s.TrainDispatch.Active!=1||p.BoardNS<0||p.BoardNS>s.Tick*r.tickNS()+s.PhaseNS||p.DepartNS!=s.TrainDispatch.DepartNS+int64(r.world.TrainMotion.DoorCloseSeconds*1e9)||p.BoardNS<s.TrainDispatch.StartNS+int64(r.world.TrainMotion.approachSeconds()*1e9)||p.BoardNS>=s.TrainDispatch.DepartNS||p.Paid!=(id==playerActorID){return fmt.Errorf("invalid saved train passenger %s",id)}
  found:=false
  if a:=s.Life.Actor(id);a!=nil{found=a.BoardedEdge==e.ID&&a.Level==e.From&&a.Position==e.Exit&&a.Trip==nil&&a.Body==nil&&len(a.Path)==0&&len(a.PendingPath)==0}else{for _,a:=range s.Life.Population.Actors{if a.ID==id{found=a.BoardedEdge==e.ID&&a.Level==e.From&&a.Position==e.Exit&&a.Trip==nil&&!a.Materialized&&len(a.Path)==0}}}
  if !found{return fmt.Errorf("saved boarded actor missing %s",id)}
 }
 for _,a:=range s.Life.Actors{if a.BoardedEdge!=""{if _,ok:=s.TrainPassengers[a.ID];!ok{return fmt.Errorf("orphan boarded actor %s",a.ID)}}}
 for _,a:=range s.Life.Population.Actors{if a.BoardedEdge!=""{if _,ok:=s.TrainPassengers[a.ID];!ok{return fmt.Errorf("orphan boarded resident %s",a.ID)}}}
 return nil
}
