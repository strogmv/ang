// Code generated by ANG. Actual CUE world, finite inventory, normal life frames.
package poc
import("testing";"encoding/json";"fmt";"reflect";"strings";"angelsdemons/server/internal/behavior";inv "angelsdemons/server/internal/inventory";pb "angelsdemons/server/internal/transport/grpc/pb/game/v1")
func npcMoney(r *Runtime)int64{var n int64;for _,a:=range r.state.Inventory.Accounts{n+=a.Balance};return n}
func TestNPC1ClosedShopUsesAnotherAndConservesMoney(t *testing.T){
 r:=worldAuditRuntime(t,0);id:="char.roommate_senya";r.state.Life.Seconds=12*3600
 // Staff every shop at its genuine service post; close only the first food shop.
 for _,sh:=range r.world.Inventory.Shopfronts{a:=r.state.Life.Actor(sh.Owner);a.ResidenceID="";a.Level=sh.Service.Level;a.Position=behavior.Cell{X:sh.Service.At.X,Y:sh.Service.At.Y};a.Path=nil;a.Trip=nil;r.state.Inventory.Shopfronts[sh.ID]=inv.ShopProgress{Open:true}}
 if e:=r.advanceMarketSupply();e!=nil{t.Fatal(e)}
 var food []behavior.LifeAffordance;for _,p:=range r.world.Life.Brain.Places{if p.Kind=="market_food"{food=append(food,p)}}
 if len(food)<2{t.Fatal("need two authored food shops")}
 for _,sh:=range r.world.Inventory.Shopfronts{if sh.DisplayStore==food[0].Store{r.state.Inventory.Shopfronts[sh.ID]=inv.ShopProgress{Open:false}}}
 offers:=r.npcOffers(id,"market_food","level.c7_market");if len(offers)==0{a,ok:=r.npcAccount(id);t.Logf("account %+v %v",a,ok);for _,p:=range food{t.Logf("shop %s access %v",p.ID,r.commerceAccessible(id,inv.Location{Kind:"store",Store:p.Store}));for _,i:=range r.state.Inventory.Items{if i.Location.Store==p.Store{t.Logf("item %+v",i)}}};t.Fatal("no replacement")};for _,p:=range offers{if p.ID==food[0].ID{t.Fatal("closed shop offered")}}
 buyer:=r.state.Life.Actor(id);buyer.Level=offers[0].Level;buyer.Position=offers[0].At;buyer.Path=nil;buyer.Trip=nil;buyer.Arrived=true;buyer.ResidenceID=""
 money:=npcMoney(r);stock:=commerceTotal(r.state.Inventory);if !r.npcBuy(id,offers[0],true){t.Fatal("alternative purchase failed")}
 if r.state.NPCEconomy.Purchases!=1||r.state.NPCEconomy.Turnover!=200||npcMoney(r)!=money||commerceTotal(r.state.Inventory)!=stock-1{t.Fatal("purchase not conserved at catalog price 2 CRD")}
 if len(r.state.NPCEconomy.BySeller)!=1{t.Fatal("seller revenue not recorded")}
 if len(r.state.NPCEconomy.UnitsBySeller)!=1{t.Fatal("seller units not recorded")};for owner,n:=range r.state.NPCEconomy.UnitsBySeller{if n!=1||r.state.NPCEconomy.BySeller[owner]!=200{t.Fatalf("seller units/revenue %d/%d",n,r.state.NPCEconomy.BySeller[owner])}}
}
// Debug-only HUD projection: decision journal + commerce counters, absent without debug_perception.
func TestNPC1DebugJournalProjection(t *testing.T){
 r:=worldAuditRuntime(t,20);for i:=0;i<600;i++{r.state.Tick++;if e:=r.advanceLifeFrameBy(1);e!=nil{t.Fatal(e)}}
 r.world.Config.DebugPerception=true;view:=&pb.PocLifeView{};r.appendNPCDebugJournal(view)
 decisions,economy:=0,"";for _,line:=range view.Events{if strings.HasPrefix(line,"Решение NPC ")&&strings.Contains(line," · причина: "){decisions++};if strings.HasPrefix(line,"Экономика NPC · покупок "){economy=line}}
 if decisions==0||decisions>npcDebugDecisionLines||economy==""||economy!=view.Events[len(view.Events)-1]{t.Fatalf("debug journal projection: %d decisions, economy %q",decisions,economy)}
 if !strings.Contains(economy,fmt.Sprintf("сумма счетов %d",npcMoney(r))){t.Fatalf("economy line total differs: %s",economy)}
 r.world.Config.DebugPerception=false;hidden:=&pb.PocLifeView{};r.appendNPCDebugJournal(hidden);if len(hidden.Events)!=0{t.Fatal("decision journal leaked without debug perception")}
}
func TestNPC1ReplayAndActualSave(t *testing.T){
 if testing.Short(){t.Skip("real life replay")};a:=worldAuditRuntime(t,100);b:=worldAuditRuntime(t,100)
 for i:=0;i<7200;i++{for _,r:=range []*Runtime{a,b}{r.state.Tick++;if e:=r.advanceLifeFrameBy(1);e!=nil{t.Fatal(e)}}}
 if worldLifeHash(a)!=worldLifeHash(b){t.Fatal("same seed differs")}
 slot:=a.world.Config.SaveSlots[0];if e:=a.writeSave(slot,a.snapshotState());e!=nil{t.Fatal(e)};loaded,_,e:=a.readSave(slot);if e!=nil{t.Fatal(e)};raw,e:=json.Marshal(loaded);if e!=nil{t.Fatal(e)};c:=worldAuditRuntime(t,0);c.state=state{};if e=json.Unmarshal(raw,&c.state);e!=nil{t.Fatal(e)}
 if e=c.state.Life.Validate(c.world.Life,c.state.Tick);e!=nil{t.Fatal(e)};if e=c.validateInventory(c.state);e!=nil{t.Fatal(e)}
 for i:=0;i<3600;i++{for _,r:=range []*Runtime{a,c}{r.state.Tick++;if e=r.advanceLifeFrameBy(1);e!=nil{t.Fatal(e)}}}
 if worldLifeHash(a)!=worldLifeHash(c)||!reflect.DeepEqual(a.state.NPCEconomy,c.state.NPCEconomy){for i,x:=range a.state.Life.Actors{y:=c.state.Life.Actors[i];if !reflect.DeepEqual(x,y){bx,_:=json.Marshal(x);by,_:=json.Marshal(y);t.Logf("named %s A=%s B=%s",x.ID,bx,by);break}};for i,x:=range a.state.Life.Population.Actors{y:=c.state.Life.Population.Actors[i];if !reflect.DeepEqual(x,y){bx,_:=json.Marshal(x);by,_:=json.Marshal(y);t.Logf("population %s A=%s B=%s",x.ID,bx,by);break}};t.Logf("economy A=%+v B=%+v inventory_equal=%v",a.state.NPCEconomy,c.state.NPCEconomy,reflect.DeepEqual(a.state.Inventory,c.state.Inventory));t.Fatal("loaded continuation differs")}
}

func TestNPC1SaveBudget500(t *testing.T){
 old:=worldAuditRuntimeOverride;worldAuditRuntimeOverride=func(r *Runtime){r.world.Life.Population.MaxActors=500};defer func(){worldAuditRuntimeOverride=old}()
 r:=worldAuditRuntime(t,500);for i:=0;i<120;i++{r.state.Tick++;if e:=r.advanceLifeFrameBy(1);e!=nil{t.Fatal(e)}}
 raw,e:=json.Marshal(r.snapshotState());if e!=nil{t.Fatal(e)};if len(raw)>4*1024*1024{t.Fatal("500 NPC save exceeds 4 MiB")};t.Logf("500 NPC serialized state: %d bytes",len(raw))
 slot:=r.world.Config.SaveSlots[0];if e=r.writeSave(slot,r.snapshotState());e!=nil{t.Fatal(e)};saved,_,e:=r.readSave(slot);if e!=nil{t.Fatal(e)};if saved.Life.Population.Count!=500{t.Fatal("saved population count lost")}
}

// x300 (30 s/frame): 20+10 game hours cross the night, the morning commute,
// opening and post breaks. Same seed must match, and a real disk save/load
// must continue identically, including committed legs and break deadlines.
func TestNPC1ReplayAndActualSaveX300(t *testing.T){
 if testing.Short(){t.Skip("real life replay")};const rate=int64(30)
 a:=worldAuditRuntime(t,100);b:=worldAuditRuntime(t,100);a.state.Life.SecondsPerTick=rate;b.state.Life.SecondsPerTick=rate
 for i:=0;i<2400;i++{for _,r:=range []*Runtime{a,b}{r.state.Tick++;if e:=r.advanceLifeFrameBy(rate);e!=nil{t.Fatal(e)}}}
 if worldLifeHash(a)!=worldLifeHash(b){t.Fatal("same seed differs at x300")}
 slot:=a.world.Config.SaveSlots[0];if e:=a.writeSave(slot,a.snapshotState());e!=nil{t.Fatal(e)};loaded,_,e:=a.readSave(slot);if e!=nil{t.Fatal(e)};raw,e:=json.Marshal(loaded);if e!=nil{t.Fatal(e)};c:=worldAuditRuntime(t,0);c.state=state{};if e=json.Unmarshal(raw,&c.state);e!=nil{t.Fatal(e)}
 if e=c.state.Life.Validate(c.world.Life,c.state.Tick);e!=nil{t.Fatal(e)};if e=c.validateInventory(c.state);e!=nil{t.Fatal(e)};if c.state.Life.SecondsPerTick!=rate{t.Fatal("saved calendar rate lost")}
 legs:=0;for _,x:=range a.state.Life.Actors{if x.Brain.LegEdge!=""{legs++}};if legs==0{t.Fatal("no committed travel leg exercised")}
 for i:=0;i<1200;i++{for _,r:=range []*Runtime{a,c}{r.state.Tick++;if e=r.advanceLifeFrameBy(rate);e!=nil{t.Fatal(e)}}}
 if worldLifeHash(a)!=worldLifeHash(c)||!reflect.DeepEqual(a.state.NPCEconomy,c.state.NPCEconomy){t.Fatal("loaded x300 continuation differs")}
}
