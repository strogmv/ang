   if cp.Load==on{t.Fatalf("%s at %d: hanging %v but drawn on bay %q",st.Hook,r.state.Life.Seconds,cp.Load,b)}
   if on&&b!=st.Queue[st.Move].From&&b!=st.Queue[st.Move].To{t.Fatalf("%s drawn on bay %q outside its move",st.Hook,b)}}
  // saves in the four moments the brief names
  point:="";switch{case c.Phase=="away"&&run.Legs[c.Leg].Kind=="edge":point="corridor";case c.Phase=="away"&&run.Legs[c.Leg].Kind=="deck":point="deck";case r.cargoAnyHook():point="hook";case c.Phase=="go"&&run.Legs[c.Leg].Kind=="drive"&&c.S>0:point="seats"}
  if point!=""&&!saved[point]&&replay==nil{
   saved[point]=true;snapshot:=r.snapshotState();if err:=r.validateLifeSave(snapshot);err!=nil{t.Fatalf("state %s is not a valid save: %v",point,err)}
   slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,snapshot);err!=nil{t.Fatal(err)};restored,_,err:=r.readSave(slot);if err!=nil{t.Fatalf("save %s: %v",point,err)}
   if !reflect.DeepEqual(snapshot.CargoConvoys,restored.CargoConvoys){t.Fatalf("save %s changed the convoy: %+v -> %+v",point,snapshot.CargoConvoys,restored.CargoConvoys)}
   for _,m:=range v.Crew{a,b:=snapshot.Life.Actor(m.ID),restored.Life.Actor(m.ID);if !reflect.DeepEqual(*a,*b){t.Fatalf("save %s changed rider %s: %+v -> %+v",point,m.ID,*a,*b)}}
   if !reflect.DeepEqual(snapshot.Life.Clone(),restored.Life.Clone()){t.Fatalf("save %s changed the Life state",point)}
   replay=&Runtime{world:r.world,canonicalWorld:r.canonicalWorld,sdkWorlds:r.sdkWorlds,state:restored};replayTicks=0
  }
  if c.Run==""&&c.Day==morning/86400+1{done:=true;for _,tr:=range track{done=done&&(tr.Stocked>0||tr.Units==0)};if done&&replay==nil{break}}
 }
 c:=r.state.CargoConvoys.Convoys[v.ID]
 if c.Run!=""||c.Day!=morning/86400+1{t.Fatalf("the run did not finish by %02d:00: legs %v",(deadline-morning)/3600,seenLegs)}
 for _,m:=range v.Crew{a:=r.state.Life.Actor(m.ID);if a.Mount!=nil||a.Level!=v.Home.LevelID{t.Fatalf("%s did not come home free: %s %+v",m.ID,a.Level,a.Mount)}
  for _,e:=range []string{"hub_market_freight","market_hub_freight"}{if !edges[m.ID][e]{t.Fatalf("%s did not ride the convoy on %s (rode %v)",m.ID,e,edges[m.ID])}}}
 for shop,tr:=range track{
  if tr.Units==0{continue}
  lot:=cargoLotDefinition{};for _,l:=range r.world.CargoConvoys.Lots{if l.Shop==shop{lot=l}};a:=r.state.Life.Actor(lot.Owner)
  late:=tr.Opened==0||tr.Opened>opening[shop]+3600;if rate>=30{late=tr.Opened==0}
  if brain&&tr.Landed>0&&tr.Landed<=opening[shop]&&tr.Opened==0{t.Errorf("%s: with the brain its keeper never opened the stall",shop)}
  if tr.Landed>0&&tr.Stocked==0&&late&&rate>1{
   // the cargo chain ends at the stall's locker; a keeper who did not reach his stall in time at a fast calendar (the
   // housing corridor's and the gates' old traffic, docs/godot-walkers.md «Что не сделано» 1) is reported, not counted
   // as a lost lot: it waits in his locker, the goods are all counted above
   t.Logf("%s: lot in the locker at %s; its keeper opened %s (%s %v %s)",shop,cargoHM(tr.Landed),cargoHM(tr.Opened),a.Level,a.Position,a.Label);continue}
  if tr.Landed==0||tr.Stocked==0{
