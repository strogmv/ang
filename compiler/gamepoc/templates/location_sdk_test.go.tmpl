const sdkHostTestID="test.sdk.host"
func sdkHostRuntime(t *testing.T)*Runtime {
 t.Helper();r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 ticks:=r.world.Life.MoveTicks;if ticks<1{ticks=r.world.Config.MoveEveryTicks}
 step:=ticks*(1000000000/int64(r.world.Config.TickHz))
 r.world.LocationSDK=sdkBundle{Schema:"ang.location-runtime.v1",ContentHash:"test-bundle",UnitMM:500,CellMeters:.5,TickHz:r.world.Config.TickHz,MoveEveryTicks:ticks,MovementStepNS:step,CollisionModel:"cardinal_cell_occupancy",PublicArchitecture:true,Levels:[]sdkLevel{{ID:sdkHostTestID,Scenario:"sdk:"+sdkHostTestID,UnitMM:500,CellMeters:.5,Seed:42,Width:7,Depth:5,Spawn:behavior.Cell{X:1,Y:1},Terrain:[]string{"#######","#..#..#","#..#..#","#.....#","#######"},WalkableGlyphs:[]string{"."},OpaqueGlyphs:[]string{"#"," "},InitialLayoutKnown:true,MoveEveryTicks:ticks,MovementStepNS:step}}}
 if err:=r.prepareLocationSDK();err!=nil{t.Fatal(err)};return r
}
func sdkHostNew(t *testing.T,r *Runtime,scenario,id string)*pb.PocActionResult {
 t.Helper();c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})}
 r.command(input{client:c,msg:&pb.ClientMessage{Msg:&pb.ClientMessage_NewGame{NewGame:&pb.PocNewGameRequest{Epoch:r.state.Epoch,RequestId:id,Scenario:scenario}}}})
 if len(c.out)==0{t.Fatal("new game had no response")};result:=(<-c.out).GetActionResult();if result==nil{t.Fatal("new game did not return action result")};return result
}
func sdkHostLoad(t *testing.T,r *Runtime,s state,id string) {
 t.Helper();c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})}
 r.diskComplete(diskResult{job:diskJob{client:c,id:id,action:"load",epoch:r.state.Epoch},loaded:s})
 result:=(<-c.out).GetActionResult();if result==nil||!result.Ok{t.Fatalf("load failed: %v",result)}
}
func sdkHostMove(t *testing.T,r *Runtime,target point,seq uint64)*pb.PocMoveResult {
 t.Helper();c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})}
 r.move(c,&pb.MoveTo{X:int32(target.X),Y:int32(target.Y),Epoch:r.state.Epoch,InputSeq:seq})
 result:=(<-c.out).GetMoveResult();if result==nil{t.Fatal("missing move result")};return result
}

func TestLocationSDKHostUsesPhysicalLifeMovementAndNoPrivateWorld(t *testing.T) {
 r:=sdkHostRuntime(t);if result:=sdkHostNew(t,r,"sdk:"+sdkHostTestID,"sdk-start");!result.Ok{t.Fatal(result)}
 if r.state.SDKLayout!=sdkHostTestID||r.currentLevel()!=sdkHostTestID||len(r.world.Life.Locations)!=1||len(r.state.Life.Actors)!=1||!r.state.Life.Actor(playerActorID).Manual||r.state.Life.Population.Count!=0||len(r.world.Life.Edges)>0||len(r.world.Life.Maintenance.Assets)>0||len(r.world.Life.Inspection.Objects)>0||r.world.Region.ID!=""||len(r.world.Entities)>0||len(r.world.Scene.Cameras)>0||len(r.state.Inventory.Items)>0||len(r.state.Inventory.Stores)>0||len(r.state.Inventory.Accounts)>0{t.Fatal("SDK session inherited private world content")}
 c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})};r.sendState(c);wire:=(<-c.out).GetGameState()
 if wire==nil||wire.Life==nil||wire.Life.LevelId!=sdkHostTestID||len(wire.SceneAgents)>0||len(wire.Entities)>0||wire.Life.RegionMap!=nil||len(wire.Life.Equipment)>0||len(wire.Life.Markers)>0||len(wire.Life.People)>0{t.Fatalf("SDK wire leaked normal content: %v",wire)}
 if wire.Inventory!=nil&&(len(wire.Inventory.Items)>0||len(wire.Inventory.Stores)>0||len(wire.Inventory.Balances)>0||len(wire.Inventory.Entitlements)>0){t.Fatal("SDK wire leaked inventory catalog")}
 spawn:=r.state.Player;if result:=sdkHostMove(t,r,point{3,1},1);result.Ok{t.Fatal("SDK wall accepted as destination")};if r.state.Player!=spawn||len(r.state.Path)>0{t.Fatal("rejected wall command changed movement")}
 target:=point{5,1};if result:=sdkHostMove(t,r,target,2);!result.Ok{t.Fatal(result)}
 route:=append([]point(nil),r.state.Path...);if len(route)<8||r.state.Player!=spawn{t.Fatalf("obstacle was skipped or position teleported on acceptance: %v",route)}
 ticks:=r.world.Life.MoveTicks
 for i:=int64(1);i<ticks;i++{r.step();if r.state.Player!=spawn{t.Fatal("SDK motion arrived before ordinary Life cadence")}}
 r.step();if r.state.Player!=route[0]{t.Fatal("SDK did not advance to its accepted first cell at ordinary cadence")}
 previous:=r.state.Player
 for i:=0;i<len(route)*int(ticks)+2&&r.state.Player!=target;i++{r.step();if manhattan(previous,r.state.Player)>1||!r.world.Life.Walks(sdkHostTestID,cell(r.state.Player)){t.Fatal("SDK movement crossed obstacle or skipped cells")};previous=r.state.Player}
 if r.state.Player!=target||len(r.state.Path)>0{t.Fatalf("SDK did not finish physical route: %+v",r.state.Life.Actor(playerActorID))}
 if err:=r.validateLifeSave(r.snapshotState());err!=nil{t.Fatal(err)}
}

func TestLocationSDKHostSaveSwitchAndLoadSelectsSavedWorld(t *testing.T) {
 r:=sdkHostRuntime(t);if result:=sdkHostNew(t,r,"life","normal-start");!result.Ok{t.Fatal(result)}
 normal:=r.snapshotState();slots:=r.world.Config.SaveSlots;if len(slots)<2{t.Fatal("fixture requires two save slots")}
 if err:=r.writeSave(slots[0],normal);err!=nil{t.Fatal(err)}
 if result:=sdkHostNew(t,r,"sdk:"+sdkHostTestID,"sdk-start");!result.Ok{t.Fatal(result)}
 if result:=sdkHostMove(t,r,point{5,1},1);!result.Ok{t.Fatal(result)};r.step();saved:=r.snapshotState()
 if err:=r.writeSave(slots[1],saved);err!=nil{t.Fatal(err)}
 // Reading a normal save while SDK is active must validate normal geometry,
 // actors and inventory, never the current SDK world's tiny isolated model.
 loadedNormal,_,err:=r.readSave(slots[0]);if err!=nil{t.Fatal(err)};sdkHostLoad(t,r,loadedNormal,"normal-load")
 if r.state.SDKLayout!=""||len(r.state.Life.Actors)!=len(normal.Life.Actors)||len(r.world.Life.Locations)!=len(r.canonicalWorld.Life.Locations)||r.world.Region.ID!=r.canonicalWorld.Region.ID{t.Fatal("normal load retained SDK world")}
 loadedSDK,_,err:=r.readSave(slots[1]);if err!=nil{t.Fatal(err)};sdkHostLoad(t,r,loadedSDK,"sdk-load")
 if r.state.SDKLayout!=sdkHostTestID||r.state.Epoch==saved.Epoch||!reflect.DeepEqual(r.state.Life,saved.Life)||!reflect.DeepEqual(r.state.Path,saved.Path)||!reflect.DeepEqual(r.state.Inventory,saved.Inventory)||len(r.world.Life.Actors)!=1{t.Fatal("SDK load used normal world or lost accepted movement")}
 for i:=0;i<100&&r.state.Player!=(point{5,1});i++{r.step()};if r.state.Player!=(point{5,1}){t.Fatal("loaded SDK route did not continue")}
 restarted:=sdkHostRuntime(t);restarted.data=r.data;afterRestart,_,err:=restarted.storageRuntime().readSave(slots[1]);if err!=nil{t.Fatal(err)};sdkHostLoad(t,restarted,afterRestart,"restart-load");if restarted.state.SDKLayout!=sdkHostTestID||restarted.currentLevel()!=sdkHostTestID||!reflect.DeepEqual(restarted.state.Life,saved.Life){t.Fatal("restart did not restore SDK world and accepted route")}
 listed:=r.storageRuntime().readSlots();if len(listed)<2||!listed[0].Valid||!listed[1].Valid{t.Fatal("mixed SDK and normal save slots did not validate independently")}
 if result:=sdkHostNew(t,r,"life","normal-again");!result.Ok{t.Fatal(result)};if r.state.SDKLayout!=""||len(r.state.Life.Actors)<2||r.world.Region.ID!=r.canonicalWorld.Region.ID{t.Fatal("ordinary NewGame stayed in SDK world")}
}

func TestLocationSDKHostUnknownScenarioDoesNotMutateSession(t *testing.T) {
 r:=sdkHostRuntime(t);if result:=sdkHostNew(t,r,"sdk:"+sdkHostTestID,"sdk-start");!result.Ok{t.Fatal(result)}
 if result:=sdkHostMove(t,r,point{5,1},1);!result.Ok{t.Fatal(result)};r.step();before:=r.snapshotState();world:=r.world
 for i,scenario:=range []string{"sdk","sdk:","sdk:missing","sdk:../outside","sdk-anything","sdk:"+sdkHostTestID+":missing"," sdk:"+sdkHostTestID,"SDK:"+sdkHostTestID}{
  if result:=sdkHostNew(t,r,scenario,fmt.Sprintf("bad-sdk-%d",i));result.Ok{t.Fatalf("accepted unknown/malformed scenario %q",scenario)}
  if !reflect.DeepEqual(before,r.snapshotState())||!reflect.DeepEqual(world,r.world){t.Fatalf("rejected %q mutated state/world",scenario)}
 }
 invalid:=before;invalid.SDKLayout="missing";if _,err:=r.savedWorldRuntime(invalid.SDKLayout);err==nil{t.Fatal("unknown SDK save selected fallback world")}
 invalid=before;invalid.Region.Initialized=true;if err:=r.validateSDKSave(invalid);err==nil{t.Fatal("SDK accepted foreign region knowledge")}
 invalid=before;invalid.Life.Enabled=false;if err:=r.validateSDKSave(invalid);err==nil{t.Fatal("SDK save bypassed Life validation")}
}

func TestLocationSDKHostDiskValidationDoesNotRaceWorldSwitches(t *testing.T) {
 r:=sdkHostRuntime(t);if result:=sdkHostNew(t,r,"life","normal-start");!result.Ok{t.Fatal(result)};slots:=r.world.Config.SaveSlots
 if len(slots)<2{t.Fatal("fixture requires two save slots")};if err:=r.writeSave(slots[0],r.snapshotState());err!=nil{t.Fatal(err)}
 if result:=sdkHostNew(t,r,"sdk:"+sdkHostTestID,"sdk-start");!result.Ok{t.Fatal(result)};if err:=r.writeSave(slots[1],r.snapshotState());err!=nil{t.Fatal(err)}
 storage:=r.storageRuntime();done:=make(chan error,1)
 go func(){for i:=0;i<30;i++{for _,slot:=range slots[:2]{if _,_,err:=storage.readSave(slot);err!=nil{done<-err;return}}};done<-nil}()
 for i:=0;i<30;i++{scenario:="life";if i%2==0{scenario="sdk:"+sdkHostTestID};if result:=sdkHostNew(t,r,scenario,fmt.Sprintf("switch-%d",i));!result.Ok{t.Fatal(result)};r.step()}
 if err:=<-done;err!=nil{t.Fatal(err)}
 if storage.world.Config.LevelID!=r.canonicalWorld.Config.LevelID||storage.world.Region.ID!=r.canonicalWorld.Region.ID{t.Fatal("disk worker switched to active SDK world")}
}

func TestLocationSDKHostRejectsOrdinaryLevelIDCollision(t *testing.T) {
 for _,kind:=range []string{"life","capture"}{t.Run(kind,func(t *testing.T){
  r:=sdkHostRuntime(t);id:=r.world.Config.LevelID
  if kind=="life"{for level:=range r.world.Life.Locations{id=level;break}}
  r.world.LocationSDK.Levels[0].ID=id;r.world.LocationSDK.Levels[0].Scenario="sdk:"+id
  if err:=r.prepareLocationSDK();err==nil{t.Fatal("SDK ID collision made normal saves/render mode ambiguous")}
 })}
}
