// The k-th queued person of a cell (by serial) waits on its k-th wait cell.
func (r *Runtime) sanitaryWaitTarget(p sanitaryUser, u sanitaryUnit) *behavior.Cell {
	if len(u.WaitCells) == 0 {
		return nil
	}
	cfg := r.world.SanitaryServices
	ahead := 0
	for _, other := range r.state.Sanitary.Users {
		if other.Phase == "queued" && other.Serial < p.Serial {
			if ou := cfg.unit(other.UnitID); ou != nil && ou.cellKey() == u.cellKey() {
				ahead++
			}
		}
	}
	at := u.WaitCells[min(ahead, len(u.WaitCells)-1)]
	return &at
}

// sanitaryWait sends a queued person to its wait cell at the door, or holds
// it where it stands when that cell cannot be reached now.
func (r *Runtime) sanitaryWait(p *sanitaryUser, u sanitaryUnit) {
	target := r.sanitaryWaitTarget(*p, u)
	a := r.state.Life.Actor(p.ActorID)
	if target == nil || a == nil {
		return
	}
	if p.WaitAt != nil && *p.WaitAt == *target {
		if a.CombatHold || a.Position != *target || len(a.Path) > 0 || a.Body != nil && a.Body.Moving {
			return
		}
		a.Body = nil
		a.CombatHold = true
		a.OverrideLevel = ""
		a.OverrideEdge = ""
		return
	}
	if r.sanitaryWalk(p, u, *target, "sanitary.phase.queued") != nil {
		p.WaitAt = nil
		return
	}
	p.WaitAt = target
}
func (r *Runtime) sanitaryApproach(p *sanitaryUser, u sanitaryUnit) error {
	if err := r.sanitaryWalk(p, u, u.EntryCell, "sanitary.phase.approach"); err != nil {
		return err
	}
	p.WaitAt = nil
	r.sanitaryPhase(p, "approach", 0)
	return nil
}
func (r *Runtime) sanitaryWalk(p *sanitaryUser, u sanitaryUnit, to behavior.Cell, label string) error {
	a := r.state.Life.Actor(p.ActorID)
	if a == nil || !a.OnFloor() || a.Level != u.LevelID {
		return textError{Key: "sanitary.error.unavailable"}
	}
	m := r.state.Life.GateModel(r.world.Life)
	path := m.Space(a.Level, r.state.Life.BlockedCells(a.Level, a.ID)).Path(a.Position, to, behavior.Cell{}, 0)
	if a.Position != to && len(path) == 0 {
		return textError{Key: "sanitary.error.path"}
	}
	before := r.state.Life.Clone()
	a.CombatHold = false
	a.Manual = true
	a.RestFootprint = nil
	a.OverrideLevel = a.Level
	a.OverrideAt = to
	a.OverrideEdge = ""
	a.Arrived = false
	a.Path = path
	a.PendingPath = nil
	a.Goal = to
	a.MoveStartTick = r.lifeMotionTick()
	a.Activity = "walking"
	a.Label = label
	if a.ID == playerActorID && m.BodyCapable(a.Level) {
		r.state.Life.EnsureHeroBody(m)
		if !r.state.Life.HeroBodyRouteTo(m, to) {
			r.state.Life = before
			return textError{Key: "sanitary.error.path"}
		}
	}
	return nil
}
func (r *Runtime) sanitaryRequest(id, unit string) error {
	cfg := r.world.SanitaryServices
	u := cfg.unit(unit)
	a := r.state.Life.Actor(id)
	if p, ok := r.state.Sanitary.Users[id]; ok {
		if p.UnitID == unit {
			return nil
		}
		return textError{Key: "sanitary.error.busy"}
	}
	if u == nil || !cfg.ServiceAvailable || a == nil || !a.OnFloor() || a.Level != u.LevelID || a.CombatHold || r.medicalReserved(id) || r.state.Paused || r.state.Combat.Active && r.state.Combat.Actor(id) != nil {
		return textError{Key: "sanitary.error.unavailable"}
	}
	c := r.combatant(id, "player")
	if !combatWounds.Status(combatBody(c)).CanWalk {
		return textError{Key: "medical.error.cannot_walk"}
	}
	count, _ := r.sanitaryCellLoad(unit, id)
	if count >= cfg.QueueLimit || r.state.Sanitary.Serial == ^uint64(0) {
		return textError{Key: "sanitary.error.busy"}
	}
	p := sanitaryUser{ActorID: id, UnitID: unit, Serial: r.state.Sanitary.Serial + 1, PriorManual: a.Manual, RequestedSecond: r.state.Life.Seconds, LastSecond: r.state.Life.Seconds}
	if id != playerActorID && a.Brain.BreakKind == "hygiene" {
		p.ReturnBySecond = a.Brain.BreakReturnAt
	}
	r.sanitaryPhase(&p, "queued", 0)
	if count == 0 {
		if err := r.sanitaryApproach(&p, *u); err != nil {
			return err
		}
	}
	if p.Phase == "queued" {
		r.sanitaryWait(&p, *u)
	}
	a = r.state.Life.Actor(id)
	a.Manual = true
	a.Brain.InterruptService()
	sanitaryRestoreDutyBreak(a, p, false)
	a.Brain.AdvanceServiceNeeds(r.world.Life.Brain, id, r.state.Life.Seconds, r.state.Seed, 0)
	if r.state.Sanitary.Users == nil {
		r.state.Sanitary.Users = map[string]sanitaryUser{}
	}
	r.state.Sanitary.Serial = p.Serial
	r.state.Sanitary.Users[id] = p
	r.sanitaryHoldUsers()
	return nil
}
func (r *Runtime) sanitaryRelease(id string) {
	p, ok := r.state.Sanitary.Users[id]
	if !ok {
		return
	}
	a := r.state.Life.Actor(id)
	if a == nil {
		return
	}
	a.ServiceAttachment = ""
	a.CombatHold = false
	a.Manual = p.PriorManual
	a.OverrideLevel = ""
	a.OverrideEdge = ""
	a.Path = nil
	a.PendingPath = nil
	a.Body = nil
	a.Goal = a.Position
	a.Arrived = id == playerActorID
	a.Activity = "rest"
	a.Label = "sanitary.phase.idle"
	a.Brain.InterruptService()
	sanitaryRestoreDutyBreak(a, p, true)
	a.Brain.NextDecision = 0
	delete(r.state.Sanitary.Users, id)
	if c, ok := r.state.CombatRoster[id]; ok {
		r.combatCareHold(c)
	}
}
func (r *Runtime) sanitaryExitReady(p *sanitaryUser, u sanitaryUnit) bool {
	a := r.state.Life.Actor(p.ActorID)
	if a == nil {
		return false
	}
	c := r.combatant(a.ID, "player")
	p.ExitBlocked = r.state.Life.BlockedCells(u.LevelID, a.ID)[u.EntryCell] || !combatWounds.Status(combatBody(c)).CanWalk
	return !p.ExitBlocked
}
func (r *Runtime) sanitaryCommand(q *pb.PocLifeCommand) error {
	defer r.syncLifeHero()
	if !r.state.Active || !r.state.Life.Enabled || r.state.Paused {
		return textError{Key: "sanitary.error.unavailable"}
	}
	switch q.Action {
	case "sanitary_request":
		return r.sanitaryRequest(playerActorID, q.Destination)
	case "sanitary_cancel":
		p, ok := r.state.Sanitary.Users[playerActorID]
		if !ok {
			return nil
		}
		u := r.world.SanitaryServices.unit(p.UnitID)
		switch p.Phase {
		case "queued", "approach", "opening":
			if p.Phase != "queued" {
				r.sanitaryDoorTarget(*u, 0)
			}
			r.sanitaryRelease(playerActorID)
			return nil
		case "using":
			r.sanitaryDoorTarget(*u, 1)
			r.sanitaryPhase(&p, "opening_exit", r.world.SanitaryServices.DoorSeconds)
			r.state.Sanitary.Users[playerActorID] = p
			return nil
		}
		return textError{Key: "sanitary.error.busy"}
	}
	return textError{Key: "sanitary.error.unavailable"}
}
func (r *Runtime) advanceSanitaryServices() error {
	cfg := r.world.SanitaryServices
	if cfg == nil || r.state.Paused {
		return nil
	}
	ids := make([]string, 0, len(r.state.Sanitary.Users))
	for id := range r.state.Sanitary.Users {
		ids = append(ids, id)
	}
	sort.Slice(ids, func(i, j int) bool {
		return r.state.Sanitary.Users[ids[i]].Serial < r.state.Sanitary.Users[ids[j]].Serial
	})
	for _, id := range ids {
		p := r.state.Sanitary.Users[id]
		u := cfg.unit(p.UnitID)
		a := r.state.Life.Actor(id)
		if u == nil || a == nil {
			return fmt.Errorf("orphan sanitary user")
		}
		now := r.simNS()
		delta := r.state.Life.Seconds - p.LastSecond
		if delta < 0 {
			return fmt.Errorf("sanitary clock reversed")
		}
		recoverSeconds := int64(0)
		if p.Phase == "using" && cfg.ServiceAvailable {
			elapsed := min(delta, u.ServiceSeconds-p.UseElapsed)
			if elapsed < 0 {
				return fmt.Errorf("sanitary overrun")
			}
			p.UseElapsed += elapsed
			if u.Kind != "wc" {
				recoverSeconds = elapsed
			}
			water := int64(0)
			if u.Kind == "wc" {
				if p.UseElapsed == u.ServiceSeconds && p.WaterML == 0 {
					water = u.WaterML
				}
			} else {
				n := u.WaterML*elapsed + p.WaterRemainder
				water = n / u.ServiceSeconds
				p.WaterRemainder = n % u.ServiceSeconds
			}
			if r.state.Sanitary.WaterML == nil {
				r.state.Sanitary.WaterML = map[string]int64{}
			}
			if r.state.Sanitary.WaterML[u.ID] > 9000000000000000-water {
				return fmt.Errorf("sanitary meter overflow")
			}
			r.state.Sanitary.WaterML[u.ID] += water
			p.WaterML += water
		}
		if p.Phase != "approach" {
			a.Brain.AdvanceServiceNeeds(r.world.Life.Brain, id, r.state.Life.Seconds, r.state.Seed, recoverSeconds)
		}
		p.LastSecond = r.state.Life.Seconds
		if p.ReturnBySecond > 0 && r.state.Life.Seconds >= p.ReturnBySecond && (p.Phase == "queued" || p.Phase == "approach") {
			r.sanitaryRelease(id)
			continue
		}
		if (p.Phase == "queued" || p.Phase == "approach") && r.state.Life.Seconds-p.RequestedSecond >= u.MaxWaitSeconds {
			r.sanitaryRelease(id)
			continue
		}
		// a person of the Life at a calendar rate: the door steps that end within this frame follow on at once, each from the
		// end of the one before (sanitaryPhase), as long in game seconds as at ×1 (baseline fixes, 21.11: one step a frame
		// made the doors of one visit 3 minutes at ×30 instead of one, and the 10-minute break 11)
		released := false
		for pass := 0; pass < 8; pass++ {
			before := p.Phase
			var err error
			if released, err = r.sanitaryStepUser(id, &p, u, a, now); err != nil {
				return err
			}
			if released || p.Phase == before || id == playerActorID || r.state.Life.SecondsPerTick <= 1 || p.PhaseEndNS <= p.PhaseStartNS || p.PhaseEndNS > now {
				break
			}
		}
		if released {
			continue
		}
		r.state.Sanitary.Users[id] = p
	}
	r.sanitaryHoldUsers()
	r.sanitaryNPCRequests()
	return nil
}
// sanitaryStepUser: one step of a visit's phases; released when the visit ended (the user is gone).
func (r *Runtime) sanitaryStepUser(id string, p *sanitaryUser, u *sanitaryUnit, a *behavior.LifeActor, now int64) (bool, error) {
	cfg := r.world.SanitaryServices
	switch p.Phase {
	case "queued":
		if r.sanitaryQueueHead(*p) && !r.sanitaryBusy(u.ID, id) {
			_ = r.sanitaryApproach(p, *u) // A blocked doorway keeps the FIFO lease until its deadline.
		}
		if p.Phase == "queued" {
			r.sanitaryWait(p, *u)
		}
	case "approach":
		if a.Position == u.EntryCell && len(a.Path) == 0 && (a.Body == nil || !a.Body.Moving) {
			a.Body = nil
			a.CombatHold = true
			a.OverrideLevel = ""
			a.OverrideEdge = ""
			r.sanitaryPhase(p, "opening", cfg.DoorSeconds)
			r.sanitaryDoorAlong(*u, 1, p)
		}
	case "opening":
		if now >= p.PhaseEndNS {
			a.ServiceAttachment = u.ID
			r.sanitaryPhase(p, "entry", cfg.EntrySeconds)
		}
	case "entry":
		if now >= p.PhaseEndNS {
			r.sanitaryPhase(p, "sealing", cfg.DoorSeconds)
			r.sanitaryDoorAlong(*u, 0, p)
		}
	case "sealing":
		if now >= p.PhaseEndNS {
			r.sanitaryPhase(p, "using", 0)
		}
	case "using":
		if p.ReturnBySecond > 0 && r.state.Life.Seconds >= p.ReturnBySecond && p.UseElapsed < u.ServiceSeconds {
			r.sanitaryPhase(p, "opening_exit", cfg.DoorSeconds)
			r.sanitaryDoorAlong(*u, 1, p)
			break
		}
		if p.UseElapsed >= u.ServiceSeconds {
			if r.state.Sanitary.Completed == nil {
				r.state.Sanitary.Completed = map[string]uint64{}
			}
			r.state.Sanitary.Completed[u.ID]++
			r.sanitaryPhase(p, "opening_exit", cfg.DoorSeconds)
			r.sanitaryDoorAlong(*u, 1, p)
		}
	case "opening_exit":
		if now >= p.PhaseEndNS && r.sanitaryExitReady(p, *u) {
			r.sanitaryPhase(p, "exit", cfg.ExitSeconds)
		}
	case "exit":
		if now >= p.PhaseEndNS {
			if !r.sanitaryExitReady(p, *u) {
				r.sanitaryPhase(p, "opening_exit", 0)
				p.ExitBlocked = true
			} else {
				a.ServiceAttachment = ""
				a.Position = u.EntryCell
				r.sanitaryPhase(p, "closing", cfg.DoorSeconds)
				r.sanitaryDoorAlong(*u, 0, p)
			}
		}
	case "closing":
		if now >= p.PhaseEndNS {
			r.sanitaryRelease(id)
			return true, nil
		}
	default:
		return false, fmt.Errorf("unknown sanitary phase")
	}
	return false, nil
}

// sanitaryDutyKind: on duty a person uses the short service of a cubicle — the toilet and the hands, its basin (the
// cubicle holds both); the full wash is at home in the morning and the evening (doc 09, 21.11).
func sanitaryDutyKind(kind string) bool { return kind == "basin" }

// sanitaryChoreo: the doors and the steps of one visit in game seconds of ×1 (the same at every rate): in — the door
// opens, he steps in, it seals; out — it opens, he steps out, it closes behind him.
func (c *sanitaryCatalog) sanitaryChoreo(tickHz int64) (in, out int64) {
	in = int64(math.Ceil((2*c.DoorSeconds + c.EntrySeconds) * float64(tickHz)))
	out = int64(math.Ceil((2*c.DoorSeconds + c.ExitSeconds) * float64(tickHz)))
	return in, out
}

// sanitaryQueueSeconds: how long the people already at that cubicle keep it (game seconds, as at ×1).
func (r *Runtime) sanitaryQueueSeconds(u sanitaryUnit, except string) int64 {
	cfg := r.world.SanitaryServices
	in, out := cfg.sanitaryChoreo(int64(r.world.Config.TickHz))
	wait := int64(0)
	for id, p := range r.state.Sanitary.Users {
		other := cfg.unit(p.UnitID)
		if id == except || other == nil || other.cellKey() != u.cellKey() {
			continue
		}
		switch p.Phase {
		case "queued", "approach", "opening", "entry", "sealing":
			wait += in + other.ServiceSeconds + out
		case "using":
			wait += max(0, other.ServiceSeconds-p.UseElapsed) + out
		default:
			wait += out
		}
	}
	return wait
}

// sanitaryBreak: the washroom's own check of a break on duty (doc 09 «санблок ≤10 мин», 21.11): the whole absence — to
// the cubicle and back, the people before him, the doors and the use — fits budget game seconds from `at`. It returns
// the second he must start out of the cubicle for his post (the brain's return, the cubicle's deadline). The same check
// keeps the request on the way (sanitaryNPCRequests).
func (r *Runtime) sanitaryBreak(id, level string, at behavior.Cell, seconds, budget int64) (int64, bool) {
	cfg := r.world.SanitaryServices
	if cfg == nil || !cfg.NPCHygiene || !cfg.ServiceAvailable {
		return 0, false
	}
	in, out := cfg.sanitaryChoreo(int64(r.world.Config.TickHz))
	best, returnBy := int64(-1), int64(0)
	for _, u := range cfg.unitsAt(level) {
		if u.LevelID != level || !sanitaryDutyKind(u.Kind) {
			continue
		}
		travel := r.state.Life.StaticTravelSeconds(r.world.Life, level, at, u.EntryCell)
		if travel < 0 {
			continue
		}
		// the margin (data): the people on the way and a frame of ×30 at each end of the visit stay inside the budget
		total := 2*travel + r.sanitaryQueueSeconds(u, id) + in + u.ServiceSeconds + out + cfg.DutyMarginSeconds
		if total <= budget && (best < 0 || total < best) {
			best, returnBy = total, seconds+budget-cfg.DutyMarginSeconds-travel-out
		}
	}
	return returnBy, best >= 0
}

func (r *Runtime) sanitaryNPCRequests() {
	cfg := r.world.SanitaryServices
	if cfg == nil || !cfg.NPCHygiene {
		return
	}
	for _, a := range r.state.Life.Actors {
		if a.ID == playerActorID || a.Manual || !a.OnFloor() || a.CombatHold || r.serviceReserved(a.ID) || a.Brain.Place.ID != cfg.ManagedAffordance || !r.cartServiceReady(a.ID) {
			continue
		}
		// A free door first, otherwise the door with the shortest queue.
		units := append([]sanitaryUnit(nil), cfg.unitsAt(a.Level)...)
		load := map[string]int{}
		for _, u := range units {
			load[u.ID], _ = r.sanitaryCellLoad(u.ID, a.ID)
		}
		sort.SliceStable(units, func(i, j int) bool { return load[units[i].ID] < load[units[j].ID] })
		in, _ := cfg.sanitaryChoreo(int64(r.world.Config.TickHz))
		for _, u := range units {
			if cfg.ServiceAvailable && u.Kind != "wc" && u.LevelID == a.Level {
				// a break on duty: the short service only, and the same bound as the brain's (sanitaryBreak): from here to
				// the door, the people before him, the doors in and the use end before the second he must start back
				if a.Brain.BreakKind == "hygiene" {
					travel := r.state.Life.StaticTravelSeconds(r.world.Life, a.Level, a.Position, u.EntryCell)
					if !sanitaryDutyKind(u.Kind) || travel < 0 || r.state.Life.Seconds+travel+r.sanitaryQueueSeconds(u, a.ID)+in+u.ServiceSeconds > a.Brain.BreakReturnAt {
						continue
					}
				}
				if r.sanitaryRequest(a.ID, u.ID) == nil {
					break
				}
			}
		}
		// No physical provider fits this already bounded duty break. Continue
		// through the ordinary return route instead of waiting at a wall.
		if !r.sanitaryReserved(a.ID) && a.Brain.BreakKind == "hygiene" {
			owner := r.state.Life.Actor(a.ID)
			owner.Brain.Returning = true
			owner.Brain.NextDecision = 0
		}
	}
}

func (r *Runtime) sanitaryQueueHead(p sanitaryUser) bool {
	cfg := r.world.SanitaryServices
	u := cfg.unit(p.UnitID)
	for _, other := range r.state.Sanitary.Users {
		if ou := cfg.unit(other.UnitID); ou != nil && u != nil && ou.cellKey() == u.cellKey() && other.Serial < p.Serial {
			return false
		}
	}
	return true
}
