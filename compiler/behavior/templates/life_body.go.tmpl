// Code generated by ANG. Continuous body of the controlled hero (document 87, movement v2).
package behavior

import (
	"fmt"
	"math"
)

// LifeHeroBodyModel is authored in CUE (world.life.hero_body). In a location
// with a known cell size (modular SDK layouts) the controlled hero is a disk
// that moves at any angle in plan millimetres: steered by a direction (WASD /
// stick), drawn towards a point (held mouse button) or along a pulled-string
// route (click). Cells stay the rule layer for everyone else: the cells under
// the disk are occupied, the next corridor cell is reserved, courtesy,
// exits, sight and knowledge keep their cell semantics.
type LifeHeroBodyModel struct {
	RadiusMM     float64 `json:"radius_mm"`
	RunFactor    float64 `json:"run_factor"`
	SneakFactor  float64 `json:"sneak_factor,omitempty"`
	FollowStopMM float64 `json:"follow_stop_mm"`
	LookaheadMM  float64 `json:"lookahead_mm"`
}

func (b LifeHeroBodyModel) sneakFactor() float64 {
	if b.SneakFactor == 0 {
		return .55
	}
	return b.SneakFactor
}
func (b LifeHeroBodyModel) enabled() bool { return b.RadiusMM > 0 }
func (m LifeModel) validateHeroBody() error {
	b := m.HeroBody
	if !(b.sneakFactor() >= .2 && b.sneakFactor() <= .9) {
		return fmt.Errorf("invalid sneak movement factor")
	}
	if !b.enabled() {
		return nil
	}
	if !(b.RadiusMM >= 100 && b.RadiusMM <= 300) || !(b.RunFactor >= 1 && b.RunFactor <= 3) || !(b.FollowStopMM >= 50 && b.FollowStopMM <= 1000) || !(b.LookaheadMM >= 500 && b.LookaheadMM <= 5000) {
		return fmt.Errorf("invalid hero body model")
	}
	for id, l := range m.Locations {
		if l.CellMM != 0 && (l.CellMM < 100 || l.CellMM > 4000 || 2*b.RadiusMM >= float64(l.CellMM)) {
			return fmt.Errorf("hero body radius does not fit the cells of %s", id)
		}
	}
	return nil
}

// LifeBodyPoint is a plan point (millimetres from the plan origin) on a
// layer: surfaces 0..S-1 then stairs S..S+C-1, the API deck numbering.
type LifeBodyPoint struct {
	X     float64 `json:"x"`
	Y     float64 `json:"y"`
	Layer int     `json:"layer"`
}

// LifeBody is the saved continuous state. Clock is the motion time (motion
// ticks x 1000) the body has been integrated to; input received between
// ticks is applied from its arrival time, never from the next tick.
type LifeBody struct {
	X       float64         `json:"x"`
	Y       float64         `json:"y"`
	Layer   int             `json:"layer"`
	Clock   int64           `json:"clock"`
	Mode    string          `json:"mode,omitempty"`
	DX      float64         `json:"dx,omitempty"`
	DY      float64         `json:"dy,omitempty"`
	TX      float64         `json:"tx,omitempty"`
	TY      float64         `json:"ty,omitempty"`
	Run     bool            `json:"run,omitempty"`
	Route   []LifeBodyPoint `json:"route,omitempty"`
	Target  Cell            `json:"target,omitempty"`
	Seq     uint64          `json:"seq,omitempty"`
	Moving  bool            `json:"moving,omitempty"`
	FX      float64         `json:"fx,omitempty"`
	FY      float64         `json:"fy,omitempty"`
	Stalled float64         `json:"stalled,omitempty"`
	Replans int             `json:"replans,omitempty"`
	Cells   []Cell          `json:"cells,omitempty"`
}

// holds: a cell under the disk (occupancy for other people).
func (b *LifeBody) holds(at Cell) bool {
	if b == nil {
		return false
	}
	for _, c := range b.Cells {
		if c == at {
			return true
		}
	}
	return false
}

func (b *LifeBody) clone() *LifeBody {
	if b == nil {
		return nil
	}
	out := *b
	out.Route = append([]LifeBodyPoint(nil), b.Route...)
	out.Cells = append([]Cell(nil), b.Cells...)
	return &out
}

const (
	lifeBodySubMM   = 40.0
	lifeBodyProbeMM = 100.0
	// A route whose body made less than a fifth of its walk for this many
	// millimetres is re-planned around the people it can see.
	lifeBodyStallMM  = 900.0
	lifeBodyGiveUpMM = 4500.0
)

// deckBodyIndex: stair nodes by plan cell and stair-end links keyed by the
// layer of their near end and the plan cell of their far end.
type deckBodyIndex struct {
	connector []map[int]Cell
	links     map[deckBodyKey][]deckBodyLink
}
type deckBodyKey struct{ layer, plan int }
type deckBodyLink struct{ from, to Cell } // from: plan cell of the near end; to: nav cell of the far end

func (v *DeckVolume) buildBodyIndex() {
	x := &deckBodyIndex{links: map[deckBodyKey][]deckBodyLink{}}
	for _, c := range v.Connectors {
		nodes := map[int]Cell{}
		for _, n := range c.Nodes {
			nodes[n.Plan.Y*v.PlanWidth+n.Plan.X] = n.Nav
		}
		x.connector = append(x.connector, nodes)
	}
	layer := func(n Cell) (int, bool) {
		k := v.navIndex(n)
		if k < 0 || v.navPlan[k] < 0 {
			return 0, false
		}
		if d := int(v.navDeck[k]); d >= 0 {
			return d, true
		}
		return len(v.Surfaces) + (-1 - int(v.navDeck[k])), true
	}
	add := func(a, b Cell) {
		la, ok := layer(a)
		if !ok {
			return
		}
		pa, pb := v.navPlan[v.navIndex(a)], v.navPlan[v.navIndex(b)]
		if pb < 0 {
			return
		}
		key := deckBodyKey{la, int(pb)}
		x.links[key] = append(x.links[key], deckBodyLink{from: Cell{int(pa) % v.PlanWidth, int(pa) / v.PlanWidth}, to: b})
	}
	for _, l := range v.Links {
		add(l.A, l.B)
		add(l.B, l.A)
	}
	v.body = x
}

// lifeBodyGeom is the static plan geometry of one location seen by a body.
type lifeBodyGeom struct {
	m     LifeModel
	level string
	cell  float64
	w, h  int
	deck  *DeckVolume
}

func (m LifeModel) bodyGeom(level string) (lifeBodyGeom, bool) {
	l, ok := m.Locations[level]
	if !ok || l.CellMM <= 0 || !m.HeroBody.enabled() || len(l.Terrain) == 0 || len(l.Terrain[0]) == 0 {
		return lifeBodyGeom{}, false
	}
	g := lifeBodyGeom{m: m, level: level, cell: float64(l.CellMM), w: len(l.Terrain[0]), h: len(l.Terrain)}
	if d := m.Decks[level]; d != nil {
		if d.body == nil || d.navPlan == nil {
			return lifeBodyGeom{}, false
		}
		g.deck, g.w, g.h = d, d.PlanWidth, d.PlanDepth
	}
	return g, true
}

func (g lifeBodyGeom) cellOf(x, y float64) Cell {
	return Cell{int(math.Floor(x / g.cell)), int(math.Floor(y / g.cell))}
}
func (g lifeBodyGeom) center(p Cell) (float64, float64) {
	return (float64(p.X) + .5) * g.cell, (float64(p.Y) + .5) * g.cell
}
func (g lifeBodyGeom) walks(n Cell) bool { return g.m.Walks(g.level, n) }

// navOf maps a plan cell of a layer to its navigation cell (no links).
func (g lifeBodyGeom) navOf(layer int, p Cell) (Cell, bool) {
	if p.X < 0 || p.Y < 0 || p.X >= g.w || p.Y >= g.h {
		return Cell{}, false
	}
	if g.deck == nil {
		return p, layer == 0
	}
	d := g.deck
	if layer >= 0 && layer < len(d.Surfaces) {
		s := d.Surfaces[layer]
		if !s.Walkable || s.NavRow < 0 {
			return Cell{}, false
		}
		n := Cell{p.X, s.NavRow + p.Y}
		k := d.navIndex(n)
		if k < 0 || d.navPlan[k] < 0 || int(d.navDeck[k]) != layer {
			return Cell{}, false
		}
		return n, true
	}
	c := layer - len(d.Surfaces)
	if c < 0 || c >= len(d.body.connector) {
		return Cell{}, false
	}
	n, ok := d.body.connector[c][p.Y*d.PlanWidth+p.X]
	return n, ok
}

// LayerOf returns the layer and plan cell of a navigation cell.
func (g lifeBodyGeom) locate(n Cell) (int, Cell, bool) {
	if g.deck == nil {
		return 0, n, n.X >= 0 && n.Y >= 0 && n.X < g.w && n.Y < g.h
	}
	d := g.deck
	k := d.navIndex(n)
	if k < 0 || d.navPlan[k] < 0 {
		return 0, Cell{}, false
	}
	i := int(d.navPlan[k])
	layer := int(d.navDeck[k])
	if layer < 0 {
		layer = len(d.Surfaces) + (-1 - layer)
	}
	return layer, Cell{i % d.PlanWidth, i / d.PlanWidth}, true
}

// square is the navigation cell of plan square p as felt by a body on a
// layer: its own walkable cell, or the far end of a link from an orthogonally
// adjacent cell of that layer (a stair end seen from its landing).
func (g lifeBodyGeom) square(layer int, p Cell) (Cell, bool) {
	if n, ok := g.navOf(layer, p); ok && g.walks(n) {
		return n, true
	}
	if g.deck == nil || p.X < 0 || p.Y < 0 || p.X >= g.w || p.Y >= g.h {
		return Cell{}, false
	}
	for _, e := range g.deck.body.links[deckBodyKey{layer, p.Y*g.deck.PlanWidth + p.X}] {
		if Distance(e.from, p) == 1 && g.walks(e.to) {
			return e.to, true
		}
	}
	return Cell{}, false
}

// enter: the centre crosses from plan cell a to its orthogonal neighbour b.
func (g lifeBodyGeom) enter(layer int, a, b Cell) (Cell, int, bool) {
	if n, ok := g.navOf(layer, b); ok && g.walks(n) {
		return n, layer, true
	}
	if g.deck == nil || b.X < 0 || b.Y < 0 || b.X >= g.w || b.Y >= g.h {
		return Cell{}, 0, false
	}
	for _, e := range g.deck.body.links[deckBodyKey{layer, b.Y*g.deck.PlanWidth + b.X}] {
		if e.from == a && g.walks(e.to) {
			if l, _, ok := g.locate(e.to); ok {
				return e.to, l, true
			}
		}
	}
	return Cell{}, 0, false
}

// transition returns the navigation cells the centre passes from plan cell a
// to plan cell b (one step on each axis at most) and the resulting layer.
func (g lifeBodyGeom) transition(layer int, a, b Cell) ([]Cell, int, bool) {
	dx, dy := b.X-a.X, b.Y-a.Y
	if dx == 0 && dy == 0 {
		n, ok := g.navOf(layer, a)
		return []Cell{n}, layer, ok
	}
	if dx < -1 || dx > 1 || dy < -1 || dy > 1 {
		return nil, 0, false
	}
	if dx == 0 || dy == 0 {
		n, l, ok := g.enter(layer, a, b)
		return []Cell{n}, l, ok
	}
	for _, mid := range []Cell{{a.X + dx, a.Y}, {a.X, a.Y + dy}} {
		n1, l1, ok := g.enter(layer, a, mid)
		if !ok {
			continue
		}
		n2, l2, ok := g.enter(l1, mid, b)
		if ok {
			return []Cell{n1, n2}, l2, true
		}
	}
	return nil, 0, false
}

func (g lifeBodyGeom) near(x, y, r float64, visit func(Cell)) {
	x0, x1 := int(math.Floor((x-r-1)/g.cell)), int(math.Floor((x+r+1)/g.cell))
	y0, y1 := int(math.Floor((y-r-1)/g.cell)), int(math.Floor((y+r+1)/g.cell))
	for py := y0; py <= y1; py++ {
		for px := x0; px <= x1; px++ {
			visit(Cell{px, py})
		}
	}
}

// pen is the depth of the disk (x,y,r) inside square p; <= 0 when apart.
func (g lifeBodyGeom) pen(x, y float64, p Cell, r float64) float64 {
	x0, y0 := float64(p.X)*g.cell, float64(p.Y)*g.cell
	x1, y1 := x0+g.cell, y0+g.cell
	qx, qy := math.Max(x0, math.Min(x, x1)), math.Max(y0, math.Min(y, y1))
	if d := math.Hypot(x-qx, y-qy); d > 0 {
		return r - d
	}
	return r + math.Min(math.Min(x-x0, x1-x), math.Min(y-y0, y1-y))
}

// normal points from square p towards the centre (out of the square).
func (g lifeBodyGeom) normal(x, y float64, p Cell) (float64, float64) {
	x0, y0 := float64(p.X)*g.cell, float64(p.Y)*g.cell
	x1, y1 := x0+g.cell, y0+g.cell
	qx, qy := math.Max(x0, math.Min(x, x1)), math.Max(y0, math.Min(y, y1))
	if d := math.Hypot(x-qx, y-qy); d > 0 {
		return (x - qx) / d, (y - qy) / d
	}
	best, nx, ny := x-x0, -1.0, 0.0
	if v := x1 - x; v < best {
		best, nx, ny = v, 1, 0
	}
	if v := y - y0; v < best {
		best, nx, ny = v, 0, -1
	}
	if v := y1 - y; v < best {
		nx, ny = 0, 1
	}
	return nx, ny
}

func (g lifeBodyGeom) blocked(layer int, p Cell, others map[Cell]bool) bool {
	n, ok := g.square(layer, p)
	return !ok || others[n]
}

// tryStep moves the disk by (sx,sy) with push-out from blocked squares. A
// step never deepens an overlap; an overlap that already existed (a layer
// change beside a stair stringer) is relieved gradually while walking on.
func (g lifeBodyGeom) tryStep(b *LifeBody, sx, sy, r float64, others map[Cell]bool) bool {
	from := g.cellOf(b.X, b.Y)
	px, py := b.X+sx, b.Y+sy
	_, layer, ok := g.transition(b.Layer, from, g.cellOf(px, py))
	if !ok {
		return false
	}
	limit := math.Hypot(sx, sy) + 2
	for it := 0; it < 4; it++ {
		moved := false
		cx, cy := px, py
		g.near(cx, cy, r, func(p Cell) {
			if !g.blocked(layer, p, others) {
				return
			}
			depth := g.pen(px, py, p, r)
			if depth <= 1e-6 {
				return
			}
			max := limit
			if g.pen(b.X, b.Y, p, r) > 0 {
				max = 12
			}
			nx, ny := g.normal(px, py, p)
			d := math.Min(depth+.01, max)
			px, py = px+nx*d, py+ny*d
			moved = true
		})
		if !moved {
			break
		}
	}
	_, layer2, ok := g.transition(b.Layer, from, g.cellOf(px, py))
	if !ok || layer2 != layer {
		return false
	}
	accept := true
	g.near(px, py, r, func(p Cell) {
		if !accept || !g.blocked(layer, p, others) {
			return
		}
		if depth := g.pen(px, py, p, r); depth > .5 && depth > math.Max(g.pen(b.X, b.Y, p, r), 0)+.5 {
			accept = false
		}
	})
	if !accept {
		return false
	}
	b.X, b.Y, b.Layer = px, py, layer
	return true
}

// move integrates a displacement in sub-steps; a blocked sub-step slides on
// its larger axis, then the other; the distance actually moved is returned.
func (g lifeBodyGeom) move(b *LifeBody, dx, dy, r float64, others map[Cell]bool) float64 {
	dist := math.Hypot(dx, dy)
	if dist < 1e-9 {
		return 0
	}
	n := int(math.Ceil(dist / lifeBodySubMM))
	sx, sy := dx/float64(n), dy/float64(n)
	moved := 0.0
	for i := 0; i < n; i++ {
		x0, y0 := b.X, b.Y
		if !g.tryStep(b, sx, sy, r, others) {
			ax, ay, bx, by := sx, 0.0, 0.0, sy
			if math.Abs(sy) > math.Abs(sx) {
				ax, ay, bx, by = 0, sy, sx, 0
			}
			if !g.tryStep(b, ax, ay, r, others) && !g.tryStep(b, bx, by, r, others) {
				break
			}
		}
		moved += math.Hypot(b.X-x0, b.Y-y0)
	}
	return moved
}

// bodyOthers: navigation cells held by every other person of the level.
func (s LifeState) bodyOthers(a *LifeActor) map[Cell]bool {
	out := map[Cell]bool{}
	for i := range s.Actors {
		o := &s.Actors[i]
		if o.ID == a.ID || !o.OnFloor() || o.Level != a.Level {
			continue
		}
		out[o.Position] = true
		if len(o.Path) > 0 {
			out[o.Path[0]] = true
		}
		if o.Body != nil {
			for _, c := range o.Body.Cells {
				out[c] = true
			}
		}
	}
	for _, o := range s.Population.Actors {
		if !o.Materialized || o.Trip != nil || o.Level != a.Level {
			continue
		}
		out[o.Position] = true
		if len(o.Path) > 0 {
			out[o.Path[0]] = true
		}
	}
	return out
}

func (m LifeModel) bodyWalkPerMilli(level string) float64 {
	return float64(m.Locations[level].CellMM) / float64(m.MoveTicks*1000)
}

// integrateBody advances the body to motion time `until` with its input.
func (s *LifeState) integrateBody(m LifeModel, a *LifeActor, until int64) {
	b := a.Body
	if b == nil {
		return
	}
	g, ok := m.bodyGeom(a.Level)
	if !ok || until <= b.Clock {
		return
	}
	dt := float64(until - b.Clock)
	b.Clock = until
	if b.Mode == "" {
		b.Moving = false
		return
	}
	others := s.bodyOthers(a)
	r := m.HeroBody.RadiusMM
	v := m.bodyWalkPerMilli(a.Level)
	if a.Sneaking {
		v *= m.HeroBody.sneakFactor()
	} else if b.Run {
		v *= m.HeroBody.RunFactor
	}
	x0, y0 := b.X, b.Y
	expected, moved := 0.0, 0.0
	switch b.Mode {
	case "steer":
		mag := math.Hypot(b.DX, b.DY)
		if mag > 1 {
			mag = 1
		}
		if mag > 1e-6 {
			ux, uy := b.DX/math.Hypot(b.DX, b.DY), b.DY/math.Hypot(b.DX, b.DY)
			expected = v * mag * dt
			moved = g.move(b, ux*expected, uy*expected, r, others)
		}
	case "follow":
		dx, dy := b.TX-b.X, b.TY-b.Y
		d := math.Hypot(dx, dy) - m.HeroBody.FollowStopMM*.5
		if d > 1 {
			expected = math.Min(v*dt, d)
			moved = g.move(b, dx/math.Hypot(dx, dy)*expected, dy/math.Hypot(dx, dy)*expected, r, others)
		}
	case "route":
		left := v * dt
		for left > 1e-6 && len(b.Route) > 0 {
			w := b.Route[0]
			dx, dy := w.X-b.X, w.Y-b.Y
			d := math.Hypot(dx, dy)
			if d < .5 {
				if b.Layer == w.Layer {
					b.Route = b.Route[1:]
					continue
				}
				break
			}
			step := math.Min(left, d)
			expected += step
			got := g.move(b, dx/d*step, dy/d*step, r, others)
			moved += got
			left -= step
			if got < step-.5 {
				break
			}
			if step >= d-.5 && math.Hypot(w.X-b.X, w.Y-b.Y) < .5 && b.Layer == w.Layer {
				b.Route = b.Route[1:]
			}
		}
		if len(b.Route) == 0 {
			b.Mode, b.Stalled, b.Replans = "", 0, 0
		}
	}
	if moved > .5 {
		d := math.Hypot(b.X-x0, b.Y-y0)
		if d > .5 {
			b.FX, b.FY = (b.X-x0)/d, (b.Y-y0)/d
		}
	}
	a.WalkedMM += moved
	b.Moving = moved > .5
	if b.Mode == "route" {
		if moved < expected*.2 {
			b.Stalled += expected - moved
		} else {
			b.Stalled = 0
		}
	}
	s.settleBody(g, a, others)
}

// settleBody: centre cell -> Position, disk cells -> occupancy of others.
func (s *LifeState) settleBody(g lifeBodyGeom, a *LifeActor, others map[Cell]bool) {
	b := a.Body
	c := g.cellOf(b.X, b.Y)
	if n, ok := g.navOf(b.Layer, c); ok {
		a.Position = n
	}
	cells := []Cell{a.Position}
	r := g.m.HeroBody.RadiusMM
	g.near(b.X, b.Y, r, func(p Cell) {
		if p == c || g.pen(b.X, b.Y, p, r) <= 0 {
			return
		}
		n, ok := g.square(b.Layer, p)
		if !ok || others[n] {
			return
		}
		for _, have := range cells {
			if have == n {
				return
			}
		}
		cells = append(cells, n)
	})
	b.Cells = cells
}

// direction of the current input at the body (unit vector) and how far it
// still wants to go; ok is false when the body has no intention.
func (g lifeBodyGeom) intention(b *LifeBody, stop float64) (float64, float64, float64, bool) {
	switch b.Mode {
	case "steer":
		d := math.Hypot(b.DX, b.DY)
		if d > 1e-6 {
			return b.DX / d, b.DY / d, math.Inf(1), true
		}
	case "follow":
		dx, dy := b.TX-b.X, b.TY-b.Y
		d := math.Hypot(dx, dy)
		if d > stop*.5+1 {
			return dx / d, dy / d, d - stop*.5, true
		}
	case "route":
		for _, w := range b.Route {
			dx, dy := w.X-b.X, w.Y-b.Y
			if d := math.Hypot(dx, dy); d > .5 {
				return dx / d, dy / d, d, true
			}
		}
	}
	return 0, 0, 0, false
}

// corridor: the 4-connected navigation cells the centre is about to cross,
// up to the authored look-ahead, stopping at the first static obstacle.
func (g lifeBodyGeom) corridor(b *LifeBody, look, stop float64) []Cell {
	var out []Cell
	x, y, layer := b.X, b.Y, b.Layer
	last := g.cellOf(x, y)
	points := []LifeBodyPoint{}
	if b.Mode == "route" {
		points = b.Route
	} else if ux, uy, d, ok := g.intention(b, stop); ok {
		d = math.Min(d, look)
		points = []LifeBodyPoint{{X: x + ux*d, Y: y + uy*d, Layer: layer}}
	}
	walked := 0.0
	for _, w := range points {
		for walked < look {
			dx, dy := w.X-x, w.Y-y
			d := math.Hypot(dx, dy)
			if d < 1 {
				break
			}
			step := math.Min(lifeBodyProbeMM, math.Min(d, look-walked))
			x, y = x+dx/d*step, y+dy/d*step
			walked += step
			next := g.cellOf(x, y)
			if next == last {
				continue
			}
			cells, l, ok := g.transition(layer, last, next)
			if !ok {
				return out
			}
			out = append(out, cells...)
			last, layer = next, l
		}
		if walked >= look {
			break
		}
	}
	return out
}

// EnsureHeroBody creates the body of a manually controlled hero standing in
// a cell-sized location, or drops it (trip, residence, automatic routine).
func (s *LifeState) EnsureHeroBody(m LifeModel) {
	a := s.Actor(s.ControlledActorID)
	if a == nil {
		return
	}
	g, ok := m.bodyGeom(a.Level)
	if !ok || !a.Manual || a.Trip != nil || a.ResidenceID != "" {
		a.Body = nil
		return
	}
	if a.Body != nil {
		return
	}
	layer, plan, ok := g.locate(a.Position)
	if !ok {
		return
	}
	x, y := g.center(plan)
	a.Body = &LifeBody{X: x, Y: y, Layer: layer, Clock: m.MotionTick(s.Tick, s.Seconds) * 1000, Cells: []Cell{a.Position}}
	if len(a.Path) > 0 || len(a.PendingPath) > 0 {
		goal := a.Goal
		a.Path, a.PendingPath = nil, nil
		if goal != a.Position {
			s.routeBody(m, g, a, goal, 0, 0, false, false)
		}
	}
}

// HeroBodyAdvance integrates the body to a sub-tick motion time (input
// arrival, publication) and refreshes its reservation; no courtesy is asked.
func (s *LifeState) HeroBodyAdvance(m LifeModel, until int64) {
	a := s.Actor(s.ControlledActorID)
	if a == nil || a.Body == nil {
		return
	}
	g, ok := m.bodyGeom(a.Level)
	if !ok {
		return
	}
	s.integrateBody(m, a, until)
	s.bodyIntent(m, g, a)
}

// bodyIntent: reservation of the next corridor cell, or a pending contact.
func (s *LifeState) bodyIntent(m LifeModel, g lifeBodyGeom, a *LifeActor) {
	b := a.Body
	a.Path, a.PendingPath = nil, nil
	if b.Mode == "" {
		return
	}
	corridor := g.corridor(b, m.HeroBody.LookaheadMM, m.HeroBody.FollowStopMM)
	if len(corridor) == 0 {
		return
	}
	if s.bodyOthers(a)[corridor[0]] {
		a.PendingPath = corridor
	} else {
		a.Path = corridor
	}
}

// SteerHeroBody applies new input from its arrival time: mode "steer" with a
// plan direction (|d| <= 1: analogue speed), "follow" towards a plan point,
// or "stop". The caller integrated the body to now first.
func (s *LifeState) SteerHeroBody(m LifeModel, mode string, x, y float64, run bool, seq uint64) error {
	a := s.Actor(s.ControlledActorID)
	if a == nil || a.Body == nil {
		return fmt.Errorf("no controllable body")
	}
	g, ok := m.bodyGeom(a.Level)
	if !ok || math.IsNaN(x) || math.IsNaN(y) || math.IsInf(x, 0) || math.IsInf(y, 0) {
		return fmt.Errorf("invalid steering")
	}
	b := a.Body
	switch mode {
	case "steer":
		d := math.Hypot(x, y)
		if d > 1 {
			x, y = x/d, y/d
		}
		if d < 1e-3 {
			mode, x, y = "", 0, 0
		}
		b.DX, b.DY, b.TX, b.TY = x, y, 0, 0
	case "follow":
		if x < -1e6 || y < -1e6 || x > 1e7 || y > 1e7 {
			return fmt.Errorf("invalid follow point")
		}
		b.DX, b.DY, b.TX, b.TY = 0, 0, x, y
	case "stop":
		mode = ""
		b.DX, b.DY, b.TX, b.TY = 0, 0, 0, 0
	default:
		return fmt.Errorf("unknown steering mode")
	}
	b.Mode, b.Run, b.Route, b.Seq, b.Stalled, b.Replans = mode, run, nil, seq, 0, 0
	a.Goal = a.Position
	s.bodyIntent(m, g, a)
	s.bodyLabels(a)
	return nil
}

// RouteHeroBody: a click. The intent is the familiar static cell route
// (as MoveRoute); the body walks its pulled string to the exact point.
func (s *LifeState) RouteHeroBody(m LifeModel, target Cell, x, y float64, point, run bool, seq uint64) bool {
	a := s.Actor(s.ControlledActorID)
	if a == nil || a.Body == nil {
		return false
	}
	g, ok := m.bodyGeom(a.Level)
	if !ok || !m.Space(a.Level, nil).CanStand(target) {
		return false
	}
	if !s.routeBody(m, g, a, target, x, y, point, run) {
		return false
	}
	a.Body.Seq = seq
	s.bodyLabels(a)
	return true
}

// HeroBodyRouteTo: an exit or region destination of the same planner.
func (s *LifeState) HeroBodyRouteTo(m LifeModel, target Cell) bool {
	a := s.Actor(s.ControlledActorID)
	if a == nil || a.Body == nil {
		return false
	}
	g, ok := m.bodyGeom(a.Level)
	return ok && s.routeBody(m, g, a, target, 0, 0, false, a.Body.Run)
}

func (s *LifeState) routeBody(m LifeModel, g lifeBodyGeom, a *LifeActor, target Cell, x, y float64, point, run bool) bool {
	b := a.Body
	var cells []Cell
	if target != a.Position {
		cells = m.Space(a.Level, nil).Path(a.Position, target, Cell{}, 0)
		if len(cells) == 0 {
			return false
		}
	}
	route, ok := g.pull(b, cells, nil)
	if !ok {
		return false
	}
	last := route[len(route)-1]
	if point {
		if tl, tp, ok := g.locate(target); ok && tl == last.Layer && g.cellOf(x, y) == tp && g.clear(tl, x, y, g.m.HeroBody.RadiusMM+5, nil) {
			last.X, last.Y = x, y
		}
	}
	route[len(route)-1] = last
	b.Mode, b.Route, b.Run, b.Target, b.DX, b.DY, b.TX, b.TY, b.Stalled, b.Replans = "route", route, run, target, 0, 0, 0, 0, 0, 0
	a.Goal = target
	s.bodyIntent(m, g, a)
	return true
}

// clear: the disk at (x,y) touches no blocked square of the layer.
func (g lifeBodyGeom) clear(layer int, x, y, r float64, others map[Cell]bool) bool {
	if _, ok := g.navOf(layer, g.cellOf(x, y)); !ok {
		return false
	}
	ok := true
	g.near(x, y, r, func(p Cell) {
		if ok && g.pen(x, y, p, r) > 0 && g.blocked(layer, p, others) {
			ok = false
		}
	})
	return ok
}

// segmentClear: the disk swept from a to b on one layer (static geometry).
func (g lifeBodyGeom) segmentClear(layer int, ax, ay, bx, by float64, others map[Cell]bool) bool {
	r := g.m.HeroBody.RadiusMM + 10
	d := math.Hypot(bx-ax, by-ay)
	n := int(math.Ceil(d/50)) + 1
	for i := 0; i <= n; i++ {
		t := float64(i) / float64(n)
		x, y := ax+(bx-ax)*t, ay+(by-ay)*t
		if _, ok := g.navOf(layer, g.cellOf(x, y)); !ok {
			return false
		}
		if !g.clear(layer, x, y, r, others) && !(i == 0 || i == n) {
			return false
		}
	}
	return true
}

// pull turns a cell route into straight segments: runs on one layer are
// string-pulled (farthest visible cell centre), link crossings keep both
// cell centres so the body steps straight across a stair end.
func (g lifeBodyGeom) pull(b *LifeBody, cells []Cell, others map[Cell]bool) ([]LifeBodyPoint, bool) {
	type node struct {
		p     LifeBodyPoint
		cross bool
	}
	nodes := []node{{p: LifeBodyPoint{X: b.X, Y: b.Y, Layer: b.Layer}}}
	prevLayer := b.Layer
	for _, c := range cells {
		layer, plan, ok := g.locate(c)
		if !ok {
			return nil, false
		}
		x, y := g.center(plan)
		cross := layer != prevLayer
		if cross {
			nodes[len(nodes)-1].cross = true
		}
		nodes = append(nodes, node{p: LifeBodyPoint{X: x, Y: y, Layer: layer}, cross: cross})
		prevLayer = layer
	}
	if len(nodes) == 1 {
		return []LifeBodyPoint{nodes[0].p}, true
	}
	var out []LifeBodyPoint
	at := 0
	for at < len(nodes)-1 {
		next := at + 1
		for k := at + 2; k < len(nodes); k++ {
			if nodes[k].p.Layer != nodes[at].p.Layer {
				break
			}
			blockedRun := false
			for j := at + 1; j < k; j++ {
				if nodes[j].cross {
					blockedRun = true
					break
				}
			}
			if blockedRun || !g.segmentClear(nodes[at].p.Layer, nodes[at].p.X, nodes[at].p.Y, nodes[k].p.X, nodes[k].p.Y, others) {
				break
			}
			next = k
		}
		out = append(out, nodes[next].p)
		at = next
	}
	return out, true
}

func (s *LifeState) bodyLabels(a *LifeActor) {
	if a.OverrideLevel != "" {
		return
	}
	if a.Body.Mode != "" {
		a.Arrived = false
		a.Activity, a.Label = "walking", lifeManualMoveLabel
		return
	}
	a.Goal = a.Position
	if !a.Arrived {
		a.Arrived, a.StartedAt, a.Activity, a.Label = true, s.Seconds, "rest", "На месте"
	}
}

// advanceHeroBody runs at the hero's turn of a world tick: integrate to the
// tick, re-plan a stalled click route around seen people, ask the person at
// a blocked contact to step aside, refresh labels and reservations.
func (s *LifeState) advanceHeroBody(m LifeModel, a *LifeActor, tick int64, yieldBudget *int) {
	g, ok := m.bodyGeom(a.Level)
	if !ok {
		a.Body = nil
		return
	}
	s.integrateBody(m, a, tick*1000)
	b := a.Body
	if b.Mode == "route" && b.Stalled >= lifeBodyStallMM {
		if b.Stalled >= lifeBodyGiveUpMM || b.Replans >= 3 {
			b.Mode, b.Route, b.Stalled, b.Replans = "", nil, 0, 0
			if a.OverrideLevel == "" {
				a.Label = "Ждёт проход"
			}
		} else if cells := m.Space(a.Level, s.observedTraffic(m, a.ID, a.Level)).Path(a.Position, b.Target, Cell{}, 0); len(cells) > 0 || a.Position == b.Target {
			final := b.Route[len(b.Route)-1]
			if route, ok := g.pull(b, cells, nil); ok {
				route[len(route)-1].X, route[len(route)-1].Y = final.X, final.Y
				b.Route, b.Replans = route, b.Replans+1
				b.Stalled = lifeBodyStallMM * .5
			}
		} else {
			b.Replans++
			b.Stalled = lifeBodyStallMM * .5
		}
	}
	s.bodyIntent(m, g, a)
	a.MoveStartTick = tick
	if len(a.PendingPath) > 0 && *yieldBudget > 0 && s.courtesyAware(m, a.ID, a.Level, a.PendingPath[0]) && s.yieldPopulationFor(m, a.Level, a.PendingPath[0], tick, a.ID, a.PendingPath...) {
		*yieldBudget = *yieldBudget - 1
	}
	s.bodyLabels(a)
}

// heroBodyGoal: the controlled hero walks to an exit or region destination.
func (s *LifeState) heroBodyGoal(m LifeModel, a *LifeActor, destination Cell) {
	b := a.Body
	if a.Goal == destination && (b.Mode == "route" || a.Position == destination) {
		return
	}
	g, ok := m.bodyGeom(a.Level)
	if !ok {
		return
	}
	if !s.routeBody(m, g, a, destination, 0, 0, false, b.Run) {
		a.Goal = destination
		a.Label = "Ждёт проход"
	}
}

// validateBody checks a saved body against its location.
func (s LifeState) validateBody(m LifeModel, a LifeActor) error {
	b := a.Body
	g, ok := m.bodyGeom(a.Level)
	if !ok || a.ID != s.ControlledActorID || !a.Manual || a.Trip != nil || a.ResidenceID != "" {
		return fmt.Errorf("invalid hero body owner")
	}
	finite := func(v ...float64) bool {
		for _, x := range v {
			if math.IsNaN(x) || math.IsInf(x, 0) {
				return false
			}
		}
		return true
	}
	if !finite(b.X, b.Y, b.DX, b.DY, b.TX, b.TY, b.FX, b.FY, b.Stalled) || b.Clock < 0 || len(b.Route) > 4096 || len(b.Cells) == 0 || len(b.Cells) > 4 || math.Hypot(b.DX, b.DY) > 1.0001 || b.Replans < 0 || b.Stalled < 0 {
		return fmt.Errorf("invalid hero body")
	}
	switch b.Mode {
	case "", "steer", "follow", "route":
	default:
		return fmt.Errorf("invalid hero body mode")
	}
	if n, ok := g.navOf(b.Layer, g.cellOf(b.X, b.Y)); !ok || n != a.Position || b.Cells[0] != a.Position {
		return fmt.Errorf("hero body outside its cell")
	}
	for _, c := range b.Cells {
		if !m.Walks(a.Level, c) {
			return fmt.Errorf("hero body on a blocked cell")
		}
	}
	for _, w := range b.Route {
		if !finite(w.X, w.Y) {
			return fmt.Errorf("invalid hero body route")
		}
	}
	return nil
}

// BodyCapable: the controlled hero of this level walks as a continuous body.
func (m LifeModel) BodyCapable(level string) bool {
	_, ok := m.bodyGeom(level)
	return ok
}
