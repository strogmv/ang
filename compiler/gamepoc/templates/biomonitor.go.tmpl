// appendBiomonitors: for every wearer the hero sees (the scene agents after the perception filter) and the hero himself
// if he wears one, the tier and the lit segments. Nobody else is sent, and nothing about the wounds themselves.
func (r *Runtime) appendBiomonitors(view *pb.PocLifeView, hero *behavior.LifeActor, seen []*pb.PocAgentState) {
	m := r.world.Biomonitor
	if m == nil || len(m.Wearers) == 0 || hero == nil || hero.Trip != nil {
		return
	}
	visible := map[string]bool{playerActorID: true}
	for _, a := range seen {
		visible[a.Id] = true
	}
	for _, id := range m.Wearers {
		if !visible[id] {
			continue
		}
		tier, segments := r.biomonitorOf(id)
		view.Biomonitors = append(view.Biomonitors, &pb.PocBiomonitorState{PersonId: id, Tier: tier, Segments: segments})
	}
}
