// Code generated by ANG. Explicit population POC scenarios and filtered view adapter.
package poc

import (
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"fmt"
	"strings"
)

func lifeScenarioPopulation(scenario string) (int, bool) {
	switch scenario {
	case "life":
		return 0, true
	case "life100":
		return 100, true
	case "life300":
		return 300, true
	}
	return 0, false
}
func (r *Runtime) lifeAgentMoveTicks(id string) int64 {
	if strings.HasPrefix(id, "population.") && r.world.Life.Person(id) == nil {
		return r.world.Life.Population.MoveTicks
	}
	return r.world.Life.MoveTicks
}
func (r *Runtime) appendPopulationResidents(v *Runtime, level string) {
	for _, a := range r.state.Life.Population.Actors {
		if !a.Materialized || a.Trip != nil || a.Level != level {
			continue
		}
		agent := demoAgent{ID: a.ID, Name: a.Name, Position: location(a.Position), Task: a.Activity, Role: "Статист POC", MoveStartNS: a.MoveStartTick * r.tickNS()}
		for _, at := range a.Path {
			agent.Path = append(agent.Path, location(at))
		}
		v.state.Demo.Residents = append(v.state.Demo.Residents, agent)
	}
}
func (r *Runtime) appendPopulationDebug(view *pb.PocLifeView) {
	if !r.world.Config.DebugPerception || r.state.Life.Population.Count == 0 {
		return
	}
	active, queued, transit := 0, 0, 0
	for _, a := range r.state.Life.Population.Actors {
		if a.Materialized {
			active++
		}
		if a.Queued {
			queued++
		}
		if a.Trip != nil {
			transit++
		}
	}
	view.Events = append(view.Events, fmt.Sprintf("Население POC: %d · подробно %d · очередь входа %d · в пути %d", r.state.Life.Population.Count, active, queued, transit))
}
func (r *Runtime) stopPopulation(err error) {
	// Unexpected state is frozen and cannot be resumed/saved as a valid world.
	// A new game or a previously valid save is required; diagnostics remain visible.
	r.state.Paused = true
	r.state.Life.PopulationFailure = err.Error()
	message := "Симуляция населения остановлена: " + err.Error() + ". Загрузите сохранение или начните заново."
	r.state.Life.Events = append(r.state.Life.Events, message)
	if len(r.state.Life.Events) > 64 {
		r.state.Life.Events = append([]string(nil), r.state.Life.Events[len(r.state.Life.Events)-64:]...)
	}
	r.syncLifeHero()
	if r.client != nil {
		r.action(r.client, "", "population", "", fmt.Errorf("%s", message))
	}
}
