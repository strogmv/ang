// Code generated by ANG. Access zones, step 2: the scan, the countdown and the turrets' fire. DO NOT EDIT.
package poc

import (
	"errors"
	"fmt"
	"hash/fnv"
	"math"
	"sort"

	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

// world.access_zones (owner 13.11: «без права доступа, при пересечении должна быть проверка … если не ок 10 секунд
// покинуть зону, не покинул — стреляют турели и смерть»). Everyone who stands in the polygon of a zone of the hero's level
// (the same people the turrets see, turretWatchPeople; the hero by his continuous body) is checked:
//   scan (scan_seconds, like the scan before a medical capsule) → granted | countdown (countdown_seconds) → fire.
// Access: the caste (a person's archetype, the population's profile, a visitor's look), a pass item he carries, or the
// escort of a guard of the post (guardEscortTarget). The guards of the post are always their own: never scanned, never a
// target. Leaving the polygon erases the record: the countdown starts again from a new scan. In the fire phase every
// turret of the zone that holds him in its own aim and sees him shoots once per shot_interval_ms through the general world
// hit rule (applyWorldHit, the wound model); a dead body is no longer checked. No fire on approach, ever: a shot exists only
// for a record in the fire phase. Detailed where the player is: records exist only on the hero's level, saved with the game.
type accessZone struct {
	ID        string       `json:"id"`
	LevelID   string       `json:"level_id"`
	PolygonM  [][2]float64 `json:"polygon_m"`
	GuardPost string       `json:"guard_post"`
	Turrets   []string     `json:"turrets"`
	Access    struct {
		Castes         []string `json:"castes"`
		PassItems      []string `json:"pass_items"`
		EscortByGuards bool     `json:"escort_by_guards"`
	} `json:"access"`
	ScanSeconds      float64 `json:"scan_seconds"`
	CountdownSeconds float64 `json:"countdown_seconds"`
	Fire             string  `json:"fire"`
}

// One person inside a zone of the hero's level and the phase of his check (the tick clock, as the turrets'). By says why
// a granted person may stand there: caste | pass | escort.
type accessZoneRecord struct {
	Zone    string `json:"zone"`
	Person  string `json:"person"`
	Phase   string `json:"phase"` // scan | granted | countdown | fire
	SinceNS int64  `json:"since_ns"`
	By      string `json:"by,omitempty"`
}

// One shot of a turret post. The newest shot of each post is kept (its fire clock) with any of the last second (what
// the client draws).
type accessZoneShot struct {
	Serial  uint64   `json:"serial"`
	Turret  string   `json:"turret"`
	Target  string   `json:"target"`
	AtNS    int64    `json:"at_ns"`
	Wounded bool     `json:"wounded,omitempty"`
	ToMM    [3]int64 `json:"to_mm"`
}

// The checks of the hero's level; replaced as a whole every tick (copy on write), nil when nobody is in a zone and no
// shot is kept.
type accessZoneState struct {
	Records []accessZoneRecord `json:"records,omitempty"`
	Shots   []accessZoneShot   `json:"shots,omitempty"`
	Serial  uint64             `json:"serial,omitempty"`
}

func (s *accessZoneState) clone() *accessZoneState {
	if s == nil {
		return nil
	}
	out := &accessZoneState{Serial: s.Serial}
	out.Records = append([]accessZoneRecord(nil), s.Records...)
	out.Shots = append([]accessZoneShot(nil), s.Shots...)
	return out
}

func accessZoneMS(seconds float64) int64 { return int64(math.Round(seconds * 1000)) }

// accessZoneInside: the person's point (plan mm) in the zone's polygon (plan metres), even-odd.
func accessZoneInside(z accessZone, xMM, yMM int64) bool {
	x, y := float64(xMM)/1000, float64(yMM)/1000
	inside := false
	n := len(z.PolygonM)
	for i, j := 0, n-1; i < n; j, i = i, i+1 {
		a, b := z.PolygonM[i], z.PolygonM[j]
		if (a[1] > y) != (b[1] > y) && x < (b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0] {
			inside = !inside
		}
	}
	return inside
}

// accessZonePosts: the turret posts of the zone (its turrets, the post that guards it).
func (r *Runtime) accessZonePosts(z accessZone) []turretWatchPost {
	if r.world.TurretWatch == nil {
		return nil
	}
	var out []turretWatchPost
	for _, id := range z.Turrets {
		for _, p := range r.world.TurretWatch.Posts {
			if p.ID == id {
				out = append(out, p)
			}
		}
	}
	return out
}

// accessZoneGuard: a guard of the zone's post (the turret posts' own guard list, from the Life schedules).
func (r *Runtime) accessZoneGuard(z accessZone, id string) bool {
	for _, p := range r.accessZonePosts(z) {
		if p.guard(id) {
			return true
		}
	}
	return false
}

// accessZoneCaste: the caste of a person, from the one source the world keeps (the persons' archetypes and the
// population profiles, as the barks and the wound chips read it); a hall visitor by the look of his kind.
func (r *Runtime) accessZoneCaste(id string) string {
	if c := barkCatalog.Castes[id]; c != "" {
		return c
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.ID == id && a.Profile != nil {
			return barkCatalog.PopulationCastes[a.Profile.DefinitionID]
		}
	}
	if r.visitorsOn() {
		for _, b := range r.state.Visitors.Bodies {
			if fmt.Sprintf("visitor.%d", b.Serial) == id && b.Kind >= 0 && b.Kind < len(r.world.Visitors.Kinds) {
				return r.world.Visitors.Kinds[b.Kind].Look
			}
		}
	}
	return ""
}

// accessZoneRight: why this person may stand in the zone — "caste", "pass", "escort" — or "" (an intruder).
func (r *Runtime) accessZoneRight(z accessZone, id string) string {
	caste := r.accessZoneCaste(id)
	for _, c := range z.Access.Castes {
		if caste != "" && caste == c {
			return "caste"
		}
	}
	if len(z.Access.PassItems) > 0 {
		for _, key := range combatItemKeys(r.state.Inventory) {
			i := r.state.Inventory.Items[key]
			for _, pass := range z.Access.PassItems {
				if i.Definition == pass && r.combatCarried(r.state.Inventory, id, i) {
					return "pass"
				}
			}
		}
	}
	if z.Access.EscortByGuards {
		for _, p := range r.accessZonePosts(z) {
			for _, g := range p.Guards {
				if r.guardEscortTarget(g) == id {
					return "escort"
				}
			}
		}
	}
	return ""
}

func (r *Runtime) accessZoneRecordOf(person string) (accessZoneRecord, bool) {
	if r.state.AccessZones == nil {
		return accessZoneRecord{}, false
	}
	for _, rec := range r.state.AccessZones.Records {
		if rec.Person == person {
			return rec, true
		}
	}
	return accessZoneRecord{}, false
}

// accessZoneRank: how much a person matters to the turrets (turretWatchChoose): under fire 2, in the countdown 1, else 0.
func (r *Runtime) accessZoneRank(person string) int {
	rec, ok := r.accessZoneRecordOf(person)
	switch {
	case !ok:
		return 0
	case rec.Phase == "fire":
		return 2
	case rec.Phase == "countdown":
		return 1
	}
	return 0
}

// lawfulWorldSource: a turret post of a zone that fires after its scan and countdown — the law of the place, not a
// person. Its kills stay in the wound ledger under its id; no killing case is opened against it (recordWoundEvents).
func (r *Runtime) lawfulWorldSource(id string) bool {
	for _, z := range r.world.AccessZones {
		if z.Fire != "after_scan_and_countdown" {
			continue
		}
		for _, t := range z.Turrets {
			if t == id {
				return true
			}
		}
	}
	return false
}

// lawfulWorldSourceGuard: the observer guards the post whose turret wounded this body under its zone's law.
func (r *Runtime) lawfulWorldSourceGuard(body, observer string) bool {
	c, ok := r.state.CombatRoster[body]
	if !ok || len(c.Body) == 0 {
		return false
	}
	for _, w := range combatBody(c).Wounds {
		if !r.lawfulWorldSource(w.Author) {
			continue
		}
		for _, z := range r.world.AccessZones {
			for _, t := range z.Turrets {
				if t == w.Author && r.accessZoneGuard(z, observer) {
					return true
				}
			}
		}
	}
	return false
}

// advanceAccessZones: the phases of everyone in a zone of the hero's level (before the barks read the facts, so the
// guard's warning comes in the frame the countdown starts).
func (r *Runtime) advanceAccessZones() {
	if len(r.world.AccessZones) == 0 || !r.state.Life.Enabled {
		r.state.AccessZones = nil
		return
	}
	hero := r.state.Life.Actor(playerActorID)
	level := ""
	if hero != nil && hero.Trip == nil {
		level = hero.Level
	}
	now := r.state.Tick * r.tickNS()
	old := r.state.AccessZones
	next := &accessZoneState{}
	if old != nil {
		next.Serial = old.Serial
	}
	var people []turretWatchPerson
	for _, z := range r.world.AccessZones {
		if z.LevelID != level {
			continue // nothing is checked where the player is not
		}
		if people == nil {
			people = r.turretWatchPeople(level)
		}
		scan, countdown := accessZoneMS(z.ScanSeconds)*1000000, accessZoneMS(z.CountdownSeconds)*1000000
		for _, p := range people {
			if r.accessZoneGuard(z, p.ID) || !accessZoneInside(z, p.XMM, p.YMM) || r.woundBodyDead(p.ID) {
				continue
			}
			rec := accessZoneRecord{Zone: z.ID, Person: p.ID, Phase: "scan", SinceNS: now}
			if old != nil {
				for _, saved := range old.Records {
					if saved.Zone == z.ID && saved.Person == p.ID {
						rec = saved
					}
				}
			}
			if rec.Phase == "scan" && now-rec.SinceNS >= scan {
				if by := r.accessZoneRight(z, p.ID); by != "" {
					rec.Phase, rec.By, rec.SinceNS = "granted", by, rec.SinceNS+scan
				} else {
					rec.Phase, rec.SinceNS = "countdown", rec.SinceNS+scan
				}
			}
			if rec.Phase == "countdown" {
				// An escort that begins in the countdown (the guard takes him) lets him stay.
				if by := r.accessZoneRight(z, p.ID); by != "" {
					rec.Phase, rec.By, rec.SinceNS = "granted", by, now
				} else if now-rec.SinceNS >= countdown && z.Fire == "after_scan_and_countdown" {
					rec.Phase, rec.SinceNS = "fire", rec.SinceNS+countdown
				}
			}
			next.Records = append(next.Records, rec)
		}
	}
	sort.Slice(next.Records, func(i, j int) bool {
		if next.Records[i].Zone != next.Records[j].Zone {
			return next.Records[i].Zone < next.Records[j].Zone
		}
		return next.Records[i].Person < next.Records[j].Person
	})
	if old != nil {
		next.Shots = accessZoneKeptShots(old.Shots, now)
	}
	if len(next.Records) == 0 && len(next.Shots) == 0 {
		next = nil
	}
	r.state.AccessZones = next
}

// accessZoneKeptShots: the newest shot of each post (its fire clock) and every shot of the last second.
func accessZoneKeptShots(shots []accessZoneShot, now int64) []accessZoneShot {
	newest := map[string]uint64{}
	for _, s := range shots {
		if s.Serial > newest[s.Turret] {
			newest[s.Turret] = s.Serial
		}
	}
	var out []accessZoneShot
	for _, s := range shots {
		if newest[s.Turret] == s.Serial || now-s.AtNS < 1000000000 {
			out = append(out, s)
		}
	}
	return out
}

// accessZoneFire: after the turrets moved this tick, each turret of a zone shoots at the person it tracks if he is in
// the fire phase, its own aim is within the tolerance of him and it sees him, once per shot interval.
func (r *Runtime) accessZoneFire() error {
	s := r.state.AccessZones
	if s == nil || r.world.TurretWatch == nil || r.world.TurretWatch.Rule.Fire == nil {
		return nil
	}
	rule, fire := r.world.TurretWatch.Rule, r.world.TurretWatch.Rule.Fire
	now := r.state.Tick * r.tickNS()
	height := int64(math.Round(rule.AimHeightM * 1000))
	tolerance := turretWatchMdeg(fire.AimToleranceDeg)
	var people map[string]turretWatchPerson
	next := s.clone()
	fired := false
	for _, z := range r.world.AccessZones {
		if z.Fire != "after_scan_and_countdown" {
			continue
		}
		for _, p := range r.accessZonePosts(z) {
			var turret *turretWatchState
			for i := range r.state.Turrets {
				if r.state.Turrets[i].ID == p.ID {
					turret = &r.state.Turrets[i]
				}
			}
			if turret == nil || turret.Phase != "tracking" || turret.Target == "" {
				continue
			}
			rec, ok := r.accessZoneRecordOf(turret.Target)
			if !ok || rec.Zone != z.ID || rec.Phase != "fire" || r.accessZoneGuard(z, rec.Person) || r.woundBodyDead(rec.Person) {
				continue // never on approach: a shot only for a record in the fire phase
			}
			last := int64(math.MinInt64)
			for _, shot := range next.Shots {
				if shot.Turret == p.ID && shot.AtNS > last {
					last = shot.AtNS
				}
			}
			if last != math.MinInt64 && now-last < fire.ShotIntervalMS*1000000 {
				continue
			}
			if people == nil {
				people = map[string]turretWatchPerson{}
				for _, person := range r.turretWatchPeople(p.LevelID) {
					people[person.ID] = person
				}
			}
			person, here := people[rec.Person]
			if !here {
				continue
			}
			if _, _, body := r.knownCombatLifeActor(person.ID); !body || r.state.Combat.Active && r.state.Combat.Actor(person.ID) != nil {
				continue // no Life body to wound (a hall visitor), or a fight owns his body now
			}
			heading, pitch, reach := p.aim(rule, person.XMM, person.YMM, height)
			cell := r.turretWatchCellMM(p.LevelID)
			pivot := behavior.Cell{X: int(math.Floor(p.PivotM[0] * 1000 / float64(cell))), Y: int(math.Floor(p.PivotM[1] * 1000 / float64(cell)))}
			if !reach || abs64(turretWatchWrap(turret.HeadingMdeg-heading)) > tolerance || abs64(turret.PitchMdeg-pitch) > tolerance || !r.turretWatchSees(p, pivot, person, height) {
				continue // its own barrel is not on him yet, or a wall stands between
			}
			next.Serial++
			h := fnv.New64a()
			fmt.Fprintf(h, "%d/%s/%s/%d", r.state.Seed, z.ID, p.ID, next.Serial)
			result, err := r.applyWorldHit(person.ID, worldHit{Source: p.ID, Fire: fire.WorldSource, Target: fire.Target, From: pivot, Seed: int64(h.Sum64() >> 1)})
			if err != nil {
				return err
			}
			next.Shots = append(next.Shots, accessZoneShot{Serial: next.Serial, Turret: p.ID, Target: person.ID, AtNS: now, Wounded: result.Wound != nil, ToMM: [3]int64{person.XMM, person.YMM, height}})
			fired = true
		}
	}
	if fired {
		next.Shots = accessZoneKeptShots(next.Shots, now)
		r.state.AccessZones = next
	}
	return nil
}

func abs64(v int64) int64 {
	if v < 0 {
		return -v
	}
	return v
}

// accessZoneFacts: the barks fact «someone without access is caught in the zone» (countdown or fire), per zone.
func (r *Runtime) accessZoneFacts(level string) []string {
	if r.state.AccessZones == nil {
		return nil
	}
	var out []string
	for _, z := range r.world.AccessZones {
		if z.LevelID != level {
			continue
		}
		for _, rec := range r.state.AccessZones.Records {
			if rec.Zone == z.ID && (rec.Phase == "countdown" || rec.Phase == "fire") {
				out = append(out, z.ID)
				break
			}
		}
	}
	return out
}

// accessZoneFaceAgent: a guard of a zone's post standing still turns to the intruder of the countdown or the fire
// nearest to him (as a buyer turns to his terminal, vendingFaceAgent): he is the one who warns.
func (r *Runtime) accessZoneFaceAgent(a *pb.PocAgentState) {
	if r.state.AccessZones == nil || len(a.Path) > 0 {
		return
	}
	best, found := int64(-1), false
	for _, z := range r.world.AccessZones {
		if !r.accessZoneGuard(z, a.Id) {
			continue
		}
		for _, rec := range r.state.AccessZones.Records {
			if rec.Zone != z.ID || (rec.Phase != "countdown" && rec.Phase != "fire") {
				continue
			}
			_, at, ok := r.knownCombatLifeActor(rec.Person)
			if !ok {
				continue
			}
			dx, dy := int64(at.X)-int64(a.X), int64(at.Y)-int64(a.Y)
			if d := dx*dx + dy*dy; d > 0 && (!found || d < best) {
				best, found = d, true
				a.FaceX, a.FaceY = float64(dx), float64(dy)
			}
		}
	}
}

// appendAccessZones: the records the hero may know — his own, and those of people he sees — and the shots of the last
// second (their points are in his view or he is the target).
func (r *Runtime) appendAccessZones(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView) {
	s := r.state.AccessZones
	if s == nil || hero == nil || hero.Trip != nil {
		return
	}
	now := r.state.Tick * r.tickNS()
	people := map[string]turretWatchPerson{}
	for _, p := range r.turretWatchPeople(hero.Level) {
		people[p.ID] = p
	}
	cell := r.turretWatchCellMM(hero.Level)
	byID := map[string]accessZone{}
	for _, z := range r.world.AccessZones {
		byID[z.ID] = z
	}
	for _, rec := range s.Records {
		p, ok := people[rec.Person]
		z := byID[rec.Zone]
		if !ok || z.LevelID != hero.Level || (rec.Person != playerActorID && !viewSees(perception, int32(p.XMM/cell), int32(p.YMM/cell))) {
			continue
		}
		total := int64(0)
		switch rec.Phase {
		case "scan":
			total = accessZoneMS(z.ScanSeconds)
		case "countdown":
			total = accessZoneMS(z.CountdownSeconds)
		}
		elapsed := max(int64(0), (now-rec.SinceNS)/1000000)
		view.AccessZone = append(view.AccessZone, &pb.PocAccessZoneState{ZoneId: rec.Zone, PersonId: rec.Person, Phase: rec.Phase, ElapsedMs: elapsed,
			RemainingMs: max(int64(0), total-elapsed), TotalMs: total, SampleNs: now, AtM: []float64{float64(p.XMM) / 1000, float64(p.YMM) / 1000}})
	}
	for _, shot := range s.Shots {
		if now-shot.AtNS >= 1000000000 || (shot.Target != playerActorID && !viewSees(perception, int32(shot.ToMM[0]/cell), int32(shot.ToMM[1]/cell))) {
			continue
		}
		view.AccessZoneShots = append(view.AccessZoneShots, &pb.PocAccessZoneShot{TurretId: shot.Turret, TargetId: shot.Target, Serial: shot.Serial, SampleNs: shot.AtNS,
			Wounded: shot.Wounded, ToM: []float64{float64(shot.ToMM[0]) / 1000, float64(shot.ToMM[1]) / 1000, float64(shot.ToMM[2]) / 1000}})
	}
}

// validateAccessZones: saved records belong to zones of the hero's level, a phase each, no guard and no dead body among
// them, clocks not ahead of the tick; shots of the zones' posts with serials under the counter.
func (r *Runtime) validateAccessZones(s state) error {
	if s.AccessZones == nil {
		return nil
	}
	if len(r.world.AccessZones) == 0 {
		return errors.New("access zone state in a world without access zones")
	}
	hero := s.Life.Actor(playerActorID)
	now := s.Tick * r.tickNS()
	zones := map[string]accessZone{}
	for _, z := range r.world.AccessZones {
		zones[z.ID] = z
	}
	seen := map[string]bool{}
	for _, rec := range s.AccessZones.Records {
		z, ok := zones[rec.Zone]
		if !ok || hero == nil || hero.Trip != nil || hero.Level != z.LevelID {
			return fmt.Errorf("access zone record %s/%s is saved away from the hero's level", rec.Zone, rec.Person)
		}
		if seen[rec.Zone+"\x00"+rec.Person] || rec.Person == "" || rec.SinceNS > now || rec.SinceNS < 0 {
			return fmt.Errorf("access zone record %s/%s is duplicated or out of its clock", rec.Zone, rec.Person)
		}
		seen[rec.Zone+"\x00"+rec.Person] = true
		switch rec.Phase {
		case "scan", "countdown":
			if rec.By != "" {
				return fmt.Errorf("access zone record %s/%s has a right before its scan ended", rec.Zone, rec.Person)
			}
		case "granted":
			if rec.By != "caste" && rec.By != "pass" && rec.By != "escort" {
				return fmt.Errorf("access zone record %s/%s is granted without a right", rec.Zone, rec.Person)
			}
		case "fire":
			if z.Fire != "after_scan_and_countdown" || rec.By != "" {
				return fmt.Errorf("access zone record %s/%s is under fire in a zone that never fires", rec.Zone, rec.Person)
			}
		default:
			return fmt.Errorf("access zone record %s/%s has an unknown phase %q", rec.Zone, rec.Person, rec.Phase)
		}
		for _, p := range r.accessZonePosts(z) {
			if p.guard(rec.Person) {
				return fmt.Errorf("access zone record %s/%s checks a guard of the post", rec.Zone, rec.Person)
			}
		}
	}
	for _, shot := range s.AccessZones.Shots {
		known := false
		for _, z := range r.world.AccessZones {
			for _, t := range z.Turrets {
				known = known || (t == shot.Turret && z.Fire == "after_scan_and_countdown")
			}
		}
		if !known || shot.Serial == 0 || shot.Serial > s.AccessZones.Serial || shot.AtNS > now {
			return fmt.Errorf("access zone shot %d of %s is not a shot of a zone's fire", shot.Serial, shot.Turret)
		}
	}
	return nil
}
