 m:=seatedFixture();l:=LifeModel{Locations:map[string]LifeLocation{"market":{Terrain:[]string{"........","........","........","........","........","........","........","........"}}},Walkable:map[string]bool{".":true}}
 if err:=m.Places[0].Seating.validate(l,m.Places[0]);err!=nil{t.Fatal(err)}
 bad:=*m.Places[0].Seating;bad.Queue=[]LifeSpot{{ID:"q1",At:Cell{1,5},Pose:"stand"}};if bad.validate(l,m.Places[0])==nil{t.Fatal("a queue place on a seat cell was accepted")}
 held:=map[string]Cell{};bought:=0
 svc:=LifeBrainServices{Offers:func(_,kind,_ string)[]LifeAffordance{if kind!="seated_food"{return nil};return []LifeAffordance{{ID:"yatai",Kind:kind,Level:"market"}}},
  Buy:func(_ string,p LifeAffordance,food bool)bool{bought++;return food&&p.Kind=="seated_food"},
  SeatsTaken:func(_,_,self string)map[Cell]bool{out:=map[Cell]bool{};for id,at:=range held{if id!=self{out[at]=true}};return out},
  TravelSeconds:func(string,Cell,Cell)int64{return 30}}
 schedule:=LifeStep{Level:"market",At:Cell{6,6},Activity:"market"};home:=LifeStep{Level:"home",Activity:"sleep"}
 // Late in the window (past every personal arrival delay) and only lightly hungry: the meal-time appetite decides.
 noon:=int64(13*3600+59*60);people:=[]*LifeBrain{}
 for i:=0;i<3;i++{b:=&LifeBrain{Initialized:true,RationOrder:"order.fixture",LastSecond:noon,Needs:[5]int64{150000,100000,0,0,0},WorkDays:map[int64]int64{}};id:=fmt.Sprintf("p%d",i)
  target:=b.advance(m,svc,id,"market","rest",Cell{6,6},true,true,false,schedule,home,0,noon,42);people=append(people,b)
  if b.Goal.GoalID!="seated_food"||b.Seat==""{t.Fatalf("%s did not choose the counter: %+v",id,b.Goal)};held[id]=target.At}
 if people[0].Seat==people[1].Seat||people[0].SeatQueue||people[1].SeatQueue||!people[2].SeatQueue||people[2].Seat!="q1"{t.Fatalf("seats double booked or no queue: %s %s %s",people[0].Seat,people[1].Seat,people[2].Seat)}
 b:=people[0];at:=held["p0"]
 b.advance(m,svc,"p0","market","eat_at_yatai",at,true,true,false,schedule,home,0,noon+30,42)
 if bought!=1||b.SeatedAt!=noon+30||b.SitUntil<noon+30+23+600||b.SitUntil>noon+30+23+1500||b.Needs[0]!=0{t.Fatalf("meal on the seat: bought %d %+v",bought,b)}
 if err:=b.Validate(m,noon+30);err!=nil{t.Fatal(err)}
 x,phase,_,ok:=b.SeatPresentation(m,"market",at);if !ok||phase!="sit"||x.ID!=b.Seat{t.Fatal("seated body not presented")}
 b.advance(m,svc,"p0","market","eat_at_yatai",at,true,true,false,schedule,home,0,b.SitUntil,42)
 if b.RiseAt!=b.SitUntil{t.Fatal("no rise at the end of the meal")}
 rise:=b.RiseAt;target:=b.advance(m,svc,"p0","market","eat_at_yatai",at,true,true,false,schedule,home,0,rise+10,42)
 if target.At!=at||b.Seat==""{t.Fatal("left the seat during the rise")}
 b.advance(m,svc,"p0","market","eat_at_yatai",at,true,true,false,schedule,home,0,rise+23,42)
 if b.Seat!=""||b.Place.Kind=="seated_food"{t.Fatalf("seat not released after the rise: %+v",b)}
 // The queued person takes the freed seat at once (the host now reports it free).
 delete(held,"p0");q:=people[2];target=q.advance(m,svc,"p2","market","eat_at_yatai",Cell{1,7},true,true,false,schedule,home,0,rise+24,42)
 if q.SeatQueue||target.At!=at{t.Fatalf("queue did not move to the freed seat: %+v",q)}
 // No second visit in the same window.
 b.NextDecision=0;b.advance(m,svc,"p0","market","rest",Cell{6,6},true,true,false,schedule,home,0,rise+60,42)
 if b.Goal.GoalID=="seated_food"{t.Fatal("came back in the same meal window")}
}
// Food court v1.1 (owner 16.11 «пару столиков на которых нпс смогут стоя поесть»): a standing-table guest reserves his place
// at the table, buys at a pickup place of the counter, waits to be handed the meal, carries it to the table, eats standing,
// rises and leaves; the place is held all the while; the saved state is valid at every step.
func TestStandingTableBuyAtCounterEatAtTable(t *testing.T){
 m:=seatedFixture();s:=m.Places[0].Seating
 s.Seats=[]LifeSpot{{ID:"t1n",At:Cell{4,2},Pose:"table",Yaw:180},{ID:"t1e",At:Cell{5,3},Pose:"table",Yaw:270}}
 s.Queue=nil;s.Pickup=[]LifeSpot{{ID:"p1",At:Cell{1,6},Pose:"stand",Yaw:0}};s.PickupSeconds=20;s.SitDown=4;s.Rise=3
 s.Items=[]LifeServiceItem{{Definition:"porridge",Food:true,ChancePPM:1000000},{Definition:"tea",Food:false,ChancePPM:600000}}
 l:=LifeModel{Locations:map[string]LifeLocation{"market":{Terrain:[]string{"........","........","........","........","........","........","........","........"}}},Walkable:map[string]bool{".":true}}
 if err:=s.validate(l,m.Places[0]);err!=nil{t.Fatal(err)}
 for name,mut:=range map[string]func(x *LifeSeating){
  "no_pickup":func(x *LifeSeating){x.Pickup=nil},
  "queue":func(x *LifeSeating){x.Queue=[]LifeSpot{{ID:"q1",At:Cell{1,7},Pose:"stand"}}},
  "mixed":func(x *LifeSeating){x.Seats=append(x.Seats,LifeSpot{ID:"s9",At:Cell{6,6},Pose:"sit"})},
  "pickup_seconds":func(x *LifeSeating){x.PickupSeconds=0},
  "pickup_pose":func(x *LifeSeating){x.Pickup=[]LifeSpot{{ID:"p1",At:Cell{1,6},Pose:"sit"}}},
  "pickup_on_table":func(x *LifeSeating){x.Pickup=[]LifeSpot{{ID:"p1",At:Cell{4,2},Pose:"stand"}}},
 }{bad:=*s;bad.Seats=append([]LifeSpot{},s.Seats...);mut(&bad);if bad.validate(l,m.Places[0])==nil{t.Fatalf("%s accepted",name)}}
 held:=map[string]Cell{};bought:=0
 svc:=LifeBrainServices{Offers:func(_,kind,_ string)[]LifeAffordance{if kind!="seated_food"{return nil};return []LifeAffordance{{ID:"yatai",Kind:kind,Level:"market"}}},
  Buy:func(_ string,p LifeAffordance,food bool)bool{bought++;return p.Kind=="seated_food"},
  SeatsTaken:func(_,_,self string)map[Cell]bool{out:=map[Cell]bool{};for id,at:=range held{if id!=self{out[at]=true}};return out},
  TravelSeconds:func(string,Cell,Cell)int64{return 30}}
 schedule:=LifeStep{Level:"market",At:Cell{6,6},Activity:"market"};home:=LifeStep{Level:"home",Activity:"sleep"}
 noon:=int64(13*3600+59*60)
 b:=&LifeBrain{Initialized:true,RationOrder:"order.fixture",LastSecond:noon,Needs:[5]int64{150000,100000,0,0,0},WorkDays:map[int64]int64{}}
 target:=b.advance(m,svc,"p0","market","rest",Cell{6,6},true,true,false,schedule,home,0,noon,42)
 if b.Goal.GoalID!="seated_food"||b.Seat==""||target.At!=(Cell{1,6})||b.SeatPicked{t.Fatalf("not to the pickup place first: %+v -> %+v",b,target)}
 if err:=b.Validate(m,noon);err!=nil{t.Fatal(err)}
 seat,_:=s.spot(b.Seat);held["p0"]=seat.At
 // at the counter: bought on arrival, then served for PickupSeconds
 b.advance(m,svc,"p0","market","eat_at_yatai",Cell{1,6},true,true,false,schedule,home,0,noon+30,42)
 if bought!=1||b.PickedAt!=noon+30||b.SeatItem!="porridge"||b.SeatPicked{t.Fatalf("not bought at the counter: %d %+v",bought,b)}
 if err:=b.Validate(m,noon+30);err!=nil{t.Fatal(err)}
 if x,phase,_,ok:=b.SeatPresentation(m,"market",Cell{1,6});!ok||phase!="queue"||x.ID!="p1"{t.Fatal("waiting at the counter not presented")}
 target=b.advance(m,svc,"p0","market","eat_at_yatai",Cell{1,6},true,true,false,schedule,home,0,noon+40,42)
 if target.At!=(Cell{1,6}){t.Fatal("left the counter before being served")}
 target=b.advance(m,svc,"p0","market","eat_at_yatai",Cell{1,6},true,true,false,schedule,home,0,noon+50,42)
 if !b.SeatPicked||target.At!=seat.At{t.Fatalf("not on to the table: %+v",target)}
 if err:=b.Validate(m,noon+50);err!=nil{t.Fatal(err)}
 // another guest finds the place held while the first walks over
 c:=&LifeBrain{Initialized:true,RationOrder:"order.fixture",LastSecond:noon,Needs:[5]int64{150000,100000,0,0,0},WorkDays:map[int64]int64{}}
 c.advance(m,svc,"p1","market","rest",Cell{6,6},true,true,false,schedule,home,0,noon+50,42)
 if c.Seat==b.Seat{t.Fatal("a held table place was given again")}
 // at the table: no second purchase, the meal eaten standing
 b.advance(m,svc,"p0","market","eat_at_yatai",seat.At,true,true,false,schedule,home,0,noon+80,42)
 if bought!=1||b.SeatedAt!=noon+80||b.Needs[0]!=0||b.SitUntil<noon+80+4+600{t.Fatalf("not eating at the table: bought %d %+v",bought,b)}
 if x,phase,_,ok:=b.SeatPresentation(m,"market",seat.At);!ok||phase!="sit"||x.Pose!="table"{t.Fatal("eating at the table not presented")}
 if err:=b.Validate(m,noon+80);err!=nil{t.Fatal(err)}
 b.advance(m,svc,"p0","market","eat_at_yatai",seat.At,true,true,false,schedule,home,0,b.SitUntil,42)
 rise:=b.RiseAt;b.advance(m,svc,"p0","market","eat_at_yatai",seat.At,true,true,false,schedule,home,0,rise+3,42)
 if b.Seat!=""||b.SeatItem!=""||b.PickedAt!=0{t.Fatalf("table place not released: %+v",b)}
 // a saved guest at the counter with a forged target is refused
 d:=*c;if d.Seat!=""{d.Target.At=Cell{7,7};if d.Validate(m,noon+50)==nil{t.Fatal("a guest away from the pickup place was saved")}}
}
// demo-hub v11-text: occupancy windows - below min_seated anyone free comes at once (no delay, no chance roll, not even
// hungry: then a mug of tea, no meal), at max_seated nobody new comes; regulars hold seats as posts and never queue.
func TestYataiOccupancyWindowsTopUpAndCap(t *testing.T){
 m:=seatedFixture();s:=m.Places[0].Seating;s.Windows=[]LifeMealWindow{{From:12*3600,To:14*3600,ChancePPM:0,MinSeated:1,MaxSeated:1,SitMin:1200,SitMax:1300}};s.Regulars=[]string{"r1"}
 l:=LifeModel{Locations:map[string]LifeLocation{"market":{Terrain:[]string{"........","........","........","........","........","........","........","........"}}},Walkable:map[string]bool{".":true}}
 if err:=s.validate(l,m.Places[0]);err!=nil{t.Fatal(err)}
 for name,w:=range map[string]LifeMealWindow{"min over max":{From:0,To:3600,MinSeated:2,MaxSeated:1},"max over seats":{From:0,To:3600,MaxSeated:3},"short stay":{From:0,To:3600,SitMin:30,SitMax:60}}{bad:=*s;bad.Windows=[]LifeMealWindow{w};if bad.validate(l,m.Places[0])==nil{t.Fatalf("%s accepted",name)}}
 held:=map[string]Cell{};meals:=map[string]bool{}
 svc:=LifeBrainServices{Offers:func(_,kind,_ string)[]LifeAffordance{if kind!="seated_food"{return nil};return []LifeAffordance{{ID:"yatai",Kind:kind,Level:"market"}}},
  Buy:func(id string,p LifeAffordance,meal bool)bool{meals[id]=meal;return p.Kind=="seated_food"},
  SeatsTaken:func(_,_,self string)map[Cell]bool{out:=map[Cell]bool{};for id,at:=range held{if id!=self{out[at]=true}};return out},
  TravelSeconds:func(string,Cell,Cell)int64{return 30}}
 schedule:=LifeStep{Level:"market",At:Cell{6,6},Activity:"market"};home:=LifeStep{Level:"home",Activity:"sleep"}
 at:=int64(12*3600+10)
 fresh:=func()*LifeBrain{return &LifeBrain{Initialized:true,RationOrder:"order.fixture",LastSecond:at,Needs:[5]int64{10000,100000,0,0,0},WorkDays:map[int64]int64{}}}
 r:=fresh();r.advance(m,svc,"r1","market","rest",Cell{6,6},true,true,false,schedule,home,0,at,42);if r.Goal.GoalID=="seated_food"{t.Fatal("a regular queued for its own counter")}
 p0:=fresh();target:=p0.advance(m,svc,"p0","market","rest",Cell{6,6},true,true,false,schedule,home,0,at,42)
 if p0.Goal.GoalID!="seated_food"||p0.SeatQueue||p0.Seat==""{t.Fatalf("not hungry, chance 0, start of the window, below min: must come and take a seat: %+v",p0.Goal)};held["p0"]=target.At
 p1:=fresh();p1.Needs[0]=900000;p1.advance(m,svc,"p1","market","rest",Cell{6,6},true,true,false,schedule,home,0,at,42)
 if p1.Goal.GoalID=="seated_food"{t.Fatal("came although the counter is at max_seated")}
 p0.advance(m,svc,"p0","market","eat_at_yatai",target.At,true,true,false,schedule,home,0,at+30,42)
 if p0.SeatedAt!=at+30||meals["p0"]||p0.Meals!=0||p0.Needs[0]<10000||p0.SitUntil<at+30+23+1200||p0.SitUntil>at+30+23+1300{t.Fatalf("tea visit with the window's stay: meal %v %+v",meals["p0"],p0)}
}

// Saving a valid late meal on day two must use the same stride as seatMarker.
func TestYataiSeatWindowSaveAcrossDays(t *testing.T){
 m:=seatedFixture()
 m.Places[0].Seating.Windows=nil
 for i:=int64(0);i<31;i++{m.Places[0].Seating.Windows=append(m.Places[0].Seating.Windows,LifeMealWindow{From:i*1800,To:(i+1)*1800,ChancePPM:1000000})}
 for _,day:=range []int64{0,1,7}{
  seconds:=day*86400+31*1800
  b:=LifeBrain{Initialized:true,RationOrder:m.RationOrder,LastSecond:seconds,SeatWindow:seatMarker(seconds,30)}
  raw,err:=json.Marshal(b);if err!=nil{t.Fatal(err)}
  var loaded LifeBrain;if err=json.Unmarshal(raw,&loaded);err!=nil{t.Fatal(err)}
  if err=loaded.Validate(m,seconds);err!=nil{t.Fatalf("day %d valid window rejected: %v",day,err)}
  loaded.SeatWindow=seatMarker((day+1)*86400,0)
  if loaded.Validate(m,seconds)==nil{t.Fatal("future-day window accepted")}
 }
}
