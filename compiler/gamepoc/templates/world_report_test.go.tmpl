// Full report and acceptance run as normal generated tests; -short may omit days.
// NPC_WORLD_REPORT_DAYS extends N-versus-day-1 comparison without changing the kernel.
func TestNPCWorldDayThresholds(t *testing.T) {
	if testing.Short() {
		t.Skip("full world days")
	}
	days := 2
	if v := os.Getenv("NPC_WORLD_REPORT_DAYS"); v != "" {
		n, err := strconv.Atoi(v)
		if err != nil || n < 2 || n > 30 {
			t.Fatal("days must be in [2,30]")
		}
		days = n
	}
	rep := worldRunAuditDay(t, 100, int64(days)*86400, true)
	worldAuditWrite(t, "world-days.json", rep)
	if rep.GameSeconds != int64(days)*86400 || rep.Ticks != rep.GameSeconds || len(rep.Checkpoints) != days*24 || len(rep.DaysCompared) != days-1 {
		t.Fatal("incomplete world report")
	}
	total := int64(0)
	for _, v := range rep.ActivityTotals {
		total += v
	}
	if total != int64(rep.NamedActors+100)*rep.GameSeconds {
		t.Fatal("unaccounted actor time")
	}
	if rep.PopulationAggregates["mean_meaningful_activities"] < 1.5 || rep.NamedDecisionCount == 0 || rep.PopulationDecisionCount == 0 {
		t.Fatal("frozen world or missing reasons")
	}
	if rep.QueueReasons["active_limit"] != 0 {
		t.Fatal("active budget stranded residents at entry")
	}
	for _, comparison := range rep.DaysCompared {
		if comparison.Samples == 0 || comparison.Identical >= 1 {
			t.Fatal("days are identical or comparison empty")
		}
	}
	for _, n := range rep.PurchasesPerDay {
		if n <= 0 {
			t.Fatal("a complete Life100 day had no NPC purchase")
		}
	}
	if rep.NPCPurchases <= 0 || rep.FoodConsumed <= 0 {
		t.Fatal("no NPC market purchases/food")
	}
	worldCheckStockAccounting(t, rep)
	if rep.MoneyDelta != rep.WageSource {
		t.Fatal("money changed outside explicit wage source")
	}
	if rep.PeakHunger >= 1000000 {
		t.Fatal("starvation threshold reached")
	}
	worldCheckWorkerAttendance(t, rep, days)
}
func TestNPCWorldCrowdBudget(t *testing.T) {
	if os.Getenv("NPC_WORLD_PERF") == "" {
		t.Skip("set NPC_WORLD_PERF=1 on the reference machine")
	}
	t.Setenv("NPC_WORLD_REPORT_HERO_AUTO", "1")
	old := worldAuditRuntimeOverride
	worldAuditRuntimeOverride = func(r *Runtime) { r.world.Life.Population.MaxActors = 500; r.world.Life.Population.MaxActive = 200 }
	defer func() { worldAuditRuntimeOverride = old }()
	rep := worldRunAuditDay(t, 500, 86400, false)
	worldAuditWrite(t, "world-500-200.json", rep)
	active := 0
	for _, h := range rep.Hours {
		if h.MaxActive > active {
			active = h.MaxActive
		}
	}
	if active != 200 {
		t.Fatalf("benchmark did not exercise exactly 200 physical residents: %d", active)
	}
	if rep.TickP99US >= 5000 {
		t.Fatalf("500/200 tick p99 %.1f us exceeds 5000 us", rep.TickP99US)
	}
	if rep.QueueReasons["active_limit"] != 0 {
		t.Fatal("active budget created a queue")
	}
}
func BenchmarkNPCWorld500200(b *testing.B) {
	old := worldAuditRuntimeOverride
	worldAuditRuntimeOverride = func(r *Runtime) {
		r.world.Life.Population.MaxActors = 500
		r.world.Life.Population.MaxActive = 200
		r.world.Life.StartSeconds = 22 * 3600
	}
	defer func() { worldAuditRuntimeOverride = old }()
	b.Setenv("NPC_WORLD_REPORT_HERO_AUTO", "1")
	r := worldAuditRuntime(b, 500)
	for i := 0; i < 300; i++ {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			b.Fatal(err)
		}
	}
	samples := make([]float64, 0, b.N)
	b.ReportAllocs()
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		r.state.Tick++
		start := time.Now()
		if err := r.advanceLifeFrameBy(1); err != nil {
			b.Fatal(err)
		}
		samples = append(samples, float64(time.Since(start).Nanoseconds())/1000)
	}
	b.StopTimer()
	p99 := worldPct(samples, .99)
	b.ReportMetric(p99, "p99-us")
	if b.N >= 1000 && p99 >= 5000 {
		b.Fatalf("500/200 benchmark p99 %.1f us exceeds 5000 us", p99)
	}
}

// Strict live acceptance: every observed working frame is open or a bounded
// declared break. Being present once per day alone cannot satisfy this test.
func TestNPC1CalendarRates(t *testing.T) {
	if testing.Short() {
		t.Skip("two authored days per rate")
	}
	rates := []int64{1, 10, 30}
	if os.Getenv("NPC_RATE_ONLY") != "" {
		n, e := strconv.ParseInt(os.Getenv("NPC_RATE_ONLY"), 10, 64)
		if e != nil {
			t.Fatal(e)
		}
		rates = []int64{n}
	}
	for _, rate := range rates {
		t.Run(fmt.Sprint(rate), func(t *testing.T) {
			t.Setenv("NPC_WORLD_REPORT_RATE", fmt.Sprint(rate))
			rep := worldRunAuditDay(t, 100, 2*86400, true)
			worldAuditWrite(t, fmt.Sprintf("world-rate-%d.json", rate), rep)
			if rep.ShopUnexpectedClosed != 0 {
				t.Errorf("unplanned/overlong closure: %d shop-seconds; %v", rep.ShopUnexpectedClosed, rep.ShopFailures)
			}
			worldCheckWorkerAttendance(t, rep, 2)
			if len(rep.PurchasesPerDay) != 2 || rep.PurchasesPerDay[0] <= 0 || rep.PurchasesPerDay[1] <= 0 {
				t.Errorf("no daily purchases: %v", rep.PurchasesPerDay)
			}
			if rep.MoneyDelta != rep.WageSource {
				t.Error("money not conserved")
			}
			worldCheckStockAccounting(t, rep)
			if rep.PeakHunger >= 1000000 {
				t.Errorf("hunger saturated: %d", rep.PeakHunger)
			}
			if len(rep.DaysCompared) != 1 || rep.DaysCompared[0].Identical >= 1 {
				t.Error("identical/empty days")
			}
			if os.Getenv("NPC_WORLD_PERF") != "" && rep.TickP99US >= 5000 {
				t.Errorf("physical frame p99 %.1f us exceeds 5000 us", rep.TickP99US)
			}
		})
	}
}
