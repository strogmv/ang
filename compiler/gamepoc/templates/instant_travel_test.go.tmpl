// Audits that inspect one physical frame must use the ordinary kernel frame;
// the public host step may now contain thousands of elapsed travel frames.
func stepLifeFrameForAudit(t *testing.T,r *Runtime){t.Helper();r.state.Tick++;if err:=r.state.Inventory.Advance(r.state.Tick);err!=nil{t.Fatal(err)};if err:=r.advanceLifeFrameBy(r.state.Life.SecondsPerTick);err!=nil{t.Fatal(err)};r.updateLifeExploration()}

func instantEdgeFixture(t *testing.T,paid bool,population int,seconds,rate int64)(*Runtime,behavior.LifeEdge){
 t.Helper();r:=lifeRuntimeFixture(t);var edge behavior.LifeEdge;for _,e:=range r.world.Life.Edges{if (paid&&e.Fare!=nil)||(!paid&&e.Mode=="walk"){edge=e;break}};if edge.ID==""{t.Skip("matching authored transition missing")}
 r.world.Life.StartSeconds=seconds;life,err:=r.world.Life.StartWithPopulation(population,playerActorID);if err!=nil{t.Fatal(err)};r.state.Tick=0;r.initLifeState(life);r.state.Life.SecondsPerTick=rate
 h:=r.state.Life.Actor(playerActorID);h.Level=edge.From;h.Position=edge.Exit;h.Goal=edge.Exit;h.Path=nil;h.PendingPath=nil;h.Trip=nil;h.Manual=true;h.Arrived=false;h.OverrideLevel=edge.To;h.OverrideAt=edge.Entry;h.OverrideEdge=edge.ID;h.WaitingDeparture=0;r.syncLifeHero();r.syncRegionKnowledge();r.updateLifeExploration();if err:=r.state.Life.AdvancePopulation(r.world.Life,playerActorID);err!=nil{t.Fatal(err)};return r,edge
}
func replayInstantFrames(t *testing.T,r *Runtime,origin string){
 t.Helper();r.state.Life.BeginControlledTravel(r.world.Life,r.admitLifeTravel);if err:=r.state.Life.AdvancePopulation(r.world.Life,playerActorID);err!=nil{t.Fatal(err)}
 for frame:=0;frame<instantTravelMaxFrames&&r.currentLevel()==origin;frame++{h:=r.state.Life.Actor(playerActorID);if h.AdmissionDeniedEdge!=""{break};boundary:=h.WaitingDeparture;if h.Trip!=nil{boundary=h.Trip.Arrival};delta:=r.state.Life.SecondsPerTick;if left:=boundary-r.state.Life.Seconds;left>0&&left<delta{delta=left};if boundary<=r.state.Life.Seconds{delta=1};r.state.Tick++;if err:=r.state.Inventory.Advance(r.state.Tick);err!=nil{t.Fatal(err)};if err:=r.advanceLifeFrameBy(delta);err!=nil{t.Fatal(err)}}
 if r.currentLevel()!=origin{r.state.Life.SettleControlledArrival();r.syncLifeHero()};r.updateLifeExploration()
}
func TestInstantWalkElapsedTimePauseAndExactBoundary(t *testing.T){
 for _,rate:=range []int64{1,30}{r,e:=instantEdgeFixture(t,false,0,12345,rate);before:=r.snapshotState();r.state.Paused=true;if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};paused:=r.snapshotState();before.Paused=true;if !reflect.DeepEqual(before,paused){t.Fatal("pause changed time or actor during transition")};r.state.Paused=false;start:=r.state.Life.Seconds
  if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"enter",Destination:e.ID});err!=nil{t.Fatal(err)};h:=r.state.Life.Actor(playerActorID);if h.Level!=e.To||h.Trip!=nil||!h.Arrived||r.state.Life.Seconds-start!=e.TravelSeconds||r.state.Life.SecondsPerTick!=rate{t.Fatalf("walk did not finish immediately with exact elapsed time rate%d: %+v seconds%d",rate,h,r.state.Life.Seconds-start)};if err:=r.validateLifeSave(r.snapshotState());err!=nil{t.Fatal(err)}
 }
}
func TestInstantRailNightLife100MatchesOrdinaryWorldReplay(t *testing.T){
 r,e:=instantEdgeFixture(t,true,100,1,1);start:=r.state.Life.Seconds;departure:=e.NextDeparture(start);expected:=departure-start+e.TravelSeconds;if departure-start<3500{t.Fatal("night fixture no longer exercises near-hour wait")}
 reference:=&Runtime{world:r.world,state:r.snapshotState()};started:=time.Now();if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};elapsed:=time.Since(started);replayInstantFrames(t,reference,e.From)
 if r.currentLevel()!=e.To||r.state.Life.Actor(playerActorID).Trip!=nil||r.state.Life.Seconds-start!=expected{t.Fatal("night train did not include actual wait+travel")}
 if !reflect.DeepEqual(r.state.Life,reference.state.Life)||!reflect.DeepEqual(r.state.Inventory,reference.state.Inventory)||r.state.Tick!=reference.state.Tick{t.Fatal("instant transition diverged from ordinary NPC/economy frame replay")};if err:=r.validateLifeSave(r.snapshotState());err!=nil{t.Fatal(err)}
 t.Logf("night life100: wait=%ds trip=%ds elapsed=%ds frames=%d synchronous_ms=%.3f",departure-start,e.TravelSeconds,expected,r.state.Tick,float64(elapsed.Microseconds())/1000)
}
func TestInstantDeniedFareAndRestoredPriorTripNeverDebitTwice(t *testing.T){
 r,e:=instantEdgeFixture(t,true,0,1,1);payer:="";for id,a:=range r.state.Inventory.Accounts{if a.Owner==playerActorID&&a.Currency==e.Fare.Currency{payer=id;break}};if payer==""{t.Fatal("missing payer")};account:=r.state.Inventory.Accounts[payer];account.Balance=0;r.state.Inventory.Accounts[payer]=account;before:=r.snapshotState();if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};h:=r.state.Life.Actor(playerActorID);if h.Level!=e.From||h.Trip!=nil||h.AdmissionDeniedEdge!=e.ID||r.state.Life.Seconds!=before.Life.Seconds||!reflect.DeepEqual(r.state.Inventory,before.Inventory){t.Fatal("unaffordable transition changed money/time or bypassed admission")}
 // A genuine legacy in-progress Trip: board through the existing kernel at a
 // departure, save it, then let the new host finish only its remaining time.
 r,e=instantEdgeFixture(t,true,0,3600,1);r.state.Life.BeginControlledTravel(r.world.Life,r.admitLifeTravel);if r.state.Life.Actor(playerActorID).Trip==nil{t.Fatal("legacy trip fixture did not board")};if err:=r.state.Life.AdvancePopulation(r.world.Life,playerActorID);err!=nil{t.Fatal(err)};r.syncLifeHero();paid:=r.state.Inventory.Clone();slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,r.snapshotState());err!=nil{t.Fatal(err)};loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};start:=loaded.Life.Seconds;client:=&connection{out:make(chan *pb.ServerMessage,16),stop:make(chan struct{})};r.client=client;r.diskComplete(diskResult{job:diskJob{client:client,id:"legacy-trip",action:"load",slot:slot,epoch:r.state.Epoch},loaded:loaded});if r.currentLevel()!=e.To||r.state.Life.Actor(playerActorID).Trip!=nil||r.state.Life.Seconds-start!=e.TravelSeconds||!reflect.DeepEqual(paid.Accounts,r.state.Inventory.Accounts)||!reflect.DeepEqual(paid.Cursors,r.state.Inventory.Cursors){t.Fatal("restored trip waited in realtime, lost time or paid twice")}
}

func TestInstantRailCoarseClockAndSingleCommandResponse(t *testing.T){
 r,e:=instantEdgeFixture(t,true,0,1,30);start:=r.state.Life.Seconds;expected:=e.NextDeparture(start)-start+e.TravelSeconds;if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};if r.state.Life.Seconds-start!=expected||r.state.Life.SecondsPerTick!=30{t.Fatal("coarse calendar rounded a partial departure boundary")}
 r,e=instantEdgeFixture(t,false,0,12345,1);client:=&connection{out:make(chan *pb.ServerMessage,16),stop:make(chan struct{})};r.command(input{client:client,msg:&pb.ClientMessage{Msg:&pb.ClientMessage_LifeCommand{LifeCommand:&pb.PocLifeCommand{RequestId:"instant-walk",Epoch:r.state.Epoch,Action:"enter",Destination:e.ID}}}});states:=0;for len(client.out)>0{msg:=<-client.out;if state:=msg.GetGameState();state!=nil{states++;if state.Life.Transit||state.Life.LevelId!=e.To||state.Life.TravelRemainingSeconds!=0{t.Fatal("command published a countdown or pre-arrival scene")}}};if states!=1{t.Fatalf("expected one final state, got%d",states)}
}
func TestInstantTravelOccupiedLandingHasBoundedWorkAndNoOverlap(t *testing.T){
 r,e:=instantEdgeFixture(t,false,0,12345,1);candidates:=[]behavior.Cell{e.Entry,{X:e.Entry.X+1,Y:e.Entry.Y},{X:e.Entry.X,Y:e.Entry.Y+1},{X:e.Entry.X-1,Y:e.Entry.Y},{X:e.Entry.X,Y:e.Entry.Y-1}};next:=0
 for _,at:=range candidates{if !r.world.Life.Walks(e.To,at){continue};for next<len(r.state.Life.Actors)&&r.state.Life.Actors[next].ID==playerActorID{next++};if next>=len(r.state.Life.Actors){t.Fatal("fixture needs one named body per legal landing")};a:=&r.state.Life.Actors[next];a.Level=e.To;a.Position=at;a.Goal=at;a.Path=nil;a.Trip=nil;a.PendingPath=nil;a.Manual=true;a.OverrideLevel="";a.OverrideEdge="";a.Arrived=true;next++}
 if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};h:=r.state.Life.Actor(playerActorID);if h.Level!=e.From||h.Trip==nil||r.state.Tick!=instantTravelMaxFrames||r.instantTravelStalled==""{t.Fatal("blocked landing bypassed bodies or lost work bound")};tick:=r.state.Tick;if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};if r.state.Tick!=tick{t.Fatal("permanently blocked leg repeated a huge batch")};r.step();if r.state.Tick!=tick+1{t.Fatal("bounded fallback stopped ordinary world simulation")};if err:=r.validateLifeSave(r.snapshotState());err!=nil{t.Fatal(err)}
}

func TestInstantRestoredOverdueTripUsesAlreadyElapsedClock(t *testing.T){
 r,e:=instantEdgeFixture(t,false,0,12345,1);r.state.Life.BeginControlledTravel(r.world.Life,r.admitLifeTravel);h:=r.state.Life.Actor(playerActorID);if h.Trip==nil{t.Fatal("missing trip")};r.state.Life.Seconds=h.Trip.Arrival;before:=r.state.Life.Seconds;tick:=r.state.Tick;if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};if h.Level!=e.To||h.Trip!=nil||r.state.Life.Seconds!=before||r.state.Tick!=tick{t.Fatal("already elapsed trip added fake time/ticks")}
}

func TestInstantRailFullDepartureUsesNextRealSlotAndOneFare(t *testing.T){
 r,e:=instantEdgeFixture(t,true,0,3600,1);filled:=0;for i:=range r.state.Life.Actors{a:=&r.state.Life.Actors[i];if a.ID==playerActorID{continue};a.Level=e.From;a.Position=e.Exit;a.Path=nil;a.PendingPath=nil;a.Trip=&behavior.LifeTrip{Edge:e.ID,Departure:3600,Arrival:3600+e.TravelSeconds};filled++;if filled==e.Seats{break}};if filled!=e.Seats{t.Fatal("fixture needs enough real named passengers to fill departure")}
 before:=r.state.Inventory.Clone();start:=r.state.Life.Seconds;expected:=e.NextDeparture(start+1)-start+e.TravelSeconds;if err:=r.completeHeroTravel();err!=nil{t.Fatal(err)};if r.currentLevel()!=e.To||r.state.Life.Actor(playerActorID).Trip!=nil||r.state.Life.Seconds-start!=expected{t.Fatal("full train was bypassed or next scheduled departure was not included")};if r.state.Inventory.Cursors[playerActorID].Sequence!=before.Cursors[playerActorID].Sequence+1||r.state.Inventory.Accounts[e.Fare.ReceiverAccount].Balance-before.Accounts[e.Fare.ReceiverAccount].Balance!=e.Fare.AmountMinor{t.Fatal("full earlier departure charged or eventual fare was duplicated")};if err:=r.validateLifeSave(r.snapshotState());err!=nil{t.Fatal(err)}
}
