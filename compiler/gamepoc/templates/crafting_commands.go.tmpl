// craftingQueue: the work a master still has before a new order (FIFO).
func (r *Runtime) craftingQueue(worker string) int64 {
	var n int64
	for _, j := range r.state.Crafting.Jobs {
		if j.Worker == worker && !j.Done {
			n += j.Plan.Seconds - j.Progress
		}
	}
	return n
}

