		spots[behavior.Cell{X: s.At.X, Y: s.At.Y}] = i
	}
	visitorsRun(t, r, (11*3600-r.state.Life.Seconds%86400+86400)%86400, nil)
	most, ate := 0, map[string]int{}
	visitorsRun(t, r, 3*3600, func() {
		held := map[int]int64{}
		n := 0
		for _, b := range r.state.Visitors.Bodies {
			if b.Table == 0 {
				if b.Phase == "eat" {
					t.Fatalf("visitor %d eats without a place", b.Serial)
				}
				continue
			}
			if other, ok := held[b.Table-1]; ok {
