// Code generated by ANG. Persistent injuries follow the physical Life clock.
package poc

import (
	"angelsdemons/server/internal/behavior"
	"errors"
)

type combatCareState struct {
	Clocks map[string]int64 `json:"clocks,omitempty"`
}

func (s combatCareState) Clone() combatCareState {
	if s.Clocks != nil {
		m := make(map[string]int64, len(s.Clocks))
		for id, at := range s.Clocks {
			m[id] = at
		}
		s.Clocks = m
	}
	return s
}

// Called when an injury is first stored. Existing nonparticipants retain their
// fractional interval; repeated presentation/sync calls cannot stop blood loss.
func (r *Runtime) combatCareTrack() {
	if len(r.state.CombatRoster) == 0 {
		return
	}
	if r.state.CombatCare.Clocks == nil {
		r.state.CombatCare.Clocks = map[string]int64{}
	}
	for id, c := range r.state.CombatRoster {
		_, known := r.state.CombatCare.Clocks[id]
		if !known || r.state.Combat.Active && r.state.Combat.Actor(id) != nil {
			r.state.CombatCare.Clocks[id] = r.state.Life.Seconds
		}
		if !r.state.Combat.Active || r.state.Combat.Actor(id) == nil {
			r.combatCareHold(c)
		}
	}
}

func (r *Runtime) combatCareOnFloor(id string) (behavior.Cell, bool) {
	if a := r.state.Life.Actor(id); a != nil {
		return a.Position, a.OnFloor()
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.ID == id {
			return a.Position, a.Trip == nil && (a.Materialized || a.CombatHold)
		}
	}
	return behavior.Cell{}, false
}

func (r *Runtime) combatCareHold(c behavior.Combatant) {
	held := !c.Withdrawn&&(!c.Able() || c.StunTurns > 0 || len(c.Body)>0&&!c.BodyCanWalk)
	activity, label := "stunned", "ui.combat.stunned"
	if c.HP <= 0 || c.FightResponse=="fall" {
		activity, label = "down", "ui.combat.down"
	} else if c.Surrendered {
		activity, label = "surrendered", "ui.combat.surrendered"
	}
	if a := r.state.Life.Actor(c.ID); a != nil {
		if !a.OnFloor() {
			return
		}
		was := a.CombatHold
		a.CombatHold = held
		if held {
			a.Safety = nil
			a.Brain.InterruptService()
			a.Path = nil
			a.PendingPath = nil
			a.Goal = a.Position
			a.Activity = activity
			a.Label = label
			a.MoveStartTick = r.lifeMotionTick()
		} else if was {
			a.Arrived = c.ID == playerActorID
			a.Activity = "rest"
			a.Label = "ui.combat.finished"
			a.Brain.NextDecision = 0
		}
		return
	}
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if a.ID != c.ID {
			continue
		}
		if a.Trip != nil || !a.Materialized && !a.CombatHold {
			return
		}
		was := a.CombatHold
		a.CombatHold = held
		if held {
			a.Safety = nil
			a.Brain.InterruptService()
			a.Path = nil
			a.Goal = a.Position
			a.Activity = activity
			a.MoveStartTick = r.lifeMotionTick()
		} else if was {
			a.Arrived = false
			a.Activity = "rest"
			a.Brain.NextDecision = 0
		}
		return
	}
}

func (r *Runtime) advanceCombatCare() error {return r.advanceWoundCare()}

func (r *Runtime) validateCombatCare(s state) error {
	if len(s.CombatCare.Clocks) != len(s.CombatRoster) {
		return errors.New("orphaned injury clock")
	}
	for id, at := range s.CombatCare.Clocks {
		if _, ok := s.CombatRoster[id]; !ok || at < 0 || at > s.Life.Seconds {
			return errors.New("invalid injury clock")
		}
	}
	return nil
}
