	if hero != nil && hero.CombatHold {
		return textError{Key: "error.combat_actor_inactive"}
	}
	switch q.Action {
 case "encounter_choice", "encounter_greet", "debug_next_morning": return r.encounterCommand(q)
 case "interact":return r.playableInteract(q.Destination)
 case "illumination_power_off","illumination_power_on":return r.illuminationCommand(q.Action,q.Destination)
 case "stealth":return r.stealthCommand(q.Destination)
	case "route_preview", "route_clear", "route_go":
		return r.wayfindingCommand(q.Action, q.Destination)
	case "practice":
		return r.startPractice(q.Destination, q.PracticeRule)
	case "inspection_attribute":
		return r.setInspectionAttribute(q.InspectionAttribute, int(q.InspectionValue))
	case "gate_lockdown", "gate_release", "gate_power_off", "gate_power_on":
		return r.gateCommand(q.Action, q.Destination)
	case "fault":
		if !r.world.Config.DebugPerception || r.state.Paused {
			return errors.New("Отладка поломки недоступна")
		}
		err := r.state.Life.MaintenanceFault(q.Destination)
		if err == nil {
			if r.state.Life.PracticeExcluded == nil {
				r.state.Life.PracticeExcluded = map[string]bool{}
			}
			r.state.Life.PracticeExcluded[q.Destination] = true
		}
		return err
	case "rate":
 if hero.Sneaking&&q.SecondsPerTick>int32(r.world.Stealth.FrameSeconds){return textError{Key:"error.stealth.time"}}
		if q.SecondsPerTick != 1 && q.SecondsPerTick != 10 && q.SecondsPerTick != 30 {
			return errors.New("Неизвестный масштаб времени")
		}
		r.state.Life.SecondsPerTick = int64(q.SecondsPerTick)
	case "auto":
 hero.Sneaking=false
		r.resetInstantTravel()
		hero.AdmissionDeniedEdge = ""
		hero.PendingPath = nil
		hero.Manual = false
		hero.OverrideLevel = ""
		hero.OverrideEdge = ""
		hero.Arrived = false
		hero.Path = nil
	case "enter":
		edge := r.world.Life.Edge(q.Destination)
		if hero.Trip != nil || edge == nil || edge.From != hero.Level || !r.lifeExitKnown(*edge) {
			return errors.New("Этот выход сейчас недоступен")
		}
		r.resetInstantTravel()
		hero.AdmissionDeniedEdge = ""
		hero.PendingPath = nil
		hero.Manual = true
		hero.OverrideLevel = edge.To
		hero.OverrideAt = edge.Entry
		hero.OverrideEdge = edge.ID
		hero.Arrived = false
		hero.WaitingDeparture = 0
		// Movement v2: the body walks its pulled string to the exit cell.
		if model := r.state.Life.GateModel(r.world.Life); model.BodyCapable(hero.Level) {
			r.heroBodyNow()
			r.state.Life.EnsureHeroBody(model)
			if hero.Body != nil {
				r.state.Life.HeroBodyRouteTo(model, edge.Exit)
				hero.Goal = edge.Exit
				hero.Arrived = false
				hero.Activity = "walking"
				hero.Label = "Идёт к выходу: " + r.world.Life.Locations[edge.To].Name
				r.state.Life.ObserveDecisions()
				break
			}
		}
		// Plan immediately for responsive input; finish any already accepted segment.
		from := hero.Position
		moving := len(hero.Path) > 0
		if moving {
			from = hero.Path[0]
		}
		route, _ := r.state.Life.MoveRoute(r.world.Life, hero.ID, hero.Level, from, edge.Exit, r.lifeMotionTick())
		if moving {
			route = append([]behavior.Cell{from}, route...)
		} else {
			hero.MoveStartTick = r.lifeMotionTick()
		}
		hero.Path = route
		hero.Goal = edge.Exit
		hero.Activity = "walking"
		hero.Label = "Идёт к выходу: " + r.world.Life.Locations[edge.To].Name
