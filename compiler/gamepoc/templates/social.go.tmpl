 levelIndex:=0;if r.networkKnown(a)&&d.Issued{levelIndex=d.DangerLevel}else if known{levelIndex=cfg.HeroAction.WitnessLevel}
 level:=r.world.AI.Policy.Danger.Level(levelIndex);maxLevel:=r.world.AI.Policy.Danger.Max();profile:=r.actorProfile(*a)
