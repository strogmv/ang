func TestCombatV4EndReservesWithoutStanceAndParriesThenCounters(t *testing.T){
 r,space,s:=combatV4Fixture(t);s.Actor("b").Position=Cell{3,2};s.Actor("a").Weapon.ParryPercent=0
 combatDo(t,&s,space,r,"a",CombatAction{Type:"end"});if s.Actor("a").ReservedAP!=r.APPerTurn||s.Actor("a").Guarding{t.Fatal("remaining AP was burned or guard invented")}
 combatDo(t,&s,space,r,"b",CombatAction{Type:"attack",TargetID:"a",Mode:"quick"})
 parry,reply:=0,0;for _,e:=range s.Events{if e.Type=="parry"{parry++};if e.Type=="reaction"{reply++}}
 if parry!=1||reply!=1||s.Actor("a").ReservedAP!=r.APPerTurn-r.GuardAP-s.Actor("a").Weapon.AttackAP{t.Fatal("not exactly one paid deflection then counter")}
}
func TestCombatV4LongWeaponEntryAndKnifeExitUseReserve(t *testing.T){
 r,space,s:=combatV4Fixture(t);space.CellMM=500;s.Actor("a").Position=Cell{1,2};s.Actor("b").Position=Cell{5,2};s.Actor("a").Weapon.RangeMM=1500
 combatDo(t,&s,space,r,"a",CombatAction{Type:"end"});combatDo(t,&s,space,r,"b",CombatAction{Type:"move",To:Cell{3,2}})
 n:=0;for _,e:=range s.Events{if e.Type=="reaction"{n++;if e.To!=(Cell{4,2}){t.Fatal("long weapon did not interrupt at first reachable cell")}}};if n!=1{t.Fatal("entry reply missing or repeated")}
 // A knife also interrupts the first retreat step before it leaves reach.
 r,space,s=combatV4Fixture(t);s.Actor("b").Position=Cell{3,2};s.Actor("a").Weapon.Kind="blade";combatDo(t,&s,space,r,"a",CombatAction{Type:"end"});combatDo(t,&s,space,r,"b",CombatAction{Type:"move",To:Cell{4,2}})
 n=0;cost:=0;for _,e:=range s.Events{if e.Type=="reaction"{n++;if e.To!=(Cell{3,2}){t.Fatal("knife replied after contact was already lost")}};if e.Type=="move"{cost+=e.AP}};if n!=1||cost!=2{t.Fatalf("retreat n=%d AP=%d",n,cost)}
}
