// Code generated by ANG. Playable Life presets reuse the ordinary physical world.
package poc

import (
	"encoding/json"
	"errors"
	"fmt"
	"math"
	"sort"
	"strings"

	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

type playableInteraction struct {
	ID              string        `json:"id"`
	NameKey         string        `json:"name_key"`
	Effect          string        `json:"effect"`
	Target          string        `json:"target"`
	RequiredItem    string        `json:"required_item"`
	At              behavior.Cell `json:"at"`
	CooldownSeconds int64         `json:"cooldown_seconds"`
	Loudness        float64       `json:"loudness"`
}
type playableSceneDefinition struct {
	ID                   string                `json:"id"`
	Scenario             string                `json:"scenario"`
	Level                string                `json:"level"`
	NameKey              string                `json:"name_key"`
	ObjectiveKey         string                `json:"objective_key"`
	Guard                string                `json:"guard"`
	GuardNameKey         string                `json:"guard_name_key"`
	KeyDefinition        string                `json:"key_definition"`
	Gate                 string                `json:"gate"`
	Spawn                behavior.Cell         `json:"spawn"`
	StartSecond          int64                 `json:"start_second"`
	GuardRoute           []behavior.Cell       `json:"guard_route"`
	PatrolPauseSeconds   int64                 `json:"patrol_pause_seconds"`
	SoundMemorySeconds   int64                 `json:"sound_memory_seconds"`
	ContactMemorySeconds int64                 `json:"contact_memory_seconds"`
	GoalSource           string                `json:"goal_source"`
	Exit                 behavior.Cell         `json:"exit"`
	Interactions         []playableInteraction `json:"interactions"`
	Stores               []inv.Store           `json:"stores"`
	Sources              []inv.Source          `json:"sources"`
	// A second person of a stand, an opponent of the guard: he fights the guard where the hero does not see them (noise waves stand).
	Extras []playableExtra `json:"extras"`
}
type playableExtra struct {
	ID            string        `json:"id"`
	At            behavior.Cell `json:"at"`
	CombatProfile string        `json:"combat_profile"`
}
type playableSceneState struct {
	ID          string           `json:"id,omitempty"`
	PatrolIndex int              `json:"patrol_index,omitempty"`
	WaitUntil   int64            `json:"wait_until,omitempty"`
	Cooldowns   map[string]int64 `json:"cooldowns,omitempty"`
	Completed   bool             `json:"completed,omitempty"`
}

func (s playableSceneState) Clone() playableSceneState {
	if s.Cooldowns != nil {
		out := make(map[string]int64, len(s.Cooldowns))
		for id, until := range s.Cooldowns {
			out[id] = until
		}
		s.Cooldowns = out
	}
	return s
}

// Build independent session worlds once. No session repositions an actor in the
// canonical catalog, appends stock to it, or mutates another scene's gate/map.
func (r *Runtime) preparePlayableScenes() error {
	r.playableWorlds = map[string]worldData{}
	if len(r.world.PlayableScenes) > 16 {
		return errors.New("too many playable scenes")
	}
	ids := make([]string, 0, len(r.world.PlayableScenes))
	for id := range r.world.PlayableScenes {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		def := r.world.PlayableScenes[id]
		if err := r.validatePlayableDefinition(id, def); err != nil {
			return err
		}
		raw, err := json.Marshal(r.world)
		if err != nil {
			return err
		}
		var w worldData
		if err := json.Unmarshal(raw, &w); err != nil {
			return err
		}
		w.PlayableID = id
		w.Decks = map[string]*behavior.DeckVolume{}
		for level, original := range r.world.Decks {
			data, err := json.Marshal(original)
			if err != nil {
				return err
			}
			volume := &behavior.DeckVolume{}
			if err := json.Unmarshal(data, volume); err != nil {
				return err
			}
			if err := volume.Prepare(); err != nil {
				return err
			}
			w.Decks[level] = volume
		}
		w.Life.Walkable, w.Life.Decks = w.Walkable, w.Decks
		w.Life.StartSeconds, w.Life.SecondsPerTick = def.StartSecond, 1
		w.Life.Brain.Enabled = false
		w.Life.Population = behavior.PopulationModel{}
		w.Life.Maintenance = behavior.MaintenanceModel{}
		w.Life.Residences, w.Life.PracticeStations = nil, nil
		for actor := range w.Life.Development.Profiles {
			if actor != playerActorID && actor != def.Guard && !def.hasExtra(actor) {
				delete(w.Life.Development.Profiles, actor)
			}
		}
		people := make([]behavior.LifePerson, 0, 2)
		for _, actor := range []string{playerActorID, def.Guard} {
			person := *w.Life.Person(actor)
			at, activity := def.Spawn, "rest"
			if actor == def.Guard {
				at, activity = def.GuardRoute[0], "post"
				person.Relations = []behavior.LifeRelation{{To: playerActorID, Strength: -1}}
			}
			person.Steps = []behavior.LifeStep{{Level: def.Level, At: at, Activity: activity, Label: def.NameKey}}
			people = append(people, person)
		}
		for _, extra := range def.Extras {
			person := *w.Life.Person(extra.ID)
			person.Relations = []behavior.LifeRelation{{To: def.Guard, Strength: -1}}
			person.Steps = []behavior.LifeStep{{Level: def.Level, At: extra.At, Activity: "post", Label: def.NameKey}}
			people = append(people, person)
			people[1].Relations = append(people[1].Relations, behavior.LifeRelation{To: extra.ID, Strength: -1})
			w.CombatRuntime.Actors[extra.ID] = extra.CombatProfile
		}
		w.Life.Actors = people
		// The prototype reuses a stable body/profile ID, but its public name is
		// scene-authored. Alias the copied actor-name translation, never canon.
		for _, message := range w.Localization.Messages {
			if message.Key != def.GuardNameKey {
				continue
			}
			for i := range w.Localization.Messages {
				if w.Localization.Messages[i].Key == "actor."+def.Guard+".name" {
					w.Localization.Messages[i].Texts = message.Texts
				}
			}
			if name := message.Texts[w.Localization.DefaultLocale]; name != "" {
				w.Life.Person(def.Guard).Name = name
			}
			break
		}
		w.Inventory.Deliveries, w.Inventory.Shopfronts = nil, nil
		for _, store := range def.Stores {
			w.Inventory.Stores[store.ID] = store
		}
		for i := range w.Inventory.Sources {
			source := &w.Inventory.Sources[i]
			if source.Location.Kind == "store" && source.Location.Store == inv.ActorStore(def.Guard) && source.Location.Slot == "hand.main" {
				source.Location.Slot = ""
			}
		}
		w.Inventory.Sources = append(w.Inventory.Sources, def.Sources...)
		w.Vending = vendingCatalog{}
		w.CombatLife.Aggressors = map[string][]string{def.Guard: {playerActorID}}
		for _, extra := range def.Extras {
			w.CombatLife.Aggressors[def.Guard] = append(w.CombatLife.Aggressors[def.Guard], extra.ID)
		}
		w.CombatLife.Responders = map[string]combatResponder{}
		faceX, faceY := r.playableRouteDirection(def)
		w.Stealth.Watchers = map[string]stealthWatcher{def.Guard: {FaceX: faceX, FaceY: faceY, InvestigateSteps: true}}
		w.Stealth.SoundMemorySeconds, w.Stealth.ForgetSeconds = def.SoundMemorySeconds, def.ContactMemorySeconds
		w.Config.LevelID, w.Config.DebugPerception, w.Config.CaptureDemo = def.Level, false, demoPolicy{}
		w.Spawn, w.Terrain = location(def.Spawn), w.Life.Locations[def.Level].Terrain
		w.Entities, w.Scene.Cameras = nil, nil
		w.Region, w.Wayfinding = regionCatalog{}, wayfindingCatalog{}
		w.Illumination.Levels = map[string]illuminationLevel{def.Level: w.Illumination.Levels[def.Level]}
		variant := &Runtime{world: w}
		if err := variant.prepareIllumination(); err != nil {
			return err
		}
		if err := w.Life.Validate(); err != nil {
			return fmt.Errorf("playable scene %s: %w", id, err)
		}
		if err := w.CombatLife.Validate(w.Life, w.CombatRuntime); err != nil {
			return err
		}
		if err := w.Stealth.Validate(w.Life, w.CombatLife); err != nil {
			return err
		}
		if err := w.CombatRuntime.ValidateInventory(w.Inventory); err != nil {
			return err
		}
		if _, err := inv.New(w.Inventory, w.Config.Seed); err != nil {
			return fmt.Errorf("playable scene %s inventory: %w", id, err)
		}
		r.playableWorlds[id] = variant.world
	}
	return nil
}

func (d playableSceneDefinition) hasExtra(actor string) bool {
	for _, extra := range d.Extras {
		if extra.ID == actor {
			return true
		}
	}
	return false
}
func (r *Runtime) validatePlayableDefinition(id string, d playableSceneDefinition) error {
	fail := func() error { return fmt.Errorf("invalid playable scene %s", id) }
	if d.ID != id || id == "" || d.Scenario != "life:"+id || len(id) > 128 || strings.TrimSpace(id) != id || d.NameKey == "" || d.ObjectiveKey == "" || d.GuardNameKey == "" || d.KeyDefinition == "" || d.Guard == playerActorID || r.world.Life.Person(d.Guard) == nil || r.world.Life.Person(playerActorID) == nil || d.StartSecond < 0 || d.StartSecond >= 86400 || len(d.GuardRoute) < 2 || len(d.GuardRoute) > 32 || d.PatrolPauseSeconds < 1 || d.PatrolPauseSeconds > 300 || len(d.Interactions) < 1 || len(d.Interactions) > 32 || len(d.Stores) > 32 || len(d.Sources) < 1 || len(d.Sources) > 32 || !r.world.Life.Walks(d.Level, d.Spawn) || !r.world.Life.Walks(d.Level, d.Exit) || r.world.Decks[d.Level] == nil || r.world.CombatRuntime.DefaultProfile == "" || !r.world.CombatLife.Enabled || !r.world.Stealth.Enabled || !r.world.Illumination.Enabled {
		return fail()
	}
	if _, ok := r.world.Illumination.Levels[d.Level]; !ok {
		return fail()
	}
	gate := r.world.Life.Gate(d.Gate)
	if gate == nil || !gate.Manual || r.world.Life.GateLevel(d.Gate) != d.Level {
		return fail()
	}
	for i, at := range d.GuardRoute {
		next := d.GuardRoute[(i+1)%len(d.GuardRoute)]
		if at == d.Spawn || at == next || !r.world.Life.Walks(d.Level, at) || len(r.world.Life.Space(d.Level, nil).Path(at, next, behavior.Cell{}, 0)) == 0 {
			return fail()
		}
	}
	stores := map[string]inv.Store{}
	for id, store := range r.world.Inventory.Stores {
		stores[id] = store
	}
	for _, store := range d.Stores {
		_, duplicate := stores[store.ID]
		terrain := r.world.Life.Locations[d.Level].Terrain
		if store.ID == "" || duplicate || store.Kind != "surface" && store.Kind != "container" || store.Anchor.Kind != "world" || store.Anchor.Level != d.Level || store.Anchor.At.Y < 0 || store.Anchor.At.Y >= len(terrain) || store.Anchor.At.X < 0 || store.Anchor.At.X >= len(terrain[store.Anchor.At.Y]) {
			return fail()
		}
		stores[store.ID] = store
	}
	sources := map[string]inv.Source{}
	sceneSources := map[string]bool{}
	for _, s := range r.world.Inventory.Sources {
		sources[s.ID] = s
	}
	for _, s := range d.Sources {
		definition, known := r.world.Inventory.Definitions[s.Definition]
		if _, duplicate := sources[s.ID]; duplicate || s.ID == "" || !known || definition.Carrier != "physical" || s.Rolls != 0 || len(s.Loot) != 0 || s.Quantity != 1 || s.Condition < 1 || s.Condition > 1000000 || s.Hidden || s.ForSale || s.Owner != "" && s.Owner != playerActorID && s.Owner != d.Guard && !d.hasExtra(s.Owner) {
			return fail()
		}
		switch s.Location.Kind {
		case "ground":
			if s.Location.Level != d.Level || !r.world.Life.Walks(d.Level, behavior.Cell{X: s.Location.At.X, Y: s.Location.At.Y}) {
				return fail()
			}
		case "store":
			store, found := stores[s.Location.Store]
			if !found || store.Anchor.Kind == "actor" && store.Anchor.Actor != playerActorID && store.Anchor.Actor != d.Guard && !d.hasExtra(store.Anchor.Actor) || store.Anchor.Kind != "actor" && (store.Anchor.Kind != "world" || store.Anchor.Level != d.Level) {
				return fail()
			}
		default:
			return fail()
		}
		sources[s.ID] = s
		sceneSources[s.ID] = true
	}
	_, goalFound := sources[d.GoalSource]
	keyFound := false
	for _, source := range d.Sources {
		keyFound = keyFound || source.Definition == d.KeyDefinition
	}
	if !goalFound || !sceneSources[d.GoalSource] || !keyFound {
		return fail()
	}
	if d.SoundMemorySeconds < 1 || d.SoundMemorySeconds > r.world.CombatLife.ThreatMemorySeconds || d.ContactMemorySeconds < 1 || d.ContactMemorySeconds > r.world.CombatLife.ThreatMemorySeconds {
		return fail()
	}
	light := r.world.Illumination.Levels[d.Level]
	actions := map[string]bool{}
	goalAction, exitAction := false, false
	for _, action := range d.Interactions {
		if action.ID == "" || len(action.ID) > 128 || actions[action.ID] || action.NameKey == "" || !r.world.Life.Walks(d.Level, action.At) || action.CooldownSeconds < 0 || action.CooldownSeconds > 300 || !(action.Loudness >= 0 && action.Loudness <= 1) {
			return fail()
		}
		actions[action.ID] = true
		if action.RequiredItem != "" {
			if _, ok := r.world.Inventory.Definitions[action.RequiredItem]; !ok {
				return fail()
			}
		}
		switch action.Effect {
		case "power_toggle":
			known := false
			for _, ref := range light.PowerRefs {
				known = known || ref == action.Target
			}
			if !known {
				return fail()
			}
		case "gate_toggle":
			if action.Target != d.Gate || action.RequiredItem != d.KeyDefinition {
				return fail()
			}
		case "take":
			source, ok := sources[action.Target]
			anchor := inv.Anchor{Kind: "world", Level: source.Location.Level, At: source.Location.At}
			if source.Location.Kind == "store" {
				anchor = stores[source.Location.Store].Anchor
			}
			if !ok || !sceneSources[action.Target] || anchor.Kind != "world" || anchor.Level != d.Level || behavior.Distance(action.At, behavior.Cell{X: anchor.At.X, Y: anchor.At.Y}) > 1 || source.Owner != "" && source.Owner != playerActorID {
				return fail()
			}
			goalAction = goalAction || action.Target == d.GoalSource
		case "noise":
			if action.Loudness <= 0 || action.CooldownSeconds < 1 {
				return fail()
			}
		case "exit":
			if action.At != d.Exit {
				return fail()
			}
			exitAction = true
		default:
			return fail()
		}
	}
	if !goalAction || !exitAction {
		return fail()
	}
	return nil
}

func (r *Runtime) playableRouteDirection(d playableSceneDefinition) (float64, float64) {
	a, b := d.GuardRoute[0], d.GuardRoute[1]
	if v := r.world.Decks[d.Level]; v != nil {
		a, _, _, _ = v.Locate(a)
		b, _, _, _ = v.Locate(b)
	}
	dx, dy := float64(b.X-a.X), float64(b.Y-a.Y)
	n := math.Hypot(dx, dy)
	if n == 0 {
		return 0, 1
	}
	return dx / n, dy / n
}

func (r *Runtime) initPlayableScene() error {
	if r.world.PlayableID == "" {
		return nil
	}
	d, ok := r.world.PlayableScenes[r.world.PlayableID]
	h, guard := r.state.Life.Actor(playerActorID), r.state.Life.Actor(d.Guard)
	if !ok || h == nil || guard == nil || h.Level != d.Level || guard.Level != d.Level {
		return errors.New("playable scene actors missing")
	}
	r.state.Playable = playableSceneState{ID: d.ID, WaitUntil: r.state.Life.Seconds + d.PatrolPauseSeconds, Cooldowns: map[string]int64{}}
	h.Manual, guard.Manual = true, false
	r.state.Life.SecondsPerTick = 1
	r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
	r.syncLifeHero()
	return nil
}

// The ordinary Life planner moves the guard. Override destinations keep it
// autonomous, so the existing Safety/search code can interrupt and later return.
func (r *Runtime) advancePlayableScene() error {
	d, ok := r.world.PlayableScenes[r.state.Playable.ID]
	if !ok || r.state.Playable.ID == "" || r.world.PlayableID != r.state.Playable.ID || r.state.Paused {
		return nil
	}
	s := &r.state.Playable
	if s.PatrolIndex < 0 || s.PatrolIndex >= len(d.GuardRoute) {
		return errors.New("playable patrol index outside route")
	}
	a := r.state.Life.Actor(d.Guard)
	if a == nil || !a.OnFloor() || a.Level != d.Level || a.CombatHold || a.Safety != nil || r.state.Combat.Active || !r.combatWorldConscious(a.ID) {
		return nil
	}
	a.Manual = false
	at := d.GuardRoute[s.PatrolIndex]
	if a.Position == at && a.Arrived && len(a.Path) == 0 {
		if s.WaitUntil == 0 {
			s.WaitUntil = r.state.Life.Seconds + d.PatrolPauseSeconds
		}
		if r.state.Life.Seconds < s.WaitUntil {
			return nil
		}
		s.PatrolIndex = (s.PatrolIndex + 1) % len(d.GuardRoute)
		at = d.GuardRoute[s.PatrolIndex]
		s.WaitUntil = 0
	}
	if a.OverrideLevel != d.Level || a.OverrideAt != at || a.Goal != at || a.Arrived {
		a.OverrideLevel, a.OverrideAt, a.OverrideEdge = d.Level, at, ""
		a.Goal, a.Arrived = at, false
		a.Path, a.PendingPath = nil, nil
		a.MoveStartTick = r.lifeMotionTick()
		s.WaitUntil = 0
	}
	return nil
}

func (r *Runtime) playableOwnItem(match func(inv.Item) bool) bool {
	for _, i := range r.state.Inventory.Items {
		if i.Owner == playerActorID && i.Quantity > 0 && i.Condition > 0 && match(i) && r.carried(i) && r.state.Inventory.Accessible(r.inventoryModelFor(true), i.Location) == nil {
			return true
		}
	}
	return false
}
func (r *Runtime) playableHasDefinition(definition string) bool {
	return r.playableOwnItem(func(i inv.Item) bool { return i.Definition == definition })
}
func (r *Runtime) playableGoalCarried(d playableSceneDefinition) bool {
	return r.playableOwnItem(func(i inv.Item) bool { return i.Origin == d.GoalSource })
}
func (r *Runtime) playableReach(h *behavior.LifeActor, at behavior.Cell) bool {
	if h == nil || !h.OnFloor() || behavior.Distance(h.Position, at) > 1 {
		return false
	}
	v := r.world.Decks[h.Level]
	if v == nil {
		return false
	}
	from := v.BodyLightPoints(h.Position, behavior.Combatant{Crouched: h.Sneaking && !h.SneakUpright})[1]
	to := v.BodyLightPoints(at, behavior.Combatant{})[1]
	if h.Body != nil {
		from.X, from.Y = h.Body.X, h.Body.Y
	}
	if math.Hypot(from.X-to.X, from.Y-to.Y) > 500+1e-6 {
		return false
	}
	c := r.world.Illumination.Levels[h.Level]
	if c.rays != nil {
		v = c.rays
	}
	return v.RayClearMM(from, to, r.illuminationBoxes(c))
}
func (r *Runtime) playableInteractionReason(d playableSceneDefinition, action playableInteraction, h *behavior.LifeActor) string {
	if h == nil || !h.OnFloor() || h.Level != d.Level || h.CombatHold || !r.combatWorldConscious(playerActorID) || r.state.Paused || r.heroInCombat() {
		return "error.scene.unavailable"
	}
	if r.state.Playable.Completed {
		return "error.scene.completed"
	}
	if !r.playableReach(h, action.At) {
		return "error.scene.range"
	}
	if until := r.state.Playable.Cooldowns[action.ID]; until > r.state.Life.Seconds {
		return "error.scene.cooldown"
	}
	if action.RequiredItem != "" && !r.playableHasDefinition(action.RequiredItem) {
		return "error.scene.locked"
	}
	if action.Effect == "take" {
		available := false
		for _, item := range r.state.Inventory.Items {
			if item.Origin == action.Target && item.Quantity > 0 && !item.Hidden && !r.carried(item) && (item.Owner == "" || item.Owner == playerActorID) && r.inventoryReach(item.Location) {
				available = true
				break
			}
		}
		if !available {
			return "error.scene.item"
		}
	}
	if action.Effect == "exit" && !r.playableGoalCarried(d) {
		return "error.scene.goal"
	}
	return ""
}

func (r *Runtime) playableInteract(id string) error {
	d, ok := r.world.PlayableScenes[r.state.Playable.ID]
	if !ok || r.state.Playable.ID == "" || r.world.PlayableID != r.state.Playable.ID {
		return textError{Key: "error.scene.unavailable"}
	}
	var selected *playableInteraction
	for i := range d.Interactions {
		if d.Interactions[i].ID == id {
			selected = &d.Interactions[i]
			break
		}
	}
	if selected == nil {
		return textError{Key: "error.scene.unknown"}
	}
	action := *selected
	if reason := r.playableInteractionReason(d, action, r.state.Life.Actor(playerActorID)); reason != "" {
		return textError{Key: reason}
	}
	// All effects occur on one candidate state, including item transfers and
	// anonymous hearing/search. Rejected actions cannot partly flip a circuit.
	next := &Runtime{world: r.world, state: r.snapshotState(), lifeInventory: r.lifeInventory, openStore: r.openStore, illuminationCache: r.illuminationCache}
	next.state.Playable = r.state.Playable.Clone()
	switch action.Effect {
	case "power_toggle":
		if next.state.Illumination.Off == nil {
			next.state.Illumination.Off = map[string]map[string]bool{}
		}
		if next.state.Illumination.Off[d.Level] == nil {
			next.state.Illumination.Off[d.Level] = map[string]bool{}
		}
		if next.state.Illumination.Off[d.Level][action.Target] {
			delete(next.state.Illumination.Off[d.Level], action.Target)
		} else {
			next.state.Illumination.Off[d.Level][action.Target] = true
		}
	case "gate_toggle":
		gate, exists := next.state.Life.Gates[action.Target]
		if !exists {
			return textError{Key: "error.scene.unavailable"}
		}
		if err := next.state.Life.SetGateRequest(next.world.Life, action.Target, !gate.RequestOpen); err != nil {
			return err
		}
	case "take":
		keys := combatItemKeys(next.state.Inventory)
		found := false
		for _, key := range keys {
			i := next.state.Inventory.Items[key]
			if i.Origin != action.Target || next.carried(i) {
				continue
			}
			cursor := next.state.Inventory.Cursors[playerActorID]
			_, err := next.executeActorAction(inv.Action{Actor: playerActorID, Kind: "take", Item: i.ID, Quantity: i.Quantity, ExpectedRevision: i.Revision, Sequence: cursor.Sequence + 1})
			if err != nil {
				return textError{Key: "error.scene.item"}
			}
			found = true
			break
		}
		if !found {
			return textError{Key: "error.scene.item"}
		}
	case "noise":
		if next.state.Stealth.NoiseSequence >= 1<<50 {
			return textError{Key: "error.scene.unavailable"}
		}
		next.state.Stealth.NoiseSequence++
		guard := next.state.Life.Actor(d.Guard)
		if guard != nil && guard.OnFloor() && guard.Level == d.Level && !guard.CombatHold && next.combatWorldConscious(guard.ID) {
			observer := combatLifeObserver{ID: guard.ID, Level: guard.Level, At: guard.Position}
			if heard, audible := next.combatWorldHeard(observer, action.At, action.Loudness); audible {
				now := next.state.Life.Seconds
				next.combatWorldRemember(guard.ID, behavior.Fact{Subject: fmt.Sprintf("noise.playable.%s.%d", d.ID, next.state.Stealth.NoiseSequence), Kind: "combat.noise", Source: "sound", Value: true, Position: heard.Estimate, Radius: heard.Radius, Strength: heard.Intensity, ObservedTick: now, ExpiresTick: now + next.world.Stealth.SoundMemorySeconds, Priority: 10})
				next.stealthSearch(observer, heard.Estimate, now+next.world.Stealth.SoundMemorySeconds)
			}
		}
	case "exit":
		next.state.Playable.Completed = true
		next.state.Paused = true
	default:
		return textError{Key: "error.scene.unknown"}
	}
	if next.state.Playable.Cooldowns == nil {
		next.state.Playable.Cooldowns = map[string]int64{}
	}
	if action.CooldownSeconds > 0 {
		next.state.Playable.Cooldowns[action.ID] = next.state.Life.Seconds + action.CooldownSeconds
	}
	r.state = next.state
	if action.Effect == "noise" {
		r.noiseOwn("signal", d.Level, action.At, action.Loudness, 0)
	}
	return nil
}

func (r *Runtime) validatePlayableScene(s state) error {
	p := s.Playable
	if p.ID == "" {
		if r.world.PlayableID != "" || p.PatrolIndex != 0 || p.WaitUntil != 0 || len(p.Cooldowns) != 0 || p.Completed {
			return errors.New("unexpected playable state")
		}
		return nil
	}
	d, ok := r.world.PlayableScenes[p.ID]
	if !ok || r.world.PlayableID != p.ID || s.SDKLayout != "" || !s.Life.Enabled || p.PatrolIndex < 0 || p.PatrolIndex >= len(d.GuardRoute) || p.WaitUntil < 0 || p.WaitUntil > s.Life.Seconds && p.WaitUntil-s.Life.Seconds > d.PatrolPauseSeconds || len(p.Cooldowns) > len(d.Interactions) || len(s.Life.Actors) != 2 {
		return errors.New("invalid playable scene state")
	}
	h, guard := s.Life.Actor(playerActorID), s.Life.Actor(d.Guard)
	if h == nil || guard == nil || h.Level != d.Level || guard.Level != d.Level || !h.OnFloor() || !guard.OnFloor() {
		return errors.New("invalid playable actors")
	}
	for id, until := range p.Cooldowns {
		known := false
		for _, action := range d.Interactions {
			if action.ID == id && action.CooldownSeconds > 0 && until >= 0 && (until <= s.Life.Seconds || until-s.Life.Seconds <= action.CooldownSeconds) {
				known = true
			}
		}
		if !known {
			return errors.New("invalid playable cooldown")
		}
	}
	if p.Completed {
		owned := false
		for _, i := range s.Inventory.Items {
			owned = owned || i.Origin == d.GoalSource && i.Owner == playerActorID && i.Quantity > 0
		}
		if !owned {
			return errors.New("completed playable scene has no acquired objective")
		}
	}
	return nil
}

func (r *Runtime) appendPlayableScene(view *pb.PocLifeView, h *behavior.LifeActor, perception *pb.PocObserverView, locale string) {
	d, ok := r.world.PlayableScenes[r.state.Playable.ID]
	if !ok || r.state.Playable.ID == "" || r.world.PlayableID != r.state.Playable.ID || h == nil || h.Level != d.Level {
		return
	}
	m := &pb.PocPlayableScene{Id: d.ID, Name: r.localText(locale, d.NameKey, d.NameKey), Objective: r.localText(locale, d.ObjectiveKey, d.ObjectiveKey), Completed: r.state.Playable.Completed, GoalCarried: r.playableGoalCarried(d), KeyCarried: r.playableHasDefinition(d.KeyDefinition)}
	for _, action := range d.Interactions {
		if !viewSees(perception, int32(action.At.X), int32(action.At.Y)) {
			continue
		}
		reason := r.playableInteractionReason(d, action, h)
		m.Actions = append(m.Actions, &pb.PocSceneAction{Id: action.ID, Name: r.localText(locale, action.NameKey, action.NameKey), X: int32(action.At.X), Y: int32(action.At.Y), Enabled: reason == "", Reason: r.localText(locale, reason, reason)})
	}
	// Scene lamps are known architecture. Publish operating state, never an
	// observer's suspicion, remembered target or unseen person's identity.
	c := r.world.Illumination.Levels[d.Level]
	w := c.Calendar.weights(r.state.Life.Seconds)
	for _, e := range c.Emitters {
		factor := r.illuminationSourceFactor(d.Level, c, e, w)
		m.Lights = append(m.Lights, &pb.PocSceneLight{Id: e.ID, Powered: factor > 0, Factor: factor})
	}
	view.PlayableScene = m
}
