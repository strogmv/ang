// Expectations by hand: night cadence 1 h makes a 600 s walk earlier than the
// rail (57 min wait); by day the next train in under 5 min wins by >120 s; two
// full trains of visible queue (8 bodies, 4 seats, 300 s) make walking earlier.
func TestNPC1LegUsesRealDepartureAndQueue(t *testing.T){
 m:=lifeFixture();m.Brain=brainFixture();m.Locations["a"]=LifeLocation{Name:"A",Terrain:[]string{".....",".....","....."}}
 rail:=LifeEdge{ID:"rail",From:"a",To:"b",Exit:Cell{4,0},Entry:Cell{0,1},Mode:"rail",TravelSeconds:120,PeriodSeconds:300,NightPeriodSeconds:3600,DayStartSecond:6*3600,DayEndSecond:22*3600,Seats:4}
 walk:=LifeEdge{ID:"walk",From:"a",To:"b",Exit:Cell{4,2},Entry:Cell{0,1},Mode:"walk",TravelSeconds:600,Seats:8}
 back:=LifeEdge{ID:"back",From:"b",To:"a",Exit:Cell{0,1},Entry:Cell{4,1},Mode:"walk",TravelSeconds:60,Seats:8}
 m.Edges=[]LifeEdge{rail,walk,back}
 s:=LifeState{Seconds:5*3600+180,Actors:[]LifeActor{{ID:"one",Level:"a",Position:Cell{2,1}}}}
 if e:=s.brainLegEdge(m,&s.Actors[0],"b");e==nil||e.ID!="walk"{t.Fatalf("night: expected walk, got %+v",e)}
 s.Seconds=6*3600+10;s.Actors[0].Brain.LegCheck=s.Seconds+30
 if e:=s.brainLegEdge(m,&s.Actors[0],"b");e.ID!="walk"{t.Fatal("leg changed before its recheck")}
 s.Actors[0].Brain.LegCheck=0
 if e:=s.brainLegEdge(m,&s.Actors[0],"b");e.ID!="rail"{t.Fatalf("day: expected rail, got %s",e.ID)}
 for i:=0;i<8;i++{s.Actors=append(s.Actors,LifeActor{ID:fmt.Sprint("queue",i),Level:"a",Position:Cell{i%4,i/4},Goal:rail.Exit})}
 s.Actors[0].Brain.LegCheck=0;s.Actors[0].WaitingDeparture=6*3600+300
 if e:=s.brainLegEdge(m,&s.Actors[0],"b");e.ID!="walk"||s.Actors[0].WaitingDeparture!=0{t.Fatalf("queue: expected walk and cleared timetable, got %s %d",e.ID,s.Actors[0].WaitingDeparture)}
 // Committed boarding approach is kept despite the queue.
 s.Actors[0].Brain.LegEdge="rail";s.Actors[0].Brain.LegCheck=0;s.Actors[0].WaitingDeparture=6*3600+300;s.Actors[0].Goal=rail.Exit
 if e:=s.brainLegEdge(m,&s.Actors[0],"b");e.ID!="rail"{t.Fatal("boarding approach abandoned")}
}
