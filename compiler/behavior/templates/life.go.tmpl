func(s LifeState)BlockedCells(level,except string)map[Cell]bool{return s.blocked(level,except)}
func(s LifeState)PopulationEnvironment()PopulationEnvironment{
 env:=PopulationEnvironment{Occupied:map[string]map[Cell]bool{}}
 for _,a:=range s.Actors{
  if a.Trip!=nil{env.Trips=append(env.Trips,*a.Trip);continue}
