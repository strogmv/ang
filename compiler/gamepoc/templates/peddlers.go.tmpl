// peddlerHeroNear: the hero stands within reach of the peddler, who is at a stop with his shop open.
func (r *Runtime) peddlerHeroNear(p peddlerDef) bool {
	hero := r.state.Life.Actor(playerActorID)
	a := r.state.Life.Actor(p.Actor)
	if hero == nil || a == nil || hero.Trip != nil || !hero.OnFloor() || hero.Level != a.Level || r.peddlerStopNow(p) == "" {
