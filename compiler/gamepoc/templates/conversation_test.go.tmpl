// The evening after an escape: Prokhor in the gate passage talks once, within the window, as the event its entries keep.
func TestMemoryGateEveningAfterTheEscape(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	if err := choose(r, "escape"); err != nil {
		t.Fatal(err)
	}
	r.talkDrop()
	s := &r.state.CalendarEncounter
	if s.Outcome != "escape" {
		t.Fatalf("no escape: %+v", s)
	}
	s.Phase = "done"
	a, h := r.state.Life.Actor(e.Actor), r.state.Life.Actor(playerActorID)
	a.Level, a.Position, a.Path, a.Trip = e.Gate.Level, behavior.Cell{X: e.Gate.At.X, Y: e.Gate.At.Y}, nil, nil
	h.Level, h.Position, h.Path, h.Trip, h.Body = e.Gate.Level, behavior.Cell{X: e.Gate.At.X + 1, Y: e.Gate.At.Y}, nil, nil, nil
	conv, ok := r.talkAvailable(e.Actor)
	if !ok || conv != e.Talk.Gate {
		t.Fatalf("no evening talk at the gate: %q %v", conv, ok)
	}
	if err := r.conversationCommand(&pb.PocLifeCommand{Action: "conversation_open", Destination: e.Actor}); err != nil {
		t.Fatal(err)
	}
	tk := r.state.Memory.Talks[talkKey(e.Talk.Gate, e.Actor)]
	if tk == nil || (tk.Entry != "e.seen" && tk.Entry != "e.unseen") {
		t.Fatalf("the gate talk opened by %+v", tk)
	}
	if err := choose(r, "bye"); err != nil {
		t.Fatal(err)
	}
	r.talkDrop()
	if conv, ok := r.talkAvailable(e.Actor); ok && conv == e.Talk.Gate {
		t.Fatal("the gate talk opens again after his goodbye")
	}
	// outside the window: nothing (12 game hours)
	w := dialogueCustody(t, nil)
	if err := choose(w, "escape"); err != nil {
		t.Fatal(err)
	}
	w.talkDrop()
	w.state.CalendarEncounter.Phase = "done"
	for id, f := range w.state.Memory.Facts {
		f.Second -= 13 * 3600
		f.First = f.Second
		w.state.Memory.Facts[id] = f
	}
	a, h = w.state.Life.Actor(e.Actor), w.state.Life.Actor(playerActorID)
	a.Level, a.Position, a.Path, a.Trip = e.Gate.Level, behavior.Cell{X: e.Gate.At.X, Y: e.Gate.At.Y}, nil, nil
	h.Level, h.Position, h.Path, h.Trip, h.Body = e.Gate.Level, behavior.Cell{X: e.Gate.At.X + 1, Y: e.Gate.At.Y}, nil, nil, nil
	if conv, ok := w.talkAvailable(e.Actor); ok && conv == e.Talk.Gate {
		t.Fatal("the gate talk opens after its evening")
	}
}

