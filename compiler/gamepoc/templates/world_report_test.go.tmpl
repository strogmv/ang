var worldAuditRuntimeOverride func(*Runtime)

type worldRuntimeMem struct{ heapMiB float64 }

func (m *worldRuntimeMem) read() {
	var ms goruntime.MemStats
	goruntime.GC()
	goruntime.ReadMemStats(&ms)
	m.heapMiB = float64(ms.HeapAlloc) / (1 << 20)
}

