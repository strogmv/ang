func TestPopulationRuntimeHeroGotoThroughCrowd(t *testing.T) {
 r:=lifeRuntimeFixture(t)
 life,err:=r.world.Life.StartWithPopulation(100,playerActorID);if err!=nil{t.Fatal(err)}
 r.state.Tick=0;r.initLifeState(life);r.state.Life.SecondsPerTick=30
 yielded,saved:=false,false
 for _,destination:=range []string{"level.poc_housing","level.poc_monorail","level.poc_work"}{
  if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"goto",Destination:destination});err!=nil{t.Fatal(err)}
  arrived:=false
  for i:=0;i<2400;i++{
   previous:=r.state.Life.Population.Clone()
   r.step()
   if r.state.Paused{t.Fatalf("simulation paused: %s",r.state.Life.PopulationFailure)}
   // Includes shared named/population positions, first-step reservations and seats.
   if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatalf("tick %d: %v",r.state.Tick,err)}
   for j,a:=range r.state.Life.Population.Actors{
    old:=previous.Actors[j]
    if old.Materialized&&a.Materialized&&old.Level==a.Level&&old.Trip==nil&&a.Trip==nil&&behavior.Distance(old.Position,a.Position)>1{t.Fatalf("resident teleported %s",a.ID)}
    if a.YieldUntil>r.state.Tick{yielded=true;if !saved{
     raw,err:=json.Marshal(r.state.Life);if err!=nil{t.Fatal(err)};var restored behavior.LifeState;if err=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)}
     if !reflect.DeepEqual(r.state.Life.Clone(),restored.Clone()){t.Fatal("yield negotiation lost in save")};r.state.Life=restored;saved=true
    }}
   }
   hero:=r.state.Life.Actor(playerActorID)
   if hero.Level==destination&&hero.Trip==nil&&len(hero.Path)==0&&hero.OverrideLevel==""{arrived=true;break}
  }
  if !arrived{logCrowdBlockage(t,r);t.Fatalf("crowd deadlock toward %s: %+v",destination,*r.state.Life.Actor(playerActorID))}
 }
 if !yielded||!saved{t.Fatal("fixture did not exercise negotiated yield/save")}
}

// A layout/timetable revision can remove the incidental encounter this test
// used to rely on. Arrange one real local contact on the current first leg,
// using an existing idle friend and an empty off-route pocket. YieldUntil and
// movement remain entirely the runtime's responsibility.
func prepareWarmupMixedTrafficContact(t *testing.T,r *Runtime){
 t.Helper();hero:=r.state.Life.Actor(playerActorID);edge:=r.world.Life.NextEdge(hero.Level,"level.poc_housing");if edge==nil{t.Fatal("mixed fixture lacks the housing route")}
 route:=r.world.Life.Space(hero.Level,nil).Path(hero.Position,edge.Exit,behavior.Cell{},0);if len(route)==0{t.Fatal("mixed fixture lacks a physical first step")};contact:=route[0]
 avoid:=map[behavior.Cell]bool{hero.Position:true};for _,at:=range route{avoid[at]=true}
 heroIndex:=-1;for i,a:=range r.state.Life.Actors{if a.ID==hero.ID{heroIndex=i;break}}
 for i:=heroIndex+1;i<len(r.state.Life.Actors);i++{a:=&r.state.Life.Actors[i]
  if a.Level!=hero.Level||a.Trip!=nil||a.Manual||!a.Arrived||len(a.Path)>0||a.YieldUntil>r.state.Tick||(a.Activity!="rest"&&a.Activity!="market")||r.state.Life.RelationTo(r.world.Life,a.ID,hero.ID)<=0{continue}
  occupied:=r.state.Life.BlockedCells(hero.Level,a.ID);if occupied[contact]{continue};pocket:=false
  for _,d:=range []behavior.Cell{{X:0,Y:-1},{X:1,Y:0},{X:0,Y:1},{X:-1,Y:0}}{next:=behavior.Cell{X:contact.X+d.X,Y:contact.Y+d.Y};if r.world.Life.Walks(hero.Level,next)&&!occupied[next]&&!avoid[next]{pocket=true;break}}
  if !pocket{continue};a.Position=contact;a.Goal=contact;a.PendingPath=nil;a.MoveStartTick=r.state.Tick
  if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatalf("invalid mixed contact fixture: %v",err)};return
 }
 t.Fatal("mixed fixture needs an existing idle friend, a free current-route contact and an off-route pocket")
}
func TestPopulationRuntimeWarmupMixedQueueProgressBeforeScheduleRelease(t *testing.T){
 r:=lifeRuntimeFixture(t);life,err:=r.world.Life.StartWithPopulation(100,playerActorID);if err!=nil{t.Fatal(err)}
 r.state.Tick=0;r.initLifeState(life)
 for i:=0;i<10;i++{r.step()}
 prepareWarmupMixedTrafficContact(t,r)
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"rate",SecondsPerTick:30});err!=nil{t.Fatal(err)}
 namedYield,saved:=false,false
 for _,destination:=range []string{"level.poc_housing","level.poc_monorail","level.poc_work"}{
  if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"goto",Destination:destination});err!=nil{t.Fatal(err)}
  arrived:=false
  for i:=0;i<600;i++{
   previous:=r.state.Life.Clone();stepLifeFrameForAudit(t,r)
   if r.state.Paused{t.Fatalf("simulation paused: %s",r.state.Life.PopulationFailure)}
   if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatalf("tick %d: %v",r.state.Tick,err)}
   if r.state.Life.Actor(playerActorID).YieldUntil!=0{t.Fatal("hero was enlisted in traffic negotiation")}
   for j,a:=range r.state.Life.Actors{
    old:=previous.Actors[j];if old.Trip==nil&&a.Trip==nil&&old.Level==a.Level&&behavior.Distance(old.Position,a.Position)>1{t.Fatalf("named actor teleported %s",a.ID)}
    if a.YieldUntil>r.state.Tick{namedYield=true;if !saved{
     raw,err:=json.Marshal(r.state.Life);if err!=nil{t.Fatal(err)};var restored behavior.LifeState;if err=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)}
     if !reflect.DeepEqual(r.state.Life.Clone(),restored.Clone()){t.Fatal("mixed queue save lost state")};r.state.Life=restored;saved=true
    }}
   }
   for j,a:=range r.state.Life.Population.Actors{old:=previous.Population.Actors[j];if old.Materialized&&a.Materialized&&old.Level==a.Level&&old.Trip==nil&&a.Trip==nil&&behavior.Distance(old.Position,a.Position)>1{t.Fatalf("resident teleported %s",a.ID)}}
   hero:=r.state.Life.Actor(playerActorID)
   if hero.Level==destination&&hero.Trip==nil&&len(hero.Path)==0{arrived=true;break}
   // Old mixed queue stayed on the market until tick1123. Enforce early
   // physical departure, independent of that later calendar release.
   if destination=="level.poc_housing"&&r.state.Tick>=450{logCrowdBlockage(t,r);t.Fatalf("mixed queue failed early progress: %+v",*hero)}
  }
  if !arrived{t.Fatalf("SDK warmup route stalled toward %s",destination)}
 }
 if !namedYield||!saved{t.Fatal("fixture did not exercise/save mixed yielding")}
}

func TestPopulationRuntimeLoadsLegacyTrafficFields(t *testing.T){
 r:=lifeRuntimeFixture(t);life,err:=r.world.Life.StartWithPopulation(100,playerActorID);if err!=nil{t.Fatal(err)}
 r.state.Tick=0;r.initLifeState(life)
 legacy:=r.snapshotState();legacy.Life.ControlledActorID=""
 for i:=range legacy.Life.Actors{legacy.Life.Actors[i].YieldUntil=0}
 for i:=range legacy.Life.Population.Actors{legacy.Life.Population.Actors[i].YieldUntil=0}
 slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,legacy);err!=nil{t.Fatal(err)}
 // Use the actual disk reader and load completion path, including checksum,
 // content/state validation and epoch replacement, not only JSON unmarshal.
 loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)}
 if loaded.Life.ControlledActorID!=""{t.Fatal("test did not omit old field")}
 c:=&connection{out:make(chan *pb.ServerMessage,32),stop:make(chan struct{})}
 r.diskComplete(diskResult{job:diskJob{client:c,action:"load",slot:slot,epoch:r.state.Epoch},loaded:loaded})
 if r.state.Life.ControlledActorID!=""{t.Fatal("load invented controller")}
 r.step()
 if r.state.Paused||r.state.Life.ControlledActorID!=playerActorID||r.state.Life.Actor(playerActorID).YieldUntil!=0{t.Fatal("legacy load failed safe controller restoration")}
 if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatal(err)}
}
