func TestPopulationProfileLegacyMigrationIsDeterministicAndPausedStable(t *testing.T){
 p,l:=populationProfileFixture();s,err:=p.Start(l,5,0,0);if err!=nil{t.Fatal(err)}
 for i:=range s.Actors{s.Actors[i].Profile=nil};saved:=populationProfileReload(t,s);before:=s.Clone()
 if err=s.Validate(p,l,0,0);err!=nil{t.Fatal(err)}
 populationAdvance(t,&s,p,l,0,0,"",PopulationEnvironment{});if !reflect.DeepEqual(before,s.Clone()){t.Fatal("paused legacy save migrated without an ordinary advance")}
 populationAdvance(t,&s,p,l,1,1,"",PopulationEnvironment{});populationAdvance(t,&saved,p,l,1,1,"",PopulationEnvironment{})
 if !reflect.DeepEqual(s.Clone(),saved.Clone()){t.Fatal("legacy deterministic migration diverged")}
 for _,a:=range s.Actors{if a.Profile==nil||a.Profile.Version!=1||a.Profile.Home==nil||a.Profile.Work==nil||a.Profile.Leisure==nil{t.Fatal("missing migrated places")}}
 // Generic SDK callers without a profile catalogue retain the old stage route.
 p.Profiles=nil;legacy,err:=p.Start(l,1,0,0);if err!=nil{t.Fatal(err)}
 if legacy.Actors[0].Profile.DefinitionID!=populationLegacyProfile||legacy.Actors[0].Profile.Work.Level!="b"{t.Fatal("legacy fallback invented a new schedule")}
}
