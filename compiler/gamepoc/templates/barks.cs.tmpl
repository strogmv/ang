     if(live.skipped)continue;
     float t=(float)((now-b.StartedNs)/1e6);if(t<0)continue;
     float total=b.RevealMs+b.FixMs+b.HoldMs,life=total+b.FadeMs;
     if(b.Kind=="thought"){DrawBarkThought(b,live,t,total,life,em,lineH,scale,px);continue;}
     Vector2 head;bool inFrame,onScreen;if(!BarkHead(b,vp,out head,out inFrame,out onScreen)){live.skipped=!live.started;continue;}
     bool hall=b.To=="hall";
     if(!live.started){
      // owner 02.11: a line of somebody out of the frame is not started, a shout to the hall is pinned to the edge
      if(!inFrame&&!hall){live.skipped=true;continue;}
      if(drawn>=BarkMaxOnScreen)continue; // queued: waits for a free slot while it lives
      live.started=true;
     }
     if(drawn>=BarkMaxOnScreen)continue;
     if(!inFrame&&!hall&&live.leftAt<0)live.leftAt=now;
     if(inFrame)live.leftAt=-1;
     float alpha=1,clock=t;
     if(live.leftAt>=0){float gone=(float)((now-live.leftAt)/1e6);float off3=Mathf.Max(1,b.OffscreenFadeMs);if(gone>=off3)continue;clock=t+gone*4;alpha=1-gone/off3;}
     else if(t>total)alpha=1-(t-total)/Mathf.Max(1,b.FadeMs);
     if(alpha<=0||t>life)continue;
     var pinned=!inFrame&&hall;
     // a shout to the hall from somebody unseen: where his voice is when that is on screen (behind a machine), else
     // pinned to the edge of the frame on his side; no thread — there is no head to tie it to
     if(pinned&&!onScreen)head=new Vector2(Mathf.Clamp(head.x,safe.xMin+40,safe.xMax-40),Mathf.Clamp(head.y,safe.yMin+30,safe.yMax-4));
     Color colour;if(!ColorUtility.TryParseHtmlString(string.IsNullOrEmpty(b.Colour)?"#d8d2c4":b.Colour,out colour))colour=Color.white;
     if(b.Kind=="gesture"||b.Kind=="sign"){
      var markAt=px(new Vector2(head.x,head.y-10));var mc=b.Kind=="sign"?new Color(.86f,.62f,.36f,alpha*.95f):new Color(colour.r,colour.g,colour.b,alpha*.9f);
