func TestMemorySavesMidWeekAndDropsWhatIsGone(t *testing.T) {
	r := memoryDay(t, 1)
	atTheSack(t, r)
	r.calendarEncounterAfterFrame()
	for _, id := range []string{"ask_work", "greet"} {
		if err := choose(r, id); err != nil {
			t.Fatal(err)
		}
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(r.state.Memory, loaded.Memory) {
		a, _ := json.Marshal(r.state.Memory)
		b, _ := json.Marshal(loaded.Memory)
		t.Fatalf("the memory changed in the save:\n%s\n%s", a, b)
	}
	// a fact, a topic and a voice the content no longer has are dropped; the game loads
	r.state.Memory.Facts["fact.prokhor.removed"] = memoryFact{First: 1, Second: 1, Count: 1}
	r.state.Memory.Topics["topic.removed"] = 1
	sackTalk(r).Voiced = append(sackTalk(r).Voiced, "removed")
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err = r.readSave(slot)
	if err != nil {
		t.Fatalf("a save naming removed memory did not load: %v", err)
	}
	if _, ok := loaded.Memory.Facts["fact.prokhor.removed"]; ok || loaded.Memory.Topics["topic.removed"] != 0 {
		t.Fatal("removed memory was kept")
	}
	if strings.Contains(strings.Join(loaded.Memory.Talks[sackKey(r)].Voiced, ","), "removed") {
		t.Fatal("a removed voice was kept")
	}
}

// A save from before story memory: the acquaintance flag and a settled custody become the facts the conversation's own
// data writes; the custody's log becomes its talk.
func TestMemoryOldSaveBecomesFacts(t *testing.T) {
	probe := dialogueCustody(t, nil)
	e := probe.world.CalendarEncounter
	for _, c := range []struct{ choice, outcome, fact string }{{"refuse", "refuse", "fact.prokhor.custody_refuse"}, {"kind", "willing", "fact.prokhor.custody_kind"}, {"timeout", "forced", "fact.prokhor.custody_late"}} {
		r := encounterFixture(t)
		r.state = probe.snapshotState()
		s := r.snapshotState()
		s.Memory = memoryState{}
		s.CalendarEncounter.Met = true
		s.CalendarEncounter.Choice, s.CalendarEncounter.Outcome, s.CalendarEncounter.Phase = c.choice, c.outcome, "escort"
		s.CalendarEncounter.Log = append(s.CalendarEncounter.Log, encounterReason{Second: s.Life.Seconds, Cause: e.Duty.Law, Choice: c.choice, Outcome: c.outcome, Observed: true})
		// the old log asked the intake question folded since, and the fear question that stays
		s.CalendarEncounter.Talk = dialogueSession{Chosen: []string{"ask_intake", "ask_fear"}, Lines: []dialogueEntry{{Kind: "line", Speaker: e.Guard, Text: "encounter.prokhor.prompt.guard"}}}
		r.sanitizeMemory(&s)
		if _, ok := s.Memory.Facts[c.fact]; !ok {
			t.Fatalf("%s: no %s from the old save", c.choice, c.fact)
		}
		if rec := s.Memory.Facts[r.encounterMetFact()]; !reflect.DeepEqual(rec.Args["how"], []string{"greeted"}) {
			t.Fatalf("%s: the old greeting did not become the acquaintance: %+v", c.choice, rec)
		}
		if s.CalendarEncounter.Met || len(s.CalendarEncounter.Talk.Lines) > 0 || s.Memory.Talks[custodyKey(r)] == nil {
			t.Fatalf("%s: the old encounter's conversation did not move into the memory", c.choice)
		}
		if got := s.Memory.Talks[custodyKey(r)].Chosen; len(got) != 1 || got[0] != "ask_fear" {
			t.Fatalf("%s: the old log's answers came over as %v", c.choice, got)
		}
		if err := r.validateMemorySave(s); err != nil {
			t.Fatal(err)
		}
	}
}

