func visitorsRuntime(t testing.TB, rate int64) *Runtime {
	t.Helper()
	r := worldAuditRuntime(t, 0)
	if !r.visitorsOn() {
		t.Skip("the world has no hall visitors")
	}
	r.state.Life.SecondsPerTick = rate
	return r
}
func visitorsRun(t testing.TB, r *Runtime, seconds int64, each func()) {
	t.Helper()
	for end := r.state.Life.Seconds + seconds; r.state.Life.Seconds < end; {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(r.state.Life.SecondsPerTick); err != nil {
			t.Fatal(err)
		}
		if each != nil {
			each()
		}
	}
}
func visitorsMoney(r *Runtime) int64 {
	var n int64
	for _, a := range r.state.Inventory.Accounts {
		n += a.Balance
	}
	return n
}
func visitorsHeld(r *Runtime) int64 {
	var n int64
	for _, i := range r.state.Inventory.Items {
		if worldVisitorSlot(r, i.Owner) {
			n += i.Quantity
		}
	}
	return n
}

// A whole day of the hall: about per_day people come, most of them buy, the goods and the money really move and both
// ledgers close — every CRD of a purse is either spent at a seller or back outside, every unit bought is either in a
// visitor's bag or carried out, and no money or goods appear.
func TestVisitorsDayOfTradeClosesItsLedgers(t *testing.T) {
	if testing.Short() {
		t.Skip("a whole day of the hall")
	}
	r := visitorsRuntime(t, 30)
	v := r.world.Visitors
	// to the next midnight, then one whole day
	visitorsRun(t, r, 86400-r.state.Life.Seconds%86400, nil)
	if len(r.state.Visitors.Bodies) != 0 {
		t.Fatalf("%d visitors are in the hall at midnight", len(r.state.Visitors.Bodies))
	}
	before := r.state.Visitors.clone().Ledger
	money, wages := visitorsMoney(r), r.state.NPCEconomy.WageSource
	peak := 0
	visitorsRun(t, r, 86400, func() {
		if n := len(r.state.Visitors.Bodies); n > peak {
			peak = n
		}
		clock := r.state.Life.Seconds % 86400
		if n := len(r.state.Visitors.Bodies); n > 0 && (clock < v.OpenSecond || clock >= v.LeaveSecond+r.state.Life.SecondsPerTick) {
			t.Fatalf("%d visitors in the locked hall at second %d", n, clock)
		}
	})
	l := r.state.Visitors.Ledger
	arrived, bought, spent := l.Arrived-before.Arrived, l.Purchases-before.Purchases, l.Spent-before.Spent
	t.Logf("visitors of a day: arrived %d, walked %d, unseen %d, passed %d; bought %d units for %d minor; most bodies at once %d", arrived, l.Walked-before.Walked, l.Unseen-before.Unseen, l.Passed-before.Passed, bought, spent, peak)
	if arrived != v.PerDay {
		t.Fatalf("arrived %d, the day has %d", arrived, v.PerDay)
	}
	if peak < 1 || peak > v.MaxBodies {
		t.Fatalf("bodies at once %d, limit %d", peak, v.MaxBodies)
	}
	if bought < v.PerDay/2 || bought > 2*v.PerDay {
		t.Fatalf("purchases of the day %d are out of range for %d visitors", bought, v.PerDay)
	}
	if (l.PurseIn-before.PurseIn)-(l.PurseOut-before.PurseOut) != spent {
		t.Fatalf("purses: in %d, back %d, spent %d", l.PurseIn-before.PurseIn, l.PurseOut-before.PurseOut, spent)
	}
	if got := visitorsMoney(r) - money; got != r.state.NPCEconomy.WageSource-wages {
		t.Fatalf("money changed by %d outside the wages %d", got, r.state.NPCEconomy.WageSource-wages)
	}
	var carried, sold, paid int64
	for id, n := range l.Carried {
		carried += n - before.Carried[id]
	}
	for id, n := range l.Units {
		sold += n - before.Units[id]
		paid += l.Turnover[id] - before.Turnover[id]
	}
	if carried+visitorsHeld(r) != bought || sold != bought || paid != spent {
		t.Fatalf("units: bought %d, carried out %d, in bags %d, by seller %d; paid by seller %d of %d", bought, carried, visitorsHeld(r), sold, paid, spent)
	}
	sellers := 0
	for id, n := range l.Units {
		if n-before.Units[id] > 0 {
			sellers++
		}
	}
	if sellers < len(v.Supply.Rules)/2 {
		t.Fatalf("only %d sellers sold to the visitors (%d stalls and peddlers are supplied)", sellers, len(v.Supply.Rules))
	}
	// the outside account is finite and was not drained
	if a := r.state.Inventory.Accounts[v.Outside.Account]; a.Balance <= 0 || a.Balance > v.Outside.Balance {
		t.Fatalf("outside account %d", a.Balance)
	}
}

// The same seed gives the same visitors; another seed gives others; a save in the middle of a rush continues the same.
func TestVisitorsAreDeterministicBySeedAndSurviveASave(t *testing.T) {
	hash := func(r *Runtime) string {
		b, err := json.Marshal(r.state.Visitors)
		if err != nil {
			t.Fatal(err)
		}
		return string(b)
	}
	start := func(seed int64) *Runtime {
		r := visitorsRuntime(t, 10)
		r.state.Seed += seed
		// 06:00 of the next morning in one step of the audit clock would skip the night; walk to the opening instead
		return r
	}
	a, b, c := start(0), start(0), start(7)
	open := a.world.Visitors.OpenSecond
	wait := (open - a.state.Life.Seconds%86400 + 86400) % 86400
	for _, r := range []*Runtime{a, b, c} {
		r.state.Life.SecondsPerTick = 30
		visitorsRun(t, r, wait, nil)
		r.state.Life.SecondsPerTick = 10
		visitorsRun(t, r, 1800, nil)
	}
	if hash(a) != hash(b) {
		t.Fatal("the same seed gave different visitors")
	}
	if hash(a) == hash(c) {
		t.Fatal("another seed gave the same visitors")
	}
	if len(a.state.Visitors.Bodies) == 0 || a.state.Visitors.Ledger.Purchases == 0 {
		t.Fatalf("no rush after the opening: bodies %d, purchases %d", len(a.state.Visitors.Bodies), a.state.Visitors.Ledger.Purchases)
	}
	if err := a.validateVisitorSave(a.state); err != nil {
		t.Fatal(err)
	}
	raw, err := json.Marshal(a.state)
	if err != nil {
		t.Fatal(err)
	}
	resumed := visitorsRuntime(t, 10)
	var s state
	if err = json.Unmarshal(raw, &s); err != nil {
		t.Fatal(err)
	}
	resumed.state = s
	if err := resumed.validateVisitorSave(resumed.state); err != nil {
		t.Fatal(err)
	}
	visitorsRun(t, a, 1800, nil)
	visitorsRun(t, resumed, 1800, nil)
	if hash(a) != hash(resumed) {
		t.Fatal("the saved game continued with other visitors")
	}
}

