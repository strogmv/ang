// Code generated by ANG. Combat episodes of the Player (doc 96): real NewGame, movement, recognition, combat commands,
// the panel's validated options, the barks of the fight and a save/load in the middle of an encounter.
package poc

import (
	"fmt"
	"reflect"
	"strings"
	"testing"

	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

func combatEpisodeFixture(t *testing.T, id, locale string) (*Runtime, *connection, playableSceneDefinition) {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	d, ok := r.world.PlayableScenes[id]
	if !ok {
		t.Skip("world has no combat episode " + id)
	}
	c := &connection{locale: locale, out: make(chan *pb.ServerMessage, 4096), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "episode.new", Scenario: d.Scenario, Seed: 711}}}})
	answer, _ := playableDrain(c)
	if answer == nil || !answer.Ok || r.state.Playable.ID != d.ID {
		t.Fatalf("real NewGame did not enter the combat episode: %+v", answer)
	}
	return r, c, d
}

// combatEpisodeEngage walks the hero to the patrol's first post; recognition and the encounter are the host's own.
func combatEpisodeEngage(t *testing.T, r *Runtime, c *connection, d playableSceneDefinition) {
	t.Helper()
	for frame := 0; frame < 120 && r.state.Life.Actor(d.Guard).Position == d.GuardRoute[0]; frame++ {
		r.step()
	}
	r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: uint64(r.state.Tick) + 1, X: int32(d.GuardRoute[0].X), Y: int32(d.GuardRoute[0].Y)})
	playableDrain(c)
	for frame := 0; frame < 2400 && !r.heroInCombat(); frame++ {
		r.step()
	}
	if !r.heroInCombat() || r.state.Combat.Actor(d.Guard) == nil {
		t.Fatal("the watchman never recognised the hero into a shared encounter")
	}
}

func combatEpisodeView(r *Runtime, c *connection) *pb.PocGameState {
	r.sendState(c)
	_, state := playableDrain(c)
	return state
}

func combatEpisodeOption(view *pb.PocGameState, id string) *pb.PocCombatOption {
	if view == nil || view.Combat == nil {
		return nil
	}
	for _, o := range view.Combat.Options {
		if o.Id == id || strings.HasPrefix(o.Id, id) {
			return o
		}
	}
	return nil
}

func combatEpisodeSend(t *testing.T, r *Runtime, c *connection, o *pb.PocCombatOption, request string) *pb.PocActionResult {
	t.Helper()
	result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: request, Action: o.Action, TargetId: o.TargetId, Mode: o.Mode, ItemId: o.ItemId, X: o.X, Y: o.Y, BodyPart: "torso", ExpectedTurn: r.state.Combat.Turn})
	return result
}

func combatEpisodeHeroTurn(r *Runtime) bool {
	for n := 0; n < 40 && r.state.Combat.Active; n++ {
		if cur := r.state.Combat.Current(); cur != nil && cur.ID == playerActorID && cur.StunTurns == 0 {
			return true
		}
		r.step()
	}
	return false
}

func TestCombatEpisodeKnifeOptionsBarksAndSaveLoad(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_knife", "ru")
	combatEpisodeEngage(t, r, c, d)
	if !combatEpisodeHeroTurn(r) {
		t.Fatal("the hero never got a turn")
	}
	view := combatEpisodeView(r, c)
	if view.Combat == nil || len(view.Combat.Options) == 0 || view.Combat.TurnAp != int32(r.world.CombatRuntime.Rules.APPerTurn) {
		t.Fatalf("the hero's turn has no validated panel: %+v", view.Combat)
	}
	for _, o := range view.Combat.Options {
		if o.Label == "" || !o.Enabled && (o.Reason == "" || strings.HasPrefix(o.Reason, "error.") || strings.Contains(o.Reason, "{")) {
			t.Fatalf("option %s is not explained in words: %+v", o.Id, o)
		}
	}
	for _, a := range view.Combat.Actors {
		if a.Id == d.Guard && a.HeldItem != "item.service_baton" {
			t.Fatalf("the watchman's visible baton is not published: %q", a.HeldItem)
		}
	}
	if o := combatEpisodeOption(view, "bandage"); o == nil || o.Enabled || !strings.Contains(o.Reason, "кровотечения нет") {
		t.Fatalf("bandaging without bleeding is not refused in words: %+v", o)
	}
	equip := combatEpisodeOption(view, "equip.")
	if equip == nil || !equip.Enabled || equip.Ap != int32(r.world.CombatRuntime.Rules.EquipAP) {
		t.Fatalf("the knife in the bag is not offered for its AP: %+v", equip)
	}
	if res := combatEpisodeSend(t, r, c, equip, "episode.equip"); !res.Ok {
		t.Fatal(res.Message)
	}
	if r.state.Combat.Actor(playerActorID).Weapon.ID != "item.knife_simple" {
		t.Fatal("equip did not put the real knife in the hand")
	}
	saved, savedTurn := false, int64(0)
	var snapshot state
	attacks, bandaged := 0, false
	for step := 0; step < 80 && r.heroInCombat() && combatEpisodeHeroTurn(r); step++ {
		view = combatEpisodeView(r, c)
		if !saved && attacks > 0 {
			snapshot = r.snapshotState()
			if err := r.writeSave(r.world.Config.SaveSlots[0], snapshot); err != nil {
				t.Fatal(err)
			}
			saved, savedTurn = true, r.state.Combat.Turn
		}
		var pick *pb.PocCombatOption
		if o := combatEpisodeOption(view, "bandage"); o != nil && o.Enabled {
			pick, bandaged = o, true
		}
		for _, id := range []string{"attack.heavy.", "attack.single.", "attack.quick.", "move.approach.", "end"} {
			if o := combatEpisodeOption(view, id); pick == nil && o != nil && o.Enabled {
				pick = o
			}
		}
		if pick == nil {
			t.Fatalf("no enabled option on the hero's turn: %+v", view.Combat.Options)
		}
		if pick.Action == "attack" {
			attacks++
		}
		if res := combatEpisodeSend(t, r, c, pick, fmt.Sprintf("episode.%d", step)); !res.Ok {
			t.Fatalf("validated option %s refused by the same server: %s", pick.Id, res.Message)
		}
		// The Life clock keeps running while the client shows the events (the barks listen in its frames).
		for n := 0; n < 20; n++ {
			r.step()
		}
		playableDrain(c)
	}
	if attacks == 0 {
		t.Fatal("the episode never reached a real knife attack")
	}
	guardBlows := 0
	for _, e := range r.state.Combat.Events {
		if e.ActorID == d.Guard && e.Type == "attack" {
			guardBlows++
		}
	}
	shouted := false
	for line := range r.state.Barks.Voices {
		shouted = shouted || strings.HasPrefix(line, d.Guard+"|")
	}
	if !shouted {
		t.Fatal("the watchman never shouted during the fight (barks adapter)")
	}
	t.Logf("knife episode: hero attacks=%d bandaged=%t guard blows=%d active=%t winner=%q voices=%v", attacks, bandaged, guardBlows, r.state.Combat.Active, r.state.Combat.Winner, r.state.Barks.Voices)
	if !saved {
		t.Fatal("no save point in the middle of the encounter")
	}
	loaded, _, err := r.readSave(r.world.Config.SaveSlots[0])
	if err != nil {
		t.Fatal("mid-combat save failed validation", err)
	}
	if !reflect.DeepEqual(loaded.Combat, snapshot.Combat) || loaded.Combat.Turn != savedTurn || !reflect.DeepEqual(loaded.Inventory, snapshot.Inventory) {
		t.Fatal("save/load changed the encounter or its physical items")
	}
	sdkHostLoad(t, r, loaded, "episode.restore")
	if !r.heroInCombat() || r.state.Combat.Turn != savedTurn || r.world.PlayableID != d.ID {
		t.Fatal("load did not restore the encounter of the episode")
	}
	if view = combatEpisodeView(r, c); view.Combat == nil || len(view.Combat.Options) == 0 {
		t.Fatal("loaded encounter has no panel")
	}
}

func TestCombatEpisodeNeedleReloadAndShot(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_needle", "en")
	combatEpisodeEngage(t, r, c, d)
	if !combatEpisodeHeroTurn(r) {
		t.Fatal("the hero never got a turn")
	}
	view := combatEpisodeView(r, c)
	shot := combatEpisodeOption(view, "attack.single.")
	if shot == nil || shot.Enabled || !strings.Contains(shot.Reason, "empty") {
		t.Fatalf("an empty needle gun is not refused in words: %+v", shot)
	}
	reload := combatEpisodeOption(view, "reload")
	if reload == nil || !reload.Enabled {
		t.Fatalf("the clip in the bag is not offered: %+v", reload)
	}
	if res := combatEpisodeSend(t, r, c, reload, "needle.reload"); !res.Ok {
		t.Fatal(res.Message)
	}
	if hero := r.state.Combat.Actor(playerActorID); hero.Ammo != hero.Weapon.Magazine {
		t.Fatalf("reload did not load the real needles: %+v", hero)
	}
	if !combatEpisodeHeroTurn(r) {
		t.Skip("the encounter ended before the next turn")
	}
	view = combatEpisodeView(r, c)
	shot = combatEpisodeOption(view, "attack.single.")
	if shot == nil || !shot.Enabled {
		t.Skipf("no shot this turn: %+v", shot)
	}
	ammo := r.state.Combat.Actor(playerActorID).Ammo
	if res := combatEpisodeSend(t, r, c, shot, "needle.shot"); !res.Ok {
		t.Fatal(res.Message)
	}
	if a := r.state.Combat.Actor(playerActorID); a != nil && a.Ammo != ammo-1 {
		t.Fatalf("a shot did not spend one physical needle: %d -> %d", ammo, a.Ammo)
	}
	found := false
	for _, e := range combatEpisodeView(r, c).Combat.GetEvents() {
		found = found || e.Type == "attack" && e.ActorId == playerActorID && e.Ap > 0
	}
	if !found {
		t.Fatal("the hero's shot is not a public event with its AP")
	}
}

// The barks adapter only listens: a hit and a fall-back step of the watchman become «ранен, отхожу», and a shout that
// meets the speaker still talking waits instead of being lost. The two events are appended to a copy of the log only
// to drive the listener; no rule, AP or wound is decided here.
func TestCombatBarksWoundedRetreatWaitsForBusySpeaker(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_knife", "ru")
	combatEpisodeEngage(t, r, c, d)
	r.barkCombatFrame()
	guard := r.state.Combat.Actor(d.Guard)
	if guard == nil {
		t.Fatal("no watchman in the encounter")
	}
	guard.HP = guard.MaxHP - 10
	seq := r.state.Combat.EventSeq
	r.state.Combat.Events = append(r.state.Combat.Events,
		behavior.CombatEvent{Type: "attack", ActorID: playerActorID, TargetID: d.Guard, Hit: true, Amount: 10, Sequence: seq + 1, Turn: r.state.Combat.Turn},
		behavior.CombatEvent{Type: "move", ActorID: d.Guard, From: guard.Position, To: guard.Position, Reason: "increase separation from known danger", Sequence: seq + 2, Turn: r.state.Combat.Turn})
	r.state.Combat.EventSeq = seq + 2
	busy := false
	for _, sp := range r.state.Barks.Active {
		busy = busy || sp.Speaker == d.Guard
	}
	r.barkCombatFrame()
	said := func() bool {
		for line := range r.state.Barks.Voices {
			if strings.HasPrefix(line, d.Guard+"|") && strings.Contains(line, "retreat") {
				return true
			}
		}
		return false
	}
	if busy && said() {
		t.Fatal("a speaker still talking shouted over himself")
	}
	if busy && r.barkCombat.pending[d.Guard].intent != "wounded_retreat" {
		t.Fatalf("the fall-back shout of a busy speaker was lost: %+v", r.barkCombat.pending)
	}
	for n := 0; n < 120 && !said(); n++ {
		r.step()
	}
	if !said() {
		t.Fatalf("«wounded, falling back» never reached the hero: voices=%v pending=%+v", r.state.Barks.Voices, r.barkCombat.pending)
	}
}
