// Code generated by ANG. Server-side direct light and physical shadow rays.
package behavior

import "math"

// DeckPointMM uses the authored physical frame: X/Y in the plan, Z up. A plan
// cell occupies [X*500,(X+1)*500] x [Y*500,(Y+1)*500], not a nav-band row.
type DeckPointMM struct {
	X float64 `json:"x_mm"`
	Y float64 `json:"y_mm"`
	Z float64 `json:"z_mm"`
}

// DeckRayBox is an opaque closed box in the same frame. The host supplies a
// read-only snapshot of moving gate leaves; no gate clock lives in this kernel.
type DeckRayBox struct {
	Min DeckPointMM `json:"min"`
	Max DeckPointMM `json:"max"`
}

const illuminationBoundaryEpsilonMM = 1e-7

func illuminationFinite(n float64) bool { return !math.IsNaN(n) && !math.IsInf(n, 0) }
func illuminationPointFinite(p DeckPointMM) bool {
	return illuminationFinite(p.X) && illuminationFinite(p.Y) && illuminationFinite(p.Z)
}

// RayClearMM traces the exact segment, including both ends, against prepared
// slabs/solids/edges and dynamic boxes. Touching an opaque face/edge/corner is
// blocked: there is no sight's "look at the near face" exception. A fixture
// mounted on a wall must author its emitting point outside its own housing.
// Invalid/unprepared volumes, non-finite input and rays outside the plan fail
// closed. This method does not modify the volume, dynamic boxes or sight cache.
func (v *DeckVolume) RayClearMM(from, to DeckPointMM, dynamic []DeckRayBox) bool {
	if v == nil || v.PlanWidth < 1 || v.PlanDepth < 1 || v.PlanWidth > 1<<20 || v.PlanDepth > 1<<20 || len(v.spans) != v.PlanWidth*v.PlanDepth || !illuminationPointFinite(from) || !illuminationPointFinite(to) {
		return false
	}
	dx, dy, dz := to.X-from.X, to.Y-from.Y, to.Z-from.Z
	if !illuminationFinite(dx) || !illuminationFinite(dy) || !illuminationFinite(dz) || !v.illuminationPointClear(from) || !v.illuminationPointClear(to) {
		return false
	}
	for _, box := range dynamic {
		if !illuminationPointFinite(box.Min) || !illuminationPointFinite(box.Max) || box.Min.X > box.Max.X || box.Min.Y > box.Max.Y || box.Min.Z > box.Max.Z || illuminationBoxHit(from, to, box) {
			return false
		}
	}
	cx, cy := int(math.Floor(from.X/deckCellMM)), int(math.Floor(from.Y/deckCellMM))
	parallelX, parallelY := false, false
	if line, on := illuminationBoundary(from.X); dx == 0 && on {
		cx, parallelX = line, true
	}
	if line, on := illuminationBoundary(from.Y); dy == 0 && on {
		cy, parallelY = line, true
	}
	stepX, stepY := 0, 0
	tMaxX, tMaxY, tDeltaX, tDeltaY := math.Inf(1), math.Inf(1), math.Inf(1), math.Inf(1)
	if dx > 0 {
		stepX, tDeltaX = 1, deckCellMM/dx
		tMaxX = (float64(cx+1)*deckCellMM - from.X) / dx
	} else if dx < 0 {
		stepX, tDeltaX = -1, -deckCellMM/dx
		tMaxX = (float64(cx)*deckCellMM - from.X) / dx
	}
	if dy > 0 {
		stepY, tDeltaY = 1, deckCellMM/dy
		tMaxY = (float64(cy+1)*deckCellMM - from.Y) / dy
	} else if dy < 0 {
		stepY, tDeltaY = -1, -deckCellMM/dy
		tMaxY = (float64(cy)*deckCellMM - from.Y) / dy
	}
	t := 0.0
	// Every iteration crosses at least one plan boundary, except the final one.
	for steps := 0; steps <= v.PlanWidth+v.PlanDepth+2; steps++ {
		next := math.Min(1, math.Min(tMaxX, tMaxY))
		if next < t || !v.illuminationColumnClear(cx, cy, from.Z+dz*t, from.Z+dz*next, parallelX, parallelY) {
			return false
		}
		if next >= 1 {
			return true
		}
		// A supercover corner test includes every incident column and edge. A
		// diagonal ray cannot slip between two solids that touch at a corner.
		at := DeckPointMM{from.X + dx*next, from.Y + dy*next, from.Z + dz*next}
		if !v.illuminationPointClear(at) {
			return false
		}
		crossX, crossY := tMaxX <= tMaxY, tMaxY <= tMaxX
		if crossX {
			cx += stepX
			tMaxX += tDeltaX
		}
		if crossY {
			cy += stepY
			tMaxY += tDeltaY
		}
		t = next
	}
	return false
}

func illuminationBoundary(mm float64) (int, bool) {
	line := math.Round(mm / deckCellMM)
	return int(line), math.Abs(mm-line*deckCellMM) <= illuminationBoundaryEpsilonMM
}

func (v *DeckVolume) illuminationPointClear(p DeckPointMM) bool {
	if p.X < 0 || p.Y < 0 || p.X >= float64(v.PlanWidth)*deckCellMM || p.Y >= float64(v.PlanDepth)*deckCellMM {
		return false
	}
	cx, cy := int(math.Floor(p.X/deckCellMM)), int(math.Floor(p.Y/deckCellMM))
	lineX, boundaryX := illuminationBoundary(p.X)
	lineY, boundaryY := illuminationBoundary(p.Y)
	if boundaryX {
		cx = lineX
	}
	if boundaryY {
		cy = lineY
	}
	return v.illuminationColumnClear(cx, cy, p.Z, p.Z, boundaryX, boundaryY)
}

// On a grid plane include both neighboring columns and the entire edge height
// interval. This also handles vertical rays and rays parallel to a thin wall.
func (v *DeckVolume) illuminationColumnClear(cx, cy int, z0, z1 float64, boundaryX, boundaryY bool) bool {
	left, top := cx, cy
	if boundaryX {
		left--
	}
	if boundaryY {
		top--
	}
	lo, hi := math.Min(z0, z1), math.Max(z0, z1)
	for y := top; y <= cy; y++ {
		for x := left; x <= cx; x++ {
			if x < 0 || y < 0 || x >= v.PlanWidth || y >= v.PlanDepth {
				return false
			}
			n := y*v.PlanWidth + x
			for _, iv := range v.spans[n] {
				if iv.bottom > iv.top || iv.bottom <= hi && iv.top >= lo {
					return false
				}
			}
			if boundaryX {
				side := byte('w')
				if x < cx {
					side = 'e'
				}
				if v.illuminationEdgeHit(n, side, lo, hi) {
					return false
				}
			}
			if boundaryY {
				side := byte('n')
				if y < cy {
					side = 's'
				}
				if v.illuminationEdgeHit(n, side, lo, hi) {
					return false
				}
			}
		}
	}
	return true
}

func (v *DeckVolume) illuminationEdgeHit(n int, side byte, lo, hi float64) bool {
	for _, iv := range v.edges[deckEdgeKey{n, side}] {
		if iv.bottom > iv.top || iv.bottom <= hi && iv.top >= lo {
			return true
		}
	}
	return false
}

func illuminationBoxHit(from, to DeckPointMM, box DeckRayBox) bool {
	start, end := 0.0, 1.0
	a := [3]float64{from.X, from.Y, from.Z}
	b := [3]float64{to.X, to.Y, to.Z}
	low := [3]float64{box.Min.X, box.Min.Y, box.Min.Z}
	high := [3]float64{box.Max.X, box.Max.Y, box.Max.Z}
	for axis := range a {
		d := b[axis] - a[axis]
		if d == 0 {
			if a[axis] < low[axis] || a[axis] > high[axis] {
				return false
			}
			continue
		}
		near, far := (low[axis]-a[axis])/d, (high[axis]-a[axis])/d
		if near > far {
			near, far = far, near
		}
		start, end = math.Max(start, near), math.Min(end, far)
		if start > end {
			return false
		}
	}
	return true
}

// BodyLightPoints returns legs/torso/head in physical plan coordinates, using
// the same stance heights as combat. Invalid/unmapped navigation yields NaNs,
// which RayClearMM and DirectIlluminance reject rather than sampling map origin.
func (v *DeckVolume) BodyLightPoints(at Cell, pose Combatant) [3]DeckPointMM {
	bad := DeckPointMM{math.NaN(), math.NaN(), math.NaN()}
	if v == nil || v.PlanWidth < 1 || v.NavWidth < 1 || v.NavDepth < 1 || len(v.navPlan) != v.NavWidth*v.NavDepth || len(v.navHeight) != len(v.navPlan) || len(v.navDeck) != len(v.navPlan) {
		return [3]DeckPointMM{bad, bad, bad}
	}
	plan, height, _, ok := v.Locate(at)
	if !ok {
		return [3]DeckPointMM{bad, bad, bad}
	}
	x, y := (float64(plan.X)+.5)*deckCellMM, (float64(plan.Y)+.5)*deckCellMM
	return [3]DeckPointMM{
		{x, y, float64(height + combatBodyHeight(pose, "legs"))},
		{x, y, float64(height + combatBodyHeight(pose, "torso"))},
		{x, y, float64(height + combatBodyHeight(pose, "head"))},
	}
}

type LightEmitter struct {
	ID               string      `json:"id"`
	Distribution     string      `json:"distribution"`
	At               DeckPointMM `json:"at"`
	Aim              DeckPointMM `json:"aim"`
	Lumens           float64     `json:"lumens"`
	BeamDegrees      float64     `json:"beam_degrees"`
	GlassTiltDegrees float64     `json:"glass_tilt_degrees"`
}

// DirectIlluminance is an unshadowed game approximation in lux, not certified
// photometry. It measures a receiver facing the incoming ray: there is no
// receiver-normal, reflected/ambient light, fixture area or power state here.
// Units are lumens/metres; distance is clamped to 100 mm near a point emitter.
// Lambert is normalized over its hemisphere, iso over the sphere. Spot/asym
// use the bake's cos^n FWHM beam and a finite, softly cut cone (at most 170 deg).
// Truncation/glass clipping can discard flux; they never invent upward spill.
func DirectIlluminance(e LightEmitter, p DeckPointMM) float64 {
	if !illuminationPointFinite(e.At) || !illuminationPointFinite(p) || !illuminationFinite(e.Lumens) || e.Lumens <= 0 {
		return 0
	}
	dx, dy, dz := p.X-e.At.X, p.Y-e.At.Y, p.Z-e.At.Z
	distance := math.Hypot(math.Hypot(dx, dy), dz)
	if !illuminationFinite(distance) || distance <= 0 {
		return 0
	}
	x, y, z := dx/distance, dy/distance, dz/distance
	intensity := 0.0
	switch e.Distribution {
	case "iso":
		intensity = e.Lumens / (4 * math.Pi)
	case "lambert_down":
		intensity = e.Lumens / math.Pi * math.Max(0, -z)
	case "wall_down", "spot", "asym":
		if !illuminationPointFinite(e.Aim) {
			return 0
		}
		ax, ay, az := e.Aim.X-e.At.X, e.Aim.Y-e.At.Y, e.Aim.Z-e.At.Z
		length := math.Hypot(math.Hypot(ax, ay), az)
		if !illuminationFinite(length) || length <= 0 {
			return 0
		}
		cosine := math.Min(1, x*(ax/length)+y*(ay/length)+z*(az/length))
		if cosine <= 0 {
			return 0
		}
		if e.Distribution == "wall_down" {
			intensity = e.Lumens / math.Pi * cosine
			break
		}
		beam := e.BeamDegrees
		if beam == 0 {
			beam = 100
		}
		if !illuminationFinite(beam) || beam < 1 || beam > 170 {
			return 0
		}
		half := beam * math.Pi / 360
		cosHalf, cosCone := math.Cos(half), math.Cos(math.Min(85*math.Pi/180, half*1.25))
		if cosine < cosCone {
			return 0
		}
		if e.Distribution == "asym" {
			if !illuminationFinite(e.GlassTiltDegrees) || e.GlassTiltDegrees < -90 || e.GlassTiltDegrees > 90 {
				return 0
			}
			// The glass normal tilts from down toward horizontal aim. No light
			// emerges behind the glass, even when the optical axis points there.
			horizontal := math.Hypot(ax, ay)
			tilt := e.GlassTiltDegrees * math.Pi / 180
			glass := -z * math.Cos(tilt)
			if horizontal > 0 {
				glass += (x*(ax/horizontal) + y*(ay/horizontal)) * math.Sin(tilt)
			}
			if glass <= 0 {
				return 0
			}
		}
		n := math.Log(.5) / math.Log(cosHalf)
		intensity = e.Lumens * ((n + 1) / (2 * math.Pi)) * math.Pow(cosine, n)
		if cosine < cosHalf && cosHalf > cosCone {
			feather := (cosine - cosCone) / (cosHalf - cosCone)
			intensity *= feather * feather * (3 - 2*feather)
		}
	default:
		return 0
	}
	metres := math.Max(.1, distance/1000)
	lux := intensity / metres / metres
	if math.IsNaN(lux) || lux < 0 {
		return 0
	}
	if math.IsInf(lux, 1) {
		return math.MaxFloat64
	}
	return lux
}
