// Generated by ANG. Source surface and lettering share this deformation exactly (cloth v2).
// A hanging piece (a heavy PVC strip, a banner) is a line hinged on its top rail at mesh height cloth.x, cloth.y long, held
// by its clamp: over cloth.z it turns from the vertical to its hinge angle, below that it bends a little further toward its
// free end. swing.x is the hinge angle and swing.y the bend at the free end (radians; positive: the free end moves along
// axis, the piece's own horizontal swing direction in mesh space). The people's push sets them (client cloth_motion.gd);
// with no push they are 0 and the piece hangs still. The only motion without a person is the drift of a draft named in
// data: drift.x radians over drift.y seconds (drift.x 0: still air, there is no wind in the dome). The line keeps its
// length: it is integrated exactly, so the free end rises as it swings and the piece never stretches.
float ang_cloth_sinc(float u) {
 return abs(u)<0.0001?1.0-u*u/6.0:sin(u)/u;
}
// The drift angle at time t: two slow sines, the faster one at the draft's period.
float ang_cloth_drift(vec2 drift, float t, float phase) {
 if(drift.x<=0.0||drift.y<=0.0) {return 0.0;}
 float w=6.2831853*t/drift.y;
 return drift.x*(0.8*sin(w+phase)+0.2*sin(0.618*w+1.7*phase+1.3));
}
// One piece of the line whose angle runs evenly from p0 to p1 over length l, integrated up to x (0..l): its
// (along axis, down) extent.
vec2 ang_cloth_piece(float p0, float p1, float l, float x) {
 float d=(p1-p0)*x/max(l,0.00001);
 float k=x*ang_cloth_sinc(0.5*d);
 return vec2(sin(p0+0.5*d),cos(p0+0.5*d))*k;
}
// The line at arc length s from the hinge: x along axis, y down, z its angle there.
vec3 ang_cloth_line(float s, vec3 cloth, float a, float b) {
 float len=max(cloth.y,0.01);
 float c=clamp(cloth.z,0.005,0.5*len);
 float m=c+0.5*(len-c);
 float a2=a+0.3*b;
 float a3=a+b;
 float x0=clamp(s,0.0,c);
 float x1=clamp(s-c,0.0,m-c);
 float x2=clamp(s-m,0.0,len-m);
 vec2 r=ang_cloth_piece(0.0,a,c,x0)+ang_cloth_piece(a,a2,m-c,x1)+ang_cloth_piece(a2,a3,len-m,x2);
 r+=vec2(sin(a3),cos(a3))*max(s-len,0.0);
 float angle=s<=c?a*x0/c:(s<=m?a+(a2-a)*x1/(m-c):a2+(a3-a2)*x2/(len-m));
 return vec3(r,angle);
}
// The total hinge angle: the people's swing plus the drift (a MultiMesh instance drifts on its own phase).
float ang_cloth_hinge(float instance_id, float phase, float time, vec4 swing, vec2 drift) {
 return swing.x+ang_cloth_drift(drift,time,phase+instance_id*2.17);
}
// The offset of mesh point p. A horizontal canopy only heaves with the drift toward its hem (uv.y).
vec3 ang_cloth_offset(vec3 p, vec3 axis, vec2 uv, float instance_id, float phase, float time,
 vec4 swing, vec3 cloth, vec2 drift, bool horizontal) {
 float a=ang_cloth_hinge(instance_id,phase,time,swing,drift);
 if(horizontal) {return vec3(0.0,0.25*cloth.y*a*uv.y,0.0);}
 float s=max(cloth.x-p.y,0.0);
 vec3 line=ang_cloth_line(s,cloth,a,swing.y);
 return axis*line.x+vec3(0.0,s-line.y,0.0);
}
// The angle the piece is turned at p (radians, about its rail): the same line, for turning its normals.
float ang_cloth_angle(vec3 p, float instance_id, float phase, float time, vec4 swing, vec3 cloth, vec2 drift, bool horizontal) {
 if(horizontal) {return 0.0;}
 float a=ang_cloth_hinge(instance_id,phase,time,swing,drift);
 return ang_cloth_line(max(cloth.x-p.y,0.0),cloth,a,swing.y).z;
}
// A vector (a normal, the paint's standoff) turned with the piece by angle a about its rail.
vec3 ang_cloth_turn(vec3 v, vec3 axis, float a) {
 float x=dot(v,axis);
 float c=cos(a);
 float sn=sin(a);
 return v+axis*(x*c-v.y*sn-x)+vec3(0.0,x*sn+v.y*c-v.y,0.0);
}
