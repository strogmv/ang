func (r *Runtime) devChanges(before, after devSnapshot) []*pb.PocDialogueChangeDebug {
	var changes []*pb.PocDialogueChangeDebug
	kinds := map[string]bool{}
	for kind := range before { kinds[kind] = true }
	for kind := range after { kinds[kind] = true }
	for _, kind := range slices.Sorted(maps.Keys(kinds)) {
		ids := map[string]bool{}
		for id := range before[kind] { ids[id] = true }
		for id := range after[kind] { ids[id] = true }
		for _, id := range slices.Sorted(maps.Keys(ids)) {
			old, next := before[kind][id], after[kind][id]
			if old == next { continue }
			row := &pb.PocDialogueChangeDebug{Kind: kind, Id: id, Before: old, After: next}
			if kind == "fact" || kind == "knowledge" {
				row.KnownBy = r.devKnownBy(id)
			}
			if kind == "scheduled" { row.DueSecond, _ = strconv.ParseInt(next,10,64) }
			changes = append(changes, row)
		}
	}
	return changes
}

func (r *Runtime) devKnownBy(id string) []string {
	var out []string
	if r.storyBelief(playerActorID, id) > 0 { out = append(out, playerActorID) }
	for _, actor := range r.state.Life.Actors {
		if actor.ID != playerActorID && r.storyBelief(actor.ID, id) > 0 {
			out = append(out, actor.ID)
		}
	}
	slices.Sort(out)
	return out
}

func (r *Runtime) devStep(c talkCtx, id string) func(string) {
	d := r.dev.session(r.state.Epoch, c)
	before := r.devSnapshot()
	step := &pb.PocDialogueStepDebug{Id: id, Node: c.t.Node}
	d.effectSink = &step.Effects
	return func(outcome string) {
		d.effectSink = nil
		step.Outcome, step.NextNode, step.Close = outcome, c.t.Node, c.t.Close
		step.Changes = r.devChanges(before, r.devSnapshot())
		// Keep the recent steps in the panel. The client appends them to a separate trace.
		d.steps = append(slices.Clone(d.steps), step)
		if r.state.Memory.Open != c.key {
			d.closed = &pb.PocDialogueDebug{Conversation: c.conv.ID, StoryFile: d.Paths[c.conv.ID],
				Entry: c.t.Entry, Node: c.t.Node, Card: step.Close, Session: fmt.Sprintf("%s#%d", c.key, c.t.Serial),
				Level: r.currentLevel(), GameSeconds: r.state.Life.Seconds, Steps: d.steps}
		}
	}
}

