func(m LifeModel)Person(id string)*LifePerson{for i:=range m.Actors{if m.Actors[i].ID==id{return &m.Actors[i]}};return nil}
func(m LifeModel)Edge(id string)*LifeEdge{for i:=range m.Edges{if m.Edges[i].ID==id{return &m.Edges[i]}};return nil}
// Graph search is deterministic and minimizes configured travel time. Walking
// inside each location is planned separately against current physical occupants.
