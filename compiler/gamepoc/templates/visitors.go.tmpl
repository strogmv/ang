const visitorSerialStride int64 = 100000

// How long a walker waits before a shut cell until he looks for another way.
const visitorHoldTicks int64 = 30

type visitorArrival struct {
	Second int64 // second of the day
	Number int64
}

// Memory only: rebuilt from the seed, the day and the floor.
type visitorRuntime struct {
	seed, day int64
	arrivals  []visitorArrival
	ready     bool
	// walks over the floor as it is now: the memory is dropped whenever the floor changes (a gate, a lifting deck),
	// so a remembered walk is always what a fresh search would find — a save continues the same
	paths map[[2]behavior.Cell][]behavior.Cell
	floor uint64
	targets   map[string]int
	category  map[string][]int
	// units for sale on every showcase, by definition (rebuilt when the inventory changes)
	stock      map[string]map[string]int64
	stockAt    uint64
	stockReady bool
}

func (r *Runtime) visitorsOn() bool {
