// Code generated by ANG. Physical equipment and movement authority in Life combat.
package poc

import (
	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"reflect"
	"testing"
)

func combatEquippedStunner(t *testing.T, r *Runtime) string {
	t.Helper()
	for id, item := range r.state.Inventory.Items {
		if item.Definition != "item.security_stunner" {
			continue
		}
		model := r.inventoryModelFor(true)
		_, err := r.state.Inventory.Apply(model, inv.Transaction{Actor: playerActorID, Sequence: r.state.Inventory.Cursors[playerActorID].Sequence + 1, Moves: []inv.Move{{Item: id, Quantity: 1, ExpectedRevision: item.Revision, To: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID), Slot: model.Definitions[item.Definition].EquipSlot}}}})
		if err != nil {
			t.Fatal(err)
		}
		return id
	}
	t.Fatal("authored physical stock missing")
	return ""
}
func TestCombatLifeStunnerUsesRealStockAndWearAtomically(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	id := combatEquippedStunner(t, r)
	combatStart(t, r, c, target)
	item := r.state.Inventory.Items[id]
	if r.state.Combat.Actor(playerActorID).Weapon.ID != item.Definition {
		t.Fatal("equipped physical tool not selected")
	}
	q := &pb.PocCombatCommand{RequestId: "combat.physical.use", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}
	result, _ := combatWire(t, r, c, q)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	if r.state.Inventory.Items[id].Condition != item.Condition-r.world.Inventory.Definitions[item.Definition].WearPerUse {
		t.Fatal("combat left physical tool condition untouched")
	}
	before := r.state.Inventory.Clone()
	result, _ = combatWire(t, r, c, q)
	if !result.Ok || !reflect.DeepEqual(before, r.state.Inventory) {
		t.Fatal("wire replay consumed physical tool twice")
	}
}
func TestCombatLifeBrokenToolCannotCommitDamageOrAP(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	id := combatEquippedStunner(t, r)
	combatStart(t, r, c, target)
	// Break an existing equipped item between acceptance of the encounter and
	// the action. The action must revalidate the physical resource transaction.
	item := r.state.Inventory.Items[id]
	item.Condition = 0
	r.state.Inventory.Items[id] = item
	beforeCombat, beforeItems := r.state.Combat.Clone(), r.state.Inventory.Clone()
	result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "combat.broken", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if result.Ok || !reflect.DeepEqual(beforeCombat, r.state.Combat) || !reflect.DeepEqual(beforeItems, r.state.Inventory) {
		t.Fatal("failed physical use committed tactical effects")
	}
}
func TestCombatLifeMoveRejectsWrongSurfaceWithoutResourceMutation(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	combatStart(t, r, c, target)
	hero := r.state.Life.Actor(playerActorID)
	before := r.state.Combat.Clone()
	r.combatMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1, X: int32(hero.Position.X), Y: int32(hero.Position.Y), Deck: 999})
	var ack *pb.PocMoveResult
	for len(c.out) > 0 {
		if a := (<-c.out).GetMoveResult(); a != nil {
			ack = a
		}
	}
	if ack == nil || ack.Ok || !reflect.DeepEqual(before, r.state.Combat) {
		t.Fatal("wrong surface was reinterpreted as a tactical position")
	}
}
func TestCombatLifeInactiveHealthRosterDoesNotGrantFreeHealing(t *testing.T) {
	r, _, target := combatLifeFixture(t, true)
	a := r.combatant(target, "opposition")
	a.HP = max(1, a.HP-10)
	a.Position = r.state.Life.Actor(target).Position
	r.state.CombatRoster = map[string]behavior.Combatant{target: a}
	if next := r.combatant(target, "opposition"); next.HP != a.HP {
		t.Fatal("new encounter initialization healed persistent actor")
	}
}
