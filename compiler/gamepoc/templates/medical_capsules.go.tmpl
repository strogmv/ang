		r.medicalDoorTarget(p.UnitID, 1)
	} else if phase == "treatment" {
		r.medicalDoorTarget(p.UnitID, 0)
	}
	p.Phase = phase
	p.PhaseStartNS = r.simNS()
	p.PhaseEndNS = p.PhaseStartNS + int64(seconds*1e9)
}
func medicalDoorValue(d medicalDoor, now int64) float64 {
	if d.EndNS <= d.StartNS || now >= d.EndNS {
		return d.To
	}
	if now <= d.StartNS {
		return d.From
	}
	return d.From + (d.To-d.From)*float64(now-d.StartNS)/float64(d.EndNS-d.StartNS)
}
func (r *Runtime) medicalDoorTarget(id string, to float64) {
	if r.state.Medical.Doors == nil {
		r.state.Medical.Doors = map[string]medicalDoor{}
