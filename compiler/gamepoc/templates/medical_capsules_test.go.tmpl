func TestMedicalTwoActualPatientsNPCPolicyAndBlockedExit(t *testing.T) {
	r := medicalFixture(t)
	medicalInjure(t, r, playerActorID, true)
	p := medicalEnter(t, r)
	id := medicalPlaceNPC(t, r)
	r.world.MedicalCapsules.NPCSelfCare = true
	r.medicalNPCRequests()
	np, ok := r.state.Medical.Patients[id]
	if !ok || np.UnitID != r.world.MedicalCapsules.Units[1].ID {
		t.Fatal("NPC did not select free second unit")
	}
	r.advanceMedicalCapsules()
	medicalAdvance(t, r, r.world.MedicalCapsules.ScanSeconds+r.world.MedicalCapsules.EntrySeconds+.2)
	np = r.state.Medical.Patients[id]
	if np.Phase != "treatment" || !r.medicalAttached(id) {
		t.Fatalf("NPC did not enter real care %+v", np)
	}
	conn := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{})}
	r.sendLifeState(conn)
	msg := (<-conn.out).GetGameState()
	count := 0
	for _, agent := range msg.SceneAgents {
		if agent.Id == id {
			count++
			if agent.ServiceAttachment != np.UnitID {
				t.Fatal("NPC lost public service attachment")
			}
		}
	}
	if count != 1 {
		t.Fatalf("expected one existing NPC body, got %d", count)
	}
	var projected struct {
		Units []map[string]any `json:"units"`
	}
	if err := json.Unmarshal([]byte(msg.Life.MedicalCapsulesJson), &projected); err != nil {
		t.Fatal(err)
	}
	for _, unit := range projected.Units {
		if unit["patient_id"] == id && unit["quote"] != nil {
			t.Fatal("NPC clinical quote leaked")
		}
	}
	if len(r.state.Medical.Receipts) != 2 {
		t.Fatal("missing actual patient receipts")
	}
	hero := r.state.Life.Actor(playerActorID)
	u := r.world.MedicalCapsules.Units[0]
	blocker := r.state.Life.Actor(id)
	blocker.ServiceAttachment = ""
	blocker.Position = u.ScanCell
	blocker.Body = nil
	p = r.state.Medical.Patients[playerActorID]
	r.medicalSetPhase(&p, "exit", r.world.MedicalCapsules.ExitSeconds)
	r.state.Medical.Patients[playerActorID] = p
	medicalAdvance(t, r, r.world.MedicalCapsules.ExitSeconds+1)
	p = r.state.Medical.Patients[playerActorID]
	if !p.ExitBlocked || hero.ServiceAttachment == "" || r.medicalPatientPose(p, u) != u.InsidePose {
		t.Fatal("egress overlapped occupied floor")
	}
	blocker.Position = r.world.MedicalCapsules.Units[1].ScanCell
	medicalAdvance(t, r, r.world.MedicalCapsules.ExitSeconds+.2)
	if r.medicalReserved(playerActorID) || !hero.OnFloor() {
		t.Fatal("free exit not released")
	}
}
