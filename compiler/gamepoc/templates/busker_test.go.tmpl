	// a payer at the case, step by step: the palm on the reader for pay_ticks, then the money moves from his purse
	slot := -1
	used := map[int]bool{}
	for _, o := range r.state.Visitors.Bodies {
		used[o.Slot] = true
	}
	for i := 1; i < len(r.world.Visitors.Slots); i++ {
		if !used[i] {
			slot = i
			break
		}
	}
	if slot < 0 {
		t.Skip("no free visitor slot for the payer")
	}
	acct := r.visitorAccount(r.world.Visitors.Slots[slot])
	if !r.visitorMove(r.world.Visitors.Outside.Account, acct, 100) {
		t.Fatal("purse")
	}
	pay := b.Spot.Pay[0].cell()
	for _, o := range r.state.Visitors.Bodies {
		if o.At == pay {
			t.Skip("the pay cell is taken")
		}
	}
	serial := int64(day)*visitorSerialStride + 99999
	r.state.Visitors.Bodies = append(r.state.Visitors.Bodies, visitorBody{Serial: serial, Slot: slot, At: pay, Phase: "walk", Paying: true, Since: r.state.Tick})
	purse, his := r.state.Inventory.Accounts[acct].Balance, r.state.Inventory.Accounts[b.Account].Balance
	sawAct := false
	for k := int64(0); k < b.Listeners.PayTicks+3; k++ {
		r.state.Tick++
		if err := r.advanceVisitors(); err != nil {
			t.Fatal(err)
		}
		for _, o := range r.state.Visitors.Bodies {
			if o.Serial == serial && o.Phase == "pay" {
				if act := r.visitorAct(o); act != nil && act.Name == "pay_reader" {
					sawAct = true
				}
			}
		}
	}
	got := r.state.Inventory.Accounts[b.Account].Balance - his
	if !sawAct || got < b.Listeners.PayMinor.Min || got > b.Listeners.PayMinor.Max || purse-r.state.Inventory.Accounts[acct].Balance != got {
		t.Fatalf("a payer by the reader: act %v, his account +%d, the purse -%d", sawAct, got, purse-r.state.Inventory.Accounts[acct].Balance)
	}
}

// The hero by the case: a conversation opens once he stops there while the musician plays or rests; a tip goes by the
// reader from the hero's account to his (refused without the money); «listen» closes it until he walks off.
func TestBuskerHeroTalksAndTipsByTheReader(t *testing.T) {
	r := buskerWorld(t, 1)
	b := r.world.Busker
	day := buskerPresentDay(r)
	p := r.buskerPlanOf(day)
	r.state.Life.Seconds = day*86400 + p.Blocks[0].From + 600
	peddlerPlace(t, r, b.Actor, invCell(b.Spot.Seat))
	r.state.Busker = buskerState{Phase: "play", Since: r.state.Life.Seconds, Tune: 1, TuneTick: r.state.Tick, Last: 1}
	pay := b.Spot.Pay[0]
	peddlerPlace(t, r, playerActorID, invCell(pay))
	r.buskerHero()
	msg := &pb.PocGameState{}
	r.appendBuskerConversation(msg, "ru")
	v := msg.Conversation
	if v == nil || v.Kind != "busker" || v.Speaker != b.Actor || len(v.Choices) != 5+len(b.Hero.TipsMinor) {
		t.Fatalf("conversation by the case: %+v", v)
	}
	for _, c := range v.Choices {
		if c.Action != "busker_choice" || c.Text == "" {
			t.Fatalf("choice %+v", c)
		}
	}
	if err := r.buskerCommand(&pb.PocLifeCommand{Action: "busker_choice", Destination: "tune"}); err != nil {
		t.Fatal(err)
	}
	msg = &pb.PocGameState{}
	r.appendBuskerConversation(msg, "ru")
	if msg.Conversation == nil || msg.Conversation.Text == "" || msg.Conversation.Text == r.localText("ru", b.Lines["intro_play"], "") {
		t.Fatalf("the tune's answer: %+v", msg.Conversation)
	}
	hero, _ := r.peddlerAccount(playerActorID)
	before, his := hero.Balance, r.state.Inventory.Accounts[b.Account].Balance
	if err := r.buskerCommand(&pb.PocLifeCommand{Action: "busker_choice", Destination: "tip.0"}); err != nil {
		t.Fatal(err)
	}
	hero, _ = r.peddlerAccount(playerActorID)
	if hero.Balance != before-b.Hero.TipsMinor[0] || r.state.Inventory.Accounts[b.Account].Balance != his+b.Hero.TipsMinor[0] || r.state.Busker.Tips != 1 {
		t.Fatalf("tip: hero %d -> %d, his %d -> %d", before, hero.Balance, his, r.state.Inventory.Accounts[b.Account].Balance)
	}
	// no money: refused, nothing moves
	acc := r.state.Inventory.Accounts[hero.ID]
	acc.Balance = 1
	r.state.Inventory.Accounts[hero.ID] = acc
	if err := r.buskerCommand(&pb.PocLifeCommand{Action: "busker_choice", Destination: "tip.1"}); err != nil || r.state.Busker.Reply != b.Lines["no_money"] || r.state.Inventory.Accounts[hero.ID].Balance != 1 {
		t.Fatalf("tip without money: %v %q", err, r.state.Busker.Reply)
	}
	if err := r.buskerCommand(&pb.PocLifeCommand{Action: "busker_choice", Destination: "listen"}); err != nil {
		t.Fatal(err)
	}
	r.buskerHero()
	msg = &pb.PocGameState{}
	r.appendBuskerConversation(msg, "ru")
	if msg.Conversation != nil {
		t.Fatal("the conversation reopened after «listen» while he still stands there")
	}
	// he walks off and comes back: it opens again
	peddlerPlace(t, r, playerActorID, invCell(buskerCell{X: b.Spot.Seat.X - b.Hero.LeaveCells - 3, Y: b.Spot.Seat.Y}))
	r.buskerHero()
	peddlerPlace(t, r, playerActorID, invCell(pay))
	r.buskerHero()
	msg = &pb.PocGameState{}
	r.appendBuskerConversation(msg, "ru")
	if msg.Conversation == nil {
		t.Fatal("no conversation on a new approach")
	}
	// a broken save is refused
	s := r.snapshotState()
	s.Busker.Phase = "dance"
	if r.validateBuskerSave(s) == nil {
		t.Fatal("a saved unknown phase accepted")
	}
}
