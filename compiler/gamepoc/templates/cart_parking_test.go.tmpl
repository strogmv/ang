			OwnerVisible bool     `json:"owner_visible"`
			HandContact  bool     `json:"hand_contact"`
			Mode         string   `json:"mode"`
			Pose         cartPose `json:"pose"`
		} `json:"carts"`
	}
	if err := json.Unmarshal([]byte(visibleRaw), &public); err != nil || len(public.Carts) != 1 || public.Carts[0].OwnerVisible || public.Carts[0].HandContact || public.Carts[0].Pose != b.Pose || public.Carts[0].Mode != "parked" {
