// Code generated by ANG. Event-time observation, not retrospective unfogging.
package poc

import "angelsdemons/server/internal/behavior"

func(r *Runtime)capturePublicCombatEvents(){r.capturePublicCombatEventsFrom(r.state.Combat)}
func(r *Runtime)capturePublicCombatEventsFrom(previous behavior.CombatState){
 poses:=map[string]behavior.Combatant{};for _,a:=range previous.Actors{poses[a.ID]=cloneCombatant(a)}
 observer,inside:=poses[playerActorID]
 if !inside{observer=behavior.Combatant{ID:playerActorID,Position:behavior.Cell{X:r.state.Player.X,Y:r.state.Player.Y}}}
 level:=r.state.Combat.LevelID;model:=r.world.Life.Locations[level];radius:=model.PlayerRangeCells;if radius<1{radius=r.world.Visibility.PlayerRange};unit:=model.CellMM;if unit<1{unit=1000}
 rules:=r.world.CombatRuntime.Rules;rules.SightRangeMM=radius*unit
 space:=r.combatSpace(r.state.Combat)
 for _,raw:=range r.state.Combat.Events{
  if raw.Sequence<=r.state.CombatPublicSeq{continue};r.state.CombatPublicSeq=raw.Sequence
  from:=poses[raw.ActorID];from.Position=raw.From
  to:=poses[raw.TargetID];to.Position=raw.To
  seenFrom:=r.currentLevel()==level&&space.ActorVisible(observer,from,rules)
  seenTo:=r.currentLevel()==level&&space.ActorVisible(observer,to,rules)
  // Apply the path's steps and stance changes in event order. Coming around
  // the corner later in this SAME command does not reveal an earlier attacker.
  if p,ok:=poses[raw.ActorID];ok{
   switch raw.Type{case "move","move_stop","roll","fall_shift":p.Position=raw.To;case "prone":p.Prone=true;p.Crouched=false;case "crouch":p.Crouched=true;p.Prone=false;case "stand":p.Prone=false;p.Crouched=false}
   poses[p.ID]=p;if p.ID==playerActorID{observer=p}
  }
  if raw.Type=="down"||raw.Type=="dead"||raw.Type=="fall"{if p,ok:=poses[raw.TargetID];ok{p.Prone=true;p.Crouched=false;poses[p.ID]=p}}
  if r.currentLevel()!=level{continue}
  // An invisible explosion victim produces no hit count, damage or sequence
  // gap on the wire. The throw/detonation itself may still be observable.
  if raw.Type=="blast_hit"&&raw.TargetID!=playerActorID&&!seenTo{continue}
  if raw.ActorID!=playerActorID&&raw.TargetID!=playerActorID&&!seenFrom&&!seenTo{continue}
  event:=raw;event.Reason="";event.AmmoSpent=0;event.MedkitsSpent=0;event.WeaponUses=0;event.ItemsSpent=0;event.ArmorBlocked=0
  if event.ActorID!=playerActorID&&!seenFrom{event.ActorID="";event.From=behavior.Cell{X:-1,Y:-1};event.ItemID=""}
  if event.TargetID!=playerActorID&&!seenTo{event.TargetID="";event.To=behavior.Cell{X:-1,Y:-1};event.Amount=0;event.Hit=false;event.BodyPart=""}
  if event.TargetID!=playerActorID {switch event.Type{case "wound","condition","blocked","down","dead","weak","confused","care_done","stopped":event.ItemID=""}}
  r.state.CombatPublicSerial++;event.Sequence=r.state.CombatPublicSerial
  r.state.CombatPublicEvents=append(r.state.CombatPublicEvents,event)
  if len(r.state.CombatPublicEvents)>64{r.state.CombatPublicEvents=append([]behavior.CombatEvent(nil),r.state.CombatPublicEvents[len(r.state.CombatPublicEvents)-64:]...)}
 }
}

// Reuse the physical combat poses for the ordinary SceneAgents projection too;
// hiding only the combat panel would still expose the prone enemy in the world.
func(r *Runtime)combatPoseSight(from,to point,radius int)(bool,bool){
 if !r.state.Combat.Active||r.state.Combat.LevelID!=r.currentLevel(){return false,false}
 var target *behavior.Combatant
 for i:=range r.state.Combat.Actors{if r.state.Combat.Actors[i].Position==(behavior.Cell{X:to.X,Y:to.Y}){target=&r.state.Combat.Actors[i];break}}
 if target==nil{return false,false}
 observer:=behavior.Combatant{Position:behavior.Cell{X:from.X,Y:from.Y}}
 for _,a:=range r.state.Combat.Actors{if a.Position==observer.Position{observer=cloneCombatant(a);break}}
 unit:=r.world.Life.Locations[r.currentLevel()].CellMM;if unit<1{unit=1000};rules:=r.world.CombatRuntime.Rules;rules.SightRangeMM=radius*unit
 return r.combatSpace(r.state.Combat).ActorVisible(observer,*target,rules),true
}
