  Vector3 CombatMissSide(Vector3 toVictim){var side=Vector3.Cross(Vector3.up,toVictim).normalized;var toCamera=locationSDKCamera!=null?-locationSDKCamera.transform.forward:Vector3.back;toCamera.y=0;return Vector3.Dot(side,toCamera)>=0?side:-side;}
  // Per-frame IK of one body besides the strike: the free hand on the wound, the pinned feet.
  void CombatBodyIK(LocationSDKHumanoid h,PocCombatContactRig rig,PocCombatLook look){
   CombatBody body;if(!combatBodies.TryGetValue(h.id,out body)){rig.clutch.weight=0;rig.legL.weight=0;rig.legR.weight=0;rig.hipsShift.weight=0;return;}
   float now=CombatNow;
   // the hips give way, the root stays on the server's cell
   if(now>body.shiftUntil)body.shift=Vector3.zero;if(body.shift.sqrMagnitude>1e-8f){var hb=h.animator.GetBoneTransform(HumanBodyBones.Hips);var hd=rig.hipsShift.data;hd.position=hb.position+body.shift;rig.hipsShift.data=hd;rig.hipsShift.weight=1;
    if(body.leanDeg>0){var chest=rig.torso.data.constrainedObject;var flat=body.shift;flat.y=0;if(chest!=null&&flat.sqrMagnitude>1e-6f){var td=rig.torso.data;td.rotation=(Quaternion.AngleAxis(body.leanDeg*Mathf.Clamp01(flat.magnitude/.12f),Vector3.Cross(Vector3.up,flat.normalized))*chest.rotation).eulerAngles;rig.torso.data=td;rig.torso.weight=1;}}
