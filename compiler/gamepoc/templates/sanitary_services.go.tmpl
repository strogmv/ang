}
func (r *Runtime) sanitaryCommand(q *pb.PocLifeCommand) error {
	defer r.syncLifeHero()
	if !r.state.Active || !r.state.Life.Enabled || r.state.Paused {
		return textError{Key: "sanitary.error.unavailable"}
	}
	switch q.Action {
	case "sanitary_request":
		return r.sanitaryRequest(playerActorID, q.Destination)
	case "sanitary_cancel":
		p, ok := r.state.Sanitary.Users[playerActorID]
		if !ok {
			return nil
		}
		u := r.world.SanitaryServices.unit(p.UnitID)
		switch p.Phase {
		case "queued", "approach", "opening":
			if p.Phase != "queued" {
				r.sanitaryDoorTarget(*u, 0)
			}
			r.sanitaryRelease(playerActorID)
			return nil
		case "using":
			r.sanitaryDoorTarget(*u, 1)
			r.sanitaryPhase(&p, "opening_exit", r.world.SanitaryServices.DoorSeconds)
			r.state.Sanitary.Users[playerActorID] = p
			return nil
		}
		return textError{Key: "sanitary.error.busy"}
	}
	return textError{Key: "sanitary.error.unavailable"}
}
func (r *Runtime) advanceSanitaryServices() error {
	cfg := r.world.SanitaryServices
	if cfg == nil || r.state.Paused {
		return nil
	}
	ids := make([]string, 0, len(r.state.Sanitary.Users))
	for id := range r.state.Sanitary.Users {
		ids = append(ids, id)
	}
	sort.Slice(ids, func(i, j int) bool {
		return r.state.Sanitary.Users[ids[i]].Serial < r.state.Sanitary.Users[ids[j]].Serial
	})
	for _, id := range ids {
		p := r.state.Sanitary.Users[id]
		u := cfg.unit(p.UnitID)
		a := r.state.Life.Actor(id)
		if u == nil || a == nil {
			return fmt.Errorf("orphan sanitary user")
		}
		now := r.simNS()
		delta := r.state.Life.Seconds - p.LastSecond
		if delta < 0 {
			return fmt.Errorf("sanitary clock reversed")
		}
		recoverSeconds := int64(0)
		if p.Phase == "using" && cfg.ServiceAvailable {
			elapsed := min(delta, u.ServiceSeconds-p.UseElapsed)
			if elapsed < 0 {
				return fmt.Errorf("sanitary overrun")
			}
			p.UseElapsed += elapsed
			if u.Kind != "wc" {
				recoverSeconds = elapsed
			}
			water := int64(0)
			if u.Kind == "wc" {
				if p.UseElapsed == u.ServiceSeconds && p.WaterML == 0 {
					water = u.WaterML
				}
			} else {
				n := u.WaterML*elapsed + p.WaterRemainder
				water = n / u.ServiceSeconds
				p.WaterRemainder = n % u.ServiceSeconds
			}
			if r.state.Sanitary.WaterML == nil {
				r.state.Sanitary.WaterML = map[string]int64{}
			}
			if r.state.Sanitary.WaterML[u.ID] > 9000000000000000-water {
				return fmt.Errorf("sanitary meter overflow")
			}
			r.state.Sanitary.WaterML[u.ID] += water
			p.WaterML += water
		}
		if p.Phase != "approach" {
			a.Brain.AdvanceServiceNeeds(r.world.Life.Brain, id, r.state.Life.Seconds, r.state.Seed, recoverSeconds)
		}
		p.LastSecond = r.state.Life.Seconds
		if p.ReturnBySecond > 0 && r.state.Life.Seconds >= p.ReturnBySecond && (p.Phase == "queued" || p.Phase == "approach") {
			r.sanitaryRelease(id)
			continue
		}
		if (p.Phase == "queued" || p.Phase == "approach") && r.state.Life.Seconds-p.RequestedSecond >= u.MaxWaitSeconds {
			r.sanitaryRelease(id)
			continue
		}
		switch p.Phase {
		case "queued":
			if r.sanitaryQueueHead(p) && !r.sanitaryBusy(u.ID, id) {
				_ = r.sanitaryApproach(&p, *u) // A blocked doorway keeps the FIFO lease until its deadline.
			}
		case "approach":
			if a.Position == u.EntryCell && len(a.Path) == 0 && (a.Body == nil || !a.Body.Moving) {
				a.Body = nil
				a.CombatHold = true
				a.OverrideLevel = ""
				a.OverrideEdge = ""
				r.sanitaryDoorTarget(*u, 1)
				r.sanitaryPhase(&p, "opening", cfg.DoorSeconds)
			}
		case "opening":
			if now >= p.PhaseEndNS {
				a.ServiceAttachment = u.ID
				r.sanitaryPhase(&p, "entry", cfg.EntrySeconds)
			}
		case "entry":
			if now >= p.PhaseEndNS {
				r.sanitaryDoorTarget(*u, 0)
				r.sanitaryPhase(&p, "sealing", cfg.DoorSeconds)
			}
		case "sealing":
			if now >= p.PhaseEndNS {
				r.sanitaryPhase(&p, "using", 0)
			}
		case "using":
			if p.ReturnBySecond > 0 && r.state.Life.Seconds >= p.ReturnBySecond && p.UseElapsed < u.ServiceSeconds {
				r.sanitaryDoorTarget(*u, 1)
				r.sanitaryPhase(&p, "opening_exit", cfg.DoorSeconds)
				break
			}
			if p.UseElapsed >= u.ServiceSeconds {
				if r.state.Sanitary.Completed == nil {
					r.state.Sanitary.Completed = map[string]uint64{}
				}
				r.state.Sanitary.Completed[u.ID]++
				r.sanitaryDoorTarget(*u, 1)
				r.sanitaryPhase(&p, "opening_exit", cfg.DoorSeconds)
			}
		case "opening_exit":
			if now >= p.PhaseEndNS && r.sanitaryExitReady(&p, *u) {
				r.sanitaryPhase(&p, "exit", cfg.ExitSeconds)
			}
		case "exit":
			if now >= p.PhaseEndNS {
				if !r.sanitaryExitReady(&p, *u) {
					r.sanitaryPhase(&p, "opening_exit", 0)
					p.ExitBlocked = true
				} else {
					a.ServiceAttachment = ""
					a.Position = u.EntryCell
					r.sanitaryDoorTarget(*u, 0)
					r.sanitaryPhase(&p, "closing", cfg.DoorSeconds)
				}
			}
		case "closing":
			if now >= p.PhaseEndNS {
				r.sanitaryRelease(id)
				continue
			}
		default:
			return fmt.Errorf("unknown sanitary phase")
		}
		r.state.Sanitary.Users[id] = p
	}
	r.sanitaryHoldUsers()
	r.sanitaryNPCRequests()
	return nil
}
func (r *Runtime) sanitaryNPCRequests() {
	cfg := r.world.SanitaryServices
	if cfg == nil || !cfg.NPCHygiene {
		return
	}
	for _, a := range r.state.Life.Actors {
		if a.ID == playerActorID || a.Manual || !a.OnFloor() || a.CombatHold || r.serviceReserved(a.ID) || a.Brain.Place.ID != cfg.ManagedAffordance {
			continue
		}
		units := append([]sanitaryUnit(nil), cfg.Units...)
		sort.SliceStable(units, func(i, j int) bool { return !r.sanitaryBusy(units[i].ID, a.ID) && r.sanitaryBusy(units[j].ID, a.ID) })
		for _, u := range units {
			if cfg.ServiceAvailable && u.Kind != "wc" && u.LevelID == a.Level {
				if a.Brain.BreakKind == "hygiene" {
					travel := r.state.Life.StaticTravelSeconds(r.world.Life, a.Level, a.Position, u.EntryCell)
					physical := int64(math.Ceil((cfg.EntrySeconds+cfg.ExitSeconds+4*cfg.DoorSeconds)*float64(r.world.Config.TickHz))) * r.state.Life.SecondsPerTick
					if travel < 0 || r.sanitaryBusy(u.ID, a.ID) || r.state.Life.Seconds+2*travel+physical+u.ServiceSeconds > a.Brain.BreakReturnAt {
						continue
					}
				}
				if r.sanitaryRequest(a.ID, u.ID) == nil {
					break
				}
			}
		}
		// No physical provider fits this already bounded duty break. Continue
		// through the ordinary return route instead of waiting at a wall.
		if !r.sanitaryReserved(a.ID) && a.Brain.BreakKind == "hygiene" {
			owner := r.state.Life.Actor(a.ID)
			owner.Brain.Returning = true
			owner.Brain.NextDecision = 0
		}
	}
}

func (r *Runtime) sanitaryQueueHead(p sanitaryUser) bool {
	for _, other := range r.state.Sanitary.Users {
		if other.UnitID == p.UnitID && other.Serial < p.Serial {
			return false
		}
	}
	return true
}
