// An open column holds the world outside combat. In a fight the view may be
// republished every tick, but the previews change only with their inputs.
func (r *Runtime) appendOpenDress(c *connection, msg *pb.PocGameState) {
	if !r.dressOpen(c) || msg.Inventory == nil {
		return
	}
	key := dressViewKey{
		revision: r.state.Inventory.Revision,
		epoch:    r.state.Epoch, locale: c.locale, level: r.currentLevel(), position: r.state.Player,
		fighting: r.heroInCombat(), paused: r.state.Paused, captured: r.state.Demo.Captured,
	}
	if key.fighting {
		key.turn = r.state.Combat.Turn
		hero := r.state.Combat.Actor(playerActorID)
		key.ap, key.able, key.canHold = hero.AP, hero.Able(), hero.BodyCanHold
	}
	if c.dressView != nil && c.dressKey == key {
		msg.Inventory.Dress = c.dressView
		return
	}
	r.appendDress(msg.Inventory, c.locale)
	r.appendDressCraft(msg, c.locale)
	c.dressKey, c.dressView = key, msg.Inventory.Dress
}

func (r *Runtime) appendDress(view *pb.PocInventoryView, locale string) {
	s := r.state.Inventory
	m := r.world.Inventory
	before := r.dressEffects(s, inv.Item{})
	d := &pb.PocDressView{WeightLine: r.dressWeight(locale, before), MassG: before.mass, NoisePermille: int32(before.noise)}
	noiseKey := "step_quiet"
	if before.noise > 1000 { noiseKey = "step_loud" }
	d.NoiseLine = r.dressText(locale, noiseKey)
	if r.heroInCombat() {
		d.Turn = r.state.Combat.Turn
	}
	if before.caste != "" {
		identity := r.accessZoneCaste(playerActorID)
		key := "caste"
		if identity != "" && identity != before.caste {
			key = "caste_other"
		}
		d.CasteLine = fmt.Sprintf(r.dressText(locale, key), r.dressText(locale, "caste_tag."+before.caste))
	}
	groups := map[string]*pb.PocDressGroup{}
	for _, id := range []string{"worn", heroBelt, heroPockets, heroBackpack, "nearby"} {
		group := &pb.PocDressGroup{Id: id, Label: r.dressText(locale, id)}
		groups[id] = group
		d.Groups = append(d.Groups, group)
	}
	worn := map[string]*pb.PocDressRow{}
	for _, v := range view.Items {
		i := s.Items[v.Id]
		if r.combatLoadedContainer(s, i) {
			continue
		}
		if !v.Carried && (!v.CanTake || i.Location.Kind != "ground") {
			continue
		}
		row := r.dressRow(locale, i, before, d.Turn)
		if dressWorn(i) {
			worn[i.Location.Slot] = row
			continue
		}
		group := "nearby"
		if v.Carried {
			group = r.dressGroup(s, i)
		}
		groups[group].Rows = append(groups[group].Rows, row)
	}
	for _, slot := range m.Dress.Slots {
		row := worn[slot.ID]
		if row == nil {
			row = &pb.PocDressRow{Label: r.dressText(locale, "empty")}
		}
		row.SlotLabel = r.localText(locale, slot.Label, slot.ID)
		groups["worn"].Rows = append(groups["worn"].Rows, row)
	}
	beltRows := map[string]*pb.PocDressRow{}
	for _, row := range groups[heroBelt].Rows {
		beltRows[row.Id] = row
	}
	groups[heroBelt].Rows = nil
	slots, _ := r.chipHudItemSlots()
	for _, id := range slots {
		row := beltRows[id]
		if row == nil {
			row = &pb.PocDressRow{Label: r.dressText(locale, "empty")}
		}
		groups[heroBelt].Rows = append(groups[heroBelt].Rows, row)
	}
	for _, id := range []string{heroPockets, heroBackpack, "nearby"} {
		group := groups[id]
		sort.SliceStable(group.Rows, func(i, j int) bool {
			a, b := s.Items[group.Rows[i].Id], s.Items[group.Rows[j].Id]
			pa, pb := m.Definitions[a.Definition].Purpose, m.Definitions[b.Definition].Purpose
			if pa != pb {
				return pa < pb
			}
			return group.Rows[i].Label < group.Rows[j].Label
		})
		counts := map[string]int64{}
		for _, row := range group.Rows {
			counts[row.PurposeId] += row.Quantity
		}
		for _, row := range group.Rows {
			row.SectionLine = fmt.Sprintf(r.dressText(locale, "section"), row.Purpose, counts[row.PurposeId])
		}
	}
	for _, id := range []string{heroBelt, heroPockets} {
		group := groups[id]
		capacity := s.Stores[inv.DressStore(playerActorID, id)].Capacity
		count := len(group.Rows)
		if id == heroBelt {
			count = len(beltRows)
		}
		group.CapacityLine = fmt.Sprintf(r.dressText(locale, "count"), count, capacity.Stacks)
	}
	if pack := r.dressPack(s); pack != "" {
		group := groups[heroBackpack]
		group.CapacityLine = fmt.Sprintf(r.dressText(locale, "volume"), float64(s.Stores[pack].Capacity.Volume)/1000)
	}
	view.Dress = d
}

// Use the same visibility and affordability as the existing crafting screen.
func (r *Runtime) appendDressCraft(msg *pb.PocGameState, locale string) {
	if msg.Crafting == nil {
		return
	}
	view := msg.Inventory.Dress
	view.RecipesLabel = r.dressText(locale, "recipes")
	if found := r.state.Crafting.LastSalvage; found != nil {
		parts := make([]string, 0, len(*found))
		for _, part := range *found {
			parts = append(parts, fmt.Sprintf("%s ×%d", r.craftingItemName(locale, part.Definition), part.Quantity))
		}
		if len(parts) == 0 {
			parts = append(parts, r.dressText(locale, "salvage_empty"))
		}
		view.SalvageResult = fmt.Sprintf(r.dressText(locale, "salvage_result"), strings.Join(parts, ", "))
	}
	things := make(map[string]*pb.PocCraftingThing, len(msg.Crafting.Things))
	for _, thing := range msg.Crafting.Things {
		things[thing.ItemId] = thing
	}
	for _, group := range view.Groups {
		for _, row := range group.Rows {
			if row.Id == "" {
				continue
			}
			item := r.state.Inventory.Items[row.Id]
			r.dressCraftRow(locale, row, item, things[item.ID], msg.Crafting.Busy)
			if r.heroInCombat() {
				available := row.Actions[:0]
				for _, action := range row.Actions { if action.Refusal == "" { available = append(available, action) } }
				row.Actions = available
			}
		}
	}
}

func (r *Runtime) dressCraftRow(locale string, row *pb.PocDressRow, item inv.Item, view *pb.PocCraftingThing, busy bool) {
	m := r.world.Crafting
	w := r.craftingWorker(m.Hero.Actor)
	part, _, component := m.PartOf(item.Definition)
	var wanted, yields []string
	var bookRecipe string
	for _, recipe := range m.Recipes {
		if m.Knows(w, recipe) {
			for _, input := range recipe.Inputs {
				if input.Item == item.Definition || (component && input.Class == part.ID) {
					wanted = append(wanted, r.craftingText(locale, recipe.Name))
					if bookRecipe == "" && (recipe.Kind == "craft" || recipe.Heirloom) {
						bookRecipe = recipe.ID
					}
					break
				}
			}
		}
		if recipe.Kind != "disassemble" || recipe.Target != item.Definition {
			continue
		}
		yields = append(yields, r.dressSalvageHint(locale, recipe, w))
		if view == nil || !m.Open(w, recipe) {
			continue
		}
		for _, projected := range view.Actions {
			if projected.Id != recipe.ID {
				continue
			}
			price := []string{fmt.Sprintf(r.dressText(locale, "craft_minutes"), projected.Minutes), projected.Legal}
			price = append(price, projected.Tools...)
			for _, condition := range []string{projected.Station, projected.Rent} {
				if condition != "" {
					price = append(price, condition)
				}
			}
			action := &pb.PocDressAction{Id: "salvage", RecipeId: recipe.ID, Label: r.craftingText(locale, "ui.crafting.disassemble"),
				PriceLine: strings.Join(price, " · "), Refusal: projected.Reason}
			if r.state.Paused || r.heroInCombat() || r.craftingHero() == nil {
				action.Refusal = r.craftingText(locale, "crafting.error.blocked")
			} else if busy {
				action.Refusal = r.craftingText(locale, "crafting.error.busy")
			}
			row.Actions = append(row.Actions, action)
		}
	}
	row.MayContain = strings.Join(yields, " · ")
	if len(wanted) > 0 {
		row.WantedBy = fmt.Sprintf(r.dressText(locale, "wanted"), strings.Join(wanted, ", "))
		if bookRecipe != "" {
			row.Actions = append(row.Actions, &pb.PocDressAction{Id: "recipes", RecipeId: bookRecipe, Label: r.dressText(locale, "make")})
		}
	}
}

func (r *Runtime) dressSalvageHint(locale string, recipe crafting.Recipe, w crafting.Worker) string {
	m := r.world.Crafting
	if m.Knows(w, recipe) && m.TierOf(w, recipe.Discipline) >= recipe.Tier {
		parts := make([]string, 0, len(recipe.Yields))
		for _, y := range recipe.Yields {
			part, _ := m.Part(y.Class)
			parts = append(parts, fmt.Sprintf("%s ×%d–%d", r.craftingText(locale, part.Name), y.Min, y.Max))
		}
		return fmt.Sprintf(r.dressText(locale, "salvage_yields"), strings.Join(parts, ", "))
	}
	if m.Open(w, recipe) {
		return fmt.Sprintf(r.dressText(locale, "salvage_likely"), r.craftingText(locale, recipe.Hint))
	}
	return r.dressText(locale, "salvage_unknown")
}
