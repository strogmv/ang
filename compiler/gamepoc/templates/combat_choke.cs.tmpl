 }
 public sealed partial class AngelsDemonsPoc {
  bool CombatChokeMode(PocCombatLook look,string mode){if(look==null||look.choke==null||look.choke.modes==null)return false;foreach(var m in look.choke.modes)if(m==mode)return true;return false;}
  // The hold event says how it ended and on which second the body went limp: "completed:9".
  void CombatChokeHoldEvent(CombatBeat b,string mark){var p=(mark??"").Split(':');b.chokeEnd=p.Length>0?p[0]:"";int limp;if(p.Length>1&&int.TryParse(p[1],out limp))b.limpS=limp;}
  void CombatChokeBegin(CombatBeat b,PocCombatLook look){
   var th=look.choke;var v=CombatHumanoid(b.target);var a=CombatHumanoid(b.actor);Vector3 vAt,aAt;if(!LocationSDKNavToWorld(b.to.x,b.to.y,out vAt))vAt=v.go.transform.position;if(!LocationSDKNavToWorld(b.from.x,b.from.y,out aAt))aAt=a.go.transform.position;
   float yaw=v!=null&&v.hasYaw?v.yaw:Mathf.Atan2(vAt.x-aAt.x,vAt.z-aAt.z)*Mathf.Rad2Deg;var fwd=Quaternion.Euler(0,yaw,0)*Vector3.forward;
   b.pairYaw=yaw;b.pairV=vAt;b.pairS=vAt-fwd*th.start_m;b.pairC1=vAt-fwd*th.end_m;
   var gap=aAt-b.pairS;gap.y=0;b.fill=gap.magnitude>.04f?gap.magnitude/Mathf.Max(.3f,th.fill_mps):0;
   int held=Mathf.Max(1,b.holdS);if(b.limpS<1)b.limpS=held;
   b.take=b.fromCrouch?th.take_crouch_s:th.take_stand_s;b.holdT=Mathf.Min(held,b.limpS);b.chokeWait=b.holdDone&&held>b.limpS?(held-b.limpS)/Mathf.Max(1f,th.limp_wait_rate):0;b.lowerT=b.holdDone?th.lower_s:th.free_s;
   b.seconds=b.fill+b.take+b.holdT+b.chokeWait+b.lowerT;b.impact=.5f;b.clip=b.fromCrouch?th.attacker_crouch:th.attacker_stand;b.reaction=th.victim;
   CombatBodyOf(b.actor).ease=Vector3.zero;CombatBodyOf(b.target).ease=Vector3.zero;
   if(!string.IsNullOrEmpty(b.thirdId)){Vector3 c0,c1;if(LocationSDKNavToWorld(b.thirdFrom.x,b.thirdFrom.y,out c0)&&LocationSDKNavToWorld(b.thirdTo.x,b.thirdTo.y,out c1)){b.thirdA=c0;b.thirdB=c1;b.thirdWalk=Vector3.Distance(c0,c1)/Mathf.Max(.3f,look.move_mps);}}
  }
  // Seconds into the lower clip, without the wait of a long hold.
  float CombatChokeLower(CombatBeat b,PocCombatChoke th,float tt){float x=tt-b.take-b.holdT;if(b.chokeWait<=0||x<th.limp_wait_at_s)return x;if(x<th.limp_wait_at_s+b.chokeWait)return th.limp_wait_at_s;return x-b.chokeWait;}
  void CombatChokePresent(LocationSDKHumanoid h,string id,CombatBeat b,PocCombatLook look,float t,ref Vector3 at,ref float yawTo,ref PocCombatClip clip,ref float clipTime,ref bool walking,ref string want,ref float turnRate){
   var th=look.choke;float tt=t-b.fill;
   if(id==b.thirdId){
    // He walks up while the hold lasts; the seconds of the walk are the ones the server counted.
    float start=b.take+b.holdT-b.thirdWalk;float u=Mathf.Clamp01((tt-start)/Mathf.Max(.05f,b.thirdWalk));at=Vector3.Lerp(b.thirdA,b.thirdB,u);var d=b.thirdB-b.thirdA;if(d.sqrMagnitude>1e-4f)yawTo=Mathf.Atan2(d.x,d.z)*Mathf.Rad2Deg;if(u>0&&u<1){walking=true;want=locationSDKHumanoidCast.walk_state;}return;
   }
   if(b.actor==id&&!b.fadeA){b.fadeA=true;want=b.fromCrouch&&!string.IsNullOrEmpty(locationSDKHumanoidCast.crouch_idle_state)?locationSDKHumanoidCast.crouch_idle_state:locationSDKHumanoidCast.idle_state;yawTo=h.yaw;return;}
   if(b.target==id&&!b.fadeV){b.fadeV=true;want=locationSDKHumanoidCast.idle_state;yawTo=b.pairYaw;h.yaw=b.pairYaw;at=b.pairV;return;}
   if(b.actor==id){
    if(t<b.fill){Vector3 a0;if(!LocationSDKNavToWorld(b.from.x,b.from.y,out a0))a0=at;at=Vector3.Lerp(a0,b.pairS,t/Mathf.Max(.01f,b.fill));var d=b.pairS-a0;if(d.sqrMagnitude>1e-4f)yawTo=Mathf.Atan2(d.x,d.z)*Mathf.Rad2Deg;walking=true;want=b.fromCrouch&&!string.IsNullOrEmpty(locationSDKHumanoidCast.crouch_walk_state)?locationSDKHumanoidCast.crouch_walk_state:locationSDKHumanoidCast.walk_state;return;}
    yawTo=b.pairYaw;turnRate=th.turn_dps;float takeS=b.fromCrouch?th.take_crouch_s:th.take_stand_s;float total=takeS+th.hold_s;
    if(tt<b.take+b.holdT){at=b.pairS;clip=b.fromCrouch?th.attacker_crouch:th.attacker_stand;clipTime=tt<b.take?tt/b.take*(takeS/total):(takeS+(tt-b.take)/Mathf.Max(1,b.limpS)*th.hold_s)/total;}
    else{Vector3 cell;bool hasCell=LocationSDKNavToWorld(b.endCell.x,b.endCell.y,out cell);
     if(b.holdDone){at=b.pairC1;clip=th.attacker_lower;clipTime=Mathf.Clamp01(CombatChokeLower(b,th,tt)/th.lower_s);if(h.state!=clip.state)h.state=null;if(hasCell)at+=(cell-b.pairC1)*CombatSmooth(clipTime);}
     else{clip=th.attacker_free;clipTime=Mathf.Clamp01((tt-b.take-b.holdT)/Mathf.Max(.01f,th.free_s));at=Vector3.Lerp(b.pairS,hasCell?cell:b.pairC1,CombatSmooth(clipTime));}}
   }else if(b.target==id){
    yawTo=b.pairYaw;h.yaw=b.pairYaw;at=b.pairV;clip=th.victim;float total=th.victim_take_s+th.hold_s+th.lower_s;
    if(tt<b.take)clipTime=Mathf.Clamp01(tt/b.take)*(th.victim_take_s/total);
    else if(tt<b.take+b.holdT)clipTime=(th.victim_take_s+(tt-b.take)/Mathf.Max(1,b.limpS)*th.hold_s)/total;
    else if(b.holdDone)clipTime=(th.victim_take_s+th.hold_s+Mathf.Clamp01(CombatChokeLower(b,th,tt)/th.lower_s)*th.lower_s)/total;
    else{clip=th.victim_free;clipTime=Mathf.Clamp01((tt-b.take-b.holdT)/Mathf.Max(.01f,th.free_s));}
   }
  }
  void CombatChokeFx(CombatBeat b,float t){
   var look=CombatLook();var th=look==null?null:look.choke;if(th==null)return;float tt=t-b.fill;var s=th.sound;
   if(!b.fxDone&&tt>=b.take){b.fxDone=true;NoiseWaveRelease(b.sequence);CombatAutoImpact(b.actor,b.target,b.hit,b.from,b.to);if(s!=null)CombatPairSound(s.grab,b);b.chokeNextSound=b.take+.6f;}
   // he fights for air: the sound comes less often and quieter as the strength goes (the file is chosen by data, the volume by how much of it is left)
   if(s!=null&&s.struggle!=null&&b.fxDone&&tt<b.take+b.holdT&&tt>=b.chokeNextSound){float left=1-Mathf.Clamp01((tt-b.take)/Mathf.Max(1,b.limpS));b.chokeNextSound=tt+th.sound_every_s*(1.6f-.6f*left);if(left>.12f)CombatPairSoundAt(s.struggle,b,.45f+.55f*left);}
   if(!b.pairKo&&tt>=b.take+b.holdT){b.pairKo=true;var vb=CombatBodyOf(b.target);vb.held=CombatHeld(b.target);
    if(b.holdDone){CombatFloat(b.target,L("ui.combat.choke.limp"),new Color(1f,.85f,.35f));if(s!=null)CombatPairSound(s.limp,b);CombatAutoShotLater("knocked-out");if(b.chokeWait>0)CombatFloat(b.actor,L("ui.combat.choke.holding"),new Color(1f,.6f,.4f),.9f);}
    else{CombatFloat(b.target,L(b.chokeEnd=="broke_free"?"ui.combat.choke.free":"ui.combat.choke.interrupted"),new Color(.95f,.85f,.6f));if(s!=null)CombatPairSound(s.free,b);CombatAutoShotLater("broke-free");}}
   if(!b.pairBody&&b.holdDone&&tt>=b.take+b.holdT&&CombatChokeLower(b,th,tt)>=th.fall_thud_s){b.pairBody=true;CombatPairSound(th.sound_fall,b);}
   if(t>=b.seconds-CombatDt*1.5f&&b.holdDone){var vb=CombatBodyOf(b.target);vb.wasDown=true;vb.fallAt=CombatNow-1000;if(string.IsNullOrEmpty(vb.fallStyle))vb.fallStyle="choke";}
  }
  void CombatPairSoundAt(PocCombatSoundCue cue,CombatBeat b,float share){if(cue==null)return;var quiet=new PocCombatSoundCue{key=cue.key,clip=cue.clip,volume=cue.volume*share};CombatPairSound(quiet,b);}
  static Quaternion CombatHandGoal(Transform hand,Transform mid,Transform index,Transform little,bool right,Vector3 F,Vector3 Pl){
   Vector3 f=mid.position-hand.position;f.Normalize();Vector3 side=index.position-little.position;side-=Vector3.Dot(side,f)*f;side.Normalize();Vector3 palm=(right?Vector3.Cross(f,side):Vector3.Cross(side,f)).normalized;
   Pl=(Pl-Vector3.Dot(Pl,F)*F).normalized;return Quaternion.LookRotation(F,Pl)*Quaternion.Inverse(Quaternion.LookRotation(f,palm))*hand.rotation;
  }
  // The holder's arms on the victim's real neck; the victim's hands on the holder's forearm. Both from the same points, so the order of the two bodies does not matter.
  void CombatChokeIK(CombatBeat b,LocationSDKHumanoid h,PocCombatContactRig rig,PocCombatLook look){
   var th=look.choke;var victim=CombatHumanoid(b.target);if(victim==null||victim.animator==null)return;
   var neck=victim.animator.GetBoneTransform(HumanBodyBones.Neck);if(neck==null)return;
   // The frame of the holder's own shoulders, level: the neck may turn inside the arm, the arm belongs to the man who holds it.
   var holder=CombatHumanoid(b.actor);if(holder==null||holder.animator==null)return;var sr=holder.animator.GetBoneTransform(HumanBodyBones.RightUpperArm);var sl=holder.animator.GetBoneTransform(HumanBodyBones.LeftUpperArm);if(sr==null||sl==null)return;
   Vector3 across=sr.position-sl.position;across.y=0;if(across.sqrMagnitude<1e-5f)return;
   // Up is along his neck, so the bar stays on the front of the throat however far back he goes down.
   var vchest=victim.animator.GetBoneTransform(HumanBodyBones.Chest);Vector3 upv=vchest==null?Vector3.up:(neck.position-vchest.position).normalized;Vector3 fwdv=Vector3.Cross(across.normalized,upv);if(fwdv.sqrMagnitude<1e-4f)return;Quaternion frame=Quaternion.LookRotation(fwdv.normalized,upv);
   Func<float[],Vector3> dir=v=>(frame*PairV(v)).normalized;Func<float[],Vector3> pt=v=>neck.position+frame*PairV(v);
   float t=CombatNow-combatBeatAt-b.fill;float wIn=CombatSmooth((t-(b.take-th.grip_in_s))/Mathf.Max(.01f,th.grip_in_s));float after=t-b.take-b.holdT;
   float wOut=b.holdDone?1-CombatSmooth((CombatChokeLower(b,th,t)-th.release_at_s)/Mathf.Max(.01f,th.release_s)):1-CombatSmooth(after/.18f);float w=Mathf.Min(wIn,wOut);
   Vector3 E=pt(th.elbow_r),W=pt(th.wrist_r);var an=h.animator;
   if(b.actor==h.id){
    var rh=an.GetBoneTransform(HumanBodyBones.RightHand);var rm=an.GetBoneTransform(HumanBodyBones.RightMiddleProximal);var ri=an.GetBoneTransform(HumanBodyBones.RightIndexProximal);var rl=an.GetBoneTransform(HumanBodyBones.RightLittleProximal);
    var lh=an.GetBoneTransform(HumanBodyBones.LeftHand);var lm=an.GetBoneTransform(HumanBodyBones.LeftMiddleProximal);var li=an.GetBoneTransform(HumanBodyBones.LeftIndexProximal);var ll=an.GetBoneTransform(HumanBodyBones.LeftLittleProximal);
    if(w<=0||rh==null||rm==null||ri==null||rl==null||lh==null||lm==null||li==null||ll==null){rig.clutch.weight=0;rig.Hints(0);rig.Pose(rig.target.position,rig.target.rotation,0);return;}
    rig.armHint.position=pt(th.hint_r);rig.clutchHint.position=pt(th.hint_l);rig.Hints(w);
    // The hands come round the neck on the outside, not through it: from where the clip has them, past a point beside the throat, to the place of the hold.
    float gu=CombatSmooth((t-(b.take-th.grip_in_s))/Mathf.Max(.01f,th.grip_in_s));Vector3 Wl=pt(th.wrist_l);
    if(gu<1&&after<=0){Quaternion inv=Quaternion.Inverse(frame);if(!b.chokeFromSet){b.chokeFromSet=true;b.chokeFromR=inv*(rh.position-neck.position);b.chokeFromL=inv*(lh.position-neck.position);}
     Vector3 r0=neck.position+frame*b.chokeFromR,l0=neck.position+frame*b.chokeFromL;Vector3 r1=pt(th.via_r),l1=pt(th.via_l);W=Vector3.Lerp(Vector3.Lerp(r0,r1,gu),Vector3.Lerp(r1,W,gu),gu);Wl=Vector3.Lerp(Vector3.Lerp(l0,l1,gu),Vector3.Lerp(l1,Wl,gu),gu);w=Mathf.Min(w,CombatSmooth(gu/.3f));}
    rig.clutchGoal.SetPositionAndRotation(Wl,CombatHandGoal(lh,lm,li,ll,false,dir(th.fingers_l),dir(th.palm_l)));rig.clutch.weight=w;
    rig.Pose(W,CombatHandGoal(rh,rm,ri,rl,true,dir(th.fingers_r),dir(th.palm_r)),w);
    b.pairW=w;b.pairT=t;b.pairMouth=E;b.pairPoint=W;
    if(combatAutoDir!=null&&w>.98f)CombatChokeMeasure(b,h,victim,E,W);
    return;
   }
   // The victim: his hands come up to the forearm and stay while he has strength.
   {float share=(t-b.take)/Mathf.Max(1,b.limpS);float come=CombatSmooth((t-b.take+.25f)/Mathf.Max(.01f,th.claw_in_s));float wr=come*(1-CombatSmooth((share-th.claw_off_r[0])/Mathf.Max(.01f,th.claw_off_r[1]-th.claw_off_r[0])));float wl=come*(1-CombatSmooth((share-th.claw_off_l[0])/Mathf.Max(.01f,th.claw_off_l[1]-th.claw_off_l[0])));
    float gone=1-CombatSmooth(after/.2f);wr*=gone;wl*=gone;if(!b.holdDone&&after>0){wr=wl=gone*come;}
    var rh=an.GetBoneTransform(HumanBodyBones.RightHand);var rm=an.GetBoneTransform(HumanBodyBones.RightMiddleProximal);var ri=an.GetBoneTransform(HumanBodyBones.RightIndexProximal);var rl=an.GetBoneTransform(HumanBodyBones.RightLittleProximal);
    var lh=an.GetBoneTransform(HumanBodyBones.LeftHand);var lm=an.GetBoneTransform(HumanBodyBones.LeftMiddleProximal);var li=an.GetBoneTransform(HumanBodyBones.LeftIndexProximal);var ll=an.GetBoneTransform(HumanBodyBones.LeftLittleProximal);
    if((wr<=0&&wl<=0)||rh==null||rm==null||ri==null||rl==null||lh==null||lm==null||li==null||ll==null){rig.clutch.weight=0;rig.Hints(0);rig.Pose(rig.target.position,rig.target.rotation,0);return;}
    Vector3 up=dir(new[]{0f,1f,0f}),front=dir(new[]{0f,0f,1f});Vector3 along=(W-E).normalized;float left=1-Mathf.Clamp01(share);float wiggle=th.claw_slide_m*left*Mathf.Sin(2*Mathf.PI*th.claw_rate_hz*t);
    Vector3 cr=Vector3.Lerp(E,W,th.claw_r_at)+up*th.claw_up_m+front*th.claw_front_m+along*wiggle,cl=Vector3.Lerp(E,W,th.claw_l_at)+up*th.claw_up_m+front*th.claw_front_m-along*wiggle;
    CombatProp prop;bool hasProp=combatProps.TryGetValue(h.id,out prop)&&prop.go!=null;Quaternion lp=Quaternion.identity;Vector3 lg=Vector3.zero;if(hasProp){lp=Quaternion.Inverse(rh.rotation)*prop.go.transform.rotation;lg=Quaternion.Inverse(rh.rotation)*(prop.go.transform.position-rh.position);}
    rig.armHint.position=pt(th.claw_hint_r);rig.clutchHint.position=pt(th.claw_hint_l);rig.HintArm(true,wr);rig.HintArm(false,wl);
    rig.clutchGoal.SetPositionAndRotation(cl,CombatHandGoal(lh,lm,li,ll,false,dir(th.claw_fingers),dir(th.claw_palm)));rig.clutch.weight=wl;
    // A weapon still in his fist stays low, down by the leg: that hand is no use on the forearm. It leaves the hand when he goes limp.
    if(hasProp){rig.armHint.position=pt(th.armed_hint_r);rig.HintArm(true,come*gone);rig.Pose(pt(th.armed_r),rh.rotation,come*gone);prop.go.transform.SetPositionAndRotation(rh.position+rh.rotation*lg,rh.rotation*lp);}
    else rig.Pose(cr,CombatHandGoal(rh,rm,ri,rl,true,dir(th.claw_fingers),dir(th.claw_palm)),wr);
   }
  }
  // Review log (autoplay only): the bar of the forearm against the victim's real skin, the holder's own elbow against his point.
  internal readonly List<string> combatM4Rows=new List<string>();
  void CombatChokeMeasure(CombatBeat b,LocationSDKHumanoid a,LocationSDKHumanoid v,Vector3 E,Vector3 W){
   var el=a.animator.GetBoneTransform(HumanBodyBones.RightLowerArm);var rh=a.animator.GetBoneTransform(HumanBodyBones.RightHand);var lh=a.animator.GetBoneTransform(HumanBodyBones.LeftHand);if(el==null||rh==null||lh==null)return;
   Vector3 mid=Vector3.Lerp(el.position,rh.position,.5f);
   combatM4Rows.Add("{\"t\":"+CombatF(b.pairT)+",\"frame\":"+Time.frameCount+",\"forearm_skin\":"+CombatF(CombatHeadNeckSigned(v,mid))+",\"elbow_to_goal\":"+CombatF(Vector3.Distance(el.position,E))+",\"wrist_to_goal\":"+CombatF(Vector3.Distance(rh.position,W))+",\"hand_gap\":"+CombatF(Vector3.Distance(lh.position,rh.position))+"}");
  }
