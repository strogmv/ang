func placeTradeCustomer(t *testing.T, r *Runtime, owner string) inv.Shopfront {
	t.Helper()
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.Owner != owner {
			continue
		}
		r.state.Life.Seconds = sh.OpenSecond + 30*60
		peddlerPlace(t, r, owner, sh.Service.At)
		if err := r.advanceMarketSupply(); err != nil {
			t.Fatal(err)
		}
		anchor, err := r.state.Inventory.Root(r.inventoryModelFor(true), inv.Location{Kind: "store", Store: sh.DisplayStore})
		if err != nil {
			t.Fatal(err)
		}
		for _, at := range []inv.Cell{{X: anchor.At.X + 1, Y: anchor.At.Y}, {X: anchor.At.X - 1, Y: anchor.At.Y},
			{X: anchor.At.X, Y: anchor.At.Y + 1}, {X: anchor.At.X, Y: anchor.At.Y - 1}, anchor.At} {
			cell := behavior.Cell{X: at.X, Y: at.Y}
			if !r.world.Life.Walks(anchor.Level, cell) || slices.ContainsFunc(r.state.Life.Actors, func(a behavior.LifeActor) bool {
				return a.ID != playerActorID && a.Level == anchor.Level && a.OnFloor() && a.Position == cell
			}) {
				continue
			}
			peddlerPlace(t, r, playerActorID, at)
			if r.talkAtCounter(owner) && r.storefrontOpen(sh.ID) {
				return sh
			}
		}
		t.Fatal("test has no walkable customer cell at the counter")
	}
	t.Fatal("test stall missing")
	return inv.Shopfront{}
}

