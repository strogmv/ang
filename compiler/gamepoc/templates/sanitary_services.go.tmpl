	if !combatWounds.Status(combatBody(c)).CanWalk {
		return textError{Key: "medical.error.cannot_walk"}
	}
	count := 0
	for _, p := range r.state.Sanitary.Users {
		if p.UnitID == unit {
			count++
		}
	}
	if count >= cfg.QueueLimit || r.state.Sanitary.Serial == ^uint64(0) {
		return textError{Key: "sanitary.error.busy"}
	}
	p := sanitaryUser{ActorID: id, UnitID: unit, Serial: r.state.Sanitary.Serial + 1, PriorManual: a.Manual, RequestedSecond: r.state.Life.Seconds, LastSecond: r.state.Life.Seconds}
