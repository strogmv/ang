func gridCoverRules()CombatRules{r:=combatFixtureRules();r.Grid=CombatGridRules{1000,"orthogonal"};r.CoverRules=CombatCoverRules{HalfPenalty:.2,FullPenalty:.4,CrouchBonus:.1,ProneBonus:.2,FlankBonus:.1,RearBonus:.2,ProbeCells:2,RaysMM:[]int{450,1100,1650},HalfRays:1,FullRays:3};return r}
func TestCombatGridDerivesConnectedAreasAndKeepsNarrowPassage(t *testing.T){
 space:=combatFixtureSpace();space.CellMM=500;space.Space.Width=8;space.Space.Height=6;space.Space.Walkable=func(c Cell)bool{return c.X!=3||c.Y==2}
 r:=gridCoverRules();space.Grid=DeriveCombatGrid(space.Space,500,r.Grid,nil)
 if !space.Grid.Same(Cell{0,0},Cell{1,1})||space.Grid.Same(Cell{1,1},Cell{2,1}){t.Fatal("wrong metre groups")}
 a,b:=combatFixtureActor("a","blue",Cell{0,2}),combatFixtureActor("b","red",Cell{7,5});a.Controlled=true
 s,err:=NewCombat("grid","fixture",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)}
 at:=s.SnapCombatCell(space,r,*s.Actor("a"),Cell{6,2},true);preview:=s.MovePreview(space,r,"a",at)
 if preview.Reason!=""{t.Fatalf("narrow authored door lost: %+v",preview)}
 before:=s.Actor("a").AP;if err=s.Execute(space,r,"a",CombatAction{Type:"move",To:at});err!=nil{t.Fatal(err)}
 if s.Actor("a").AP!=before-preview.AP||s.Actor("a").Position!=at{t.Fatal("preview and execution differ")}
 if preview.AP!=3{t.Fatalf("three orthogonal metre cells cost %d AP",preview.AP)}
 // A diagonal crosses two orthogonal boundaries and never cuts a blocked corner.
 if space.moveMM(Cell{0,0},Cell{1,0})!=0||space.moveMM(Cell{1,0},Cell{2,0})!=1000{t.Fatal("wrong cell charge")}
}
