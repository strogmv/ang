func TestMedicalThreeRealPatientsWaitForOccupiedExitThenCompleteOnce(t *testing.T) {
	r := medicalFixture(t)
	var original worldData
	if err := json.Unmarshal(compiledJSON, &original); err != nil {
		t.Fatal(err)
	}
	r.world.Life.HeroBody = original.Life.HeroBody
	r.canonicalWorld.Life.HeroBody = original.Life.HeroBody
	u := r.world.MedicalCapsules.Units[0]
	medicalInjure(t, r, playerActorID, true)
	granny := medicalPlaceNPC(t, r)
	resident := "char.market_resident_01"
	a := r.state.Life.Actor(resident)
	if a == nil {
		t.Fatal("missing actual resident")
	}
	a.Level = u.LevelID
	a.Position = behavior.Cell{X: 11, Y: 70}
	a.Goal = a.Position
	a.Path = nil
	a.PendingPath = nil
	a.Trip = nil
	a.ResidenceID = ""
	a.ServiceAttachment = ""
	a.Body = nil
	a.Manual = false
	a.CombatHold = false
	a.OverrideLevel = ""
	a.OverrideEdge = ""
	a.Brain.InterruptService()
	medicalInjure(t, r, resident, true)
	r.state.Life.EnsureHeroBody(r.world.Life)
	if err := r.medicalRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	r.world.MedicalCapsules.NPCSelfCare = true
	receiverBefore := r.state.Inventory.Accounts[r.world.MedicalCapsules.ReceiverAccount].Balance
	frame := func() {
		r.state.Tick++
		if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
			t.Fatal(err)
		}
		if err := r.advanceLifeFrameBy(30); err != nil {
			t.Fatal(err)
		}
	}
	heroReleased := false
	for i := 0; i < 500; i++ {
		frame()
		if p, ok := r.state.Medical.Patients[playerActorID]; ok && p.Phase == "offer" {
			if err := r.medicalAccept(playerActorID, u.ID, p.OfferID); err != nil {
				t.Fatal(err)
			}
		}
		if !r.medicalReserved(playerActorID) && len(r.state.Medical.Receipts) >= 2 {
			heroReleased = true
			break
		}
	}
	if !heroReleased {
		t.Fatal("initial two patients did not finish canonical care")
	}
	head, ok := r.state.Medical.Patients[resident]
	if !ok || head.Phase != "queued" || head.Serial != 3 {
		t.Fatalf("occupied exit silently lost third real queued patient: %+v exists=%v", head, ok)
	}
	if !r.state.Life.BlockedCells(u.LevelID, resident)[u.ScanCell] {
		t.Fatal("fixture must have the released hero physically on scan/exit anchor")
	}
	for i := 0; i < 20; i++ {
		frame()
		p, ok := r.state.Medical.Patients[resident]
		if !ok || p.Phase != "queued" || p.Serial != head.Serial || p.LeaseUntilNS != head.LeaseUntilNS {
			t.Fatal("blocked retry abandoned reservation or renewed its FIFO/lease")
		}
	}
	slot := r.world.Config.SaveSlots[1]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	r.state = loaded
	if p := r.state.Medical.Patients[resident]; p.Phase != "queued" || p.Serial != head.Serial || r.state.Medical.NPCAttempts[resident] != medicalInjuryKey(combatBody(r.state.CombatRoster[resident])) {
		t.Fatal("save/load lost waiting reservation or attempt idempotency")
	}
	target := behavior.Cell{X: 11, Y: 66}
	before := r.state.Life.Actor(playerActorID).Position
	conn := &connection{out: make(chan *pb.ServerMessage, 32), stop: make(chan struct{})}
	r.lifeMove(conn, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1, X: int32(target.X), Y: int32(target.Y)})
	accepted := false
	for len(conn.out) > 0 {
		if result := (<-conn.out).GetMoveResult(); result != nil {
			accepted = result.Ok
		}
	}
	if !accepted || r.state.Life.Actor(playerActorID).Position != before {
		t.Fatal("ordinary MoveTo must accept an intent without teleporting hero")
	}
	cared := false
	done := false
	for i := 0; i < 500; i++ {
		frame()
		if p, ok := r.state.Medical.Patients[resident]; ok && p.Phase == "treatment" {
			cared = true
		}
		b := combatBody(r.state.CombatRoster[resident])
		if cared && !r.medicalReserved(resident) && b.Care == nil && len(b.Conditions) == 0 {
			done = true
			break
		}
	}
	if !done || r.state.Life.Actor(playerActorID).Position != target {
		t.Fatal("waiting real resident did not complete care after ordinary hero movement")
	}
	for i := 0; i < 20; i++ {
		frame()
	}
	for _, id := range []string{playerActorID, granny, resident} {
		count := 0
		for _, receipt := range r.state.Medical.Receipts {
			if receipt.ActorID == id {
				count++
			}
		}
		b := combatBody(r.state.CombatRoster[id])
		if count != 1 || b.Care != nil || len(b.Conditions) != 0 {
			t.Fatalf("patient %s not cured exactly once: receipts=%d care=%+v conditions=%+v", id, count, b.Care, b.Conditions)
		}
	}
	if len(r.state.Medical.Receipts) != 3 || r.state.Inventory.Accounts[r.world.MedicalCapsules.ReceiverAccount].Balance-receiverBefore != 900 {
		t.Fatal("three canonical300minor receipts must transfer exactly900minor")
	}
}

func TestMedicalExpiredUnusedNPCReservationCanRejoinOnce(t *testing.T) {
	r := medicalFixture(t)
	u := r.world.MedicalCapsules.Units[0]
	medicalInjure(t, r, playerActorID, true)
	if err := r.medicalRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	medicalPlaceNPC(t, r)
	id := "char.market_resident_01"
	a := r.state.Life.Actor(id)
	if a == nil {
		t.Fatal("missing real resident")
	}
	a.Level = u.LevelID
	a.Position = behavior.Cell{X: 11, Y: 70}
	a.Goal = a.Position
	a.Trip = nil
	a.ResidenceID = ""
	a.Body = nil
	a.Path = nil
	a.PendingPath = nil
	a.Manual = false
	a.CombatHold = false
	a.ServiceAttachment = ""
	medicalInjure(t, r, id, true)
	r.world.MedicalCapsules.NPCSelfCare = true
	r.medicalNPCRequests()
	first := r.state.Medical.Patients[id]
	if first.Phase != "queued" || r.state.Medical.NPCAttempts[id] != medicalInjuryKey(combatBody(r.state.CombatRoster[id])) {
		t.Fatal("real NPC did not reserve behind occupied units")
	}
	first.LeaseUntilNS = r.simNS() + 1
	r.state.Medical.Patients[id] = first
	r.state.Tick++
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		t.Fatal(err)
	}
	if err := r.advanceMedicalCapsules(); err != nil {
		t.Fatal(err)
	}
	next, ok := r.state.Medical.Patients[id]
	if !ok || next.Phase != "queued" || next.Serial <= first.Serial || next.LeaseUntilNS != r.simNS()+r.world.MedicalCapsules.LeaseSeconds*1e9 || len(r.state.Medical.Receipts) != 0 {
		t.Fatal("unused expiry permanently locked injury, renewed old reservation, or charged before care")
	}
	for i := 0; i < 4; i++ {
		r.medicalNPCRequests()
	}
	if again := r.state.Medical.Patients[id]; again.Serial != next.Serial || again.LeaseUntilNS != next.LeaseUntilNS || r.state.Medical.NPCAttempts[id] != medicalInjuryKey(combatBody(r.state.CombatRoster[id])) {
		t.Fatal("active retry reservation lost request idempotency")
	}
	younger := next
	younger.Serial++
	if !r.medicalQueuedAhead(younger) || r.medicalQueuedAhead(next) {
		t.Fatal("a later FIFO serial may not bypass a waiting head")
	}
}

func TestMedicalRepeatedConditionEpisodeAfterCureAndSavedAttempt(t *testing.T) {
	r := medicalFixture(t)
	id := medicalPlaceNPC(t, r)
	r.world.MedicalCapsules.NPCSelfCare = true
	receiver := r.world.MedicalCapsules.ReceiverAccount
	before := r.state.Inventory.Accounts[receiver].Balance
	r.medicalNPCRequests()
	first, ok := r.state.Medical.Patients[id]
	if !ok {
		t.Fatal("first real NPC incident not admitted")
	}
	firstKey := r.state.Medical.NPCAttempts[id]
	firstAt := combatBody(r.state.CombatRoster[id]).Conditions[0].At
	frame := func() {
		r.state.Tick++
		if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
			t.Fatal(err)
		}
		if err := r.advanceLifeFrameBy(30); err != nil {
			t.Fatal(err)
		}
	}
	// Apply the second canonical condition after the first is fully cured but
	// before release/healthy polling: clearing an empty-key cache alone is not enough.
	healed := false
	for i := 0; i < 400; i++ {
		frame()
		p := r.state.Medical.Patients[id]
		body := combatBody(r.state.CombatRoster[id])
		if p.Phase == "exit" && body.Care == nil && len(body.Conditions) == 0 {
			healed = true
			break
		}
	}
	if !healed || len(r.state.Medical.Receipts) != 1 || r.state.Medical.NPCAttempts[id] != firstKey {
		t.Fatal("expected first completed care with its saved incident attempt still held during exit")
	}
	c := r.state.CombatRoster[id]
	body := combatBody(c)
	if _, err := combatWounds.ApplyCondition(&body, "burn.contact", "", r.state.Seed); err != nil {
		t.Fatal(err)
	}
	if body.Conditions[0].At <= firstAt {
		t.Fatal("second incident must have a later canonical timestamp")
	}
	projectWoundBody(&c, body)
	r.state.CombatRoster[id] = c
	r.storeWoundBody(c)
	secondKey := medicalInjuryKey(body)
	if secondKey == firstKey {
		t.Fatal("new burn.contact episode reused the cured episode's attempt key")
	}
	admitted := false
	for i := 0; i < 100; i++ {
		frame()
		if p, ok := r.state.Medical.Patients[id]; ok && p.Serial > first.Serial {
			admitted = true
			break
		}
	}
	if !admitted || r.state.Medical.NPCAttempts[id] != secondKey {
		t.Fatal("new same-kind incident was permanently suppressed by old attempt")
	}
	second := r.state.Medical.Patients[id]
	slot := r.world.Config.SaveSlots[1]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	r.state = loaded
	for i := 0; i < 5; i++ {
		r.medicalNPCRequests()
	}
	if p := r.state.Medical.Patients[id]; p.Serial != second.Serial || r.state.Medical.NPCAttempts[id] != secondKey || len(r.state.Medical.Receipts) != 1 {
		t.Fatal("same saved incident lost request idempotency")
	}
	done := false
	for i := 0; i < 500; i++ {
		frame()
		body := combatBody(r.state.CombatRoster[id])
		if !r.medicalReserved(id) && body.Care == nil && len(body.Conditions) == 0 {
			done = true
			break
		}
	}
	if !done || len(r.state.Medical.Receipts) != 2 || r.state.Inventory.Accounts[receiver].Balance-before != 600 {
		t.Fatal("two real incidents must finish exactly two canonical300minor treatments")
	}
	if _, ok := r.state.Medical.NPCAttempts[id]; ok {
		t.Fatal("fully recovered eligible NPC retained stale attempt history")
	}
	for i := 0; i < 20; i++ {
		frame()
	}
	if len(r.state.Medical.Receipts) != 2 {
		t.Fatal("unchanged/healthy incident was treated repeatedly")
	}
}
