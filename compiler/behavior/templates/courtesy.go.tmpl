// Code generated by ANG. Local courtesy uses directed relations and physical traffic.
package behavior

import "fmt"

type LifeRelation struct {
 To string `json:"to"`
 Strength float64 `json:"strength"`
}
type LifeCourtesyPolicy struct {
 NoticeCells int `json:"notice_cells"`
 // Maximum extra walking cells admitted for a locally observed body detour,
 // compared with a fresh shortest route through the familiar static layout.
 // Zero preserves the default of four cells; it does not disable collisions.
 MaxDetourExtraCells int `json:"max_detour_extra_cells,omitempty"`
}

func(m LifeModel)courtesyDetourBudget()int{if m.Courtesy.MaxDetourExtraCells>0{return m.Courtesy.MaxDetourExtraCells};return 4}

// Keep short selected flanks through brief waits, but do not let a saved or
// interrupted whole-room loop become the baseline for another longer loop.
// This consults fixed layout only, never distant people or their intentions.
func(m LifeModel)controlledIntent(level string,from,to Cell,pending []Cell)[]Cell{
 baseline:=m.Space(level,nil).Path(from,to,Cell{},0)
 if len(pending)==0||len(pending)>len(baseline)+m.courtesyDetourBudget(){return baseline};return pending
}

// Relations are directed: the NPC's attitude to the controlled actor matters.
// No edge means neutral. Runtime overrides persist for named and population NPCs.
func(s LifeState)RelationTo(m LifeModel,from,to string)float64{
 if values:=s.RelationOverrides[from];values!=nil{if value,ok:=values[to];ok{return value}}
 value:=0.0
 if person:=m.Person(from);person!=nil{for _,relation:=range person.Relations{if relation.To==to{value+=relation.Strength}}}
 if value>1{return 1};if value< -1{return -1};return value
}
func(s LifeState)hasRelationActor(id string)bool{
 if id==""{return false};for _,a:=range s.Actors{if a.ID==id{return true}}
 for _,a:=range s.Population.Actors{if a.ID==id{return true}};return false
}
func(s *LifeState)SetRelation(from,to string,value float64)error{
 if !s.hasRelationActor(from)||!s.hasRelationActor(to)||!(value>=-1&&value<=1){return fmt.Errorf("invalid life relation")}
 if s.RelationOverrides==nil{s.RelationOverrides=map[string]map[string]float64{}}
 if s.RelationOverrides[from]==nil{s.RelationOverrides[from]=map[string]float64{}}
 s.RelationOverrides[from][to]=value;return nil
}
func(s LifeState)validateRelations()error{
 for from,values:=range s.RelationOverrides{if !s.hasRelationActor(from){return fmt.Errorf("unknown life relation actor")};for to,value:=range values{if !s.hasRelationActor(to)||!(value>=-1&&value<=1){return fmt.Errorf("invalid saved life relation")}}};return nil
}
func(s LifeState)cloneRelations()map[string]map[string]float64{
 if s.RelationOverrides==nil{return nil};out:=map[string]map[string]float64{}
 for from,values:=range s.RelationOverrides{if values==nil{out[from]=nil;continue};out[from]=map[string]float64{};for to,value:=range values{out[from][to]=value}};return out
}
func(s LifeState)courtesyRequester(requester string)bool{return requester!=""&&requester==s.ControlledActorID}
func(s LifeState)courtesyNamed(m LifeModel,a LifeActor,requester string,tick int64)bool{
 if !s.courtesyRequester(requester)||a.ID==requester||a.Manual||a.Trip!=nil||len(a.Path)>0||tick<a.YieldUntil||s.RelationTo(m,a.ID,requester)<=0{return false}
 switch a.Activity{case "rest","market","waiting","walking":default:return false}
 repair,assigned:=s.maintenanceStep(m,a.ID);return !assigned||a.Level!=repair.Level||a.Position!=repair.At
}
func(s LifeState)courtesyAware(m LifeModel,requester,level string,at Cell)bool{
 actor:=s.Actor(requester);if actor==nil||actor.Trip!=nil||actor.Level!=level{return false}
 radius:=m.Courtesy.NoticeCells;if radius==0{radius=2}
 if Distance(actor.Position,at)>radius||m.Space(level,nil).Blockers(actor.Position,at)!=0{return false}
 if actor.Position.X!=at.X&&actor.Position.Y!=at.Y{
  return m.Walks(level,Cell{actor.Position.X,at.Y})&&m.Walks(level,Cell{at.X,actor.Position.Y})
 };return true
}

// MoveRoute accepts an intent through the familiar static layout. Distant
// people, their jobs and their private attitudes do not change this route.
// Only the first physical step is reserved; every later step is checked again.
func(s LifeState)MoveRoute(m LifeModel,requester,level string,from,target Cell,tick int64)([]Cell,bool){
 blocked:=map[Cell]bool(nil)
 if !s.courtesyRequester(requester){blocked=s.blocked(level,requester)}
 space:=m.Space(level,blocked)
 if !space.CanStand(target){return nil,false}
 if from==target{return nil,true}
 route:=space.Path(from,target,Cell{},0);if len(route)==0{return nil,false}
 // On a redirect `from` can be the end of an already accepted segment.
 // Its following steps remain intent, even if someone unseen occupies one.
 actor:=s.Actor(requester)
 if s.courtesyRequester(requester)&&actor!=nil&&from==actor.Position&&s.occupied(level,route[0],requester){return nil,true}
 return route,true
}

// observedTraffic is local contact information, never the occupancy of a room
// hidden by fog. Attitude is deliberately absent from obstacle classification.
func(s LifeState)observedTraffic(m LifeModel,requester,level string)map[Cell]bool{
 blocked:=map[Cell]bool{}
 mark:=func(id,place string,at Cell,path []Cell){
  if id==requester||place!=level||!s.courtesyAware(m,requester,level,at){return}
  blocked[at]=true
  if len(path)>0&&s.courtesyAware(m,requester,level,path[0]){blocked[path[0]]=true}
 }
 for _,a:=range s.Actors{if a.Trip==nil{mark(a.ID,a.Level,a.Position,a.Path)}}
 for _,a:=range s.Population.Actors{if a.Materialized&&a.Trip==nil{mark(a.ID,a.Level,a.Position,a.Path)}}
 return blocked
}

// Ask only about the next two points of our own accepted intent. A positive
// directed relation and the existing local line-of-sight gate are required;
// accepted NPC segments, duties and people beyond that range stay untouched.
func(s *LifeState)anticipateControlledTraffic(m LifeModel,a *LifeActor,tick int64,yieldBudget *int){
 if a==nil||!s.courtesyRequester(a.ID)||!a.Manual||a.Trip!=nil||a.Arrived||*yieldBudget<=0{return}
 route:=a.Path;if len(route)==0{route=a.PendingPath}
 for i,at:=range route{if i>=2||*yieldBudget<=0{break};if !s.courtesyAware(m,a.ID,a.Level,at){continue}
  eligible:=false
  for _,other:=range s.Actors{if other.Level==a.Level&&other.Position==at&&s.courtesyNamed(m,other,a.ID,tick){eligible=true;break}}
  if !eligible{for _,other:=range s.Population.Actors{if other.Materialized&&other.Level==a.Level&&other.Position==at&&other.Trip==nil&&len(other.Path)==0&&tick>=other.YieldUntil&&s.RelationTo(m,other.ID,a.ID)>0{switch other.Activity{case "rest","market","waiting","waiting_departure","waiting_seat":eligible=true}}}}
  if !eligible{continue}
  // A direct empty side pocket avoids propagating an early request through an
  // unseen queue. Ordinary contact negotiation retains its existing behavior.
  pocket:=false;for _,d:=range []Cell{{0,-1},{1,0},{0,1},{-1,0}}{next:=Cell{at.X+d.X,at.Y+d.Y};if !m.Walks(a.Level,next)||s.occupied(a.Level,next,a.ID){continue};onRoute:=next==a.Position;for _,point:=range route{if point==next{onRoute=true;break}};if !onRoute{pocket=true;break}}
  if pocket&&s.yieldPopulationFor(m,a.Level,at,tick,a.ID,route...){*yieldBudget = *yieldBudget - 1}
 }
}

// Refill intent only after the blocking body has actually moved this tick.
// No second position update occurs; a new segment begins at the current tick.
func(s *LifeState)resumeControlledAfterTraffic(m LifeModel,tick int64){
 a:=s.Actor(s.ControlledActorID);if a==nil||!a.Manual||a.Trip!=nil||a.Arrived||len(a.Path)>0||len(a.PendingPath)==0{return}
 route:=m.controlledIntent(a.Level,a.Position,a.Goal,a.PendingPath);a.PendingPath=route;if len(route)==0||route[len(route)-1]!=a.Goal||Distance(a.Position,route[0])!=1||!m.Walks(a.Level,route[0])||s.occupied(a.Level,route[0],a.ID){return}
 a.Path=route;a.PendingPath=nil;a.MoveStartTick=tick;a.Activity="walking";a.Label=lifeManualMoveLabel;if a.OverrideLevel!=""{a.Label=lifeWalkingPrefix+m.Locations[a.OverrideLevel].Name}
}

// A pocket lease can be renewed briefly for the same moving visible requester,
// but never past its original hard deadline. A stopped/cancelled intent and
// a requester that already passed the contact do not renew the lease.
func(s LifeState)courtesyPocketUntil(m LifeModel,requester,level string,origin Cell,limit,tick,moveTicks int64)int64{
 if !s.courtesyRequester(requester)||limit<=tick{return 0};a:=s.Actor(requester)
 if a==nil||!a.Manual||a.Trip!=nil||a.Arrived||a.Level!=level||len(a.Path)==0||!s.courtesyAware(m,requester,level,origin){return 0}
 passing:=a.Position==origin;for i,at:=range a.Path{if i>=2{break};if at==origin{passing=true;break}}
 if !passing{return 0};until:=tick+2*moveTicks;if until>limit{until=limit};return until
}

// Contact is resolved only after reaching a blocked physical next step. A
// friendly person can yield; otherwise a local detour is attempted. The goal
// remains accepted when there is no room, so a later opening resumes movement.
func(s *LifeState)controlledRoute(m LifeModel,a *LifeActor,destination Cell,tick int64,yieldBudget *int)[]Cell{
 route:=m.controlledIntent(a.Level,a.Position,destination,a.PendingPath)
 if len(route)==0{return nil}
 next:=route[0]
 if !s.occupied(a.Level,next,a.ID){a.PendingPath=nil;return route}
 a.PendingPath=route
 // A visible person already walking across the next step is a short wait,
 // rather than a reason to discard the route and circle the whole room.
 for _,other:=range s.Actors{if other.ID!=a.ID&&other.Level==a.Level&&other.Trip==nil&&len(other.Path)>0&&(other.Position==next||other.Path[0]==next)&&s.courtesyAware(m,a.ID,a.Level,other.Position){return nil}}
 for _,other:=range s.Population.Actors{if other.Materialized&&other.Level==a.Level&&other.Trip==nil&&len(other.Path)>0&&(other.Position==next||other.Path[0]==next)&&s.courtesyAware(m,a.ID,a.Level,other.Position){return nil}}
 if *yieldBudget>0&&s.courtesyAware(m,a.ID,a.Level,next)&&s.yieldPopulationFor(m,a.Level,next,tick,a.ID,route...){*yieldBudget = *yieldBudget - 1;return nil}
 route=m.Space(a.Level,s.observedTraffic(m,a.ID,a.Level)).Path(a.Position,destination,Cell{},0)
 // A nearby stationary body cannot justify circling the whole room. Retain
 // the accepted goal and wait when no proportionate local bypass is free.
 baseline:=m.Space(a.Level,nil).Path(a.Position,destination,Cell{},0)
 if len(route)>len(baseline)+m.courtesyDetourBudget(){return nil}
 if len(route)>0&&!s.occupied(a.Level,route[0],a.ID){a.PendingPath=nil;return route}
 return nil
}
