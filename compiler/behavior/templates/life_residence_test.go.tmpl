// Code generated by ANG. Physical home thresholds, privacy and durable return.
package behavior

import("encoding/json";"reflect";"testing")
func residenceFixture()LifeModel{
 m:=lifeFixture();m.MoveTicks=1;m.Actors[0].Steps=[]LifeStep{
  {AtMinute:0,Level:"a",At:Cell{1,1},Activity:"service"},
  {AtMinute:1,Level:"a",At:Cell{3,0},Activity:"sleep"},
  {AtMinute:2,Level:"a",At:Cell{1,1},Activity:"service"},
 }
 m.Actors[1].Steps=[]LifeStep{{AtMinute:0,Level:"a",At:Cell{0,2},Activity:"rest"}}
 m.Residences=[]LifeResidence{{ID:"home.one",Level:"a",Entry:Cell{3,0},ReturnAt:Cell{3,1},Capacity:1,Residents:[]string{"one"}}}
 return m
}
func TestLifeResidencePhysicalEntryAndOccupiedReturnReplay(t *testing.T){
 m:=residenceFixture();if err:=m.Validate();err!=nil{t.Fatal(err)};s:=m.Start();s.ControlledActorID="two";s.Actor("two").Manual=true
 var replay *LifeState;entered,returned:=false,false
 for tick:=int64(1);tick<=160;tick++{
  before:=*s.Actor("one");s.Advance(m,tick)
  if replay!=nil{replay.Advance(m,tick);if !reflect.DeepEqual(s.Clone(),replay.Clone()){t.Fatalf("residence replay differs at %d",tick)}}
  a:=s.Actor("one");if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}
  if !entered&&a.ResidenceID!=""{
   if before.Position!=m.Residences[0].Entry&&Distance(before.Position,a.Position)!=1{t.Fatal("entered without a physical final step")}
   if a.Position!=m.Residences[0].Entry||a.OnFloor()||s.BlockedCells("a","two")[a.Position]||s.PopulationEnvironment().Occupied["a"][a.Position]{t.Fatal("private resident remains a body")}
   hard,residents:=s.yieldTraffic(m,"a",tick,"two");if hard[a.Position]{t.Fatal("private resident blocks courtesy")};if _,ok:=residents[a.Position];ok{t.Fatal("private resident offered for yielding")}
   entered=true
  }
  if tick==110{
   blocker:=s.Actor("two");blocker.Position=m.Residences[0].ReturnAt;blocker.Goal=blocker.Position
   b,_:=json.Marshal(s);replay=&LifeState{};if err:=json.Unmarshal(b,replay);err!=nil{t.Fatal(err)}
  }
  if tick>=120&&tick<130&&a.ResidenceID==""{t.Fatal("return ignored occupied physical landing")}
  if tick==130{for _,world:=range []*LifeState{&s,replay}{b:=world.Actor("two");b.Position=Cell{0,2};b.Goal=b.Position}}
  if entered&&tick>130&&a.OnFloor(){returned=true;if before.ResidenceID!=""&&a.Position!=m.Residences[0].ReturnAt{t.Fatal("return did not use authored landing")}}
 }
 if !entered||!returned||!s.Actor("one").Arrived||s.Actor("one").Position!=(Cell{1,1})||replay==nil{t.Fatal("home cycle incomplete")}
}
func TestLifeResidenceInitialNightAndControlledActor(t *testing.T){
 m:=residenceFixture();m.StartSeconds=90;s:=m.Start();a:=s.Actor("one")
 if a.ResidenceID!="home.one"{t.Fatal("night initialization failed")};if err:=s.Validate(m,0);err!=nil{t.Fatal(err)}
 // A new character command cannot turn a public controlled actor into a private occupant.
 a.ResidenceID="";s.ControlledActorID=a.ID
 if s.enterResidence(m,a)||a.ResidenceID!=""{t.Fatal("controlled actor automatically entered")}
 s.ControlledActorID="";a.Manual=true;if s.enterResidence(m,a){t.Fatal("manual actor automatically entered")}
 a.Manual=false;a.Activity="work";if s.enterResidence(m,a){t.Fatal("working actor disappeared into a home sleep destination")}
 s.Enabled=false;before:=s.Clone();s.Advance(m,1);if !reflect.DeepEqual(before,s.Clone()){t.Fatal("disabled simulation changed residence state")}
}
func TestLifeResidenceRejectsInvalidBindingsAndSavedOccupancy(t *testing.T){
 for _,edit:=range []func(*LifeModel){
  func(m *LifeModel){m.Residences[0].Residents=[]string{"missing"}},
  func(m *LifeModel){m.Residences[0].Residents=[]string{"one","one"};m.Residences[0].Capacity=2},
  func(m *LifeModel){m.Residences[0].ReturnAt=m.Residences[0].Entry},
  func(m *LifeModel){m.Residences[0].Entry=Cell{99,99}},
  func(m *LifeModel){m.Residences[0].ReturnAt=m.Edges[0].Exit},
  func(m *LifeModel){m.Residences[0].Capacity=0},
  func(m *LifeModel){level:=m.Locations["a"];level.Terrain=[]string{"..#..","..#..","..#.."};m.Locations["a"]=level},
  func(m *LifeModel){m.Residences[0].Residents=[]string{"two"}},
 }{m:=residenceFixture();edit(&m);if m.Validate()==nil{t.Fatal("invalid residence accepted")}}
 m:=residenceFixture();m.StartSeconds=90
 for _,edit:=range []func(*LifeState){
  func(s *LifeState){s.Actor("one").ResidenceID="unknown"},
  func(s *LifeState){s.Actor("one").Path=[]Cell{{2,0}}},
  func(s *LifeState){s.Actor("one").Position=Cell{2,0}},
  func(s *LifeState){s.ControlledActorID="one"},
  func(s *LifeState){s.Actor("one").Manual=true},
  func(s *LifeState){s.Actor("one").Step=999},
 }{s:=m.Start();edit(&s);if s.Validate(m,0)==nil{t.Fatal("invalid saved residence accepted")}}
}

func TestLifeResidenceSharedPortalSerializesReturnWithoutOverlappingBodies(t *testing.T){
 m:=residenceFixture();m.Actors[1].Steps=[]LifeStep{{AtMinute:0,Level:"a",At:Cell{0,2},Activity:"service"},{AtMinute:1,Level:"a",At:Cell{3,0},Activity:"sleep"},{AtMinute:2,Level:"a",At:Cell{0,2},Activity:"service"}}
 m.Residences[0].Capacity=2;m.Residences[0].Residents=append(m.Residences[0].Residents,"two")
 if err:=m.Validate();err!=nil{t.Fatal(err)};s:=m.Start();inside:=map[string]bool{};left:=map[string]int64{}
 for tick:=int64(1);tick<=160;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)};for _,a:=range s.Actors{if a.ResidenceID!=""{inside[a.ID]=true};if inside[a.ID]&&a.OnFloor()&&left[a.ID]==0{left[a.ID]=tick}}}
 if len(inside)!=2||len(left)!=2||left["one"]==left["two"]{t.Fatalf("shared return not serialized: inside=%v left=%v",inside,left)}
}
