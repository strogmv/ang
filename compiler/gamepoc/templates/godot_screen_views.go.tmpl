	slot.GameDay = int32(s.Life.Seconds/86400 + 1)
	slot.GameClockSeconds = int32(s.Life.Seconds % 86400)
	if hero := s.Life.Actor(playerActorID); hero != nil {
		slot.LevelId = hero.Level
