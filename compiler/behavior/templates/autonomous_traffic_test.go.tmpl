func autonomousMixedFlowAdvance(t *testing.T,m LifeModel,s *LifeState,tick int64){
 t.Helper();old:=s.Clone();s.Advance(m,tick);if err:=s.AdvancePopulation(m,"hero");err!=nil{t.Fatal(err)}
 if err:=s.Validate(m,tick);err!=nil{t.Fatalf("tick%d: %v",tick,err)}
 assertStep:=func(id string,from,to Cell,path,next []Cell,start,now,duration int64){
  if from!=to&&(Distance(from,to)!=1||tick<start+duration){t.Fatalf("tick%d autonomous %s teleported or accelerated",tick,id)}
  if len(path)>0&&tick<start+duration&&(len(next)==0||next[0]!=path[0]||now!=start){t.Fatalf("tick%d autonomous %s lost an accepted first step",tick,id)}
 }
 for i,a:=range s.Actors{b:=old.Actors[i];assertStep(a.ID,b.Position,a.Position,b.Path,a.Path,b.MoveStartTick,a.MoveStartTick,m.MoveTicks)}
 for i,a:=range s.Population.Actors{b:=old.Population.Actors[i];assertStep(a.ID,b.Position,a.Position,b.Path,a.Path,b.MoveStartTick,a.MoveStartTick,m.Population.MoveTicks)}
 before:=s.Clone();if err:=s.AdvancePopulation(m,"hero");err!=nil{t.Fatal(err)};if !reflect.DeepEqual(before,s.Clone()){t.Fatal("same-frame population retry made a second traffic decision")}
}

