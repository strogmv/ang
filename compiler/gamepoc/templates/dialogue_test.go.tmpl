func TestDialogueShownChanceIsTheRolledChance(t *testing.T) {
	r := dialogueCustody(t, nil)
	o := dialogueCheckedOption(t, r)
	row := r.world.DialogueRules.Chance[o.Check.Difficulty]
	for _, skill := range []int{0, 10, 20, 25, 33, 60, 100} {
		dialogueSetSkill(r, o.Check.Skill, skill)
		for _, locale := range []string{"ru", "en"} {
			c := dialogueOption(t, dialogueView(t, r, locale), o.ID)
			if c == nil || int(c.Chance) != row[skill] || !strings.Contains(c.CheckLabel, strconv.Itoa(row[skill])) || c.CheckColour == "" || !c.Once || c.Locked {
				t.Fatalf("skill %d %s: shown %+v, table %d", skill, locale, c, row[skill])
			}
		}
	}
	dialogueSetSkill(r, o.Check.Skill, 20)
	shown := dialogueOption(t, dialogueView(t, r, "ru"), o.ID).Chance
	if err := choose(r, o.ID); err != nil {
		t.Fatal(err)
	}
	talk := custodyTalk(r)
	var check dialogueEntry
	for _, e := range talk.Lines {
		if e.Kind == "check" {
			check = e
		}
	}
	if check.Chance != int(shown) || check.Skill != o.Check.Skill || check.Difficulty != o.Check.Difficulty {
		t.Fatalf("rolled with %d, showed %d", check.Chance, shown)
	}
	if want := dialogueDie(r.state.Seed, r.state.CheckSeed, custodyKey(r), o.ID, 1) < check.Chance; check.Success != want || talk.Checks[o.ID].Success != want {
		t.Fatalf("the roll is not the server's die: %+v", check)
	}
}

