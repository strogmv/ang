}
func (m PracticeModel) Start() PracticeState {
	s := PracticeState{Actors: make(map[string]PracticeActor, len(m.Profiles))}
	for id, p := range m.Profiles {
		a := PracticeActor{Skills: make(map[string]PracticeSkill, len(p.Skills)), Repetitions: map[string]PracticeRepeat{}}
		for skill, v := range p.Skills {
			a.Skills[skill] = PracticeSkill{ValueMilli: int64(v.Start) * 1000, Cap: v.Cap}
		}
		s.Actors[id] = a
	}
	return s
}
func (a PracticeActor) clone() PracticeActor {
	out := a
	out.Skills = make(map[string]PracticeSkill, len(a.Skills))
	for k, v := range a.Skills {
		out.Skills[k] = v
	}
	out.Repetitions = make(map[string]PracticeRepeat, len(a.Repetitions))
	for k, v := range a.Repetitions {
		out.Repetitions[k] = v
	}
	return out
}
func (s PracticeState) Clone() PracticeState {
	out := PracticeState{}
	if s.Actors != nil {
		out.Actors = make(map[string]PracticeActor, len(s.Actors))
		for id, a := range s.Actors {
			out.Actors[id] = a.clone()
		}
	}
	return out
}
func (s PracticeState) Value(actor, skill string) int {
	return int(s.Actors[actor].Skills[skill].ValueMilli / 1000)
}
func practiceOutcome(e PracticeEvent) bool { return e.Outcome == "success" || e.Outcome == "failure" }

// All intermediate products are bounded by validated model limits. Each step
// truncates to milli precision; a positive learning signal below cap earns at
// least one milli. Zero quality/multipliers never receive this rounding floor.
func practiceGain(r PracticeRule, p PracticeProfile, value PracticeSkill, e PracticeEvent, count int64) int64 {
	capMilli := int64(value.Cap) * 1000
	outcome := r.SuccessPermille
	if e.Outcome == "failure" {
		outcome = r.FailurePermille
	}
	if capMilli <= value.ValueMilli || r.BaseGainMilli == 0 || p.LearnPermille == 0 || e.QualityPermille == 0 || outcome == 0 {
		return 0
	}
	gain := r.BaseGainMilli * (capMilli - value.ValueMilli) / capMilli
	gain = gain * int64(p.LearnPermille) / 1000
	gain = gain * int64(e.QualityPermille) / 1000
	gain = gain * int64(outcome) / 1000
	challenge := (int64(r.Difficulty)*1000 + 1000) * 1000 / (value.ValueMilli + 1000)
	if challenge > 1000 {
		challenge = 1000
	}
	gain = gain * challenge / 1000
	if count > math.MaxInt64-r.RepeatScale {
		gain = 0
	} else {
		gain = gain * r.RepeatScale / (r.RepeatScale + count)
	}
	if gain < 1 {
		gain = 1
	}
	if remaining := capMilli - value.ValueMilli; gain > remaining {
		gain = remaining
	}
	return gain
}
func (a PracticeActor) validate(m PracticeModel, id string, p PracticeProfile, now int64) error {
	if a.Sequence < 0 || len(a.Skills) != len(p.Skills) {
		return fmt.Errorf("invalid practice actor %q", id)
	}
	for _, key := range practiceKeys(p.Skills) {
		cfg := p.Skills[key]
		v, ok := a.Skills[key]
		if !ok || v.Cap != cfg.Cap || v.ValueMilli < int64(cfg.Start)*1000 || v.ValueMilli > int64(cfg.Cap)*1000 {
			return fmt.Errorf("invalid saved practice skill %q/%q", id, key)
		}
	}
	totalCount := int64(0)
	for _, key := range practiceKeys(a.Repetitions) {
		v := a.Repetitions[key]
		r, ok := m.rule(key)
		_, hasSkill := p.Skills[r.Skill]
		if !ok || !hasSkill || v.Count < 1 || v.Count > a.Sequence || v.WindowStart < 0 || v.LastTick < v.WindowStart || v.LastTick > now || v.LastTick-v.WindowStart >= r.RepeatWindowTicks || (v.Count-1) > (v.LastTick-v.WindowStart)/r.CooldownTicks {
			return fmt.Errorf("invalid saved practice repeat %q/%q", id, key)
		}
		if v.Count > a.Sequence-totalCount {
			return fmt.Errorf("practice repeat counts exceed actions for %q", id)
		}
		totalCount += v.Count
	}
	if a.Sequence == 0 {
		if a.LastEvent != (PracticeEvent{}) || a.LastResult != (PracticeResult{}) || len(a.Repetitions) != 0 {
			return fmt.Errorf("practice actor %q has history without sequence", id)
		}
		for key, cfg := range p.Skills {
			if a.Skills[key].ValueMilli != int64(cfg.Start)*1000 {
				return fmt.Errorf("practice actor %q has unearned initial skill", id)
			}
		}
		return nil
	}
	e, result := a.LastEvent, a.LastResult
	r, ok := m.rule(e.Rule)
	v, hasSkill := a.Skills[r.Skill]
	if !ok || !hasSkill || e.Actor != id || e.Sequence != a.Sequence || e.Tick < 0 || e.Tick > now || !practiceOutcome(e) || e.QualityPermille < 0 || e.QualityPermille > 1000 || result.Replayed || result.Actor != id || result.Rule != e.Rule || result.Skill != r.Skill || result.Sequence != e.Sequence || result.Tick != e.Tick || result.BeforeMilli < int64(p.Skills[r.Skill].Start)*1000 || result.AfterMilli != v.ValueMilli || result.AfterMilli < result.BeforeMilli || result.GainMilli != result.AfterMilli-result.BeforeMilli {
		return fmt.Errorf("invalid practice receipt for %q", id)
	}
	count := int64(0)
	for _, repeat := range a.Repetitions {
		if repeat.LastTick > e.Tick {
			return fmt.Errorf("practice repetition ahead of receipt for %q", id)
		}
	}
	if e.QualityPermille > 0 {
		repeat, ok := a.Repetitions[e.Rule]
		if !ok || repeat.LastTick != e.Tick {
			return fmt.Errorf("missing practice repetition for %q", id)
		}
		count = repeat.Count - 1
	}
	before := PracticeSkill{ValueMilli: result.BeforeMilli, Cap: v.Cap}
	if result.GainMilli != practiceGain(r, p, before, e, count) {
		return fmt.Errorf("inconsistent practice gain for %q", id)
	}
	return nil
}
func (s PracticeState) Validate(m PracticeModel, now int64) error {
	if now < 0 {
		return fmt.Errorf("invalid practice clock")
	}
	if err := m.Validate(); err != nil {
		return err
	}
	if len(s.Actors) != len(m.Profiles) {
		return fmt.Errorf("practice actor registry mismatch")
	}
	for _, id := range practiceKeys(m.Profiles) {
		a, ok := s.Actors[id]
		if !ok {
			return fmt.Errorf("missing practice actor %q", id)
		}
		if err := a.validate(m, id, m.Profiles[id], now); err != nil {
			return err
		}
	}
	return nil
}

// Apply commits only after every guard succeeds. Zero-quality events advance the
// receipt sequence but do not consume repetition/cooldown budget. Positive-
// quality events consume that budget even at cap or with zero configured gain.
// A retry of the last exact payload is accepted at later ticks without learning
// twice; new payloads must use the authoritative current tick exactly.
func (s *PracticeState) Apply(m PracticeModel, e PracticeEvent, now int64) (PracticeResult, error) {
	fail := func(reason string) (PracticeResult, error) {
		return PracticeResult{}, fmt.Errorf("practice: %s", reason)
	}
	if now < 0 || e.Tick < 0 || e.Tick > now || e.Sequence < 1 || !practiceOutcome(e) || e.QualityPermille < 0 || e.QualityPermille > 1000 {
		return fail("invalid event")
	}
	p, ok := m.Profiles[e.Actor]
	if !ok {
		return fail("unknown actor")
	}
	a, ok := s.Actors[e.Actor]
	if !ok {
		return fail("missing actor state")
	}
	if err := a.validate(m, e.Actor, p, now); err != nil {
		return PracticeResult{}, err
	}
	if a.Sequence > 0 && e.Sequence == a.Sequence {
		if e != a.LastEvent {
			return fail("altered duplicate")
		}
		result := a.LastResult
		result.Replayed = true
		return result, nil
	}
	if a.Sequence == math.MaxInt64 || e.Sequence != a.Sequence+1 {
		return fail("nonconsecutive sequence")
	}
	if e.Tick != now || e.Tick < a.LastEvent.Tick {
		return fail("nonmonotonic event clock")
	}
	r, ok := m.rule(e.Rule)
	if !ok {
		return fail("unknown rule")
	}
	v, ok := a.Skills[r.Skill]
	if !ok {
		return fail("actor lacks rule skill")
	}
	repeat, exists := a.Repetitions[e.Rule]
	if e.QualityPermille > 0 && exists && e.Tick-repeat.LastTick < r.CooldownTicks {
		return fail("rule cooldown")
	}
	if !exists || e.Tick-repeat.WindowStart >= r.RepeatWindowTicks {
		repeat = PracticeRepeat{WindowStart: e.Tick}
	}
	gain := practiceGain(r, p, v, e, repeat.Count)
	result := PracticeResult{Actor: e.Actor, Rule: e.Rule, Skill: r.Skill, Sequence: e.Sequence, Tick: e.Tick, BeforeMilli: v.ValueMilli, AfterMilli: v.ValueMilli + gain, GainMilli: gain}
	next := a.clone()
	v.ValueMilli = result.AfterMilli
	next.Skills[r.Skill] = v
	if e.QualityPermille > 0 {
		if repeat.Count == math.MaxInt64 {
			return fail("repetition count overflow")
		}
		repeat.Count++
		repeat.LastTick = e.Tick
		next.Repetitions[e.Rule] = repeat
	}
	next.Sequence = e.Sequence
	next.LastEvent = e
	next.LastResult = result
	s.Actors[e.Actor] = next
	return result, nil
}
