// Every stall and peddler with a consignment starts the day with its starting stock again, and the consignment only
// loses what was laid out.
func TestVisitorSupplyLaysOutTheStartingStockEveryMorning(t *testing.T) {
	if testing.Short() {
		t.Skip("two mornings of the hall")
	}
	r := visitorsRuntime(t, 30)
	v := r.world.Visitors
	if len(v.Supply.Rules) == 0 {
		t.Skip("no consignments")
	}
	count := func(store, item string) int64 {
		var n int64
		for _, i := range r.state.Inventory.Items {
			if i.Location.Kind == "store" && i.Location.Store == store && i.Definition == item {
				n += i.Quantity
			}
		}
		return n
	}
	// A shop supplied by the cargo convoy (cargo to the market v1, 12.11) keeps the same consignment at the Copper dock
	// and in the trailers; its supply store is its locker in store 17. The days of stock are counted where they are.
	reserve := func(shop, store, item string) int64 {
		n := count(store, item)
		if r.world.CargoConvoys != nil {
			for _, lot := range r.world.CargoConvoys.Lots {
				if lot.Shop == shop && lot.LockerStore == store {
					n += count(lot.CopperStore, item)
					for _, trailer := range lot.TrailerStores {
						n += count(trailer, item)
					}
				}
			}
		}
		return n
	}
	behind := map[string]int64{}
	for _, rule := range v.Supply.Rules {
		for _, lot := range rule.Lots {
			behind[rule.Shop+"/"+lot.Item] = reserve(rule.Shop, rule.Store, lot.Item)
			if behind[rule.Shop+"/"+lot.Item] != lot.Full*v.Supply.Days {
				t.Fatalf("%s %s: %d behind the lock, want %d days of %d", rule.Shop, lot.Item, behind[rule.Shop+"/"+lot.Item], v.Supply.Days, lot.Full)
			}
		}
	}
	// the first day sells, the second morning lays out again
	visitorsRun(t, r, 86400-r.state.Life.Seconds%86400+86400, nil)
	full, laid := 0, 0
	for end := r.state.Life.Seconds + 86400; r.state.Life.Seconds < end; {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(30); err != nil {
			t.Fatal(err)
		}
	}
	for _, rule := range v.Supply.Rules {
		if r.state.Visitors.Supplied[rule.Shop] == 0 {
			continue
		}
		laid++
		for _, lot := range rule.Lots {
			moved := behind[rule.Shop+"/"+lot.Item] - reserve(rule.Shop, rule.Store, lot.Item)
			if moved < 0 || moved > 3*lot.Full {
				t.Fatalf("%s %s: %d left the consignment in three mornings (lot %d)", rule.Shop, lot.Item, moved, lot.Full)
			}
			if moved > 0 {
				full++
			}
		}
	}
	if laid < len(v.Supply.Rules)*3/4 || full == 0 {
		t.Fatalf("laid out at %d of %d supplied places, %d lots moved", laid, len(v.Supply.Rules), full)
	}
}

// Acceptance of the hall's economy (11.11.2026): nobody who lives off the market starves in fourteen days, at any
// calendar rate, by the seed. NPC_SURVIVAL_RATE picks one rate; NPC_SURVIVAL_STATE names a file that carries the run
// across invocations of NPC_SURVIVAL_CHUNK_DAYS days each (a long x1 run in short pieces).
func TestMarketPeopleSurviveFourteenDays(t *testing.T) {
	if testing.Short() {
		t.Skip("fourteen days of the hall at three rates")
	}
	rates := []int64{1, 10, 30}
	if v := os.Getenv("NPC_SURVIVAL_RATE"); v != "" {
		n, err := strconv.ParseInt(v, 10, 64)
		if err != nil || (n != 1 && n != 10 && n != 30) {
			t.Fatal("NPC_SURVIVAL_RATE must be 1, 10 or 30")
		}
		rates = []int64{n}
	}
	const days = 14
	type progress struct {
		State  json.RawMessage  `json:"state"`
		Start  int64            `json:"start"`
		Peak   map[string]int64 `json:"peak"`
		PeakAt map[string]int64 `json:"peak_at"`
	}
	for _, rate := range rates {
		t.Run(fmt.Sprint(rate), func(t *testing.T) {
			r := worldAuditRuntime(t, 0)
			r.state.Life.SecondsPerTick = rate
			p := progress{Start: r.state.Life.Seconds, Peak: map[string]int64{}, PeakAt: map[string]int64{}}
			file := os.Getenv("NPC_SURVIVAL_STATE")
			if file != "" {
				if raw, err := os.ReadFile(file); err == nil {
					if err := json.Unmarshal(raw, &p); err != nil {
						t.Fatal(err)
					}
					var s state
					if err := json.Unmarshal(p.State, &s); err != nil {
						t.Fatal(err)
					}
					r.state = s
					r.state.Life.SecondsPerTick = rate
				}
			}
			end := p.Start + days*86400
			stop := end
			if v := os.Getenv("NPC_SURVIVAL_CHUNK_DAYS"); v != "" && file != "" {
				n, err := strconv.ParseInt(v, 10, 64)
				if err != nil || n < 1 {
					t.Fatal("NPC_SURVIVAL_CHUNK_DAYS must be a positive number")
				}
				stop = min(end, r.state.Life.Seconds+n*86400)
			}
			market := map[string]bool{}
			for _, a := range r.world.Life.Actors {
				for _, step := range a.Steps {
					if a.ID != playerActorID && step.Level == r.world.Visitors.Level {
						market[a.ID] = true
					}
				}
			}
			if len(market) < 40 {
				t.Fatalf("only %d people of the market", len(market))
			}
			for r.state.Life.Seconds < stop {
				r.state.Tick++
				if err := r.advanceLifeFrameBy(rate); err != nil {
					t.Fatal(err)
				}
				if r.state.Life.Seconds%60 >= rate {
					continue
				}
				for _, a := range r.state.Life.Actors {
					if market[a.ID] && a.Brain.Needs[0] > p.Peak[a.ID] {
						p.Peak[a.ID], p.PeakAt[a.ID] = a.Brain.Needs[0], r.state.Life.Seconds
					}
				}
			}
			if file != "" {
				raw, err := json.Marshal(r.state)
				if err != nil {
					t.Fatal(err)
				}
				p.State = raw
				out, err := json.Marshal(p)
				if err != nil {
					t.Fatal(err)
				}
				if err := os.WriteFile(file, out, 0o644); err != nil {
					t.Fatal(err)
				}
			}
			ids := make([]string, 0, len(market))
			for id := range market {
				ids = append(ids, id)
			}
			sort.Slice(ids, func(i, j int) bool { return p.Peak[ids[i]] > p.Peak[ids[j]] || p.Peak[ids[i]] == p.Peak[ids[j]] && ids[i] < ids[j] })
			done := (r.state.Life.Seconds - p.Start) / 86400
			t.Logf("rate x%d, %d of %d days, %d people of the market; hungriest: %s %d ppm, %s %d ppm, %s %d ppm", rate, done, days, len(ids), ids[0], p.Peak[ids[0]], ids[1], p.Peak[ids[1]], ids[2], p.Peak[ids[2]])
			for _, id := range ids {
				if p.Peak[id] >= 1000000 {
					at := p.PeakAt[id] - p.Start
					t.Errorf("%s starved to the limit on day %d at %02d:%02d", id, at/86400+1, p.PeakAt[id]%86400/3600, p.PeakAt[id]%3600/60)
				}
			}
			if r.state.Life.Seconds < end {
				t.Logf("not finished: run again with the same NPC_SURVIVAL_STATE")
			}
		})
	}
}
