  static bool RegionNodeTravelAllowed(PocRegionNode node){return RegionNodeKnown(node)&&node.CanTravel&&!node.Current&&!string.IsNullOrEmpty(node.LevelId);}
  static PocRegionNode RegionFindNode(PocRegionMap map,string id){if(map==null)return null;foreach(var node in map.Nodes)if(node.Id==id&&RegionNodeKnown(node))return node;return null;}
  static List<PocRegionDeck> RegionKnownDecks(PocRegionMap map){
   var result=new List<PocRegionDeck>();
   if(map==null)return result;
   foreach(var deck in map.Decks){bool hasNode=false;foreach(var node in map.Nodes)if(node.DeckId==deck.Id&&RegionNodePlottable(node)){hasNode=true;break;}if(hasNode)result.Add(deck);}
   result.Sort((a,b)=>{int order=a.ElevationM.CompareTo(b.ElevationM);return order!=0?order:string.CompareOrdinal(a.Id,b.Id);});return result;
  }
  static List<PocRegionNode> RegionDeckNodes(PocRegionMap map,string deck){
   var result=new List<PocRegionNode>();if(map!=null)foreach(var node in map.Nodes)if(node.DeckId==deck&&RegionNodePlottable(node))result.Add(node);return result;
  }
  // These are schematic display units supplied by the server, not room metres.
  // Both drawing and picking use the same oblique projection.
  static Vector2 RegionPlane(double x,double y){return new Vector2((float)(x*.92+y*.55),(float)(-x*.28+y*.52));}
  static Rect RegionModelBounds(IList<PocRegionNode> nodes){
   if(nodes.Count==0)return new Rect(-1,-1,2,2);
   float left=float.MaxValue,top=float.MaxValue,right=float.MinValue,bottom=float.MinValue;
   foreach(var node in nodes)for(int i=0;i<4;i++){var p=RegionPlane(node.X+(i<2?-1:1)*node.Width/2,node.Y+(i%2==0?-1:1)*node.Height/2);left=Math.Min(left,p.x);right=Math.Max(right,p.x);top=Math.Min(top,p.y);bottom=Math.Max(bottom,p.y);}
   return new Rect(left,top,Mathf.Max(1,right-left),Mathf.Max(1,bottom-top));
  }
  static float RegionFitScale(Rect bounds,Rect canvas){return Mathf.Min(Mathf.Max(1,canvas.width-60)/Mathf.Max(1,bounds.width),Mathf.Max(1,canvas.height-80)/Mathf.Max(1,bounds.height));}
  static Vector2 RegionMapPoint(double x,double y,Rect bounds,Rect canvas,float zoom,Vector2 pan){
   float scale=RegionFitScale(bounds,canvas)*zoom;return canvas.center+pan+(RegionPlane(x,y)-bounds.center)*scale;
  }
  static float RegionBlockRise(PocRegionNode node,float zoom){return Mathf.Clamp((node.Kind=="junction"?1:node.Kind=="station"||node.Kind=="refuge"?4:10)*zoom,1,18);}
  static Vector2[] RegionNodeCorners(PocRegionNode node,Rect bounds,Rect canvas,float zoom,Vector2 pan,float inset=0){
   double w=Math.Max(1,node.Width/2-inset),h=Math.Max(1,node.Height/2-inset);
   return new[]{RegionMapPoint(node.X-w,node.Y-h,bounds,canvas,zoom,pan),RegionMapPoint(node.X+w,node.Y-h,bounds,canvas,zoom,pan),RegionMapPoint(node.X+w,node.Y+h,bounds,canvas,zoom,pan),RegionMapPoint(node.X-w,node.Y+h,bounds,canvas,zoom,pan)};
  }
  static Rect RegionNodeRect(PocRegionNode node,Rect bounds,Rect canvas,float zoom,Vector2 pan){
   var points=RegionNodeCorners(node,bounds,canvas,zoom,pan);float left=points[0].x,right=left,top=points[0].y,bottom=top;
   foreach(var point in points){left=Math.Min(left,point.x);right=Math.Max(right,point.x);top=Math.Min(top,point.y);bottom=Math.Max(bottom,point.y);}
   float rise=RegionBlockRise(node,zoom);return new Rect(left-3,top-rise-3,right-left+6,bottom-top+rise+6);
  }

  static void RegionZoomAt(Vector2 pointer,Rect canvas,float factor,ref float zoom,ref Vector2 pan){
   float previous=zoom;zoom=Mathf.Clamp(zoom*factor,.65f,4.5f);Vector2 local=pointer-canvas.center;pan=local-(local-pan)*(zoom/previous);
  }
  void RegionResetView(){hudRegionLabelHits.Clear();hudRegionZoom=1;hudRegionPan=Vector2.zero;hudRegionPointerDown=false;hudRegionDetailScroll=Vector2.zero;}
  void RegionFocusNode(PocRegionMap map,PocRegionNode node){
   if(node==null||node.DeckId!=hudRegionDeckID)return;hudRegionZoom=2f;
   Rect bounds=RegionModelBounds(RegionDeckNodes(map,hudRegionDeckID));Vector2 target=RegionMapPoint(node.X,node.Y,bounds,hudRegionCanvas,hudRegionZoom,Vector2.zero);hudRegionPan=hudRegionCanvas.center-target;
  }
  void RegionSelectDeck(List<PocRegionDeck> decks,int index,PocRegionMap map){
   if(index<0||index>=decks.Count)return;hudRegionDeckID=decks[index].Id;hudRegionNodeID="";
   foreach(var node in map.Nodes)if(node.DeckId==hudRegionDeckID&&RegionNodeKnown(node)){if(hudRegionNodeID==""||node.Current)hudRegionNodeID=node.Id;if(node.Current)break;}
   RegionResetView();
  }
  void RegionRefreshSelection(PocRegionMap map,List<PocRegionDeck> decks){
   if(hudRegionMapID!=map.Id){hudRegionMapID=map.Id;hudRegionFollowCurrent=true;hudRegionDeckID="";hudRegionNodeID="";}
   bool deckExists=false;foreach(var deck in decks)if(deck.Id==hudRegionDeckID)deckExists=true;
   if(hudRegionFollowCurrent||!deckExists){
    string target=map.CurrentDeck;var current=RegionFindNode(map,map.CurrentNode);if(current!=null)target=current.DeckId;
    int index=0;for(int i=0;i<decks.Count;i++)if(decks[i].Id==target){index=i;break;}
    RegionSelectDeck(decks,index,map);if(current!=null&&current.DeckId==hudRegionDeckID){hudRegionNodeID=current.Id;}hudRegionFollowCurrent=false;
   }
   var selected=RegionFindNode(map,hudRegionNodeID);if(selected==null||selected.DeckId!=hudRegionDeckID){hudRegionNodeID="";foreach(var node in map.Nodes)if(node.DeckId==hudRegionDeckID&&RegionNodePlottable(node)){hudRegionNodeID=node.Id;break;}}
  }
  bool RegionSelectNode(PocRegionMap map,PocRegionNode node){
   if(node==null||RegionFindNode(map,node.Id)!=node||!RegionNodePlottable(node))return false;
   hudRegionNodeID=node.Id;hudRegionDetailScroll=Vector2.zero;
   if(!node.Current&&!string.IsNullOrEmpty(node.LevelId))WayfindingSelect(node.LevelId);else WayfindingClear();return true;
  }
  void RegionHandleMapInput(List<PocRegionNode> nodes,Rect bounds){
   var e=Event.current;if(e==null)return;
   if(e.type==EventType.MouseUp&&hudRegionPointerDown){
    bool labelHit=false;if(!hudRegionDragging&&e.button==0&&hudRegionCanvas.Contains(e.mousePosition))for(int i=hudRegionLabelHits.Count-1;i>=0;i--)if(hudRegionLabelHits[i].box.Contains(e.mousePosition)){var node=RegionFindNode(state.Life.RegionMap,hudRegionLabelHits[i].id);if(node!=null&&node.DeckId==hudRegionDeckID)labelHit=RegionSelectNode(state.Life.RegionMap,node);break;}
    if(!labelHit&&!hudRegionDragging&&e.button==0&&hudRegionCanvas.Contains(e.mousePosition))for(int i=nodes.Count-1;i>=0;i--){Rect box=RegionNodeRect(nodes[i],bounds,hudRegionCanvas,hudRegionZoom,hudRegionPan),edge;string arrow;bool hit=box.Contains(e.mousePosition)||(RegionEdgeLabel(nodes[i],box,hudRegionCanvas,out edge,out arrow)&&edge.Contains(e.mousePosition));if(hit){RegionSelectNode(map:state.Life.RegionMap,node:nodes[i]);break;}}
    hudRegionPointerDown=false;hudRegionDragging=false;e.Use();return;
   }
   if(e.type==EventType.MouseDrag&&hudRegionPointerDown){Vector2 offset=e.mousePosition-hudRegionPointerStart;if(offset.sqrMagnitude>9)hudRegionDragging=true;if(hudRegionDragging)hudRegionPan=hudRegionPanStart+offset;e.Use();return;}
   if(!hudRegionCanvas.Contains(e.mousePosition))return;
   if(e.type==EventType.ScrollWheel){RegionZoomAt(e.mousePosition,hudRegionCanvas,Mathf.Pow(1.12f,-e.delta.y),ref hudRegionZoom,ref hudRegionPan);e.Use();return;}
   if(e.type==EventType.MouseDown&&(e.button==0||e.button==2)){hudRegionPointerDown=true;hudRegionDragging=false;hudRegionPointerStart=e.mousePosition;hudRegionPanStart=hudRegionPan;e.Use();}
  }
  static bool RegionClipEdge(float p,float q,ref float start,ref float end){
   if(Mathf.Abs(p)<.000001f)return q>=0;float ratio=q/p;
   if(p<0){if(ratio>end)return false;if(ratio>start)start=ratio;}else{if(ratio<start)return false;if(ratio<end)end=ratio;}return true;
  }
  static bool RegionClipLine(Rect canvas,ref Vector2 from,ref Vector2 to){
   if(canvas.width<=0||canvas.height<=0||!RegionFinite(from.x)||!RegionFinite(from.y)||!RegionFinite(to.x)||!RegionFinite(to.y))return false;
   Vector2 delta=to-from;float start=0,end=1;
   if(!RegionClipEdge(-delta.x,from.x-canvas.xMin,ref start,ref end)||!RegionClipEdge(delta.x,canvas.xMax-from.x,ref start,ref end)||!RegionClipEdge(-delta.y,from.y-canvas.yMin,ref start,ref end)||!RegionClipEdge(delta.y,canvas.yMax-from.y,ref start,ref end))return false;
   Vector2 origin=from;from=origin+delta*start;to=origin+delta*end;return true;
  }
  void RegionClippedFill(Rect box,Rect canvas,Color color){
   float left=Mathf.Max(box.xMin,canvas.xMin),top=Mathf.Max(box.yMin,canvas.yMin),right=Mathf.Min(box.xMax,canvas.xMax),bottom=Mathf.Min(box.yMax,canvas.yMax);
   if(right>left&&bottom>top)Fill(new Rect(left,top,right-left,bottom-top),color);
  }
  void RegionLine(Rect canvas,Vector2 from,Vector2 to,Color color,float width){
   // Rotating an IMGUI group also rotates its clip. Only bounded, axis-aligned
   // rectangles are submitted here; the HUD matrix/color/clip are never changed.
   if(!RegionClipLine(canvas,ref from,ref to))return;Vector2 delta=to-from;width=Mathf.Clamp(width,1,4);
   if(Mathf.Abs(delta.y)<.001f){RegionClippedFill(new Rect(Mathf.Min(from.x,to.x)-width/2,from.y-width/2,Mathf.Abs(delta.x)+width,width),canvas,color);return;}
   if(Mathf.Abs(delta.x)<.001f){RegionClippedFill(new Rect(from.x-width/2,Mathf.Min(from.y,to.y)-width/2,width,Mathf.Abs(delta.y)+width),canvas,color);return;}
   int steps=Mathf.Max(1,Mathf.CeilToInt(Mathf.Max(Mathf.Abs(delta.x),Mathf.Abs(delta.y))/2));float diameter=width+1;
   for(int i=0;i<=steps;i++){Vector2 point=from+delta*((float)i/steps);RegionClippedFill(new Rect(point.x-diameter/2,point.y-diameter/2,diameter,diameter),canvas,color);}
  }
  static bool RegionEdgeLabel(PocRegionNode node,Rect box,Rect canvas,out Rect label,out string arrow){
   label=new Rect();arrow="";if(!RegionNodeKnown(node)||canvas.Overlaps(box)||string.IsNullOrEmpty(node.LevelId))return false;
   float width=Mathf.Min(188,canvas.width-16),height=20;Vector2 center=box.center;
   if(center.x>canvas.xMax){arrow="→";label=new Rect(canvas.xMax-width-6,Mathf.Clamp(center.y+12,canvas.y+6,canvas.yMax-height-6),width,height);}
   else if(center.x<canvas.xMin){arrow="←";label=new Rect(canvas.x+6,Mathf.Clamp(center.y+12,canvas.y+6,canvas.yMax-height-6),width,height);}
   else{arrow=center.y<canvas.yMin?"↑":"↓";label=new Rect(Mathf.Clamp(center.x-width/2,canvas.x+6,canvas.xMax-width-6),center.y<canvas.yMin?canvas.y+6:canvas.yMax-height-6,width,height);}return true;
  }
  string RegionRouteNotice(string name){return L("ui.region.route_notice").Replace("{name}",name);}
  string RegionElevationLabel(double elevation){return L("ui.region.elevation").Replace("{elevation}",elevation.ToString("+0.#;-0.#;0",CultureInfo.InvariantCulture));}
  string RegionLinkName(string mode){return mode=="monorail"?L("ui.region.link_monorail"):mode=="stairs"?L("ui.region.link_stairs"):mode=="lift"?L("ui.region.link_lift"):L("ui.region.link_corridor");}
  static bool RegionSegmentHitsBox(Vector2 a,Vector2 b,Rect box){return RegionClipLine(box,ref a,ref b);}
  static List<Vector2> RegionConnectionPoints(PocRegionNode from,PocRegionNode to,IList<PocRegionNode> nodes){
   var a=new Vector2((float)from.X,(float)(from.Y+from.Height/2+14));var b=new Vector2((float)to.X,(float)(to.Y+to.Height/2+14));
   var candidates=new List<List<Vector2>>{new List<Vector2>{a,new Vector2(b.x,a.y),b},new List<Vector2>{a,new Vector2(a.x,b.y),b}};
   float left=Math.Min(a.x,b.x),right=Math.Max(a.x,b.x),top=Math.Min(a.y,b.y),bottom=Math.Max(a.y,b.y);
   foreach(var n in nodes){left=Math.Min(left,(float)(n.X-n.Width/2));right=Math.Max(right,(float)(n.X+n.Width/2));top=Math.Min(top,(float)(n.Y-n.Height/2));bottom=Math.Max(bottom,(float)(n.Y+n.Height/2));}
   foreach(float y in new[]{top-16,bottom+16,(a.y+b.y)/2})candidates.Add(new List<Vector2>{a,new Vector2(a.x,y),new Vector2(b.x,y),b});
   foreach(float x in new[]{left-16,right+16,(a.x+b.x)/2})candidates.Add(new List<Vector2>{a,new Vector2(x,a.y),new Vector2(x,b.y),b});
   List<Vector2> best=null;float bestCost=float.MaxValue;
   foreach(var route in candidates){float cost=route.Count*2;for(int i=1;i<route.Count;i++){cost+=Vector2.Distance(route[i-1],route[i]);foreach(var n in nodes){if(n.Id==from.Id||n.Id==to.Id)continue;var box=new Rect((float)(n.X-n.Width/2-5),(float)(n.Y-n.Height/2-5),(float)n.Width+10,(float)n.Height+10);if(RegionSegmentHitsBox(route[i-1],route[i],box))cost+=10000;}}if(cost<bestCost){bestCost=cost;best=route;}}
   var result=new List<Vector2>();foreach(var point in best)if(result.Count==0||(point-result[result.Count-1]).sqrMagnitude>.001f)result.Add(point);return result;
  }
  void RegionPolygon(Rect canvas,Vector2[] points,Color color){
   // Bounded scan conversion avoids rotating an IMGUI clipping group.
   float top=canvas.yMax,bottom=canvas.yMin;foreach(var p in points){top=Math.Min(top,p.y);bottom=Math.Max(bottom,p.y);}int first=Math.Max((int)Math.Floor(canvas.yMin),(int)Math.Floor(top)),last=Math.Min((int)Math.Ceiling(canvas.yMax),(int)Math.Ceiling(bottom));
   for(int y=first;y<last;y++){float scan=y+.5f,left=float.MaxValue,right=float.MinValue;for(int i=0;i<points.Length;i++){var a=points[i];var b=points[(i+1)%points.Length];if((a.y>scan)==(b.y>scan))continue;float x=a.x+(scan-a.y)*(b.x-a.x)/(b.y-a.y);left=Math.Min(left,x);right=Math.Max(right,x);}if(right>left)RegionClippedFill(new Rect(left,y,right-left,1),canvas,color);}
  }
  void RegionOutline(Rect canvas,Vector2[] points,Color color,float width){for(int i=0;i<points.Length;i++)RegionLine(canvas,points[i],points[(i+1)%points.Length],color,width);}
  void RegionDashedLine(Rect canvas,Vector2 a,Vector2 b,Color color,float width){
   if(!RegionClipLine(canvas,ref a,ref b))return;var d=b-a;float length=d.magnitude;if(length<.01f)return;
   for(float at=0;at<length;at+=11)RegionLine(canvas,a+d*(at/length),a+d*(Math.Min(at+6,length)/length),color,width);
  }
  void RegionDrawLinks(PocRegionMap map,Rect bounds,Rect canvas){
   var nodes=RegionDeckNodes(map,hudRegionDeckID);RegionPrepareConnections(nodes);var active=new HashSet<string>(map.SelectedLocalLinkIds,StringComparer.Ordinal);
   for(int pass=0;pass<2;pass++)foreach(var link in map.Links){if(active.Contains(link.Id)!=(pass==1))continue;var from=RegionFindNode(map,link.FromNode);var to=RegionFindNode(map,link.ToNode);if(!RegionNodePlottable(from)||!RegionNodePlottable(to)||from.DeckId!=hudRegionDeckID||to.DeckId!=hudRegionDeckID)continue;
    bool rail=link.Mode=="monorail",selected=active.Contains(link.Id);List<Vector2> route;string routeKey=link.Id+"/"+link.FromNode+"/"+link.ToNode+"/"+link.Mode;if(!regionConnectionRoutes.TryGetValue(routeKey,out route)){route=rail?new List<Vector2>{new Vector2((float)from.X,(float)from.Y),new Vector2((float)to.X,(float)to.Y)}:RegionConnectionPoints(from,to,nodes);regionConnectionRoutes[routeKey]=route;}
    for(int i=1;i<route.Count;i++){var a=RegionMapPoint(route[i-1].x,route[i-1].y,bounds,canvas,hudRegionZoom,hudRegionPan);var b=RegionMapPoint(route[i].x,route[i].y,bounds,canvas,hudRegionZoom,hudRegionPan);var normal=new Vector2(-(b-a).y,(b-a).x).normalized;
     if(rail){Color railColor=new Color(.43f,.58f,.60f,.85f);RegionLine(canvas,a-normal*2,b-normal*2,railColor,1);RegionLine(canvas,a+normal*2,b+normal*2,railColor,1);float length=Vector2.Distance(a,b);for(float t=9;t<length;t+=16){var at=Vector2.Lerp(a,b,t/length);RegionLine(canvas,at-normal*4,at+normal*4,new Color(.30f,.40f,.41f),1);}}
     else{RegionLine(canvas,a,b,new Color(.15f,.19f,.19f),4);RegionDashedLine(canvas,a,b,new Color(.48f,.50f,.45f,.85f),1);}
     if(selected)RegionDashedLine(canvas,a+(rail?normal*7:Vector2.zero),b+(rail?normal*7:Vector2.zero),new Color(.96f,.65f,.30f),3);
    }
   }
  }
  void RegionRoofLine(PocRegionNode node,Rect bounds,Rect canvas,double x1,double y1,double x2,double y2,Color color){
   var rise=new Vector2(0,RegionBlockRise(node,hudRegionZoom));RegionLine(canvas,RegionMapPoint(node.X+x1,node.Y+y1,bounds,canvas,hudRegionZoom,hudRegionPan)-rise,RegionMapPoint(node.X+x2,node.Y+y2,bounds,canvas,hudRegionZoom,hudRegionPan)-rise,color,1);
  }
  void RegionDrawBlock(PocRegionNode node,Rect bounds,Rect canvas){
   var floor=RegionNodeCorners(node,bounds,canvas,hudRegionZoom,hudRegionPan);var top=(Vector2[])floor.Clone();float rise=RegionBlockRise(node,hudRegionZoom);for(int i=0;i<top.Length;i++)top[i].y-=rise;
   bool selected=node.Id==hudRegionNodeID;Color roof=node.Knowledge=="visited"?new Color(.31f,.32f,.28f):new Color(.25f,.28f,.29f);if(selected)roof=new Color(.40f,.37f,.26f);
   RegionPolygon(canvas,new[]{top[2],top[3],floor[3],floor[2]},new Color(.16f,.18f,.18f));RegionPolygon(canvas,new[]{top[3],top[0],floor[0],floor[3]},new Color(.20f,.22f,.21f));RegionPolygon(canvas,top,roof);RegionOutline(canvas,top,selected?hudBrass:new Color(.48f,.49f,.43f),selected?2:1);
   RegionLine(canvas,top[3],floor[3],new Color(.38f,.40f,.35f),1);RegionLine(canvas,floor[0],floor[3],new Color(.32f,.34f,.31f),1);RegionLine(canvas,floor[3],floor[2],new Color(.32f,.34f,.31f),1);
   var inset=RegionNodeCorners(node,bounds,canvas,hudRegionZoom,hudRegionPan,5);for(int i=0;i<inset.Length;i++)inset[i].y-=rise;RegionOutline(canvas,inset,new Color(.14f,.17f,.17f),1);
   Color ink=new Color(.62f,.63f,.54f);double w=node.Width*.29,h=node.Height*.29;
   if(node.Kind=="market"||node.Kind=="housing"){for(int i=-1;i<=1;i++)RegionRoofLine(node,bounds,canvas,w*i,-h,w*i,h,ink);}
   else if(node.Kind=="station"||node.Kind=="transport_hub"){RegionRoofLine(node,bounds,canvas,-w,-h*.45,w,-h*.45,ink);RegionRoofLine(node,bounds,canvas,-w,h*.45,w,h*.45,ink);}
   else if(node.Kind=="clinic"){RegionRoofLine(node,bounds,canvas,-w*.65,0,w*.65,0,ink);RegionRoofLine(node,bounds,canvas,0,-h*.8,0,h*.8,ink);}
   else if(node.Kind=="repair_workshop"||node.Kind=="utility_air"){for(int i=-1;i<=1;i++)RegionRoofLine(node,bounds,canvas,-w,h*i*.6,w,h*i*.6,ink);}
   else if(node.Kind=="control"||node.Kind=="controlled_reception"){RegionRoofLine(node,bounds,canvas,-w,0,w,0,ink);RegionRoofLine(node,bounds,canvas,0,-h,0,h,ink);}
   if(node.Current){var c=RegionMapPoint(node.X,node.Y,bounds,canvas,hudRegionZoom,hudRegionPan)-new Vector2(0,rise);var diamond=new[]{c+new Vector2(0,-6),c+new Vector2(6,0),c+new Vector2(0,6),c+new Vector2(-6,0)};RegionPolygon(canvas,diamond,new Color(.97f,.62f,.26f));RegionOutline(canvas,diamond,new Color(.98f,.81f,.51f),1);}
  }
  void RegionDrawNodes(List<PocRegionNode> nodes,Rect bounds,Rect canvas){
   hudRegionLabelHits.Clear();var ordered=new List<PocRegionNode>(nodes);ordered.Sort((a,b)=>RegionPlane(a.X,a.Y).y.CompareTo(RegionPlane(b.X,b.Y).y));foreach(var node in ordered)if(canvas.Overlaps(RegionNodeRect(node,bounds,canvas,hudRegionZoom,hudRegionPan)))RegionDrawBlock(node,bounds,canvas);
   if(hudRegionLabel==null)hudRegionLabel=new GUIStyle(hudSmall){fontSize=12,wordWrap=true,alignment=TextAnchor.MiddleCenter,normal={textColor=hudPaper}};
   var labels=new List<Rect>();
   for(int pass=0;pass<3;pass++)foreach(var node in nodes){int priority=node.Current||node.Id==hudRegionNodeID?0:!string.IsNullOrEmpty(node.LevelId)||node.Kind=="hygiene"||node.Kind=="food"||node.Kind=="laundry"||node.Kind=="clinic"?1:2;if(pass!=priority)continue;
    Rect box=RegionNodeRect(node,bounds,canvas,hudRegionZoom,hudRegionPan);if(!canvas.Overlaps(box)){Rect edge;string arrow;if(RegionEdgeLabel(node,box,canvas,out edge,out arrow)&&priority<2){labels.Add(edge);Fill(edge,new Color(.075f,.085f,.09f,.96f));GUI.Label(new Rect(edge.x+4,edge.y,edge.width-8,20),new GUIContent(arrow+" "+node.Name,node.Name),hudSmall);}continue;}
    if(node.Kind=="junction"&&priority==2)continue;
    string name=string.IsNullOrEmpty(node.Label)?node.Name:node.Label;float width=priority<2?112:96;float height=Math.Min(44,Math.Max(21,hudRegionLabel.CalcHeight(new GUIContent(name),width-8)));
    Rect label=new Rect();bool found=false;var positions=new List<Vector2>();for(int ring=0;ring<3;ring++){float gap=5+ring*24;positions.Add(new Vector2(box.center.x-width/2,box.yMin-height-gap));positions.Add(new Vector2(box.center.x-width/2,box.yMax+gap));positions.Add(new Vector2(box.xMax+gap,box.center.y-height/2));positions.Add(new Vector2(box.xMin-width-gap,box.center.y-height/2));}foreach(var at in positions){var test=new Rect(Mathf.Clamp(at.x,canvas.x+3,canvas.xMax-width-3),Mathf.Clamp(at.y,canvas.y+3,canvas.yMax-height-3),width,height);bool collision=false;foreach(var other in labels)if(other.Overlaps(test)){collision=true;break;}if(!collision){label=test;found=true;break;}}
    if(!found){if(priority==2)continue;label=new Rect(Mathf.Clamp(box.center.x-width/2,canvas.x+3,canvas.xMax-width-3),Mathf.Clamp(box.yMax+5,canvas.y+3,canvas.yMax-height-3),width,height);}
    labels.Add(label);hudRegionLabelHits.Add(new RegionLabelHit{box=new Rect(label.x+hudRegionCanvas.x,label.y+hudRegionCanvas.y,label.width,label.height),id=node.Id});var edgePoint=new Vector2(Mathf.Clamp(box.center.x,label.xMin,label.xMax),Mathf.Clamp(box.center.y,label.yMin,label.yMax));RegionLine(canvas,box.center,edgePoint,new Color(.40f,.41f,.35f),1);RegionClippedFill(label,canvas,new Color(.085f,.095f,.098f,.94f));GUI.Label(new Rect(label.x+4,label.y,label.width-8,label.height),new GUIContent(name,name),hudRegionLabel);
   }
  }

  string RegionNodeDescription(PocRegionMap map,PocRegionNode selected){
   var text=new StringBuilder();if(!string.IsNullOrEmpty(selected.Description))text.Append(selected.Description);
   foreach(var link in map.Links){string id=link.FromNode==selected.Id?link.ToNode:link.ToNode==selected.Id?link.FromNode:"";if(id=="")continue;var other=RegionFindNode(map,id);if(other==null)continue;
    text.Append("\n\n").Append(L("ui.region.connection").Replace("{mode}",RegionLinkName(link.Mode)).Replace("{name}",other.Name));
    if(other.DeckId!=selected.DeckId)foreach(var deck in map.Decks)if(deck.Id==other.DeckId){text.Append("\n").Append(deck.Name);break;}
   }return text.ToString();
  }
  void RegionDrawDetail(PocRegionMap map){
   Rect panel=new Rect(986,282,220,395);Fill(new Rect(panel.x-6,panel.y,1,panel.height),new Color(.39f,.36f,.28f));var node=RegionFindNode(map,hudRegionNodeID);
   GUI.Label(new Rect(998,289,196,21),L("ui.region.selected_object"),hudSmall);
   if(node==null){GUI.Label(new Rect(998,326,196,70),L("ui.region.select_place"),hudWrap);return;}
   GUI.Label(new Rect(998,319,196,69),node.Name,hudWrap);
   GUI.Label(new Rect(998,389,196,32),node.Current?L("ui.region.status_here"):node.Knowledge=="visited"?L("ui.region.status_visited"):L("ui.region.status_known"),hudWrap);
   string description=RegionNodeDescription(map,node);float height=Mathf.Max(160,hudWrap.CalcHeight(new GUIContent(description),174)+8);
   hudRegionDetailScroll=GUI.BeginScrollView(new Rect(996,429,202,153),hudRegionDetailScroll,new Rect(0,0,180,height));GUI.Label(new Rect(2,0,174,height),description,hudWrap);GUI.EndScrollView();
   bool destination=RegionNodeTravelAllowed(node);var guidance=WayfindingView();bool selected=guidance!=null&&guidance.SelectedDestinationId==node.LevelId&&!wayfindingPending;
   if(destination){
    if(HudButton(new Rect(998,596,196,34),L("ui.region.preview_route"),CanSend()))RegionSelectNode(map,node);
    if(HudButton(new Rect(998,637,96,35),L("ui.region.show_floor"),selected&&guidance.Reachable))page="game";
    if(HudButton(new Rect(1100,637,94,35),L("ui.wayfinding.go"),CanSend()&&state!=null&&!state.Paused&&!loadingActive&&selected&&guidance.Reachable)){if(WayfindingGo())page="game";}
   }else GUI.Label(new Rect(998,601,196,60),node.Current?L("ui.region.current_place"):L("ui.region.landmark"),hudWrap);
  }

  void DrawRegionMap(){
