// barkNear: the walkable Life cell closest to `at` on the level.
func barkNear(t *testing.T, r *Runtime, level string, at behavior.Cell) behavior.Cell {
	t.Helper()
	for d := 0; d < 12; d++ {
		for dy := -d; dy <= d; dy++ {
			for dx := -d; dx <= d; dx++ {
				c := behavior.Cell{X: at.X + dx, Y: at.Y + dy}
				if r.world.Life.Walks(level, c) {
					return c
				}
			}
		}
	}
	t.Fatalf("no walkable cell near %v on %s", at, level)
	return at
}
func barkPut(t *testing.T, r *Runtime, id, level string, at behavior.Cell) {
	t.Helper()
	a := r.state.Life.Actor(id)
	if a == nil {
		t.Fatalf("no Life actor %s", id)
	}
	a.Level, a.Position, a.Path, a.Trip, a.ResidenceID, a.Arrived = level, at, nil, nil, "", true
	if id == playerActorID {
		r.syncLifeHero()
	}
}
func barkSpot(t *testing.T, r *Runtime, place, spot string) behavior.Cell {
	t.Helper()
	for _, p := range r.world.Life.Brain.Places {
		if p.ID == place && p.Seating != nil {
			if s, ok := p.Seating.Spot(spot); ok {
				return s.At
			}
		}
	}
	t.Fatalf("no spot %s of %s", spot, place)
	return behavior.Cell{}
}

