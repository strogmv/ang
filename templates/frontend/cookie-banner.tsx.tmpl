'use client';
import React, { useState, useEffect, useCallback } from 'react';

// ── Cookie category types ─────────────────────────────────────────────────────

export type CookieCategory = 'essential' | 'analytics' | 'marketing' | 'personalization';

export interface CookieCategoryDef {
  id: CookieCategory;
  label: string;
  description: string;
  required: boolean;
  examples: string[];
}

export const COOKIE_CATEGORIES: CookieCategoryDef[] = [
  {
    id: 'essential',
    label: 'Essential',
    description: 'Required for the site to function. Cannot be disabled.',
    required: true,
    examples: ['Session cookie', 'CSRF token', 'Auth token'],
  },
  {
    id: 'analytics',
    label: 'Analytics',
    description: 'Help us understand how visitors interact with the site (anonymized).',
    required: false,
    examples: ['Page views', 'Session duration', 'Error tracking'],
  },
  {
    id: 'marketing',
    label: 'Marketing',
    description: 'Used to deliver relevant ads and track campaign effectiveness.',
    required: false,
    examples: ['Ad click tracking', 'Retargeting'],
  },
  {
    id: 'personalization',
    label: 'Personalization',
    description: 'Remember your preferences and customise your experience.',
    required: false,
    examples: ['Language preference', 'Theme', 'Recently viewed'],
  },
];

// ── Persistence ───────────────────────────────────────────────────────────────

const CONSENT_COOKIE = 'ang_cookie_consent';
const CONSENT_VERSION = '1'; // bump when categories change

export type ConsentRecord = {
  version: string;
  timestamp: string;
  categories: Record<CookieCategory, boolean>;
};

export const readConsentRecord = (): ConsentRecord | null => {
  if (typeof document === 'undefined') return null;
  const match = document.cookie.match(new RegExp(`(?:^|; )${CONSENT_COOKIE}=([^;]*)`));
  if (!match) return null;
  try {
    const record: ConsentRecord = JSON.parse(decodeURIComponent(match[1]));
    if (record.version !== CONSENT_VERSION) return null; // stale consent
    return record;
  } catch {
    return null;
  }
};

export const writeConsentRecord = (categories: Record<CookieCategory, boolean>): void => {
  const record: ConsentRecord = {
    version: CONSENT_VERSION,
    timestamp: new Date().toISOString(),
    categories,
  };
  const expires = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString();
  document.cookie = `${CONSENT_COOKIE}=${encodeURIComponent(JSON.stringify(record))}; expires=${expires}; path=/; SameSite=Lax`;
};

export const hasConsented = (category: CookieCategory): boolean => {
  if (category === 'essential') return true;
  const record = readConsentRecord();
  return record?.categories[category] ?? false;
};

// ── CookieBanner component ────────────────────────────────────────────────────

interface CookieBannerProps {
  /** Called after user saves consent. Use to init analytics etc. */
  onConsent?: (categories: Record<CookieCategory, boolean>) => void;
  /** Render prop to show a custom banner UI. Falls back to built-in. */
  render?: (props: CookieBannerRenderProps) => React.ReactNode;
  /** Privacy policy URL */
  privacyPolicyUrl?: string;
}

interface CookieBannerRenderProps {
  categories: CookieCategoryDef[];
  selections: Record<CookieCategory, boolean>;
  toggle: (id: CookieCategory) => void;
  acceptAll: () => void;
  rejectOptional: () => void;
  savePreferences: () => void;
}

export const CookieBanner = ({ onConsent, render, privacyPolicyUrl = '/privacy' }: CookieBannerProps) => {
  const [visible, setVisible] = useState(false);
  const [expanded, setExpanded] = useState(false);
  const [selections, setSelections] = useState<Record<CookieCategory, boolean>>({
    essential: true,
    analytics: false,
    marketing: false,
    personalization: false,
  });

  useEffect(() => {
    if (!readConsentRecord()) setVisible(true);
  }, []);

  const save = useCallback((cats: Record<CookieCategory, boolean>) => {
    writeConsentRecord(cats);
    onConsent?.(cats);
    setVisible(false);
  }, [onConsent]);

  const acceptAll = useCallback(() => {
    const all = { essential: true, analytics: true, marketing: true, personalization: true };
    setSelections(all);
    save(all);
  }, [save]);

  const rejectOptional = useCallback(() => {
    const minimal = { essential: true, analytics: false, marketing: false, personalization: false };
    setSelections(minimal);
    save(minimal);
  }, [save]);

  const savePreferences = useCallback(() => save(selections), [save, selections]);

  const toggle = useCallback((id: CookieCategory) => {
    if (id === 'essential') return;
    setSelections((prev) => ({ ...prev, [id]: !prev[id] }));
  }, []);

  if (!visible) return null;

  if (render) {
    return <>{render({ categories: COOKIE_CATEGORIES, selections, toggle, acceptAll, rejectOptional, savePreferences })}</>;
  }

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-label="Cookie preferences"
      aria-describedby="cookie-banner-desc"
      style={{
        position: 'fixed', bottom: 0, left: 0, right: 0, zIndex: 9999,
        background: '#fff', borderTop: '1px solid #e5e7eb',
        padding: '1rem 1.5rem', boxShadow: '0 -2px 8px rgba(0,0,0,0.08)',
        maxHeight: '80vh', overflowY: 'auto',
      }}
    >
      <p id="cookie-banner-desc" style={{ margin: '0 0 0.5rem', fontSize: 14 }}>
        We use cookies to improve your experience.{' '}
        <a href={privacyPolicyUrl} style={{ color: '#2563eb' }}>Privacy Policy</a>
      </p>

      {expanded && (
        <div style={{ marginBottom: '0.75rem' }}>
          {COOKIE_CATEGORIES.map((cat) => (
            <label key={cat.id} style={{ display: 'flex', alignItems: 'flex-start', gap: 8, marginBottom: 8, cursor: cat.required ? 'default' : 'pointer' }}>
              <input
                type="checkbox"
                checked={selections[cat.id]}
                disabled={cat.required}
                onChange={() => toggle(cat.id)}
                aria-label={`${cat.label}: ${cat.description}`}
                style={{ marginTop: 2 }}
              />
              <span>
                <strong style={{ fontSize: 13 }}>{cat.label}{cat.required ? ' (required)' : ''}</strong>
                <br />
                <span style={{ fontSize: 12, color: '#6b7280' }}>{cat.description}</span>
              </span>
            </label>
          ))}
        </div>
      )}

      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
        <button onClick={acceptAll} style={{ padding: '6px 14px', background: '#2563eb', color: '#fff', border: 'none', borderRadius: 6, cursor: 'pointer', fontSize: 13 }}>
          Accept all
        </button>
        <button onClick={rejectOptional} style={{ padding: '6px 14px', background: '#f3f4f6', border: '1px solid #d1d5db', borderRadius: 6, cursor: 'pointer', fontSize: 13 }}>
          Essential only
        </button>
        {!expanded ? (
          <button onClick={() => setExpanded(true)} style={{ padding: '6px 14px', background: 'none', border: '1px solid #d1d5db', borderRadius: 6, cursor: 'pointer', fontSize: 13 }}>
            Manage preferences
          </button>
        ) : (
          <button onClick={savePreferences} style={{ padding: '6px 14px', background: '#f3f4f6', border: '1px solid #d1d5db', borderRadius: 6, cursor: 'pointer', fontSize: 13 }}>
            Save preferences
          </button>
        )}
      </div>
    </div>
  );
};

// ── CookieSettingsButton — re-open consent from footer ────────────────────────

export const useCookieConsent = () => {
  const [visible, setVisible] = useState(false);
  const openSettings = useCallback(() => setVisible(true), []);
  const onConsent = useCallback(() => setVisible(false), []);
  return { visible, openSettings, onConsent };
};
