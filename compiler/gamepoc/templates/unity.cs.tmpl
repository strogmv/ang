        void ProofStep()
        {
            double now = clock.Elapsed.TotalSeconds;
            if (verifySdk) SdkProofDiagnostics(now);
            if (verifyPainted) PaintedProofDiagnostics(now);
            if (verifyCopperRoute) CopperRouteProofDiagnostics(now);
            if (verifyAmbient) AmbientProofDiagnostics(now);
            if (now > (verifyLife ? 420 : 120)) { FinishProof(false, "proof timeout, phase=" + proofPhase + ", status=" + message); return; }
            if (!connected || state == null || !string.IsNullOrEmpty(busy)) return;
            if (verifyLocationSDK) { LocationSDKProofStep(now); return; }
            if (verifyAmbient) { AmbientProofStep(now); return; }
            if (verifyCopperRoute) { CopperRouteProofStep(now); return; }
            if (verifySdk) { SdkProofStep(now); return; }
            if (verifyPainted) { PaintedProofStep(now); return; }
            if (verifyLife) { LifeProofStep(now); return; }
            if (verifyInventory) { InventoryProofStep(); return; }
            if (verifyCapture) { CaptureProofStep(now); return; }
            switch (proofPhase)
            {
                case 0:
                    if (!Application.isBatchMode) { string output = ProofDirectory(); Directory.CreateDirectory(output); ScreenCapture.CaptureScreenshot(Path.Combine(output, "menu.png")); }
                    proofAt = now; proofPhase = 12; break;
                case 12: if (now - proofAt > .5) { NewGame(777); proofPhase = 1; } break;
                case 1: if (state.Active && state.Seed == 777 && state.Tick > 3) { ClickMove(3, 2); proofPhase = 2; } break;
                case 2: if (state.PlayerX == 3 && state.PlayerY == 2) { Options(true, 1); proofPhase = 3; } break;
                case 3: if (state.Paused) { savedTick = state.Tick; savedEpoch = state.Epoch; saveConfirmed = false; SaveOrLoad("slot3", true); proofPhase = 4; } break;
                case 4: if (saveConfirmed) { NewGame(999); proofPhase = 5; } break;
                case 5: if (state.Seed == 999 && state.Epoch != savedEpoch) { SaveOrLoad("slot3", false); proofPhase = 6; } break;
                case 6:
                    if (state.Seed == 777)
                    {
                        if (!state.Paused || state.Tick != savedTick || state.PlayerX != 3 || state.PlayerY != 2 || state.Epoch == savedEpoch) { FinishProof(false, "save/load mismatch"); return; }
                        Options(false, 1); proofPhase = 7;
                    }
                    break;
                case 7:
                    if (!state.Paused) { fps = 15; volume = .37f; ApplyDisplay(); proofTick = state.Tick; proofAt = now; proofPhase = 8; }
                    break;
                case 8:
                    if (now - proofAt >= 2)
                    {
                        if (state.Tick - proofTick < 10 || state.Tick - proofTick > 35) { FinishProof(false, "tick rate changed at low FPS"); return; }
                        proofLowFps = measuredFps;
                        proofTick = state.Tick; session.Dispose(); session = null; connected = false; proofAt = now; proofPhase = 9;
                    }
                    break;
                case 10:
                    if (state.Tick - proofTick < 8) { FinishProof(false, "world stopped without client"); return; }
                    fps = 144; ApplyDisplay(); proofTick = state.Tick; proofAt = now; proofPhase = 11; break;
                case 11:
                    if (now - proofAt >= 2)
                    {
                        if (state.Tick - proofTick < 10 || state.Tick - proofTick > 35) { FinishProof(false, "tick rate changed at high FPS"); return; }
                        if (Mathf.Abs(PlayerPrefs.GetFloat(Pref("volume")) - .37f) > .001f || PlayerPrefs.GetInt(Pref("fps")) != 144) { FinishProof(false, "options not persisted"); return; }
                        if (Application.isBatchMode) FinishProof(true, "functional checks passed; rendered input latency requires a windowed Player");
                        else { latencyRateIndex = 0; latencySamples = 0; proofAcks.Clear(); proofBegins.Clear(); fps = latencyRates[0]; ApplyDisplay(); latencyWait = now; proofPhase = 20; }
                    }
                    break;
                case 20:
                    if (now - latencyWait < .7 || state.Path.Count > 0) break;
                    ClickMove(state.PlayerX == 3 ? 2 : 3, 2); proofPhase = 21; break;
                case 21:
                    if (now - clickAt > 1) { FinishProof(false, "movement response timeout at " + fps + " FPS"); return; }
                    if (!latencyResultReady) break;
                    if (!moveAccepted || beginMS < 0) { FinishProof(false, "latency route rejected"); return; }
                    proofAcks.Add(ackMS); proofBegins.Add(beginMS); latencySamples++;
                    if (latencySamples < 32) { latencyWait = now - .7; proofPhase = 20; break; }
                    proofAcks.Sort(); proofBegins.Sort();
                    if (proofAcks[proofAcks.Count - 1] > resource.config.input_ack_budget_ms || proofBegins[proofBegins.Count - 1] > resource.config.input_ack_budget_ms) latencyWithinBudget = false;
                    if (latencyRateIndex > 0) latencyJSON += ",";
                    latencyJSON += "{\"fps_limit\":" + fps + ",\"samples\":" + latencySamples + ",\"ack_p95_ms\":" + Number(proofAcks[(int)Math.Ceiling(proofAcks.Count * .95) - 1]) + ",\"ack_max_ms\":" + Number(proofAcks[proofAcks.Count - 1]) + ",\"first_render_p95_ms\":" + Number(proofBegins[(int)Math.Ceiling(proofBegins.Count * .95) - 1]) + ",\"first_render_max_ms\":" + Number(proofBegins[proofBegins.Count - 1]) + "}";
                    latencyRateIndex++;
                    if (latencyRateIndex == latencyRates.Length)
                    {
                        latencyJSON += "]"; proofPhase = 22; ClickMove(0, 0); break;
                    }
                    fps = latencyRates[latencyRateIndex]; ApplyDisplay(); latencySamples = 0; proofAcks.Clear(); proofBegins.Clear(); latencyWait = now; proofPhase = 20; break;
                case 22:
                    if (!latencyResultReady) { if (now - clickAt > 1) FinishProof(false, "blocked route response timeout"); break; }
                    if (moveAccepted) { FinishProof(false, "blocked cell accepted"); break; }
                    FinishProof(latencyWithinBudget, latencyWithinBudget ? "functional checks, input latency within CUE budget at 40/60/144 FPS and blocked route feedback passed" : "input latency exceeded CUE budget; see per-FPS measurements"); break;
            }
        }

        static string Number(double value) => value.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);

        void LateUpdate()
        {
            // Receive again before rendering: a local server reply may arrive
            // after Update sent input. Keep callbacks on the Unity main thread.
            if (session != null) session.Pump(32);
            UpdateMotion();
            if (verify && proofPhase == 9 && clock.Elapsed.TotalSeconds - proofAt > 1.2 && session == null) { proofPhase = 10; Connect(); }
        }
        void FinishProof(bool ok, string detail)
        {
            if (closing) return;
            string destination = ProofDirectory();
            Directory.CreateDirectory(destination);
            string json = "{\"pass\":" + (ok ? "true" : "false") + ",\"detail\":\"" + detail.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", " ").Replace("\r", " ") + "\",\"saved_tick\":" + savedTick + ",\"final_tick\":" + (state == null ? 0 : state.Tick) + ",\"low_fps_observed\":" + proofLowFps.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + ",\"high_fps_observed\":" + measuredFps.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + ",\"server_hz\":" + (state == null ? "0" : state.ServerTickHz.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) + ",\"content_hash\":\"" + resource.content_hash + "\"}";
            if (latencyJSON.EndsWith("]")) json = json.Substring(0, json.Length - 1) + ",\"input_latency\":" + latencyJSON + "}";
            if (verifyCapture) json = json.Substring(0, json.Length - 1) + ",\"capture_demo\":" + CaptureReportJSON() + "}";
            if (verifySdk) json=json.Substring(0,json.Length-1)+",\"sdk\":"+SdkReportJSON()+"}";
            if (verifyLife) json = json.Substring(0,json.Length-1) + ",\"life\":" + LifeReportJSON() + "}";
            if (verifyPainted) json=json.Substring(0,json.Length-1)+",\"painted\":"+PaintedProofReportJSON()+"}";
            if (verifyCopperRoute) json=json.Substring(0,json.Length-1)+",\"copper_route\":"+CopperRouteProofReportJSON()+"}";
            if (verifyAmbient) json=json.Substring(0,json.Length-1)+",\"ambient\":"+AmbientProofReportJSON()+"}";
            if (verifyLocationSDK) json=json.Substring(0,json.Length-1)+",\"location_sdk\":"+LocationSDKProofReportJSON()+"}";
            File.WriteAllText(Path.Combine(destination, "report.json"), json);
            Debug.Log("POC_PROOF " + json); closing = true;
            if (!Application.isBatchMode) StartCoroutine(CaptureAndExit(ok, destination)); else ExitProof(ok);
        }
        string ProofDirectory()
        {
            if (verifyLocationSDK) return locationSDKProofDirectory;
            if (verifyAmbient) return ambientProofDirectory;
            if (verifyCopperRoute) return copperRouteProofDirectory;
            if (verifyPainted) return paintedProofDirectory;
            string result = Environment.GetEnvironmentVariable("ANG_POC_VERIFY_DIR");
            return string.IsNullOrEmpty(result) ? (verifySdk?Path.Combine(root,".local/sdk-visual"):Path.GetDirectoryName(dataDirectory)) : result;
        }
        IEnumerator CaptureAndExit(bool ok, string destination)
        {
            ScreenCapture.CaptureScreenshot(Path.Combine(destination, "game.png"));
            yield return new WaitForEndOfFrame();
            yield return new WaitForSecondsRealtime(.35f);
            ExitProof(ok);
        }
        void ExitProof(bool ok)
        {
            DisposeHost();
#if UNITY_EDITOR
            UnityEditor.EditorApplication.Exit(ok ? 0 : 1);
#else
            Application.Quit(ok ? 0 : 1);
#endif
        }
        void Quit()
        {
            closing = true; DisposeHost();
#if UNITY_EDITOR
            UnityEditor.EditorApplication.isPlaying = false;
#else
            Application.Quit();
#endif
        }
        void DisposeHost()
        {
            if (disposed) return; disposed = true; connected = false;
            if (session != null) session.Dispose();
            if (channel != null) channel.Dispose();
            if (http != null) http.Dispose();
            if (host != null)
            {
                try { host.StandardInput.Close(); if (!host.WaitForExit(1500)) host.Kill(); } catch (InvalidOperationException) { }
                host.Dispose();
            }
        }
        void OnApplicationQuit() { DisposeHost(); }
        void OnDestroy() { ReleaseLocationSDK(); DisposeHost(); }
    }
}
