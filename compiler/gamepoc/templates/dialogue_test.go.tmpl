func TestDialogueShownChanceIsTheRolledChance(t *testing.T) {
	r := dialogueCustody(t, nil)
	c := dialogueCheckedChoice(t, r)
	row := r.world.DialogueRules.Chance[c.Check.Difficulty]
	for _, skill := range []int{0, 10, 20, 25, 33, 60, 100} {
		dialogueSetSkill(r, c.Check.Skill, skill)
		for _, locale := range []string{"ru", "en"} {
			o := dialogueOption(t, dialogueView(t, r, locale), c.ID)
			if o == nil || int(o.Chance) != row[skill] || !strings.Contains(o.CheckLabel, strconv.Itoa(row[skill])) || o.CheckColour == "" || !o.Once || o.Locked {
				t.Fatalf("skill %d %s: shown %+v, table %d", skill, locale, o, row[skill])
			}
		}
	}
	dialogueSetSkill(r, c.Check.Skill, 20)
	shown := dialogueOption(t, dialogueView(t, r, "ru"), c.ID).Chance
	if err := r.encounterCommand(&pb.PocLifeCommand{Action: "encounter_choice", Destination: c.ID}); err != nil {
		t.Fatal(err)
	}
	talk := r.state.CalendarEncounter.Talk
	var check dialogueEntry
	for _, e := range talk.Lines {
		if e.Kind == "check" {
			check = e
		}
	}
	if check.Chance != int(shown) || check.Skill != c.Check.Skill || check.Difficulty != c.Check.Difficulty {
		t.Fatalf("rolled with %d, showed %d", check.Chance, shown)
	}
	if want := dialogueDie(r.state.Seed, r.state.CheckSeed, r.world.CalendarEncounter.ID, c.ID, 1) < check.Chance; check.Success != want || talk.Checks[c.ID].Success != want {
		t.Fatalf("the roll is not the server's die: %+v", check)
	}
}

func TestDialogueRollIsDeterministicAndBothOutcomesHappen(t *testing.T) {
	base := dialogueCustody(t, nil)
	c := dialogueCheckedChoice(t, base)
	// one runtime per world, every seed from the same return-day state
	runs := [2]*Runtime{encounterFixture(t), encounterFixture(t)}
	outcomes := map[bool]int{}
	// the world's seed stays; the game's own check value decides the roll
	for seed := int64(1); seed <= 64; seed++ {
		for _, r := range runs {
			r.state = base.snapshotState()
			r.state.CheckSeed = seed
			if err := r.encounterCommand(&pb.PocLifeCommand{Action: "encounter_choice", Destination: c.ID}); err != nil {
				t.Fatal(err)
			}
		}
		a, b := runs[0].state.CalendarEncounter, runs[1].state.CalendarEncounter
		if !reflect.DeepEqual(a, b) {
			t.Fatalf("seed %d: the same world rolled differently", seed)
		}
		success := a.Talk.Checks[c.ID].Success
		outcomes[success]++
		want, reply := c.Outcome, c.Reply
		if !success {
			want, reply = c.Fail.Outcome, c.Fail.Reply
		}
		last := a.Talk.Lines[len(a.Talk.Lines)-1]
		if a.Choice != c.ID || a.Outcome != want || last.Text != reply[len(reply)-1].Text || a.ReplyKey != last.Text {
			t.Fatalf("seed %d success=%v: choice %s outcome %s reply %s", seed, success, a.Choice, a.Outcome, last.Text)
		}
		if err := runs[0].validateEncounterSave(runs[0].state); err != nil {
			t.Fatalf("seed %d: a resolved check does not validate: %v", seed, err)
		}
		// the reply's header is who spoke last
		if v := dialogueView(t, runs[0], "ru"); v.Kind != "reply" || v.Speaker != reply[len(reply)-1].Speaker {
			t.Fatalf("seed %d: the reply's speaker is %s, the last line's %s", seed, v.Speaker, reply[len(reply)-1].Speaker)
		}
	}
	if outcomes[true] == 0 || outcomes[false] == 0 {
		t.Fatalf("64 seeds at %d%% gave only one outcome: %v", base.dialogueChance(*c.Check), outcomes)
	}
}

