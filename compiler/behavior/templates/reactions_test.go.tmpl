  if ok!=wantOK||!reflect.DeepEqual(got,want)||!reflect.DeepEqual(contact,wantContact){t.Fatalf("case %d changed assignment: %v/%v vs %v/%v",scenario,got,contact,want,wantContact)}
 }
}
