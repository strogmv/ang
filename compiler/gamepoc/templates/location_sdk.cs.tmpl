   Vector3 right=new Vector3(.7071068f,0,-.7071068f),feet=new Vector3(LocationSDKCellCenter(position.x,locationSDKLevel.cell_meters),locationSDKLevel.elevation*locationSDKLevel.cell_meters+.01f,LocationSDKCellCenter(position.y,locationSDKLevel.cell_meters));
