 svc:=LifeBrainServices{Offers:func(_,kind,_ string)[]LifeAffordance{if kind!="seated_food"{return nil};return []LifeAffordance{{ID:"yatai",Kind:kind,Level:"market"}}},
  Buy:func(_ string,p LifeAffordance,food bool)bool{bought++;return food&&p.Kind=="seated_food"},
