func TestPopulationRuntimeCloneAndCrossKernelCollision(t *testing.T) {
	r := populationRuntimeFixture(t, 100)
	clone := r.state.Life.Clone()
	clone.Population.Actors[0].Visits[clone.Population.Actors[0].Level]++
	if reflect.DeepEqual(clone.Population.Actors[0].Visits, r.state.Life.Population.Actors[0].Visits) {
		t.Fatal("clone aliases population visits")
	}
	var physical *behavior.PopulationActor
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if a.Materialized {
			physical = a
			break
		}
	}
	if physical == nil {
		t.Fatal("no materialized residents")
	}
	hero := r.state.Life.Actor(playerActorID)
	hero.Level = physical.Level
	hero.Position = physical.Position
	hero.Path = nil
	r.syncLifeHero()
	if r.validateLifeSave(r.state) == nil {
		t.Fatal("save accepted named/population overlap")
	}
}
func TestPopulationRuntimeHeroCannotClaimReservedStep(t *testing.T) {
	r := populationRuntimeFixture(t, 100)
	hero := r.state.Life.Actor(playerActorID)
	var target behavior.Cell
	var residentID string
	found := false
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if !a.Materialized || a.Level != hero.Level {
			continue
		}
		blocked := r.state.Life.BlockedCells(a.Level, "")
		for _, at := range []behavior.Cell{{X: a.Position.X + 1, Y: a.Position.Y}, {X: a.Position.X, Y: a.Position.Y + 1}, {X: a.Position.X - 1, Y: a.Position.Y}, {X: a.Position.X, Y: a.Position.Y - 1}} {
			if r.world.Life.Walks(a.Level, at) && !blocked[at] {
				a.Path = []behavior.Cell{at}
				a.Goal = at
				target = at
				residentID = a.ID
				found = true
				break
			}
		}
		if found {
			break
		}
	}
	if !found {
		t.Fatal("fixture has no free neighboring cell")
	}
	c := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{})}
	before := hero.Position
	r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1, X: int32(target.X), Y: int32(target.Y)})
	result := (<-c.out).GetMoveResult()
	// A future intention can be accepted, but cannot claim somebody else's
	// physical next step. Rejecting the whole command would reveal unseen traffic.
	if result == nil || !result.Ok || hero.Position != before || (len(hero.Path)>0 && hero.Path[0]==target) {
		t.Fatal("intent rejected hidden traffic or claimed population reservation")
	}
	for _,a:=range r.state.Life.Population.Actors{if a.ID==residentID&&(len(a.Path)==0||a.Path[0]!=target){t.Fatal("input cancelled the resident's accepted segment")}}
	r.state.Life.SecondsPerTick=1
	for i:=0;i<24;i++{r.step();if err:=r.validateLifeSave(r.snapshotState());err!=nil{t.Fatalf("tick %d: %v",r.state.Tick,err)}}
}
func TestPopulationRuntimeViewFiltersHiddenResidents(t *testing.T) {
	r := populationRuntimeFixture(t, 300)
	r.world.Config.DebugPerception = true
	c := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{})}
	r.sendState(c)
	msg := (<-c.out).GetGameState()
	if msg == nil || msg.PlayerView == nil || len(msg.DebugViews) > 0 {
		t.Fatal("mass population calculated full debug observer views")
	}
	for _, a := range msg.SceneAgents {
		if !viewSees(msg.PlayerView, a.X, a.Y) {
			t.Fatal("hidden population leaked")
		}
	}
	hero := r.state.Life.Actor(playerActorID)
	edge := r.world.Life.NextEdge(hero.Level, r.world.Life.Population.Stages[1].Level)
	if edge != nil && edge.From == hero.Level {
		hero.Position = edge.Exit
		hero.Trip = &behavior.LifeTrip{Edge: edge.ID, Departure: r.state.Life.Seconds, Arrival: r.state.Life.Seconds + edge.TravelSeconds}
		hero.Path = nil
		r.syncLifeHero()
		r.sendState(c)
		msg = (<-c.out).GetGameState()
		if len(msg.SceneAgents) != 0 {
			t.Fatal("transit disclosed destination residents")
		}
	}
}

