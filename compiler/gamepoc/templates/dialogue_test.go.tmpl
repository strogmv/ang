// Every answer of the custody changes the world by its data: the outcome, the rating (refusing, the gate), the trust of
// the person (the custody's cost; a heard lie costs more), who leads him, and the facts its effects name (doc 103: a
// fact per answer, with who knew it at once).
func TestDialogueAnswersChangeTheWorldByTheirData(t *testing.T) {
	probe := dialogueCustody(t, nil)
	e := probe.world.CalendarEncounter
	type answer struct {
		id     string
		failed bool
	}
	cases := []answer{}
	for _, o := range custodyNode(t, probe).Options {
		if o.Close == "" {
			continue
		}
		cases = append(cases, answer{o.ID, false})
		if o.Check != nil {
			cases = append(cases, answer{o.ID, true})
		}
	}
	for _, a := range cases {
		name := a.id
		if a.failed {
			name += "/failed"
		}
		t.Run(name, func(t *testing.T) {
			r := dialogueCustody(t, nil)
			var o convOption
			for _, option := range custodyNode(t, r).Options {
				if option.ID == a.id {
					o = option
				}
			}
			ctx, _ := r.talkOpenNow()
			if !r.optionShown(ctx, o) {
				// an answer for people who know each other: the acquaintance first
				r.memoryWrite(r.encounterMetFact(), map[string]string{"how": "greeted"}, talkCtx{self: e.Actor})
				if !r.optionShown(ctx, o) {
					t.Skipf("answer %s is not offered here", o.ID)
				}
			}
			c := encounterChoiceOf(r, o.Close)
			if o.Check != nil {
				r.state.CheckSeed = seedFor(r, custodyKey(r), o.ID, *o.Check, a.failed)
			}
			effects := o.Do
			if a.failed {
				effects = o.Fail.Do
			}
			want := map[string]bool{}
			for _, d := range effects {
				if d.Fact != "" && r.memoryHolds(ctx, d.When) {
					want[d.Fact] = true
				}
			}
			had := map[string]bool{}
			for id := range r.state.Memory.Facts {
				had[id] = true
			}
			rating := r.state.Crafting.Law.Trust
			trust := r.state.Life.RelationTo(r.world.Life, e.Actor, playerActorID)
			if err := choose(r, o.ID); err != nil {
				t.Fatal(err)
			}
			s := r.state.CalendarEncounter
			outcome, cost := c.Outcome, 0.0
			if a.failed {
				outcome, cost = c.Fail.Outcome, c.Fail.TrustCost
			}
			if outcome == "willing" || outcome == "forced" {
				cost += e.Duty.TrustCost
			}
			if s.Outcome != outcome {
				t.Fatalf("outcome %s, want %s", s.Outcome, outcome)
			}
			wantRating := rating
			if outcome == "refuse" || outcome == "escape" {
				wantRating = max(0, rating-e.Duty.RatingPenalty)
			}
			if r.state.Crafting.Law.Trust != wantRating {
				t.Fatalf("rating %d, want %d", r.state.Crafting.Law.Trust, wantRating)
			}
			if got := r.state.Life.RelationTo(r.world.Life, e.Actor, playerActorID); got < max(-1, trust+cost)-1e-9 || got > max(-1, trust+cost)+1e-9 {
				t.Fatalf("trust %.3f, want %.3f (before %.3f, cost %.3f)", got, max(-1, trust+cost), trust, cost)
			}
			if led := r.guardEscortTarget(e.Guard); (outcome == "forced" || outcome == "refuse") != (led == e.Actor) {
				t.Fatalf("outcome %s: the guard leads %q", outcome, led)
			}
			if a.failed && cost >= e.Duty.TrustCost {
				t.Fatal("a heard lie costs no more trust than the custody")
			}
			if len(want) == 0 {
				t.Fatal("an answer of the custody writes no fact")
			}
			for fact := range want {
				rec, ok := r.state.Memory.Facts[fact]
				if !ok || rec.Count != 1 || rec.Second != r.state.Life.Seconds {
					t.Fatalf("fact %s not written once now: %+v", fact, rec)
				}
				def := r.world.Memory.Facts[fact]
				for _, who := range def.KnownBy {
					if !r.memoryKnows(talkCtx{self: e.Actor}.person(who), fact) {
						t.Fatalf("fact %s: %s should know it at once", fact, who)
					}
				}
				if def.Visibility == "private" && len(rec.Witnesses) != len(def.KnownBy) {
					t.Fatalf("private fact %s has witnesses %v", fact, rec.Witnesses)
				}
			}
			for id := range r.state.Memory.Facts {
				if !want[id] && !had[id] {
					t.Fatalf("answer %s wrote fact %s, not in its data", o.ID, id)
				}
			}
		})
	}
}

// The timeout of the custody is the conversation's event: the guard's line, its facts, the forced outcome.
func TestDialogueCustodyTimeoutWritesItsFacts(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	ev := custodyConv(r).Events["timeout"]
	if ev == nil {
		t.Skip("no timeout event")
	}
	r.state.CalendarEncounter.Assigned = r.state.Life.Seconds - e.Duty.TimeoutSeconds
	r.calendarEncounterAfterFrame()
	if s := r.state.CalendarEncounter; s.Choice != "timeout" || s.Outcome != "forced" {
		t.Fatalf("the timeout did not force: %+v", s)
	}
	for _, d := range ev.Do {
		if _, ok := r.state.Memory.Facts[d.Fact]; d.Fact != "" && !ok {
			t.Fatalf("the timeout did not write %s", d.Fact)
		}
	}
	lines := custodyTalk(r).Lines
	if last := lines[len(lines)-1]; last.Text != ev.Lines[len(ev.Lines)-1].Text {
		t.Fatalf("the timeout's line is %s", last.Text)
	}
}

// A new game draws its own check value; a fixed one is taken only in a debug build (proofs).
func TestDialogueNewGameCheckValue(t *testing.T) {
	// the real draw for this test: a new game's own value
	fixed := drawCheckSeed
	drawCheckSeed = newCheckSeed
	defer func() { drawCheckSeed = fixed }()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	c := &connection{out: make(chan *pb.ServerMessage, 256), stop: make(chan struct{})}
	games := 0
	start := func(value int64) {
		// each its own request: a repeated request id is answered from its receipt, not run again
		games++
		r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: fmt.Sprintf("check.new.%d", games), Scenario: "life", Seed: 777, CheckSeed: value}}}})
	}
	r.canonicalWorld.Config.DebugPerception = true
	start(5)
	if r.state.CheckSeed != 5 {
		t.Fatalf("a debug build did not take the fixed value: %d", r.state.CheckSeed)
	}
	start(0)
	drawn := r.state.CheckSeed
	if drawn <= 0 || drawn == 5 {
		t.Fatalf("a new game did not draw its own value: %d", drawn)
	}
	r.canonicalWorld.Config.DebugPerception = false
	epoch := r.state.Epoch
	start(9)
	if r.state.CheckSeed == 9 || r.state.Epoch != epoch {
		t.Fatal("a release build took a fixed check value")
	}
	// a save from before the value: derived from its epoch, the same at every load
	s := r.snapshotState()
	s.CheckSeed = 0
	migrateCheckSeed(&s)
	again := r.snapshotState()
	again.CheckSeed = 0
	migrateCheckSeed(&again)
	if s.CheckSeed <= 0 || s.CheckSeed != again.CheckSeed {
		t.Fatalf("an old save's check value is not stable: %d %d", s.CheckSeed, again.CheckSeed)
	}
	other := r.snapshotState()
	other.CheckSeed, other.Epoch = 0, other.Epoch+"x"
	migrateCheckSeed(&other)
	if other.CheckSeed == s.CheckSeed {
		t.Fatal("two games derived the same check value")
	}
}

// Asking a plain question again writes nothing twice: its answer is already in the log.
func TestDialogueAskingAgainWritesNothingTwice(t *testing.T) {
	r := dialogueCustody(t, nil)
	q := custodyQuestions(t, r)[0]
	if err := choose(r, q.ID); err != nil {
		t.Fatal(err)
	}
	lines := len(custodyTalk(r).Lines)
	facts, _ := json.Marshal(r.state.Memory.Facts)
	for i := 0; i < 80; i++ {
		if err := choose(r, q.ID); err != nil {
			t.Fatal(err)
		}
	}
	again, _ := json.Marshal(r.state.Memory.Facts)
	if got := len(custodyTalk(r).Lines); got != lines || string(facts) != string(again) {
		t.Fatalf("asking again wrote %d more lines or changed the facts", got-lines)
	}
}
