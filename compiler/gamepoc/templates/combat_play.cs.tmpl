   AudioClip clip;if(!combatAudioClips.TryGetValue(cue.clip,out clip)){clip=Resources.Load<AudioClip>(cue.clip);combatAudioClips[cue.clip]=clip;if(clip==null)Debug.LogWarning("ANG combat: sound file missing "+cue.clip);}if(clip==null)return;
   AudioSource src=null;foreach(var x in combatAudio)if(x!=null&&!x.isPlaying){src=x;break;}if(src==null){var go=new GameObject("combat sound");go.transform.SetParent(transform,false);src=go.AddComponent<AudioSource>();src.playOnAwake=false;src.spatialBlend=0;src.bypassReverbZones=true;combatAudio.Add(src);}
   src.clip=clip;src.volume=Mathf.Clamp01(cue.volume);src.Play();CombatM1Sound(cue.key,cue.clip);
