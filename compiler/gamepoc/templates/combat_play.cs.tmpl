   Dictionary<string,float> lengths;if(!combatClipLengths.TryGetValue(an.runtimeAnimatorController,out lengths)){lengths=new Dictionary<string,float>(StringComparer.Ordinal);foreach(var c in an.runtimeAnimatorController.animationClips)if(c!=null)lengths[c.name]=c.length;combatClipLengths[an.runtimeAnimatorController]=lengths;}
