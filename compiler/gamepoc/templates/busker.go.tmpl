// buskerPlanOf: the plan of a day.
func (r *Runtime) buskerPlanOf(day int64) buskerPlan {
	if r.busker.ready && r.busker.plan.Day == day && r.busker.seed == r.state.Seed {
		return r.busker.plan
	}
	b := r.world.Busker
	d := b.Day
	p := buskerPlan{Day: day}
	p.Absent = int64(r.buskerDraw(day, "absent")%1000) < d.AbsentPermille
	p.Arrive = buskerSpan(r.buskerDraw(day, "arrive"), buskerRange{d.Arrive.From, d.Arrive.To})
	p.Leave = buskerSpan(r.buskerDraw(day, "leave"), buskerRange{d.Leave.From, d.Leave.To})
	p.Depart = p.Arrive - d.LeadSeconds
	used := make([]int, len(d.Breaks))
	t := p.Arrive
	for k := 0; t < p.Leave && k < 64; k++ {
		set := buskerSpan(r.buskerDraw(day, fmt.Sprintf("set.%d", k)), d.SetSeconds)
		if t+set >= p.Leave-d.SetSeconds.Min/2 {
			p.Blocks = append(p.Blocks, buskerBlock{Kind: "set", From: t, To: p.Leave, Break: -1})
			break
		}
		p.Blocks = append(p.Blocks, buskerBlock{Kind: "set", From: t, To: t + set, Break: -1})
		t += set
		// a break by the weights of those still allowed today
		total := int64(0)
		for i, br := range d.Breaks {
			if used[i] < br.MaxPerDay {
				total += br.Weight
			}
		}
		if total == 0 {
			continue
		}
		pick := int64(r.buskerDraw(day, fmt.Sprintf("break.%d", k)) % uint64(total))
		chosen := -1
		for i, br := range d.Breaks {
			if used[i] >= br.MaxPerDay {
				continue
			}
			if pick < br.Weight {
				chosen = i
				break
			}
			pick -= br.Weight
		}
		br := d.Breaks[chosen]
		n := buskerSpan(r.buskerDraw(day, fmt.Sprintf("break.%d.len", k)), br.Seconds)
		if t+n+d.SetSeconds.Min/2 >= p.Leave {
			// no break right before he packs up: the last set runs to the end
			p.Blocks[len(p.Blocks)-1].To = p.Leave
			break
		}
		used[chosen]++
		p.Blocks = append(p.Blocks, buskerBlock{Kind: br.ID, From: t, To: t + n, Break: chosen})
		t += n
	}
	r.busker.plan, r.busker.ready, r.busker.seed = p, true, r.state.Seed
	return p
}

// buskerBlockAt: the block of the plan at a second of the day (-1: none).
func buskerBlockAt(p buskerPlan, clock int64) int {
	for i, bl := range p.Blocks {
		if clock >= bl.From && clock < bl.To {
			return i
		}
	}
	return -1
}

// buskerWant: where the plan wants him now — "home", "spot" (on his way to it or set up: a set, a rest, a tea break with no
// free stool) or a break place — and the block.
func (r *Runtime) buskerWant() (string, int, buskerPlan) {
	b := r.world.Busker
	now := r.state.Life.Seconds
	day, clock := now/86400, now%86400
	p := r.buskerPlanOf(day)
	if p.Absent || clock < p.Depart || clock >= p.Leave {
		return "home", -1, p
	}
	if clock < p.Arrive {
		return "spot", -1, p
	}
	i := buskerBlockAt(p, clock)
	if i < 0 {
		return "home", -1, p
	}
	bl := p.Blocks[i]
	switch bl.Kind {
	case "set", "rest":
		return "spot", i, p
	case "tea":
		s := &r.state.Busker
		marker := day*1000 + int64(i) + 1
		if s.SeatFor != marker {
			// the first stool of the break that nobody holds now; none: he stays at the spot and rests
			s.SeatFor, s.Seat = marker, -1
			br := b.Day.Breaks[bl.Break]
			taken := r.npcSeatsTaken(br.At.Level, br.Place, b.Actor)
			for k, c := range br.SeatCells {
				if !taken[c.cell()] {
					s.Seat = k + 1
					break
				}
			}
		}
		if s.Seat < 1 {
			return "spot", i, p
		}
		return "tea", i, p
	}
	return bl.Kind, i, p
}

