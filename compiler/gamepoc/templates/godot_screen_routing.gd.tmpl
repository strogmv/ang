# Generated by ANG. Opening conditions and shortcuts are catalog data.
extends RefCounted
const C = preload("res://generated/game_contract.gd")
const Catalog = preload("res://generated/screens/catalog.gd")
## The input actions (world.input_actions): a screen's shortcut is an action's key and button
const Keys = preload("res://generated/input_actions.gd")
var app
var auto_screens := {}
func _init(host) -> void:
	app = host
func reset() -> void:
	auto_screens.clear()

func server_screens(received_us := 0) -> void:
	if app.game_state == null or not app.playing:
		return
	for entry in Catalog.specification().screens:
		if not entry.has("opening"):
			continue
		var trigger = Catalog.read(entry.opening.ref, app.game_state, null, {})
		if trigger == null or (trigger is bool and not trigger):
			auto_screens.erase(entry.id)
			if app.game_ui.visible and app.game_ui.screen_id == entry.id:
				app.game_ui._close()
			continue
		if (not app.screen_open or (entry.get("opening_mode", "") == "replace" and
			app.game_ui.screen_id != entry.id)) and \
			not C.ProtoMessage.same_value(auto_screens.get(entry.id), trigger):
			auto_screens[entry.id] = trigger
			app.open_game_screen(entry.id, received_us)

## A screen's shortcut, asked with the context of what is on screen: where a precedence rule puts that screen's own
## action first (a fight's Y ends the turn), the shortcut steps aside.
func shortcut(event: InputEvent) -> bool:
	if not (event is InputEventKey or event is InputEventJoypadButton):
		return false
	var context := input_context()
	for entry in Catalog.specification().screens:
		if entry.has("shortcut") and Keys.pressed(event, entry.shortcut.action, false, context):
			app.open_game_screen(entry.id)
			return true
	return false

## The input context of what is on screen: the open screen's (world.input_actions screens), else the world.
func input_context() -> String:
	if app.screen_open and is_instance_valid(app.game_ui) and app.game_ui.visible:
		return Keys.screen_context(str(app.game_ui.screen_id))
	return "world"


func foreground_control(event: InputEvent) -> bool:
	if app.screen_open:
		return false
	var key: bool = event is InputEventKey and Keys.event_is(event, Keys.MENU_CONFIRM)
	var pad: bool = event is InputEventJoypadButton and Keys.event_is(event, Keys.MENU_CONFIRM)
	if not key and not pad:
		return false
	var focus: Control = app.get_viewport().gui_get_focus_owner()
	if focus is Button and focus.is_visible_in_tree() and not focus.disabled:
		if event.pressed and (not key or not event.echo):
			focus.pressed.emit()
		return true
	return false
