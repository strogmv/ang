func buskerWorld(t testing.TB, rate int64) *Runtime {
	t.Helper()
	r := worldAuditRuntime(t, 0)
	if !r.buskerOn() {
		t.Skip("the world has no street musician")
	}
	r.state.Life.SecondsPerTick = rate
	return r
}

// buskerRunTo: the world runs at its rate to a second of the day (the next time it comes).
func buskerRunTo(t testing.TB, r *Runtime, clock int64, each func()) {
