func TestCombatPaceIndependentTurns(t *testing.T) {
 cfg:=paceProjectionGeometry()
 groupsFor:=func(events []behavior.CombatEvent,turn int64)map[int64]int64{return combatPlaybackGroups(events,turn,cfg)}
 move:=func(turn int64,id string,x,y int)[]behavior.CombatEvent{return []behavior.CombatEvent{{Type:"move",ActorID:id,Turn:turn,From:behavior.Cell{X:x,Y:y},To:behavior.Cell{X:x+1,Y:y}},{Type:"end",ActorID:id,Turn:turn}}}
 base:=[]behavior.CombatEvent{};for i,id:=range []string{"npc.a","npc.b","npc.c","npc.d"}{base=append(base,move(int64(i+2),id,0,i*4)...)}
 
 auto:=[]behavior.CombatEvent{};for _,e:=range base{if e.Type=="move"{auto=append(auto,e)}}
 if len(groupsFor(auto,6))!=4{t.Fatal("AP-exhausted turns have no end event but must still overlap")}
 if len(groupsFor(auto[:1],2))!=0{t.Fatal("current undecided turn must not overlap")}
 before:=append([]behavior.CombatEvent(nil),base...)
 got:=groupsFor(base,0)
 if len(got)!=4 {t.Fatal("four independent turns must batch",got)}
 for turn:=int64(2);turn<=5;turn++ {if got[turn]!=2 {t.Fatal("unstable batch",got)}}
 if !reflect.DeepEqual(before,base)||!reflect.DeepEqual(got,groupsFor(base,0)){t.Fatal("projection mutated combat or is nondeterministic")}
 for _,kind:=range []string{"attack","reaction","overwatch","fall_shift","stunned","equip","report","invalid"}{
  events:=append([]behavior.CombatEvent(nil),base...);events[2].Type=kind
  groups:=groupsFor(events,0);if groups[2]!=0||groups[3]!=0{t.Fatal("interaction must be a barrier",kind,groups)}
 }
 for _,test:=range []struct{name string;change func([]behavior.CombatEvent)}{
  {"crossing paths",func(e []behavior.CombatEvent){e[2].From=e[0].To;e[2].To=e[0].From}},
  {"nearby bodies",func(e []behavior.CombatEvent){e[2].From=behavior.Cell{X:0,Y:1};e[2].To=behavior.Cell{X:1,Y:1}}},
  {"hero",func(e []behavior.CombatEvent){e[2].ActorID=playerActorID;e[3].ActorID=playerActorID}},
  {"repeat actor",func(e []behavior.CombatEvent){e[2].ActorID=e[0].ActorID;e[3].ActorID=e[0].ActorID}},
  {"target interaction",func(e []behavior.CombatEvent){e[2].TargetID="npc.a"}},
  {"incomplete turn",func(e []behavior.CombatEvent){e[3].Type="move"}},
 }{events:=append([]behavior.CombatEvent(nil),base...);test.change(events);if g:=groupsFor(events,0);g[2]!=0{t.Fatal(test.name,g)}}
 if len(groupsFor([]behavior.CombatEvent{{Type:"end",ActorID:"npc.idle",Turn:2}},0))!=0{t.Fatal("idle turn must not create playback")}
}


