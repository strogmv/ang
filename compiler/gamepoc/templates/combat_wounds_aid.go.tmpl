			score := 20.0
			if combatWounds.Status(body).ExternalULS > 0 {
				score = 100
			}
			out = append(out, behavior.CombatCandidate{Action: action, Score: score, Reason: fmt.Sprintf("treat own wound with carried %s", spec.kind), AP: min(c.AP, plan.RemainingS)})
