	return r.advanceCombatAI()
}
func (r *Runtime) combatMove(c *connection, m *pb.MoveTo) {
	result := &pb.PocMoveResult{Epoch: r.state.Epoch, InputSeq: m.InputSeq}
	target := behavior.Cell{X: int(m.X), Y: int(m.Y)}
	deckOK := m.Deck == 0
	if volume := r.deckVolume(); volume != nil {
		deck, ok := volume.SurfaceIndex(target)
		deckOK = ok && int32(deck) == m.Deck
	}
	if !deckOK {
		result.Reason = "invalid_deck"
	} else if m.Epoch != r.state.Epoch || m.InputSeq == 0 || m.InputSeq <= c.lastMoveSeq {
		result.Reason = "stale_input"
	} else {
		c.lastMoveSeq = m.InputSeq
		q := &pb.PocCombatCommand{Action: "move", X: m.X, Y: m.Y, ExpectedTurn: r.state.Combat.Turn}
		if err := r.combatCommand(q); err != nil {
			result.Reason = "combat_action_rejected"
		} else {
			result.Ok = true
			r.state.LastMoveSeq = m.InputSeq
		}
	}
	r.send(c, &pb.ServerMessage{Msg: &pb.ServerMessage_MoveResult{MoveResult: result}})
	r.sendState(c)
}

// Commit the tactical action and physical equipment wear together. A rejected
// use leaves HP/AP, random counter and the inventory transaction cursor intact.
func (r *Runtime) commitCombat(candidate behavior.CombatState) error {
 trial:=&Runtime{world:r.world,state:r.snapshotState(),npcAccountIDs:r.npcAccountIDs}
 if err:=trial.commitCombatDraft(candidate,r.state.Combat.Clone(),nil);err!=nil{return err}
 r.state=trial.state;return nil
}

func(r *Runtime)performCombatAction(actor string,action *behavior.CombatAction)error{
 previous:=r.state.Combat.Clone()
 trial:=&Runtime{world:r.world,state:r.snapshotState(),npcAccountIDs:r.npcAccountIDs}
 if action==nil{draft:=previous.Clone();decision:=draft.Decide(trial.combatSpace(draft),trial.world.CombatRuntime.Rules);if decision.Chosen.Action.Type=="aid"||decision.Chosen.Action.Type=="aid_continue"{q:=decision.Chosen.Action;action=&q;actor=draft.Current().ID}}
 if action!=nil&&(action.Type=="aid"||action.Type=="aid_continue"||action.Type=="bandage"||action.Type=="heal"){
  q:=*action;if q.Type!="aid"&&q.Type!="aid_continue"{q.TargetID="";q.Mode="dressing";if q.Type=="heal"{q.Mode="medkit";q.ItemID="item.medkit_guard"}}
  if err:=trial.performWoundAid(actor,q,true);err!=nil{return err};r.state=trial.state;return nil
 }
 candidate:=previous.Clone();space:=trial.combatSpace(candidate)
 var impactErr error
 space.ApplyImpact=func(s *behavior.CombatState,source,target,part,mode string)int{if impactErr!=nil{return 0};amount,err:=trial.applyWoundImpact(s,source,target,part,mode);if err!=nil{impactErr=err};return amount}
 if action==nil||action.Type!="end"{trial.releaseWoundPressure(&candidate,actor)}
 applied:=map[uint64]bool{};var shotErr error
 space.AfterShot=func(s *behavior.CombatState,e behavior.CombatEvent){
  if shotErr!=nil{return}
  // Every physical projectile commits its consequences on THIS draft before
  // the executor considers a following reaction or burst projectile.
  item,_,ok:=trial.equippedCombatItem(trial.state.Inventory,e.ActorID)
  if !ok{shotErr=errors.New("shot weapon missing");return}
  if err:=trial.applyCombatResources(&trial.state.Inventory,*s,e);err!=nil{shotErr=err;return}
  applied[e.Sequence]=true
  trial.state.Combat=*s
  if e.ActorID==playerActorID{
   witnesses:=s.Clone()
   trial.craftingShotHook(item.ID,trial.combatShotGuards(witnesses,e))
  }
  if err:=trial.combatCraftingUse(item.ID,e.ActorID,true);err!=nil{shotErr=err;return}
  *s=trial.state.Combat
  if trial.state.Crafting.Law.Hacked[item.ID].Jammed{a:=s.Actor(e.ActorID);a.WeaponUsesLimited=true;a.WeaponUsesRemaining=0;a.Overwatch=false;a.Guarding=false;a.ReservedAP=0}
 }
 var err error
 if action!=nil&&action.Type=="assault"{err=candidate.ExecuteAssault(space,trial.world.CombatRuntime.Rules,actor,*action)}else if action==nil{err=candidate.StepAI(space,trial.world.CombatRuntime.Rules)}else{err=candidate.Execute(space,trial.world.CombatRuntime.Rules,actor,*action)}
 if err!=nil{return err};if shotErr!=nil{return shotErr};if impactErr!=nil{return impactErr}
 if err=trial.commitCombatDraft(candidate,previous,applied);err!=nil{return err}
 r.state=trial.state;return nil
}

func(r *Runtime)commitCombatDraft(candidate,previous behavior.CombatState,applied map[uint64]bool)error{
 for _,event:=range candidate.Events{
  if event.Sequence<=previous.EventSeq||applied[event.Sequence]{continue}
  if event.AmmoSpent>0{item,_,ok:=r.equippedCombatItem(r.state.Inventory,event.ActorID);if ok&&r.state.Crafting.Law.Hacked[item.ID].By!=""{return errors.New("hacked shot bypassed per-projectile executor")}}
  if event.AmmoSpent>0||event.MedkitsSpent>0||event.ItemsSpent>0||event.WeaponUses>0||event.ArmorBlocked>0||event.Type=="reload"||event.Type=="equip"{
   if err:=r.applyCombatResources(&r.state.Inventory,previous,event);err!=nil{return err}
  }
 }
 r.state.Combat=candidate
 for i:=range r.state.Combat.Actors{
  a:=&r.state.Combat.Actors[i];actual:=cloneCombatant(*a);r.refreshCombatEquipment(r.state.Inventory,&actual)
  if actual.BodyArmor!=a.BodyArmor||actual.Weapon.ID==a.Weapon.ID&&(actual.Ammo!=a.Ammo||actual.ReserveAmmo!=a.ReserveAmmo||actual.Medkits!=a.Medkits){return errors.New("combat counters differ from physical custody")}
  a.BodyArmor=actual.BodyArmor;a.Weapon=actual.Weapon;a.WeaponUsesLimited=actual.WeaponUsesLimited;a.WeaponUsesRemaining=actual.WeaponUsesRemaining;a.Ammo=actual.Ammo;a.ReserveAmmo=actual.ReserveAmmo;a.Medkits=actual.Medkits;a.Explosives=actual.Explosives
 }
 r.state.Combat.ResolveCasualties(r.world.CombatRuntime.Rules,r.combatSpace(r.state.Combat))
 if err:=r.applyAmbientCombatBlasts(previous);err!=nil{return err}
 if err:=r.commitWoundBodies(previous);err!=nil{return err}
 for i:=range r.state.Combat.Actors{r.refreshCombatEquipment(r.state.Inventory,&r.state.Combat.Actors[i])}
 r.capturePublicCombatEventsFrom(previous);r.syncCombatLife()
 if err:=r.combatLifeAfterAction(previous);err!=nil{return err}
 if r.combatLifeTryDisengage()||previous.Active&&!r.state.Combat.Active{
  if r.state.CombatWorld.Cooldowns==nil{r.state.CombatWorld.Cooldowns=map[string]int64{}}
  for _,a:=range previous.Actors{for _,b:=range previous.Actors{if a.Team!=b.Team{r.state.CombatWorld.Cooldowns[a.ID+"\x00"+b.ID]=r.state.Life.Seconds+r.world.CombatLife.ThreatMemorySeconds}}}
 }
 if len(r.state.Combat.Events)>512{r.state.Combat.Events=append([]behavior.CombatEvent(nil),r.state.Combat.Events[len(r.state.Combat.Events)-512:]...)}
 return nil
}

func (r *Runtime) syncCombatLife() {
 // An inactive encounter is history. Re-publication must never restore its
 // old wounds or cell over the current Life body and post-combat care.
 if !r.state.Combat.Active && r.state.CombatLifeSync.EncounterID==r.state.Combat.ID && r.state.CombatLifeSync.Sequence==r.state.Combat.EventSeq{return}
 r.state.CombatLifeSync=combatLifeSync{EncounterID:r.state.Combat.ID,Sequence:r.state.Combat.EventSeq}
	if r.state.Combat.ID == "" {
		return
	}
	if r.state.CombatRoster == nil {
		r.state.CombatRoster = map[string]behavior.Combatant{}
	}
	for _, c := range r.state.Combat.Actors {
		stored := cloneCombatant(c)
		r.state.CombatRoster[c.ID] = stored
 r.storeWoundBody(stored)
		a := r.state.Life.Actor(c.ID)
		if a == nil {
			continue
		}
		a.RestFootprint=r.restFootprint(c,max(1,r.world.Life.Locations[r.state.Combat.LevelID].CellMM))
		wasHeld := a.CombatHold
		if a.Position != c.Position {
			a.Position = c.Position
			a.Goal = c.Position
			a.Body = nil
		}
		a.Path = nil
		a.PendingPath = nil
		a.MoveStartTick = r.lifeMotionTick()
		a.CombatHold = !c.Withdrawn&&(r.state.Combat.Active || !c.Able())
		if a.CombatHold {
			a.Activity = "combat"
			a.Label = "ui.combat.active"
			if c.HP <= 0 || c.FightResponse=="fall" {
				a.Activity = "down"
				a.Label = "ui.combat.down"
			} else if c.Surrendered {
				a.Activity = "surrendered"
				a.Label = "ui.combat.surrendered"
			}
		} else if wasHeld {
			a.Activity = "rest"
			a.Label = "ui.combat.finished"
			a.Arrived = c.ID == playerActorID
		}
	}
r.combatCareTrack()
	r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
	r.syncLifeHero()
	r.capturePublicCombatEvents()
	r.state.Life.ObserveDecisions()
}
func (r *Runtime) appendCombat(msg *pb.PocGameState) {

 if r.state.Life.Enabled{c:=r.combatant(playerActorID,"player");if active:=r.state.Combat.Actor(playerActorID);r.state.Combat.Active&&active!=nil{c=cloneCombatant(*active)};if hero:=r.state.Life.Actor(playerActorID);hero!=nil{c.Position=hero.Position};msg.PlayerCondition=r.combatActorView(c,true)}
	s := r.state.Combat
	if s.ID == "" {
		return
	}
	if s.Actor(playerActorID)==nil{visible:=false;for _,a:=range s.Actors{if r.combatTargetVisible(a){visible=true;break}};if !visible{return}}
 view := &pb.PocCombatView{Active: s.Active, EncounterId: s.ID, LevelId: s.LevelID, Turn: s.Turn, Winner: s.Winner}
	if s.LevelID != r.currentLevel() {msg.Combat=view;return}
 // A finished encounter keeps public poses, but uses current Life positions and
 // current wounds/equipment. Historical combat cells must never rewind walking
 // actors or project bodies into another level.
 if !s.Active {
  for _,old:=range s.Actors {
   level,at,ok:=r.knownCombatLifeActor(old.ID);if !ok||level!=r.currentLevel(){continue}
   a:=r.combatant(old.ID,old.Team);a.Position=at
   if a.ID!=playerActorID&&!r.combatTargetVisible(a){continue}
   view.Actors=append(view.Actors,r.combatActorView(a,a.ID==playerActorID))
  }
  msg.Combat=view;return
 }
	if a := s.Current(); a != nil {
		if a.ID == playerActorID || r.combatTargetVisible(*a) {
			view.CurrentActorId = a.ID
		}
	}
	for _, a := range s.Actors {
		if a.ID != playerActorID && !r.combatTargetVisible(a) {
			continue
		}
view.Actors=append(view.Actors,r.combatActorView(a,a.ID==playerActorID))
	}
	for _, e := range r.state.CombatPublicEvents {
		view.Events = append(view.Events, &pb.PocCombatEvent{Type: e.Type,Mode:e.Mode, ActorId: e.ActorID, TargetId: e.TargetID, FromX: int32(e.From.X), FromY: int32(e.From.Y), ToX: int32(e.To.X), ToY: int32(e.To.Y), Amount: int32(e.Amount), Hit: e.Hit, Turn: e.Turn, Sequence: e.Sequence,BodyPart:e.BodyPart,ItemId:e.ItemID})
	}
	msg.Combat = view
}
func (r *Runtime) validateCombatSave(s state) error {
 if s.CombatLifeSync.EncounterID!=""&&(s.CombatLifeSync.EncounterID!=s.Combat.ID||s.CombatLifeSync.Sequence>s.Combat.EventSeq){return errors.New("invalid encounter Life synchronization cursor")}
	if s.CombatSerial > 1<<50 || (s.Combat.ID != "" && s.CombatSerial == 0) {
		return errors.New("invalid encounter sequence")
	}
	if len(s.CombatPublicEvents) > 64 || s.CombatPublicSeq > s.Combat.EventSeq || s.CombatPublicSerial>s.CombatPublicSeq {
		return errors.New("invalid public combat event history")
	}
	if s.Combat.ID == "" {
		if len(s.CombatPublicEvents) != 0 || s.CombatPublicSeq != 0 || s.CombatPublicSerial!=0 {
			return errors.New("combat roster without encounter")
		}
	}
	if !s.Life.Enabled {
 if s.Combat.ID==""&&len(s.CombatRoster)==0{return nil}
		return errors.New("combat outside Life")
	}
	validator := &Runtime{world: r.world, state: s}
	space := validator.combatSpace(s.Combat)
	if !s.Combat.Active {
		// A closed gate may now occupy an empty historical combat cell. Only
		// an active battle is constrained by the present gate configuration.
		space.Space.Walkable = func(at behavior.Cell) bool { return r.world.Life.Walks(s.Combat.LevelID, at) }
		space.Space.Blocked = nil
	}
	if err := func()error{if s.Combat.ID==""{return nil};return s.Combat.Validate(r.world.CombatRuntime.Rules, space)}(); err != nil {
		return err
	}
	if len(s.CombatRoster) > len(s.Life.Actors)+len(s.Life.Population.Actors) {
		return errors.New("combat roster exceeds persistent population")
	}
 for id,c:=range s.CombatRoster {
  level,at,present:=validator.knownCombatLifeActor(id)
  if id!=c.ID||level==""||c.Team==""||len(c.Team)>256||c.Controlled!=(id==playerActorID){return errors.New("unknown combat roster actor")}
  if err:=c.Validate(r.world.CombatRuntime.Rules);err!=nil{return err}
  if !c.Withdrawn&&(!c.Able()||len(c.Body)>0&&!c.BodyCanWalk)&&(!present||!validator.combatLifeHeld(id)||at!=c.Position){return errors.New("incapable combat actor resumed a routine")}
  if c.Able()&&c.StunTurns==0&&(len(c.Body)==0||c.BodyCanWalk)&&validator.combatLifeHeld(id)&&(!s.Combat.Active||s.Combat.Actor(id)==nil){return errors.New("orphan combat hold")}
 }

	for _, c := range s.Combat.Actors {
 if !s.Combat.Active{continue}
		a := s.Life.Actor(c.ID)
		if a == nil || a.CombatHold != (s.Combat.Active || !c.Able()) || ((s.Combat.Active || !c.Able()) && (!a.OnFloor() || a.Level != s.Combat.LevelID || a.Position != c.Position)) {
			return errors.New("combat/life pose or hold mismatch")
		}
if s.Combat.Active{
 actual:=cloneCombatant(c);validator.refreshCombatEquipment(s.Inventory,&actual)
 if actual.Weapon!=c.Weapon||actual.Ammo!=c.Ammo||actual.ReserveAmmo!=c.ReserveAmmo||actual.Medkits!=c.Medkits||actual.BodyArmor!=c.BodyArmor||actual.WeaponUsesLimited!=c.WeaponUsesLimited||actual.WeaponUsesRemaining!=c.WeaponUsesRemaining||!reflect.DeepEqual(actual.Explosives,c.Explosives){return errors.New("saved tactical resources differ from physical inventory")}
 }
		cached, ok := s.CombatRoster[c.ID]
		if !ok || !reflect.DeepEqual(cached,c) {
			return errors.New("combat roster differs")
		}
	}
	lastSequence := uint64(0)
	for _, e := range s.CombatPublicEvents {
		validCell := func(at behavior.Cell) bool {
			return (at.X == -1 && at.Y == -1) || (at.X >= 0 && at.Y >= 0 && at.X < space.Space.Width && at.Y < space.Space.Height)
		}
		if e.Sequence <= lastSequence || e.Sequence > s.CombatPublicSerial || e.Turn < 1 || e.Turn > s.Combat.Turn || e.Reason != "" || !validCell(e.From) || !validCell(e.To) || (e.ActorID != "" && !validator.combatActorKnown(e.ActorID)) || (e.TargetID != "" && !validator.combatActorKnown(e.TargetID)) {
			return errors.New("invalid filtered combat event")
		}
		lastSequence = e.Sequence
	}
	return nil
}

func(r *Runtime)combatActorView(a behavior.Combatant,own bool)*pb.PocCombatActor{
 v := &pb.PocCombatActor{FallStyle:a.FallStyle,FallDx:int32(a.FallDirection.X),FallDy:int32(a.FallDirection.Y),Id: a.ID, X: int32(a.Position.X), Y: int32(a.Position.Y), Surrendered: a.Surrendered, Down: a.HP <= 0 || a.FightResponse=="fall"}
 if own {
	if len(a.Body)==0{v.Hp = int32(a.HP);v.MaxHp = int32(a.MaxHP)}
	v.Ap = int32(a.AP)
	v.Ammo = int32(a.Ammo)
 v.Bleeding=int32(a.Bleeding);v.Suppression=int32(a.Suppression);v.Morale=int32(a.Morale);v.ReservedAp=int32(a.ReservedAP)
 v.Overwatch=a.Overwatch;v.HeadWound=int32(a.HeadWound);v.ArmWound=int32(a.ArmWound);v.LegWound=int32(a.LegWound)
 v.Medkits=int32(a.Medkits);v.ReserveAmmo=int32(a.ReserveAmmo);v.WeaponId=a.Weapon.ID;v.WeaponKind=a.Weapon.Kind
 for _,option:=range r.combatEquipmentOptions(a.ID){v.Equipment=append(v.Equipment,&pb.PocCombatEquipment{Id:option.ID,Name:r.world.Inventory.Definitions[option.Weapon.ID].Name,Kind:option.Weapon.Kind})}
 v.AttackAp=int32(a.Weapon.AttackAP);v.QuickAp=int32(a.Weapon.QuickAP);v.HeavyAp=int32(a.Weapon.HeavyAP)
 for _,x:=range a.Explosives{v.Explosives=append(v.Explosives,&pb.PocCombatStock{ItemId:x.Explosive.ID,Count:int32(x.Count)})}

 }
 if hero:=r.state.Combat.Actor(playerActorID);hero!=nil{v.Allied=a.Team==hero.Team}
 v.Stance="stand";if a.Crouched{v.Stance="crouch"};if a.Prone{v.Stance="prone"};v.Guarding=a.Guarding;v.Stunned=a.StunTurns>0
 return v
}

// Public prone pose occupies a body strip in combat and ordinary Life pathfinding.
func(r *Runtime)restFootprint(a behavior.Combatant,unit int)[]behavior.Cell{
 if !a.Prone&&!a.FallShifted{return nil};d:=a.FallDirection;if d.X==0&&d.Y==0{d=behavior.Cell{X:0,Y:1}}
 length:=r.world.CombatSpacing.FallLengthMM;if a.FallStyle=="knees"{length=0};width:=r.world.CombatSpacing.FallWidthMM
 norm:=math.Hypot(float64(d.X),float64(d.Y));dx,dy:=float64(d.X)/norm,float64(d.Y)/norm;out:=[]behavior.Cell{};seen:=map[behavior.Cell]bool{}
 for along:=-250;along<=length;along+=125{for across:=-width/2;across<=width/2;across+=125{c:=behavior.Cell{X:a.Position.X+int(math.Round((float64(along)*dx-float64(across)*dy)/float64(unit))),Y:a.Position.Y+int(math.Round((float64(along)*dy+float64(across)*dx)/float64(unit)))};if !seen[c]{seen[c]=true;out=append(out,c)}}};return out
}
