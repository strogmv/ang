				useful = true
			}
		}
		if useful {
			add(CombatCandidate{CombatAction{Type: "report", TargetID: b.ID}, float64(a.WeaponRisk()) * .5 * r.AttackWeight, "deliver missing observation through available channel", r.ReportAP})
		}
