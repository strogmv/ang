// Code generated by ANG. A route preview is chip memory, never a movement order.
package poc

import (
 "sort"
 "strings"
 "angelsdemons/server/internal/behavior"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

type wayfindingGuidePoint struct {X float64 `json:"x"`;Y float64 `json:"y"`}
type wayfindingFrame struct {U wayfindingGuidePoint `json:"u"`;V wayfindingGuidePoint `json:"v"`}
type wayfindingDestination struct {MarkerNumber int `json:"marker_number,omitempty"`;ID string `json:"id"`;NameKey string `json:"name_key"`;Level string `json:"level"`;Color string `json:"color"`;Kind string `json:"kind"`;At behavior.Cell `json:"at"`;GuideFrom *behavior.Cell `json:"guide_from,omitempty"`;GuideRoute []wayfindingGuidePoint `json:"guide_route,omitempty"`;GuideFrame *wayfindingFrame `json:"guide_frame,omitempty"`;GuideUnderlays []behavior.Cell `json:"guide_underlays,omitempty"`;GuideSupport []behavior.Cell `json:"guide_support,omitempty"`;EdgeID string `json:"edge_id,omitempty"`}
type wayfindingCatalog struct {Destinations []wayfindingDestination `json:"destinations"`}
// Selection and caches are transient UI state, intentionally outside saves.
type wayfindingSession struct {Epoch,Level,Selected,Rejected,Memory string;Guides map[string][]behavior.Cell;Shapes map[string][]*pb.PocWayfindingShapePoint;From,To behavior.Cell;Route []behavior.Cell;RouteReady bool}
type wayfindingResolved struct {Number int;ID,Name,Color,Kind,EdgeID,Mode string;At behavior.Cell}

func(r *Runtime)wayfindingContext()(*behavior.LifeActor,string){
 hero:=r.state.Life.Actor(playerActorID);if hero==nil{return nil,""}
 if r.wayfinding.Epoch!=r.state.Epoch||r.wayfinding.Level!=hero.Level{r.wayfinding=wayfindingSession{Epoch:r.state.Epoch,Level:hero.Level}}
 level:=r.world.Life.Locations[hero.Level];var key strings.Builder
 for y,row:=range level.Terrain{for x:=range len(row){seen,ok:=r.state.LifeExploration[hero.Level][y*len(row)+x];if ok{key.WriteString(seen.Glyph)}else{key.WriteByte('?')}}}
 memory:=key.String();if r.wayfinding.Memory!=memory{r.wayfinding.Memory=memory;r.wayfinding.Guides=map[string][]behavior.Cell{};r.wayfinding.Shapes=map[string][]*pb.PocWayfindingShapePoint{};r.wayfinding.RouteReady=false}
 return hero,memory
}
func(r *Runtime)wayfindingWalks(level string,at behavior.Cell)bool{
 rows:=r.world.Life.Locations[level].Terrain;if at.Y<0||at.Y>=len(rows)||at.X<0||at.X>=len(rows[at.Y]){return false}
 seen,ok:=r.state.LifeExploration[level][at.Y*len(rows[at.Y])+at.X]
 return ok&&r.world.Walkable[seen.Glyph]
}
func(r *Runtime)wayfindingPath(level string,from,to behavior.Cell)[]behavior.Cell{
 if !r.wayfindingWalks(level,from)||!r.wayfindingWalks(level,to){return nil}
 rows:=r.world.Life.Locations[level].Terrain;space:=behavior.Space{Width:len(rows[0]),Height:len(rows),MaxSearchCells:len(rows)*len(rows[0]),Walkable:func(at behavior.Cell)bool{return r.wayfindingWalks(level,at)}}
 route:=space.Path(from,to,behavior.Cell{},0);if from!=to&&len(route)==0{return nil}
 return append([]behavior.Cell{from},route...)
}
func(r *Runtime)wayfindingLocal(locale string)[]wayfindingResolved{
 hero:=r.state.Life.Actor(playerActorID);if hero==nil||hero.Trip!=nil{return nil};var out []wayfindingResolved;edges:=map[string]bool{}
 for _,d:=range r.world.Wayfinding.Destinations{if d.Level!=hero.Level||!r.wayfindingWalks(hero.Level,d.At){continue};if d.EdgeID!=""{e:=r.world.Life.Edge(d.EdgeID);if e==nil||!r.lifeExitKnown(*e)||!r.regionPlaceKnown(e.To){continue};edges[e.ID]=true};out=append(out,wayfindingResolved{Number:d.MarkerNumber,ID:d.ID,Name:r.localText(locale,d.NameKey,d.ID),Color:d.Color,Kind:d.Kind,At:d.At,EdgeID:d.EdgeID});if d.EdgeID!=""{edge:=r.world.Life.Edge(d.EdgeID);out[len(out)-1].Mode=edge.Mode;if edge.NameKey!=""{out[len(out)-1].Name=r.lifeEdgeName(locale,*edge)}}}
 // Real known exits also work in rooms with no authored service destinations.
 for _,e:=range r.world.Life.Edges{if len(out)>=24{break};if e.From!=hero.Level||edges[e.ID]||!r.lifeExitKnown(e)||!r.regionPlaceKnown(e.To)||!r.wayfindingWalks(hero.Level,e.Exit){continue};out=append(out,wayfindingResolved{ID:"exit:"+e.ID,Name:r.lifeEdgeName(locale,e),Color:"#C5AD77",Kind:"exit",At:e.Exit,EdgeID:e.ID,Mode:e.Mode})}
 sort.Slice(out,func(i,j int)bool{return out[i].ID<out[j].ID});return out
}
// Resolve only known regional connectivity. An undiscovered parallel Life edge
// cannot be selected merely because it would be a shorter physical shortcut.
func(r *Runtime)wayfindingRegional(locale,target string)(wayfindingResolved,bool){
 hero:=r.state.Life.Actor(playerActorID);if hero==nil||hero.Trip!=nil||target==hero.Level||!r.regionCanGoto(target){return wayfindingResolved{},false}
 from,to:=r.regionNodeForLevel(hero.Level),r.regionNodeForLevel(target);if from==nil||to==nil{return wayfindingResolved{},false}
 // Reconstruct the known schematic route, then stop at its first playable
 // room. A landmark can precede that room, but a route to the station must
 // never continue through the station and offer an unrelated hub beyond it.
 queue:=[]string{from.ID};seen:=map[string]bool{from.ID:true};previous:=map[string]string{};nextNode:=""
 for head:=0;head<len(queue)&&!seen[to.ID];head++{at:=queue[head];for _,link:=range r.world.Region.Links{if !r.state.Region.KnownLinks[link.ID]||!r.state.Region.KnownNodes[link.FromNode]||!r.state.Region.KnownNodes[link.ToNode]{continue};next:="";if link.FromNode==at{next=link.ToNode}else if link.ToNode==at{next=link.FromNode};if next==""||seen[next]{continue};seen[next]=true;previous[next]=at;queue=append(queue,next)}}
 if seen[to.ID]{var path []string;for at:=to.ID;at!=from.ID;at=previous[at]{path=append(path,at)};for i:=len(path)-1;i>=0&&nextNode=="";i--{for _,node:=range r.world.Region.Nodes{if node.ID==path[i]&&node.LevelID!=""{nextNode=node.ID;break}}}}
 var best wayfindingResolved;bestCost:=int(^uint(0)>>1);bestDirect:=false
 for _,e:=range r.world.Life.Edges{if e.From!=hero.Level||!r.lifeExitKnown(e)||!r.wayfindingWalks(hero.Level,e.Exit){continue};node:=r.regionNodeForLevel(e.To);if node==nil||!r.state.Region.KnownNodes[node.ID]{continue};direct:=e.To==target;if !direct&&node.ID!=nextNode{continue}
  bound,allowed:=false,false;for _,link:=range r.world.Region.Links{for _,id:=range link.LifeEdges{if id==e.ID{bound=true;allowed=allowed||r.state.Region.KnownLinks[link.ID]}}};if bound&&!allowed{continue}
  cost:=len(r.wayfindingPath(hero.Level,hero.Position,e.Exit));if cost==0{cost=int(^uint(0)>>1)};if best.ID==""||(direct&&!bestDirect)||(direct==bestDirect&&(cost<bestCost||(cost==bestCost&&e.ID<best.EdgeID))){bestDirect=direct;best=wayfindingResolved{ID:target,Name:r.regionLevelName(locale,target),Color:"#C5AD77",Kind:"exit",At:e.Exit,EdgeID:e.ID,Mode:e.Mode};bestCost=cost}
 };return best,best.ID!=""
}
func(r *Runtime)resolveWayfinding(locale,id string)(wayfindingResolved,bool){for _,d:=range r.wayfindingLocal(locale){if d.ID==id{return d,true}};return r.wayfindingRegional(locale,id)}
func(r *Runtime)wayfindingCommand(action,id string)error{
 hero,_:=r.wayfindingContext();if hero==nil{return textError{Key:"error.wayfinding.unknown"}}
 switch action{
 case "route_clear":r.wayfinding.Selected="";r.wayfinding.Rejected="";r.wayfinding.RouteReady=false;return nil
 case "route_preview":r.wayfinding.Rejected="";if hero.Trip!=nil{r.wayfinding.Selected="";r.wayfinding.Rejected=id;return textError{Key:"error.wayfinding.unknown"}};if _,ok:=r.resolveWayfinding("",id);!ok{r.wayfinding.Selected="";r.wayfinding.Rejected=id;r.wayfinding.RouteReady=false;return textError{Key:"error.wayfinding.unknown"}};r.wayfinding.Selected=id;r.wayfinding.RouteReady=false;return nil
 case "route_go":
  if r.state.Paused{return textError{Key:"error.wayfinding.paused"}};if hero.Trip!=nil||id==""||id!=r.wayfinding.Selected{return textError{Key:"error.wayfinding.unknown"}}
  d,ok:=r.resolveWayfinding("",id);if !ok{r.wayfinding.Selected="";r.wayfinding.Rejected=id;return textError{Key:"error.wayfinding.unknown"}};if len(r.wayfindingPath(hero.Level,hero.Position,d.At))==0{return textError{Key:"error.wayfinding.unreachable"}}
  if d.EdgeID!=""{return r.lifeCommand(&pb.PocLifeCommand{Action:"enter",Destination:d.EdgeID})};if !r.lifeWalkTo(d.At){return textError{Key:"error.wayfinding.unreachable"}};return nil
 };return textError{Key:"error.wayfinding.unknown"}
}
func wayfindingPoints(path []behavior.Cell)[]*pb.PocPoint{var out []*pb.PocPoint;for _,p:=range path{out=append(out,&pb.PocPoint{X:int32(p.X),Y:int32(p.Y)})};return out}
// GuideSupport was computed and validated by ANG from the entire paint buffer.
// Publish all points together or none: deleting an unknown middle point would
// draw a false chord across unobserved architecture. The cache follows exact
// remembered geometry, not simulation ticks, actor paths or live occupancy.
func(r *Runtime)wayfindingPaintKnown(d wayfindingDestination,at behavior.Cell)bool{
 if r.wayfindingWalks(d.Level,at){return true};for _,under:=range d.GuideUnderlays{if under!=at{continue};rows:=r.world.Life.Locations[d.Level].Terrain;if at.Y<0||at.Y>=len(rows)||at.X<0||at.X>=len(rows[at.Y]){return false};seen,ok:=r.state.LifeExploration[d.Level][at.Y*len(rows[at.Y])+at.X];return ok&&seen.Glyph==string(rows[at.Y][at.X])};return false
}
func(r *Runtime)wayfindingShape(d wayfindingDestination)[]*pb.PocWayfindingShapePoint{
 if shape,ok:=r.wayfinding.Shapes[d.ID];ok{return shape}
 var shape []*pb.PocWayfindingShapePoint
 if len(d.GuideRoute)>=2&&len(d.GuideSupport)>0{known:=true;for _,at:=range d.GuideSupport{if !r.wayfindingPaintKnown(d,at){known=false;break}};if known{shape=make([]*pb.PocWayfindingShapePoint,len(d.GuideRoute));for i,p:=range d.GuideRoute{shape[i]=&pb.PocWayfindingShapePoint{X:p.X,Y:p.Y}}}}
 r.wayfinding.Shapes[d.ID]=shape;return shape
}
func(r *Runtime)appendWayfinding(view *pb.PocLifeView,locale string){
 hero,_:=r.wayfindingContext();if hero==nil{return};out:=&pb.PocWayfindingView{LevelId:hero.Level,Status:"none"};view.Wayfinding=out;if hero.Trip!=nil{out.Status="transit";r.wayfinding.Selected="";return}
 for _,d:=range r.wayfindingLocal(locale){out.Destinations=append(out.Destinations,&pb.PocWayfindingDestination{Id:d.ID,Name:d.Name,Color:d.Color,Kind:d.Kind,X:int32(d.At.X),Y:int32(d.At.Y),ServiceAvailable:d.EdgeID!="",TravelMode:d.Mode,Number:int32(d.Number)})}
 budget:=16384;for _,d:=range r.world.Wayfinding.Destinations{if d.Level!=hero.Level||d.GuideFrom==nil||!r.wayfindingWalks(hero.Level,d.At){continue};if d.EdgeID!=""{found:=false;for _,v:=range out.Destinations{if v.Id==d.ID{found=true;break}};if !found{continue}}
  path,exists:=r.wayfinding.Guides[d.ID];if !exists{path=r.wayfindingPath(hero.Level,*d.GuideFrom,d.At);r.wayfinding.Guides[d.ID]=path};if len(path)<2||len(path)>budget{continue};budget-=len(path);guide:=&pb.PocWayfindingGuide{Id:d.ID,Color:d.Color,Path:wayfindingPoints(path),Shape:r.wayfindingShape(d),Authored:len(d.GuideRoute)>0};if len(guide.Shape)>1{guide.Underlays=wayfindingPoints(d.GuideUnderlays);if d.GuideFrame!=nil{guide.AxisU=&pb.PocWayfindingShapePoint{X:d.GuideFrame.U.X,Y:d.GuideFrame.U.Y};guide.AxisV=&pb.PocWayfindingShapePoint{X:d.GuideFrame.V.X,Y:d.GuideFrame.V.Y}}};out.Guides=append(out.Guides,guide)
 }
 if r.wayfinding.Selected==""{if r.wayfinding.Rejected!=""{out.Status="unknown";out.RejectedDestinationId=r.wayfinding.Rejected};return};d,ok:=r.resolveWayfinding(locale,r.wayfinding.Selected);if !ok{r.wayfinding.Rejected=r.wayfinding.Selected;r.wayfinding.Selected="";r.wayfinding.RouteReady=false;out.Status="unknown";out.RejectedDestinationId=r.wayfinding.Rejected;return}
 out.SelectedDestinationId=d.ID;out.SelectedName=d.Name;out.SelectedColor=d.Color;out.LocalExitId=d.EdgeID;out.LocalExitMode=d.Mode;if edge:=r.world.Life.Edge(d.EdgeID);edge!=nil{out.LocalExitName=r.lifeEdgeName(locale,*edge)}
 if !r.wayfinding.RouteReady||r.wayfinding.From!=hero.Position||r.wayfinding.To!=d.At{r.wayfinding.From=hero.Position;r.wayfinding.To=d.At;r.wayfinding.Route=r.wayfindingPath(hero.Level,hero.Position,d.At);r.wayfinding.RouteReady=true}
 out.Path=wayfindingPoints(r.wayfinding.Route);out.Reachable=len(out.Path)>0;out.Status="unreachable";if out.Reachable{out.Status="ready";if hero.Position==d.At&&d.EdgeID==""{out.Status="arrived"}}
}
