func TestMedicalPhysicalHeroApproachAndFrameContinuation(t *testing.T) {
	r := medicalFixture(t)
	var original worldData
	if err := json.Unmarshal(compiledJSON, &original); err != nil {
		t.Fatal(err)
	}
	r.world.Life.HeroBody = original.Life.HeroBody
	r.canonicalWorld.Life.HeroBody = original.Life.HeroBody
	r.world.Life.Brain = original.Life.Brain
	r.canonicalWorld.Life.Brain = original.Life.Brain
	hero := r.state.Life.Actor(playerActorID)
	u := r.world.MedicalCapsules.Units[0]
	hero.Position = behavior.Cell{X: u.ScanCell.X + 2, Y: u.ScanCell.Y}
	hero.Goal = hero.Position
	r.state.Life.EnsureHeroBody(r.world.Life)
	if hero.Body == nil {
		t.Fatal("fixture has no continuous hero body")
	}
	medicalInjure(t, r, playerActorID, true)
	if err := r.medicalRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 300 && r.state.Medical.Patients[playerActorID].Phase == "approach"; i++ {
		r.state.Tick++
		r.state.Inventory.Advance(r.state.Tick)
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	p := r.state.Medical.Patients[playerActorID]
	if p.Phase != "scan" || hero.Position != u.ScanCell || hero.Body != nil {
		t.Fatalf("body did not arrive at scan: phase=%s body=%+v pos=%v", p.Phase, hero.Body, hero.Position)
	}
	for i := 0; i < int(r.world.MedicalCapsules.ScanSeconds*float64(r.world.Config.TickHz))+1; i++ {
		r.state.Tick++
		r.state.Inventory.Advance(r.state.Tick)
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	p = r.state.Medical.Patients[playerActorID]
	if err := r.medicalAccept(playerActorID, u.ID, p.OfferID); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < int(r.world.MedicalCapsules.EntrySeconds*float64(r.world.Config.TickHz))+1; i++ {
		r.state.Tick++
		r.state.Inventory.Advance(r.state.Tick)
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	if r.state.Medical.Patients[playerActorID].Phase != "treatment" {
		t.Fatalf("frame did not start treatment %+v", r.state.Medical.Patients[playerActorID])
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave(slot); err != nil {
		t.Fatal(err)
	}
}

// Explicit developer clinical fixture: actual named people, core burn condition,
// funded real CRD accounts. It is never installed into ordinary New Game.
func TestMedicalNativeFixture(t *testing.T) {
	dir := os.Getenv("ANG_MEDICAL_NATIVE_DIR")
	if dir == "" {
		t.Skip("set output directory for an explicit native clinical save")
	}
	if err := os.MkdirAll(dir, 0700); err != nil {
		t.Fatal(err)
	}
	r, err := New(dir, "token")
	if err != nil {
		t.Fatal(err)
	}
	r.state.Active = true
	r.state.Speed = 1
	r.initLife()
	r.state.Life.SecondsPerTick = 30
	u := r.world.MedicalCapsules.Units[0]
	h := r.state.Life.Actor(playerActorID)
	h.Level = u.LevelID
	h.Position = behavior.Cell{X: u.ScanCell.X + 2, Y: u.ScanCell.Y}
	h.Goal = h.Position
	h.Trip = nil
	h.ResidenceID = ""
	h.Path = nil
	h.PendingPath = nil
	h.Body = nil
	h.Manual = true
	h.OverrideLevel = ""
	h.OverrideEdge = ""
	r.syncLifeHero()
	medicalInjure(t, r, playerActorID, true)
	id := medicalPlaceNPC(t, r)
	n := r.state.Life.Actor(id)
	n.Position = behavior.Cell{X: u.ScanCell.X + 2, Y: r.world.MedicalCapsules.Units[1].ScanCell.Y}
	n.Goal = n.Position
	n.Brain.InterruptService()
	third := r.state.Life.Actor("char.market_resident_01")
	if third == nil {
		t.Fatal("missing third actual resident")
	}
	third.Level = u.LevelID
	third.Position = behavior.Cell{X: 11, Y: 70}
	third.Goal = third.Position
	third.Trip = nil
	third.ResidenceID = ""
	third.Path = nil
	third.PendingPath = nil
	third.RestFootprint = nil
	third.Body = nil
	third.Manual = false
	third.OverrideLevel = ""
	third.OverrideEdge = ""
	third.Brain.InterruptService()
	medicalInjure(t, r, third.ID, true)
	r.state.Life.EnsureHeroBody(r.world.Life)
	if err := r.medicalCommand(&pb.PocLifeCommand{Action: "medical_request", Destination: u.ID}); err != nil {
		t.Fatal(err)
	}
	// Keep the entire approach and top-to-bottom scan behind an explicit native-review resume.
	// Ordinary New Game and the service clock itself are unchanged.
	r.state.Paused = true
	slot := "slot3"
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !loaded.Paused || loaded.Tick != r.state.Tick {
		t.Fatal("native fixture must retain its paused initial simulation tick during loading")
	}
	t.Logf("native clinical save: dir=%s slot=%s NPC=%s; paused; hero reserved a and approaches after ordinary resume; ordinary NPC policy chooses b and queues char.market_resident_01", dir, slot, id)
}

func TestMedicalScanDoesNotStopActualBleeding(t *testing.T) {
	r, _, id := combatCareInjury(t, false, false)
	r.world.MedicalCapsules.NPCSelfCare = false
	u := r.world.MedicalCapsules.Units[0]
	a := r.state.Life.Actor(id)
	a.Level = u.LevelID
	a.Position = u.ScanCell
	a.Goal = a.Position
	a.Path = nil
	a.PendingPath = nil
	a.Trip = nil
	a.ResidenceID = ""
	a.Body = nil
	a.CombatHold = false
	delete(r.state.CombatCare.ShowUntil, id)
	if err := r.medicalRequest(id, u.ID); err != nil {
		t.Fatal(err)
	}
	if err := r.advanceMedicalCapsules(); err != nil {
		t.Fatal(err)
	}
	before := combatBody(r.state.CombatRoster[id])
	r.state.Life.Seconds += 2
	if err := r.advanceWoundCare(); err != nil {
		t.Fatal(err)
	}
	after := combatBody(r.state.CombatRoster[id])
	if after.LostUL <= before.LostUL || after.Clock-before.Clock != 2 || after.Care != nil {
		t.Fatal("scan stopped or duplicated actual bleeding")
	}
}
func TestMedicalDoorClosesAfterReleaseAndRejectsUnsafeSavedPose(t *testing.T) {
	r := medicalFixture(t)
	medicalInjure(t, r, playerActorID, true)
	p := medicalEnter(t, r)
	medicalAdvance(t, r, r.world.MedicalCapsules.EntrySeconds)
	u := r.world.MedicalCapsules.Units[0]
	p = r.state.Medical.Patients[playerActorID]
	r.state.Life.Seconds += p.Quote.Seconds
	if err := r.advanceWoundCare(); err != nil {
		t.Fatal(err)
	}
	if err := r.advanceMedicalCapsules(); err != nil {
		t.Fatal(err)
	}
	medicalAdvance(t, r, r.world.MedicalCapsules.ExitSeconds)
	d := r.state.Medical.Doors[u.ID]
	if d.To != 0 || d.From != 1 || d.EndNS <= r.simNS() {
		t.Fatalf("idle close not saved %+v", d)
	}
	saved := r.snapshotState()
	half := (d.StartNS + d.EndNS) / 2
	if medicalDoorValue(saved.Medical.Doors[u.ID], half) != .5 {
		t.Fatal("load changed door phase")
	}
	if err := r.validateMedical(saved); err != nil {
		t.Fatal(err)
	}
	bad := saved.Medical.Doors[u.ID]
	bad.To = 2
	saved.Medical.Doors[u.ID] = bad
	if r.validateMedical(saved) == nil {
		t.Fatal("invalid door loaded")
	}
}

