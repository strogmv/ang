func TestEmergentScenarioAlarmComesFromWitnessesAndReachesTheOperator(t *testing.T){
 r:=emergentFixture(t);cfg:=r.world.Config.CaptureDemo
 for r.state.Tick<1500&&!r.state.Demo.Delivered{r.step();assertDemoNoOverlap(t,r)}
 d:=r.state.Demo
 if len(d.AlarmLog)==0{t.Fatal("nobody raised an alarm")}
 if !d.Issued||d.CallCause=="test_hook"||d.CallCause==""{t.Fatalf("network call must follow an NPC alarm or report, got cause %q issued=%v",d.CallCause,d.Issued)}
 operator:=r.state.Demo.Residents[r.residentIndex(cfg.Monitoring.Operator)]
 if operator.AlarmRaisedTick==0||operator.AlarmRaisedTick!=d.IssuedTick{t.Fatalf("the operator must be the one who called the network: %+v",operator)}
 if d.AlarmLog[0].Tick<d.HeroActionTick||d.AlarmLog[0].Tick>d.IssuedTick{t.Fatalf("alarm must come after the hero action and before the call: %+v",d.AlarmLog)}
 if !d.Delivered{t.Fatalf("emergent scenario did not reach delivery: tick=%d phase=%s plan=%s",r.state.Tick,d.Squad.Phase,d.Plan.Diagnostic())}
 // The operator's cause names the NPC whose alarm it heard; heard facts expire later by policy.
 raiser:=r.sceneActor(d.AlarmLog[0].ActorID)
 source:=strings.TrimPrefix(strings.TrimPrefix(d.CallCause,"relay:"),"report:");if source==d.CallCause||r.sceneActor(source)==nil{t.Fatalf("operator must have called on a heard NPC alarm, got %q",d.CallCause)}
 if raiser==nil||!r.networkKnown(raiser){t.Fatal("the witness who raised the alarm never learned the network was engaged")}
}
func TestAlarmIsRelayedBeyondTheFirstHearersRange(t *testing.T){
 r:=emergentFixture(t);r.world.AI.Policy.Perception.Hearing.RangeCells=6;cfg:=r.world.Config.CaptureDemo
 first:=&r.state.Demo.Agents[0];r.state.Demo.HeroOffenceUntil=1000
 first.Memory.Record(behavior.Fact{Subject:"poc.hero",Kind:"incident",Source:"sight",Cause:"offence",Value:true,Position:cell(r.state.Player),ObservedTick:1},r.world.AI.Policy.Memory)
 r.state.Tick=1;r.raiseAlarm(first)
 operator:=&r.state.Demo.Residents[r.residentIndex(cfg.Monitoring.Operator)]
 if manhattan(first.Position,operator.Position)<=6{t.Skip("fixture needs the operator beyond the first hearing range")}
 for i:=0;i<120&&!r.state.Demo.Issued;i++{r.step()}
 if !r.state.Demo.Issued{t.Fatalf("relayed alarm never reached the operator: %+v",r.state.Demo.AlarmLog)}
 if len(r.state.Demo.AlarmLog)<2{t.Fatalf("expected a relay by another NPC: %+v",r.state.Demo.AlarmLog)}
 if f,ok:=operator.Memory.Best("alarm");!ok||f.Subject==first.ID{t.Fatalf("operator must have heard a relay, not the distant original: %+v",f)}
}
func TestCameraNeedsAnOperatorToRaiseAnything(t *testing.T){
 cam:=(*Runtime)(nil);_=cam
 for _,withOperator:=range []bool{false,true}{
  r:=emergentFixture(t);cfg:=&r.world.Config.CaptureDemo;if !withOperator{cfg.Monitoring.Operator=""}
  if len(r.world.Scene.Cameras)==0{t.Skip("level has no cameras")}
  // Inside the camera's range but out of everyone's (shortened) sight and hearing: only the sensor notices.
  camera:=r.world.Scene.Cameras[0];found:=false
  for y:=0;y<len(r.world.Terrain)&&!found;y++{for x:=0;x<len(r.world.Terrain[0]);x++{at:=point{x,y};if !r.walkable(at)||manhattan(at,camera.Position)>camera.Range||!r.sceneVisible(cell(camera.Position),cell(at)){continue};clear:=true;for _,a:=range r.sceneActors(){if manhattan(a.Position,at)<=1{clear=false}};if clear{r.state.Player=at;found=true;break}}};if !found{t.Fatal("camera fixture needs a genuinely visible unoccupied cell")}

  r.world.AI.Policy.Social.SightRange=1;r.world.AI.Policy.Perception.Hearing.RangeCells=2
  for _,a:=range r.sceneActors(){if manhattan(a.Position,r.state.Player)<=1{t.Skip("fixture needs no adjacent witness")}}
  for i:=0;i<300&&!r.state.Demo.Issued;i++{r.step()}
  if withOperator&&(!r.state.Demo.Issued||len(r.state.Demo.CallCause)<7||r.state.Demo.CallCause[:7]!="camera:"){t.Fatalf("camera observation with an operator did not lead to a call: %+v",r.state.Demo.CallCause)}
  if !withOperator&&(r.state.Demo.Issued||len(r.state.Demo.AlarmLog)!=0){t.Fatal("a camera without an operator raised an alarm by itself")}
 }
}
func TestEmergentRunIsDeterministicAcrossSave(t *testing.T){
 a:=emergentFixture(t);b:=emergentFixture(t);var mid state
 for a.state.Tick<500{a.step();b.step();if a.state.Tick==150{mid=a.snapshotState()}}
 if stateDigest(t,a.snapshotState())!=stateDigest(t,b.snapshotState()){t.Fatal("emergent runs diverged")}
 slot:=a.world.Config.SaveSlots[0];if err:=a.writeSave(slot,mid);err!=nil{t.Fatal(err)}
 restored,_,err:=a.readSave(slot);if err!=nil{t.Fatal(err)}
 if len(restored.Demo.Sounds)==0&&len(restored.Demo.AlarmLog)==0&&restored.Demo.HeroActionTick==0{t.Fatal("save in the middle of the emergent scenario carries no perception state")}
 c:=emergentFixture(t);c.state=restored;for c.state.Tick<500{c.step()}
 if stateDigest(t,c.snapshotState())!=stateDigest(t,a.snapshotState()){t.Fatal("resuming the emergent scenario from a save diverged")}
 if len(a.state.Demo.Sounds)>a.world.AI.Policy.Perception.Hearing.MaxSoundsPerTick*2{t.Fatal("sound list is not bounded")}
}

