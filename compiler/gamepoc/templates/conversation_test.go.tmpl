	}
	v := dialogueView(t, r, "ru")
	if v.Trade == nil || v.Trade.Mode != "buy" || len(v.Trade.Summary) < 2 || len(v.Choices) > r.world.Memory.Trade.Rows {
		t.Fatalf("the goods view: %+v, %d rows", v.Trade, len(v.Choices))
	}
	offers, _, _ := r.peddlerOffers("ru", akim)
	goods := tradeRows(v, "good")
	if len(offers) == 0 || len(goods) == 0 {
		t.Fatalf("Akim shows nothing: %d offers, %d rows", len(offers), len(goods))
	}
	for i, g := range goods {
		o := offers[i]
		if g.Id != o.ItemId || g.Text != o.Name || !strings.HasPrefix(g.PriceText, strings.ReplaceAll(o.Price, ".", ",")) || g.Unavailable == o.Ok || g.Action != "conversation_buy" || g.Stock == "" || g.Detail == "" {
			t.Fatalf("row %d %+v is not the tray's offer %+v", i, g, o)
		}
	}
	if done := tradeRows(v, "done"); len(done) != 1 || v.Choices[len(v.Choices)-1].Kind != "done" || done[0].Text == "" {
		t.Fatalf("no row back to the talk: %+v", v.Choices)
	}
	// one piece by its row, and the same piece through the old window's command in a twin world
	var pick *pb.PocVendingOffer
	for _, o := range offers {
		if o.Ok {
			pick = o
			break
		}
	}
	if pick == nil {
		t.Fatal("the hero can afford nothing on Akim's tray")
	}
	before, sellerBefore, had := peddlerBalance(r, playerActorID), peddlerBalance(r, akim.Actor), carriedCount(r, pick.Definition)
	if err := tradeCommand(r, "conversation_buy", pick.ItemId); err != nil {
		t.Fatal(err)
	}
	item := old.state.Inventory.Items[pick.ItemId]
	if res := inventoryAnswer(t, old, peddlerRequest(old, "buy", item, "")); !res.Ok {
		t.Fatalf("the old window refused the same purchase: %s", res.Message)
	}
	paid := before - peddlerBalance(r, playerActorID)
	if paid <= 0 || paid != before-peddlerBalance(old, playerActorID) {
		t.Fatalf("paid %d in the talk, the old window took %d", paid, before-peddlerBalance(old, playerActorID))
	}
	if peddlerBalance(r, akim.Actor)-sellerBefore != paid || carriedCount(r, pick.Definition) != had+1 || carriedCount(old, pick.Definition) != had+1 {
		t.Fatalf("the money or the piece did not move as before: seller +%d, carried %d (old %d)", peddlerBalance(r, akim.Actor)-sellerBefore, carriedCount(r, pick.Definition), carriedCount(old, pick.Definition))
	}
	if peddlerMoney(r) != peddlerMoney(old) {
		t.Fatalf("the world's money differs from the old window's: %d, %d", peddlerMoney(r), peddlerMoney(old))
	}
	note := lastNote(t, tk)
	if !note.Success || note.Text != "ui.peddler.result.bought" || note.Item != pick.Definition || note.Minor != paid {
		t.Fatalf("the note of the purchase: %+v", note)
	}
	v = dialogueView(t, r, "ru")
	if line := lastShownLine(v); line.Kind != "note" || !line.Success || !strings.Contains(line.Text, pick.Name) || v.Trade == nil {
		t.Fatalf("the purchase in the log: %+v", line)
	}
	// no money: the row still sends, the server refuses in the old window's own words, nothing moves
	heroBroke(t, r)
	heroBroke(t, old)
	v = dialogueView(t, r, "ru")
	goods = tradeRows(v, "good")
	if len(goods) == 0 || !goods[0].Unavailable || !strings.Contains(goods[0].Detail, r.localText("ru", "ui.peddler.refused.funds", "?")) {
		t.Fatalf("a row the hero cannot pay for: %+v", goods)
	}
	tray, seller := len(tradeRows(v, "good")), peddlerBalance(r, akim.Actor)
	if err := tradeCommand(r, "conversation_buy", goods[0].Id); err != nil {
		t.Fatal(err)
	}
	refused := inventoryAnswer(t, old, peddlerRequest(old, "buy", old.state.Inventory.Items[goods[0].Id], ""))
	note = lastNote(t, tk)
	v = dialogueView(t, r, "ru")
	if note.Success || refused.Ok || lastShownLine(v).Text != refused.Message || lastShownLine(v).Success {
		t.Fatalf("the refusal: note %+v, shown %q, the old window said %q", note, lastShownLine(v).Text, refused.Message)
	}
	if peddlerBalance(r, playerActorID) != 0 || peddlerBalance(r, akim.Actor) != seller || len(tradeRows(v, "good")) != tray {
		t.Fatal("a refused purchase moved money or goods")
	}
	// a piece that is gone, a row of the wrong list, a made-up row
	if err := tradeCommand(r, "conversation_buy", "item.nothing"); err != nil || lastNote(t, tk).Success {
		t.Fatalf("a row that is gone: %v %+v", err, lastNote(t, tk))
	}
	if err := tradeCommand(r, "conversation_sell", goods[0].Id); err == nil {
		t.Fatal("a sale was taken while the tray is shown")
	}
	if err := tradeCommand(r, "conversation_trade", "elsewhere"); err == nil {
		t.Fatal("an unknown row was taken")
	}
	// the cart man also buys: the list turns over to what he takes from the hero, and back
	if akim.Buys != nil {
		if len(tradeRows(v, "sell")) != 1 {
			t.Fatalf("no row to sell to the cart man: %+v", v.Choices)
		}
		if err := tradeCommand(r, "conversation_trade", "sell"); err != nil {
			t.Fatal(err)
		}
		v = dialogueView(t, r, "ru")
		_, buyback, _ := r.peddlerOffers("ru", akim)
		if v.Trade.Mode != "sell" || len(tradeRows(v, "good")) != min(len(buyback), len(tradeRows(v, "good"))) || len(tradeRows(v, "buy")) != 1 || len(v.Choices) > r.world.Memory.Trade.Rows {
			t.Fatalf("the cart man's buying list: %+v", v.Trade)
		}
		for _, g := range tradeRows(v, "good") {
			if g.Action != "conversation_sell" {
				t.Fatalf("a row of the buying list buys: %+v", g)
			}
		}
		if rows := tradeRows(v, "good"); len(rows) > 0 && !rows[0].Unavailable {
			money, n := peddlerBalance(r, playerActorID), len(buyback)
			if err := tradeCommand(r, "conversation_sell", rows[0].Id); err != nil {
				t.Fatal(err)
			}
			if note := lastNote(t, tk); !note.Success || note.Text != "ui.peddler.result.sold" || peddlerBalance(r, playerActorID)-money != note.Minor || note.Minor <= 0 {
				t.Fatalf("the sale: %+v, money +%d", note, peddlerBalance(r, playerActorID)-money)
			}
			if _, after, _ := r.peddlerOffers("ru", akim); len(after) > n {
				t.Fatal("the sold thing is still offered")
			}
		}
		if err := tradeCommand(r, "conversation_trade", "buy"); err != nil || dialogueView(t, r, "ru").Trade.Mode != "buy" {
			t.Fatalf("back to his goods: %v", err)
		}
	}
	// a node's answer is not taken while the goods are shown; «done» goes back to the talk, which goes on
	if err := choose(r, "bye"); err == nil {
		t.Fatal("an answer of the talk was taken while the goods are shown")
	}
	if err := tradeCommand(r, "conversation_trade", "done"); err != nil {
		t.Fatal(err)
	}
	v = dialogueView(t, r, "ru")
	if shown := shownIDs(v); v.Trade != nil || !shown["trade"] || !shown["bye"] {
		t.Fatalf("after the goods: %v", shown)
	}
	if err := tradeCommand(r, "conversation_buy", pick.ItemId); err == nil {
		t.Fatal("a buy was taken after the goods were put away")
	}
	// a save in the middle of the goods loads as it was
	if err := choose(r, "trade"); err != nil {
		t.Fatal(err)
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatalf("a save with the goods shown did not load: %v", err)
	}
	if !reflect.DeepEqual(r.state.Memory, loaded.Memory) || !loaded.Memory.Talks[r.state.Memory.Open].Trade.On {
		t.Fatal("the talk's trade changed in the save")
	}
}

// stallCounter: an open stall whose keeper stands at it and shows goods, with the hero on its customer's cell.
func stallCounter(t *testing.T, r *Runtime) (inv.Shopfront, bool) {
	t.Helper()
	for _, sh := range r.world.Inventory.Shopfronts {
		if _, peddler := r.peddlerOfActor(sh.Owner); peddler || !r.storefrontOpen(sh.ID) || !r.talkSelfTrades(sh.Owner) || len(r.storefrontOffers("ru", sh)) == 0 {
			continue
		}
		anchor, err := r.state.Inventory.Root(r.inventoryModelFor(true), inv.Location{Kind: "store", Store: sh.DisplayStore})
		if err != nil || anchor.Kind != "world" {
			continue
		}
		for _, c := range []inv.Cell{{X: anchor.At.X + 1, Y: anchor.At.Y}, {X: anchor.At.X - 1, Y: anchor.At.Y}, {X: anchor.At.X, Y: anchor.At.Y + 1}, {X: anchor.At.X, Y: anchor.At.Y - 1}, anchor.At} {
			if !r.world.Life.Walks(anchor.Level, behavior.Cell{X: c.X, Y: c.Y}) {
				continue
			}
			peddlerPlace(t, r, playerActorID, c)
			r.state.Life.Actor(playerActorID).Level = anchor.Level
			r.syncLifeHero()
			if r.inventoryReach(inv.Location{Kind: "store", Store: sh.DisplayStore}) {
				return sh, true
			}
		}
	}
	return inv.Shopfront{}, false
}

// Trade at a stall goes on inside the keeper's talk, opened from the customer's cell: the stall's goods as rows, a piece
// bought with the money and the piece moving exactly as through the old window's command.
func TestTalkTradeAtAStallInsideTheTalk(t *testing.T) {
	r := memoryDay(t, 5)
	old := memoryDay(t, 5)
	shop, ok := stallCounter(t, r)
	for tries := 0; !ok && tries < 24; tries++ {
		// the stalls open by their own hours: on with the morning, the twin world in step
		encounterAdvanceTo(t, r, r.state.Life.Seconds+900)
		encounterAdvanceTo(t, old, r.state.Life.Seconds)
		shop, ok = stallCounter(t, r)
	}
	if !ok {
		t.Fatal("no open stall with goods and a keeper at it all morning")
	}
	if twin, ok := stallCounter(t, old); !ok || twin.ID != shop.ID {
		t.Fatalf("the twin world's stall: %s, %v", twin.ID, ok)
	}
	// the talk target stands where the hero can buy: the customer's cell is one of its cells
	if !r.talkAtCounter(shop.Owner) {
		t.Fatal("the customer's cell is not at the counter")
	}
	tk := openWith(t, r, shop.Owner)
	if !strings.HasPrefix(tk.Lines[0].Text, "dlg.market.") && !tk.Interjected {
		t.Fatalf("the keeper did not greet: %+v", tk.Lines)
	}
	if err := choose(r, "trade"); err != nil {
		t.Fatal(err)
	}
	v := dialogueView(t, r, "ru")
	offers := r.storefrontOffers("ru", shop)
	goods := tradeRows(v, "good")
	if v.Trade == nil || v.Trade.Message != "" || len(goods) == 0 || len(v.Choices) > r.world.Memory.Trade.Rows || len(tradeRows(v, "sell")) != 0 {
		t.Fatalf("the stall's goods: %+v, %d rows of %d offers", v.Trade, len(goods), len(offers))
	}
	for i, g := range goods {
		if o := offers[i]; g.Id != o.ItemId || g.Text != o.Name || g.PriceText != o.PriceText || g.Unavailable == o.Ok {
			t.Fatalf("row %d %+v is not the stall's offer %+v", i, g, o)
		}
	}
	var pick *pb.PocVendingOffer
	for _, o := range offers[:len(goods)] {
		if o.Ok {
			pick = o
			break
		}
	}
	if pick == nil {
		t.Fatal("the hero can afford nothing at the stall")
	}
	before, had := peddlerBalance(r, playerActorID), carriedCount(r, pick.Definition)
	world := peddlerMoney(r)
	if err := tradeCommand(r, "conversation_buy", pick.ItemId); err != nil {
		t.Fatal(err)
	}
	if res := inventoryAnswer(t, old, peddlerRequest(old, "buy", old.state.Inventory.Items[pick.ItemId], shop.DisplayStore)); !res.Ok {
		t.Fatalf("the old window refused the same purchase: %s", res.Message)
	}
	paid := before - peddlerBalance(r, playerActorID)
	if paid <= 0 || paid != before-peddlerBalance(old, playerActorID) || carriedCount(r, pick.Definition) != had+1 || carriedCount(old, pick.Definition) != had+1 || peddlerMoney(r) != world || peddlerMoney(old) != world {
		t.Fatalf("the stall purchase: paid %d (old %d), carried %d (old %d)", paid, before-peddlerBalance(old, playerActorID), carriedCount(r, pick.Definition), carriedCount(old, pick.Definition))
	}
	if note := lastNote(t, tk); !note.Success || note.Item != pick.Definition || note.Minor != paid {
		t.Fatalf("the note of the purchase: %+v", note)
	}
	if line := lastShownLine(dialogueView(t, r, "ru")); line.Kind != "note" || !strings.Contains(line.Text, pick.Name) {
		t.Fatalf("the purchase in the log: %+v", line)
	}
	// no money: the row says why, the server refuses, nothing moves
	heroBroke(t, r)
	v = dialogueView(t, r, "ru")
	goods = tradeRows(v, "good")
	if len(goods) == 0 {
		return
	}
	funds := r.localText("ru", "ui.peddler.refused.funds", "?")
	if !goods[0].Unavailable || !strings.HasPrefix(goods[0].Detail, funds) {
		t.Fatalf("a row the hero cannot pay for: %+v", goods[0])
	}
	if err := tradeCommand(r, "conversation_buy", goods[0].Id); err != nil {
		t.Fatal(err)
	}
	if note := lastNote(t, tk); note.Success || lastShownLine(dialogueView(t, r, "ru")).Text != funds || peddlerBalance(r, playerActorID) != 0 || peddlerMoney(r) != world-(before-paid) {
		t.Fatalf("the refusal at the stall: %+v, shown %q", note, lastShownLine(dialogueView(t, r, "ru")).Text)
	}
}

// A list longer than the column's rows pages: «more» and «back» keep the numbers under nine, the last row always goes
// back to the talk, and a page out of range is brought back in.
func TestTalkTradePagesKeepNineRows(t *testing.T) {
	r := memoryDay(t, 5)
	rows := r.world.Memory.Trade.Rows
	many := talkGoods{}
	for i := 0; i < 20; i++ {
		many.rows = append(many.rows, &pb.PocVendingOffer{ItemId: fmt.Sprint("i", i)})
	}
	tk := &talkState{Trade: talkTrade{On: true}}
	c := talkCtx{t: tk}
	per, pages, page := r.talkTradePages(c, many)
	if per != rows-3 || pages != (20+per-1)/per || page != 0 {
		t.Fatalf("20 goods: %d a page, %d pages, page %d", per, pages, page)
	}
	tk.Trade.Page = 99
	if _, _, page = r.talkTradePages(c, many); page != pages-1 {
		t.Fatalf("a page out of range: %d of %d", page, pages)
	}
	many.buys = true
	if per, _, _ = r.talkTradePages(c, many); per != rows-4 {
		t.Fatalf("with the row that turns the list over: %d a page", per)
	}
	few := talkGoods{rows: many.rows[:rows-1]}
	if per, pages, _ = r.talkTradePages(c, few); per != rows-1 || pages != 1 {
		t.Fatalf("%d goods and the row back fit one page: %d a page, %d pages", rows-1, per, pages)
	}
	// in the world: whoever shows the most goods now never shows more than the rows, on any page
	akim := akimAt(t, r)
	openWith(t, r, akim.Actor)
	if err := choose(r, "trade"); err != nil {
		t.Fatal(err)
	}
	offers, _, _ := r.peddlerOffers("ru", akim)
	seen := 0
	for guard := 0; guard < 16; guard++ {
		v := dialogueView(t, r, "ru")
		if len(v.Choices) > rows || v.Choices[len(v.Choices)-1].Kind != "done" {
			t.Fatalf("page %d shows %d rows", v.Trade.Page, len(v.Choices))
		}
		seen += len(tradeRows(v, "good"))
		if (v.Trade.Page > 1) != (len(tradeRows(v, "prev")) == 1) || (v.Trade.Page < v.Trade.Pages) != (len(tradeRows(v, "more")) == 1) {
			t.Fatalf("page %d of %d: %+v", v.Trade.Page, v.Trade.Pages, v.Choices)
		}
		if v.Trade.Page == v.Trade.Pages {
			break
		}
		if err := tradeCommand(r, "conversation_trade", "more"); err != nil {
			t.Fatal(err)
		}
	}
	if seen != len(offers) {
		t.Fatalf("the pages showed %d of %d goods", seen, len(offers))
	}
}

// Saving loaded state again must preserve every byte, not just selected fact fields.
func memoryRoundTripBytes(t *testing.T, r *Runtime, s state) state {
	t.Helper()
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, s); err != nil {
		t.Fatal(err)
	}
	before, err := os.ReadFile(r.slotFile(slot))
	if err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if err := r.writeSave(slot, loaded); err != nil {
		t.Fatal(err)
	}
	after, err := os.ReadFile(r.slotFile(slot))
	if err != nil {
		t.Fatal(err)
	}
	if !bytes.Equal(before, after) {
		t.Fatalf("save changed on load (%d -> %d bytes)", len(before), len(after))
	}
	return loaded
}
func TestMemoryCustodyEveryOutcomeStable(t *testing.T) {
	base := encounterFixture(t)
	e := base.world.CalendarEncounter
	// Outcomes come from authored choices, including check failures and timeout.
	type outcome struct {
		choice, result string
		seen           bool
	}
	all := []outcome{{choice: "timeout", result: "forced"}}
	for _, c := range e.Choices {
		all = append(all, outcome{choice: c.ID, result: c.Outcome})
		if c.Outcome == "escape" {
			all = append(all, outcome{choice: c.ID, result: c.Outcome, seen: true})
		}
		if c.Fail != nil && c.Fail.Outcome != c.Outcome {
			all = append(all, outcome{choice: c.ID, result: c.Fail.Outcome})
		}
	}
	sort.Slice(all, func(i, j int) bool { return all[i].choice+all[i].result < all[j].choice+all[j].result })
	for _, out := range all {
		t.Run(fmt.Sprintf("%s/%s/seen=%v", out.choice, out.result, out.seen), func(t *testing.T) {
			r := encounterFixture(t)
			s := r.snapshotState()
			s.CalendarEncounter.Choice, s.CalendarEncounter.Outcome, s.CalendarEncounter.Phase = out.choice, out.result, "done"
			s.Memory = memoryState{}
			s.CalendarEncounter.Log = append(s.CalendarEncounter.Log, encounterReason{Second: s.Life.Seconds, Cause: e.Duty.Law, Choice: out.choice, Outcome: out.result, Observed: out.seen})
			// A legacy save migrates once; the first normalized save is then byte-stable over three loads.
			r.sanitizeMemory(&s)
			if s.Memory.Migrated != memoryMigrationVersion {
				t.Fatal("no migration mark")
			}
			if s.Memory.Talks[custodyKey(r)] != nil {
				t.Fatal("migration created an empty custody talk")
			}
			before := s.Memory.clone()
			inventory := s.Inventory
			relations := s.Life.RelationOverrides
			for i := 0; i < 3; i++ {
				s = memoryRoundTripBytes(t, r, s)
			}
			if !reflect.DeepEqual(before, s.Memory) || !reflect.DeepEqual(inventory, s.Inventory) || !reflect.DeepEqual(relations, s.Life.RelationOverrides) {
				t.Fatal("repeated migration changed memory, inventory or relations")
			}
		})
	}
}
func TestMemoryTimeoutAlreadySettledDoesNotReplay(t *testing.T) {
	r := encounterFixture(t)
	e := r.world.CalendarEncounter
	s := r.snapshotState()
	s.Memory = memoryState{}
	s.CalendarEncounter.Choice, s.CalendarEncounter.Outcome, s.CalendarEncounter.Phase = "timeout", "forced", "done"
