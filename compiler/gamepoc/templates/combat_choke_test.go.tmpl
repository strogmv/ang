var combatM4Report = flag.String("combat-m4-report", "", "directory for the moment 4 seeded fixtures")

const chokeMode, chokeLong = "choke_hold", "choke_long"

func chokeFixture(t *testing.T, seed int64, scene string) (*Runtime, *connection, playableSceneDefinition) {
	t.Helper()
	r, c, d := combatEpisodeFixture(t, scene, "ru")
	r.state.Seed = seed
	for frame := 0; frame < 10; frame++ {
		r.step()
	}
	return r, c, d
}

// holdEvent: the end of the hold as the show gets it.
func chokeHold(t *testing.T, r *Runtime) (behavior.CombatEvent, string, int) {
	t.Helper()
	for _, e := range r.state.Combat.Events {
		if e.Type == "hold" {
			p := strings.Split(e.BodyPart, ":")
			if len(p) != 2 {
				t.Fatalf("the mark of the hold: %q", e.BodyPart)
			}
			limp, err := strconv.Atoi(p[1])
			if err != nil {
				t.Fatal(err)
			}
			return e, p[0], limp
		}
	}
	t.Fatal("no hold event")
	return behavior.CombatEvent{}, "", 0
}

func chokeRun(t *testing.T, r *Runtime, c *connection, d playableSceneDefinition, walk, mode string) behavior.Combatant {
	t.Helper()
	throatWalk(t, r, c, throatStandoff, walk)
	if r.heroInCombat() {
		t.Fatalf("noticed on a quiet approach (%s)", walk)
	}
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: d.Guard, Mode: mode}); err != nil {
		t.Fatal(err)
	}
	return *r.state.Combat.Actor(d.Guard)
}

// The knockout comes on the second the wound model drew, the wake from the same model: nothing new in the numbers.
func TestChokeLimpOnTheModelsSecondAndLetGo(t *testing.T) {
	limps, free := map[int]int{}, 0
	dead := 0
	for seed := int64(1); seed <= 60; seed++ {
		r, c, d := chokeFixture(t, seed, "combat_choke")
		v := chokeRun(t, r, c, d, "on", chokeMode)
		e, end, limp := chokeHold(t, r)
		if limp < 8 || limp > 14 {
			t.Fatalf("seed %d: limp on %d", seed, limp)
		}
		limps[limp]++
		b := combatBody(v)
		switch end {
		case "completed":
			if !e.Hit || e.Amount != limp {
				t.Fatalf("seed %d: held %d of %d, done %v", seed, e.Amount, limp, e.Hit)
			}
			if b.Dead {
				dead++
				continue
			}
			if combatWounds.Status(b).Conscious {
				t.Fatalf("seed %d: conscious after the hold", seed)
			}
			if w := b.KnockoutUntil - b.Clock; w < 10 || w > 40 {
				t.Fatalf("seed %d: wakes in %d s", seed, w)
			}
			if v.FallStyle != "choke" && v.FallStyle != "knees" {
				t.Fatalf("seed %d: fall %q", seed, v.FallStyle)
			}
		case "broke_free":
			free++
			if e.Hit || e.Amount >= limp {
				t.Fatalf("seed %d: broke free but %+v", seed, e)
			}
			if !combatWounds.Status(b).Conscious || v.FightResponse == "held" || v.Prone || b.KnockoutUntil > b.Clock || b.StunUntil > b.Clock {
				t.Fatalf("seed %d: free, but: %+v / %q", seed, combatWounds.Status(b), v.FightResponse)
			}
		default:
			t.Fatalf("seed %d: ended %q with nobody around", seed, end)
		}
	}
	if len(limps) < 4 || free == 0 || free > 30 {
		t.Fatalf("limps %v, broke free %d of 60, dead %d", limps, free, dead)
	}
}

// Held on: past the safe seconds the brain starves, the death goes to the holder in the Ledger; the risk is the model's.
func TestChokeHeldOnDiesByTheModelAndTheHolderAnswers(t *testing.T) {
	deaths, done := 0, 0
	for seed := int64(1); seed <= 120 && done < 60; seed++ {
		r, c, d := chokeFixture(t, seed, "combat_choke")
		v := chokeRun(t, r, c, d, "on", chokeLong)
		e, end, limp := chokeHold(t, r)
		if end != "completed" {
			continue
		}
		done++
		if e.Amount != 60 || limp > 14 {
			t.Fatalf("seed %d: held %d, limp %d", seed, e.Amount, limp)
		}
		if b := combatBody(v); b.Dead {
			deaths++
			author := false
			for _, ev := range r.state.Combat.Events {
				if ev.TargetID == d.Guard && ev.Type == "dead" && ev.Culprit == playerActorID {
					author = true
				}
			}
			if !author {
				t.Fatalf("seed %d: nobody answers for the death", seed)
			}
		}
	}
	if done < 40 || deaths < done/3 || deaths > done*5/6 {
		t.Fatalf("deaths %d of %d: the model says about six in ten", deaths, done)
	}
}

// Only with empty hands; the blade and the club keep what they offered.
func TestChokeNeedsEmptyHands(t *testing.T) {
	r, c, d := chokeFixture(t, 1, "combat_choke")
	throatWalk(t, r, c, throatStandoff, "on")
	msg := &pb.PocGameState{}
	r.appendTakedownOptions(msg, "ru")
	if len(msg.Takedowns) != 2 || !msg.Takedowns[0].Enabled || !msg.Takedowns[1].Enabled {
		t.Fatalf("the offer: %+v", msg.Takedowns)
	}
	th, tc, td := throatFixture(t)
	throatWalk(t, th, tc, throatStandoff, "on")
	if err := th.takedownCheck(playerActorID, td.Guard, chokeMode); err == nil || err.(textError).Key != "error.takedown.weapon.hands" {
		t.Fatalf("with a knife in hand: %v", err)
	}
	msg = &pb.PocGameState{}
	th.appendTakedownOptions(msg, "ru")
	for _, o := range msg.Takedowns {
		if o.Mode == chokeMode || o.Mode == chokeLong {
			t.Fatalf("a knife in hand, offered %s", o.Mode)
		}
	}
	_ = d
}

// Empty hands at an ordinary walk: nothing on offer beside a guard; on a quiet step, the two rows.
func TestChokeOfferedOnlyOnAQuietStep(t *testing.T) {
	r, c, _ := chokeFixture(t, 1, "combat_choke")
	throatWalk(t, r, c, throatStandoff, "on")
	if err := r.stealthCommand("off"); err != nil {
		t.Fatal(err)
	}
	msg := &pb.PocGameState{}
	r.appendTakedownOptions(msg, "ru")
	if len(msg.Takedowns) != 0 {
		t.Fatalf("offered at an ordinary walk: %+v", msg.Takedowns)
	}
}

// The sound is the real rule of hearing: a step under the place noise of 5 carries about 3 m; nobody else's numbers changed.
func TestChokeMakesAStepOfNoise(t *testing.T) {
	r, c, d := chokeFixture(t, 3, "combat_choke")
	noiseBaseline(t, r)
	throatWalk(t, r, c, throatStandoff, "on")
	noiseBaseline(t, r)
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: d.Guard, Mode: chokeMode}); err != nil {
		t.Fatal(err)
	}
	found := false
	for _, w := range noiseView(r) {
		if w.Own && w.Kind == "takedown" && w.CombatSequence > 0 && math.Abs(float64(w.RadiusMm)-3060) < 1 {
			found = true
		}
	}
	if !found {
		t.Fatalf("no wave of the struggle at 3.06 m: %+v", r.noise.waves)
	}
}

// What is already counted on his body is shown in real seconds, in a world that runs faster: his clock waits for the show, and he wakes as many seconds after it as the model said.
func TestChokeTheClockWaitsForTheShow(t *testing.T) {
	r, c, d := chokeFixture(t, 12, "combat_choke")
	v := chokeRun(t, r, c, d, "on", chokeMode)
	if _, end, _ := chokeHold(t, r); end != "completed" {
		t.Skipf("seed 12 now ends %s", end)
	}
	b := combatBody(v)
	wake := b.KnockoutUntil - b.Clock
	until, ok := r.state.CombatCare.ShowUntil[d.Guard]
	if !ok || until <= r.state.Life.Seconds {
		t.Fatalf("no wait: %v %d now %d", ok, until, r.state.Life.Seconds)
	}
	for r.state.Life.Seconds < until {
		r.step()
	}
	k, ok := r.state.CombatRoster[d.Guard]
	if !ok {
		t.Fatal("no roster body")
	}
	left := combatBody(k)
	if left.KnockoutUntil-left.Clock < wake-1 {
		t.Fatalf("the clock ran during the show: %d of %d left", left.KnockoutUntil-left.Clock, wake)
	}
	for i := 0; i < 2000 && r.state.Life.Seconds < until+wake+2; i++ {
		r.step()
	}
	if st := combatWounds.Status(combatBody(r.state.CombatRoster[d.Guard])); !st.Conscious {
		t.Fatalf("still out %d s after the show", wake+2)
	}
}

// A man who sees it comes up while it lasts and it is over before the limp second; the hold ends with him at hand.
func TestChokeInterruptedByTheManDownTheAisle(t *testing.T) {
	r, c, d := chokeFixture(t, 2, "combat_choke_third")
	third := d.Extras[0].ID
	from := r.state.Life.Actor(third).Position
	chokeRun(t, r, c, d, "on", chokeMode)
	e, end, limp := chokeHold(t, r)
	if end != "interrupted" || e.Hit || e.Amount >= limp {
		t.Fatalf("ended %q after %d of %d", end, e.Amount, limp)
	}
	at := r.state.Life.Actor(third).Position
	if at == from {
		t.Fatal("he did not come")
	}
	if r.combatWorldDistance(d.Level, at, r.state.Combat.Actor(playerActorID).Position) > r.world.CombatRuntime.Rules.Techniques[chokeMode].BreakReachMM {
		t.Fatalf("he stands at %+v", at)
	}
	if r.state.Combat.Actor(third) == nil {
		t.Fatal("he did not join the fight")
	}
	if v := r.state.Combat.Actor(d.Guard); !combatWounds.Status(combatBody(*v)).Conscious {
		t.Fatal("the watchman is out")
	}
}

// The same rule for an NPC with an authored intention: empty hands, the hero as the target, the wound on the NPC's name.
func TestChokeByAnNPCFromAnAuthoredIntention(t *testing.T) {
	for seed, done := int64(1), false; seed <= 40 && !done; seed++ {
		r, c, d := chokeFixture(t, seed, "combat_choke")
		r.world.CombatLife.Aggressors = map[string][]string{}
		r.world.CombatLife.Takedowns = map[string]combatTakedownIntent{d.Guard: {Target: playerActorID, Technique: chokeMode}}
		g := r.state.Life.Actor(d.Guard)
		h := r.state.Life.Actor(playerActorID)
		h.Position = behavior.Cell{X: g.Position.X + 6, Y: g.Position.Y - 6}
		h.Body = nil
		r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
		throatWalk(t, r, c, behavior.Cell{X: g.Position.X + 2, Y: g.Position.Y - 2}, "")
		r.state.Stealth.HeroFaceX, r.state.Stealth.HeroFaceY = .7071, -.7071
		r.state.Life.Actor(d.Guard).Position = behavior.Cell{X: r.state.Life.Actor(playerActorID).Position.X - 2, Y: r.state.Life.Actor(playerActorID).Position.Y + 2}
		if err := r.takedownCheck(d.Guard, playerActorID, chokeMode); err == nil {
			t.Fatal("a baton in his hand, and he may choke")
		}
		for id, i := range r.state.Inventory.Items {
			if i.Definition == "item.service_baton" && i.Owner == d.Guard {
				i.Location.Slot = ""
				r.state.Inventory.Items[id] = i
			}
		}
		if err := r.takedownCheck(d.Guard, playerActorID, chokeMode); err != nil {
			t.Fatalf("the NPC's check with empty hands: %v", err)
		}
		if err := r.combatLifeAfterFrame(); err != nil {
			t.Fatal(err)
		}
		if r.state.Combat.ID == "" {
			t.Fatal("the intention did not start anything")
		}
		_, end, _ := chokeHold(t, r)
		if end != "completed" {
			continue
		}
		done = true
		body := combatBody(*r.state.Combat.Actor(playerActorID))
		if len(body.Wounds) == 0 || body.Wounds[0].Author != d.Guard {
			t.Fatalf("the wound's author: %+v", body.Wounds)
		}
	}
}

var combatM4Stats = flag.String("combat-m4-stats", "", "file for the outcome counts of the hold, through the real command")

// Opt-in: how the real command divides, against the wound model's own table (doc 97: let go ~0.15 % dead, held a minute ~60 %).
func TestCombatMoment4Stats(t *testing.T) {
	if *combatM4Stats == "" {
		t.Skip("opt-in moment 4 counts")
	}
	out := map[string]any{}
	for _, mode := range []string{chokeMode, chokeLong} {
		row := map[string]int{}
		limps := map[string]int{}
		for seed := int64(1); seed <= 400; seed++ {
			r, c, d := chokeFixture(t, seed, "combat_choke")
			v := chokeRun(t, r, c, d, "on", mode)
			_, end, limp := chokeHold(t, r)
			row["runs"]++
			row[end]++
			if end == "completed" {
				limps[strconv.Itoa(limp)]++
				if combatBody(v).Dead {
					row["dead"]++
				}
			}
		}
		out[mode] = map[string]any{"counts": row, "limp_seconds": limps}
	}
	raw, _ := json.MarshalIndent(out, "", " ")
	if err := os.WriteFile(*combatM4Stats, raw, 0644); err != nil {
		t.Fatal(err)
	}
}

// The seeded saves of the moment for the stand and the video: the outcome is found by playing the real command.
func TestCombatMoment4Probes(t *testing.T) {
	if *combatM4Report == "" {
		t.Skip("opt-in moment 4 fixtures")
	}
	root := filepath.Join(*combatM4Report, "probes")
	if err := os.MkdirAll(root, 0755); err != nil {
		t.Fatal(err)
	}
	type want struct {
		Name, Walk, Mode, Scene string
		Pick                    func(r *Runtime, v behavior.Combatant, end string, limp int, held int) bool
	}
	wake := func(v behavior.Combatant) int64 { b := combatBody(v); return b.KnockoutUntil - b.Clock }
	wants := []want{
		{"4a_ko", "on", chokeMode, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "completed" && limp == 9 && !combatBody(v).Dead && v.FallStyle == "choke"
		}},
		{"4b_ko", "upright", chokeMode, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "completed" && limp == 12 && !combatBody(v).Dead && v.FallStyle == "choke"
		}},
		{"4a_ko_short", "on", chokeMode, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "completed" && limp == 8 && !combatBody(v).Dead && v.FallStyle == "choke" && wake(v) <= 14
		}},
		{"4a_ko_long", "on", chokeMode, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "completed" && limp == 14 && !combatBody(v).Dead && v.FallStyle == "choke"
		}},
		{"4_free_early", "on", chokeMode, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "broke_free" && held <= 3
		}},
		{"4_free_late", "on", chokeMode, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "broke_free" && held >= 5
		}},
		{"4_third", "on", chokeMode, "combat_choke_third", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "interrupted" && limp >= 9
		}},
		{"4_long_alive", "on", chokeLong, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "completed" && !combatBody(v).Dead && limp <= 10 && v.FallStyle == "choke"
		}},
		{"4_long_dead", "on", chokeLong, "combat_choke", func(r *Runtime, v behavior.Combatant, end string, limp, held int) bool {
			return end == "completed" && combatBody(v).Dead && limp <= 10 && v.FallStyle == "choke"
		}},
	}
	index := []map[string]any{}
	for _, q := range wants {
		found := false
		for seed := int64(1); seed <= 900 && !found; seed++ {
			r, c, d := chokeFixture(t, seed, q.Scene)
			base := r.snapshotState()
			v := chokeRun(t, r, c, d, q.Walk, q.Mode)
			e, end, limp := chokeHold(t, r)
			if !q.Pick(r, v, end, limp, e.Amount) {
				continue
			}
			events := append([]behavior.CombatEvent(nil), r.state.Combat.Events...)
			b := combatBody(v)
			r.state = base
			row := map[string]any{"name": q.Name, "seed": seed, "episode": d.ID, "mode": q.Walk, "technique": q.Mode, "standoff": throatStandoff, "limp_s": limp, "held_s": e.Amount, "end": end, "dead": b.Dead, "wake_s": b.KnockoutUntil - b.Clock, "fall": v.FallStyle}
			o := filepath.Join(root, q.Name)
			if err := os.MkdirAll(o, 0755); err != nil {
				t.Fatal(err)
			}
			r.data = o
			if err := r.writeSave("slot3", base); err != nil {
				t.Fatal(err)
			}
			if _, _, err := r.readSave("slot3"); err != nil {
				t.Fatal(q.Name, "strict load", err)
			}
			meta, _ := json.MarshalIndent(map[string]any{"row": row, "events": events}, "", "  ")
			if err := os.WriteFile(filepath.Join(o, "setup.json"), meta, 0644); err != nil {
				t.Fatal(err)
			}
			index = append(index, row)
			found = true
		}
		if !found {
			t.Errorf("no seed for %s", q.Name)
		}
	}
	raw, _ := json.MarshalIndent(index, "", "  ")
	if err := os.WriteFile(filepath.Join(root, "index.json"), raw, 0644); err != nil {
		t.Fatal(err)
	}
}
