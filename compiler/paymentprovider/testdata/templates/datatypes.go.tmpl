func macanRecipientDetails(req macanPayInRequisites) *model.RecipientDetails {
	if req.NspkLink != "" {
		return &model.RecipientDetails{
			Identifier: req.NspkLink,
		}
	}
	if req.Phone != "" {
		return &model.RecipientDetails{
			Identifier:       req.Phone,
			IdentifierHolder: req.CardHolder,
			InstitutionName:  req.BankName,
		}
	}
	if req.CardInfo != "" {
		return &model.RecipientDetails{
			Identifier:       req.CardInfo,
			IdentifierHolder: req.CardHolder,
			InstitutionName:  req.BankName,
		}
	}
	return nil
}

func macanPayoutRequisite(brand string, ps *model.PaymentSource, ownerInfo map[string]string) macanRequisite {
	holder := helpers.MapGet(ownerInfo, providers.FullnameKey, "")
	if holder == "" {
		holder = helpers.MapGet(ownerInfo, providers.CardholderKey, "")
	}
	req := macanRequisite{HolderName: holder}
	apmID := ps.APM.ID
	for _, rule := range macanPaymentMethodRules {
		if macanBrandMatches(rule, brand) {
			switch rule.requisiteKind {
			case requisiteCard:
				if ps.Card != nil {
					req.CardNumber = ps.Card.PAN
				}
			case requisitePhone:
				req.PhoneNumber = apmID
			default:
				req.AccountNumber = apmID
			}
			return req
		}
	}
	req.AccountNumber = apmID
	return req
}
