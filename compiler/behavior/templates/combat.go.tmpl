// CombatRules are authored data. AP movement cost uses physical metres, not
// authoring-grid resolution; 500 mm cells therefore do not double move cost.
type CombatRules struct {
	APPerTurn         int     `json:"ap_per_turn"`
	MoveAPPerMeter    int     `json:"move_ap_per_meter"`
	ReloadAP          int     `json:"reload_ap"`
	HealAP            int     `json:"heal_ap"`
	CrouchAP          int     `json:"crouch_ap"`
	ReportAP          int     `json:"report_ap"`
	HealAmount        int     `json:"heal_amount"`
	MemoryTurns       int64   `json:"memory_turns"`
	SightRangeMM      int     `json:"sight_range_mm"`
	HearingRangeMM    int     `json:"hearing_range_mm"`
	ShareRangeMM      int     `json:"share_range_mm"`
	MaxSearchCells    int     `json:"max_search_cells"`
	MaxActionsPerTurn int     `json:"max_actions_per_turn"`
	MinHit            float64 `json:"min_hit"`
	MaxHit            float64 `json:"max_hit"`
	DamageMin         float64 `json:"damage_min"`
	DamageMax         float64 `json:"damage_max"`
	EstimatedDefense  int     `json:"estimated_defense"`
	CoverWeight       float64 `json:"cover_weight"`
	AttackWeight      float64 `json:"attack_weight"`
	MoveWeight        float64 `json:"move_weight"`
	HealWeight        float64 `json:"heal_weight"`
	RetreatWeight     float64 `json:"retreat_weight"`
}
type CombatWeapon struct {
	ID       string `json:"id"`
