				t.Fatal("failed negotiation changed a protected task")
			}
		})
	}
}

func TestLifeCourtesyWaitIntentPreservesMovingFriendsAcceptedSegment(t *testing.T) {
	m, s := courtesyFixture()
	m.Actors[1].Steps[0].At = Cell{3, 1}
	friend := s.Actor("friend")
	friend.Arrived, friend.Activity, friend.Goal = false, "walking", Cell{3, 1}
	friend.Path = []Cell{{3, 1}}
	before := s.Clone()
	courtesyAccept(t, m, &s, Cell{5, 2})
	if !reflect.DeepEqual(friend.Path, before.Actor("friend").Path) || friend.Position != (Cell{3, 2}) {
		t.Fatal("intent admission interrupted the friend's accepted movement")
	}
	for tick := int64(1); tick <= 24; tick++ {
		courtesyAdvance(t, m, &s, tick)
		if tick < m.MoveTicks && s.Actor("friend").Position != (Cell{3, 2}) {
