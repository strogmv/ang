func stealthFootstep(t *testing.T, quiet bool) (*Runtime, *connection, string) {
	t.Helper()
	r, c, target := stealthFixture(t)
	stealthWatch(r, target, false, true)
	if quiet {
		result, _ := stealthWire(t, r, c, "stealth.noise.quiet", "on")
		if !result.Ok {
			t.Fatal(result.Message)
		}
	}
	if err := r.advanceStealth(); err != nil {
		t.Fatal(err)
	}
	h := r.state.Life.Actor(playerActorID)
	heroBodySteer(t, r, c, "steer", 1, 0)
	// Actual body integration produces the step; the sensing frame samples it.
	r.state.Life.HeroBodyAdvance(r.state.Life.GateModel(r.world.Life), h.Body.Clock+8000)
	r.state.Life.Seconds += 8
	r.syncLifeHero()
	if err := r.advanceStealth(); err != nil {
		t.Fatal(err)
	}
	return r, c, target
}
func TestStealthFootstepsUseRealMotionAnonymousHearingAndFiniteMemory(t *testing.T) {
	normal, _, target := stealthFootstep(t, false)
	quiet, _, quietTarget := stealthFootstep(t, true)
	memory := normal.state.CombatWorld.Memories[target]
	sound, heard := memory.Best("combat.noise")
	if !heard || sound.Cause != "" || sound.Source != "sound" || sound.Radius < 1 || sound.Subject == playerActorID {
		t.Fatal("footstep revealed identity or precise location", sound)
	}
	if _, heard := quiet.state.CombatWorld.Memories[quietTarget].Best("combat.noise"); heard {
		t.Fatal("quiet steps did not reduce actual hearing range")
	}
	a := normal.state.Life.Actor(target)
	if a.Safety == nil || a.Safety.Reason != "stealth observation" || normal.state.Combat.Active {
		t.Fatal("anonymous sound failed to start physical investigation or invented a fight")
	}
	origin, goal := a.Position, a.Safety.Goal
	// Explicit loss-of-sight fixture isolates the sound search from a new visual
	// identification. Movement remains the real Life path and collision kernel.
	normal.world.Stealth.RangeMM = 1
	normal.world.Stealth.NearMM = 1
	h := normal.state.Life.Actor(playerActorID)
	h.Body.Mode = ""
	h.Body.Moving = false
	for i := 0; i < 6; i++ {
		normal.state.Tick++
		if err := normal.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	if a.Position == origin && goal != origin {
		t.Fatal("search changed a label without physically moving")
	}
	for i := 0; i < 20; i++ {
		normal.state.Tick++
		if err := normal.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	if a.Safety != nil && a.Safety.Reason == "stealth observation" {
		t.Fatal("expired anonymous noise kept search alive")
	}
}
