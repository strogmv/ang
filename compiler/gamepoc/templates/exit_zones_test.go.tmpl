// A night-locked gate may stand several cells before the exit it closes. The
// nameplate must still be disabled and carry that gate's opening hour, and it
// must change no state. By day the same exit is offered again.
func TestExitZoneBehindShutGateIsClosedWithItsHour(t *testing.T){
 r:=lifeRuntimeFixture(t);if r.world.ExitZones==nil{t.Skip("fixture has no authored exit zones")}
 hero:=r.state.Life.Actor(playerActorID);if hero==nil{t.Fatal("hero")}
 level:=r.world.Life.Locations[hero.Level];var night []behavior.LifeGate
 for _,d:=range level.Gates{if d.LockAtNight{night=append(night,d)}};if len(night)==0{t.Skip("start level has no night-locked gate")}
 targets:=func()map[string]*pb.PocExitTarget{msg:=&pb.PocGameState{Life:&pb.PocLifeView{}};r.appendExitTargets(msg,"ru");rows:=map[string]*pb.PocExitTarget{};for _,row:=range msg.Life.ExitTargets{rows[row.Id]=row};return rows}
 day:=targets()
 // Move the calendar forward to one hour after the latest closing time and let real frames lock the gates.
 closing:=int64(0);for _,d:=range night{if d.CloseSecond>closing{closing=d.CloseSecond}}
 r.state.Life.SecondsPerTick=1
 r.state.Life.Seconds+=((closing+3600-r.state.Life.Seconds%86400)%86400+86400)%86400
 locked:=func()bool{for _,d:=range night{if r.state.Life.Gates[d.ID].Passable(){return false}};return true}
 for i:=0;i<2000&&!locked();i++{r.step()}
 if !locked(){t.Fatal("night gates never locked in real frames")}
 before,_:=json.Marshal(r.snapshotState())
 closed:=0
 for id,row:=range targets(){
  was:=day[id];if was==nil{t.Fatal("exit disappeared at night")}
  if !was.Enabled||row.Access.GetRoutable(){continue}
  var zone exitZoneDefinition;for _,z:=range r.world.ExitZones.Zones{if z.EdgeID==id{zone=z}}
  if !r.exitBehindShutGate(zone){continue}
  closed++
  if row.Enabled||row.ClosedReason==""||row.Text!=row.ClosedReason{t.Fatalf("exit behind a locked gate is still offered: %+v",row)}
  hour:=false;for _,d:=range night{if strings.Contains(row.ClosedReason,fmt.Sprintf("%02d:%02d",d.OpenSecond/3600,(d.OpenSecond%3600)/60)){hour=true}}
  if !hour{t.Fatalf("closed reason does not name the gate opening hour: %q",row.ClosedReason)}
 }
 if closed==0{t.Fatal("no exit of the start level lies behind its night gates; the fixture lost its purpose")}
 after,_:=json.Marshal(r.snapshotState());if !bytes.Equal(before,after){t.Fatal("closed caption changed state")}
}

