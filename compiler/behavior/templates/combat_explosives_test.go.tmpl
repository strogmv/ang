func TestCombatExplosiveRejectedArcUnseenAreaAndStunAreAtomic(t *testing.T) {
	r, space := combatAdvancedRules(), combatFixtureSpace()
	a, b := combatBomber("a", "blue", Cell{1, 1}, 1), combatClub("b", "red", Cell{5, 1})
	a.Initiative = 30
	s := combatNewAdvanced(t, r, space, a, b)
	action := CombatAction{Type: "throw", ItemID: combatBomb().ID, To: Cell{5, 1}}
	space.ThrowClear = func(Cell, Cell) bool { return false }
	before := s.Clone()
	if err := s.Execute(space, r, "a", action); err == nil || !reflect.DeepEqual(before, s) {
		t.Fatal("blocked arc spent AP/stock or advanced RNG")
	}
	space.ThrowClear = nil
	space.Space.Visible = func(from, to Cell) bool { return from == to }
	s.Actor("a").Contacts = nil
	before = s.Clone()
	if err := s.Execute(space, r, "a", action); err == nil || !reflect.DeepEqual(before, s) {
		t.Fatal("unknown remote world authorised a throw")
	}
	space.Space.Visible = func(Cell, Cell) bool { return true }
	s.Actor("a").StunTurns = 1
	before = s.Clone()
	if err := s.Execute(space, r, "a", action); err == nil || !reflect.DeepEqual(before, s) {
		t.Fatal("stunned actor threw or changed rejected state")
	}
