// Code generated by ANG. Development catalog bindings for life scenarios.
package behavior

import "fmt"

type LifePracticeStation struct {
	ID                      string   `json:"id"`
	Name                    string   `json:"name"`
	Level                   string   `json:"level"`
	At                      Cell     `json:"at"`
	Rules                   []string `json:"rules"`
	Source                  string   `json:"source"`
	SuccessBasePermille     int      `json:"success_base_permille"`
	SuccessPerSkillPermille int      `json:"success_per_skill_permille"`
	MinSuccessPermille      int      `json:"min_success_permille"`
	MaxSuccessPermille      int      `json:"max_success_permille"`
}
type LifePracticeAttempt struct {
	Station, Rule, Level      string
	At                        Cell
	StartedTick, CompleteTick int64
}

func (m LifeModel) PracticeRule(id string) (PracticeRule, bool) { return m.Development.rule(id) }
func (m LifeModel) PracticeStation(id string) *LifePracticeStation {
	for i := range m.PracticeStations {
		if m.PracticeStations[i].ID == id {
			return &m.PracticeStations[i]
		}
	}
	return nil
}
func (m LifeModel) validateDevelopment() error {
	if err := m.Development.Validate(); err != nil {
		return err
	}
	for id := range m.Development.Profiles {
		if m.Person(id) == nil {
			return fmt.Errorf("development actor outside life: %s", id)
		}
	}
	seen := map[string]bool{}
	for _, st := range m.PracticeStations {
		if st.ID == "" || seen[st.ID] || st.Name == "" || st.Source == "" || !m.Walks(st.Level, st.At) || len(st.Rules) == 0 || st.SuccessBasePermille < 0 || st.SuccessBasePermille > 1000 || st.SuccessPerSkillPermille < 0 || st.SuccessPerSkillPermille > 1000 || st.MinSuccessPermille < 0 || st.MaxSuccessPermille > 1000 || st.MinSuccessPermille > st.MaxSuccessPermille {
			return fmt.Errorf("invalid practice station %s", st.ID)
		}
		seen[st.ID] = true
		rules := map[string]bool{}
		for _, id := range st.Rules {
			if _, ok := m.PracticeRule(id); !ok || rules[id] {
				return fmt.Errorf("invalid station rule %s", id)
			}
			rules[id] = true
		}
	}
	return nil
}
func (s LifeState) validateDevelopment(m LifeModel, tick int64) error {
	if err := s.Development.Validate(m.Development, tick); err != nil {
		return err
	}
	if len(s.PracticeLog) > 12 {
		return fmt.Errorf("practice journal too long")
	}
	for _, line := range s.PracticeLog {
		if len(line) > 1000 {
			return fmt.Errorf("practice journal line too long")
		}
	}
	for id := range s.PracticeExcluded {
		found := false
		for _, asset := range m.Maintenance.Assets {
			found = found || asset.ID == id
		}
		if !found {
			return fmt.Errorf("unknown excluded practice asset")
		}
	}
	if p := s.PracticePending; p != nil {
		st := m.PracticeStation(p.Station)
		rule, ok := m.PracticeRule(p.Rule)
		allowed := false
		if st != nil {
			for _, id := range st.Rules {
				allowed = allowed || id == p.Rule
			}
		}
		if st == nil || !ok || !allowed || p.Level != st.Level || !m.Walks(p.Level, p.At) || Distance(p.At, st.At) > 1 || p.StartedTick < 0 || p.StartedTick > tick || p.CompleteTick-p.StartedTick != rule.CooldownTicks || p.CompleteTick <= tick {
			return fmt.Errorf("invalid pending practice")
		}
	}
	return nil
}
