		job := r.craftingJobID()
		target := r.craftingStack(i)
		p, err := m.Plan(r.craftingWorker(ms.Actor), crafting.Request{Recipe: rec.ID, Target: item, JobID: job, Seed: r.state.Seed}, r.craftingMasterStacks(ms), &target, crafting.Bench{Station: ms.Station, Present: true})
