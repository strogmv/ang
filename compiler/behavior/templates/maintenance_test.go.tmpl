func TestMaintenanceLongRepairAndTestingDoNotExpire(t *testing.T){
 m:=maintenanceFixture();m.Maintenance.AssignmentTimeout=30;m.Maintenance.Assets[0].RepairSeconds=90;m.Maintenance.Assets[0].TestSeconds=60
 s:=m.Start();installed:=0;hook:=func(MaintenanceAsset,string)error{installed++;return nil};saved:=false
 for tick:=int64(1);tick<240;tick++{
  s.AdvanceWithMaintenance(m,tick,hook);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}
  u:=s.Maintenance.Units[0]
  if !saved&&u.Phase=="repairing"&&u.Elapsed>m.Maintenance.AssignmentTimeout{raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var restored LifeState;if err=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)};if !reflect.DeepEqual(s.Clone(),restored.Clone()){t.Fatal("progress timestamp did not survive save")};s=restored;saved=true}
  if u.Replacements>0{if !saved||installed!=1||u.Replacements!=1||len(u.Crew)!=0||!u.Operational(){t.Fatalf("invalid completed long repair: %+v installs=%d",u,installed)};return}
 }
 t.Fatalf("long repair/testing restarted or stalled: %+v installs=%d",s.Maintenance.Units[0],installed)
}

