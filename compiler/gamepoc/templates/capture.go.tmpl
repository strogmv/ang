 for i,a:=range s.Demo.Agents{
  if a.ID!=cfg.Agents[i].ID||!r.walkable(a.Position)||len(a.Path)>len(r.world.Terrain)*len(r.world.Terrain[0])||len(a.Inbox)>4{return errors.New("invalid demo actor")}
  switch a.Task{case "shadowing","escorting","supplying","equipping","searching","search_assembling","search_report","blocked","patrol","extra_work","considering","joining","await_team","responding","holding","capturing","transporting","delivered","working","assembling","approaching","committing","gather_watch","withdraw","returning","yielding","fleeing","assisting","avoiding","holding_post","investigating":default:return errors.New("invalid demo task")}
  if a.Task=="considering"&&(len(a.Inbox)==0||a.Inbox[0].Kind!="capture"){return errors.New("invalid actor inbox")}
  previous:=a.Position;for _,p:=range a.Path{if !r.walkable(p)||manhattan(previous,p)!=1{return errors.New("invalid demo route")};previous=p}
 }
 ids:=map[string]bool{}
 for _,c:=range s.Demo.Candidates{found:=false;for _,a:=range s.Demo.Agents{if a.ID==c.AgentID{found=true;break}};if !found||ids[c.AgentID]{return errors.New("invalid dispatch candidate")};ids[c.AgentID]=true}
 expected:=len(cfg.Agents);if r.demoAgentIndex(s.Demo.TargetActor)>=0{expected--};if s.Demo.Issued&&len(ids)!=expected{return errors.New("incomplete dispatch save")}
 if s.Demo.CarrierID!=""{found:=false;for _,a:=range s.Demo.Agents{if a.ID==s.Demo.CarrierID{found=true}};if !found{return errors.New("invalid carrier")}}
 if len(s.Demo.Plan.Pending)>r.world.AI.Policy.Planning.MaxPending||len(s.Demo.Plan.Trace)>32{return errors.New("invalid saved plan")}
 hearing:=r.world.AI.Policy.Perception.Hearing
 if s.Demo.DangerLevel<0||s.Demo.DangerLevel>r.world.AI.Policy.Danger.Max()||len(s.Demo.Sounds)>hearing.MaxSoundsPerTick*2||s.Demo.HeardCursor<0||s.Demo.HeardCursor>len(s.Demo.Sounds)||len(s.Demo.AlarmLog)>32{return errors.New("invalid saved danger or sound state")}
 switch s.Demo.Scenario{case "","test_hook","none":default:return errors.New("invalid saved scenario")}
 for _,snd:=range s.Demo.Sounds{if snd.Tick<0||snd.Tick>s.Tick||snd.Loudness<=0||snd.Loudness>1||!r.walkable(location(snd.Origin)){return errors.New("invalid saved sound")}}
 for _,actors:=range [][]demoAgent{s.Demo.Agents,s.Demo.Residents}{for _,a:=range actors{if a.RefusalPenalty<0||a.AlarmRaisedTick<0||a.AlarmRaisedTick>s.Tick{return errors.New("invalid civic duty state")}}}
 if s.Demo.Plan.Root!=""{
  if _,ok:=r.world.AI.Tasks[s.Demo.Plan.Root];!ok{return errors.New("unknown saved root")}
  if s.Demo.Plan.Current!=""{if _,ok:=r.world.AI.Actions[s.Demo.Plan.Current];!ok{return errors.New("unknown saved action")}}
  for _,f:=range s.Demo.Plan.Pending{_,action:=r.world.AI.Actions[f.ID];_,task:=r.world.AI.Tasks[f.ID];if (!action&&!task)||f.Depth<0||f.Depth>r.world.AI.Policy.Planning.MaxDepth{return errors.New("invalid saved pending task")}}
  if s.Demo.Plan.StartedTick<0||s.Demo.Plan.StartedTick>s.Tick{return errors.New("invalid saved task clock")}
 }
 return nil
}
