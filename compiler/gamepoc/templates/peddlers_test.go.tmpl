// peddlerOpenAt: the peddler stands at a stop in his hours and the commerce runtime opens his shop there.
func peddlerOpenAt(t *testing.T, r *Runtime, p peddlerDef, stop int) {
	t.Helper()
	if day := r.state.Life.Seconds % 86400; day < p.OpenSecond || day >= p.CloseSecond {
		r.state.Life.Seconds += (p.OpenSecond + 600 - day + 86400) % 86400
	}
	peddlerPlace(t, r, p.Actor, p.Stops[stop].At)
	if err := r.advanceMarketSupply(); err != nil {
		t.Fatal(err)
	}
	if r.peddlerStopNow(p) != p.Stops[stop].ID {
		t.Fatalf("%s did not open at stop %s", p.Shop, p.Stops[stop].ID)
	}
}
