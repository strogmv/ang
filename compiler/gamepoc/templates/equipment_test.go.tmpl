func lookTowardGroup(r *Runtime,away bool){a:=r.sceneActor(r.primaryMember());if a==nil{return};target:=r.targetPosition();facing:=point{1,0};dx,dy:=a.Position.X-target.X,a.Position.Y-target.Y;if dx<0{facing.X=-1};if dx==0{facing=point{0,1};if dy<0{facing.Y=-1}};if away{facing.X=-facing.X;facing.Y=-facing.Y};p:=r.state.Poses[playerActorID];p.Facing=facing;r.state.Poses[playerActorID]=p}
func TestUnarmedGroupShadowsAndNeedsRealDistractionBeforeCapture(t *testing.T){
 r:=armedNoCenterFixture(t);sawShadow:=false
 for r.state.Tick<500&&!sawShadow{lookTowardGroup(r,false);r.step();assertDemoNoOverlap(t,r);sawShadow=r.state.Demo.Squad.Phase=="shadowing"}
 if !sawShadow||r.state.Demo.Captured{t.Fatalf("armed target did not produce neutral shadowing: %s",r.state.Demo.Plan.Diagnostic())}
 for i:=0;i<20;i++{lookTowardGroup(r,false);r.step();assertDemoNoOverlap(t,r);if r.state.Demo.Captured{t.Fatal("unarmed team attacked a facing armed target")}}
 lookTowardGroup(r,true)
 for i:=0;i<300&&!r.rearStageReady()&&r.state.Demo.Plan.Status!="failed";i++{r.step();assertDemoNoOverlap(t,r)}
 if !r.rearStageReady()||r.state.Demo.Captured{t.Fatalf("rear approach failed or turn alone caused attack: %s phase=%s",r.state.Demo.Plan.Diagnostic(),r.state.Demo.Squad.Phase)}
 r.focusActor(playerActorID,"object.test")
 for i:=0;i<20&&!r.state.Demo.Captured;i++{r.step();assertDemoNoOverlap(t,r)}
 if !r.state.Demo.Captured{t.Fatalf("observed distraction did not open coordinated capture: %s phase=%s",r.state.Demo.Plan.Diagnostic(),r.state.Demo.Squad.Phase)}
}
func TestTurningBackTowardGroupClosesOpportunity(t *testing.T){
 r:=armedNoCenterFixture(t);for r.state.Tick<500&&r.state.Demo.Squad.Phase!="shadowing"{lookTowardGroup(r,false);r.step();assertDemoNoOverlap(t,r)};lookTowardGroup(r,true)
 for i:=0;i<300&&!r.rearStageReady()&&r.state.Demo.Plan.Status!="failed";i++{r.step();assertDemoNoOverlap(t,r)};if !r.rearStageReady(){t.Fatal("no rear approach")}
