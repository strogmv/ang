// A 12×12 plan: base band rows 0..11, gallery band rows 13..24 (slab x 1..10,
// y 1..3 at +3.5 m), one 3-lane stair block rows 25..30 rising north from the
// base foot y=10 to the gallery head y=3. The stair body blocks base x 4..6,
// y 4..9. Links join the foot/head landings to the first/last stair row.
func multideckFixture() (LifeModel, *DeckVolume) {
	const w, d, galleryRow, stairRow = 12, 12, 13, 25
	grid := make([][]byte, stairRow+6)
	for y := range grid {
		grid[y] = []byte(strings.Repeat(" ", w))
	}
	for y := 0; y < d; y++ {
		for x := 0; x < w; x++ {
			grid[y][x] = '.'
			if x >= 4 && x <= 6 && y >= 4 && y <= 9 || x == 9 && y == 6 {
				grid[y][x] = '#'
			}
		}
	}
	for y := 1; y <= 3; y++ {
		for x := 1; x <= 10; x++ {
			grid[galleryRow+y][x] = '.'
		}
	}
	var links []LifeLink
	var nodes []DeckNode
	for lane := 0; lane < 3; lane++ {
		for step := 0; step < 6; step++ {
			grid[stairRow+step][lane] = '.'
			nodes = append(nodes, DeckNode{Nav: Cell{lane, stairRow + step}, Plan: Cell{4 + lane, 9 - step}, HeightMM: 290 + step*580})
		}
		links = append(links, LifeLink{A: Cell{4 + lane, 10}, B: Cell{lane, stairRow}}, LifeLink{A: Cell{lane, stairRow + 5}, B: Cell{4 + lane, galleryRow + 3}})
	}
	terrain := make([]string, len(grid))
	for y := range grid {
		terrain[y] = string(grid[y])
	}
	m := LifeModel{StartSeconds: 0, SecondsPerTick: 1, MoveTicks: 2, Walkable: map[string]bool{".": true}, Locations: map[string]LifeLocation{"md": {Name: "md", Terrain: terrain, Links: links, InitialLayoutKnown: true}},
		Actors: []LifePerson{
			{ID: "hero", Name: "hero", Steps: []LifeStep{{Level: "md", At: Cell{5, galleryRow + 2}, Activity: "rest"}}},
			{ID: "npc", Name: "npc", Steps: []LifeStep{{Level: "md", At: Cell{8, 11}, Activity: "rest", Label: "below"}, {AtMinute: 1, Level: "md", At: Cell{8, galleryRow + 1}, Activity: "post", Label: "gallery post"}}},
		}}
	var edges []DeckEdge
	for x := 1; x <= 10; x++ {
		if x < 4 || x > 6 {
			edges = append(edges, DeckEdge{At: Cell{x, 3}, Side: "south", BottomMM: 3500, TopMM: 4600})
		}
	}
	v := &DeckVolume{Schema: "ang.multideck.v1", PlanWidth: w, PlanDepth: d, NavWidth: w, NavDepth: len(grid), EyeMM: 1600, TargetMM: []int{1000, 1700}, SightRangeCells: 24,
		Surfaces:   []DeckSurface{{ID: "base", Index: 0, ElevationMM: 0, SlabMM: 250, Walkable: true, Grounded: true, NavRow: 0, Slab: []DeckRect{{0, 0, w, d}}}, {ID: "gallery", Index: 1, ElevationMM: 3500, SlabMM: 250, Walkable: true, NavRow: galleryRow, Slab: []DeckRect{{1, 1, 10, 3}}}},
		Connectors: []DeckConnector{{ID: "stair", Nodes: nodes}}, Links: links, Edges: edges, Solids: []DeckSpan{{Rect: DeckRect{9, 6, 1, 1}, BottomMM: 0, TopMM: 3250}}}
	return m, v
}

func TestMultideckSightSlabsRailingsAndVoids(t *testing.T) {
	_, v := multideckFixture()
	if err := v.Prepare(); err != nil {
		t.Fatal(err)
	}
	gallery := func(x, y int) Cell { return Cell{x, 13 + y} }
	hall := func(x, y int) Cell { return Cell{x, y} }
	cases := []struct {
		name     string
		from, to Cell
		want     bool
	}{
		{"gallery edge sees the hall below", gallery(8, 3), hall(8, 9), true},
		{"near the gallery the slab hides its interior", hall(8, 5), gallery(8, 1), false},
		{"from afar a head above the railing is visible", hall(8, 11), gallery(8, 3), true},
		{"from afar the sheet balustrade hides the gallery depth", hall(8, 11), gallery(8, 1), false},
		{"straight down through the slab is hidden", gallery(8, 2), hall(8, 2), false},
		{"the open stair head shows the gallery", hall(5, 11), gallery(5, 2), true},
		{"on the stair the gallery is visible", Cell{1, 30}, gallery(5, 1), true},
		{"a column's near face is seen", hall(9, 10), hall(9, 6), true},
		{"a column hides what is behind it", hall(9, 10), hall(9, 4), false},
	}
	for _, c := range cases {
		if got := v.Sees(c.from, c.to); got != c.want {
			t.Fatalf("%s: got %v", c.name, got)
		}
		// The cached set equals the direct ray at every range.
		for _, radius := range []int{3, 24} {
			if v.VisibleWithin(c.from, c.to, radius) != (v.Within(c.from, c.to, radius) && v.Sees(c.from, c.to)) {
				t.Fatalf("%s: cached visibility differs at range %d", c.name, radius)
			}
		}
	}
	if s, ok := v.SurfaceIndex(Cell{1, 27}); !ok || s != 2 {
		t.Fatalf("stair nodes are API surface N+connector: %d", s)
	}
	if s, ok := v.SurfaceIndex(gallery(2, 2)); !ok || s != 1 {
		t.Fatal("gallery band index")
	}
	if _, ok := v.SurfaceIndex(gallery(2, 8)); ok {
		t.Fatal("void must not be standable")
	}
}

func TestMultideckLinksAreOrdinarySteps(t *testing.T) {
	m, _ := multideckFixture()
	if err := m.Validate(); err != nil {
		t.Fatal(err)
	}
	route := m.Space("md", nil).Path(Cell{5, 15}, Cell{2, 11}, Cell{}, 0)
	if len(route) == 0 {
		t.Fatal("gallery to hall needs a route over the stair")
	}
	previous := Cell{5, 15}
	stair := false
	for _, at := range route {
		if !m.Adjacent("md", previous, at) {
			t.Fatalf("non-adjacent step %v -> %v", previous, at)
		}
		stair = stair || at.Y >= 25
		previous = at
	}
	if !stair {
		t.Fatal("the route must use stair nodes")
	}
	bad := m
	bad.Locations = map[string]LifeLocation{"md": {Name: "md", Terrain: m.Locations["md"].Terrain, Links: []LifeLink{{A: Cell{0, 0}, B: Cell{1, 0}}}}}
	if bad.Validate() == nil {
		t.Fatal("a link between grid neighbours is not a link")
	}
}

// Hero descends while the resident climbs to its gallery post: they pass on
// the three-lane stair without sharing a cell and both arrive (no deadlock).
// A JSON save mid-stair validates and resumes to the identical result.
func TestMultideckHeroAndResidentPassOnTheStair(t *testing.T) {
	m, _ := multideckFixture()
	s := m.Start()
	s.ControlledActorID = "hero"
	commanded, bothOnStair := false, false
	var saved []byte
	var savedTick int64
	run := func(state *LifeState, from, to int64, record bool) {
		for tick := from; tick <= to; tick++ {
			before := map[string]Cell{}
			for _, a := range state.Actors {
				before[a.ID] = a.Position
			}
			state.Advance(m, tick)
			seen := map[Cell]string{}
			for _, a := range state.Actors {
				if other, ok := seen[a.Position]; ok {
					t.Fatalf("tick %d: %s and %s overlap at %v", tick, a.ID, other, a.Position)
				}
				seen[a.Position] = a.ID
				if a.Position != before[a.ID] && !m.Adjacent("md", before[a.ID], a.Position) {
					t.Fatalf("tick %d: %s jumped %v -> %v", tick, a.ID, before[a.ID], a.Position)
				}
			}
			hero, npc := state.Actor("hero"), state.Actor("npc")
			if !record {
				continue
			}
			if !commanded && npc.Position.Y >= 25 {
				route, ok := state.MoveRoute(m, "hero", "md", hero.Position, Cell{2, 11}, tick)
				if !ok || len(route) == 0 {
					t.Fatal("hero cannot plan down")
				}
				hero.Path, hero.Goal, hero.Manual, hero.Arrived, hero.Activity, hero.MoveStartTick = route, Cell{2, 11}, true, false, "walking", tick
				commanded = true
			}
			if hero.Position.Y >= 25 && npc.Position.Y >= 25 {
				bothOnStair = true
				if saved == nil {
					saved, _ = json.Marshal(state.Clone())
					savedTick = tick
				}
			}
		}
	}
	run(&s, 1, 600, true)
	hero, npc := s.Actor("hero"), s.Actor("npc")
	if !commanded || !bothOnStair {
		t.Fatalf("scenario did not put both on the stair: commanded=%v both=%v", commanded, bothOnStair)
	}
	if hero.Position != (Cell{2, 11}) || npc.Position != (Cell{8, 14}) || !npc.Arrived || npc.Activity != "post" {
		t.Fatalf("deadlock or wrong posts: hero %v npc %v %s", hero.Position, npc.Position, npc.Activity)
	}
	var restored LifeState
	if err := json.Unmarshal(saved, &restored); err != nil {
		t.Fatal(err)
	}
	if err := restored.Validate(m, savedTick); err != nil {
		t.Fatalf("mid-stair save must validate: %v", err)
	}
	run(&restored, savedTick+1, 600, false)
	a, _ := json.Marshal(s.Actors)
	b, _ := json.Marshal(restored.Actors)
	if string(a) != string(b) {
		t.Fatal("resumed mid-stair save diverged from the uninterrupted run")
	}
}
