var combatWounds = func() wounds.Model {
	m, err := wounds.Catalog()
	if err != nil {
		panic(err)
	}
	return m
}()

// Body bytes belong to an independently cloned combat draft. Durable world bodies
// and the roster are checked for equality on Load; neither is a second health model.
func combatBody(a behavior.Combatant) wounds.Body {
	var b wounds.Body
	if err := json.Unmarshal(a.Body, &b); err != nil {
		panic(fmt.Sprintf("unvalidated combat body %s: %v", a.ID, err))
	}
	return b
}
func projectWoundBody(a *behavior.Combatant, b wounds.Body) {
	st := combatWounds.Status(b)
	a.AP = max(0, a.AP-max(0, st.APPenalty-a.BodyAPPenalty))
	a.Body, _ = json.Marshal(b)
	a.BodyState = st.State
	a.BodyCanWalk = st.CanWalk
	a.BodyCanStand = st.Standing
	a.BodyCanHold = st.HoldWeapon
	a.BodyAPPenalty = st.APPenalty
 a.BodyEffects=append([]string(nil),st.Effects...)
	a.SeriousWound = combatWounds.Serious(b)
	a.BodyMoveScale = int(combatWounds.Walk.NormalMMS * 100 / max(1, st.PaceMMS))
	// Kept solely for old save migration and existing pose/resource adapters.
	// These are binary Status projections; a hit never subtracts from them.
	a.MaxHP = 100
	a.HP = 100
	if !st.Conscious {
		a.HP = 0
	}
	a.Bleeding = 0
	if st.ExternalULS > 0 {
		a.Bleeding = 1
	}
	a.HeadWound = 0
	a.ArmWound = 0
	a.LegWound = 0
	for _, w := range b.Wounds {
		z, _ := combatWounds.Zone(w.Zone)
		for _, e := range w.Effects {
			switch e {
			case "concussion":
				a.HeadWound = 1
			case "drop_weapon":
				a.ArmWound = 1
			case "limp", "no_walk":
				a.LegWound = 1
			}
			_ = z
		}
	}
	a.StunTurns = 0
	if st.Conscious && b.StunUntil > b.Clock {
		a.StunTurns = 1
	}
	if !st.Standing {
		a.Prone = true
		a.Crouched = false
	}
	if !st.Conscious {
		a.AP = 0
		a.Aid = nil
	}
	if !st.HoldWeapon {
		a.ReservedAP = 0
		a.Guarding = false
		a.Overwatch = false
	}
}
func (r *Runtime) bodyChip(id string) string {
	caste := barkCatalog.Castes[id]
	if caste == "" {
		for _, a := range r.state.Life.Population.Actors {
			if a.ID == id && a.Profile != nil {
				caste = barkCatalog.PopulationCastes[a.Profile.DefinitionID]
				break
			}
		}
	}
	if _, ok := combatWounds.Chips[caste]; ok {
		return caste
	}
	return "none"
}
func (r *Runtime) initializeWoundBody(a *behavior.Combatant) {
	if old, ok := r.state.CombatRoster[a.ID]; ok && len(old.Body) > 0 {
		projectWoundBody(a, combatBody(old))
		a.FightResponse = old.FightResponse
		a.Aid = cloneCombatant(old).Aid
		return
	}
	for _, b := range r.state.Wounds.Bodies {
		if b.ID == a.ID {
			projectWoundBody(a, b)
			return
		}
	}
	projectWoundBody(a, combatWounds.NewBody(a.ID, r.bodyChip(a.ID)))
}
func woundCombatEvents(a behavior.Combatant, events []wounds.Event, salt int64) []behavior.CombatEvent {
	out := make([]behavior.CombatEvent, 0, len(events))
	for _, e := range events {
		event := behavior.CombatEvent{Type: e.Type, ActorID: a.ID, TargetID: a.ID, From: a.Position, To: a.Position, Reason: e.Detail, ItemID: e.Wound, Culprit: e.Culprit, Crime: e.Crime, BodySecond: e.At, Hit: e.Type == "wound"}
		if e.Type == "wound" {
			event.BodyPart, event.Mode = woundPublicMark(a, e.Wound, salt)
		}
		out = append(out, event)
	}
	return out
}
// woundPublicMark is what anyone who sees the blow sees of the new wound: the zone, the side and the outward blood sign
// ("side:sign" in the event's Mode). Presentation only: no rule reads it and it consumes no random draw. Limbs have a
// real side in the wound model; the other zones do not, so the side is a stable hash of the body and the wound.
func woundPublicMark(a behavior.Combatant, id string, salt int64) (string, string) {
	body := combatBody(a)
	for _, w := range body.Wounds {
		if w.ID != id {
			continue
		}
		side := ""
		switch {
		case strings.HasPrefix(w.Limb, "left"):
			side = "left"
		case strings.HasPrefix(w.Limb, "right"):
			side = "right"
		default:
			h := fnv.New32a()
			h.Write([]byte(fmt.Sprintf("%s/%s/%d", a.ID, w.ID, salt)))
			side = "left"
			if h.Sum32()%2 == 1 {
				side = "right"
			}
		}
		sign := "none"
		rank := 0
		for _, bleed := range w.Bleeds {
			if bleed.Internal {
				continue
			}
			kind, level := "blood", 1
			switch bleed.Kind {
			case "artery", "critical":
				kind, level = "blood_spurt", 3
			case "vein", "deep_vein":
				kind, level = "blood_flow", 2
			}
			if level > rank {
				sign, rank = kind, level
			}
		}
		return w.Zone, side + ":" + sign + ":" + w.Depth
	}
	return "", ""
}
func appendWoundEvents(s *behavior.CombatState, a behavior.Combatant, events []wounds.Event) {
	for _, e := range woundCombatEvents(a, events, s.Seed) {
		s.EventSeq++
		e.Sequence = s.EventSeq
		e.Turn = s.Turn
		s.Events = append(s.Events, e)
	}
}
func (r *Runtime) woundPsyche(a behavior.Combatant) wounds.Psyche {
	psyche := r.world.Psyche.Actors[a.ID]
	policy := r.world.AI.Policy.Utility
	// Fear is a personal proxy, then passes through the existing chip-suppression law.
	// No foreign blood volume, organ state or prognosis enters it.
	threat := .25
	if a.SeriousWound {
		threat = .8
	}
	if a.BodyState == "weak" || a.BodyState == "confused" {
		threat = 1
	}
	fear := policy.Emotion("fear", psyche, map[string]float64{policy.EmotionProxies["fear"]: threat})
	return wounds.Psyche{Response: psyche.StressResponse, Courage: int64(a.Courage), FearPermille: int64(fear * 1000)}
}
