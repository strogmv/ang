   CombatBeat run=null;
   for(int i=0;i<fight.Events.Count;i++){
    var e=fight.Events[i];if(e.Sequence<=combatSeq)continue;combatSeq=e.Sequence;
    var from=new Vector2Int(e.FromX,e.FromY);var to=new Vector2Int(e.ToX,e.ToY);
    // The rest of a held technique belongs to its beat: how long it was held, the fall, the cell the holder ends on.
    {CombatBeat held=null;for(int q=combatQueue.Count-1;q>=0;q--)if(combatQueue[q].pair){held=combatQueue[q];break;}
     if(held!=null&&e.Type=="hold"&&e.ActorId==held.actor){held.holdS=e.Amount;held.holdDone=e.Hit;held.fromCrouch=e.Mode=="crouch";held.endCell=from;continue;}
