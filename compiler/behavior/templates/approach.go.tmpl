// Code generated by ANG. Personal approach preferences, separate from training.
package behavior

type ApproachStyle struct {
 Mode string `json:"mode"`
 Label string `json:"label"`
 PositionWeight int `json:"position_weight"`
 DirectCost int `json:"direct_cost"`
 SupportCost int `json:"support_cost"`
 BuddyWeight int `json:"buddy_weight"`
 Calls []string `json:"calls"`
}
type ApproachPolicy struct {
 Enabled bool `json:"enabled"`
 FearSupportThreshold float64 `json:"fear_support_threshold"`
 DefaultStyle string `json:"default_style"`
 SpeakerStyle string `json:"speaker_style"`
 CautiousStyle string `json:"cautious_style"`
 ByVector map[string]string `json:"by_vector"`
 Styles map[string]ApproachStyle `json:"styles"`
 OpeningLines []string `json:"opening_lines"`
}
// This value is saved with the accepted formation. It is not rerolled per tick.
type ApproachChoice struct {
 ID, Mode, Label, Reason, Call string
 Side int
 PositionWeight, DirectCost, SupportCost, BuddyWeight int
}
func approachHash(seed int64,id string)uint64{
 h:=uint64(14695981039346656037)^uint64(seed)
 for i:=0;i<len(id);i++{h^=uint64(id[i]);h*=1099511628211}
 return h
}
func(p ApproachPolicy) Select(vectors []string,fear,training float64,speaker bool,seed int64,id string)ApproachChoice{
 if !p.Enabled{return ApproachChoice{}}
 chosen,reason:=p.DefaultStyle,"default preference"
 for _,v:=range vectors{if style,ok:=p.ByVector[v];ok{chosen,reason=style,"dominant mapped vector: "+v;break}}
 if speaker{chosen,reason=p.SpeakerStyle,"appointed speaker"}
 if fear*(1-training)>=p.FearSupportThreshold{chosen,reason=p.CautiousStyle,"perceived fear after training damping"}
 style,ok:=p.Styles[chosen];if !ok{return ApproachChoice{}}
 h:=approachHash(seed,id);side:=1;if h&1==0{side=-1}
 call:="";if len(style.Calls)>0{call=style.Calls[(h>>1)%uint64(len(style.Calls))]}
 return ApproachChoice{ID:chosen,Mode:style.Mode,Label:style.Label,Reason:reason,Call:call,Side:side,PositionWeight:style.PositionWeight,DirectCost:style.DirectCost,SupportCost:style.SupportCost,BuddyWeight:style.BuddyWeight}
}
func(p ApproachPolicy) Opening(seed int64,id string,fallback string)string{
 if !p.Enabled||len(p.OpeningLines)==0{return fallback}
 return p.OpeningLines[approachHash(seed,id)%uint64(len(p.OpeningLines))]
}
func approachAxis(from,target Cell)Cell{
 x,y:=from.X-target.X,from.Y-target.Y;ax,ay:=x,y;if ax<0{ax=-ax};if ay<0{ay=-ay}
 if ax>=ay{if x<0{return Cell{-1,0}};return Cell{1,0}}
 if y<0{return Cell{0,-1}};return Cell{0,1}
}
func(c ApproachChoice) positionCost(from,stage,contact,target Cell,direct bool)int{
 if c.ID==""{if !direct{return 100000};return 0}
 cost:=c.SupportCost;if direct{cost=c.DirectCost}
 axis:=approachAxis(from,target);offset:=Cell{contact.X-target.X,contact.Y-target.Y}
 switch c.Mode{
 case "near": cost+=Distance(contact,Cell{target.X+axis.X,target.Y+axis.Y})*c.PositionWeight
 case "flank":
  cross:=axis.X*offset.Y-axis.Y*offset.X
  if cross==0{cost+=2*c.PositionWeight}else if cross*c.Side<0{cost+=c.PositionWeight}
 }
 return cost
}
func cloneApproaches(values map[string]ApproachChoice)map[string]ApproachChoice{
 if values==nil{return nil};result:=make(map[string]ApproachChoice,len(values));for id,c:=range values{result[id]=c};return result
}
