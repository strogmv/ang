func TestPopulationAnchorPrefixSpreadsAcrossAuthoredLevel(t *testing.T){
 for _,count:=range []int{2,3,16,107,118,123,127}{
  p:=PopulationModel{ShiftOffsets:[]int64{0,28800,57600},Anchors:map[string][]Cell{"market":{}}}
  for i:=0;i<count;i++{p.Anchors["market"]=append(p.Anchors["market"],Cell{i,0})}
  seen:=map[Cell]bool{};for i:=0;i<count;i++{at:=p.anchor(i*len(p.ShiftOffsets),"market");if seen[at]{t.Fatalf("stride repeated an anchor before exhausting %d places",count)};seen[at]=true}
  if count==118{buckets:=[8]int{};for i:=0;i<33;i++{at:=p.anchor(i*len(p.ShiftOffsets),"market");buckets[at.X*8/count]++};for _,n:=range buckets{if n==0{t.Fatalf("small population clustered in a prefix of the level: %v",buckets)}}}
 }
}

func TestPopulationFreeAnchorKeepsSpreadAndCollisionChecks(t *testing.T){
 p,l:=populationFixture();index:=12;first:=p.anchor(index,"a")
 occupied:=map[string]map[Cell]string{"a":{first:"other"}}
 next,ok:=p.freeAnchor(l,"a",index,occupied,"visitor");if !ok||next==first{t.Fatal("free anchor did not avoid real occupancy")}
 expected:=p.anchor(index+len(p.ShiftOffsets),"a");if next!=expected{t.Fatalf("collision fallback lost stable spread order: got %v want %v",next,expected)}
 for _,at:=range p.Anchors["a"]{occupied["a"][at]="other"};if _,ok=p.freeAnchor(l,"a",index,occupied,"visitor");ok{t.Fatal("spread bypassed full level admission")}
}

func populationFixture() (PopulationModel, LifeModel) {
	rows := make([]string, 20)
	for y := range rows {
		rows[y] = strings.Repeat(".", 32)
	}
	l := LifeModel{StartSeconds: 0, SecondsPerTick: 1, MoveTicks: 2, Walkable: map[string]bool{".": true}, Locations: map[string]LifeLocation{}, Actors: []LifePerson{{ID: "base", Name: "Base", Steps: []LifeStep{{Level: "a", At: Cell{31, 0}, Activity: "rest"}}}}}
	p := PopulationModel{MaxActors: 300, MaxActive: 100, MoveTicks: 2, ColdStepSeconds: 10, ShiftOffsets: []int64{0, 28800, 57600}, Stages: []PopulationStage{{ID: "home", Level: "a", Activity: "sleep", AtSecond: 0}, {ID: "work", Level: "b", Activity: "work", AtSecond: 28800}, {ID: "market", Level: "c", Activity: "rest", AtSecond: 57600}}, Anchors: map[string][]Cell{}}
	for _, level := range []string{"a", "b", "c"} {
		l.Locations[level] = LifeLocation{Name: level, Terrain: append([]string(nil), rows...)}
		for y := 0; y < 20; y += 2 {
			for x := 0; x < 32; x += 2 {
				p.Anchors[level] = append(p.Anchors[level], Cell{x, y})
			}
		}
	}
	for _, pair := range [][2]string{{"a", "b"}, {"b", "c"}, {"c", "a"}, {"b", "a"}, {"c", "b"}, {"a", "c"}} {
		l.Edges = append(l.Edges, LifeEdge{ID: pair[0] + pair[1], From: pair[0], To: pair[1], Exit: Cell{31, 19}, Entry: Cell{31, 0}, Mode: "walk", TravelSeconds: 20, Seats: 10})
	}
	return p, l
}
func populationCheck(t *testing.T, s PopulationState, p PopulationModel, l LifeModel, seconds, tick int64, env PopulationEnvironment) {
	t.Helper()
	if err := s.Validate(p, l, seconds, tick); err != nil {
		t.Fatal(err)
	}
	for level, cells := range s.Occupied() {
		for at := range cells {
			if env.Occupied[level][at] {
				t.Fatalf("population overlaps external actor at %s %+v", level, at)
			}
		}
	}
}
func populationAdvance(t *testing.T, s *PopulationState, p PopulationModel, l LifeModel, seconds, tick int64, level string, env PopulationEnvironment) {
	t.Helper()
	if err := s.Advance(p, l, seconds, tick, level, env); err != nil {
		t.Fatal(err)
	}
	populationCheck(t, *s, p, l, seconds, tick, env)
}
func TestPopulation100And300MaterializeWithoutOverlap(t *testing.T) {
	for _, count := range []int{100, 300} {
		t.Run(fmt.Sprint(count), func(t *testing.T) {
			p, l := populationFixture()
			s, err := p.Start(l, count, 0, 0)
			if err != nil {
				t.Fatal(err)
			}
			env := PopulationEnvironment{Occupied: map[string]map[Cell]bool{"a": {{0, 0}: true, {2, 0}: true, {31, 0}: true}}}
			populationAdvance(t, &s, p, l, 0, 0, "a", env)
			hot, cold := 0, 0
			for _, a := range s.Actors {
				if a.Materialized {
					hot++
				} else {
					cold++
				}
				if a.ID == "" {
					t.Fatal("anonymous population")
				}
			}
			if hot == 0 || hot > 100 || hot+cold != count {
				t.Fatal("population was dropped or active cap ignored")
			}
			before := s.Clone()
			populationAdvance(t, &s, p, l, 0, 0, "a", env)
			if !reflect.DeepEqual(before, s.Clone()) {
				t.Fatal("same-frame advance changed state")
			}
		})
	}
}
func TestPopulationColdSchedulesTravelWithoutClientOrPaths(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 300, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	original := make(map[string]string)
	for _, a := range s.Actors {
		original[a.ID] = a.Level
	}
	trips := false
	for tick := int64(1); tick <= 100; tick++ {
		seconds := int64(28800) + tick*10
		populationAdvance(t, &s, p, l, seconds, tick, "", PopulationEnvironment{})
		for _, a := range s.Actors {
			if a.Materialized || len(a.Path) > 0 {
				t.Fatal("offscreen actor used physical simulation")
			}
			trips = trips || a.Trip != nil
		}
	}
	changed := 0
	for _, a := range s.Actors {
		if a.Level != original[a.ID] {
			changed++
		}
	}
	if !trips || changed == 0 || len(s.Actors) != 300 {
		t.Fatal("coarse population did not commute independently")
	}
}
func TestPopulationActiveTransitionsAndSavePreserveIdentity(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 100, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 1, 1, "a", PopulationEnvironment{})
	raw, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var restored PopulationState
	if err := json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	if restored.routes != nil {
		t.Fatal("transient topology was saved")
	}
	clone := s.Clone()
	clone.Actors[0].Visits["a"] = 999
	if s.Actors[0].Visits["a"] == 999 {
		t.Fatal("clone aliases population history")
	}
	for tick := int64(2); tick <= 35; tick++ {
		level := "a"
		if tick >= 10 && tick < 20 {
			level = "b"
		}
		if tick >= 20 {
			level = "c"
		}
		seconds := tick * 10
		populationAdvance(t, &s, p, l, seconds, tick, level, PopulationEnvironment{})
		populationAdvance(t, &restored, p, l, seconds, tick, level, PopulationEnvironment{})
		if !reflect.DeepEqual(s.Clone(), restored.Clone()) {
			t.Fatal("population save/load diverged")
		}
	}
	for i, a := range s.Actors {
		if a.ID != fmt.Sprintf("population.%04d", i+1) {
			t.Fatal("LOD transition respawned identities")
		}
	}
}
func TestPopulationAdmissionQueueAndExternalReservations(t *testing.T) {
	p, l := populationFixture()
	p.MaxActive = 1
	s, err := p.Start(l, 9, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 1, 1, "a", PopulationEnvironment{})
	hot, waiting := 0, 0
	for _, a := range s.Actors {
		if a.Materialized {
			hot++
		}
		if a.Queued {
			waiting++
			if a.QueueReason != "active_limit" {
				t.Fatal("missing honest active-cap reason")
			}
		}
	}
	if hot != 1 || waiting != 2 {
		t.Fatal("excess population did not queue")
	}
	p.MaxActive = 3
	entry := l.Edges[2].Entry
	blocked := map[Cell]bool{entry: true, {entry.X - 1, entry.Y}: true, {entry.X, entry.Y + 1}: true}
	env := PopulationEnvironment{Occupied: map[string]map[Cell]bool{"a": blocked}}
	populationAdvance(t, &s, p, l, 2, 2, "a", env)
	for _, a := range s.Actors {
		if a.Queued && a.QueueReason != "entry_occupied" {
			t.Fatal("blocked entry was not reported")
		}
	}
	populationAdvance(t, &s, p, l, 3, 3, "a", PopulationEnvironment{})
	hot = 0
	for _, a := range s.Actors {
		if a.Materialized {
			hot++
		}
	}
	if hot < 2 {
		t.Fatal("queue did not admit after opening")
	}
}
