	hero.Trip = nil
	hero.ResidenceID = ""
	a.Level = cfg.LevelID
	a.Position = behavior.Cell{X: 7, Y: 47}
	a.ServiceAttachment = "sanitary.test"
	// Actual observer cell publication: cart is visible, the owner inside a cabin is not.
	view := &pb.PocObserverView{Cells: make([]string, 80)}
	for y := range view.Cells {
		view.Cells[y] = strings.Repeat("0", 112)
	}
	row := []byte(view.Cells[66])
	row[80] = '2'
	view.Cells[66] = string(row)
	visibleRaw := r.cartParkingJSON(hero, view)
	var public struct {
		Carts []struct {
