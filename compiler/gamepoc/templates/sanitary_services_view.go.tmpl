		}
	}
	return nil
}

func (r *Runtime) sanitaryPrivateActor(id string) bool {
	p, ok := r.state.Sanitary.Users[id]
	u := r.world.SanitaryServices.unit(p.UnitID)
	return ok && u != nil && sanitaryPrivate(p, *u)
}
