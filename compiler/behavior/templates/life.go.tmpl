   // A collision may clear the accepted path without cancelling the command.
   // Preserve that goal and retry it through the same occupancy-aware planner.
   // An idle controlled actor must never resume the person's daily routine.
   if a.Position==a.Goal&&len(a.Path)==0{if !a.Arrived{a.Arrived=true;a.StartedAt=s.Seconds;a.Activity="rest";a.Label="На месте"};continue}
   if a.Arrived||len(a.Path)>0{continue}
  }
  step:=person.Steps[a.Step];repairStep,repairing:=s.maintenanceStep(m,a.ID);if repairing{step=repairStep}
  if manualGoal{step=LifeStep{Level:a.Level,At:a.Goal,Activity:"rest",Label:"Свободное движение"}}
  if !manualGoal&&!repairing&&a.OverrideLevel==""&&a.Arrived&&len(person.Steps)>1{
   next:=(a.Step+1)%len(person.Steps);day:=a.Day;if next==0{day++};due:=day*86400+person.Steps[next].AtMinute*60
