func commerceQuantity(s inv.State,store string)int64{var n int64;for _,i:=range s.Items{if i.Location.Kind=="store"&&i.Location.Store==store{n+=i.Quantity}};return n}
func commerceTotal(s inv.State)int64{var n int64;for _,i:=range s.Items{n+=i.Quantity};return n}
type merchantHostDelivery struct{ID,Carrier string;Pickup,Dropoff int64;SourceBefore,SourceAfter,ShopBefore,ShopAfter int64;Cargo []inv.Cargo}
type merchantHostProof struct{Pass bool;Scope,ContentHash string;Start,End,Rate,InitialTotal,FinalTotal int64;PopulationIDs,ReplayTicks,PrivateHomes,Packed,Protected int;Deliveries []merchantHostDelivery}
func TestMarketDeliveriesActualNightLife100(t *testing.T){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 if len(r.world.Inventory.Deliveries)==0{t.Skip("fixture has no merchant deliveries")};if len(r.world.Inventory.Deliveries)!=8||len(r.world.Inventory.Shopfronts)<8{t.Fatal("incomplete eight-shop fixture")} // unsupplied tenant stalls may add shopfronts
 // This regression isolates delivery/packing conservation; stage-1 day tests include consumers.
