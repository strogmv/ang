   var hand=h.animator.GetBoneTransform(HumanBodyBones.RightHand);Transform tip=null;foreach(var x in prop.go.GetComponentsInChildren<Transform>())if(x.name=="contact_tip"){tip=x;break;}if(hand==null||tip==null)return false;
