func(r *Runtime) sceneFacts(a *demoAgent,seen bool)(map[string]bool,map[string]float64){
 p:=r.world.AI.Policy.Social;mp:=r.world.AI.Policy.Memory;cfg:=r.world.Config.CaptureDemo;d:=&r.state.Demo;hearing:=r.world.AI.Policy.Perception.Hearing
