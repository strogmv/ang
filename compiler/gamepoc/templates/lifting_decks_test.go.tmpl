   h.Position=behavior.Cell{X:d.Approach.X,Y:d.Approach.Y+13};h.Goal=h.Position;h.Body=nil;r.syncLifeHero();r.updateLifeExploration()
   r.sendState(c);state:=(<-c.out).GetGameState();access:=state.GetLife().GetLiftingDecks()[0].GetAccess()
   if !viewSees(state.PlayerView,int32(d.Approach.X),int32(d.Approach.Y))||!access.Visible||access.Reachable||!access.Routable{t.Fatalf("visible distant deck cannot be clicked and approached: %+v",access)}
  }
 })}
}

