        // Only presentation: every traversed point and its duration came from Go.
        // The small CUE-defined lead makes an accepted movement visible immediately;
        // no client pathfinding or game-state prediction is performed.
        void UpdateMotion()
        {
            if (state == null) return;
            double elapsed = Math.Min(Math.Max(0, clock.Elapsed.TotalSeconds - stateReceivedAt), resource.config.presentation_horizon_ms / 1000.0);
            double ns = state.SimTimeNs;
            if (!state.Paused)
                ns += (elapsed + resource.config.presentation_lead_ms / 1000.0) * 1e9 * state.Speed;
            if (!state.Paused) ns = Math.Max(renderedSimNS, ns);
            renderedSimNS = ns;
            shownPosition = SamplePath(new Vector2(state.PlayerX, state.PlayerY), state.Path, state.MotionStartNs, state.MovementStepNs, ns);
        }

        bool ClickMove(int x, int y)
        {
            if (!CanSend()) { message = connected ? "Дождитесь завершения текущего действия" : "Нет связи с сервером"; return false; }
            pendingMove = ++moveSequence;
            clickedTile = new Vector2(x, y); clickStartPosition = shownPosition;
            clickAt = clock.Elapsed.TotalSeconds; markerUntil = clickAt + 3;
            moveStatus = "Проверяем путь…"; moveAccepted = false; ackMS = -1; beginMS = -1; beginPending = true; latencyResultReady = false;
            try { session.SendMoveTo(new MoveTo { X = x, Y = y, Epoch = state.Epoch, InputSeq = pendingMove }); }
            catch (Exception e) { beginPending = false; moveStatus = "Команда не отправлена"; message = e.Message; return false; }
            return true;
        }

