// Code generated by ANG. Physical light/shadow regressions, no presentation dependencies.
package behavior

import (
	"encoding/json"
	"math"
	"reflect"
	"testing"
)

func illuminationVolume(t *testing.T) *DeckVolume {
	t.Helper()
	v := &DeckVolume{Schema: "ang.multideck.v1", PlanWidth: 6, PlanDepth: 4, NavWidth: 6, NavDepth: 8, EyeMM: 1600, TargetMM: []int{1000, 1700}, SightRangeCells: 20,
		Surfaces: []DeckSurface{
			{ID: "base", Index: 0, Grounded: true, Walkable: true, Slab: []DeckRect{{X: 0, Y: 0, W: 6, H: 4}}},
			{ID: "gallery", Index: 1, ElevationMM: 3000, SlabMM: 200, Walkable: true, NavRow: 4, Slab: []DeckRect{{X: 1, Y: 0, W: 5, H: 4}}},
		}}
	illuminationPrepare(t, v)
	return v
}
func illuminationPrepare(t *testing.T, v *DeckVolume) {
	t.Helper()
	if err := v.Prepare(); err != nil {
		t.Fatal(err)
	}
}
func illuminationRay(t *testing.T, v *DeckVolume, a, b DeckPointMM, boxes []DeckRayBox, want bool) {
	t.Helper()
	if got := v.RayClearMM(a, b, boxes); got != want {
		t.Fatalf("RayClearMM(%+v,%+v)=%v, want %v", a, b, got, want)
	}
	if got := v.RayClearMM(b, a, boxes); got != want {
		t.Fatalf("reverse RayClearMM(%+v,%+v)=%v, want %v", b, a, got, want)
	}
}

func TestIlluminationPhysicalSlabThicknessAndVoid(t *testing.T) {
	v := illuminationVolume(t)
	// A same-plan vertical segment must cross the actual gallery slab. The
	// adjacent column without a slab is an opening, not an invisible ceiling.
	illuminationRay(t, v, DeckPointMM{750, 750, 2000}, DeckPointMM{750, 750, 3500}, nil, false)
	illuminationRay(t, v, DeckPointMM{250, 750, 2000}, DeckPointMM{250, 750, 3500}, nil, true)
	illuminationRay(t, v, DeckPointMM{750, 750, 2799}, DeckPointMM{1750, 750, 2799}, nil, true)
	illuminationRay(t, v, DeckPointMM{750, 750, 2801}, DeckPointMM{1750, 750, 2801}, nil, false)
	illuminationRay(t, v, DeckPointMM{750, 750, 2800}, DeckPointMM{1750, 750, 2800}, nil, false)
	// Grounded material continues below the floor.
	illuminationRay(t, v, DeckPointMM{250, 750, -1}, DeckPointMM{250, 750, 1000}, nil, false)
}

func TestIlluminationPreservesAuthoredXYZAndCellBoundaryOrigin(t *testing.T) {
	v := illuminationVolume(t)
	v.Solids = []DeckSpan{{Rect: DeckRect{X: 1, Y: 1, W: 1, H: 1}, BottomMM: 0, TopMM: 2000}}
	illuminationPrepare(t, v)
	// The boundary is exactly 500, not 250. These emitters differ by two mm;
	// rounding either to a cell centre destroys the wall-side distinction.
	illuminationRay(t, v, DeckPointMM{499, 750, 1000}, DeckPointMM{250, 750, 1000}, nil, true)
	illuminationRay(t, v, DeckPointMM{501, 750, 1000}, DeckPointMM{250, 750, 1000}, nil, false)
	illuminationRay(t, v, DeckPointMM{500, 750, 1000}, DeckPointMM{250, 750, 1000}, nil, false)
	// A light can occupy a real XYZ under a gallery without a standable nav
	// node at that height. Physical tracing never calls Locate on the emitter.
	illuminationRay(t, v, DeckPointMM{501, 499, 2770}, DeckPointMM{1499, 499, 2770}, nil, true)
}

