// Code generated by ANG. Persistent coarse residences behind physical portals.
package behavior

import "fmt"

type LifeResidence struct {
 ID string `json:"id"`
 Level string `json:"level"`
 Entry Cell `json:"entry"`
 ReturnAt Cell `json:"return_at"`
 Capacity int `json:"capacity"`
 Residents []string `json:"residents"`
}
// OnFloor excludes both transit and private coarse interiors from physical queries.
func(a LifeActor)OnFloor()bool{return a.Trip==nil&&a.ResidenceID==""&&a.ServiceAttachment==""}
func(m LifeModel)Residence(id string)*LifeResidence{for i:=range m.Residences{if m.Residences[i].ID==id{return &m.Residences[i]}};return nil}
func(m LifeModel)ActorResidence(id string)*LifeResidence{for i:=range m.Residences{for _,resident:=range m.Residences[i].Residents{if resident==id{return &m.Residences[i]}}};return nil}
func(r LifeResidence)matches(step LifeStep)bool{return step.Activity=="sleep"&&step.Level==r.Level&&step.At==r.Entry}
func(m LifeModel)validateResidences()error{
 ids,people:=map[string]bool{},map[string]bool{}
 for _,r:=range m.Residences{
  if r.ID==""||ids[r.ID]||r.Capacity<1||r.Capacity>1000||len(r.Residents)==0||len(r.Residents)>r.Capacity||!m.Walks(r.Level,r.Entry)||!m.Walks(r.Level,r.ReturnAt)||Distance(r.Entry,r.ReturnAt)!=1{return fmt.Errorf("invalid residence %s",r.ID)};ids[r.ID]=true
  for _,edge:=range m.Edges{if (edge.From==r.Level&&(edge.Exit==r.Entry||edge.Exit==r.ReturnAt))||(edge.To==r.Level&&(edge.Entry==r.Entry||edge.Entry==r.ReturnAt)){return fmt.Errorf("residence %s conflicts with travel port",r.ID)}}
  for _,id:=range r.Residents{p:=m.Person(id);if id==""||people[id]||p==nil{return fmt.Errorf("invalid residence resident %s",id)};people[id]=true;hasSleep:=false
   for _,step:=range p.Steps{if r.matches(step){hasSleep=true};target:=step.At
    if step.Level!=r.Level{edge:=m.NextEdge(r.Level,step.Level);if edge==nil{return fmt.Errorf("residence %s has no route to routine",r.ID)};target=edge.Exit}
    if target!=r.Entry&&len(m.Space(r.Level,nil).Path(r.Entry,target,Cell{},0))==0{return fmt.Errorf("residence %s disconnected from routine",r.ID)}
   };if !hasSleep{return fmt.Errorf("residence resident %s has no home sleep step",id)}
  }
 }
 return nil
}
func(s *LifeState)enterResidence(m LifeModel,a *LifeActor)bool{
 if !a.OnFloor()||a.ID==s.ControlledActorID||a.Manual||a.OverrideLevel!=""||!a.Arrived||a.Activity!="sleep"||len(a.Path)>0{return false}
 r:=m.ActorResidence(a.ID);p:=m.Person(a.ID);if r==nil||p==nil||!r.matches(func()LifeStep{if m.Brain.Enabled&&a.Brain.Target.Level!=""{return a.Brain.Target};return p.Steps[a.Step]}())||a.Level!=r.Level||a.Position!=r.Entry{return false}
 a.ResidenceID=r.ID;a.Goal=a.Position;a.PendingPath=nil;a.WaitingDeparture=0;a.YieldUntil=0;a.YieldRequester="";a.YieldOrigin=Cell{};a.YieldHoldUntil=0;a.YieldCooldownUntil=0
 return true
}
// No elapsed simulation means no exit, sleep gain, schedule change or occupancy mutation.
func(s *LifeState)advanceResidence(m LifeModel,a *LifeActor,tick,delta int64)bool{
 if a.ResidenceID==""{return false}
 r:=m.Residence(a.ResidenceID);p:=m.Person(a.ID);if r==nil||p==nil{return true} // Validate rejects broken saves.
 if a.ID==s.ControlledActorID||a.Manual{return true} // Never move a controlled actor automatically.
 if a.Arrived&&a.Activity=="sleep"{a.SleptSeconds+=delta}
 step:=p.Steps[a.Step];if m.Brain.Enabled&&a.Brain.Target.Level!=""{step=a.Brain.Target}
 if !m.Brain.Enabled&&a.Arrived&&len(p.Steps)>1{next:=(a.Step+1)%len(p.Steps);day:=a.Day;if next==0{day++};due:=day*86400+p.Steps[next].AtMinute*60
  if s.Seconds>=due&&s.Seconds-a.StartedAt>=step.MinSeconds{a.Step=next;a.Day=day;step=p.Steps[next];a.Arrived=false}
 }
 if r.matches(step)&&a.OverrideLevel==""{if !a.Arrived{a.StartedAt=s.Seconds;a.Activity=step.Activity;a.Label=step.Label};a.Arrived=true;return true}
 a.Activity="rest";a.Label="life.residence.waiting_exit"
 if !m.Walks(r.Level,r.ReturnAt)||s.occupied(r.Level,r.ReturnAt,a.ID){return true}
 a.ResidenceID="";a.Level=r.Level;a.Position=r.ReturnAt;a.Goal=r.ReturnAt;a.Path=nil;a.PendingPath=nil;a.MoveStartTick=tick;a.Arrived=false
 return false
}
func(s LifeState)validateResidenceState(m LifeModel)error{
 counts:=map[string]int{}
 for _,a:=range s.Actors{if a.ResidenceID==""{continue};r:=m.Residence(a.ResidenceID);bound:=m.ActorResidence(a.ID)
  if r==nil||bound==nil||bound.ID!=r.ID||a.Level!=r.Level||a.Position!=r.Entry||a.Goal!=r.Entry||a.Trip!=nil||len(a.Path)>0||len(a.PendingPath)>0||a.Manual||a.ID==s.ControlledActorID||a.WaitingDeparture!=0||a.YieldRequester!=""||a.YieldUntil!=0{return fmt.Errorf("invalid private residence state for %s",a.ID)}
  p:=m.Person(a.ID);if p==nil||a.Step<0||a.Step>=len(p.Steps){return fmt.Errorf("invalid residence routine step %s",a.ID)}
  if a.Arrived&&!r.matches(func()LifeStep{if m.Brain.Enabled&&a.Brain.Target.Level!=""{return a.Brain.Target};return p.Steps[a.Step]}()){return fmt.Errorf("private resident arrived at a non-home step %s",a.ID)}
  counts[r.ID]++;if counts[r.ID]>r.Capacity{return fmt.Errorf("residence capacity exceeded %s",r.ID)}
 }
 return nil
}
