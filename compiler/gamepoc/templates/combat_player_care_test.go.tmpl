// Existing people/equipment and an explicit test weapon balance are arranged.
// Accepted kernel actions + the real atomic host commit cause all injuries and
// surrender. This tests execution/first aid, not the NPC's utility choice.
func combatPlayerCareInjury(t *testing.T,stun bool)(*Runtime,*connection,string){
 t.Helper();r,c,target:=combatLifeFixture(t,true);combatPhysicalFixture(t,r,target,false);r.world.CombatLife.Responders=map[string]combatResponder{}
 model:=r.inventoryModelFor(true);model.Sources=append(model.Sources,inv.Source{ID:"care.hero.medkit",Definition:"item.medkit_guard",Quantity:1,Condition:1000000,Owner:playerActorID,Location:inv.Location{Kind:"store",Store:inv.ActorStore(playerActorID)}});r.world.Inventory=model;r.lifeInventory=lifeInventoryCache{};var err error;r.state.Inventory,err=inv.New(r.inventoryModelFor(true),r.state.Seed);if err!=nil{t.Fatal(err)}
 weapon:=r.world.CombatRuntime.Weapons[combatFixtureBlade];if stun{weapon.Kind="blunt";weapon.WoundProfile="item.service_baton";weapon.HeavyAP=4;weapon.HeavyDamagePercent=100};r.world.CombatRuntime.Weapons[combatFixtureBlade]=weapon
 combatStart(t,r,c,target);if err:=r.performCombatAction(playerActorID,&behavior.CombatAction{Type:"end"});err!=nil{t.Fatal(err)}
 found:=false
 for seed:=int64(1);seed<=200;seed++{trial:=&Runtime{world:r.world,state:r.snapshotState(),npcAccountIDs:r.npcAccountIDs};trial.state.Seed=seed;trial.state.Combat.Seed=seed
  strike:=behavior.CombatAction{Type:"attack",TargetID:playerActorID,BodyPart:"arms"};if stun{strike.Mode="heavy";strike.BodyPart="head"}
  if err:=trial.performCombatAction(target,&strike);err!=nil{t.Fatal(err)};body:=combatBody(*trial.state.Combat.Actor(playerActorID));status:=combatWounds.Status(body)
  good:=status.Conscious&&status.CanWalk&&status.ExternalULS>0&&!combatWounds.Serious(body)&&len(body.Wounds)==1&&body.Wounds[0].Depth=="shallow"
  if stun{good=!status.Conscious&&body.KnockoutUntil>body.Clock&&combatWounds.Forecast(body,600).DeadS<0}
  if good{r.state=trial.state;found=true;break}
 };if !found{t.Fatal("no surviving player wound in 200 explicit initial seeds")}
 if r.state.Combat.Active{if err:=r.performCombatAction(target,&behavior.CombatAction{Type:"surrender"});err!=nil{t.Fatal(err)}}
 if r.state.Combat.Active{t.Fatal("encounter did not finish")};return r,c,target
}
func TestCombatPlayerCareWireBandageHealTimeAndReplay(t *testing.T){
 r,c,target:=combatPlayerCareInjury(t,false)
 // Wire/replay needs a genuinely safe clinical interval. The opponent is
 // unconscious in the body model for twice the complete treatment duration.
 opponent:=r.state.CombatRoster[target];ob:=combatBody(opponent);ob.KnockoutFrom=ob.Clock;ob.KnockoutUntil=ob.Clock+2*(combatWounds.Aid.Kinds["dressing"].Seconds+combatWounds.Aid.Kinds["medkit"].Seconds);projectWoundBody(&opponent,ob);r.state.CombatRoster[target]=opponent;r.storeWoundBody(opponent);r.combatCareHold(opponent)
 old:=combatBody(r.state.CombatRoster[playerActorID]);seconds:=r.state.Life.Seconds;count:=r.combatCount(r.state.Inventory,playerActorID,"item.med_patch",nil)
 q:=&pb.PocCombatCommand{RequestId:"care.player.bandage",Action:"bandage",ExpectedTurn:r.state.Combat.Turn};result,view:=combatWire(t,r,c,q);if !result.Ok{t.Fatal(result.Message)}
 after:=combatBody(r.state.CombatRoster[playerActorID]);controlled:=false;for _,w:=range after.Wounds{for _,control:=range w.Controls{controlled=controlled||control=="dressing"}}
 if !controlled||r.state.Life.Seconds!=seconds+combatWounds.Aid.Kinds["dressing"].Seconds||r.combatCount(r.state.Inventory,playerActorID,"item.med_patch",nil)!=count-1||len(after.Wounds)!=len(old.Wounds){t.Fatal("outside dressing did not spend real stock and 30 seconds on the wound")}
 if view==nil||view.PlayerCondition==nil||len(view.PlayerCondition.BodyLines)==0||view.PlayerCondition.Hp!=0||view.PlayerCondition.MaxHp!=0{t.Fatal("condition must publish wound/time text without HP")}
 items:=r.state.Inventory.Clone();clock:=r.state.Life.Seconds;result,_=combatWire(t,r,c,q);if !result.Ok||!reflect.DeepEqual(items,r.state.Inventory)||clock!=r.state.Life.Seconds{t.Fatal("first-aid replay spent time or supplies twice")}
 kits:=r.combatCount(r.state.Inventory,playerActorID,"item.medkit_guard",nil);result,_=combatWire(t,r,c,&pb.PocCombatCommand{RequestId:"care.player.heal",Action:"heal",ExpectedTurn:r.state.Combat.Turn});if !result.Ok{t.Fatal(result.Message)}
 healed:=combatBody(r.state.CombatRoster[playerActorID]);if !healed.Wounds[0].Treated||r.combatCount(r.state.Inventory,playerActorID,"item.medkit_guard",nil)!=kits-1||r.state.Life.Seconds!=clock+combatWounds.Aid.Kinds["medkit"].Seconds{t.Fatal("medkit must treat the actual shallow wound using its own item and time")}
}
func TestCombatPlayerCareRejectsPauseMovementAndRealStunAtomically(t *testing.T) {
	for _, kind := range []string{"paused", "moving", "stunned"} {
		t.Run(kind, func(t *testing.T) {
			r, c, _ := combatPlayerCareInjury(t, kind == "stunned")
			if kind == "paused" {
				r.state.Paused = true
			}
			if kind == "moving" {
				hero := r.state.Life.Actor(playerActorID)
				model := r.state.Life.GateModel(r.world.Life)
				blocked := r.state.Life.BlockedCells(hero.Level, hero.ID)
				chosen := false
				for _, goal := range model.StepNeighbours(hero.Level, hero.Position) {
					if !model.Walks(hero.Level, goal) || blocked[goal] {
						continue
					}
					r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 17, X: int32(goal.X), Y: int32(goal.Y)})
					for len(c.out) > 0 {
						<-c.out
					}
					if len(r.state.Life.Actor(playerActorID).Path) > 0 || r.state.Life.Actor(playerActorID).Body != nil && r.state.Life.Actor(playerActorID).Body.Moving {
						chosen = true
						break
					}
				}
				if !chosen {
					t.Fatal("real Life route did not enter movement")
				}
			}
			if kind == "stunned" && !r.state.Life.Actor(playerActorID).CombatHold {
				t.Fatal("real heavy head blow did not pin player body")
			}
			before := r.snapshotState()
			result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "care.player.reject." + kind, Action: "heal", ExpectedTurn: r.state.Combat.Turn})
			if result.Ok || !reflect.DeepEqual(before.Inventory, r.state.Inventory) || !reflect.DeepEqual(before.CombatRoster, r.state.CombatRoster) || before.Life.Seconds != r.state.Life.Seconds || !reflect.DeepEqual(before.CombatCare, r.state.CombatCare) {
				t.Fatal("rejected outside aid committed physical/health/time changes")
			}
		})
	}
}

func TestCombatV4ReturningThreatInterruptsOutsideAidWithoutRefund(t *testing.T){
 r,c,target:=combatPlayerCareInjury(t,false);opponent:=r.state.CombatRoster[target];opponent.StandDownUntil=combatBody(opponent).Clock+1;r.state.CombatRoster[target]=opponent
 count:=r.combatCount(r.state.Inventory,playerActorID,"item.medkit_guard",nil);clock:=r.state.Life.Seconds
 answer,_:=combatWire(t,r,c,&pb.PocCombatCommand{RequestId:"care.threat.returns",Action:"heal",ExpectedTurn:r.state.Combat.Turn})
 if !answer.Ok{t.Fatal("initially surrendered enemy should permit starting aid",answer.Message)}
 hero:=r.state.CombatRoster[playerActorID]
 if r.combatCount(r.state.Inventory,playerActorID,"item.medkit_guard",nil)!=count-1||hero.Aid!=nil||combatBody(hero).Wounds[0].Treated||r.state.Life.Seconds-clock>=combatWounds.Aid.Kinds["medkit"].Seconds{t.Fatal("returning threat did not interrupt real work, or refunded/treated the wound")}
}
