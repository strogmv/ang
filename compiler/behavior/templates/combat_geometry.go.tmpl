// Code generated by ANG. Physical range and directional protection for tactical combat.
package behavior

import "math"

// CombatRangeMM measures actual plan/height coordinates, never navigation-band rows.
func (v *DeckVolume) CombatRangeMM(a, b Cell) int {
	pa, ha, _, oka := v.Locate(a)
	pb, hb, _, okb := v.Locate(b)
	if !oka || !okb {
		return 1 << 30
	}
	dx, dy, dz := float64(pa.X-pb.X)*deckCellMM, float64(pa.Y-pb.Y)*deckCellMM, float64(ha-hb)
	return int(math.Ceil(math.Sqrt(dx*dx + dy*dy + dz*dz)))
}

// CombatProtection samples three target heights against authoritative solids.
// It is geometric protection, not material penetration or ballistic simulation.
func (v *DeckVolume) CombatProtection(a, b Cell) float64 {
	pa, ha, _, oka := v.Locate(a)
	pb, hb, _, okb := v.Locate(b)
	if !oka || !okb {
		return 1
	}
	blocked := 0
	for _, h := range []int{500, 1000, 1600} {
		if !v.clear(pa, float64(ha+v.EyeMM), pb, float64(hb+h)) {
			blocked++
		}
	}
	return float64(blocked) / 3
}

func (v *DeckVolume) CombatShotClear(a, b Cell) bool { return v.CombatProtection(a, b) < 1 }

func (v *DeckVolume) BodyOnCombatShot(from, to, body Cell) bool {
	a, ha, _, oka := v.Locate(from)
	b, hb, _, okb := v.Locate(to)
	p, hp, _, okp := v.Locate(body)
	if !oka || !okb || !okp {
		return true
	}
	ax, ay, az := float64(a.X)*deckCellMM, float64(a.Y)*deckCellMM, float64(ha+v.EyeMM)
	dx, dy, dz := float64(b.X-a.X)*deckCellMM, float64(b.Y-a.Y)*deckCellMM, float64(hb+1000)-az
	length := dx*dx + dy*dy
	if length == 0 {
		return false
	}
	t := ((float64(p.X)*deckCellMM-ax)*dx + (float64(p.Y)*deckCellMM-ay)*dy) / length
	if t <= 0 || t >= 1 {
		return false
	}
	z := az + t*dz
	return z >= float64(hp) && z <= float64(hp+1800) && math.Hypot(ax+t*dx-float64(p.X)*deckCellMM, ay+t*dy-float64(p.Y)*deckCellMM) < 225
}

// Counts obstructed plan samples along the sound ray. This reuses the game's
// attenuated straight-ray hearing model, not room-acoustics simulation.
func (v *DeckVolume) CombatSoundBlockers(from, to Cell) int {
	a, ha, _, oka := v.Locate(from)
	b, hb, _, okb := v.Locate(to)
	if !oka || !okb {
		return 100
	}
	steps := max(absCombat(a.X-b.X), absCombat(a.Y-b.Y))
	count := 0
	previous := -1
	for i := 1; i < steps; i++ {
		t := float64(i) / float64(steps)
		x := int(math.Round(float64(a.X) + float64(b.X-a.X)*t))
		y := int(math.Round(float64(a.Y) + float64(b.Y-a.Y)*t))
		n := y*v.PlanWidth + x
		if n == previous {
			continue
		}
		previous = n
		z := float64(ha+v.EyeMM) + float64(hb-ha)*t
		if v.blocked(n, z-1, z+1) {
			count++
		}
	}
	return count
}
func absCombat(n int) int {
	if n < 0 {
		return -n
	}
	return n
}
