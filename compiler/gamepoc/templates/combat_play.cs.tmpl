   if(attack==null||defender==null||attack.go==null||defender.go==null)return -1;var atip=Array.Find(attack.go.GetComponentsInChildren<Transform>(),t=>t.name=="contact_tip");var dtip=Array.Find(defender.go.GetComponentsInChildren<Transform>(),t=>t.name=="contact_tip");if(atip==null||dtip==null)return -1;
