func passThroughDeck(t *testing.T,r *Runtime)liftingDeckDefinition{
 if r.world.LiftingDecks!=nil{for _,d:=range r.world.LiftingDecks.Decks{if d.Lower!=nil{return d}}}
 t.Skip("content has no pass-through deck");return liftingDeckDefinition{}
}
func parkActor(r *Runtime,id,level string,at behavior.Cell)*behavior.LifeActor{
 a:=r.state.Life.Actor(id);a.Level=level;a.Position=at;a.Goal=at;a.Path=nil;a.PendingPath=nil;a.Body=nil;a.Trip=nil;a.Mount=nil;a.Manual=true;a.Arrived=true;a.OverrideLevel="";a.OverrideEdge="";a.Visits[level]=1;return a
}
func cargoLoader(t *testing.T,r *Runtime)string{if r.world.CargoConvoys==nil||len(r.world.CargoConvoys.Convoys)==0||len(r.world.CargoConvoys.Convoys[0].Crew)<2{t.Skip("no cargo crew")};return r.world.CargoConvoys.Convoys[0].Crew[1].ID}

// Each landing has its own open side, barrier and approach; the two sides are opposite.
func TestPassThroughDeckLandingsOpenOnOppositeSides(t *testing.T){
 r:=lifeRuntimeFixture(t);d:=passThroughDeck(t,r);l:=d.Lower
 if d.OpenSide==l.OpenSide{t.Fatal("both landings open on the same side: a convoy would have to reverse")}
 side:=func(open string,rect,barrier struct{X,Y,W,H int},approachY int)bool{if open=="south"{return barrier.Y==rect.Y+rect.H&&approachY>barrier.Y};return barrier.Y+barrier.H==rect.Y&&approachY<barrier.Y}
 if !side(d.OpenSide,d.Rect,d.BarrierRect,d.Approach.Y)||!side(l.OpenSide,l.Rect,l.BarrierRect,l.Approach.Y){t.Fatal("a barrier or approach is not on its landing's open side")}
 up,down:=r.world.Life.Edge(d.ReturnEdge),r.world.Life.Edge(d.TravelEdge)
 if up==nil||down==nil||!l.contains(up.Exit)||!d.contains(down.Exit){t.Fatal("riders must leave standing on the deck")}
 if d.contains(up.Entry)||up.Entry.Y<=d.BarrierRect.Y||l.contains(down.Entry)||down.Entry.Y>=l.BarrierRect.Y{t.Fatal("riders must step off on the open side of the other landing")}
}

// Upward: ten physical seconds of signal at the lower landing, nobody on its barrier line,
// riders standing on the deck leave when the leaves above start to move and step off only on the open hub deck.
func TestPassThroughDeckRidesUpFromTheLowerLanding(t *testing.T){
 r:=lifeRuntimeFixture(t);d:=passThroughDeck(t,r);l:=d.Lower;r.state.Life.SecondsPerTick=1
 parkActor(r,playerActorID,l.LevelID,behavior.Cell{X:l.Approach.X,Y:l.Approach.Y});r.syncLifeHero();r.updateLifeExploration()
 up:=r.world.Life.Edge(d.ReturnEdge)
 rider:=parkActor(r,"char.poc_hub_guard",l.LevelID,up.Exit)
 blocker:=parkActor(r,cargoLoader(t,r),l.LevelID,behavior.Cell{X:l.BarrierRect.X+1,Y:l.BarrierRect.Y})
 g:=r.state.LiftingDecks[d.ID];if _,_,open:=g.lowerPose(d);!open||g.lowerPhase(d)!="lower_open"{t.Fatal("the deck does not stand open at the lower landing between runs")}
 if r.world.Life.Locations[l.LevelID].Terrain[l.Rect.Y][l.Rect.X]!='.'{t.Fatal("the standing deck is not floor")}
 g.NextRunSecond=r.state.Life.Seconds;r.state.LiftingDecks[d.ID]=g
 signalStart:=int64(-1)
 for tick:=0;tick<400;tick++{
  r.step();g=r.state.LiftingDecks[d.ID]
  if g.Phase=="equalising"&&signalStart<0{signalStart=g.UpdatedNS}
  if g.LowerAway||g.pose(g.UpdatedNS).Barrier>0{t.Fatalf("the deck moved with a person on the lower barrier line (phase %s)",g.Phase)}
  if tick>10&&g.lowerPhase(d)!="lower_signal"{t.Fatalf("lower landing shows %s while the signal holds",g.lowerPhase(d))}
 }
 if g.Phase!="signal_up"{t.Fatalf("occupied lower edge did not hold the signal: %s",g.Phase)}
 parkActor(r,blocker.ID,l.LevelID,behavior.Cell{X:l.Approach.X+2,Y:l.Approach.Y})
 left:=int64(-1)
 for tick:=0;tick<300&&left<0;tick++{r.step();g=r.state.LiftingDecks[d.ID];if g.LowerAway{left=g.UpdatedNS}}
 if left<0{t.Fatal("the deck never left the lower landing")}
 if left-signalStart<d.SignalBeforeOpenS*1000000000{t.Fatalf("lower signal lasted %d ns before departure, less than ten seconds",left-signalStart)}
 rider=r.state.Life.Actor(rider.ID);if rider.Trip==nil||rider.Trip.Edge!=up.ID{t.Fatalf("the rider on the deck did not leave with it: %+v",rider)}
 if r.world.Life.Locations[l.LevelID].Terrain[l.Rect.Y][l.Rect.X]=='.'||r.world.Life.Locations[l.LevelID].Terrain[l.BarrierRect.Y][l.BarrierRect.X]=='.'{t.Fatal("the empty lower landing is still walkable")}
 for tick:=0;tick<600;tick++{
  r.step();g=r.state.LiftingDecks[d.ID];rider=r.state.Life.Actor(rider.ID)
  if rider.Trip==nil{p:=g.pose(g.UpdatedNS);if rider.Level!=d.LevelID||d.contains(rider.Position)||rider.Position.Y<=d.BarrierRect.Y||!(g.Phase=="loading"||g.Phase=="signal_down")||p.Deck!=liftingDeckFull||p.Barrier!=0{t.Fatalf("rider stepped off at %s %v during %s",rider.Level,rider.Position,g.Phase)};return}
 }
 t.Fatal("the rider never arrived on the hub deck")
}

// Downward: riders on the hub deck leave at the descent and step off only when the deck stands open below.
func TestPassThroughDeckRidesDownToTheLowerLanding(t *testing.T){
 r:=lifeRuntimeFixture(t);d:=passThroughDeck(t,r);l:=d.Lower;r.state.Life.SecondsPerTick=1
 parkActor(r,playerActorID,d.LevelID,behavior.Cell{X:d.Approach.X,Y:d.Approach.Y+4});r.syncLifeHero();r.updateLifeExploration()
 down:=r.world.Life.Edge(d.TravelEdge)
 g:=r.state.LiftingDecks[d.ID];g.NextRunSecond=r.state.Life.Seconds;r.state.LiftingDecks[d.ID]=g
 for tick:=0;tick<800&&r.state.LiftingDecks[d.ID].Phase!="loading";tick++{r.step()}
 if r.state.LiftingDecks[d.ID].Phase!="loading"{t.Fatal("the deck never opened in the hub")}
 rider:=parkActor(r,"char.poc_hub_guard",d.LevelID,down.Exit)
 for tick:=0;tick<600&&r.state.Life.Actor(rider.ID).Trip==nil;tick++{
  r.step();g=r.state.LiftingDecks[d.ID]
  if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatalf("a rider waiting on the hub deck is not a valid Life state during %s: %v",g.Phase,err)}
  if (g.Phase=="signal_down"||g.Phase=="departure_barrier")&&r.liftingDeckLowerEdgeBusy(d){t.Fatal("unexpected body on the lower edge")}
 }
 rider=r.state.Life.Actor(rider.ID);if rider.Trip==nil||rider.Trip.Edge!=down.ID{t.Fatal("the rider did not leave with the descending deck")}
 g=r.state.LiftingDecks[d.ID];if !g.LowerAway||g.LowerArriveSecond!=rider.Trip.Arrival{t.Fatalf("the deck and its rider disagree about the arrival below: %d vs %d",g.LowerArriveSecond,rider.Trip.Arrival)}
 for tick:=0;tick<800;tick++{
  r.step();g=r.state.LiftingDecks[d.ID];rider=r.state.Life.Actor(rider.ID)
  if rider.Trip==nil{if _,_,open:=g.lowerPose(d);!open||rider.Level!=l.LevelID||l.contains(rider.Position)||rider.Position.Y>=l.BarrierRect.Y{t.Fatalf("rider stepped off below at %s %v, landing phase %s",rider.Level,rider.Position,g.lowerPhase(d))};return}
 }
 t.Fatal("the rider never arrived at the lower landing")
}

// The route is driveable straight through the decks: the heading at the end of each deck's boarding track is the
// heading at the start of the drive off it on the other landing, and every drive moves along its own heading (a
// reverse drive against it).
func TestCargoConvoyDrivesStraightThroughTheDeck(t *testing.T){
 r:=lifeRuntimeFixture(t);if r.world.CargoConvoys==nil{t.Skip("no cargo convoys")}
 turn:=func(a,b float64)float64{d:=math.Mod(a-b+540,360)-180;return math.Abs(d)}
 for _,v:=range r.world.CargoConvoys.Convoys{for _,run:=range v.Runs{decks:=0
  for i,leg:=range run.Legs{
   if leg.Kind!="drive"&&leg.Kind!="deck"{continue}
   for at:=0.5;at<cargoTrackLength(leg.Path);at+=0.5{ax,az:=cargoTrackAt(leg.Path,at-0.1);bx,bz:=cargoTrackAt(leg.Path,at+0.1);p,_:=v.poses(leg.Path,at,leg.Reverse);dir:=cargoDeg(math.Atan2(bz-az,bx-ax));if leg.Reverse{dir=cargoDeg(math.Atan2(bz-az,bx-ax)+math.Pi)};if turn(dir,p.Yaw)>15{t.Fatalf("%s leg %d moves against its heading",run.ID,i)}}
   if leg.Kind!="deck"{continue};decks++
   if i+1>=len(run.Legs)||run.Legs[i+1].Kind!="drive"||run.Legs[i+1].LevelID!=leg.ToLevel{t.Fatalf("%s: deck leg %d is not followed by a drive off it",run.ID,i)}
   end,_:=v.poses(leg.Path,cargoTrackLength(leg.Path),false);next,_:=v.poses(run.Legs[i+1].Path,0,false)
   if turn(end.Yaw,next.Yaw)>0.01{t.Fatalf("%s turns on the deck (leg %d)",run.ID,i)}
  }
  if decks<2{t.Fatalf("%s rides the deck %d times: it must go up and come back",run.ID,decks)}
 }}
}

// cargoTotals: every unit of the lots' goods anywhere (stores, people, bags) plus what visitors carried out of the
// sector. Nothing else creates or destroys them in a world without the brain's consumers.
func cargoTotals(r *Runtime)map[string]int64{
 defs:=map[string]bool{};for _,lot:=range r.world.CargoConvoys.Lots{if lot.Definition!=""{defs[lot.Definition]=true};for _,it:=range lot.Items{defs[it.Item]=true}}
 out:=map[string]int64{};for d:=range defs{out[d]=r.state.Visitors.Ledger.Carried[d]}
 for _,i:=range r.state.Inventory.Items{if defs[i.Definition]{out[i.Definition]+=i.Quantity}}
 return out
}
type cargoLotTrack struct{Loaded,Landed,Stocked,Opened int64;Units int64;Cycle uint64}

// The morning chain at a calendar rate: the crew gathers, loads, rides the deck up, crosses the hub and the freight
// corridor, enters gate 8 by pass, puts every lot into its stall's locker in store 17, swaps the trailers under crane 9a
// and rides back down. Every lot reaches its stall by opening; no unit appears or vanishes; a save in the corridor,
// on the deck, with a trailer on the hook and with the crew on its seats continues the same way.
func cargoMorning(t *testing.T,rate int64){cargoMorningWith(t,rate,false)}
// With the brain the people eat and buy (no strict conservation): no unit appears, and what is gone is no more than the
// people's recorded purchases. The keepers walk at their real pace, so the stalls open on time.
func cargoMorningWith(t *testing.T,rate int64,brain bool){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 if r.world.CargoConvoys==nil||len(r.world.CargoConvoys.Convoys)==0{t.Skip("no cargo convoys")}
 // strict conservation: the brain's consumers off (people keep their routines); the hall's visitors buy and are counted
 cellHero(r);if !brain{r.world.Life.Brain.Enabled=false;r.canonicalWorld.Life.Brain.Enabled=false}else if !r.world.Life.Brain.Enabled{t.Skip("content has no enabled brain")}
 r.state.Active=true;r.state.Speed=1;r.initLife()
 v:=r.world.CargoConvoys.Convoys[0];run:=v.Runs[0]
 crew:=map[string]bool{};for _,m:=range v.Crew{crew[m.ID]=true}
 totals:=cargoTotals(r);purchases:=r.state.NPCEconomy.Purchases
 morning:=(r.state.Life.Seconds/86400+1)*86400
 r.state.Life.SecondsPerTick=30;for r.state.Life.Seconds<morning+run.StartSecond-20*60{r.step()}
 if f:=r.state.Life.PopulationFailure;f!=""{t.Fatal(f)}
 for _,m:=range v.Crew{a:=r.state.Life.Actor(m.ID);if a.Level!=v.Home.LevelID||!a.OnFloor()||a.Mount!=nil{t.Fatalf("%s is not free at home before the run: %s %v",m.ID,a.Level,a.Position)}}
