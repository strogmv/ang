func TestScene19SpeechEntryToCatcherUsesWorkingPlatform(t *testing.T) {
	file := &heroFileChoice{Profile: "negotiator", Strengths: []string{"observation", "melee"}, Episodes: []string{"receiving", "schedules"}, Portrait: "portrait_1"}
	r := hub19Start(t, file, 1)
	hub19At(t, r, 61, 37)
	hub19At(t, r, 111, 37)
	hub19At(t, r, 111, 27)
	for range 1600 {
		if r.state.LiftingDecks["deck.hub.copper"].Phase == "loading" {
			hub19Open(t, r, hub19Savely, "dlg.hub.savely")
			startLines(t, r, "voice.platform.savely_tell")
			if _, known := r.state.Memory.Topics["topic.catcher_limit"]; known {
				t.Fatal("the Speech voice gave the answer before the hero asked")
			}
			startPick(t, r, "corner")
			startLines(t, r, "dlg.platform.v_corner")
			if _, known := r.state.Memory.Topics["topic.catcher_limit"]; !known {
				t.Fatal("asking Savely did not give the catcher topic")
