// vendingCommand takes the hero's inventory commands that concern a terminal: "buy" of a showcase item (checks of the
// unit, the access profile and the funds, then the ordinary purchase), "sell" (buy-back) and "charge" (the dock hook).
// It returns false for every other command.
func (r *Runtime) vendingCommand(c *connection, q *pb.PocInventoryCommand, tag string, result *pb.PocInventoryResult) bool {
	v := r.world.Vending
	if len(v.Units) == 0 {
		return false
	}
	locale := ""
	if c != nil {
		locale = c.locale
	}
	unit := -1
	switch q.Action {
	case "buy":
		item, ok := r.state.Inventory.Items[q.ItemId]
		if !ok || item.Location.Kind != "store" {
			return false
		}
		if unit, ok = r.vendingDisplayUnit(item.Location.Store); !ok {
			return false
		}
	case "sell", "charge":
		var ok bool
		if unit, ok = r.vendingDisplayUnit(q.StoreId); !ok {
			result.Message = r.localText(locale, "ui.torgomat.refused.away", "ui.torgomat.refused.away")
			return true
		}
	default:
		return false
	}
	u := v.Units[unit]
	refuse := func(key, item string) bool {
		r.vendingHeroResult(unit, key, item, 0, true)
		result.Ok = false
		result.Message = r.vendingText(locale, key, item, 0)
		return true
	}
	if r.vendingHeroUnit() != unit {
		return refuse("ui.torgomat.refused.away", "")
	}
	if r.vendingInService(unit) {
		return refuse("ui.torgomat.refused.service", "")
	}
	model := r.inventoryModelFor(true)
	switch q.Action {
	case "buy":
		item := r.state.Inventory.Items[q.ItemId]
		var offer *vendingOffer
		for k := range u.Sells {
			if u.Sells[k].Item == item.Definition {
				offer = &u.Sells[k]
			}
		}
		if offer == nil {
			return refuse("ui.torgomat.refused.stock", item.Definition)
		}
		if len(offer.RequiresProfile) > 0 && !includesString(offer.RequiresProfile, r.actorProfileID(playerActorID)) {
			return refuse("ui.torgomat.refused.profile", item.Definition)
		}
		price, err := inv.Quote(model.Definitions[item.Definition], 1)
		if err != nil || r.vendingHeroBalance(model.Definitions[item.Definition].PriceUnit) < price {
			return refuse("ui.torgomat.refused.funds", item.Definition)
		}
		action := inv.Action{Actor: playerActorID, Kind: "buy", Item: q.ItemId, Store: q.StoreId, Quantity: 1, ExpectedRevision: q.ExpectedRevision, Sequence: q.Sequence, RequestTag: tag}
		if _, err := r.executeActorAction(action); err != nil {
			return refuse("ui.torgomat.refused.stock", item.Definition)
		}
		r.vendingServed(unit, false)
		r.vendingHeroResult(unit, "ui.torgomat.result.bought", item.Definition, price, false)
		result.Ok = true
		result.Message = r.vendingText(locale, "ui.torgomat.result.bought", item.Definition, price)
		return true
	case "charge":
		// Hook: the dock reads the binding of the gear and the chip of the person. No item carries a binding yet, so
		// every request is the honest refusal «no gear bound to your chip» (no money, no state change except the band).
		if !includesString(u.Services, "charge") {
			return refuse("ui.torgomat.refused.not_accepted", "")
		}
		return refuse("ui.torgomat.charge.none", "")
	}
	// sell: one unit of a carried item the unit accepts, at the system price, within the daily limit of the account
	item, ok := r.state.Inventory.Items[q.ItemId]
	if !ok || item.Revision != q.ExpectedRevision || !r.carried(item) || item.Quantity < 1 {
		return refuse("ui.torgomat.refused.not_accepted", "")
	}
	price, accepted := r.vendingBuyPrice(u, item.Definition)
	if !accepted {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	if r.vendingBuybackUsed(playerActorID)+price > v.BuybackDailyLimitMinor {
		return refuse("ui.torgomat.refused.limit", item.Definition)
	}
	if r.state.Paused {
		return refuse("ui.torgomat.refused.service", "")
	}
	hero, system, err := r.state.Inventory.TradeAccounts(model, playerActorID, v.Owner, v.Level, r.vendingAccountCurrency())
	if err != nil || system.ID != v.Account || system.Balance < price {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	tx := inv.Transaction{Actor: playerActorID, Sequence: q.Sequence, RequestTag: tag,
		Moves:    []inv.Move{{Item: item.ID, Quantity: 1, ExpectedRevision: item.Revision, To: inv.Location{Kind: "store", Store: u.IntakeStore}, ChangeOwner: true, Owner: v.Owner}},
		Payments: []inv.Payment{{From: system.ID, To: hero.ID, Currency: system.Currency, Amount: price, FromRevision: system.Revision, ToRevision: hero.Revision}}}
	if _, err := r.vendingApplyUnlocked(model, tx, u.IntakeStore); err != nil {
		return refuse("ui.torgomat.refused.not_accepted", item.Definition)
	}
	if r.state.Vending.Buyback == nil {
		r.state.Vending.Buyback = map[string]vendingBuyback{}
	}
	day := r.vendingDayKey()
	b := r.state.Vending.Buyback[playerActorID]
	if b.Day != day {
		b = vendingBuyback{Day: day}
	}
	b.Minor += price
	r.state.Vending.Buyback[playerActorID] = b
	r.vendingServed(unit, true)
	r.vendingHeroResult(unit, "ui.torgomat.result.sold", item.Definition, price, false)
	r.focusActor(playerActorID, item.ID)
	result.Ok = true
	result.Message = r.vendingText(locale, "ui.torgomat.result.sold", item.Definition, price)
	return true
}

// The system's own locked stores (cassette, intake) open only inside its own transaction and lock again (as the owner's
// stock lock of a shop: inventory commerceApply).
func (r *Runtime) vendingApplyUnlocked(model inv.Model, tx inv.Transaction, stores ...string) (inv.Result, error) {
	locked := []string{}
	for _, id := range stores {
		if st, ok := r.state.Inventory.Stores[id]; ok && st.Locked {
			st.Locked = false
			r.state.Inventory.Stores[id] = st
			locked = append(locked, id)
		}
	}
	result, err := r.state.Inventory.Apply(model, tx)
	for _, id := range locked {
		st := r.state.Inventory.Stores[id]
		st.Locked = true
		r.state.Inventory.Stores[id] = st
	}
	return result, err
}
func (r *Runtime) vendingText(locale, key, definition string, minor int64) string {
	text := r.localText(locale, key, key)
	if definition != "" {
		d := r.world.Inventory.Definitions[definition]
		text = strings.ReplaceAll(text, "{item}", r.localText(locale, d.Name, d.Name))
	}
	return strings.ReplaceAll(text, "{crd}", inv.FormatMoney(minor, r.world.Inventory.Currencies[r.vendingAccountCurrency()].Scale))
}

// advanceVending: the night refill (unit i serves from from_second + i*seconds_per_unit, once per game day; if the
// window was skipped by a long frame it runs at the first frame after its start that day) and the hero's result line
// fading when he leaves the panel.
func (r *Runtime) advanceVending() error {
	v := r.world.Vending
	if len(v.Units) == 0 || !r.state.Life.Enabled {
		return nil
	}
	day := r.vendingDayKey()
	sec := r.state.Life.Seconds % 86400
	hero := r.vendingHeroUnit()
	for i, u := range v.Units {
		s := r.vendingUnitState(u.ID)
		changed := false
		if hero != i && s.HeroKey != "" {
			s.HeroKey, s.HeroItem, s.HeroMinor = "", "", 0
			changed = true
		}
		if s.RefillDay != day && sec >= v.Refill.FromSecond+int64(i)*v.Refill.SecondsPerUnit {
			moved, err := r.vendingRefill(u)
			if err != nil {
				return err
			}
			s.RefillDay = day
			if moved > 0 {
				s.Refills++
			}
			changed = true
		}
		if changed {
			r.setVendingUnitState(u.ID, s)
		}
	}
	return nil
}

// vendingRefill moves goods of the system from the cassette to the showcase up to the par level (nothing is created).
func (r *Runtime) vendingRefill(u vendingUnit) (int64, error) {
	v := r.world.Vending
	model := r.inventoryModelFor(true)
	var moves []inv.Move
	var moved int64
	ids := make([]string, 0)
	for id, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == u.CassetteStore && i.Owner == v.Owner {
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	for _, o := range u.Sells {
		need := o.Par - r.vendingStock(u.DisplayStore, o.Item)
		for _, id := range ids {
			if need <= 0 || len(moves) >= 64 {
				break
			}
			i := r.state.Inventory.Items[id]
			if i.Definition != o.Item {
				continue
			}
			q := i.Quantity
			if q > need {
				q = need
			}
			moves = append(moves, inv.Move{Item: id, Quantity: q, ExpectedRevision: i.Revision, To: inv.Location{Kind: "store", Store: u.DisplayStore}})
			need -= q
			moved += q
		}
	}
	if len(moves) == 0 {
		return 0, nil
	}
	tx := inv.Transaction{Actor: v.Owner, Sequence: r.state.Inventory.Cursors[v.Owner].Sequence + 1, RequestTag: "vending/refill/" + u.ID, Moves: moves}
	if _, err := r.vendingApplyUnlocked(model, tx, u.CassetteStore); err != nil {
		return 0, err
	}
	// The cassette stock is the system's goods for sale already (locked and out of every reach until it is moved).
	return moved, nil
}
func (r *Runtime) vendingStock(store, definition string) int64 {
	var n int64
	for _, i := range r.state.Inventory.Items {
		if i.Location.Kind == "store" && i.Location.Store == store && i.Definition == definition && !i.Hidden {
			n += i.Quantity
		}
	}
	return n
}

// appendVending: the public signals of every unit while the hero is on the hub floor; occupancy and the queue only for
// lanes the hero sees; the offers and the buy-back list only for the unit whose panel the hero stands at.
func (r *Runtime) appendVending(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView, locale string) {
	v := r.world.Vending
	if len(v.Units) == 0 || hero == nil || !hero.OnFloor() || hero.Level != v.Level {
		return
	}
	laneOf := map[inv.Cell]int{}
	approachOf := map[inv.Cell]int{}
	for i, u := range v.Units {
		for _, c := range u.Lane {
			laneOf[c] = i
		}
		for _, c := range u.Approach {
			approachOf[c] = i
		}
	}
	queue := make([]int32, len(v.Units))
	occupied := make([]bool, len(v.Units))
	count := func(level string, at behavior.Cell, ok bool) {
		if !ok || level != v.Level {
			return
		}
		c := inv.Cell{X: at.X, Y: at.Y}
		if i, in := laneOf[c]; in {
			queue[i]++
		}
		if i, in := approachOf[c]; in {
			occupied[i] = true
		}
	}
	for _, a := range r.state.Life.Actors {
		count(a.Level, a.Position, a.OnFloor())
	}
	for _, a := range r.state.Life.Population.Actors {
		count(a.Level, a.Position, a.Trip == nil)
	}
	active := r.vendingHeroUnit()
	scale := r.world.Inventory.Currencies[r.vendingAccountCurrency()].Scale
	for i, u := range v.Units {
		seen := viewSees(perception, int32(u.Panel.X), int32(u.Panel.Y))
		occ := occupied[i] && seen
		unit := &pb.PocVendingUnit{Id: u.ID, N: int32(u.N), Kind: u.Kind, Status: r.vendingStatus(i), LampPpm: int32(r.vendingLamp(i, occ)), Dock: u.Dock, Active: i == active, StoreId: u.DisplayStore, Services: append([]string(nil), u.Services...)}
		if seen {
			unit.Occupied, unit.Queue = occ, queue[i]
		}
		for _, o := range u.Sells {
			if r.vendingStock(u.DisplayStore, o.Item) > 0 {
				unit.Stocked = true
				break
			}
		}
		if i == active {
			r.appendVendingPanel(unit, i, locale, scale)
		}
		view.Vending = append(view.Vending, unit)
	}
}
func (r *Runtime) appendVendingPanel(unit *pb.PocVendingUnit, i int, locale string, scale int64) {
	v := r.world.Vending
	u := v.Units[i]
	model := r.inventoryModelFor(true)
	service := r.vendingInService(i)
	profile := r.actorProfileID(playerActorID)
	for _, o := range u.Sells {
		d := model.Definitions[o.Item]
		offer := &pb.PocVendingOffer{Definition: o.Item, Name: r.localText(locale, d.Name, d.Name)}
		best := inv.Item{}
		for id, it := range r.state.Inventory.Items {
			if it.Location.Kind != "store" || it.Location.Store != u.DisplayStore || it.Definition != o.Item || it.Hidden || !it.ForSale || it.Quantity < 1 {
				continue
			}
			offer.Quantity += it.Quantity
			if best.ID == "" || id < best.ID {
				best = it
			}
		}
		price, err := inv.Quote(d, 1)
		if err == nil {
			offer.Price = inv.FormatMoney(price, model.Currencies[d.PriceUnit].Scale) + " " + d.PriceUnit
		}
		offer.ItemId, offer.Revision = best.ID, best.Revision
		reason := ""
		switch {
		case service:
			reason = "ui.torgomat.refused.service"
		case len(o.RequiresProfile) > 0 && !includesString(o.RequiresProfile, profile):
			reason = "ui.torgomat.no_profile"
		case best.ID == "":
			reason = "ui.torgomat.out_of_stock"
		case err != nil || r.vendingHeroBalance(d.PriceUnit) < price:
			reason = "ui.torgomat.no_money"
		}
		offer.Ok = reason == ""
		if reason != "" {
			offer.Reason = r.localText(locale, reason, reason)
		}
		unit.Offers = append(unit.Offers, offer)
	}
	left := v.BuybackDailyLimitMinor - r.vendingBuybackUsed(playerActorID)
	if left < 0 {
		left = 0
	}
	unit.BuybackLeft = inv.FormatMoney(left, scale)
	ids := make([]string, 0)
	for id, it := range r.state.Inventory.Items {
		if _, accepted := r.vendingBuyPrice(u, it.Definition); accepted && r.carried(it) {
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	for _, id := range ids {
		it := r.state.Inventory.Items[id]
		d := model.Definitions[it.Definition]
		price, _ := r.vendingBuyPrice(u, it.Definition)
		offer := &pb.PocVendingOffer{ItemId: id, Definition: it.Definition, Name: r.localText(locale, d.Name, d.Name), Quantity: it.Quantity, Revision: it.Revision, Price: inv.FormatMoney(price, scale) + " " + r.vendingAccountCurrency()}
		reason := ""
		if service {
			reason = "ui.torgomat.refused.service"
		} else if price > left {
			reason = "ui.torgomat.refused.limit"
		}
		offer.Ok = reason == ""
		if reason != "" {
			offer.Reason = r.localText(locale, reason, reason)
		}
		unit.Buyback = append(unit.Buyback, offer)
	}
	if s := r.vendingUnitState(u.ID); s.HeroKey != "" {
		unit.Message = r.vendingText(locale, s.HeroKey, s.HeroItem, s.HeroMinor)
	}
}

// validateVendingSave: a loaded state may only name the units of the world, and no account may have sold back more
// than the daily limit.
func (r *Runtime) validateVendingSave(s state) error {
	v := r.world.Vending
	known := map[string]bool{}
	for _, u := range v.Units {
		known[u.ID] = true
	}
	for id := range s.Vending.Units {
		if !known[id] {
			return errVendingSave
		}
	}
	for _, b := range s.Vending.Buyback {
		if b.Minor < 0 || b.Minor > v.BuybackDailyLimitMinor || b.Day < 0 {
			return errVendingSave
		}
	}
	return nil
}

var errVendingSave = errors.New("vending state names an unknown unit or exceeds the daily buy-back limit")
