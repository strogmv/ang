	for _, a := range r.state.Inventory.Accounts {
		n += a.Balance
	}
	return n
}
func peddlerBalance(r *Runtime, owner string) int64 { a, _ := r.peddlerAccount(owner); return a.Balance }
func peddlerFirstOnTray(r *Runtime, p peddlerDef, definition string) inv.Item {
	for _, id := range sortedCraftingItems(r.state.Inventory) {
		if i := r.state.Inventory.Items[id]; i.Location.Store == p.Tray && (definition == "" || i.Definition == definition) {
