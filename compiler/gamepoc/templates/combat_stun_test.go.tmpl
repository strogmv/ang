var combatM3Report = flag.String("combat-m3-report", "", "directory for the moment 3 seeded fixtures")

const stunMode = "stun_blow"

func stunFixture(t *testing.T, seed int64) (*Runtime, *connection, playableSceneDefinition) {
	t.Helper()
	r, c, d := combatEpisodeFixture(t, "combat_stun", "ru")
	for frame := 0; frame < 10; frame++ {
		r.step()
	}
	if seed != 0 {
		r.state.Seed = seed
	}
	return r, c, d
}

func stunStrike(t *testing.T, r *Runtime, c *connection, d playableSceneDefinition, mode string) behavior.Combatant {
	t.Helper()
	throatWalk(t, r, c, throatStandoff, mode)
	if r.heroInCombat() {
		t.Fatal("noticed on a quiet approach")
	}
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: d.Guard, Mode: stunMode}); err != nil {
		t.Fatal(err)
	}
	return *r.state.Combat.Actor(d.Guard)
}

func stunHas(c behavior.Combatant, structure string) bool {
	for _, w := range combatBody(c).Wounds {
		for _, s := range w.Structures {
			if s == structure {
				return true
			}
		}
	}
	return false
}

// One command from stealth: it always lands (he does not know), no parry, it is an ordinary wound by the same model, the hand is the same whoever holds it.
func TestStunBlowFromStealthIsOneCommand(t *testing.T) {
	for _, mode := range []string{"on", "upright"} {
		r, c, d := stunFixture(t, 3)
		v := stunStrike(t, r, c, d, mode)
		var attack *behavior.CombatEvent
		for i := range r.state.Combat.Events {
			e := &r.state.Combat.Events[i]
			if e.Type == "parry" || e.Type == "reaction" {
				t.Fatalf("%s: %s before he could know", mode, e.Type)
			}
			if e.Type == "attack" && e.ActorID == playerActorID {
				if attack != nil {
					t.Fatal("two blows in one command")
				}
				attack = e
			}
		}
		if attack == nil || !attack.Hit || attack.Mode != stunMode || attack.BodyPart != "head" {
			t.Fatalf("%s: the blow: %+v", mode, attack)
		}
		if len(combatBody(v).Wounds) != 1 || combatBody(v).Wounds[0].Zone != "head" {
			t.Fatalf("%s: the wound: %+v", mode, combatBody(v).Wounds)
		}
		if r.state.Combat.Actor(playerActorID).Crouched {
			t.Fatalf("%s: he struck from a crouch and stayed in it", mode)
		}
	}
}

// The numbers are the wound model's: 60 % out, no new roll, no safe knockout (doc 97).
func TestStunBlowNumbersAreTheModels(t *testing.T) {
	out, skull, dead := 0, 0, 0
	const n = 300
	for seed := int64(1); seed <= n; seed++ {
		r, c, d := stunFixture(t, seed)
		v := stunStrike(t, r, c, d, "on")
		if !combatWounds.Status(combatBody(v)).Conscious {
			out++
		}
		if stunHas(v, "skull") {
			skull++
		}
		if combatBody(v).Dead {
			dead++
		}
	}
	if share := float64(out) / n; share < .5 || share > .72 {
		t.Fatalf("out at once %.1f %%, the model says about 60", share*100)
	}
	if skull == 0 {
		t.Fatal("no skull in 300 blows: the model's deep blow is gone")
	}
	t.Logf("of %d: out %d, skull %d, dead within the command %d", n, out, skull, dead)
}

func TestStunBlowRefusals(t *testing.T) {
	r, c, d := stunFixture(t, 0)
	throatWalk(t, r, c, throatStandoff, "")
	if !r.heroInCombat() {
		if refusal, ok := r.takedownCheck(playerActorID, d.Guard, stunMode).(textError); !ok || refusal.Key == "" {
			t.Fatalf("a normal walk: %v", refusal)
		}
	}
	// a knife in hand: the throat is offered, the club is refused in words; a baton in hand: the other way round
	k, kc, kd := combatEpisodeFixture(t, "combat_throat", "ru")
	for frame := 0; frame < 10; frame++ {
		k.step()
	}
	throatWalk(t, k, kc, throatStandoff, "on")
	if refusal, ok := k.takedownCheck(playerActorID, kd.Guard, stunMode).(textError); !ok || refusal.Key != "error.takedown.weapon.blunt" {
		t.Fatalf("a knife in hand: %v", refusal)
	}
	msg := &pb.PocGameState{}
	k.appendTakedownOptions(msg, "ru")
	for _, o := range msg.Takedowns {
		if o.Mode == stunMode {
			t.Fatal("a knife in hand is offered the club's blow")
		}
	}
}

// An NPC does the same by an authored intention: the rule does not know the word «hero».
func TestStunBlowByAnNPCFromAnAuthoredIntention(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_stun", "ru")
	r.world.CombatLife.Aggressors = map[string][]string{}
	r.world.CombatLife.Takedowns = map[string]combatTakedownIntent{d.Guard: {Target: playerActorID, Technique: stunMode}}
	g := r.state.Life.Actor(d.Guard)
	h := r.state.Life.Actor(playerActorID)
	h.Position = behavior.Cell{X: g.Position.X + 6, Y: g.Position.Y - 6}
	h.Body = nil
	r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
	throatWalk(t, r, c, behavior.Cell{X: g.Position.X + 2, Y: g.Position.Y - 2}, "")
	r.state.Stealth.HeroFaceX, r.state.Stealth.HeroFaceY = .7071, -.7071
	r.state.Life.Actor(d.Guard).Position = behavior.Cell{X: r.state.Life.Actor(playerActorID).Position.X - 2, Y: r.state.Life.Actor(playerActorID).Position.Y + 2}
	if err := r.takedownCheck(d.Guard, playerActorID, stunMode); err != nil {
		t.Fatalf("the NPC's check: %v", err)
	}
	if err := r.combatLifeAfterFrame(); err != nil {
		t.Fatal(err)
	}
	body := combatBody(*r.state.Combat.Actor(playerActorID))
	if len(body.Wounds) == 0 || body.Wounds[0].Author != d.Guard || body.Wounds[0].Zone != "head" {
		t.Fatalf("the wound's author: %+v", body.Wounds)
	}
}

// A knockout ends on the server's clock; he gets up by himself, walks nowhere meanwhile, then he is an ordinary person again. A man who is out says nothing.
func TestKnockedOutRisesOnTheServersClock(t *testing.T) {
	for seed := int64(1); seed <= 40; seed++ {
		r, c, d := stunFixture(t, seed)
		v := stunStrike(t, r, c, d, "on")
		if combatWounds.Status(combatBody(v)).Conscious || combatBody(v).Dead || stunHas(v, "brain_bleed") {
			continue
		}
		until := combatBody(v).KnockoutUntil
		at := v.Position
		rose := int64(-1)
		rise := int64(r.world.CombatLife.RiseSeconds)
		body := func() (int64, string) {
			b := r.state.CombatRoster[d.Guard]
			return combatBody(b).Clock, r.state.Life.Actor(d.Guard).Activity
		}
		said := func() bool {
			if out := r.BarkEvent(d.Guard, "wounded", "wounded", ""); out.Said != nil {
				return true
			}
			return false
		}
		if said() {
			t.Fatal("a man who is out said a line")
		}
		for frame := 0; frame < 600; frame++ {
			r.step()
			clock, activity := body()
			if clock < until && activity != "down" {
				t.Fatalf("seed %d: not out before the clock: %s at %d of %d", seed, activity, clock, until)
			}
			if clock >= until && rose < 0 && activity == "rising" {
				rose = r.state.Life.Seconds
				if said() {
					t.Fatal("a man getting up said a line")
				}
			}
			if rose >= 0 && r.state.Life.Seconds < rose+rise {
				if activity != "rising" || r.state.Life.Actor(d.Guard).Position != at {
					t.Fatalf("seed %d: while getting up: %s at %+v", seed, activity, r.state.Life.Actor(d.Guard).Position)
				}
			}
			if rose >= 0 && r.state.Life.Seconds >= rose+rise+2 {
				if activity == "rising" || activity == "down" || r.state.CombatRoster[d.Guard].Prone {
					t.Fatalf("seed %d: still down after getting up: %s", seed, activity)
				}
				return
			}
		}
		t.Fatalf("seed %d: he never got up, knockout until %d", seed, until)
	}
	t.Fatal("no plain knockout in 40 seeds")
}

// Opt-in: one real save per outcome of the stand, the seed found by running the real commands headless.
func TestCombatMoment3Probes(t *testing.T) {
	if *combatM3Report == "" {
		t.Skip("opt-in moment 3 fixtures")
	}
	root := filepath.Join(*combatM3Report, "probes")
	if err := os.MkdirAll(root, 0755); err != nil {
		t.Fatal(err)
	}
	type want struct {
		Name, Mode string
		Pick       func(v behavior.Combatant, c behavior.Combatant) bool
	}
	plain := func(v behavior.Combatant) bool { return !stunHas(v, "skull") && !stunHas(v, "brain_bleed") }
	out := func(v behavior.Combatant) bool { return !combatWounds.Status(combatBody(v)).Conscious && !combatBody(v).Dead }
	stood := func(v behavior.Combatant) bool { st := combatWounds.Status(combatBody(v)); return st.Conscious && st.Standing && !v.Surrendered && v.FightResponse != "flee" }
	short := func(v behavior.Combatant) bool { b := combatBody(v); return b.KnockoutUntil-b.Clock >= 20 && b.KnockoutUntil-b.Clock <= 36 }
	rear := []struct {
		Name, Mode string
		Pick       func(behavior.Combatant) bool
	}{
		{"3a_ko", "on", func(v behavior.Combatant) bool { return out(v) && plain(v) && !stunHas(v, "scalp") && !short(v) }},
		{"3a_ko_up", "upright", func(v behavior.Combatant) bool { return out(v) && plain(v) && !short(v) }},
		{"3a_stood", "on", func(v behavior.Combatant) bool { return stood(v) && plain(v) && !stunHas(v, "scalp") }},
		{"3a_blood", "on", func(v behavior.Combatant) bool { return stood(v) && plain(v) && stunHas(v, "scalp") }},
		{"3a_skull", "on", func(v behavior.Combatant) bool { return out(v) && stunHas(v, "skull") && stunHas(v, "scalp") && !stunHas(v, "brain_bleed") }},
		{"3a_wake", "on", func(v behavior.Combatant) bool { return out(v) && plain(v) && short(v) }},
	}
	index := []map[string]any{}
	save := func(name string, r *Runtime, base state, row map[string]any, events []behavior.CombatEvent, dir string) {
		o := filepath.Join(dir, name)
		if err := os.MkdirAll(o, 0755); err != nil {
			t.Fatal(err)
		}
		r.data = o
		if err := r.writeSave("slot3", base); err != nil {
			t.Fatal(err)
		}
		if _, _, err := r.readSave("slot3"); err != nil {
			t.Fatal(name, "strict load", err)
		}
		meta, _ := json.MarshalIndent(map[string]any{"row": row, "events": events}, "", "  ")
		if err := os.WriteFile(filepath.Join(o, "setup.json"), meta, 0644); err != nil {
			t.Fatal(err)
		}
	}
	for _, q := range rear {
		found := false
		for seed := int64(1); seed <= 900 && !found; seed++ {
			r, c, d := stunFixture(t, seed)
			base := r.snapshotState()
			v := stunStrike(t, r, c, d, q.Mode)
			if !q.Pick(v) {
				continue
			}
			events := append([]behavior.CombatEvent(nil), r.state.Combat.Events...)
			b := combatBody(v)
			r.state = base
			row := map[string]any{"name": q.Name, "seed": seed, "episode": d.ID, "mode": q.Mode, "standoff": throatStandoff, "knockout_s": b.KnockoutUntil - b.Clock, "response": v.FightResponse, "structures": b.Wounds[0].Structures, "depth": b.Wounds[0].Depth, "fall": v.FallStyle}
			save(q.Name, r, base, row, events, root)
			index = append(index, row)
			found = true
		}
		if !found {
			t.Errorf("no seed for %s", q.Name)
		}
	}
	raw, _ := json.MarshalIndent(index, "", "  ")
	if err := os.WriteFile(filepath.Join(root, "index.json"), raw, 0644); err != nil {
		t.Fatal(err)
	}
	// In a fight: an ordinary blow to the head, the same wound rules.
	fightDir := filepath.Join(*combatM3Report, "probes-m1")
	if err := os.MkdirAll(fightDir, 0755); err != nil {
		t.Fatal(err)
	}
	front := []struct {
		Name string
		Pick func(behavior.Combatant) bool
	}{
		{"3b_ko", func(v behavior.Combatant) bool { return out(v) && plain(v) && !short(v) }},
		{"3b_stood", func(v behavior.Combatant) bool { return stood(v) && plain(v) && !stunHas(v, "scalp") }},
		{"3b_skull", func(v behavior.Combatant) bool { return stood(v) && stunHas(v, "skull") && stunHas(v, "scalp") && !stunHas(v, "brain_bleed") }},
		{"3b_wake", func(v behavior.Combatant) bool { return out(v) && plain(v) && short(v) }},
	}
	fights := []map[string]any{}
	r0, cc, scene := combatEpisodeFixture(t, "combat_stun", "ru")
	spec := r0.world.CombatRuntime.Probes["baton"]
	combatEpisodeEngage(t, r0, cc, scene)
	actors := []behavior.Combatant{r0.combatant(playerActorID, "player"), r0.combatant(scene.Guard, "opposition")}
	actors[0].Position, actors[1].Position = spec.Hero, spec.Enemy
	for i := range actors {
		b := combatWounds.NewBody(actors[i].ID, r0.bodyChip(actors[i].ID))
		projectWoundBody(&actors[i], b)
		actors[i].FightResponse, actors[i].Surrendered, actors[i].Withdrawn, actors[i].Prone, actors[i].Crouched = "", false, false, false, false
		actors[i].Suppression = 0
	}
	proposed := behavior.CombatState{LevelID: scene.Level, Actors: actors}
	s, err := behavior.NewCombat("encounter.m3.probe", scene.Level, 1, actors, r0.world.CombatRuntime.Rules, r0.combatSpace(proposed))
	if err != nil {
		t.Fatal(err)
	}
	r0.state.Combat = s
	r0.state.CombatPublicEvents, r0.state.CombatPublicSeq, r0.state.CombatPublicSerial = nil, 0, 0
	r0.state.CombatLifeSync = combatLifeSync{}
	r0.combatLifeStarted(scene.Guard, playerActorID)
	r0.syncCombatLife()
	initial := r0.snapshotState()
	for _, q := range front {
		found := false
		for seed := int64(1); seed <= 3000 && !found; seed++ {
			r0.state = initial
			r0.state = r0.snapshotState()
			r0.state.Seed, r0.state.Combat.Seed = seed, seed
			base := r0.snapshotState()
			action := behavior.CombatAction{Type: "attack", TargetID: scene.Guard, Mode: "heavy", BodyPart: "head"}
			if err := r0.performCombatAction(playerActorID, &action); err != nil {
				t.Fatal(q.Name, err)
			}
			hit := false
			events := append([]behavior.CombatEvent(nil), r0.state.Combat.Events...)
			for _, e := range events {
				if e.Type == "attack" && e.ActorID == playerActorID && e.Hit {
					hit = true
				}
			}
			v := *r0.state.Combat.Actor(scene.Guard)
			if !hit || len(combatBody(v).Wounds) != 1 || combatBody(v).Wounds[0].Zone != "head" || !q.Pick(v) {
				continue
			}
			b := combatBody(v)
			r0.state = base
			row := map[string]any{"name": q.Name, "seed": seed, "episode": spec.Episode, "command": "attack:heavy:head", "outcome": "hit", "zone": "head", "knockout_s": b.KnockoutUntil - b.Clock, "response": v.FightResponse, "structures": b.Wounds[0].Structures, "depth": b.Wounds[0].Depth, "fall": v.FallStyle}
			save(q.Name, r0, base, row, events, fightDir)
			fights = append(fights, row)
			found = true
		}
		if !found {
			t.Errorf("no seed for %s", q.Name)
		}
	}
	raw, _ = json.MarshalIndent(fights, "", "  ")
	if err := os.WriteFile(filepath.Join(fightDir, "index.json"), raw, 0644); err != nil {
		t.Fatal(err)
	}
}
