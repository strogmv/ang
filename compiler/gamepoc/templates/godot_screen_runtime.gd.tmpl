# Generated by ANG. Shared screen renderer; game rules belong to the server.
extends Control
const C = preload("res://generated/game_contract.gd")
const Catalog = preload("res://generated/screens/catalog.gd")
signal command_sent(id: String, command: C.ClientMessage)
signal dismissed(id: String)
var host
var state: C.PocGameState
var spec: Dictionary
var screen_id := ""
var selected := {}
var toggles := {}
var hud_root: Control
var rail: Array[Control] = []
var focus_ids: Array[String] = []
var content: Control
var status: Label
var last_signature: Variant = null
var refresh_pending := false
var last_focus_uid := ""
## Where the focus stood on each screen another screen replaced (screen id -> focus uid): a way back (present with
## resume) gives the focus back to that control, not to the screen's first one.
var focus_memory := {}
var resume_focus := ""
var pending_focus_visibility := false
var open_us := 0
var latency := {}
var opening_latency := {}
var hold := Vector2.ZERO
var held_time := 0.0
var repeat_at := 0.35
var busy := false
var last_refusal := ""
var scroll_axis := 0.0
var scroll_targets: Array[ScrollContainer] = []
var page_scroll: ScrollContainer
var backdrop: Control
var chrome = preload("res://generated/screens/chrome.gd").new(self)
var elements = preload("res://generated/screens/elements.gd").new(self)
var navigation = preload("res://generated/screens/navigation.gd").new(self)
## The HUD (a persistent screen, routes.hud): shown on its own under the other screens while the game is played. The world
## keeps its input: only buttons take the mouse, a button clicked gives its focus back, nothing grabs the focus on a build.
var persistent := false
## Live custom widgets of this build (control live): {widget, node, row}; they get update_screen(values) on every state.
var live_widgets: Array = []

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE if persistent else Control.MOUSE_FILTER_STOP
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	resized.connect(_layout)
	get_viewport().gui_focus_changed.connect(_focus_changed)
	RenderingServer.frame_pre_draw.connect(_before_draw)
	hide()

func _focus_changed(control: Control) -> void:
	if is_instance_valid(content) and content.is_ancestor_of(control):
		pending_focus_visibility = true

func _before_draw() -> void:
	if not visible or not pending_focus_visibility:
		return
	var focus := get_viewport().gui_get_focus_owner()
	if not is_instance_valid(focus) or not is_instance_valid(content) or not content.is_ancestor_of(focus):
		pending_focus_visibility = false
		return
	# Container sorts have settled by pre-draw. Follow a new focus once;
	# subsequent manual scrolling must remain where the player put it.
	var parent: Node = focus.get_parent()
	while parent != null:
		if parent is ScrollContainer:
			parent.ensure_control_visible(focus)
		parent = parent.get_parent()
	pending_focus_visibility = false

func value(binding: Dictionary, row: C.ProtoMessage = null) -> Variant:
	if binding.has("ref"):
		return Catalog.read(binding.ref, state, row, selected)
	return binding.get("value")

func present(id: String, snapshot: C.PocGameState, context = null, requested_us := 0, resume := false) -> void:
	host = context
	state = snapshot
	if host != null and "settings" in host:
		selected["__settings"] = host.settings
	if host != null and "save_view" in host:
		selected["__saves"] = host.save_view
	if screen_id != id:
		last_refusal = ""
		var leaving := get_viewport().gui_get_focus_owner()
		if not screen_id.is_empty() and is_instance_valid(leaving) and is_ancestor_of(leaving):
			focus_memory[screen_id] = str(leaving.get_meta("focus_uid", ""))
	resume_focus = str(focus_memory.get(id, "")) if resume else ""
	screen_id = id
	spec = {}
	for entry in Catalog.specification().screens:
		if entry.id == id:
			spec = entry
			break
	assert(not spec.is_empty(), "unregistered screen "+id)
	open_us = requested_us if requested_us>0 else Time.get_ticks_usec()
	opening_latency = {}
	last_signature = ""
	scroll_axis = 0
	hold = Vector2.ZERO
	held_time = 0
	show()
	_refresh()

func accept(snapshot: C.PocGameState) -> void:
	state = snapshot
	busy = false
	if visible and spec.has("opening"):
		var trigger = value(spec.opening)
		if trigger == null or (trigger is bool and not trigger):
			_dismiss()
			return
	if visible:
		refresh_pending = true

func _snapshot(v: Variant) -> Variant:
	if v is Dictionary:
		return v.duplicate(true)
	if v is Array:
		return v.map(_snapshot)
	return v

func _signature(nodes: Array, row: C.ProtoMessage = null) -> Array:
	var result: Array = [TranslationServer.get_locale(), _large()]
	for n in nodes:
		# a live widget's values update it in place (update_screen), they never rebuild the screen
		if n.get("live", false):
			continue
		for b in n.get("bind", {}).values():
			result.append(_snapshot(value(b, row)))
		if n.kind == "list":
			var rows: Array = elements.rows_for(n, row)
			if rows is Array:
				for item in rows:
					result.append(_signature(n.get("children", []), item))
		else:
			result.append(_signature(n.get("children", []), row))
	return result

func _large() -> bool:
	return host != null and host.large_text
func _motion() -> bool:
	return host != null and host.reduced_motion

func _refresh() -> void:
	refresh_pending = false
	var build_started := Time.get_ticks_usec()
	_resolve_lists(spec.controls)
	var signature := _signature(spec.controls)
	if C.ProtoMessage.same_value(signature, last_signature):
		_update_live()
		return
	last_signature = signature
	var focused := ""
	var keep_focus_visible := true
	var owner := get_viewport().gui_get_focus_owner()
	if is_instance_valid(owner) and is_ancestor_of(owner):
		focused = str(owner.get_meta("focus_uid", ""))
		var bounds: Rect2 = preload("res://generated/screens/checks.gd")._visible_rect(owner)
		keep_focus_visible = bounds.encloses(owner.get_global_rect()) or focused != last_focus_uid
	var scrolls := {}
	if is_instance_valid(content):
		for node in content.find_children("*", "ScrollContainer", true, false):
			if node.has_meta("scroll_id"):
				scrolls[node.get_meta("scroll_id")] = Vector2i(node.scroll_horizontal, node.scroll_vertical)
		remove_child(content)
		content.queue_free()
	scroll_targets.clear()
	live_widgets.clear()
	rail.clear()
	focus_ids.clear()
	var skin: String = spec.skin
	if spec.has("skin_rule"):
		var candidate = value(spec.skin_rule)
		if candidate is String and Catalog.specification().themes.has(candidate):
			skin = candidate
	theme = Catalog.theme(skin)
	if is_instance_valid(backdrop):
		remove_child(backdrop)
		backdrop.queue_free()
		backdrop = null
	if not spec.get("backdrop", "").is_empty():
		backdrop = Catalog.widget(spec.backdrop)
		add_child(backdrop)
		backdrop.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var column: VBoxContainer = chrome.build()
	for node in spec.controls:
		if node.get("dock", "body") == "top":
			_node(node, column, null)
	var scroll := ScrollContainer.new()
	page_scroll = scroll
	scroll.set_meta("scroll_id", screen_id+"/page")
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.follow_focus = true
	column.add_child(scroll)
	var body: Control = Control.new() if spec.layout == "hud" else VBoxContainer.new()
	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	body.add_theme_constant_override("separation", 14)
	if spec.layout == "hud":
		body.custom_minimum_size = size
		hud_root = body
	scroll.add_child(body)
	for node in spec.controls:
		if node.get("dock", "body") == "body":
			_node(node, body, null)
	for node in spec.controls:
		if node.get("dock", "body") == "bottom":
			_node(node, column, null)
	status = null
	if not spec.get("status_id", "").is_empty():
		for node in content.find_children("*", "Label", true, false):
			if node.get_meta("control_id", "") == spec.status_id:
				status = node
				if not last_refusal.is_empty():
					status.text = last_refusal
				break
	else:
		status = _label(column, last_refusal, 18)
		status.visible = not last_refusal.is_empty()
	_order_focus()
	if persistent:
		_leave_the_world_its_input()
	_layout()
	# a way back: the control that had the focus when this screen was left, once
	var wanted := focused
	var resumed := not resume_focus.is_empty()
	if resumed:
		wanted = resume_focus
		resume_focus = ""
	var fallback_focus := false
	# the HUD takes the focus back only when it had it (the gamepad walked onto it): never on its own builds
	if not rail.is_empty() and (not persistent or not focused.is_empty()):
		var index := -1
		for i in range(rail.size()):
			if rail[i].get_meta("focus_uid", "") == wanted:
				index = i
				break
		fallback_focus = index < 0 or resumed
		if index < 0 and not spec.get("initial_focus", "").is_empty():
			for i in range(rail.size()):
				if focus_ids[i] != spec.initial_focus:
					continue
				if index < 0:
					index = i
				if rail[i].get_meta("selected", false):
					index = i
					break
		if index<0:
			for i in range(rail.size()):
				if rail[i].get_meta("selected", false):
					index = i
					break
		rail[maxi(0, index)].grab_focus()
	if not fallback_focus and not keep_focus_visible:
		pending_focus_visibility = false
	latency = {"screen":screen_id, "build_us":Time.get_ticks_usec()-build_started, "controls":rail.size()}
	var expected_focus := ""
	if not rail.is_empty():
		var focus: Control = get_viewport().gui_get_focus_owner()
		if focus != null:
			expected_focus = str(focus.get_meta("focus_uid", ""))
	call_deferred("_restore_scrolls", content, scrolls, fallback_focus or keep_focus_visible, expected_focus)
	call_deferred("_painted", open_us, build_started, latency)

func _restore_scrolls(view: Control, positions: Dictionary, focus_reset := false, expected_focus := "") -> void:
	await get_tree().process_frame
	if not is_instance_valid(view) or view != content:
		return
	var focus: Control = get_viewport().gui_get_focus_owner()
	var current_uid: String = str(focus.get_meta("focus_uid", "")) if focus != null else ""
	var changed: bool = not expected_focus.is_empty() and expected_focus != current_uid
	for node in view.find_children("*", "ScrollContainer", true, false):
		var id: String = node.get_meta("scroll_id", "")
		if positions.has(id):
			if (focus_reset or changed) and focus != null and node.is_ancestor_of(focus):
				continue
			node.scroll_horizontal = positions[id].x
			node.scroll_vertical = positions[id].y
	if focus_reset or changed:
		if focus != null and view.is_ancestor_of(focus):
			var parent: Node = focus.get_parent()
			while parent != null:
				if parent is ScrollContainer:
					parent.ensure_control_visible(focus)
				parent = parent.get_parent()
	last_focus_uid = current_uid

func _painted(opening: int, refreshed: int, measurement: Dictionary) -> void:
	await RenderingServer.frame_post_draw
	measurement["response_to_draw_us"] = Time.get_ticks_usec()-refreshed
	if opening == open_us and opening_latency.is_empty():
		opening_latency = measurement.duplicate()
		opening_latency["response_to_draw_us"] = Time.get_ticks_usec()-opening

## The values of every live widget of this build, read again from the current state; each widget redraws itself.
func _update_live() -> void:
	for entry in live_widgets:
		if not is_instance_valid(entry.widget):
			continue
		var values := {}
		var bindings: Dictionary = entry.node.get("bind", {})
		for key in bindings:
			values[key] = value(bindings[key], entry.row)
		values["selected"] = selected.get(entry.node.id)
		entry.widget.update_screen(values)

## The HUD over the world: every node but a button lets the mouse through to the world, and a button clicked gives the
## focus back at once (Enter and Space stay the world's; the gamepad still walks the HUD's rail).
func _leave_the_world_its_input() -> void:
	if not is_instance_valid(content):
		return
	for node in [content] + content.find_children("*", "Control", true, false):
		if node is BaseButton:
			if not node.has_meta("hud_gives_focus_back"):
				node.set_meta("hud_gives_focus_back", true)
				node.pressed.connect(func():
					if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
						get_viewport().gui_release_focus.call_deferred()
				)
		elif node.mouse_filter != Control.MOUSE_FILTER_IGNORE and not node.has_meta("hud_takes_mouse"):
			node.mouse_filter = Control.MOUSE_FILTER_IGNORE

func _layout() -> void:
	chrome.layout()
	if spec.get("layout", "") == "hud" and is_instance_valid(hud_root):
		hud_root.custom_minimum_size = size

func _select(id: String, row: C.ProtoMessage) -> void:
	var definition: Dictionary = elements.definition(id, spec.controls)
	var old: C.ProtoMessage = selected.get(id)
	if old != null and elements.identity(definition, old) == elements.identity(definition, row):
		selected[id] = row
		return
	selected[id] = row
	last_signature = ""
	_refresh.call_deferred()

func _resolve_lists(nodes: Array, row: C.ProtoMessage = null) -> void:
	for n in nodes:
		if n.kind != "list" and not (n.kind == "custom" and n.get("action_source", "") == "source"):
			_resolve_lists(n.get("children", []), row)
			continue
		var rows: Array = elements.rows_for(n, row)
		if not rows is Array or rows.is_empty():
			selected.erase(n.id)
			continue
		if n.get("mode", "select") == "cards":
			for item in rows:
				_resolve_lists(n.get("children", []), item)
			continue
		var current: C.ProtoMessage = rows[0]
		var old = selected.get(n.id)
		if old == null and n.get("bind", {}).has("initial"):
			var preferred = value(n.bind.initial, row)
			for item in rows:
				if item.to_dict().get(n.get("row_key", "")) == preferred:
					current = item
					break
		if old != null:
			var before: String = elements.identity(n, old)
			for item in rows:
				if elements.identity(n, item) == before:
					current = item
					break
		selected[n.id] = current
		_resolve_lists(n.get("children", []), current)

func _order_focus() -> void:
	var ordered: Array[Control] = []
	var ids: Array[String] = []
	for id in spec.focus+["__close"]:
		for i in range(rail.size()):
			if focus_ids[i] == id:
				ordered.append(rail[i])
				ids.append(id)
	rail = ordered
	focus_ids = ids
	for i in range(rail.size()):
		var before := rail[posmod(i-1, rail.size())]
		var after := rail[(i+1)%rail.size()]
		rail[i].focus_previous = rail[i].get_path_to(before)
		rail[i].focus_next = rail[i].get_path_to(after)
		rail[i].focus_neighbor_top = rail[i].focus_previous
		rail[i].focus_neighbor_bottom = rail[i].focus_next

func _act(action: Dictionary, row: C.ProtoMessage = null, always := false) -> void:
	if action.command == "host.toggle":
		var id: String = value(action.params.control, row)
		var key := screen_id + "/" + id
		toggles[key] = not toggles.get(key, false)
		last_signature = ""
		_refresh()
		return
	if action.command.begins_with("host."):
		var params := {}
		for key in action.get("params", {}):
			params[key] = value(action.params[key], row)
		if host != null:
			host.screen_host_action(action.command, params, self)
		elif action.command == "host.close":
			_close()
		return
	# a screen's close always reaches the server (a talk holds the world until it hears it), even with an answer in flight
	if state == null or busy and not always:
		return
	var request := "screen-%d" % Time.get_ticks_usec()
	var command := Catalog.command(action.ref, state, row, selected, request)
	last_refusal = ""
	if is_instance_valid(status):
		status.hide()
	busy = true
	if host != null:
		host.send(command)
	command_sent.emit(request, command)

func refusal(copy: String) -> void:
	busy = false
	last_refusal = copy
	if is_instance_valid(status):
		status.text = copy
		status.show()

func _close() -> void:
	if screen_id == "conversation" and state != null and state.conversation != null and state.conversation.required:
		return
	if spec.close.command.begins_with("host.") and spec.close.command != "host.close":
		_act(spec.close)
		return
	if spec.close.command != "host.close":
		_act(spec.close, null, true)
	_dismiss()

func _dismiss() -> void:
	scroll_axis = 0
	hold = Vector2.ZERO
	hide()
	dismissed.emit(screen_id)


func _label(parent: Node, copy: String, px: int) -> Label:
	return elements._label(parent, copy, px)
func _node(n: Dictionary, parent: Node, row: C.ProtoMessage) -> void:
	elements._node(n, parent, row)
func _input(event: InputEvent) -> void:
	navigation._input(event)
func _process(delta: float) -> void:
	if refresh_pending and visible:
		_refresh()
	navigation._process(delta)

func select_key(id: String, key: String, wanted: Variant) -> void:
	var definition: Dictionary = elements.definition(id, spec.controls)
	if definition.is_empty():
		return
	for row in elements.rows_for(definition, null):
		if row.to_dict().get(key) == wanted:
			_select(id, row)
			return
