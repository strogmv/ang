func TestNPC1LegUsesRealDepartureAndQueue(t *testing.T){
 m:=lifeFixture();m.Brain=brainFixture();m.Locations["a"]=LifeLocation{Name:"A",Terrain:[]string{".....",".....","....."}}
 rail:=LifeEdge{ID:"rail",From:"a",To:"b",Exit:Cell{4,0},Entry:Cell{0,1},Mode:"rail",TravelSeconds:120,PeriodSeconds:300,NightPeriodSeconds:3600,DayStartSecond:6*3600,DayEndSecond:22*3600,Seats:4}
 walk:=LifeEdge{ID:"walk",From:"a",To:"b",Exit:Cell{4,2},Entry:Cell{0,1},Mode:"walk",TravelSeconds:600,Seats:8}
 back:=LifeEdge{ID:"back",From:"b",To:"a",Exit:Cell{0,1},Entry:Cell{4,1},Mode:"walk",TravelSeconds:60,Seats:8}
 m.Edges=[]LifeEdge{rail,walk,back}
 s:=LifeState{Seconds:5*3600+180,Actors:[]LifeActor{{ID:"one",Level:"a",Position:Cell{2,1}}}}
 if e:=s.brainLegEdge(m,&s.Actors[0],"b");e==nil||e.ID!="walk"{t.Fatalf("night: expected walk, got %+v",e)}
 s.Seconds=6*3600+10;s.Actors[0].Brain.LegCheck=s.Seconds+30
