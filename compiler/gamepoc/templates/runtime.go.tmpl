func (r *Runtime) writeSave(slot string, s state) error {
	if !r.validSlot(slot) {
		return errors.New("unknown save slot")
	}
	if s.Life.PopulationFailure != "" {
		return errors.New("cannot save failed population simulation")
	}
	b, err := json.Marshal(s)
	if err != nil {
		return err
	}
	sum := sha256.Sum256(b)
	data, err := json.Marshal(saveFile{Version: r.world.Config.SaveVersion, ContentHash: r.world.ContentHash, Checksum: hex.EncodeToString(sum[:]), CreatedUnixMS: time.Now().UnixMilli(), State: b, SaveKey: &saveKeyRecord{Hash: r.world.SaveKey.Hash, Parts: r.world.SaveKey.Parts}})
	if err != nil {
		return err
	}
	if int64(len(data)) > r.world.Config.MaxSaveBytes {
		return errors.New("save too large")
	}
	file, err := os.CreateTemp(r.data, ".save-*")
	if err != nil {
		return err
	}
	tmp := file.Name()
	defer os.Remove(tmp)
	if err = file.Chmod(0600); err == nil {
		_, err = file.Write(data)
	}
	if err == nil {
		err = file.Sync()
	}
	closeErr := file.Close()
	if err != nil {
		return err
	}
	if closeErr != nil {
		return closeErr
	}
	if err = os.Rename(tmp, filepath.Join(r.data, slot+".json")); err != nil {
		return err
	}
	directory, err := os.Open(r.data)
	if err != nil {
		return err
	}
	defer directory.Close()
	return directory.Sync()
}
