     else{count=BarkVisible(lay,revealClock);if(b.Reveal=="stamped")stampAge=BarkStampAge(lay,revealClock,out stampFrom);colour.a=alpha;}
     BarkGlyphs(lay,origin,em,lineH,count,colour,stampAge,stampFrom);
     if(live.fix!=null&&clock>b.RevealMs){
