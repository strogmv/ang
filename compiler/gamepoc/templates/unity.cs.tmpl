        void Connect()
        {
            preferredWireLocale = CurrentLocale();
            session = new GameServicePlaySession(channel.CreateCallInvoker(), () => new ClientMessage { Hello = new Hello { PlayerName = playerName, ClientVersion = "poc-1", SessionToken = token, Locale = preferredWireLocale } });
            session.MaxQueuedResponses = resource.config.queue_capacity;
            session.MaxQueuedCommands = 32;
            session.ResetQueuesOnReconnect = true;
            session.OnGameState += Receive;
            session.OnSaveSlots += value => slots = value;
            session.OnMoveResult += result =>
            {
                if (state == null || result.Epoch != state.Epoch || result.InputSeq != pendingMove) return;
                ackMS = (clock.Elapsed.TotalSeconds - clickAt) * 1000;
                moveAccepted = result.Ok;
                moveStatus = result.Ok ? "Маршрут принят" : result.Reason;
                message = moveStatus;
                if (!result.Ok) { beginPending = false; latencyResultReady = true; }
            };
            session.OnActionResult += result =>
            {
                busy = "";
                if (!result.Ok) { PracticeActionResult(result); message = "Действие не выполнено: " + result.Message; openGame = false; return; }
                if (result.Action == "save") { message = "Игра сохранена"; saveConfirmed = true; }
                else if (result.Action == "load") { message = "Игра загружена"; openGame = true; }
                else if (result.Action == "new") { message = "Партия началась"; openGame = true; }
                else message = "Опции применены";
                PracticeActionResult(result);
            };
            session.Error += e => { practiceRequestId=""; inventoryPending=false; connected = false; busy = ""; message = "Связь прервана. Переподключаемся…"; Debug.LogWarning(e.Message); };
            session.OnInventoryResult += v => {inventoryPending=false;message=v.Message;};
            session.Start();
        }

        void Receive(PocGameState value)
        {
            if (value.ContentHash != resource.content_hash) { message = "Версии мира клиента и сервера различаются"; connected = false; session.Dispose(); return; }
