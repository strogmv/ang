   }
   // A blow, a parry, a shot faces the server's target first: a short turn (CUE turn_seconds for 180°, none under 15°)
   // before the clip starts; the whole beat and its impact move by that lead.
   if((b.kind=="attack"||b.kind=="parry")&&!b.pair&&!string.IsNullOrEmpty(b.target)&&h!=null&&h.hasYaw){
