func sanitaryFixture(t *testing.T, kind string) (*Runtime, sanitaryUnit) {
	t.Helper()
	r := medicalFixture(t)
	r.world.Life.Brain.Enabled = true
	r.canonicalWorld.Life.Brain.Enabled = true
	r.world.SanitaryServices.NPCHygiene = false
	var u sanitaryUnit
	for _, v := range r.world.SanitaryServices.Units {
		if v.Kind == kind {
			u = v
			break
		}
	}
	if u.ID == "" {
		t.Fatal("missing unit")
	}
	a := r.state.Life.Actor(playerActorID)
	a.Position = u.EntryCell
	a.Goal = a.Position
	a.Level = u.LevelID
	a.Body = nil
	a.Brain = behavior.LifeBrain{}
	a.Brain.AdvanceServiceNeeds(r.world.Life.Brain, a.ID, r.state.Life.Seconds, r.state.Seed, 0)
	a.Brain.Needs[2] = 700000
	r.syncLifeHero()
	return r, u
}
func sanitaryAdvance(t *testing.T, r *Runtime, seconds int64) {
	t.Helper()
	r.state.Tick += seconds * int64(r.world.Config.TickHz)
	r.state.Life.Tick = r.state.Tick
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		t.Fatal(err)
	}
	r.state.Life.Seconds += seconds
	if err := r.advanceSanitaryServices(); err != nil {
		t.Fatal(err)
	}
	r.syncLifeHero()
}
func sanitaryUsing(t *testing.T, r *Runtime, u sanitaryUnit) {
	t.Helper()
	if err := r.sanitaryRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	if err := r.advanceSanitaryServices(); err != nil {
		t.Fatal(err)
	}
	if r.state.Sanitary.Users[playerActorID].Phase != "opening" {
		t.Fatal("not opening")
	}
	if r.state.Life.Actor(playerActorID).ServiceAttachment != "" {
		t.Fatal("entry before door open")
	}
	sanitaryAdvance(t, r, 1)
	if !r.sanitaryAttached(playerActorID) {
		t.Fatal("no physical entry")
	}
	sanitaryAdvance(t, r, 2)
	if r.state.Sanitary.Users[playerActorID].Phase != "sealing" {
		t.Fatal("door closing before using")
	}
	sanitaryAdvance(t, r, 1)
	if r.state.Sanitary.Users[playerActorID].Phase != "using" {
		t.Fatal("not using")
	}
}
func TestSanitaryShowerRealNeedsAndMeter(t *testing.T) {
	r, u := sanitaryFixture(t, "shower")
	sanitaryUsing(t, r, u)
	a := r.state.Life.Actor(playerActorID)
	before := a.Brain.Needs
	rem := a.Brain.Remainder
	for i := 0; i < 180; i++ {
		sanitaryAdvance(t, r, 1)
	}
	p := r.state.Sanitary.Users[playerActorID]
	if p.UseElapsed != 180 || p.WaterML != 25000 || p.WaterRemainder != 0 || r.state.Sanitary.WaterML[u.ID] != 25000 || p.Phase != "opening_exit" {
		t.Fatalf("bad water/time %+v", p)
	}
	expected := before[2] + ((r.world.Life.Brain.Rates[2]-r.world.Life.Brain.HygieneRecovery)*180+rem[2])/86400
	if a.Brain.Needs[2] != expected {
		t.Fatalf("hygiene %d expected %d", a.Brain.Needs[2], expected)
	}
	if a.Brain.Needs[1] <= before[1] {
		t.Fatal("other needs froze")
	}
	if err := r.validateSanitary(r.state); err != nil {
		t.Fatal(err)
	}
	sanitaryAdvance(t, r, 1)
	sanitaryAdvance(t, r, 2)
	sanitaryAdvance(t, r, 1)
	if r.sanitaryReserved(playerActorID) || !a.OnFloor() || a.Position != u.EntryCell {
		t.Fatal("failed physical exit")
	}
	if r.state.Sanitary.Completed[u.ID] != 1 {
		t.Fatal("completion repeated")
	}
}
func TestSanitaryPauseAvailabilityAndSave(t *testing.T) {
	r, u := sanitaryFixture(t, "shower")
	sanitaryUsing(t, r, u)
	sanitaryAdvance(t, r, 7)
	saved := r.state.Sanitary.clone()
	r.state.Paused = true
	for i := 0; i < 5; i++ {
		if err := r.advanceSanitaryServices(); err != nil {
			t.Fatal(err)
		}
	}
	if !reflect.DeepEqual(saved, r.state.Sanitary) {
		t.Fatal("pause consumed water")
	}
	r.state.Paused = false
	r.world.SanitaryServices.ServiceAvailable = false
	sanitaryAdvance(t, r, 30)
	if r.state.Sanitary.Users[playerActorID].UseElapsed != 7 || r.state.Sanitary.WaterML[u.ID] != saved.WaterML[u.ID] {
		t.Fatal("dry supply still flowed")
	}
	r.world.SanitaryServices.ServiceAvailable = true
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	r.state = loaded
	if err := r.validateSanitary(r.state); err != nil {
		t.Fatal(err)
	}
	sanitaryAdvance(t, r, 173)
	if r.state.Sanitary.WaterML[u.ID] != 25000 {
		t.Fatal("saved fraction lost")
	}
}
