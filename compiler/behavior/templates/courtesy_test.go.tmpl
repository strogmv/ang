	p, m := populationFixture()
	m.Population = p
	m.Actors = append(m.Actors, LifePerson{ID: "friend", Name: "Friend", Relations: []LifeRelation{{To: "base", Strength: .5}}, Steps: []LifeStep{{Level: "a", At: Cell{31, 1}, Activity: "rest"}}})
	s, err := m.StartWithPopulation(3, "base")
	if err != nil {
		t.Fatal(err)
	}
	resident := s.Population.Actors[0].ID
	if s.RelationTo(m, resident, "base") != 0 || s.RelationTo(m, "base", "friend") != 0 || s.RelationTo(m, "friend", "base") != .5 {
		t.Fatal("default relations invented friendship or reversed an edge")
	}
	for _, relation := range []struct {
		from, to string
		value    float64
	}{{"friend", "base", 0}, {resident, "base", .7}, {"base", resident, -.4}} {
		if err := s.SetRelation(relation.from, relation.to, relation.value); err != nil {
			t.Fatal(err)
		}
	}
	if s.RelationTo(m, "friend", "base") != 0 || s.RelationTo(m, resident, "base") != .7 || s.RelationTo(m, "base", resident) != -.4 {
		t.Fatal("runtime override did not replace the directed canonical value")
	}
	clone := s.Clone()
	if err := clone.SetRelation(resident, "base", -.9); err != nil {
		t.Fatal(err)
	}
	clone.RelationOverrides["base"][resident] = 1
	if s.RelationTo(m, resident, "base") != .7 || s.RelationTo(m, "base", resident) != -.4 {
		t.Fatal("cloned relation maps alias the original")
	}
	raw, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var restored LifeState
	if err := json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	if err := restored.Validate(m, restored.Tick); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(s.Clone(), restored.Clone()) || restored.RelationTo(m, resident, "base") != .7 || restored.RelationTo(m, "friend", "base") != 0 {
		t.Fatal("named or population attitude lost in save round trip")
	}
	var legacy map[string]json.RawMessage
	if err := json.Unmarshal(raw, &legacy); err != nil {
		t.Fatal(err)
	}
	delete(legacy, "relation_overrides")
	old, err := json.Marshal(legacy)
	if err != nil {
		t.Fatal(err)
	}
	var compatible LifeState
	if err := json.Unmarshal(old, &compatible); err != nil {
		t.Fatal(err)
	}
	if err := compatible.Validate(m, compatible.Tick); err != nil {
		t.Fatalf("old save without relations rejected: %v", err)
	}
	if compatible.RelationTo(m, "friend", "base") != .5 || compatible.RelationTo(m, resident, "base") != 0 {
		t.Fatal("old save fabricated a population edge or lost canonical fallback")
	}
	for _, invalid := range []struct {
		from, to string
		value    float64
	}{
		{"missing", "base", .1}, {"base", "missing", .1}, {"", "base", .1}, {resident, "base", 1.01}, {"base", resident, -1.01}, {resident, "base", math.NaN()}, {resident, "base", math.Inf(1)},
	} {
		before := s.Clone()
		if s.SetRelation(invalid.from, invalid.to, invalid.value) == nil || !reflect.DeepEqual(before, s.Clone()) {
			t.Fatal("invalid runtime relation accepted or mutated valid state")
		}
		bad := s.Clone()
		bad.RelationOverrides[invalid.from] = map[string]float64{invalid.to: invalid.value}
		if bad.Validate(m, bad.Tick) == nil {
			t.Fatal("tampered saved relation accepted")
		}
	}
}

func TestLifeCourtesyModelRejectsInvalidRangeAndRelation(t *testing.T) {
	for _, radius := range []int{0, 1, 2, 8, -1, 9} {
		m, _ := courtesyFixture()
		m.Courtesy.NoticeCells = radius
		if err := m.Validate(); (err == nil) != (radius >= 0 && radius <= 8) {
			t.Fatalf("range %d: %v", radius, err)
		}
	}
	for _, strength := range []float64{-1, 0, 1, -1.01, 1.01, math.NaN(), math.Inf(-1), math.Inf(1)} {
		m, _ := courtesyFixture()
		m.Actors[1].Relations[0].Strength = strength
		if err := m.Validate(); (err == nil) != (strength >= -1 && strength <= 1) {
			t.Fatalf("relation strength %v: %v", strength, err)
		}
	}
	m, _ := courtesyFixture()
	m.Actors[1].Relations[0].To = ""
	if m.Validate() == nil {
		t.Fatal("empty relation target accepted")
	}
}
