package poc

// The hero's personal file before the lineup (doc 104 v2, design/hero-creation/v1/BRIEF.md): the start of the hero for
// every profile, episode and trait; the hero of the book is the canon; save and load; a save from before the file; the
// screen's every line from the server; the first check on the first night in the dorm.

import (
	"math"
	"reflect"
	"strconv"
	"strings"
	"testing"

	behavior "angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

func heroFileRuntime(t *testing.T) (*Runtime, *connection) {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	if r.world.HeroFile == nil {
		t.Skip("the world has no hero file")
	}
	return r, &connection{locale: "ru", out: make(chan *pb.ServerMessage, 8192), stop: make(chan struct{})}
}

var heroFileGames int

// heroFileNew starts a life game with a file (nil: none sent) and returns the server's answer.
func heroFileNew(t *testing.T, r *Runtime, c *connection, choice *pb.PocHeroFileChoice) *pb.PocActionResult {
	t.Helper()
	heroFileGames++
	id := "file.new." + strconv.Itoa(heroFileGames)
	r.testCommand(c, input{msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: id, Scenario: "life", Seed: 777, HeroFile: choice}}}})
	return answer(t, c, id)
}

func heroFileSkills(r *Runtime) map[string]int {
	out := map[string]int{}
	for _, s := range r.world.HeroFile.Skills {
		out[s] = r.state.Life.Development.Value(playerActorID, s)
	}
	return out
}

func heroFileWith(c heroFileChoice, edit func(*heroFileChoice)) *pb.PocHeroFileChoice {
	c = c.clone()
	edit(&c)
	return c.wire()
}

// The hero of the book — a new game without a file or with the default sent — starts exactly as the canonical hero of
// the world's data (his development profile), learns his strengths faster, and the inspection sees his values.
func TestHeroFileHeroOfTheBookIsTheCanon(t *testing.T) {
	r, c := heroFileRuntime(t)
	w := r.world.HeroFile
	if a := heroFileNew(t, r, c, nil); !a.Ok {
		t.Fatal(a.Message)
	}
	if r.state.HeroFile == nil || !reflect.DeepEqual(r.state.HeroFile.Choice, w.Default) || r.state.HeroFile.Legacy {
		t.Fatalf("a new game without a file is not the hero of the book: %+v", r.state.HeroFile)
	}
	canon := r.world.Life.Development.Profiles[playerActorID]
	for s, v := range heroFileSkills(r) {
		if v != canon.Skills[s].Start || v != w.start(w.Default)[s] {
			t.Fatalf("%s starts at %d, the canon at %d, the file at %d", s, v, canon.Skills[s].Start, w.start(w.Default)[s])
		}
		if at, ok := r.state.Life.Observer.Attributes[s]; ok && at != v {
			t.Fatalf("the inspection sees %s %d, the hero has %d", s, at, v)
		}
	}
	own := r.state.Life.Development.Actors[playerActorID].Own
	for _, s := range w.Default.Strengths {
		if own == nil || own.LearnPermille[s] != w.Strengths.LearnPermille {
			t.Fatalf("strength %s does not grow faster: %+v", s, own)
		}
	}
	first := r.state.Life.Development.Actors[playerActorID]
	if a := heroFileNew(t, r, c, w.Default.wire()); !a.Ok {
		t.Fatal(a.Message)
	}
	if !reflect.DeepEqual(first, r.state.Life.Development.Actors[playerActorID]) {
		t.Fatal("the default sent differs from no file")
	}
	// exactly one canonical profile, the default's
	for _, p := range w.Profiles {
		if p.Canon != (p.ID == w.Default.Profile) {
			t.Fatalf("profile %s canon %v", p.ID, p.Canon)
		}
	}
}

// Every profile, episode and trait gives its own start, topics, recorded facts and effects.
func TestHeroFileStartForEveryProfileEpisodeAndTrait(t *testing.T) {
	r, c := heroFileRuntime(t)
	w := r.world.HeroFile
	for _, p := range w.Profiles {
		if a := heroFileNew(t, r, c, heroFileWith(w.Default, func(x *heroFileChoice) { x.Profile = p.ID })); !a.Ok {
			t.Fatal(a.Message)
		}
		for s, v := range heroFileSkills(r) {
			want := p.Skills[s]
			if heroFileHas(w.Default.Strengths, s) {
				want += w.Strengths.Bonus
			}
			if want > w.Strengths.StartCap {
				want = w.Strengths.StartCap
			}
			if v != want {
				t.Fatalf("profile %s: %s %d, want %d", p.ID, s, v, want)
			}
		}
	}
	for i, e := range w.Episodes {
		other := w.Episodes[(i+1)%len(w.Episodes)].ID
		if a := heroFileNew(t, r, c, heroFileWith(w.Default, func(x *heroFileChoice) { x.Episodes = []string{e.ID, other} })); !a.Ok {
			t.Fatal(a.Message)
		}
		if !heroFileHas(r.heroFileTopics(), e.Topic) {
			t.Fatalf("episode %s: no topic %s in %v", e.ID, e.Topic, r.heroFileTopics())
		}
		if !heroFileHas(r.heroFileFacts(), e.Fact) {
			t.Fatalf("episode %s: no recorded fact in %v", e.ID, r.heroFileFacts())
		}
		// the past is in the conversations' memory: the chosen episodes' topics and facts, not the others'
		if r.world.Memory != nil {
			for _, x := range w.Episodes {
				_, topic := r.state.Memory.Topics[x.Topic]
				fact, has := r.state.Memory.Facts[x.Fact]
				chosen := heroFileHas(r.state.HeroFile.Choice.Episodes, x.ID)
				if topic != chosen || has != chosen || has && (fact.Count != 1 || len(fact.Witnesses) != 0) {
					t.Fatalf("episode %s chosen %v: memory topic %v, fact %v %+v", x.ID, chosen, topic, has, fact)
				}
			}
		}
		// an episode's effects act only through the file's accessors (none of the episodes has one today)
		if len(e.Effects) > 0 && r.heroFileEffects() == nil {
			t.Fatalf("episode %s: its effects do not act", e.ID)
		}
	}
	for _, tr := range w.Traits {
		if a := heroFileNew(t, r, c, heroFileWith(w.Default, func(x *heroFileChoice) { x.Trait = tr.ID })); !a.Ok {
			t.Fatal(a.Message)
		}
		start := w.start(r.state.HeroFile.Choice)
		loud, relief, conspicuous := 1000, 0, 1.0
		for _, fx := range tr.Effects {
			switch {
			case fx.Skill != nil:
				base := w.start(heroFileChoice{Profile: w.Default.Profile, Strengths: w.Default.Strengths, Episodes: w.Default.Episodes, Portrait: w.Default.Portrait})[fx.Skill.ID]
				if want := min(w.Strengths.StartCap, max(0, base+fx.Skill.Add)); start[fx.Skill.ID] != want || heroFileSkills(r)[fx.Skill.ID] != want {
					t.Fatalf("trait %s: %s %d, want %d", tr.ID, fx.Skill.ID, heroFileSkills(r)[fx.Skill.ID], want)
				}
			case fx.StepLoudnessPermille > 0:
				loud = loud * fx.StepLoudnessPermille / 1000
			case fx.WoundAPRelief > 0:
				relief += fx.WoundAPRelief
			case fx.VisibilityPermille != nil:
				conspicuous *= float64(fx.VisibilityPermille.Permille) / 1000
			}
		}
		if r.heroStepLoudnessPermille() != loud || r.heroWoundRelief() != relief {
			t.Fatalf("trait %s: steps %d, relief %d", tr.ID, r.heroStepLoudnessPermille(), r.heroWoundRelief())
		}
		if a := r.combatant(playerActorID, "hero"); a.WoundAPRelief != relief {
			t.Fatalf("trait %s: the hero's fighter shrugs off %d, want %d", tr.ID, a.WoundAPRelief, relief)
		}
		// standing still: the still effects; moving: none
		r.state.HeroFile.StillSince = r.state.Life.Seconds
		if r.heroConspicuous() != 1 {
			t.Fatalf("trait %s: conspicuous while moving", tr.ID)
		}
		r.state.HeroFile.StillSince = r.state.Life.Seconds - w.StillSeconds
		if r.heroConspicuous() != conspicuous {
			t.Fatalf("trait %s: conspicuous %.2f while still, want %.2f", tr.ID, r.heroConspicuous(), conspicuous)
		}
	}
	if (behavior.Combatant{BodyAPPenalty: 2, WoundAPRelief: 1}).WoundAPPenalty() != 1 || (behavior.Combatant{BodyAPPenalty: 0, WoundAPRelief: 1}).WoundAPPenalty() != 0 {
		t.Fatal("wound relief is not subtracted from the penalty")
	}
	// a watcher's recognition rate scales with the hero's conspicuousness (the patient hero standing)
	if p := r.world.Stealth.StealthPolicy; p.Enabled {
		e := behavior.StealthEvidence{DistanceMM: p.NearMM + 1, FacingDot: 1, Exposure: 1, Sneaking: true}
		plain := p.VisualRate(e)
		e.Conspicuous = 1.5
		if plain <= 0 || p.VisualRate(e) != plain*1.5 {
			t.Fatalf("recognition does not scale with conspicuousness: %.3f → %.3f", plain, p.VisualRate(e))
		}
	}
}

// A file the server cannot take refuses the new game and leaves the running one as it was.
func TestHeroFileNewGameRefusesABadFile(t *testing.T) {
	r, c := heroFileRuntime(t)
	w := r.world.HeroFile
	if a := heroFileNew(t, r, c, nil); !a.Ok {
		t.Fatal(a.Message)
	}
	epoch := r.state.Epoch
	for name, bad := range map[string]*pb.PocHeroFileChoice{
		"unknown profile":  heroFileWith(w.Default, func(x *heroFileChoice) { x.Profile = "athlete" }),
		"unknown skill":    heroFileWith(w.Default, func(x *heroFileChoice) { x.Strengths = []string{w.Skills[0], "astral"} }),
		"repeated episode": heroFileWith(w.Default, func(x *heroFileChoice) { x.Episodes = []string{w.Episodes[0].ID, w.Episodes[0].ID} }),
		"one strength":     heroFileWith(w.Default, func(x *heroFileChoice) { x.Strengths = x.Strengths[:1] }),
		"one episode":      heroFileWith(w.Default, func(x *heroFileChoice) { x.Episodes = x.Episodes[:1] }),
		"unknown trait":    heroFileWith(w.Default, func(x *heroFileChoice) { x.Trait = "lucky" }),
	} {
		if a := heroFileNew(t, r, c, bad); a.Ok || a.Message == "" || r.state.Epoch != epoch {
			t.Fatalf("%s: accepted or the running game replaced (%v %q)", name, a.Ok, a.Message)
		}
	}
	a := heroFileNew(t, r, c, heroFileWith(w.Default, func(x *heroFileChoice) { x.Strengths = x.Strengths[:1] }))
	if a.Message != r.localText("ru", w.Text.ProblemStrengths, "") {
		t.Fatalf("one strength: %q", a.Message)
	}
	// a file the world cannot start (a growth cap under its start) fails after the new game is built: the running game
	// is swapped back whole
	running, development := r.state.HeroFile.clone(), r.state.Life.Development.Clone()
	profile := r.canonicalWorld.Life.Development.Profiles[playerActorID]
	last := w.Skills[len(w.Skills)-1]
	cfg := profile.Skills[last]
	defer func() { profile.Skills[last] = cfg }()
	limited := cfg
	limited.Cap = w.start(w.Default)[last] + 1
	profile.Skills[last] = limited
	if a := heroFileNew(t, r, c, heroFileWith(w.Default, func(x *heroFileChoice) { x.Strengths = []string{x.Strengths[0], last} })); a.Ok || r.state.Epoch != epoch || !reflect.DeepEqual(r.state.HeroFile, running) || !reflect.DeepEqual(r.state.Life.Development, development) {
		t.Fatalf("a new game that failed half-way replaced the running one: %+v", a)
	}
}

// The file is saved with the game and loads; a forged start or file refuses; a save from before the file loads with
// the hero's saved skills and a legacy file.
func TestHeroFileSaveLoadAndASaveFromBefore(t *testing.T) {
	r, c := heroFileRuntime(t)
	w := r.world.HeroFile
	last := len(w.Profiles) - 1
	choice := heroFileWith(w.Default, func(x *heroFileChoice) {
		x.Profile = w.Profiles[last].ID
		x.Strengths = w.Skills[len(w.Skills)-w.Strengths.Count:]
		x.Episodes = nil
		for _, e := range w.Episodes[len(w.Episodes)-w.EpisodesPick:] {
			x.Episodes = append(x.Episodes, e.ID)
		}
		x.Trait = w.Traits[len(w.Traits)-1].ID
		x.Portrait = w.Portraits[len(w.Portraits)-1].ID
	})
	if a := heroFileNew(t, r, c, choice); !a.Ok {
		t.Fatal(a.Message)
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(loaded.HeroFile, r.state.HeroFile) || !reflect.DeepEqual(loaded.Life.Development.Actors[playerActorID], r.state.Life.Development.Actors[playerActorID]) {
		t.Fatal("the file or the hero's development changed in the save")
	}
	forge := func(name string, edit func(*state)) {
		s := r.snapshotState()
		edit(&s)
		if err := r.writeSave(slot, s); err != nil {
			t.Fatal(err)
		}
		if _, _, err := r.readSave(slot); err == nil {
			t.Fatalf("%s: loaded", name)
		}
	}
	// a start not of the file (a tuned profile, or a forged one) is put back to the file's on load, earned kept
	s := r.snapshotState()
	a := s.Life.Development.Actors[playerActorID]
	k := w.Skills[0]
	a.Own.Start[k] -= 3
	v := a.Skills[k]
	v.ValueMilli -= 3000
	a.Skills[k] = v
	s.Life.Development.Actors[playerActorID] = a
	if err := r.writeSave(slot, s); err != nil {
		t.Fatal(err)
	}
	tuned, _, err := r.readSave(slot)
	if err != nil {
		t.Fatalf("a save of another start of the file does not load: %v", err)
	}
	if !reflect.DeepEqual(tuned.Life.Development.Actors[playerActorID].Own.Start, w.own(r.state.HeroFile.Choice).Start) || tuned.Life.Development.Value(playerActorID, k) != r.state.Life.Development.Value(playerActorID, k) {
		t.Fatal("the loaded start is not the file's")
	}
	forge("a start above the cap", func(s *state) {
		a := s.Life.Development.Actors[playerActorID]
		a.Own.Start[k] = 101
		s.Life.Development.Actors[playerActorID] = a
	})
	forge("an unknown profile", func(s *state) { s.HeroFile.Choice.Profile = "athlete" })
	forge("one strength", func(s *state) { s.HeroFile.Choice.Strengths = s.HeroFile.Choice.Strengths[:1] })
	forge("a first check state", func(s *state) { s.HeroFile.Recheck = "maybe" })
	forge("a stillness in the future", func(s *state) { s.HeroFile.StillSince = s.Life.Seconds + 1 })
	forge("a wound relief of a stranger", func(s *state) {
		s.CombatRoster = map[string]behavior.Combatant{"char.roommate_senya": {ID: "char.roommate_senya", WoundAPRelief: 1}}
	})
	// a save from before the file: no file, the hero's development without its own start, his skills of that build
	old := map[string]int{}
	s = r.snapshotState()
	s.HeroFile = nil
	a = s.Life.Development.Actors[playerActorID]
	a.Own = nil
	profile := r.world.Life.Development.Profiles[playerActorID]
	for i, k := range w.Skills {
		old[k] = max(0, profile.Skills[k].Start-5*(i%3))
		v := a.Skills[k]
		v.ValueMilli = int64(old[k]) * 1000
		a.Skills[k] = v
	}
	s.Life.Development.Actors[playerActorID] = a
	if err := r.writeSave(slot, s); err != nil {
		t.Fatal(err)
	}
	legacy, _, err := r.readSave(slot)
	if err != nil {
		t.Fatalf("a save from before the file does not load: %v", err)
	}
	if legacy.HeroFile == nil || !legacy.HeroFile.Legacy {
		t.Fatalf("no legacy file: %+v", legacy.HeroFile)
	}
	for k, v := range old {
		if got := legacy.Life.Development.Value(playerActorID, k); got != v {
			t.Fatalf("a legacy hero's %s changed: %d, was %d", k, got, v)
		}
	}
	other, _ := heroFileRuntime(t)
	other.state = legacy
	if other.heroFileEffects() != nil || other.heroFileTopics() != nil || other.heroStepLoudnessPermille() != 1000 {
		t.Fatal("a legacy file acts")
	}
}

// The screen of the file: every line and number from the server, in the player's language.
func TestHeroFileViewWordsTheScreen(t *testing.T) {
	r, _ := heroFileRuntime(t)
	w, d := r.world.HeroFile, r.world.DialogueRules
	text := func(key string) string { return r.localText("ru", key, "") }
	v := r.heroFileView("ru", &pb.PocHeroFileRequest{RequestId: "view", Mode: "new"})
	if !v.Ready || v.Problem != "" || v.RequestId != "view" || v.Header != text(w.Text.Header) || v.Club != text(w.Club) || v.ChipTraining != text(w.Text.Training) {
		t.Fatalf("the default file is not ready or unworded: %+v", v)
	}
	if !reflect.DeepEqual(v.Choice, w.Default.wire()) || v.StrengthsLeft != 0 {
		t.Fatalf("the screen does not open with the hero of the book: %+v", v.Choice)
	}
	var marks []int32
	for _, level := range d.Difficulties {
		if level.Value <= w.Strengths.StartCap {
			marks = append(marks, int32(level.Value))
		}
	}
	if !reflect.DeepEqual(v.Marks, marks) || len(marks) == 0 {
		t.Fatalf("marks %v, want %v", v.Marks, marks)
	}
	values := w.start(w.Default)
	if len(v.Skills) != len(w.Skills) {
		t.Fatal("not every file skill on the screen")
	}
	level := func(id string) dialogueDifficulty {
		for _, l := range d.Difficulties {
			if l.ID == id {
				return l
			}
		}
		t.Fatalf("no difficulty %s", id)
		return dialogueDifficulty{}
	}
	part := func(l dialogueDifficulty, skill int) string {
		return strings.NewReplacer("{difficulty}", text(l.Text), "{chance}", strconv.Itoa(d.Chance[l.ID][skill])).Replace(text(w.Text.Level))
	}
	sep := text("ui.format.separator")
	for i, s := range v.Skills {
		if s.Id != w.Skills[i] || int(s.Value) != values[s.Id] || s.Name == "" || s.Name == d.Skills[s.Id].Name || s.Colour != d.Skills[s.Id].Colour || s.Line == "" {
			t.Fatalf("skill row %d: %+v", i, s)
		}
		// the brief's examples: at the sure level's «sure» — «берёт всё · очень сложно 50 %»; below — the two levels
		// under certainty («просто 70 % · средне 40 %» at 20)
		sure := level(w.Line.SureLevel)
		if d.Chance[sure.ID][s.Value] >= w.Line.SurePercent {
			if !strings.HasPrefix(s.Line, text(w.Text.All)) {
				t.Fatalf("%s at %d: %q, want «%s …»", s.Id, s.Value, s.Line, text(w.Text.All))
			}
		} else if s.Value == 20 {
			if want := part(level("easy"), 20) + sep + part(level("medium"), 20); s.Line != want {
				t.Fatalf("%s at 20: %q, want %q", s.Id, s.Line, want)
			}
		}
		if len(s.Give) < 3 || s.Give[len(s.Give)-1].Kind != "none" {
			t.Fatalf("%s: panel %+v", s.Id, s.Give)
		}
		if s.Strength != heroFileHas(w.Default.Strengths, s.Id) {
			t.Fatalf("%s: strength mark", s.Id)
		}
	}
	if got := r.heroFileLine("ru", 55); got != text(w.Text.All)+sep+part(level("very_hard"), 55) {
		t.Fatalf("line at 55: %q", got)
	}
	// a marked strength cut by the cap says so; the chance line names before and after the strength
	for _, s := range v.Skills {
		base := int(s.Base)
		if s.Strength && base+w.Strengths.Bonus > w.Strengths.StartCap && !strings.Contains(s.Detail, strconv.Itoa(w.Strengths.StartCap)) {
			t.Fatalf("%s: capped strength without the cap: %q", s.Id, s.Detail)
		}
	}
	// half a file is shown with its problem, a foreign id with the refusal
	half := r.heroFileView("ru", &pb.PocHeroFileRequest{Choice: heroFileWith(w.Default, func(x *heroFileChoice) { x.Strengths = x.Strengths[:1] })})
	if half.Ready || half.Problem != text(w.Text.ProblemStrengths) || half.StrengthsLeft != 1 {
		t.Fatalf("half a file: %+v", half)
	}
	bad := r.heroFileView("ru", &pb.PocHeroFileRequest{Choice: heroFileWith(w.Default, func(x *heroFileChoice) { x.Trait = "lucky" })})
	if bad.Ready || bad.Problem != text(w.Text.Invalid) {
		t.Fatalf("a foreign id: %+v", bad)
	}
	// every entry worded, the canonical profile tagged, «no trait» last, the other language differs
	en := r.heroFileView("en", &pb.PocHeroFileRequest{})
	if en.Header == v.Header || en.Skills[0].Line == v.Skills[0].Line && v.Skills[0].Line != "" {
		t.Fatal("the English screen is the Russian one")
	}
	tagged := 0
	for _, o := range v.Profiles {
		if o.Title == "" || o.Text == "" || len(o.Give) == 0 {
			t.Fatalf("profile %+v", o)
		}
		if o.Recommended != "" {
			tagged++
		}
	}
	if tagged != 1 || v.Traits[len(v.Traits)-1].Id != "" || len(v.Episodes) != len(w.Episodes) || len(v.Portraits) != len(w.Portraits) {
		t.Fatal("profiles, traits, episodes or portraits")
	}
	for _, o := range append(append([]*pb.PocHeroFileOption{}, v.Episodes...), v.Traits[:len(v.Traits)-1]...) {
		if o.Title == "" || o.Text == "" || o.Minus == "" || len(o.Give) != 3 {
			t.Fatalf("entry %+v", o)
		}
		for _, g := range o.Give {
			if strings.HasPrefix(g.Text, "file.") {
				t.Fatalf("an unworded key on the screen: %q", g.Text)
			}
		}
	}
}

// The first night in the dorm the chip offers the first check once: the profile, strengths and trait change, the past
// stays, what was earned stays; skipped, it never comes back.
func TestHeroFileFirstCheck(t *testing.T) {
	r, c := heroFileRuntime(t)
	w := r.world.HeroFile
	if a := heroFileNew(t, r, c, nil); !a.Ok {
		t.Fatal(a.Message)
	}
	r.heroFileBeforeFrame()
	if r.state.HeroFile.Recheck != "" {
		t.Fatal("the first check before the first night")
	}
	recheck := func(id, action string, choice *pb.PocHeroFileChoice) *pb.PocActionResult {
		r.testCommand(c, input{msg: &pb.ClientMessage{Msg: &pb.ClientMessage_HeroFileCommand{HeroFileCommand: &pb.PocHeroFileCommand{Epoch: r.state.Epoch, RequestId: id, Action: action, Choice: choice}}}})
		return answer(t, c, id)
	}
	if a := recheck("early", "skip", nil); a.Ok {
		t.Fatal("a first check before it is offered")
	}
	// earn some practice of a file skill first
	var rule behavior.PracticeRule
	for _, x := range r.world.Life.Development.Rules {
		if heroFileHas(w.Skills, x.Skill) {
			rule = x
			break
		}
	}
	if rule.ID == "" {
		t.Skip("no practice rule of a file skill")
	}
	result, err := r.state.Life.Development.Apply(r.world.Life.Development, behavior.PracticeEvent{Actor: playerActorID, Rule: rule.ID, Sequence: 1, Tick: r.state.Tick, Outcome: "success", QualityPermille: 1000}, r.state.Tick)
	if err != nil || result.GainMilli <= 0 {
		t.Fatalf("practice: %v %+v", err, result)
	}
	// the first check's place and night (here: where the hero stands; the night's window one hour ahead, then now —
	// the world's clock is not moved, so the game stays one that saves and loads)
	hour := int(r.state.Life.Seconds % 86400 / 3600)
	w.Recheck.Level = r.currentLevel()
	w.Recheck.NightFromH, w.Recheck.NightToH = (hour+1)%24, (hour+2)%24
	r.heroFileBeforeFrame()
	if r.state.HeroFile.Recheck != "" {
		t.Fatal("the first check before its night")
	}
	w.Recheck.NightFromH, w.Recheck.NightToH = hour, (hour+1)%24
	r.heroFileBeforeFrame()
	if r.state.HeroFile.Recheck != "offered" {
		t.Fatal("no first check on the first night in the dorm")
	}
	msg := &pb.PocGameState{}
	r.appendHeroFileOffer(msg, "ru")
	if o := msg.HeroFileOffer; o == nil || o.Title != r.localText("ru", w.Recheck.Title, "") || o.Do == "" || o.Skip == "" || o.Body == "" {
		t.Fatalf("the chip's notice: %+v", msg.HeroFileOffer)
	}
	// saved and loaded between the offer and the answer: still offered, still answerable
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil || loaded.HeroFile == nil || loaded.HeroFile.Recheck != "offered" {
		t.Fatalf("the offer did not survive a load: %v %+v", err, loaded.HeroFile)
	}
	r.state = loaded
	view := r.heroFileView("ru", &pb.PocHeroFileRequest{Mode: "recheck"})
	if !view.PastLocked || !view.Ready || !reflect.DeepEqual(view.Choice, r.state.HeroFile.Choice.wire()) {
		t.Fatalf("the first check screen: %+v", view)
	}
	past := r.state.HeroFile.Choice
	if a := recheck("past", "apply", heroFileWith(past, func(x *heroFileChoice) { x.Episodes = []string{w.Episodes[len(w.Episodes)-1].ID, w.Episodes[len(w.Episodes)-2].ID} })); a.Ok || a.Message != r.localText("ru", w.Text.PastLocked, "") {
		t.Fatalf("the past changed at the first check: %+v", a)
	}
	next := heroFileWith(past, func(x *heroFileChoice) {
		x.Profile = w.Profiles[len(w.Profiles)-1].ID
		x.Strengths = w.Skills[len(w.Skills)-w.Strengths.Count:]
		x.Trait = w.Traits[0].ID
	})
	// in danger (a lockdown alarm on his level) the review is closed, on the screen and on the server
	r.state.Life.LocationLockdown = map[string]bool{r.currentLevel(): true}
	if v := r.heroFileView("ru", &pb.PocHeroFileRequest{Mode: "recheck"}); v.Ready || v.Problem != r.localText("ru", w.Text.NoRecheck, "") {
		t.Fatalf("the review in danger: %+v", v)
	}
	if a := recheck("danger", "apply", next); a.Ok || a.Message != r.localText("ru", w.Text.NoRecheck, "") {
		t.Fatalf("a review applied in danger: %+v", a)
	}
	r.state.Life.LocationLockdown = nil
	beforeStart := w.start(past)[rule.Skill]
	earned := r.state.Life.Development.Actors[playerActorID].Skills[rule.Skill].ValueMilli - int64(beforeStart)*1000
	if a := recheck("apply", "apply", next); !a.Ok || a.Message != r.localText("ru", w.Recheck.Done, "") {
		t.Fatalf("the first check: %+v", a)
	}
	f := r.state.HeroFile
	want := w.start(f.Choice)
	if f.Recheck != "done" || f.Choice.Profile != next.Profile || !reflect.DeepEqual(f.Choice.Episodes, past.Episodes) {
		t.Fatalf("the first check did not record: %+v", f)
	}
	for s, v := range want {
		got := r.state.Life.Development.Actors[playerActorID].Skills[s].ValueMilli
		if s == rule.Skill {
			if limit := int64(r.world.Life.Development.Profiles[playerActorID].Skills[s].Cap) * 1000; got != min(limit, int64(v)*1000+earned) {
				t.Fatalf("%s lost what was earned: %d, want %d", s, got, int64(v)*1000+earned)
			}
		} else if got != int64(v)*1000 {
			t.Fatalf("%s %d after the first check, want %d", s, got, v)
		}
	}
	if a := recheck("again", "skip", nil); a.Ok {
		t.Fatal("a second first check")
	}
	msg = &pb.PocGameState{}
	r.appendHeroFileOffer(msg, "ru")
	if msg.HeroFileOffer != nil {
		t.Fatal("the notice stays after the first check")
	}
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave(slot); err != nil {
		t.Fatalf("a game after its first check does not load: %v", err)
	}
	// skipped: never again
	if a := heroFileNew(t, r, c, nil); !a.Ok {
		t.Fatal(a.Message)
	}
	hour = int(r.state.Life.Seconds % 86400 / 3600)
	w.Recheck.Level = r.currentLevel()
	w.Recheck.NightFromH, w.Recheck.NightToH = hour, (hour+1)%24
	r.heroFileBeforeFrame()
	if a := recheck("skip", "skip", nil); !a.Ok || r.state.HeroFile.Recheck != "skipped" {
		t.Fatalf("skip: %+v", a)
	}
	r.heroFileBeforeFrame()
	if r.state.HeroFile.Recheck != "skipped" {
		t.Fatal("a skipped first check came back")
	}
}

// Part 1b: melee is one number — the hero's skill in a fight with a melee weapon or bare hands is his combat profile's
// moved point for point by his developed melee (the hero of the book fights exactly as tuned); a firearm and every
// NPC keep their profiles; the file's panel shows the server's fight number for the melee strength.
func TestHeroFileMeleeIsTheFightSkill(t *testing.T) {
	r, c := heroFileRuntime(t)
	w, cr := r.world.HeroFile, r.world.CombatRuntime
	profile := cr.Profiles[cr.Actors[playerActorID]]
	if profile.Develops == nil {
		t.Skip("the hero's fight develops no skill")
	}
	skill := profile.Develops.Skill
	knife, needle := cr.Weapons[w.Fight.Weapon], behavior.CombatWeapon{}
	for _, x := range cr.Weapons {
		if behavior.CombatWeaponKind(x) == "firearm" {
			needle = x
		}
	}
	npc := ""
	for id, p := range cr.Actors {
		if id != playerActorID && p == w.Fight.Opponent {
			npc = id
		}
	}
	opponent := cr.Profiles[w.Fight.Opponent]
	odds := func(s int) float64 {
		return cr.Rules.HitOdds(behavior.Combatant{Skill: s, Weapon: knife}, behavior.Combatant{Skill: opponent.Skill, Weapon: opponent.Weapon}, 0, false)
	}
	type game struct{ melee, knife, bare, gun, npc int }
	play := func(choice *pb.PocHeroFileChoice) game {
		if a := heroFileNew(t, r, c, choice); !a.Ok {
			t.Fatal(a.Message)
		}
		g := game{melee: r.state.Life.Development.Value(playerActorID, skill), knife: r.developedCombatSkill(profile, playerActorID, knife),
			bare: r.combatant(playerActorID, "hero").Skill, gun: r.developedCombatSkill(profile, playerActorID, needle)}
		if npc != "" {
			g.npc = r.combatant(npc, "enemy").Skill
		}
		return g
	}
	canon := play(nil)
	if canon.melee != profile.Develops.Base || canon.knife != profile.Skill || canon.bare != profile.Skill || canon.gun != profile.Skill {
		t.Fatalf("the hero of the book does not fight as tuned: %+v, profile %d, base %d", canon, profile.Skill, profile.Develops.Base)
	}
	strong := play(heroFileWith(w.Default, func(x *heroFileChoice) { x.Strengths = []string{w.Default.Strengths[0], skill} }))
	want := min(100, profile.Skill+strong.melee-profile.Develops.Base)
	if strong.melee != canon.melee+w.Strengths.Bonus || strong.knife != want || strong.bare != want || strong.gun != profile.Skill {
		t.Fatalf("a melee strength: %+v, want knife and bare hands %d, the needle %d", strong, want, profile.Skill)
	}
	if !(odds(strong.knife) > odds(canon.knife)) {
		t.Fatalf("the knife's chance does not rise: %.3f → %.3f", odds(canon.knife), odds(strong.knife))
	}
	if npc != "" && (canon.npc != opponent.Skill || strong.npc != opponent.Skill) {
		t.Fatalf("an NPC's skill moved with the hero's file: %d, %d, profile %d", canon.npc, strong.npc, opponent.Skill)
	}
	// the panel: the server's fight number before armor, without and with the strength
	v := r.heroFileView("ru", &pb.PocHeroFileRequest{})
	line := ""
	for _, s := range v.Skills {
		for _, g := range s.Give {
			if g.Kind == "fight" {
				if s.Id != skill {
					t.Fatalf("a fight line on %s", s.Id)
				}
				line = g.Text
			}
		}
	}
	pct := func(s int) string { return strconv.Itoa(int(math.Round(min(1, odds(s)) * 100))) }
	if want := strings.NewReplacer("{before}", pct(canon.knife), "{after}", pct(strong.knife)).Replace(r.localText("ru", w.Fight.Text, "")); line != want {
		t.Fatalf("the fight line %q, want %q", line, want)
	}
}

// The first review lapses at the end of the game's first night (06:00 of the first morning), offered or not.
func TestHeroFileFirstReviewLapsesAtTheFirstMorning(t *testing.T) {
	r, c := heroFileRuntime(t)
	w := r.world.HeroFile
	if a := heroFileNew(t, r, c, nil); !a.Ok {
		t.Fatal(a.Message)
	}
	end := r.heroFileFirstNightEnd()
	start := r.world.Life.StartSeconds
	if end <= start || end-start > 2*86400 || int(end%86400/3600) != w.Recheck.NightToH {
		t.Fatalf("the first night ends at %d (start %d)", end, start)
	}
	// never on the first check's level that night: lapsed, no notice, no review
	r.state.Life.Seconds = end
	r.heroFileBeforeFrame()
	if r.state.HeroFile.Recheck != "lapsed" {
		t.Fatalf("not lapsed: %q", r.state.HeroFile.Recheck)
	}
	msg := &pb.PocGameState{}
	r.appendHeroFileOffer(msg, "ru")
	if msg.HeroFileOffer != nil {
		t.Fatal("a lapsed review is still offered")
	}
	for i, action := range []string{"skip", "apply"} {
		id := "lapsed." + action
		choice := heroFileWith(r.state.HeroFile.Choice, func(x *heroFileChoice) { x.Profile = w.Profiles[len(w.Profiles)-1].ID })
		r.testCommand(c, input{msg: &pb.ClientMessage{Msg: &pb.ClientMessage_HeroFileCommand{HeroFileCommand: &pb.PocHeroFileCommand{Epoch: r.state.Epoch, RequestId: id, Action: action, Choice: choice}}}})
		if a := answer(t, c, id); a.Ok || a.Message != r.localText("ru", w.Text.NoRecheck, "") {
			t.Fatalf("a lapsed review answered %d: %+v", i, a)
		}
	}
	// offered and left open: it lapses all the same
	if a := heroFileNew(t, r, c, nil); !a.Ok {
		t.Fatal(a.Message)
	}
	r.state.HeroFile.Recheck = "offered"
	r.state.Life.Seconds = end
	r.heroFileBeforeFrame()
	if r.state.HeroFile.Recheck != "lapsed" {
		t.Fatalf("an open review did not lapse: %q", r.state.HeroFile.Recheck)
	}
}

// Tuned numbers load older saves (a retune at load): the hero's start, the inspection's observer and his fighters'
// wound relief and skill follow the file of this build; what he earned stays.
func TestHeroFileRetuneAtLoad(t *testing.T) {
	r, c := heroFileRuntime(t)
	w := r.world.HeroFile
	trait, effect := -1, -1
	for i, tr := range w.Traits {
		for j, e := range tr.Effects {
			if e.WoundAPRelief > 0 {
				trait, effect = i, j
			}
		}
	}
	if trait < 0 {
		t.Skip("no trait with a wound relief")
	}
	if a := heroFileNew(t, r, c, heroFileWith(w.Default, func(x *heroFileChoice) { x.Trait = w.Traits[trait].ID })); !a.Ok {
		t.Fatal(a.Message)
	}
	// the hero's fighter kept in the roster after a fight, his wound body with the wounds (as a fight leaves them)
	hero := r.combatant(playerActorID, "hero")
	r.storeWoundBody(hero)
	r.storeAmbientCombatCasualty(hero)
	if err := r.writeSave(r.world.Config.SaveSlots[1], r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave(r.world.Config.SaveSlots[1]); err != nil {
		t.Fatalf("the fixture's own save does not load: %v", err)
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	// this build: one more AP of relief, observation 10 lower and speech 10 higher in the profile (equal sums)
	relief := w.Traits[trait].Effects[effect].WoundAPRelief
	profile := -1
	for i, p := range w.Profiles {
		if p.ID == w.Default.Profile {
			profile = i
		}
	}
	first, second := "observation", "speech"
	if !heroFileHas(w.Skills, first) || !heroFileHas(w.Skills, second) {
		t.Skip("no observation and speech in the file")
	}
	skills := map[string]int{}
	for k, v := range w.Profiles[profile].Skills {
		skills[k] = v
	}
	original := w.Profiles[profile].Skills
	defer func() { w.Traits[trait].Effects[effect].WoundAPRelief, w.Profiles[profile].Skills = relief, original }()
	skills[first] -= 10
	skills[second] += 10
	w.Profiles[profile].Skills = skills
	w.Traits[trait].Effects[effect].WoundAPRelief = relief + 1
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatalf("a save of the earlier numbers does not load: %v", err)
	}
	start := w.start(loaded.HeroFile.Choice)
	if at := loaded.Life.Observer.Attributes[first]; at != start[first] || start[first] == r.state.Life.Development.Value(playerActorID, first) {
		t.Fatalf("the observer did not follow the retuned observation: %d, the file %d, before %d", at, start[first], r.state.Life.Development.Value(playerActorID, first))
	}
	for _, k := range []string{first, second} {
		if got := loaded.Life.Development.Value(playerActorID, k); got != start[k] {
			t.Fatalf("%s loads at %d, the file now starts it at %d", k, got, start[k])
		}
		if at, ok := loaded.Life.Observer.Attributes[k]; ok && at != start[k] {
			t.Fatalf("the observer sees %s %d, the hero has %d", k, at, start[k])
		}
	}
	if got := loaded.CombatRoster[playerActorID].WoundAPRelief; got != relief+1 {
		t.Fatalf("the hero's fighter shrugs off %d, the file now %d", got, relief+1)
	}
	if w.woundRelief(loaded.HeroFile) != relief+1 {
		t.Fatal("the loaded game's relief")
	}
}

func TestHeroFileReviewConfirmUsesItsOwnLocalizedText(t *testing.T) {
	r, _ := heroFileRuntime(t)
	file := r.world.HeroFile
	for _, locale := range []string{"ru", "en"} {
		open := r.localText(locale, file.Recheck.Do, "")
		review := r.localText(locale, file.Recheck.Confirm, "")
		draft := r.localText(locale, file.Text.Confirm, "")
		if review == "" || review == open || review == draft {
			t.Fatalf("%s: review confirm %q, open %q, new game confirm %q", locale, review, open, draft)
		}
		for mode, want := range map[string]string{"new": draft, "recheck": review} {
			if got := r.heroFileView(locale, &pb.PocHeroFileRequest{Mode: mode}).Confirm; got != want {
				t.Fatalf("%s/%s: confirm %q, want %q", locale, mode, got, want)
			}
		}
	}
}
