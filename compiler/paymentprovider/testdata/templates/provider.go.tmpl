func (pp *{{ .StructName }}) FetchBalances(mc *model.MerchantCreds, currencies []string) (*model.PaymentProviderBalanceResponse, error) {
	secrets, err := pp.parseProviderSecrets(mc, opBalance)
	if err != nil {
		return nil, err
	}
{{- if .UseMacanP2P }}
	path := endpointBalance
{{- if .UseOperationRuntime }}
	path = pp.operationEndpointPath("fetch_balances", path)
{{- end }}
	respBody, err := pp.httpClient.Get(common.FakeTxForBalanceFetch(ppSID), mc.ApiEndpoint+path, pp.authHeaders(secrets))
	if err != nil {
		return nil, fmt.Errorf("calling %s balance: %w", ppSID, err)
	}
	var resp macanBalanceResponse
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}
	out := &model.PaymentProviderBalanceResponse{}
	for _, cur := range currencies {
		if resp.Balance.Currency != cur {
			continue
		}
		out.Balances = append(out.Balances, model.PaymentProviderBalance{
			Currency:  cur,
			Available: helpers.FloatAmountToCoins(resp.Balance.Amount, cur),
		})
	}
	if len(out.Balances) == 0 && len(currencies) > 0 {
		return nil, fmt.Errorf("%s: balance currency %q not in requested %v", ppSID, resp.Balance.Currency, currencies)
	}
	return out, nil
{{- else }}
	_ = secrets

	// TODO: implement balance fetching
	return &model.PaymentProviderBalanceResponse{}, nil
{{- end }}
}
