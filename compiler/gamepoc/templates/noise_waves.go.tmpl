		for _, e := range r.state.Combat.Events {
			if e.Sequence > n.sequence {
				n.sequence = e.Sequence
			}
		}
		n.ready = true
		n.level = hero.Level
	}
	n.lastTick = tick
	r.noiseCombatEvents(hero)
	if hero.OnFloor() || r.heroInCombat() {
		for _, p := range n.pending {
			if p.level != hero.Level {
				continue
			}
			if w := r.noiseBuild(p, hero); w != nil {
				n.serial++
				w.Serial = n.serial
				n.waves = append(n.waves, w)
			}
		}
	}
	n.pending = n.pending[:0]
	age := int64(c.PublishS * float64(r.world.Config.TickHz))
	keep := n.waves[:0]
	for _, w := range n.waves {
		if tick-w.Tick <= age {
			keep = append(keep, w)
		}
	}
	n.waves = keep
	if over := len(n.waves) - max(1, c.MaxWaves); over > 0 {
		n.waves = append(n.waves[:0], n.waves[over:]...)
	}
	view.NoiseWaves = append([]*pb.PocNoiseWave(nil), n.waves...)
}
