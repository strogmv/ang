func TestTrainMotionAuthoredThreeLevelContinuity(t *testing.T) {
	r := lifeRuntimeFixture(t)
	c := r.world.TrainMotion
	if c == nil {
		t.Skip("world has no exterior train")
	}
	if len(c.Bindings) < 3 {
		t.Fatal("fewer than three physical level bindings")
	}
	ids := map[string]bool{}
	fleet := c.snapshots(0)
	period := c.length()/c.SpeedMPS + c.DwellSeconds
	for member := range fleet {
		initial := c.InitialDistanceM
		if member > 0 {
			initial = c.AdditionalFleet[member-1].InitialDistanceM
		}
		for _, binding := range c.Bindings {
			if _, ok := r.world.Life.Locations[binding.LevelID]; !ok {
				t.Fatal("unknown train level")
			}
			seconds := float64(c.EpochSeconds) + ((binding.StartM+binding.EndM)/2-initial)/c.SpeedMPS
			for seconds < float64(c.EpochSeconds) {
				seconds += period
			}
			train := c.snapshots(seconds)[member]
			visible := false
			for _, pose := range train.Modules[0].Bindings {
				if pose.LevelID == binding.LevelID {
					visible = pose.Visible
				}
			}
			if !visible || train.TrainID != fleet[member].TrainID || train.StockID != fleet[member].StockID {
				t.Fatalf("persistent stock did not reach %s", binding.LevelID)
			}
			ids[train.TrainID] = true
		}
	}
	if len(ids) != 1+len(c.AdditionalFleet) {
		t.Fatal("fleet stock duplicated or absent across rooms")
	}

}

func TestTrainMotionFastTravelUsesTheSameSavedPhysicalFrames(t *testing.T) {
	for _, rate := range []int64{1, 30} {
		r, edge := instantEdgeFixture(t, false, 0, 12345, rate)
		if r.world.TrainMotion == nil {
			t.Skip("world has no exterior train")
		}
		reference := &Runtime{world: r.world, state: r.snapshotState()}
		beforeNS := r.simNS()
		beforeLife := r.state.Life.Seconds
		if err := r.completeHeroTravel(); err != nil {
			t.Fatal(err)
		}
		replayInstantFrames(t, reference, edge.From)
		if r.simNS() <= beforeNS || r.state.Life.Seconds <= beforeLife {
			t.Fatal("fast travel did not advance the physical and calendar clocks")
		}
		actual := r.world.TrainMotion.snapshots(float64(r.simNS()) / 1e9)
		expected := reference.world.TrainMotion.snapshots(float64(reference.simNS()) / 1e9)
		if !reflect.DeepEqual(actual, expected) {
			t.Fatal("offscreen skip differs from ordinary physical-frame replay")
		}
	}
}
