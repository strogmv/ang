  // A witness who sees the hero during the offence window knows an incident even before any call.
  cause:="call";if !d.Issued{cause="offence"}
  a.Memory.Record(behavior.Fact{Subject:observation.SubjectID,Kind:"incident",Source:"sight",Cause:cause,Value:observation.Active||r.offenceVisible(),Position:observation.Position,ObservedTick:tick},mp)
  known:=r.world.Config.CaptureDemo.KnownFacts
