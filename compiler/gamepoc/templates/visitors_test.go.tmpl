	if most < 2 || len(ate) == 0 {
		t.Fatalf("lunch at the tables: at most %d eating, what %v", most, ate)
	}
	// the view: phase eat, facing the table, the meal and where it stands
	view := &pb.PocLifeView{}
	hero := r.state.Life.Actor(playerActorID)
	if hero != nil {
