// Offscreen simplification changes cadence, not which sides of a wall connect.
// Reopening a passage and save/load must allow exactly the same eventual trip.
func TestPopulationColdLegHonorsTopologyAndResumes(t *testing.T){
 p,l,s:=populationSplitFloorFixture();p.Anchors["a"]=[]Cell{{5,1}}
 for tick:=int64(1);tick<=3;tick++{
  populationAdvance(t,&s,p,l,tick*10,tick,"",PopulationEnvironment{})
  a:=s.Actors[0];if a.Position!=(Cell{0,1})||a.Materialized||len(a.Path)>0||a.Arrived||a.Activity!="waiting_route"{t.Fatalf("coarse resident crossed disconnected floor: %+v",a)}
 }
 raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var restored PopulationState;if err=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)}
 room:=l.Locations["a"];room.Terrain=[]string{"...#...",".......","...#..."};l.Locations["a"]=room
 for tick:=int64(4);tick<=7;tick++{
  populationAdvance(t,&s,p,l,tick*10,tick,"",PopulationEnvironment{})
  populationAdvance(t,&restored,p,l,tick*10,tick,"",PopulationEnvironment{})
  if !reflect.DeepEqual(s.Clone(),restored.Clone()){t.Fatal("reopened topology diverged after save/load")}
 }
 if !s.Actors[0].Arrived||s.Actors[0].Position!=(Cell{5,1}){t.Fatalf("reopened passage did not resume coarse itinerary: %+v",s.Actors[0])}
}

func TestPopulationAcceptedPathRechecksTopology(t *testing.T){
 p,l,s:=populationSplitFloorFixture();p.Anchors["a"]=[]Cell{{2,1}};s.ActiveLevel="a";a:=&s.Actors[0]
 a.Materialized=true;a.Goal=Cell{2,1};a.Path=[]Cell{{1,1},{2,1}}
 room:=l.Locations["a"];room.Terrain=[]string{"...#...",".#.#...","...#..."};l.Locations["a"]=room
 previous:=a.Position
 for tick:=int64(1);tick<=20;tick++{
  populationAdvance(t,&s,p,l,tick,tick,"a",PopulationEnvironment{})
  if !l.Walks(a.Level,a.Position)||Distance(previous,a.Position)>1{t.Fatal("cached population segment crossed closed floor")};previous=a.Position
  if a.Arrived{break}
 }
 if !a.Arrived||a.Position!=(Cell{2,1}){t.Fatalf("population did not take supported alternative path: %+v",a)}
}

func TestPopulation500CommuteRemainsDeterministicAndBounded(t *testing.T){
 p,l:=populationFixture();p.MaxActors=500
 s,err:=p.Start(l,500,0,0);if err!=nil{t.Fatal(err)}
 populationAdvance(t,&s,p,l,1,1,"a",PopulationEnvironment{})
 initial:=s.Clone();raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var saved PopulationState;if err=json.Unmarshal(raw,&saved);err!=nil{t.Fatal(err)}
 moved:=false
 for tick:=int64(2);tick<=64;tick++{
  populationAdvance(t,&s,p,l,28800+tick,tick,"a",PopulationEnvironment{})
  populationAdvance(t,&saved,p,l,28800+tick,tick,"a",PopulationEnvironment{})
  if !reflect.DeepEqual(s.Clone(),saved.Clone()){t.Fatalf("500 residents diverged after save/load at tick %d",tick)}
  active:=0;for i,a:=range s.Actors{if a.Materialized{active++;if initial.Actors[i].Materialized&&a.Position!=initial.Actors[i].Position{moved=true}}else if len(a.Path)>0{t.Fatal("coarse resident allocated physical route")}}
  if len(s.Actors)!=500||active>p.MaxActive{t.Fatal("population identity or physical budget changed")}
 }
 if !moved{t.Fatal("500 resident scenario did not exercise actual local movement")}
}

// This is a server simulation measurement, not a Unity frame-rate claim.
// Every 128 ticks replay a commuting burst, including bounded admission and
// path work; do not measure only a settled room of sleeping residents.
func BenchmarkPopulation500Commute(b *testing.B){
 for _,level:=range []string{"","a"}{b.Run(fmt.Sprintf("active=%t",level!=""),func(b *testing.B){
  p,l:=populationFixture();p.MaxActors=500;s,err:=p.Start(l,500,0,0);if err!=nil{b.Fatal(err)}
  if err=s.Advance(p,l,1,1,level,PopulationEnvironment{});err!=nil{b.Fatal(err)};initial:=s.Clone()
  b.ReportAllocs();b.ResetTimer()
  for i:=0;i<b.N;i++{if i%128==0{s=initial.Clone()};tick:=int64(i%128+2);if err=s.Advance(p,l,28800+tick,tick,level,PopulationEnvironment{});err!=nil{b.Fatal(err)}}
 })}
}

