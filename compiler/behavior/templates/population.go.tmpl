 if len(route)==0{populationUnreserve(claims,a.Level,pocket,a.ID);return a.Position,true}
 lead:=int64(len(route))*p.MoveTicks*secondsPerTick+secondsPerTick
 if a.WaitingDeparture==0{
  if a.Position!=pocket{return pocket,false}
  a.WaitingDeparture=edge.NextDeparture(seconds+lead+edge.BoardingLeadSeconds)
