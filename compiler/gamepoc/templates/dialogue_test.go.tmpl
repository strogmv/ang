func TestDialogueInnerVoiceNeedsItsSkill(t *testing.T) {
	probe := dialogueCustody(t, nil)
	var v convVoice
	for _, voice := range custodyNode(t, probe).Voices {
		if voice.When == nil && len(voice.Variants) == 0 {
			v = voice
			break
		}
	}
	if v.ID == "" {
		t.Skip("no plain inner voice")
	}
	for _, skill := range []int{v.AtLeast, v.AtLeast - 1} {
		if skill < 0 {
			continue
		}
		r := dialogueCustody(t, func(r *Runtime) { dialogueSetSkill(r, v.Skill, skill) })
		found := false
		for _, line := range dialogueView(t, r, "ru").Lines {
			if line.Kind == "voice" && line.Text == r.localText("ru", v.Text, "") {
				name, colour := r.dialogueSkillTag("ru", v.Skill)
				if line.Name != name || line.Colour != colour {
					t.Fatalf("voice shown as %+v", line)
				}
				found = true
			}
		}
		if found != (skill >= v.AtLeast) {
			t.Fatalf("skill %d, threshold %d: voice %v", skill, v.AtLeast, found)
		}
	}
}

func TestDialogueSaveAndLoadInTheMiddleOfTheConversation(t *testing.T) {
	r := dialogueCustody(t, nil)
	questions := custodyQuestions(t, r)
	for _, q := range questions {
		if err := choose(r, q.ID); err != nil {
			t.Fatal(err)
		}
	}
	view := dialogueView(t, r, "ru")
	for _, q := range questions {
		if o := dialogueOption(t, view, q.ID); o == nil || !o.Seen {
			t.Fatalf("an asked question is not dimmed: %+v", o)
		}
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(r.state.CalendarEncounter, loaded.CalendarEncounter) || !reflect.DeepEqual(r.state.Memory, loaded.Memory) || loaded.CheckSeed != r.state.CheckSeed {
		t.Fatal("the conversation, the memory or the game's check value changed in the save")
	}
	other := encounterFixture(t)
	other.state = loaded
	a, _ := json.Marshal(view)
	b, _ := json.Marshal(dialogueView(t, other, "ru"))
	if string(a) != string(b) {
		t.Fatalf("the loaded conversation shows differently:\n%s\n%s", a, b)
	}
	if err := choose(other, r.world.CalendarEncounter.Choices[0].ID); err != nil {
		t.Fatalf("the loaded conversation cannot go on: %v", err)
	}
	// a saved answer that no longer exists: the load keeps the game and drops that talk (it starts again)
	// One-shot history is saved independently of the current log (N6).
	key := custodyKey(r)
	history := r.state.Memory.Once[key]
	history.Chosen = append(history.Chosen, "answer_removed")
	r.state.Memory.Once[key] = history
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err = r.readSave(slot)
	if err != nil {
		t.Fatalf("a save with a removed answer did not load: %v", err)
	}
	if loaded.Memory.Talks[custodyKey(r)] != nil || loaded.Memory.Open != "" {
		t.Fatal("a talk naming a removed answer was kept")
	}
	for _, q := range questions {
		if !memoryIn(loaded.Memory.Once[key].Chosen, q.ID) {
			t.Fatalf("surviving answer %s lost with the flow", q.ID)
		}
	}
}

func TestDialogueCustodyViewIsReadOnlyAndComplete(t *testing.T) {
	r := dialogueCustody(t, nil)
	d := custodyConv(r)
	entry := d.Entries[len(d.Entries)-1]
	if custodyTalk(r).Entry != entry.ID {
		t.Fatalf("a stranger's custody opened by %s, want the usual %s", custodyTalk(r).Entry, entry.ID)
	}
	before, _ := json.Marshal(r.snapshotState())
	questions := custodyQuestions(t, r)
	for _, locale := range []string{"ru", "en"} {
		v := dialogueView(t, r, locale)
		if v.Leave || v.SpeakerColour == "" || len(v.Lines) < len(entry.Lines) || len(v.Choices) < len(questions)+1 {
			t.Fatalf("%s: incomplete custody view: %+v", locale, v)
		}
		for i, l := range entry.Lines {
			if v.Lines[i].Kind != "line" || v.Lines[i].Speaker != l.Speaker || v.Lines[i].Name == "" || v.Lines[i].Colour == "" || v.Lines[i].Text != r.localText(locale, l.Text, "") {
				t.Fatalf("%s: opening line %d shown as %+v", locale, i, v.Lines[i])
			}
		}
		for i, q := range questions {
			if v.Choices[i].Id != q.ID || v.Choices[i].Action != "conversation_choice" {
				t.Fatalf("%s: questions come first: %+v", locale, v.Choices[i])
			}
		}
	}
	if after, _ := json.Marshal(r.snapshotState()); string(before) != string(after) {
		t.Fatal("the conversation view changed the world")
	}
}

