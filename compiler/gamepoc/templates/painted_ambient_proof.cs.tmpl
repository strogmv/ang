     ambientProofIndex++;Options(false,1);proofPhase=9;break;
    case 8:if(!state.Paused&&state.Life.SecondsPerTick==1){proofPhase=4;}break;
    case 9:if(!state.Paused){LifeCommand("rate","",30);LifeCommand("goto",ambientProofLevels[ambientProofIndex]);proofPhase=2;}break;
