 if i:=r.demoAgentIndex(d.Coordination.SpeakerID);i>=0{a:=d.Agents[i];canAddress=a.Reaction.Awareness.Known&&a.Reaction.Awareness.Active&&manhattan(a.Position,r.state.Player)<=r.world.AI.Policy.Social.HearingRange&&r.sceneVisible(cell(a.Position),cell(r.state.Player))}
 if !d.Captured&&d.Coordination.TryOpening(r.world.AI.Policy.Coordination,r.state.Tick,canAddress,d.TargetAlive){r.demoEvent(d.Agents[r.demoAgentIndex(d.Coordination.OfferedBy)].Name+": «"+d.Coordination.Utterance+"»")}
 for _,m:=range members{controlled[m.ID]=true}
 if !d.Captured&&d.Plan.Status!="failed"{
  target:=cell(d.Call);latest:=int64(-1)
  for _,a:=range d.Agents{if controlled[a.ID]&&a.Reaction.Awareness.Known&&a.Reaction.Awareness.ObservedTick>latest{target=a.Reaction.Awareness.Position;latest=a.Reaction.Awareness.ObservedTick}}
  // Bystanders are not obstacles for assembly planning: a member whose route meets one asks it
  // to step aside (existing yield rule); only the hero, the group itself and immovable actors block.
  space:=r.sceneSpace(controlled)
