    if !picked[d.ID]||p.Phase!=""||len(p.Cargo)!=0||!a.OnFloor()||len(a.Path)!=0||a.Level!=d.Dropoff.Level||a.Position.X!=d.Dropoff.At.X||a.Position.Y!=d.Dropoff.At.Y||rec.ShopAfter!=rec.ShopBefore+3{t.Fatal("dropoff did not physically add exactly the carried consignment")}
