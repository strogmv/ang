// ANG barks v2 (doc 94 §4): the speaker's contour while his line is on screen — never a standing glow. Drawn by shell
// renderers that share the body's skin (same mesh and bones), enabled only while the line lives and faded with it:
//   Rim     (UniversalForward): an inverted hull _Width screen pixels wide where the body itself is seen;
//   Through (SRPDefaultUnlit):  where the body is hidden (the yatai strips, a wall, a counter) a faint figure with a brighter
//                               rim, so the thread of the line lands on somebody the eye can find.
Shader "ANG/BarkSpeaker" {
 Properties {_Color ("Colour",Color)=(1,.8,.5,1) _Width ("Rim, px",Float)=2}
 SubShader { Tags {"Queue"="Transparent+20" "RenderType"="Transparent" "RenderPipeline"="UniversalPipeline" "IgnoreProjector"="True"}
  HLSLINCLUDE
  #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
  CBUFFER_START(UnityPerMaterial)
  float4 _Color;float _Width;
  CBUFFER_END
  struct appdata {float4 vertex:POSITION;float3 normal:NORMAL;};
  ENDHLSL
  Pass { Name "Rim" Tags {"LightMode"="UniversalForward"}
   Cull Front ZWrite Off ZTest LEqual Blend SrcAlpha OneMinusSrcAlpha
   HLSLPROGRAM
   #pragma vertex vert
   #pragma fragment frag
   struct v2f {float4 pos:SV_POSITION;};
   v2f vert(appdata v){
    v2f o;float4 p=TransformObjectToHClip(v.vertex.xyz);
    float2 d=TransformWorldToHClipDir(TransformObjectToWorldNormal(v.normal)).xy;float l=length(d);d=l>1e-5?d/l:float2(0,0);
    p.xy+=d*_Width*2/_ScreenParams.xy*p.w;o.pos=p;return o;
   }
   half4 frag(v2f i):SV_Target{return half4(_Color.rgb,_Color.a);}
   ENDHLSL
  }
  Pass { Name "Through" Tags {"LightMode"="SRPDefaultUnlit"}
   Cull Back ZWrite Off ZTest Greater Blend SrcAlpha OneMinusSrcAlpha
   HLSLPROGRAM
   #pragma vertex vert
   #pragma fragment frag
   struct v2f {float4 pos:SV_POSITION;float3 n:TEXCOORD0;float3 v:TEXCOORD1;};
   v2f vert(appdata v){
    v2f o;float3 w=TransformObjectToWorld(v.vertex.xyz);o.pos=TransformWorldToHClip(w);o.n=TransformObjectToWorldNormal(v.normal);
    o.v=GetWorldSpaceNormalizeViewDir(w);return o;
   }
   half4 frag(v2f i):SV_Target{float rim=1-saturate(dot(normalize(i.n),normalize(i.v)));return half4(_Color.rgb,_Color.a*(.16+.55*rim*rim));}
   ENDHLSL
  }
 }
}
