func worldAuditRuntime(t testing.TB, count int) *Runtime {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	if worldAuditRuntimeOverride != nil {
		worldAuditRuntimeOverride(r)
	}
	life, err := r.world.Life.StartWithPopulation(count, playerActorID)
	if err != nil {
		t.Fatal(err)
	}
	r.state.Seed = r.world.Config.Seed
	if v := os.Getenv("NPC_WORLD_REPORT_SEED"); v != "" {
		seed, err := strconv.ParseInt(v, 10, 64)
		if err != nil {
			t.Fatal(err)
		}
		r.state.Seed = seed
	}
	r.state.Active = true
	r.state.Speed = 1
	r.initLifeState(life)
	r.state.Life.SecondsPerTick = 1
	r.state.Life.Actor(playerActorID).Manual = os.Getenv("NPC_WORLD_REPORT_HERO_AUTO") == ""
	return r
}

func worldPct(xs []float64, p float64) float64 {
	if len(xs) == 0 {
		return 0
	}
	s := append([]float64(nil), xs...)
	sort.Float64s(s)
	i := int(p * float64(len(s)-1))
	return s[i]
}

func worldMean(xs []float64) float64 {
	if len(xs) == 0 {
		return 0
	}
	t := 0.0
	for _, x := range xs {
		t += x
	}
	return t / float64(len(xs))
}

func worldLifeHash(r *Runtime) string {
	b, _ := json.Marshal(struct {
		L behavior.LifeState
		I any
	}{r.state.Life.Clone(), r.state.Inventory})
	h := sha256.Sum256(b)
	return hex.EncodeToString(h[:])
}

type worldAcc struct {
	kind     string
	acts     map[string]int64
	levels   map[string]bool
	cells    map[string]bool
	moved    int
	yields   int
	trans    int
	lastAct  string
	lastPos  behavior.Cell
	lastLvl  string
	yielding bool
}

func worldNewAcc(kind string) *worldAcc {
	return &worldAcc{kind: kind, acts: map[string]int64{}, levels: map[string]bool{}, cells: map[string]bool{}}
}

func (a *worldAcc) observe(level, activity string, pos behavior.Cell, yielding bool, dt int64) {
	a.acts[activity] += dt
	a.levels[level] = true
	a.cells[fmt.Sprintf("%s/%d/%d", level, pos.X, pos.Y)] = true
	if a.lastLvl == level && pos != a.lastPos {
		a.moved += behavior.Distance(a.lastPos, pos)
	}
	if activity != a.lastAct && a.lastAct != "" {
		a.trans++
	}
	if yielding && !a.yielding {
		a.yields++
	}
	a.lastAct, a.lastPos, a.lastLvl, a.yielding = activity, pos, level, yielding
}

func (a *worldAcc) out(id string) worldAuditActor {
	lv := []string{}
	for l := range a.levels {
		lv = append(lv, l)
	}
	sort.Strings(lv)
	return worldAuditActor{ID: id, Kind: a.kind, ActivitySeconds: a.acts, Levels: lv, DistinctCells: len(a.cells), CellsMoved: a.moved, Yields: a.yields, Transitions: a.trans}
}

// coarse activity class (strip "Идёт:"-style labels; use Activity field)
func worldStockByDefinition(r *Runtime) map[string]int64 {
	out := map[string]int64{}
	for _, item := range r.state.Inventory.Items {
		out[item.Definition] += item.Quantity
	}
	return out
}
func worldNPCHeldUnits(r *Runtime) int64 {
	var n int64
	for _, item := range r.state.Inventory.Items {
		if item.Location.Kind != "store" {
			continue
		}
		store, ok := r.state.Inventory.Stores[item.Location.Store]
		if ok && store.Kind == "actor" && store.Anchor.Actor != playerActorID {
			n += item.Quantity
		}
	}
	return n
}
func worldWorkerIDs(ids map[string]bool) []string {
	out := make([]string, 0, len(ids))
	for id := range ids {
		out = append(out, id)
	}
	sort.Strings(out)
	return out
}
func worldCheckWorkerAttendance(t testing.TB, rep worldAuditReport, days int) {
	t.Helper()
	if rep.ExpectedWorkers < 1 || rep.ExpectedWorkers != len(rep.ExpectedWorkerIDs) || len(rep.WorkersPerDay) != days || len(rep.AttendedWorkerIDs) != days {
		t.Fatalf("invalid authored duty roster or incomplete attendance: expected=%v attended=%v", rep.ExpectedWorkerIDs, rep.AttendedWorkerIDs)
	}
	for day, ids := range rep.AttendedWorkerIDs {
		if rep.WorkersPerDay[day] != rep.ExpectedWorkers || !reflect.DeepEqual(ids, rep.ExpectedWorkerIDs) {
			t.Fatalf("day %d duty attendance differs from authored obligations: got=%v expected=%v", day+1, ids, rep.ExpectedWorkerIDs)
		}
	}
}
func worldCheckStockAccounting(t testing.TB, rep worldAuditReport) {
	t.Helper()
	if rep.StockDelta != -(rep.FoodConsumed + rep.OtherConsumed) {
		t.Fatalf("stock consumption mismatch: delta=%d food=%d other=%d by_definition=%v", rep.StockDelta, rep.FoodConsumed, rep.OtherConsumed, rep.StockDeltasByDefinition)
	}
	if rep.NPCPurchases != rep.FoodConsumed+rep.OtherConsumed+rep.RetainedPurchaseUnits {
		t.Fatalf("purchased units neither consumed nor retained: purchases=%d food=%d other=%d retained=%d", rep.NPCPurchases, rep.FoodConsumed, rep.OtherConsumed, rep.RetainedPurchaseUnits)
	}
}
func worldRunAuditDay(t testing.TB, count int, seconds int64, compareDay2 bool) worldAuditReport {
	r := worldAuditRuntime(t, count)
	rate := int64(1)
	if v := os.Getenv("NPC_WORLD_REPORT_RATE"); v != "" {
		n, e := strconv.ParseInt(v, 10, 64)
		if e != nil || (n != 1 && n != 10 && n != 30) {
			t.Fatal("rate must be 1,10,30")
		}
		rate = n
	}
	r.state.Life.SecondsPerTick = rate
	unexpectedClosed := int64(0)
	breakSeconds := map[string]int64{}
	longestBreak := map[string]int64{}
	breakRuns := map[string]int64{}
	failures := []string{}
	start := r.state.Life.Seconds
	invStart := r.state.Inventory.Revision
	stockStart := commerceTotal(r.state.Inventory)
	moneyStart := npcMoney(r)
	peakHunger := int64(0)
	workers := map[string]bool{}
	attended := map[string]bool{}
	workersPerDay := []int{}
	purchasesPerDay := []int64{}
	previousPurchases := int64(0)
	stockDefinitionsStart := worldStockByDefinition(r)
	heldStart := worldNPCHeldUnits(r)
	attendedIDs := [][]string{}
	// Food counters deliberately exclude drinks (e.g. the yatai's food:false
	// tea). Only definitions explicitly consumed by a brain service may vanish.
	consumables := map[string]bool{}
	crafted := r.craftingContractDefinitions()
	for _, id := range r.world.Life.Brain.FoodDefinitions {
		consumables[id] = true
	}
	for _, place := range r.world.Life.Brain.Places {
		if place.Seating != nil {
			for _, item := range place.Seating.Items {
				if old, ok := consumables[item.Definition]; ok && old != item.Food {
					t.Fatalf("inconsistent consumption contract for %s", item.Definition)
				}
				consumables[item.Definition] = item.Food
			}
		}
	}
	if r.world.Life.Brain.Enabled {
		for _, p := range r.world.Life.Actors {
			if p.ID == playerActorID {
				continue
			}
			for _, step := range p.Steps {
				if step.Activity == "work" || step.Activity == "service" || step.Activity == "post" || step.Obligation {
					workers[p.ID] = true
				}
			}
		}
		for _, a := range r.state.Life.Population.Actors {
			if a.Profile != nil && a.Profile.Work != nil {
				for _, p := range r.world.Life.Population.Profiles {
					if p.ID == a.Profile.DefinitionID && p.Work.Activity == "work" {
						workers[a.ID] = true
					}
				}
			}
		}
	}
	balances := map[string]int64{}
	for id, a := range r.state.Inventory.Accounts {
		b, _ := json.Marshal(a)
		balances[id] = int64(len(b))
		_ = b
	}
	accStart, _ := json.Marshal(r.state.Inventory.Accounts)
	accs := map[string]*worldAcc{}
	order := []string{}
	dur := make([]float64, 0, seconds)
	hourDur := map[int][]float64{}
	hourActive := map[int]int{}
	hourWalking := map[int]int{}
	queue := map[string]int64{}
	// day1/day2 timelines: sample every 60s
	timeline := map[string][]string{}
	checkpoints := []worldCheckpoint{}
	began := time.Now()
	for r.state.Life.Seconds < start+seconds {
		r.state.Tick++
		t0 := time.Now()
		if err := r.advanceLifeFrameBy(rate); err != nil {
			t.Fatal(err)
		}
		d := float64(time.Since(t0).Nanoseconds()) / 1000
		for _, sh := range r.world.Inventory.Shopfronts {
			if sh.Mobile() {
				continue // demo-hub v23: a peddler's shop is shut while he walks between his stops (peddlers tests hold the round)
			}
			clock := r.state.Life.Seconds % 86400
			status := r.state.Inventory.Shopfronts[sh.ID]
			a := r.state.Life.Actor(sh.Owner)
			// demo-hub v14-traders: each shop is held to its own trading hours inside the market day (07-22), not to 07-22 itself
			from, to := max(sh.OpenSecond, 7*3600), min(sh.CloseSecond, 22*3600)
			if clock >= from && clock < to && !status.Open {
				if !status.Break {
					unexpectedClosed += rate
					if len(failures) < 12 {
						failures = append(failures, fmt.Sprintf("%d %s %s %s %s %v", r.state.Life.Seconds, sh.ID, a.Level, a.Activity, a.Brain.Goal.GoalID, a.Position))
					}
				}
				if status.Break {
					breakSeconds[sh.ID] += rate
					breakRuns[sh.ID] += rate
					if breakRuns[sh.ID] > longestBreak[sh.ID] {
						longestBreak[sh.ID] = breakRuns[sh.ID]
					}
					limit := r.world.Life.Brain.LunchSeconds
					if a.Brain.BreakKind == "hygiene" {
						limit = r.world.Life.Brain.HygieneSeconds
					}
					if r.state.Life.Seconds-a.Brain.BreakStarted > limit {
						unexpectedClosed += rate
						if len(failures) < 12 {
							failures = append(failures, fmt.Sprintf("overlong break second=%d shop=%s actor=%s kind=%s started=%d until=%d return_at=%d returning=%t elapsed=%d budget=%d level=%s activity=%s goal=%s at=%v", r.state.Life.Seconds, sh.ID, a.ID, a.Brain.BreakKind, a.Brain.BreakStarted, a.Brain.BreakUntil, a.Brain.BreakReturnAt, a.Brain.Returning, r.state.Life.Seconds-a.Brain.BreakStarted, limit, a.Level, a.Activity, a.Brain.Goal.GoalID, a.Position))
						}
					}
				}
			} else {
				breakRuns[sh.ID] = 0
			}
		}
		dur = append(dur, d)
		if (r.state.Life.Seconds-start)%3600 == 0 {
			if err := r.state.Life.Validate(r.world.Life, r.state.Tick); err != nil {
				t.Fatal(err)
			}
			checkpoints = append(checkpoints, worldCheckpoint{r.state.Life.Seconds - start, worldLifeHash(r)})
		}
		hour := int((r.state.Life.Seconds % 86400) / 3600)
		hourDur[hour] = append(hourDur[hour], d)
		if r.state.Life.Seconds%10 != 0 {
			continue
		}
		dt := int64(10)
		if rate > dt {
			dt = rate
		}
		if r.world.Life.Brain.Enabled {
			record := func(id, activity string, arrived bool, b behavior.LifeBrain) {
				if id == playerActorID {
					return
				}
				if b.Needs[0] > peakHunger {
					peakHunger = b.Needs[0]
				}
				if workers[id] && arrived && (activity == "work" || activity == "service" || activity == "post" || activity == "maintenance" || b.Target.Obligation && b.Goal.GoalID == "schedule") {
					attended[id] = true
				}
			}
			for _, a := range r.state.Life.Actors {
				record(a.ID, a.Activity, a.Arrived, a.Brain)
			}
			for _, a := range r.state.Life.Population.Actors {
				record(a.ID, a.Activity, a.Arrived, a.Brain)
			}
			if (r.state.Life.Seconds-start)%86400 == 0 {
				purchasesPerDay = append(purchasesPerDay, r.state.NPCEconomy.Purchases-previousPurchases)
				previousPurchases = r.state.NPCEconomy.Purchases
				workersPerDay = append(workersPerDay, len(attended))
				attendedIDs = append(attendedIDs, worldWorkerIDs(attended))
				attended = map[string]bool{}
			}
		}
		active, walking := 0, 0
		for _, a := range r.state.Life.Actors {
			if a.ID == playerActorID {
				continue
			}
			x := accs[a.ID]
			if x == nil {
				x = worldNewAcc("named")
				accs[a.ID] = x
				order = append(order, a.ID)
			}
			lvl := a.Level
			if a.Trip != nil {
				lvl = "trip:" + a.Trip.Edge
			}
			act := a.Activity
			if act == "" {
				act = "none"
			}
			x.observe(lvl, act, a.Position, a.Activity == "yielding", dt)
			if strings.HasPrefix(act, "walk") || len(a.Path) > 0 {
				walking++
			}
			if r.state.Life.Seconds%60 == 0 {
				timeline[a.ID] = append(timeline[a.ID], lvl+"|"+act)
			}
		}
		for _, a := range r.state.Life.Population.Actors {
			x := accs[a.ID]
			if x == nil {
				x = worldNewAcc("population")
				accs[a.ID] = x
				order = append(order, a.ID)
			}
			lvl := a.Level
			if a.Trip != nil {
				lvl = "trip:" + a.Trip.Edge
			}
			act := a.Activity
			if act == "" {
				act = "none"
			}
			x.observe(lvl, act, a.Position, a.YieldUntil > r.state.Tick, dt)
			if a.Materialized {
				active++
				if len(a.Path) > 0 {
					walking++
				}
			}
			if a.QueueReason != "" {
				queue[a.QueueReason]++
			}
			if r.state.Life.Seconds%60 == 0 {
				timeline[a.ID] = append(timeline[a.ID], lvl+"|"+act)
			}
		}
		if active > hourActive[hour] {
			hourActive[hour] = active
		}
		if walking > hourWalking[hour] {
			hourWalking[hour] = walking
		}
	}
	rep := worldAuditReport{CalendarRate: rate, ShopUnexpectedClosed: unexpectedClosed, ShopBreakSeconds: breakSeconds, ShopLongestBreak: longestBreak, ShopFailures: failures,
		Seed: r.state.Seed, MaxActive: r.world.Life.Population.MaxActive, HeroAutomatic: os.Getenv("NPC_WORLD_REPORT_HERO_AUTO") != "",
		Checkpoints: checkpoints, NamedDecisionCount: r.state.Life.Decisions.Total, PopulationDecisionCount: r.state.Life.Population.Decisions.Total,
		Interactions: map[string]int64{"account_balance_changes": 0},
		Scope:        "real Runtime.advanceLifeFrameBy (Life + population + supply + practice), calendar 1 s/tick; wall time, single goroutine; observer mode in hero_automatic",
		ContentHash:  r.world.ContentHash, Population: count, GameSeconds: seconds, Ticks: int64(len(dur)),
		WallSeconds: time.Since(began).Seconds(),
		TickP50US:   worldPct(dur, .5), TickP95US: worldPct(dur, .95), TickP99US: worldPct(dur, .99), TickMaxUS: worldPct(dur, 1), TickMeanUS: worldMean(dur),
		DistinctActivityCounts: map[int]int{}, ActivityTotals: map[string]int64{}, PopulationAggregates: map[string]float64{},
		InventoryRevisionStart: invStart, InventoryRevisionEnd: r.state.Inventory.Revision, QueueReasons: queue,
		HeroRelationOverrides: r.state.Life.RelationOverrides,
	}
	accEnd, _ := json.Marshal(r.state.Inventory.Accounts)
	if string(accStart) != string(accEnd) {
		rep.AccountBalancesChanged = 1
		rep.Interactions["account_balance_changes"] = 1
	}
	for h := 0; h < 24; h++ {
		xs := hourDur[h]
		if len(xs) == 0 {
			continue
		}
		rep.Hours = append(rep.Hours, worldAuditHour{Hour: h, P50US: worldPct(xs, .5), P95US: worldPct(xs, .95), P99US: worldPct(xs, .99), MaxUS: worldPct(xs, 1), MeanUS: worldMean(xs), MaxActive: hourActive[h], WalkingMax: hourWalking[h]})
	}
	var popActs, popLevels, popMoved, popYields, popTrans, popN float64
	for _, id := range order {
		x := accs[id]
		o := x.out(id)
		meaningful := 0
		for act := range o.ActivitySeconds {
			rep.ActivityTotals[act] += o.ActivitySeconds[act]
			if !strings.HasPrefix(act, "waiting") && act != "walking" && act != "walking_coarse" && act != "transit" && act != "yielding" && act != "none" {
				meaningful++
			}
		}
		rep.DistinctActivityCounts[meaningful]++
		if x.kind == "named" {
			rep.NamedSummary = append(rep.NamedSummary, o)
		} else {
			popN++
			popActs += float64(meaningful)
			popLevels += float64(len(o.Levels))
			popMoved += float64(o.CellsMoved)
			popYields += float64(o.Yields)
			popTrans += float64(o.Transitions)
			if len(rep.PopulationSample) < 6 || strings.HasSuffix(id, "050") || strings.HasSuffix(id, "150") {
				rep.PopulationSample = append(rep.PopulationSample, o)
			}
		}
	}
	rep.PurchasesPerDay = purchasesPerDay
	rep.StockDelta = commerceTotal(r.state.Inventory) - stockStart
	rep.NPCPurchases = r.state.NPCEconomy.Purchases
	rep.WageSource = r.state.NPCEconomy.WageSource
	rep.MoneyDelta = npcMoney(r) - moneyStart
	rep.FoodConsumed = r.state.NPCEconomy.FoodConsumed
	rep.PeakHunger = peakHunger
	rep.ExpectedWorkers = len(workers)
	rep.WorkersPerDay = workersPerDay
	rep.ExpectedWorkerIDs = worldWorkerIDs(workers)
	rep.AttendedWorkerIDs = attendedIDs
	rep.RetainedPurchaseUnits = worldNPCHeldUnits(r) - heldStart
	rep.StockDeltasByDefinition = map[string]int64{}
	stockDefinitionsEnd := worldStockByDefinition(r)
	for id := range stockDefinitionsEnd {
		if _, ok := stockDefinitionsStart[id]; !ok {
			stockDefinitionsStart[id] = 0
		}
	}
	var consumedFood int64
	for id, before := range stockDefinitionsStart {
		delta := stockDefinitionsEnd[id] - before
		if delta == 0 {
			continue
		}
		if crafted[id] {
			// crafting (doc 93): parts spent, things salvaged, products made — authored by the CUE recipes
			rep.Interactions["crafting_units_delta"] += delta
			rep.StockDelta -= delta
			continue
		}
		rep.StockDeltasByDefinition[id] = delta
		food, allowed := consumables[id]
		if delta > 0 || !allowed {
			t.Fatalf("inventory units appeared/disappeared outside an authored consumption contract: %s delta=%d", id, delta)
		}
		if food {
			consumedFood -= delta
		} else {
			rep.OtherConsumed -= delta
		}
	}
	if consumedFood != rep.FoodConsumed {
		t.Fatalf("food counter differs from physical item depletion: physical=%d counter=%d by_definition=%v", consumedFood, rep.FoodConsumed, rep.StockDeltasByDefinition)
	}
	var soldUnits, sellerTurnover int64
	for _, n := range r.state.NPCEconomy.UnitsBySeller {
		soldUnits += n
	}
	for _, n := range r.state.NPCEconomy.BySeller {
		sellerTurnover += n
	}
	if soldUnits != rep.NPCPurchases || sellerTurnover != r.state.NPCEconomy.Turnover {
		t.Fatal("seller sales ledger differs from purchases/turnover")
	}
	rep.NamedActors = len(rep.NamedSummary)
	rep.Interactions["population_yield_starts_sampled"] = int64(popYields)
	rep.Interactions["inventory_revisions"] = int64(rep.InventoryRevisionEnd - rep.InventoryRevisionStart)
	for _, actor := range rep.NamedSummary {
		rep.Interactions["named_yield_starts_sampled"] += int64(actor.Yields)
	}
	if popN > 0 {
		rep.PopulationAggregates = map[string]float64{"n": popN, "mean_meaningful_activities": popActs / popN, "mean_levels": popLevels / popN, "mean_cells_moved": popMoved / popN, "mean_yields": popYields / popN, "mean_activity_transitions": popTrans / popN}
	}
	ev := r.state.Life.Events
	if len(ev) > 30 {
		ev = ev[len(ev)-30:]
	}
	rep.LifeEventsTail = ev
	if compareDay2 && seconds >= 2*86400 {
		for day := 2; day <= int(seconds/86400); day++ {
			same, total := 0, 0
			for _, tl := range timeline {
				for i := 0; i < 1440 && (day-1)*1440+i < len(tl); i++ {
					total++
					if tl[i] == tl[(day-1)*1440+i] {
						same++
					}
				}
			}
			fraction := float64(same) / float64(total)
			rep.DaysCompared = append(rep.DaysCompared, worldDayComparison{day, total, fraction})
			if day == 2 {
				rep.Day2IdenticalSamples = &fraction
				rep.Day2Compared = total
			}
		}
	}
	return rep
}

func worldAuditWrite(t testing.TB, name string, v any) {
	dir := os.Getenv("NPC_WORLD_REPORT_OUT")
	b, _ := json.MarshalIndent(v, "", "  ")
	if dir == "" {
		t.Logf("%s %s", name, b)
		return
	}
	_ = os.MkdirAll(dir, 0o755)
	if err := os.WriteFile(filepath.Join(dir, name), b, 0o644); err != nil {
		t.Fatal(err)
	}
}

