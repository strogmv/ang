// A private transaction scope for the existing per-piece commands. The world,
// geometry and actors are read-only here. Ordinary buys may reconcile maintenance;
// peddler buys may write facts, focus and their ledger.
func (r *Runtime) tradeTrial() *Runtime {
	trial := &Runtime{state: r.state, world: r.world, lifeInventory: r.lifeInventory}
	trial.state.Inventory = r.state.Inventory.Clone()
	trial.state.Peddlers = r.state.Peddlers.clone()
	trial.state.Memory = r.state.Memory.clone()
	trial.state.Poses = maps.Clone(r.state.Poses)
	trial.state.Life.Maintenance = r.state.Life.Maintenance.Clone()
	trial.state.Life.Events = slices.Clone(r.state.Life.Events)
	return trial
}

func (r *Runtime) tradeBasketQuote(c talkCtx) string {
	return fmt.Sprintf("%s.%d.%d.%d.%d", r.state.Epoch, c.t.Serial, r.state.Inventory.Revision,
		c.t.Trade.BasketRevision, r.state.Life.Seconds)
}

func (r *Runtime) tryTradeBasket(c talkCtx, shelf tradeShelf, locale string) (*pb.PocTradeBasket, *Runtime, string) {
	basket := &pb.PocTradeBasket{Total: r.tradeAmount(locale, 0, "CRD")}
	if len(c.t.Trade.Basket) == 0 {
		basket.MoneyAfter = r.tradeScreenBalance(locale)
		basket.LoadAfter = r.tradeLoad(locale)
		return basket, nil, ""
	}
	trial := r.tradeTrial()
	var total, grossBuy, grossSell int64
	blocked := ""
	// Sell first, then buy, in the order selected within each side. Each step is
	// priced from the stock and balances the preceding step actually left.
	for _, sell := range []bool{true, false} {
		for _, piece := range c.t.Trade.Basket {
			if piece.sell != sell {
				continue
			}
			item := r.state.Inventory.Items[piece.id]
			d := r.world.Inventory.Definitions[item.Definition]
			line := &pb.PocTradeBasketLine{Id: piece.id, Sell: sell, Count: piece.count, Name: r.localText(locale, d.Name, d.Name)}
			basket.Lines = append(basket.Lines, line)
			reason, cost := "", int64(0)
			if item.ID == "" || item.Revision != piece.revision {
				reason = r.world.Memory.Trade.Gone
			} else {
				reason, cost = trial.tryTradeLine(c.key, c.self, shelf, piece)
			}
			line.Price = r.tradeAmount(locale, cost, "CRD")
			if sell {
				total -= cost
				grossSell += cost
			} else {
				total += cost
				grossBuy += cost
			}
			if reason != "" {
				line.Refusal = r.peddlerText(locale, reason, item.Definition, 0)
				if blocked == "" {
					blocked, basket.Refusal = reason, line.Refusal
				}
			}
		}
	}
	basket.Total = r.tradeAmount(locale, total, "CRD")
	basket.Credit = total < 0
	basket.Pay = r.tradeAmount(locale, grossBuy, "CRD")
	basket.Receive = r.tradeAmount(locale, grossSell, "CRD")
	if blocked == "" {
		basket.Ready = true
		basket.Quote = r.tradeBasketQuote(c)
		basket.MoneyAfter = trial.tradeScreenBalance(locale)
		basket.LoadAfter = trial.tradeLoad(locale)
	} else {
		basket.MoneyAfter = r.tradeScreenBalance(locale)
		basket.LoadAfter = r.tradeLoad(locale)
	}
	return basket, trial, blocked
}

func (r *Runtime) tradeScreenBalance(locale string) string {
	account, ok := r.peddlerAccount(playerActorID)
	if !ok {
		return ""
	}
	return r.tradeAmount(locale, account.Balance, "CRD")
}

func (r *Runtime) tryTradeLine(talk, self string, shelf tradeShelf, piece tradePiece) (string, int64) {
	var total int64
	for unit := range piece.count {
		item := r.state.Inventory.Items[piece.id]
		if shelf.peddler.Actor != "" {
			shelf.stock = r.craftingClassStock()
		}
		q := r.tradeQuote("", shelf, item, piece.sell, false)
		total += q.minor
		if q.reason != "" {
			return q.reason, total + q.minor*int64(piece.count-unit-1)
		}
		if q.unit != "CRD" {
			return r.world.Memory.Trade.Failed, total
		}
		result := r.talkDeal(self, item, piece.sell)
		if !result.ok {
			// The older peddler command groups capacity with stock. Keep its note
			// for old callers while the basket shows the confirmed physical cause.
			if _, err := r.tradeMovement(shelf, item, piece.sell); err != nil {
				switch dressInventoryRefusal(err) {
				case "capacity":
					return tradeCapacityKey(err, piece.sell), total
				case "reserved":
					return "ui.dress.reserved", total
				}
			}
			return result.key, total
		}
		r.talkTradeNote(talkCtx{t: r.state.Memory.Talks[talk]}, result.key, result.definition, result.minor, true)
	}
	return "", total
}

func (r *Runtime) tradeScreenCommand(c talkCtx, action, target string) error {
	if action != "conversation_trade" {
		return textError{Key: "error.encounter.unavailable"}
	}
	switch target {
	case "done":
		c.t.Trade = talkTrade{}
		// Go through the authored farewell answer when it exists. Its final
		// speech remains in the conversation column as the usual closing reply.
		if n := c.conv.Nodes[c.t.Node]; n != nil {
			for _, o := range n.Options {
				if o.ID == "bye" && o.Close != "" && r.optionShown(c, o) {
					word, failed, err := r.talkChoose(o.ID)
					if err == nil && word != "" {
						r.talkClosed(c, word, failed)
					}
					return err
				}
			}
		}
		return nil
	}
	if quote, confirm := strings.CutPrefix(target, "confirm:"); confirm {
		v, trial, reason := r.tryTradeBasket(c, r.tradeShelf("", c.self), "")
		if !v.Ready {
			if reason == "" {
				reason = "ui.trade.empty"
			}
			// Item-dependent wording is already in the per-line basket view.
			return textError{Key: reason}
		}
		if quote != v.Quote {
			return textError{Key: "ui.trade.quote_changed"}
		}
		trial.state.Memory.Talks[c.key].Trade.Basket = nil
		// Commit only the state touched by the normal trade commands.
		r.state.Inventory = trial.state.Inventory
		r.state.Peddlers = trial.state.Peddlers
		r.state.Memory = trial.state.Memory
		r.state.Poses = trial.state.Poses
		r.state.Life.Maintenance = trial.state.Life.Maintenance
		r.state.Life.Events = trial.state.Life.Events
		return nil
	}
	verb, id, ok := strings.Cut(target, ":")
	if !ok || id == "" {
		return textError{Key: "error.encounter.unavailable"}
	}
	switch verb {
	case "buy+", "sell+", "buy-", "sell-":
		return r.changeTradeBasket(c, id, strings.HasPrefix(verb, "sell"), strings.HasSuffix(verb, "+"))
	default:
		return textError{Key: "error.encounter.unavailable"}
	}
}

func (r *Runtime) changeTradeBasket(c talkCtx, id string, sell, add bool) error {
	t := &c.t.Trade
	index := slices.IndexFunc(t.Basket, func(p tradePiece) bool { return p.id == id && p.sell == sell })
	if !add {
		if index < 0 {
			return textError{Key: "ui.trade.empty"}
		}
		if t.Basket[index].count == 1 {
			t.Basket = slices.Delete(t.Basket, index, index+1)
		} else {
			t.Basket[index].count--
		}
		t.BasketRevision++
		return nil
	}
	total := int32(0)
	for _, p := range t.Basket {
		total += p.count
	}
	if total >= tradeBasketLimit {
		return textError{Key: "ui.trade.limit"}
	}
	item := r.state.Inventory.Items[id]
	q := r.tradeQuote("", r.tradeShelf("", c.self), item, sell, false)
	if !q.allowed {
		return textError{Key: q.reason}
	}
	if index < 0 {
		t.Basket = append(t.Basket, tradePiece{id: id, sell: sell, revision: item.Revision, count: 1})
	} else if piece := &t.Basket[index]; piece.revision != item.Revision || int64(piece.count) >= item.Quantity {
		return textError{Key: r.world.Memory.Trade.Gone}
	} else {
		piece.count++
	}
	t.BasketRevision++
	return nil
}
