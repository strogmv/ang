// Code generated by ANG. Read-only combat presentation; no rule or hidden opponent state.
package poc
import("fmt";"strings";pb "angelsdemons/server/internal/transport/grpc/pb/game/v1")
func(r *Runtime)appendScreenCombat(msg *pb.PocGameState,locale string){
 ui:=&pb.PocCombatUI{};msg.CombatUi=ui
 v:=msg.Combat
 if v==nil||!v.Active{
  for _,a:=range msg.SceneAgents{if a.Id==playerActorID{continue};ui.Engagements=append(ui.Engagements,&pb.PocCombatOption{Id:a.Id,Action:"start",TargetId:a.Id,Label:a.Name,Enabled:true})};return
 }
 hero:=msg.PlayerCondition;for _,a:=range v.Actors{if a.Id==playerActorID{hero=a;break}}
 if hero!=nil{
  ui.Summary=[]string{r.screenText(locale,"ui.combat.ap_left","ap",fmt.Sprint(hero.Ap),"max",fmt.Sprint(v.TurnAp)),r.screenText(locale,"ui.screen.combat.reserve","ap",fmt.Sprint(hero.ReservedAp)),r.screenCombatWeapon(locale,hero)}
  for _,line:=range hero.BodyLines{if strings.HasPrefix(line,"! "){ui.Danger=append(ui.Danger,strings.TrimPrefix(line,"! "))}}
  if len(ui.Danger)==0&&hero.Bleeding>0{ui.Danger=append(ui.Danger,r.screenText(locale,"ui.combat.bleeding"))}
 }
 for _,a:=range v.Actors{
  if a.Id==playerActorID{continue}
  // Targets come only from already public server options, not the hidden roster.
  offered:=false;for _,o:=range v.Options{if o.TargetId==a.Id{offered=true;break}};if !offered{continue}
  t:=&pb.PocCombatTarget{Id:a.Id,Name:r.screenCombatName(locale,a.Id)}
  distance:=strings.ReplaceAll(fmt.Sprintf("%.1f",float64(a.DistanceMm)/1000),".",r.screenText(locale,"ui.format.decimal_separator"))
  t.Summary=append(t.Summary,r.screenText(locale,"ui.combat.target_line","name",t.Name,"dist",distance),r.screenCombatWeapon(locale,a));t.Summary=append(t.Summary,a.Signs...)
  for _,o:=range v.Options{
   if o.Action=="end"{ui.End=o;continue};if o.TargetId!=""&&o.TargetId!=a.Id&&o.TargetId!=playerActorID{continue}
   key:=o.Group;nameKey:=key;if nameKey==""{nameKey="general"};name:=r.screenText(locale,"ui.screen.combat.group."+nameKey)
   if o.BodyPart!=""{key+="/"+o.BodyPart;name+=" · "+r.screenText(locale,"ui.combat.body."+o.BodyPart)}
   var group *pb.PocCombatGroup;for _,g:=range t.Groups{if g.Id==key{group=g;break}}
   if group==nil{group=&pb.PocCombatGroup{Id:key,Name:name};t.Groups=append(t.Groups,group)}
   o.Display=o.Label+" · "+r.screenText(locale,"ui.combat.ap_cost","ap",fmt.Sprint(o.Ap));group.Options=append(group.Options,o)
  };ui.Targets=append(ui.Targets,t)
 }
 for _,o:=range v.Options{if o.Action=="end"{ui.End=o}}
 for _,e:=range v.Events{if e.Hit{ui.Impact=r.screenText(locale,"ui.screen.combat.impact","actor",r.screenCombatName(locale,e.ActorId),"target",r.screenCombatName(locale,e.TargetId),"amount",fmt.Sprint(e.Amount))}}
}

func(r *Runtime)screenCombatWeapon(locale string,a *pb.PocCombatActor)string{if a.HeldItem=="unarmed"||a.HeldItem==""{return r.screenText(locale,"ui.combat.unarmed")};name:=r.screenInventoryName(locale,a.HeldItem);if name==""{return a.HeldName};return name}

func(r *Runtime)screenCombatName(locale,id string)string{
 if id==playerActorID{return r.screenText(locale,"ui.screen.combat.you")}
 fallback:=id
 if person:=r.world.Life.Person(id);person!=nil&&person.Name!=""{fallback=person.Name}
 return r.localText(locale,"actor."+id+".name",fallback)
}
