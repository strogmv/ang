func screenCombatTargetOption(option *pb.PocCombatOption, target string) bool {
	return option.Action != "end" &&
		(option.TargetId == "" || option.TargetId == target || option.TargetId == playerActorID)
}
func (r *Runtime) screenCombatWeapon(locale string, a *pb.PocCombatActor) string {
	if a.HeldItem == "unarmed" || a.HeldItem == "" {
		return r.screenText(locale, "ui.combat.unarmed")
	}
	name := r.screenInventoryName(locale, a.HeldItem)
	if name == "" {
		return a.HeldName
	}
	return name
}
func (r *Runtime) screenCombatName(locale, id string) string {
	if id == playerActorID {
		return r.screenText(locale, "ui.screen.combat.you")
	}
	fallback := id
	if person := r.world.Life.Person(id); person != nil && person.Name != "" {
		fallback = person.Name
	}
	return r.localText(locale, "actor."+id+".name", fallback)
}
