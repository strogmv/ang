; Generated by ANG. Source models use the ANG plan-local basis.
[gd_scene format=3]
{{if .WorldText}}[ext_resource type="Script" path="res://generated/world_text/world_text.gd" id="world_text"]{{end}}
{{range .Resources}}
[ext_resource type="PackedScene" path={{quote .Path}} id={{quote .ID}}]
{{end}}
[sub_resource type="StandardMaterial3D" id="floor"]
albedo_color = Color(0.24, 0.26, 0.28, 1)
roughness = 0.85

[sub_resource type="StandardMaterial3D" id="wall"]
albedo_color = Color(0.50, 0.52, 0.56, 1)
roughness = 0.7

{{if .FloorOnly}}[sub_resource type="PlaneMesh" id="box"]
size = Vector2(1, 1){{else}}[sub_resource type="BoxMesh" id="box"]
size = Vector3(1, 1, 1){{end}}

[sub_resource type="Environment" id="environment"]
background_mode = 1
background_color = Color(0.08, 0.09, 0.11, 1)
; Server presentation controls a colour ambient; this scene has no Sky.
ambient_light_source = 2
ambient_light_color = Color(0.7, 0.75, 0.85, 1)
ambient_light_energy = 0.65

[node name="Location" type="Node3D"]
metadata/layout_id = {{quote .LayoutID}}
metadata/world_frame = {{quote .Frame}}

{{if .WorldText}}[node name="WorldText" type="Node3D" parent="."]
script = ExtResource("world_text")
level_id = {{quote .LayoutID}}
{{end}}
[node name="Structure" type="Node3D" parent="."]
{{range .Boxes}}
[node name={{quote .Name}} type="MeshInstance3D" parent="Structure"]
position = {{.Position}}
scale = {{.Size}}
mesh = SubResource("box")
material_override = SubResource({{quote .Material}})
metadata/source_id = {{quote .SourceID}}
{{end}}
[node name="Placements" type="Node3D" parent="."]
{{range .Nodes}}
[node name={{quote .Name}}{{if .ResourceID}} parent="Placements" instance=ExtResource({{quote .ResourceID}}){{else}} type="Node3D" parent="Placements"{{end}}]
transform = {{.Transform}}
metadata/instance_id = {{quote .InstanceID}}
metadata/model_ref = {{quote .ModelRef}}
{{end}}
{{range .Attachments}}
[node name={{quote .Name}} type="Node3D" parent={{quote .Parent}}]
position = {{.Position}}
metadata/source_path = {{quote .SourcePath}}
{{end}}
[node name="Camera3D" type="Camera3D" parent="."]
transform = {{.CameraTransform}}
current = true
projection = 1
size = {{.CameraSize}}
far = 500.0
metadata/elevation_degrees = {{.Elevation}}
metadata/azimuth_degrees = {{.Azimuth}}

[node name="LightingRig" type="Node3D" parent="."]
metadata/role = "authored lighting placeholder"

[node name="WorldEnvironment" type="WorldEnvironment" parent="LightingRig"]
environment = SubResource("environment")

[node name="Key" type="DirectionalLight3D" parent="LightingRig"]
rotation_degrees = Vector3(-55, -25, 0)
light_color = Color(1, 0.91, 0.78, 1)
light_energy = 0.8
shadow_enabled = false
