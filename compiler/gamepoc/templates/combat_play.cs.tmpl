    return go;}
   if(combatPropBox==null){
    var shader=Shader.Find("Universal Render Pipeline/Lit");if(shader==null)shader=Shader.Find("Standard");
    Func<Color,float,float,Material> mat=(c,m,s)=>{var x=new Material(shader){enableInstancing=true};x.SetColor("_BaseColor",c);x.SetFloat("_Metallic",m);x.SetFloat("_Smoothness",s);locationSDKHumanoidOwned.Add(x);return x;};
    combatPropDark=mat(new Color(.07f,.07f,.075f),0,.35f);combatPropSteel=mat(new Color(.62f,.64f,.66f),.85f,.6f);combatPropBrass=mat(new Color(.55f,.42f,.2f),.8f,.5f);
    var tmp=GameObject.CreatePrimitive(PrimitiveType.Cube);combatPropBox=tmp.GetComponent<MeshFilter>().sharedMesh;Destroy(tmp);
   }
   var root=new GameObject("combat prop / "+kind+" / "+h.id){layer=LocationSDKLayer};root.transform.SetParent(locationSDKRoot.transform,false);
   Action<Vector3,Vector3,Material> part=(center,size,m)=>{var go=new GameObject("part"){layer=LocationSDKLayer};go.transform.SetParent(root.transform,false);go.transform.localPosition=center;go.transform.localScale=size;go.AddComponent<MeshFilter>().sharedMesh=combatPropBox;var r=go.AddComponent<MeshRenderer>();r.sharedMaterial=m;r.shadowCastingMode=UnityEngine.Rendering.ShadowCastingMode.Off;};
   if(kind=="knife"){part(new Vector3(0,0,-.045f),new Vector3(.024f,.03f,.11f),combatPropDark);part(new Vector3(0,0,.012f),new Vector3(.05f,.012f,.012f),combatPropSteel);part(new Vector3(0,0,.1f),new Vector3(.004f,.026f,.16f),combatPropSteel);}
   else if(kind=="baton"||kind=="pipe"){part(new Vector3(0,0,.2f),new Vector3(.034f,.034f,.56f),combatPropDark);part(new Vector3(0,0,-.09f),new Vector3(.04f,.04f,.03f),combatPropBrass);}
   else if(kind=="needle_gun"){part(new Vector3(0,.03f,.06f),new Vector3(.04f,.06f,.2f),combatPropDark);part(new Vector3(0,.04f,.2f),new Vector3(.016f,.016f,.12f),combatPropSteel);part(new Vector3(0,-.04f,-.01f),new Vector3(.034f,.11f,.045f),combatPropDark);part(new Vector3(0,.065f,.02f),new Vector3(.02f,.012f,.06f),combatPropBrass);}
   return root;
  }
  void CombatUpdateFlash(LocationSDKHumanoid h,CombatBody body){
   bool on=CombatNow<body.flashUntil;var block=new MaterialPropertyBlock();
   foreach(var r in h.renderers){if(r==null)continue;if(on){r.GetPropertyBlock(block);block.SetColor("_BaseColor",new Color(1f,.32f,.26f));r.SetPropertyBlock(block);}else if(body.flashUntil>0)r.SetPropertyBlock(null);}
   if(!on&&body.flashUntil>0&&CombatNow>body.flashUntil+.05f)body.flashUntil=0;
  }

  // Floating marks over the head (drawn in the HUD's 1280x800 space).
  void DrawCombatFx(){
   if(combatFx.Count==0||locationSDKCamera==null)return;var viewport=SpatialViewport();var placed=new List<Rect>();
   var style=new GUIStyle(hudBody){alignment=TextAnchor.MiddleCenter,fontSize=17,fontStyle=FontStyle.Bold};
   for(int i=combatFx.Count-1;i>=0;i--){var fx=combatFx[i];float now=CombatNow;if(now>fx.until){combatFx.RemoveAt(i);continue;}if(now<fx.start)continue;
    var h=CombatHumanoid(fx.actor);if(h==null||h.go==null||!h.go.activeSelf)continue;var head=h.animator.GetBoneTransform(HumanBodyBones.Head);var at=(head!=null?head.position:h.go.transform.position+Vector3.up*1.7f)+Vector3.up*(.35f+.35f*(now-fx.start));
    var v=locationSDKCamera.WorldToViewportPoint(at);if(v.z<=0)continue;var p=new Vector2(viewport.x+v.x*viewport.width,viewport.y+(1-v.y)*viewport.height);
    float a=Mathf.Clamp01((fx.until-now)/.5f);var rect=new Rect(p.x-110,p.y-14,220,28);for(int tries=0;tries<8&&placed.Exists(r=>r.Overlaps(rect));tries++)rect.y-=29;placed.Add(rect);
    style.normal.textColor=new Color(0,0,0,.8f*a);GUI.Label(new Rect(rect.x+1.5f,rect.y+1.5f,rect.width,rect.height),fx.text,style);style.normal.textColor=new Color(fx.color.r,fx.color.g,fx.color.b,a);GUI.Label(rect,fx.text,style);}
  }
