// Code generated by ANG. Persistent station waiting and physical travel.
package behavior
import("encoding/json";"reflect";"testing")

func platformFixture()LifeModel{
 m:=lifeFixture();m.Edges[0].WaitingCells=[]Cell{{1,0},{3,2}};m.Edges[0].BoardingLeadSeconds=5;m.Edges[0].PeriodSeconds=60;m.Edges[0].Seats=2
 return m
}
func TestLifePlatformDistinctPocketsReplayAndRealBoarding(t *testing.T){
 m:=platformFixture();if err:=m.Validate();err!=nil{t.Fatal(err)};s:=m.Start()
 waited:=map[string]Cell{};boarded:=map[string]bool{};cleared:=map[string]bool{};var replay *LifeState
 for tick:=int64(1);tick<=260;tick++{
  s.Advance(m,tick);if replay!=nil{replay.Advance(m,tick);if !reflect.DeepEqual(s.Clone(),replay.Clone()){t.Fatalf("saved waiting diverged at %d",tick)}}
  if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}
  for _,a:=range s.Actors{
   if a.Label=="life.platform.waiting"{if a.Position==m.Edges[0].Exit||a.Position==m.Edges[1].Entry{t.Fatal("waiting blocked boarding or arrival")};waited[a.ID]=a.Position}
   if a.Trip!=nil{if a.Position!=m.Edges[0].Exit||a.Trip.Edge!="ab"||a.Trip.Departure%60!=0{t.Fatal("boarding skipped physical gate or timetable")};boarded[a.ID]=true}
   if a.Level=="b"&&a.Trip==nil&&a.Position!=m.Edges[0].Entry{cleared[a.ID]=true}
  }
  if replay==nil&&len(waited)==2{raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};replay=&LifeState{};if err=json.Unmarshal(raw,replay);err!=nil{t.Fatal(err)}}
 }
 if len(waited)!=2||waited["one"]==waited["two"]||len(boarded)!=2||len(cleared)!=2||replay==nil{t.Fatalf("incomplete commute: waited=%v boarded=%v cleared=%v",waited,boarded,cleared)}
}
func TestLifePlatformRejectsUnsafeOrDisconnectedPockets(t *testing.T){
 for _,change:=range []func(*LifeModel){
  func(m *LifeModel){m.Edges[0].WaitingCells=[]Cell{m.Edges[0].Exit}},
  func(m *LifeModel){m.Edges[1].Entry=Cell{1,0}},
  func(m *LifeModel){m.Edges[0].WaitingCells=[]Cell{{1,0},{1,0}}},
  func(m *LifeModel){l:=m.Locations["a"];l.Terrain=[]string{"#.#..",".#...","....."};m.Locations["a"]=l},
  func(m *LifeModel){m.Edges[0].BoardingLeadSeconds=0},
 }{m:=platformFixture();change(&m);if m.Validate()==nil{t.Fatal("unsafe platform accepted")}}
}
func TestLifePlatformDoesNotRerouteControlledOrManualActor(t *testing.T){
 for _,manual:=range []bool{false,true}{m:=platformFixture();s:=m.Start();a:=s.Actor("one");a.Manual=manual;if !manual{s.ControlledActorID=a.ID};before:=s.Clone();goal,hold:=s.platformDestination(m,a,&m.Edges[0]);if hold||goal!=m.Edges[0].Exit||!reflect.DeepEqual(before,s.Clone()){t.Fatal("platform policy changed manual/controlled intent")}}
}

func TestLifePlatformOccupiedPocketsDoNotCancelAcceptedStep(t *testing.T){
 for _,all:=range []bool{false,true}{
  m:=platformFixture();m.Actors=append(m.Actors,LifePerson{ID:"third",Name:"Third",Steps:[]LifeStep{{Level:"a",At:Cell{3,2},Activity:"rest"}}})
  s:=m.Start();a:=s.Actor("one");a.Step=1;a.Arrived=false;a.Position=Cell{1,2};a.Goal=Cell{1,0};a.Path=[]Cell{{2,2},{2,1},{1,1},{1,0}};a.MoveStartTick=0
  other:=s.Actor("two");other.Position=Cell{1,0};other.Goal=other.Position;other.Arrived=true
  third:=s.Actor("third");if !all{third.Position=Cell{4,2};third.Goal=third.Position};third.Arrived=true
  prefix,start:=a.Path[0],a.MoveStartTick
  s.Advance(m,1)
  if len(a.Path)==0||a.Path[0]!=prefix||a.MoveStartTick!=start||a.Position!=(Cell{1,2}){t.Fatal("pocket contention cancelled an accepted step")}
  s.Advance(m,2);s.Advance(m,3)
  if a.Position!=prefix{t.Fatal("accepted step never completed at its original movement deadline")}
 }
}

func TestLifePlatformNamedPassengerHonorsPopulationPocketClaim(t *testing.T){
 m:=platformFixture();s:=m.Start();a:=s.Actor("one");a.Step=1;a.Arrived=false
 preferred,_:=s.platformDestination(m,a,&m.Edges[0]);a.Goal=preferred
 s.Population.Actors=[]PopulationActor{{ID:"population.claim",Level:a.Level,Materialized:true,Position:Cell{0,2},Goal:preferred,Arrived:false}}
 next,hold:=s.platformDestination(m,a,&m.Edges[0]);if hold||next==preferred{t.Fatal("named passenger stole an already assigned population waiting pocket")}
}

func TestLifePlatformDoesNotReserveUnexecutedHeroGoal(t *testing.T){
 m:=platformFixture();s:=m.Start();a:=s.Actor("one");a.Arrived=false
 preferred,_:=s.platformDestination(m,a,&m.Edges[0]);a.Goal=preferred
 hero:=s.Actor("two");s.ControlledActorID=hero.ID;hero.Manual=true;hero.Arrived=false;hero.Goal=preferred
 next,hold:=s.platformDestination(m,a,&m.Edges[0]);if hold||next!=preferred{t.Fatal("passenger anticipated the hero's distant unexecuted goal")}
}

func boardingWindowFixture() LifeModel {
 p,m:=populationFixture();m.StartSeconds=35;m.SecondsPerTick=1;m.MoveTicks=3
 m.Actors=[]LifePerson{{ID:"observer",Name:"Observer",Steps:[]LifeStep{{Level:"a",At:Cell{0,0},Activity:"rest"}}},{ID:"named.one",Name:"One",Steps:[]LifeStep{{Level:"a",At:Cell{5,1},Activity:"rest",MinSeconds:1},{AtMinute:1,Level:"b",At:Cell{4,4},Activity:"work"}}},{ID:"named.two",Name:"Two",Steps:[]LifeStep{{Level:"a",At:Cell{6,2},Activity:"rest",MinSeconds:1},{AtMinute:1,Level:"b",At:Cell{8,4},Activity:"work"}}}}
 for i:=range m.Edges{if m.Edges[i].ID=="ab"{m.Edges[i].Exit=Cell{6,1};m.Edges[i].Entry=Cell{6,0};m.Edges[i].Mode="rail";m.Edges[i].PeriodSeconds=60;m.Edges[i].Seats=4;m.Edges[i].TravelSeconds=30;m.Edges[i].BoardingWindowSeconds=20}}
 edges:=[]LifeEdge{};for _,edge:=range m.Edges{if edge.ID!="ac"&&edge.ID!="ca"{edges=append(edges,edge)}};m.Edges=edges
 p.MoveTicks=3;p.ShiftOffsets=[]int64{0};p.Stages[1].AtSecond=1;p.Stages[2].AtSecond=300;m.Population=p;return m
}
func TestLifeBoardingWindowSharedFourSeatsThroughOneGateAndSave(t *testing.T){
 m:=boardingWindowFixture();s,err:=m.StartWithPopulation(3,"observer");if err!=nil{t.Fatal(err)};s.Actor("observer").Manual=true;s.Population.ActiveLevel="a"
 // Explicit travel intents exercise boarding before the next routine minute.
 for _,id:=range []string{"named.one","named.two"}{a:=s.Actor(id);a.OverrideLevel="b";a.OverrideAt=m.Person(id).Steps[1].At;a.Arrived=false;a.Manual=true}
 for i:=range s.Population.Actors{a:=&s.Population.Actors[i];a.Level="a";a.Visits["a"]=1;a.Position=[]Cell{{7,1},{6,0},{8,1}}[i];a.Goal=Cell{6,1};a.Arrived=false;a.Materialized=true;a.Activity="walking"}
 seen:=map[string]int64{};counts:=map[int64]int{};var replay *LifeState;early:=false
 for tick:=int64(1);tick<=130;tick++{
  s.Advance(m,tick);if err=s.AdvancePopulation(m,"observer");err!=nil{t.Fatal(err)}
  if replay!=nil{replay.Advance(m,tick);if err=replay.AdvancePopulation(m,"observer");err!=nil{t.Fatal(err)};if !reflect.DeepEqual(s.Clone(),replay.Clone()){t.Fatal("waiting inside train changed identities or seat reservations after save")}}
  if err=s.Validate(m,tick);err!=nil{t.Fatal(err)}
  record:=func(id string,at Cell,departure,arrival int64){if at!=(Cell{6,1})||arrival!=departure+30||departure-s.Seconds>20{t.Fatal("boarding bypassed gate, berth window or real timetable")};if _,ok:=seen[id];!ok{seen[id]=departure;counts[departure]++;if departure>s.Seconds{early=true}}}
  for _,a:=range s.Actors{if a.Trip!=nil{record(a.ID,a.Position,a.Trip.Departure,a.Trip.Arrival)}}
  for _,a:=range s.Population.Actors{if a.Trip!=nil{record(a.ID,a.Position,a.Trip.Departure,a.Trip.Arrival)}}
  if replay==nil&&early{raw,_:=json.Marshal(s);replay=&LifeState{};if err=json.Unmarshal(raw,replay);err!=nil{t.Fatal(err)}}
 }
 if !early||replay==nil||len(seen)!=5||counts[60]!=4||counts[120]!=1{t.Fatalf("one-cell gate did not use four actual seats and next departure: %v / %v",seen,counts)}
}
func TestLifeBoardingWindowRejectsTooEarlyAndMissedTrain(t *testing.T){
 m:=boardingWindowFixture();s:=m.Start();a:=s.Actor("named.one");a.Position=Cell{6,1};a.Goal=a.Position;a.Path=nil;edge:=m.Edge("ab");a.WaitingDeparture=60;s.Seconds=39
 if s.beginLifeTrip(m,a,edge,nil)||a.Trip!=nil{t.Fatal("boarded before train berth window")}
 s.Seconds=40;if !s.beginLifeTrip(m,a,edge,nil)||a.Trip.Departure!=60||a.Trip.Arrival!=90{t.Fatal("could not board physically berthed train")}
 bad:=s.Clone();bad.Actor(a.ID).Trip.Departure=120;bad.Actor(a.ID).Trip.Arrival=150;if bad.Validate(m,0)==nil{t.Fatal("future departure outside berth window accepted")}
 a.Trip=nil;a.WaitingDeparture=60;s.Seconds=61;if s.beginLifeTrip(m,a,edge,nil)||a.WaitingDeparture!=120{t.Fatal("missed train was boarded retrospectively")}
 for _,window:=range []int64{-1,61}{badModel:=m;badModel.Edges=append([]LifeEdge(nil),m.Edges...);badModel.Edges[0].BoardingWindowSeconds=window;if badModel.Validate()==nil{t.Fatal("invalid berth duration accepted")}}
}

func TestLifeBoardingWindowPreservesCoarseCrossingOfRealDeparture(t *testing.T){
 m:=boardingWindowFixture();edge:=m.Edge("ab");edge.NightPeriodSeconds=120;edge.DayStartSecond=0;edge.DayEndSecond=79200
 s:=m.Start();a:=s.Actor("named.one");a.Position=edge.Exit;a.Goal=a.Position;a.Path=nil;a.WaitingDeparture=60;s.Seconds=65
 if !s.beginLifeTrip(m,a,edge,nil,35)||a.Trip.Departure!=60||a.Trip.Arrival!=90{t.Fatal("elapsed frame crossed a real departure but was postponed")}
 if edge.validBoardedDeparture(59,40){t.Fatal("unscheduled future departure accepted inside time window")}
}
