// A wall row with a three-cell gate; 21:59:50, gate raised by schedule.
func gateFixture()LifeModel{
 return LifeModel{StartSeconds:22*3600-10,SecondsPerTick:1,MoveTicks:3,Walkable:map[string]bool{".":true},
  Locations:map[string]LifeLocation{"g":{Name:"G",Terrain:[]string{".......",".......","##...##",".......","......."},Gates:[]LifeGate{{ID:"gate",Opening:[]Cell{{2,2},{3,2},{4,2}},SightClearPPM:350000,WarningTicks:30,TravelTicks:130,RetryTicks:50,LockdownWarningTicks:30,LockdownRetryTicks:50,PowerWarningTicks:30,GravityTicks:200,RampTicks:15,OpenSecond:6*3600,CloseSecond:22*3600,LockAtNight:true}}}},
  Actors:[]LifePerson{{ID:"porter",Name:"Porter",Steps:[]LifeStep{{AtMinute:0,Level:"g",At:Cell{0,0},Activity:"rest"}}}}}
}
func gateGlyph(m LifeModel,s LifeState)byte{return s.GateModel(m).Locations["g"].Terrain[2][3]}

func TestGateScheduledCloseWarnsLowersAndLocks(t *testing.T){
 m:=gateFixture();if err:=m.Validate();err!=nil{t.Fatal(err)};s:=m.Start()
 if g:=s.Gates["gate"];g.State!="open"||g.Position(0)!=GateFull||gateGlyph(m,s)!='.'{t.Fatalf("not raised at start: %+v",g)}
 seen:=map[string]int64{};last:=GateFull;sightLost:=false
 for tick:=int64(1);tick<=260;tick++{
  s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)};g:=s.Gates["gate"];p:=g.Position(tick)
  if _,ok:=seen[g.State];!ok{seen[g.State]=tick}
  if p>last{t.Fatalf("lift rose while closing at %d",tick)};last=p
  glyph:=gateGlyph(m,s)
  if g.State=="warning"&&glyph!='.'{t.Fatal("warning must keep the passage open")}
  if g.State=="closing"&&glyph=='.'{t.Fatal("a descending gate left the passage open")}
  if p<350000&&glyph!='#'{t.Fatal("sight passes under a gate lower than 2.1 m")};if p>=350000&&p<GateFull&&glyph!='+'{t.Fatal("blocked but transparent band missing")}
  if glyph=='#'{sightLost=true}
 }
 g:=s.Gates["gate"];if g.State!="locked"||g.Position(260)!=0||!sightLost{t.Fatalf("final %+v",g)}
 if seen["warning"]==0||seen["closing"]-seen["warning"]<29||seen["closing"]-seen["warning"]>30||seen["locked"]-seen["closing"]!=130{t.Fatalf("timeline %v",seen)}
}

// Hand-placed body in the opening at the end of the warning: stop, never lower over it.
func TestGateObstructionStopsAndRetriesAfterClear(t *testing.T){
 m:=gateFixture();s:=m.Start();a:=s.Actor("porter");a.Manual=true;a.Position=Cell{3,2};a.Goal=a.Position
 left:=int64(0)
 for tick:=int64(1);tick<=400;tick++{
  s.Advance(m,tick);g:=s.Gates["gate"]
  if left==0&&s.Actor("porter").Position==(Cell{3,2}){if g.Position(tick)<GateFull{t.Fatal("gate lowered onto a body")}}
  if left==0&&g.State=="stopped"&&tick>80{p:=s.Actor("porter");p.Position=Cell{3,4};p.Goal=p.Position;left=tick}
  if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}
 }
 g:=s.Gates["gate"];if left==0||g.State!="locked"||g.Stops<1{t.Fatalf("no stop/retry: %+v left=%d",g,left)}
 if g.Start<left+50{t.Fatal("retried before the opening stayed clear")}
}

// One huge frame equals many small ones (absolute segments), and a frame that
// crosses the end of a warning with a body present stops at full lift.
func TestGateLargeFrameDoesNotSkipEvents(t *testing.T){
 d:=gateFixture().Locations["g"].Gates[0]
 var small,large LifeGateState;small.rest("open",GateFull,0);large=small
 for now:=int64(1);now<=400;now++{small.advance(d,now,22*3600+now,false)}
 large.advance(d,400,22*3600+400,false)
 if small.State!=large.State||small.Position(400)!=large.Position(400)||small.Start!=large.Start{t.Fatalf("frame size changed the result: %+v vs %+v",small,large)}
 var g LifeGateState;g.rest("open",GateFull,0);g.advance(d,1,22*3600,false)
 g.advance(d,500,22*3600+500,true)
 if g.State!="stopped"||g.Position(500)!=GateFull{t.Fatalf("big frame passed an obstruction: %+v",g)}
}

func TestGateLockdownGravityRetryAndRelease(t *testing.T){
 m:=gateFixture();m.StartSeconds=12*3600;s:=m.Start()
 if err:=s.SetGateLockdown(m,"gate",true);err!=nil{t.Fatal(err)}
 var descentStart int64
 for tick:=int64(1);tick<=300;tick++{s.Advance(m,tick);g:=s.Gates["gate"];if g.State=="lockdown"&&g.Duration>0&&descentStart==0{descentStart=tick;if !g.Linear||g.Duration!=200{t.Fatalf("not a governor descent: %+v",g)}}}
 g:=s.Gates["gate"];if g.State!="lockdown"||g.Position(300)!=0||descentStart!=30{t.Fatalf("lockdown %+v start=%d",g,descentStart)}
 // Linear: half height after half the governor time.
 probe:=LifeGateState{};probe.travel("lockdown","lockdown",GateFull,0,0,200,-1);if probe.Position(100)!=GateFull/2||probe.Ramp!=0{t.Fatal("governor speed is not constant")}
 // Powered: trapezoidal speed of the kit ramp (1.5 s of 13 s), symmetric, monotonic,
 // equal to the model's ease table (0.0725 at 1.5 s, 0.5 at 6.5 s, 0.9348 at 11.5 s).
 powered:=LifeGateState{};powered.travel("opening","schedule",0,GateFull,0,130,15)
 for _,c:=range []struct{u,ppm int64}{{5,7246},{15,65217},{65,500000},{115,934782},{130,GateFull}}{if p:=powered.Position(c.u);p<c.ppm-2||p>c.ppm+2{t.Fatalf("ease at %d: %d, want %d",c.u,p,c.ppm)}}
 last:=int64(-1);for u:=int64(0);u<=130;u++{p:=powered.Position(u);if p<last{t.Fatal("powered lift not monotonic")};last=p}
 short:=LifeGateState{};short.travel("closing","schedule",GateFull/10,0,0,13,15);if short.Ramp!=6||short.Position(13)!=0{t.Fatalf("partial stroke ramp %+v",short)}
 s.SetGateLockdown(m,"gate",false)
 for tick:=int64(301);tick<=500;tick++{s.Advance(m,tick)}
 if g:=s.Gates["gate"];g.State!="open"{t.Fatalf("release did not raise by day: %+v",g)}
 // Body under the lockdown warning: stop, pause 5 s, warn again.
 a:=s.Actor("porter");a.Manual=true;a.Position=Cell{2,2};a.Goal=a.Position;s.SetGateLockdown(m,"gate",true)
 for tick:=int64(501);tick<=620;tick++{s.Advance(m,tick)}
 if g:=s.Gates["gate"];g.State!="stopped"||g.Cause!="lockdown"{t.Fatalf("lockdown over a body: %+v",g)}
 a=s.Actor("porter");a.Position=Cell{2,4};a.Goal=a.Position
 for tick:=int64(621);tick<=900;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}}
 if g:=s.Gates["gate"];g.State!="lockdown"||g.Position(900)!=0{t.Fatalf("lockdown retry: %+v",g)}
}

