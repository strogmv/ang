func (pp *{{ .StructName }}) doCheckStatusWithRetry(
	tx *model.Transaction,
	endpoint string,
	headers httpcli.Headers,
	resp httpcli.APIResponse,
	opKind string,
) error {
	var lastErr error
	for attempt := 1; attempt <= pp.checkStatusMaxAttempts(opKind); attempt++ {
		rawResp, respHeaders, respStatus, err := pp.httpClient.GetWithResponse(tx, endpoint, headers, resp)
		if err == nil {
			return nil
		}
		lastErr = err
		if rawResp != nil {
			if pp.shouldPreferParsedLogging(opKind) {
				pp.logResponsePreferParsed(tx, respStatus, rawResp, respHeaders, resp)
			} else {
				pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus,
					pp.httpClient.LogRawResponseDetails(rawResp, respHeaders))
			}
		}
		if !pp.shouldRetryCheckStatus(opKind, err, attempt) {
			break
		}
		time.Sleep(pp.checkStatusBackoff(opKind, attempt))
	}
	return lastErr
}

func (pp *{{ .StructName }}) doPostWithResponseWithPolicy(
	tx *model.Transaction,
	endpoint string,
	req httpcli.APIRequest,
	headers httpcli.Headers,
	resp httpcli.APIResponse,
	opKind string,
) ([]byte, http.Header, string, error) {
	var (
		rawResp     []byte
		respHeaders http.Header
		respStatus  string
		lastErr     error
	)
	for attempt := 1; attempt <= pp.checkStatusMaxAttempts(opKind); attempt++ {
		rawResp, respHeaders, respStatus, lastErr = pp.httpClient.PostWithResponse(tx, endpoint, req, headers, resp)
		if lastErr == nil {
			return rawResp, respHeaders, respStatus, nil
		}
		if rawResp != nil {
			if pp.shouldPreferParsedLogging(opKind) {
				pp.logResponsePreferParsed(tx, respStatus, rawResp, respHeaders, resp)
			} else {
				pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus,
					pp.httpClient.LogRawResponseDetails(rawResp, respHeaders))
			}
		}
		if !pp.shouldRetryCheckStatus(opKind, lastErr, attempt) {
			break
		}
		time.Sleep(pp.checkStatusBackoff(opKind, attempt))
	}
	return rawResp, respHeaders, respStatus, lastErr
}

func isRateLimitedError(err error) bool {
	if err == nil {
		return false
	}
	msg := strings.ToLower(err.Error())
	return strings.Contains(msg, "429") ||
		strings.Contains(msg, "too many requests") ||
		strings.Contains(msg, "rate limit")
}
