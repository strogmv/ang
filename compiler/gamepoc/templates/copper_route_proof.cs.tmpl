  static bool CopperRouteWorldPixelsVisible(Color32[] pixels,int width,int height){
   if(pixels==null||width<=0||height<=0||(long)width*height!=pixels.Length)return false;
   // Sample only the interior world plane, excluding top/bottom HUD bands and
   // side status boxes. Nonempty caches/queued actors do not prove GPU output.
   int total=0,visible=0;
   for(int y=height*18/100;y<height*80/100;y+=4)for(int x=width*15/100;x<width*85/100;x+=4){var c=pixels[y*width+x];total++;if(c.a>0&&c.r+c.g+c.b>90)visible++;}
   return total>=64&&visible>=Math.Max(8,total/200);
  }
