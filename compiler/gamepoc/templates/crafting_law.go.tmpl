// craftingOffence opens a case of an act. Witnessed acts get the law's reports (obliged at once, others by the crowd
// curve after the delay); a direct detection (a chip check, a scan) is evidence at once.
func (r *Runtime) craftingOffence(actID, item string, witnesses []string, direct bool) {
