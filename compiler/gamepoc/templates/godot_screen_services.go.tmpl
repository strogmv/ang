// Code generated by ANG. Typed screen adapter for the existing public snapshots.
package poc

import (
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"encoding/json"
	"fmt"
	"strings"
)

func (r *Runtime) appendScreenServices(msg *pb.PocGameState, locale string) {
	if msg.Life == nil {
		return
	}
	var medical struct {
		Units []medicalUnitView `json:"units"`
		Hero  medicalHeroView   `json:"hero"`
	}
	if err := json.Unmarshal([]byte(msg.Life.MedicalCapsulesJson), &medical); err == nil {
		for _, unit := range medical.Units {
			own := medical.Hero.UnitID == unit.ID
			v := &pb.PocServiceUnit{
				Id:             unit.ID,
				Name:           unit.Name,
				Phase:          unit.Phase,
				PhaseText:      unit.PhaseText,
				RequestAction:  "medical_request",
				AcceptAction:   "medical_accept",
				CancelAction:   "medical_cancel",
				CancelLabel:    r.screenText(locale, "ui.medical.cancel"),
				RequestEnabled: unit.RequestEnabled,
				RequestVisible: !own,
			}
			if unit.QueueCount > 0 {
				v.StatusLines = append(
					v.StatusLines,
					r.screenText(locale, "ui.medical.queue", "0", fmt.Sprint(unit.QueueCount)),
				)
			}
			if own {
				h := medical.Hero
				v.OfferId = h.OfferID
				v.AcceptEnabled = h.AcceptEnabled
				v.CancelEnabled = h.CancelEnabled
				if h.ReasonText != "" {
					v.StatusLines = append(v.StatusLines, h.ReasonText)
				}
				switch h.Phase {
				case "scan":
					v.StatusLines = append(
						v.StatusLines,
						r.screenText(
							locale,
							"ui.medical.scanning",
							"0",
							fmt.Sprint(int(unit.ScanProgress*100)),
						),
					)
				case "offer":
					key := "ui.screen.medical.decline"
					if h.Quote.Mode == "refused" {
						key = "ui.screen.medical.finish_exam"
					}
					v.CancelLabel = r.screenText(locale, key)
					v.StatusLines = append(v.StatusLines, r.screenText(locale, "ui.medical.mode."+h.Quote.Mode))
					if h.Quote.Mode != "refused" {
						scale := r.world.Inventory.Currencies[r.world.MedicalCapsules.Currency].Scale
						money := strings.ReplaceAll(
							inv.FormatMoney(h.Quote.PriceMinor, scale),
							".",
							r.localText(locale, "ui.format.decimal_separator", "."),
						)
						v.StatusLines = append(
							v.StatusLines,
							r.screenText(locale, "ui.medical.price", "0", money),
							r.screenText(
								locale,
								"ui.medical.duration",
								"0",
								fmt.Sprint((h.Quote.Seconds+59)/60),
							),
						)
					}
				case "treatment":
					v.StatusLines = append(
						v.StatusLines,
						r.screenText(
							locale,
							"ui.medical.remaining",
							"0",
							fmt.Sprint((h.CareRemainingSeconds+59)/60),
						),
					)
				}
			} else {
				v.StatusLines = append(v.StatusLines, r.screenText(locale, "ui.medical.examination_help"))
			}
			msg.Life.MedicalUnits = append(msg.Life.MedicalUnits, v)
		}
	}
	var sanitary struct {
		Units         []sanitaryUnitView `json:"units"`
		HeroUnitID    string             `json:"hero_unit_id"`
		HeroPhaseText string             `json:"hero_phase_text"`
	}
	if err := json.Unmarshal([]byte(msg.Life.SanitaryServicesJson), &sanitary); err == nil {
		for _, unit := range sanitary.Units {
			own := sanitary.HeroUnitID == unit.ID
			v := &pb.PocServiceUnit{
				Id:             unit.ID,
				Name:           unit.Name,
				Phase:          unit.Phase,
				PhaseText:      unit.PhaseText,
				RequestAction:  "sanitary_request",
				CancelAction:   "sanitary_cancel",
				CancelLabel:    r.screenText(locale, "ui.sanitary.cancel"),
				RequestEnabled: unit.RequestEnabled,
				RequestVisible: !own,
				CancelEnabled:  unit.CancelEnabled,
			}
			v.StatusLines = append(v.StatusLines, r.screenText(locale, "ui.sanitary.cold_supply"))
			if unit.QueueCount > 0 {
				v.StatusLines = append(
					v.StatusLines,
					r.screenText(locale, "ui.sanitary.queue", "0", fmt.Sprint(unit.QueueCount)),
				)
			}
			if !own && unit.RequestReason != "" {
				v.StatusLines = append(v.StatusLines, unit.RequestReason)
			}
			if own {
				if sanitary.HeroPhaseText != "" {
					v.StatusLines = append(v.StatusLines, sanitary.HeroPhaseText)
				}
				if unit.Phase == "using" {
					v.CancelLabel = r.screenText(locale, "ui.sanitary.finish")
					v.StatusLines = append(
						v.StatusLines,
						r.screenText(
							locale,
							"ui.sanitary.remaining",
							"0",
							fmt.Sprint(max(0, unit.UseDuration-unit.UseElapsed)),
						),
					)
				}
			}
			msg.Life.SanitaryUnits = append(msg.Life.SanitaryUnits, v)
		}
	}
}
