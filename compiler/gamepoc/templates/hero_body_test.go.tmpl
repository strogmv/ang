// Code generated by ANG. Movement v2 (documents 86/87): the continuous hero body on the story hub.
package poc

import (
	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"encoding/json"
	"math"
	"testing"
)

// heroBodyHub: an ordinary life100 market on a modular (multi-deck) story location, calendar x1, hero in control.
func heroBodyHub(t *testing.T) (*Runtime, *connection) {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	c := &connection{out: make(chan *pb.ServerMessage, 64), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "body", Scenario: "life100", Seed: 777}}}})
	for len(c.out) > 0 {
		<-c.out
	}
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || !r.world.Life.BodyCapable(hero.Level) || r.deckVolume() == nil {
		t.Skip("this world has no modular story location for the hero body")
	}
	r.state.Life.SecondsPerTick = 1
	return r, c
}

var heroBodySeq uint64 = 1000

func heroBodySteer(t *testing.T, r *Runtime, c *connection, mode string, x, y float64) {
	t.Helper()
	heroBodySeq++
	r.heroSteer(c, &pb.PocHeroSteer{Epoch: r.state.Epoch, InputSeq: heroBodySeq, Mode: mode, X: x, Y: y})
	if len(c.out) != 1 {
		t.Fatalf("steering must be answered by exactly one move result, got %d messages", len(c.out))
	}
	res := (<-c.out).GetMoveResult()
	if res == nil || !res.Ok || res.HeroBody == nil || res.HeroBody.InputSeq != heroBodySeq {
		t.Fatalf("steer %s rejected or without body: %v", mode, res)
	}
}

func heroBodyGo(t *testing.T, r *Runtime, c *connection, target behavior.Cell, deck int32) {
	t.Helper()
	heroBodySeq++
	r.move(c, &pb.MoveTo{X: int32(target.X), Y: int32(target.Y), Deck: deck, Epoch: r.state.Epoch, InputSeq: heroBodySeq})
	res := (<-c.out).GetMoveResult()
	for len(c.out) > 0 {
		<-c.out
	}
	if res == nil || !res.Ok || res.HeroBody == nil {
		t.Fatalf("route to %v rejected: %v", target, res)
	}
	hero := r.state.Life.Actor(playerActorID)
	for i := 0; i < 1200 && hero.Body != nil && hero.Body.Mode == "route"; i++ {
		heroBodyTicks(r, 1, nil)
	}
	if hero.Position != target {
		t.Fatalf("route did not arrive: at %v want %v", hero.Position, target)
	}
}

// Two sub-tick samples (input arrival / publication) and the world tick.
func heroBodyTicks(r *Runtime, n int, sample func()) {
	for i := 0; i < n; i++ {
		for _, ph := range []int64{33_000_000, 66_000_000} {
			r.state.PhaseNS = ph
			r.heroBodyNow()
			if sample != nil {
				sample()
			}
		}
		r.state.PhaseNS = 0
		r.step()
		if sample != nil {
			sample()
		}
	}
}

func heroBodyCheck(t *testing.T, r *Runtime) {
	t.Helper()
	if err := r.validateLifeSave(r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	hero := r.state.Life.Actor(playerActorID)
	if hero.Body == nil {
		return
	}
	for _, cell := range hero.Body.Cells {
		for _, a := range r.state.Life.Population.Actors {
			if a.Materialized && a.Trip == nil && a.Level == hero.Level && a.Position == cell {
				t.Fatalf("population %s stands in the hero body cell %v", a.ID, cell)
			}
		}
	}
}

// Straight lines at any angle: sixteen directions from open floor. While nobody is in the way the body keeps the line to
// the millimetre and walks one cell per move_ticks; a passer-by may only shorten a run (slide), never bend a free one.
func TestHeroBodySteersStraightAtAnyAngle(t *testing.T) {
	r, c := heroBodyHub(t)
	heroBodyGo(t, r, c, behavior.Cell{X: 97, Y: 40}, 0)
	hero := r.state.Life.Actor(playerActorID)
	cell := float64(r.world.Life.Locations[hero.Level].CellMM)
	perTick := cell / float64(r.world.Life.MoveTicks)
	clean := 0
	for k := 0; k < 16; k++ {
		a := float64(k) * math.Pi / 8
		dx, dy := math.Cos(a), math.Sin(a)
		heroBodySteer(t, r, c, "steer", dx, dy)
		x0, y0 := hero.Body.X, hero.Body.Y
		dev, along, free := 0.0, 0.0, true
		heroBodyTicks(r, 9, func() {
			px, py := hero.Body.X-x0, hero.Body.Y-y0
			dev = math.Max(dev, math.Abs(px*dy-py*dx))
			along = px*dx + py*dy
			if len(hero.PendingPath) > 0 {
				free = false
			}
		})
		if math.Abs(along-9*perTick) < 1 && free {
			if dev > 1 {
				t.Fatalf("direction %d: a free run bent by %.2f mm", k, dev)
			}
			clean++
		}
		heroBodySteer(t, r, c, "steer", -dx, -dy)
		heroBodyTicks(r, 9, nil)
		heroBodyCheck(t, r)
	}
	if clean < 10 {
		t.Fatalf("only %d of 16 free straight runs in open floor", clean)
	}
	heroBodySteer(t, r, c, "stop", 0, 0)
	heroBodyTicks(r, 2, nil)
	if hero.Body.Mode != "" || hero.Body.Moving || !hero.Arrived || len(hero.Path) != 0 {
		t.Fatalf("stop did not stop: %+v", hero.Body)
	}
}

// A wall is slid along, not a dead stop: pushing diagonally into the east wall keeps walking north beside it.
func TestHeroBodySlidesAlongWalls(t *testing.T) {
	r, c := heroBodyHub(t)
	heroBodyGo(t, r, c, behavior.Cell{X: 100, Y: 38}, 0)
	hero := r.state.Life.Actor(playerActorID)
	heroBodySteer(t, r, c, "steer", math.Sqrt(.5), -math.Sqrt(.5))
	y0 := hero.Body.Y
	heroBodyTicks(r, 30, nil)
	cell := float64(r.world.Life.Locations[hero.Level].CellMM)
	if hero.Body.X > 103*cell-r.world.Life.HeroBody.RadiusMM+.6 || y0-hero.Body.Y < 1500 {
		t.Fatalf("no slide along the wall: x %.1f y %.1f -> %.1f", hero.Body.X, y0, hero.Body.Y)
	}
	heroBodyCheck(t, r)
}

// A click on the gallery: one pulled-string route over the floor, the stair and the gallery; saves on the stair validate
// and restore exactly, the body arrives on the clicked cell of the upper surface.
func TestHeroBodyRouteClimbsToTheGalleryAndSaves(t *testing.T) {
	r, c := heroBodyHub(t)
	v := r.deckVolume()
	var gallery behavior.DeckSurface
	for _, s := range v.Surfaces {
		if s.Walkable && s.ElevationMM > 0 {
			gallery = s
		}
	}
	if gallery.ID == "" {
		t.Skip("no upper surface")
	}
	target := behavior.Cell{X: 75, Y: gallery.NavRow + 14}
	heroBodySeq++
	r.move(c, &pb.MoveTo{X: int32(target.X), Y: int32(target.Y), Deck: int32(gallery.Index), Epoch: r.state.Epoch, InputSeq: heroBodySeq})
	res := (<-c.out).GetMoveResult()
	for len(c.out) > 0 {
		<-c.out
	}
	if res == nil || !res.Ok || res.HeroBody == nil || len(res.HeroBody.Route) < 3 {
		t.Fatalf("gallery route rejected: %v", res)
	}
	hero := r.state.Life.Actor(playerActorID)
	layers := map[int]bool{}
	saved := false
	for i := 0; i < 1500 && hero.Body.Mode == "route"; i++ {
		heroBodyTicks(r, 1, nil)
		layers[hero.Body.Layer] = true
		if hero.Body.Layer >= len(v.Surfaces) && !saved {
			saved = true
			snap := r.snapshotState()
			data, err := json.Marshal(snap)
			if err != nil {
				t.Fatal(err)
			}
			var back state
			if err := json.Unmarshal(data, &back); err != nil {
				t.Fatal(err)
			}
			if err := r.validateLifeSave(back); err != nil {
				t.Fatalf("save on the stair: %v", err)
			}
			if b := back.Life.Actor(playerActorID).Body; b == nil || b.X != hero.Body.X || b.Y != hero.Body.Y || b.Layer != hero.Body.Layer || len(b.Route) != len(hero.Body.Route) {
				t.Fatal("saved body differs")
			}
		}
		if i%25 == 0 {
			heroBodyCheck(t, r)
		}
	}
	if hero.Position != target || hero.Body.Layer != gallery.Index || !saved || len(layers) < 3 {
		t.Fatalf("gallery not reached by floor+stair+gallery: at %v layer %d layers %v saved %v", hero.Position, hero.Body.Layer, layers, saved)
	}
}

// Through the crowd of an ordinary market: the body never shares a cell with anyone, saves stay valid.
func TestHeroBodyKeepsOutOfPeople(t *testing.T) {
	r, c := heroBodyHub(t)
	hero := r.state.Life.Actor(playerActorID)
	for k := 0; k < 24; k++ {
		a := float64(k*7%16) * math.Pi / 8
		heroBodySteer(t, r, c, "steer", math.Cos(a), math.Sin(a))
		heroBodyTicks(r, 15, func() {
			for _, cell := range hero.Body.Cells {
				for _, o := range r.state.Life.Actors {
					if o.ID != hero.ID && o.OnFloor() && o.Level == hero.Level && o.Position == cell {
						t.Fatalf("%s inside the hero body", o.ID)
					}
				}
			}
		})
		heroBodyCheck(t, r)
	}
}

// An exit of the hub: the body walks its route to the exit cell, the ordinary trip begins and the body is left behind
// (painted locations keep the cell hero); back on the hub a new body stands in the arrival cell.
func TestHeroBodyWalksToAnExitAndTravels(t *testing.T) {
	r, c := heroBodyHub(t)
	hero := r.state.Life.Actor(playerActorID)
	var edge *behavior.LifeEdge
	for i := range r.world.Life.Edges {
		e := &r.world.Life.Edges[i]
		if e.From == hero.Level && e.Mode == "walk" && r.lifeExitKnown(*e) {
			edge = e
			break
		}
	}
	if edge == nil {
		t.Skip("no known walking exit on the hub")
	}
	heroBodySteer(t, r, c, "stop", 0, 0)
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "enter", Destination: edge.ID}); err != nil {
		t.Fatal(err)
	}
	if hero.Body == nil || hero.Body.Mode != "route" || hero.Goal != edge.Exit {
		t.Fatalf("exit did not route the body: %+v", hero.Body)
	}
	left := false
	for i := 0; i < 3000 && !left; i++ {
		heroBodyTicks(r, 1, nil)
		left = hero.Trip != nil || hero.Level != edge.From
		if i%50 == 0 {
			heroBodyCheck(t, r)
		}
	}
	if !left || hero.Body != nil {
		t.Fatalf("hero never left by %s (at %v, body %v)", edge.ID, hero.Position, hero.Body != nil)
	}
}
