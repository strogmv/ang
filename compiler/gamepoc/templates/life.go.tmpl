func (r *Runtime) lifeMove(c *connection, m *pb.MoveTo) {
	result := &pb.PocMoveResult{Epoch: r.state.Epoch, InputSeq: m.InputSeq}
	hero := r.state.Life.Actor(playerActorID)
	if r.heroInCombat() {
		r.combatMove(c, m)
		return
	}
	switch {
	case hero != nil && hero.CombatHold:
		result.Reason = "actor_inactive"
	case r.state.Life.PopulationFailure != "":
		result.Reason = "Симуляция остановлена; загрузите сохранение"
	case m.Epoch != r.state.Epoch:
		result.Reason = "Локация изменилась"
	case m.InputSeq == 0 || m.InputSeq <= c.lastMoveSeq:
		result.Reason = "Устаревшая команда"
	case r.state.Paused:
		result.Reason = "Мир на паузе"
	case hero.Trip != nil:
		result.Reason = "Дождитесь прибытия"
	default:
		c.lastMoveSeq = m.InputSeq
		target := behavior.Cell{X: int(m.X), Y: int(m.Y)}
		// A multi-deck target names its surface; a mismatch (or deck on a planar
		// location) is rejected rather than reinterpreted as another floor.
		deckOK := m.Deck == 0
		if v := r.deckVolume(); v != nil {
			d, ok := v.SurfaceIndex(target)
			deckOK = ok && int32(d) == m.Deck
		}
		if !deckOK || !r.lifeWalkToPoint(target, float64(m.XMm), float64(m.YMm), m.HasMm, m.Run&&!hero.Sneaking, m.InputSeq) {
			result.Reason = "Сюда нельзя пройти"
		} else {
			r.state.LastMoveSeq = m.InputSeq
			result.Ok = true
		}
	}
	if hero != nil && hero.Trip == nil {
		result.HeroBody = r.heroBodyPB(hero)
	}
	r.send(c, &pb.ServerMessage{Msg: &pb.ServerMessage_MoveResult{MoveResult: result}})
	r.sendState(c)
}

// Shared ordinary movement intent: both MoveTo and explicit route Go use the
// same planner, accepted-segment preservation and authoritative cadence.
