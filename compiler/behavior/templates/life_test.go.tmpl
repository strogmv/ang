 if !saved||s.Actor("traveller").Visits["branch"]!=0{t.Fatal("route skipped save or selected unrelated branch")}
 a=s.Actor("traveller");a.Arrived=false;a.OverrideLevel="home";a.OverrideAt=Cell{2,2}
 advanceUntil("home")
 for _,pair:=range pairs[:4]{for _,id:=range []string{pair[0]+"_"+pair[1],pair[1]+"_"+pair[0]}{if !seen[id]{t.Fatalf("required physical transition%s was never crossed",id)}}}
}
