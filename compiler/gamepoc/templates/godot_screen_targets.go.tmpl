// Code generated by ANG. Read-only access points, never command availability.
package poc

import (
	behavior "angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

// This cache belongs only to presentation; it does not fill the simulation's
// route cache. One ordinary static navigation flood serves all visible targets.
type screenAccessRoutes struct {
	Epoch    string
	Level    string
	From     behavior.Cell
	Distance map[behavior.Cell]int64
	Parent   map[behavior.Cell]behavior.Cell
	Tick     int64
}

func (r *Runtime) screenRouteDistances(hero *behavior.LifeActor) map[behavior.Cell]int64 {
	cache := r.screenRoutes
	if cache != nil && cache.Epoch == r.state.Epoch &&
		cache.Level == hero.Level && cache.From == hero.Position && cache.Tick == r.state.Tick {
		return cache.Distance
	}
	blocked := r.state.Life.BlockedCells(hero.Level, hero.ID)
	model := r.state.Life.GateModel(r.world.Life)
	space := model.Space(hero.Level, blocked)
	distance := map[behavior.Cell]int64{hero.Position: 0}
	parent := map[behavior.Cell]behavior.Cell{}
	queue := []behavior.Cell{hero.Position}
	for i := 0; i < len(queue); i++ {
		at := queue[i]
		neighbors := []behavior.Cell{
			{
				X: at.X + 1,
				Y: at.Y,
			},
			{
				X: at.X,
				Y: at.Y + 1,
			},
			{
				X: at.X - 1,
				Y: at.Y,
			},
			{
				X: at.X,
				Y: at.Y - 1,
			},
		}
		neighbors = append(neighbors, space.Links[at]...)
		for _, next := range neighbors {
			if _, seen := distance[next]; seen || !space.CanStand(next) {
				continue
			}
			distance[next] = distance[at] + 1
			parent[next] = at
			queue = append(queue, next)
		}
	}
	r.screenRoutes = &screenAccessRoutes{
		Epoch:    r.state.Epoch,
		Level:    hero.Level,
		From:     hero.Position,
		Distance: distance,
		Parent:   parent,
		Tick:     r.state.Tick,
	}
	return distance
}

// Candidate cells and distances use ordinary server navigation, including current
// occupancy. The reach predicate and authored target position remain unchanged.
func (r *Runtime) screenAccess(msg *pb.PocGameState, at behavior.Cell, candidates []behavior.Cell) *pb.PocWorldAccess {
	a := &pb.PocWorldAccess{
		X:       int32(at.X),
		Y:       int32(at.Y),
		Visible: viewSees(msg.PlayerView, int32(at.X), int32(at.Y)),
	}
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || !hero.OnFloor() {
		return a
	}
	best := int64(1 << 62)
	var distances map[behavior.Cell]int64
	if len(candidates) > 0 {
		distances = r.screenRouteDistances(hero)
	}
	for _, candidate := range candidates {
		if !r.world.Life.Walks(hero.Level, candidate) {
			continue
		}
		distance, connected := distances[candidate]
		if !connected || distance >= best {
			continue
		}
		best = distance
		a.WalkX, a.WalkY = int32(candidate.X), int32(candidate.Y)
		a.Routable = true
		if hero.Position == candidate {
			a.Reachable = true
		}
	}
	if a.Routable && !a.Reachable {
		from := behavior.Cell{
			X: int(a.WalkX),
			Y: int(a.WalkY),
		}
		path := []behavior.Cell{from}
		for from != hero.Position {
			previous, ok := r.screenRoutes.Parent[from]
			if !ok {
				a.Routable = false
				break
			}
			path = append(path, previous)
			from = previous
		}
		if a.Routable && len(path) > 1 {
			next := path[len(path)-2]
			dx, dy := next.X-hero.Position.X, next.Y-hero.Position.Y
			for i := len(path) - 3; i >= 0; i-- {
				if path[i].X-next.X != dx || path[i].Y-next.Y != dy {
					break
				}
				next = path[i]
			}
			a.WalkX, a.WalkY = int32(next.X), int32(next.Y)
			if volume := r.deckVolume(); volume != nil {
				if deck, ok := volume.SurfaceIndex(next); ok {
					a.WalkDeck = int32(deck)
				}
			}
		}
	}
	return a
}
func (r *Runtime) screenReachCells(at behavior.Cell, reach int) []behavior.Cell {
	result := []behavior.Cell{}
	for y := at.Y - reach; y <= at.Y+reach; y++ {
		for x := at.X - reach; x <= at.X+reach; x++ {
			candidate := behavior.Cell{
				X: x,
				Y: y,
			}
			if manhattan(location(at), location(candidate)) <= reach &&
				r.sceneVisible(cell(location(candidate)), cell(location(at))) {
				result = append(result, candidate)
			}
		}
	}
	return result
}
func (r *Runtime) appendScreenTargets(msg *pb.PocGameState) {
	if msg.Life == nil {
		return
	}
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || !hero.OnFloor() {
		return
	}
	for _, row := range msg.SceneAgents {
		row.Access = r.screenAccess(msg, behavior.Cell{
			X: int(row.X),
			Y: int(row.Y),
		}, nil)
	}
	for _, row := range msg.Life.Storefronts {
		for _, shop := range r.world.Inventory.Shopfronts {
			if shop.ID != row.Id {
				continue
			}
			actor := r.state.Life.Actor(shop.Owner)
			if actor != nil && actor.OnFloor() && shop.ServesCell(
				actor.Level,
				inv.Cell{
					X: actor.Position.X,
					Y: actor.Position.Y,
				},
			) {
				row.ActorId = shop.Owner
			}
			anchor, err := r.state.Inventory.Root(
				r.inventoryModelFor(true),
				inv.Location{
					Kind:  "store",
					Store: shop.DisplayStore,
				},
			)
			if err != nil || anchor.Kind != "world" || anchor.Level != hero.Level {
				continue
			}
			at := behavior.Cell{
				X: anchor.At.X,
				Y: anchor.At.Y,
			}
			row.Access = r.screenAccess(msg, at, r.screenReachCells(at, 1))
			row.Access.Reachable = r.inventoryNear(anchor)
		}
	}
	for _, row := range msg.Life.Peddlers {
		for _, p := range r.world.Peddlers.Peddlers {
			if p.Actor != row.Id {
				continue
			}
			actor := r.state.Life.Actor(p.Actor)
			if actor == nil || !actor.OnFloor() || actor.Level != hero.Level {
				continue
			}
			row.Access = r.screenAccess(
				msg,
				actor.Position,
				r.screenReachCells(actor.Position, r.world.Peddlers.ReachCells),
			)
		}
	}
	// story memory: a person who has something to say — walk up close, then the talk opens
	for _, row := range msg.Life.TalkTargets {
		actor := r.state.Life.Actor(row.Id)
		if actor == nil || !actor.OnFloor() || actor.Level != hero.Level {
			continue
		}
		reach := 3
		if conv, ok := r.talkAvailable(row.Id); ok && r.world.Conversations[conv] != nil {
			reach = min(reach, r.world.Conversations[conv].Reach)
		}
		row.Access = r.screenAccess(msg, actor.Position, r.screenReachCells(actor.Position, reach))
	}
	for _, row := range msg.Life.Vending {
		for _, unit := range r.world.Vending.Units {
			if unit.ID != row.Id || hero.Level != r.world.Vending.Level {
				continue
			}
			candidates := []behavior.Cell{}
			for _, cell := range unit.Approach {
				candidates = append(candidates, behavior.Cell{
					X: cell.X,
					Y: cell.Y,
				})
			}
			row.Access = r.screenAccess(
				msg,
				behavior.Cell{
					X: unit.Panel.X,
					Y: unit.Panel.Y,
				},
				candidates,
			)
		}
	}
	for _, row := range msg.Life.MedicalUnits {
		if unit := r.world.MedicalCapsules.unit(row.Id); unit != nil && unit.LevelID == hero.Level {
			row.Access = r.screenAccess(msg, unit.ScanCell, []behavior.Cell{unit.ScanCell})
			row.Access.WorldX = unit.InsidePose.X
			row.Access.WorldY = unit.InsidePose.Y
			row.Access.WorldZ = unit.InsidePose.Z
			row.Access.UseWorld = true
		}
	}
	for _, row := range msg.Life.SanitaryUnits {
		if unit := r.world.SanitaryServices.unit(row.Id); unit != nil && unit.LevelID == hero.Level {
			row.Access = r.screenAccess(msg, unit.EntryCell, []behavior.Cell{unit.EntryCell})
			row.Access.WorldX = unit.InsidePose.X
			row.Access.WorldY = unit.InsidePose.Y
			row.Access.WorldZ = unit.InsidePose.Z
			row.Access.UseWorld = true
		}
	}
	for _, row := range msg.Life.Inspections {
		row.Access = r.screenAccess(msg, behavior.Cell{
			X: int(row.X),
			Y: int(row.Y),
		}, nil)
	}
}
