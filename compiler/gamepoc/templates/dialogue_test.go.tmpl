// dialogueCustody: the custody conversation on the return day, the hero a metre from the guard; prepare runs before the
// conversation opens (the inner voices hear the hero's skills at that moment).
func dialogueCustody(t *testing.T, prepare func(*Runtime)) *Runtime {
	t.Helper()
	r := encounterFixture(t)
	if r.world.DialogueRules == nil {
		t.Skip("no conversation rules")
	}
	e := r.world.CalendarEncounter
	dialogueDayEleven.once.Do(func() {
		base := encounterFixture(t)
		encounterAdvanceTo(t, base, (e.FirstDays+e.MissingDays)*86400+e.Morning+1200)
		dialogueDayEleven.state = base.snapshotState()
		dialogueDayEleven.ok = true
	})
	if !dialogueDayEleven.ok {
		t.Fatal("no return day")
	}
	r.state = dialogueDayEleven.state
	r.state = r.snapshotState()
	// tests pass the game's check value explicitly (a new game draws its own)
	r.state.CheckSeed = 1
	peddlerPlace(t, r, playerActorID, inv.Cell{X: e.GuardAt.At.X, Y: e.GuardAt.At.Y})
	h := r.state.Life.Actor(playerActorID)
	h.Position.X += 2
	h.Goal = h.Position
	h.Body = nil
	r.syncLifeHero()
	if prepare != nil {
		prepare(r)
	}
	r.calendarEncounterAfterFrame()
	if r.state.CalendarEncounter.Phase != "conversation" {
		t.Fatalf("not assigned: %+v", r.state.CalendarEncounter)
	}
	return r
}

func dialogueSetSkill(r *Runtime, skill string, value int) {
	a := r.state.Life.Development.Actors[playerActorID]
	v := a.Skills[skill]
	v.ValueMilli = int64(value) * 1000
	a.Skills[skill] = v
}

