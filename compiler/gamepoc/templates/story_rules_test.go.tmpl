			varyaOpen(t, r, "e.seedlings")
			varyaChoose(t, r, "no")
			r.talkDrop()
			due := r.state.Memory.Facts["fact.varya.complaint_open"].First + 72*3600
			r.state.Life.Seconds = due - rate - 60
			r.state.Tick++
			if err := r.advanceLifeFrameBy(rate); err != nil {
				t.Fatal(err)
			}
			if r.state.Memory.Facts["fact.varya.stall_restricted"].Count != 0 {
				t.Fatal("deadline fired early")
			}
			r.state.Life.Seconds = due - rate
			r.state.Tick++
