// Code generated by ANG. Emergency response must walk, save, and return to life.
package behavior

import (
	"encoding/json"
	"reflect"
	"testing"
)

func TestLifeSafetyWalksWithoutTeleportAndResumes(t *testing.T) {
	m := lifeFixture()
	m.Actors[1].Steps = m.Actors[1].Steps[:1]
	s := m.Start()
	s.ControlledActorID = "one"
	start := s.Actor("two").Position
	response := LifeSafetyOverride{Level: "a", Goal: Cell{4, 2}, Until: 20, Activity: "shelter", LabelKey: "life.combat.seek_safety", Reason: "heard impact", EncounterID: "encounter.1"}
	if err := s.ApplySafety(m, "two", response); err != nil {
		t.Fatal(err)
	}
	if s.Actor("two").Position != start {
		t.Fatal("response teleported a body")
	}
	moved := false
	for tick := int64(1); tick <= 15; tick++ {
		before := s.Actor("two").Position
		s.Advance(m, tick)
		after := s.Actor("two").Position
		if before != after {
			moved = true
			if !m.Adjacent("a", before, after) {
				t.Fatal("response skipped physical steps")
			}
		}
		if err := s.Validate(m, tick); err != nil {
			t.Fatal(err)
		}
	}
	if !moved || s.Actor("two").Position != response.Goal || s.Actor("two").Activity != "shelter" {
		t.Fatal("safety destination was not physically reached")
	}
	clone := s.Clone()
	clone.Actor("two").Safety.Goal = Cell{0, 0}
	if s.Actor("two").Safety.Goal != response.Goal {
		t.Fatal("clone aliases safety override")
	}
	raw, _ := json.Marshal(s)
	var restored LifeState
	if err := json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	for tick := int64(16); tick <= 40; tick++ {
		s.Advance(m, tick)
		restored.Advance(m, tick)
	}
	got, _ := json.Marshal(s)
	want, _ := json.Marshal(restored)
	if string(got) != string(want) {
		t.Fatal("safety resume changed after load")
	}
	if s.Actor("two").Safety != nil || s.Actor("two").Position != start || s.Actor("two").Activity != "rest" {
		t.Fatal("ordinary schedule did not resume after local danger expired")
	}
}
func TestLifeSafetyRejectsControlledUnknownAndUnreachable(t *testing.T) {
	m := lifeFixture()
	m.Locations["a"] = LifeLocation{Name: "A", Terrain: []string{"..#..", "..#..", "..#.."}}
	s := m.Start()
	s.ControlledActorID = "one"
	before := s.Clone()
	response := LifeSafetyOverride{Level: "a", Goal: Cell{4, 2}, Until: 20, Activity: "shelter", LabelKey: "life.combat.seek_safety", Reason: "impact"}
	for _, id := range []string{"one", "missing", "two"} {
		if s.ApplySafety(m, id, response) == nil {
			t.Fatal("invalid response accepted", id)
		}
	}
	if !reflect.DeepEqual(before, s) {
		t.Fatal("rejected response mutated life")
	}
}
func TestPopulationSafetyAndDownBodyKeepPhysicalPositionAcrossLOD(t *testing.T) {
	p, l := populationFixture()
	l.Population = p
	s, err := l.StartWithPopulation(9, "base")
	if err != nil {
		t.Fatal(err)
	}
	var actor *PopulationActor
	for i := range s.Population.Actors {
		a := &s.Population.Actors[i]
		if a.Materialized {
			actor = a
			break
		}
	}
	if actor == nil {
		t.Fatal("no physical resident")
	}
	id := actor.ID
	start := actor.Position
	goal := Cell{start.X + 3, start.Y}
	if !l.Walks(actor.Level, goal) {
		goal = Cell{start.X - 3, start.Y}
	}
	response := LifeSafetyOverride{Level: actor.Level, Goal: goal, Until: 100, Activity: "shelter", LabelKey: "life.combat.seek_safety", Reason: "local explosion"}
	if err = s.ApplySafety(l, id, response); err != nil {
		t.Fatal(err)
	}
	if actor.Position != start {
		t.Fatal("population safety teleported")
	}
	for tick := int64(1); tick <= 20; tick++ {
		s.AdvanceWithTravelBy(l, tick, 1, nil, nil)
		if err = s.AdvancePopulation(l, "base"); err != nil {
			t.Fatal(err)
		}
	}
	if actor.Position != goal || actor.Activity != "shelter" {
		t.Fatalf("population did not walk to safety: %+v", actor)
	}
	actor.CombatHold = true
	actor.Safety = nil
	actor.Activity = "down"
	actor.Path = nil
	fixed := actor.Position
	if s.courtesyPopulationWilling(l, *actor, "base") {
		t.Fatal("down body may not be pushed by courtesy")
	}
	for tick := int64(21); tick <= 30; tick++ {
		s.AdvanceWithTravelBy(l, tick, 1, nil, nil)
		if err = s.AdvancePopulation(l, "base"); err != nil {
			t.Fatal(err)
		}
	}
	if actor.Position != fixed || actor.Activity != "down" {
		t.Fatal("down resident resumed routine")
	}
	// Moving the observer changes LOD, not the down body's physical cell.
	s.Actor("base").Level = "b"
	s.Actor("base").Position = Cell{30, 0}
	s.Actor("base").Goal = Cell{30, 0}
	if err = s.AdvancePopulation(l, "base"); err != nil {
		t.Fatal(err)
	}
	if actor.Materialized || !s.BlockedCells(actor.Level, "")[fixed] || actor.Position != fixed {
		t.Fatal("LOD lost persistent body occupancy")
	}
	s.Actor("base").Level = "a"
	s.Actor("base").Position = Cell{31, 0}
	s.Actor("base").Goal = Cell{31, 0}
	if err = s.AdvancePopulation(l, "base"); err != nil {
		t.Fatal(err)
	}
	if !actor.Materialized || actor.Position != fixed {
		t.Fatal("LOD moved a down body on reentry")
	}
}
