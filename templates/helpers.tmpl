type contextKey string

const AuthContextKey contextKey = "auth"

type AuthClaims struct {
	UserID    string
	CompanyID string
	Roles     []string
	Perms     []string
}

// GetUserID extracts user ID from context.
func GetUserID(ctx context.Context) string {
	if claims, ok := ctx.Value(AuthContextKey).(*AuthClaims); ok {
		return claims.UserID
	}
	return "system"
}

// GetCompanyID extracts company ID from context.
func GetCompanyID(ctx context.Context) string {
	if claims, ok := ctx.Value(AuthContextKey).(*AuthClaims); ok {
		return claims.CompanyID
	}
	return ""
}

// GetID attempts to extract an "ID" field from any struct or pointer to struct.
func GetID(v any) string {
	if v == nil {
		return ""
	}
	rv := reflect.ValueOf(v)
	if rv.Kind() == reflect.Ptr {
		if rv.IsNil() {
			return ""
		}
		rv = rv.Elem()
	}
	if rv.Kind() != reflect.Struct {
		return fmt.Sprint(v)
	}
	f := rv.FieldByName("ID")
	if f.IsValid() && f.Kind() == reflect.String {
		return f.String()
	}
	return ""
}

// GetDedupeKey attempts to find a suitable unique key for idempotency in a request struct.
func GetDedupeKey(v any) string {
	if v == nil {
		return ""
	}
	rv := reflect.ValueOf(v)
	if rv.Kind() == reflect.Ptr {
		if rv.IsNil() {
			return ""
		}
		rv = rv.Elem()
	}
	if rv.Kind() != reflect.Struct {
		return ""
	}
	for _, name := range []string{"DedupeKey", "DedupeID", "ID", "RequestID"} {
		f := rv.FieldByName(name)
		if f.IsValid() && f.Kind() == reflect.String && f.String() != "" {
			return f.String()
		}
	}
	for i := 0; i < rv.NumField(); i++ {
		f := rv.Field(i)
		fieldName := rv.Type().Field(i).Name
		if len(fieldName) > 2 && fieldName[len(fieldName)-2:] == "ID" {
			if f.Kind() == reflect.String && f.String() != "" {
				return f.String()
			}
		}
	}
	return ""
}

// Marshal encodes an object to JSON string.
func Marshal(v interface{}) string {
	b, _ := json.Marshal(v)
	return string(b)
}

// Unmarshal decodes JSON bytes to an object.
func Unmarshal(data []byte, v interface{}) error {
	return json.Unmarshal(data, v)
}

// AssignKeeping is Assign onto a loaded struct (dst points at it through any
// number of pointers) that leaves the named fields as they were: the fields
// a request body must not write onto a row — secrets, which the body never
// carries, and @managed() service fields (roles, statuses).
func AssignKeeping(dst interface{}, src interface{}, keep ...string) error {
	before, loaded := structBehind(reflect.ValueOf(dst))
	saved := make([]reflect.Value, len(keep))
	if loaded {
		for i, name := range keep {
			if f := before.FieldByName(name); f.IsValid() {
				saved[i] = copyValue(f)
			}
		}
	}
	if err := Assign(dst, src); err != nil {
		return err
	}
	after, ok := structBehind(reflect.ValueOf(dst))
	if !loaded || !ok {
		return nil
	}
	for i, name := range keep {
		if f := after.FieldByName(name); saved[i].IsValid() && f.IsValid() && f.CanSet() {
			f.Set(saved[i])
		}
	}
	return nil
}

// structBehind follows pointers to a struct; ok is false at a nil pointer or
// a value that is no struct.
func structBehind(v reflect.Value) (reflect.Value, bool) {
	for v.Kind() == reflect.Ptr || v.Kind() == reflect.Interface {
		if v.IsNil() {
			return reflect.Value{}, false
		}
		v = v.Elem()
	}
	return v, v.Kind() == reflect.Struct
}

// copyValue copies a field so that decoding into the original (which reuses
// a slice's backing array) cannot change the copy.
func copyValue(f reflect.Value) reflect.Value {
	out := reflect.New(f.Type()).Elem()
	switch f.Kind() {
	case reflect.Slice:
		if !f.IsNil() {
			cp := reflect.MakeSlice(f.Type(), f.Len(), f.Len())
			reflect.Copy(cp, f)
			out.Set(cp)
		}
	case reflect.Map:
		if !f.IsNil() {
			cp := reflect.MakeMapWithSize(f.Type(), f.Len())
			iter := f.MapRange()
			for iter.Next() {
				cp.SetMapIndex(iter.Key(), iter.Value())
			}
			out.Set(cp)
		}
	default:
		out.Set(f)
	}
	return out
}

// Assign copies src into dst pointer.
// If types are directly assignable/convertible, it uses reflection.
// Otherwise falls back to JSON roundtrip for structurally compatible payloads.
func Assign(dst interface{}, src interface{}) error {
	if dst == nil {
		return fmt.Errorf("helpers.Assign: dst is nil")
	}
	dv := reflect.ValueOf(dst)
	if dv.Kind() != reflect.Ptr || dv.IsNil() {
		return fmt.Errorf("helpers.Assign: dst must be non-nil pointer")
	}
	if src == nil {
		dv.Elem().Set(reflect.Zero(dv.Elem().Type()))
		return nil
	}

	sv := reflect.ValueOf(src)
	if sv.Type().AssignableTo(dv.Elem().Type()) {
		dv.Elem().Set(sv)
		return nil
	}
	if sv.Type().ConvertibleTo(dv.Elem().Type()) {
		dv.Elem().Set(sv.Convert(dv.Elem().Type()))
		return nil
	}

	b, err := json.Marshal(src)
	if err != nil {
		return err
	}
	// An unset time.Time marshals as "0001-01-01T00:00:00Z", and a response
	// field typed string carried that out as if it were a date: every client
	// had to learn to read year one as "none". The key is dropped instead, so
	// the destination keeps its own zero — "" for a string, the zero time for
	// a time — which is what "not set" already means on either side.
	if bytes.Contains(b, []byte(zeroTimeJSON)) {
		var generic any
		if json.Unmarshal(b, &generic) == nil {
			if cleaned, marshalErr := json.Marshal(dropZeroTimes(generic)); marshalErr == nil {
				b = cleaned
			}
		}
	}
	return json.Unmarshal(b, dst)
}

const zeroTimeJSON = `"0001-01-01T00:00:00Z"`

func dropZeroTimes(v any) any {
	switch x := v.(type) {
	case map[string]any:
		for k, item := range x {
			if s, ok := item.(string); ok && s == "0001-01-01T00:00:00Z" {
				delete(x, k)
				continue
			}
			x[k] = dropZeroTimes(item)
		}
		return x
	case []any:
		for i, item := range x {
			x[i] = dropZeroTimes(item)
		}
		return x
	default:
		return v
	}
}

// JSONPathGet resolves a minimal dot/index JSONPath like $.user.email or $.items[0].id.
// Missing object keys return nil without error, matching Go map lookup semantics used by emitted flows.
func JSONPathGet(input any, path string) (any, error) {
	path = strings.TrimSpace(path)
	path = strings.TrimPrefix(path, "$")
	path = strings.TrimPrefix(path, ".")
	if path == "" {
		return input, nil
	}

	cur := input
	for _, part := range strings.Split(path, ".") {
		if part == "" {
			continue
		}
		name := part
		idx := -1
		if lb := strings.Index(part, "["); lb >= 0 && strings.HasSuffix(part, "]") {
			name = part[:lb]
			idxStr := part[lb+1 : len(part)-1]
			parsed, err := strconv.Atoi(idxStr)
			if err != nil {
				return nil, fmt.Errorf("jsonpath.Get: invalid index %q", idxStr)
			}
			idx = parsed
		}
		if name != "" {
			obj, ok := cur.(map[string]any)
			if !ok {
				return nil, fmt.Errorf("jsonpath.Get: expected object at %s", name)
			}
			cur = obj[name]
		}
		if idx >= 0 {
			arr, ok := cur.([]any)
			if !ok || idx >= len(arr) {
				return nil, fmt.Errorf("jsonpath.Get: index out of range")
			}
			cur = arr[idx]
		}
	}

	return cur, nil
}

// CopyNonEmptyFields copies non-zero fields from src to dst using reflection.
func CopyNonEmptyFields(src, dst interface{}) {
	srcVal := reflect.ValueOf(src)
	dstVal := reflect.ValueOf(dst)
	if srcVal.Kind() == reflect.Ptr {
		srcVal = srcVal.Elem()
	}
	if dstVal.Kind() == reflect.Ptr {
		dstVal = dstVal.Elem()
	}
	if !dstVal.CanSet() {
		return
	}
	srcType := srcVal.Type()
	for i := 0; i < srcVal.NumField(); i++ {
		fieldName := srcType.Field(i).Name
		if fieldName == "ID" || fieldName == "CreatedAt" || fieldName == "DeletedAt" {
			continue
		}
		srcField := srcVal.Field(i)
		dstField := dstVal.FieldByName(fieldName)
		if !dstField.IsValid() || !dstField.CanSet() {
			continue
		}
		if srcField.IsZero() {
			continue
		}
		if dstField.Type() == srcField.Type() {
			dstField.Set(srcField)
		}
	}
}

// IsZero reports whether value is a Go zero value.
func IsZero(v interface{}) bool {
	if v == nil {
		return true
	}
	return reflect.ValueOf(v).IsZero()
}

var validate = validator.New()

// Validate checks a struct for validation tags.
func Validate(s interface{}) error {
	return validate.Struct(s)
}

// MatchEvent checks if the event matches the correlation criteria (e.g. "OrderID=req.ID").
func MatchEvent(evt any, match string) bool {
	if match == "" {
		return true
	}
	if evt == nil {
		return false
	}

	// Simple implementation: parse "key=value" and check if evt.key == value
	parts := strings.Split(match, "=")
	if len(parts) != 2 {
		return true
	}

	key := strings.TrimSpace(parts[0])
	val := strings.Trim(strings.TrimSpace(parts[1]), "\"")

	rv := reflect.ValueOf(evt)
	for rv.Kind() == reflect.Ptr {
		if rv.IsNil() {
			return false
		}
		rv = rv.Elem()
	}
	if rv.Kind() != reflect.Struct {
		return false
	}

	f := rv.FieldByName(key)
	if !f.IsValid() {
		// Try lowercase
		f = rv.FieldByName(strings.Title(key))
		if !f.IsValid() {
			return false
		}
	}

	return fmt.Sprint(f.Interface()) == val
}

// IsOneOf reports whether v is equal to one of the allowed values.
func IsOneOf(v string, allowed []string) bool {
	for _, a := range allowed {
		if v == a {
			return true
		}
	}
	return false
}

// _ is a compile guard to ensure strings is used.
var _ = strings.ToLower

// KeyedMutexes hands out one mutex per key — a tender, an image source — and
// forgets the key as soon as nobody holds or waits for it. The registries it
// replaces kept every key they ever saw, so a process that locked per tender
// grew by one mutex per tender for as long as it ran. The zero value is ready
// to use.
type KeyedMutexes struct {
	mu      sync.Mutex
	entries map[string]*keyedMutexEntry
}

type keyedMutexEntry struct {
	mu   sync.Mutex
	refs int // holders and waiters; guarded by KeyedMutexes.mu
}

// KeyedMutex is one caller's handle on a key's mutex. Lock (or a successful
// TryLock) must be paired with Unlock, as with sync.Mutex.
type KeyedMutex struct {
	set   *KeyedMutexes
	key   string
	entry *keyedMutexEntry
}

// For returns a handle on key's mutex. Nothing is registered until the handle
// locks.
func (k *KeyedMutexes) For(key string) *KeyedMutex {
	return &KeyedMutex{set: k, key: key}
}

// Len is the number of keys currently held or waited for.
func (k *KeyedMutexes) Len() int {
	k.mu.Lock()
	defer k.mu.Unlock()
	return len(k.entries)
}

func (k *KeyedMutexes) acquire(key string) *keyedMutexEntry {
	k.mu.Lock()
	defer k.mu.Unlock()
	if k.entries == nil {
		k.entries = map[string]*keyedMutexEntry{}
	}
	entry := k.entries[key]
	if entry == nil {
		entry = &keyedMutexEntry{}
		k.entries[key] = entry
	}
	entry.refs++
	return entry
}

func (k *KeyedMutexes) release(key string, entry *keyedMutexEntry) {
	k.mu.Lock()
	defer k.mu.Unlock()
	entry.refs--
	if entry.refs <= 0 && k.entries[key] == entry {
		delete(k.entries, key)
	}
}

// Lock waits for the key's mutex.
func (m *KeyedMutex) Lock() {
	entry := m.set.acquire(m.key)
	entry.mu.Lock()
	m.entry = entry
}

// TryLock takes the key's mutex if it is free.
func (m *KeyedMutex) TryLock() bool {
	entry := m.set.acquire(m.key)
	if !entry.mu.TryLock() {
		m.set.release(m.key, entry)
		return false
	}
	m.entry = entry
	return true
}

// Unlock releases the key's mutex and, when it was the last one interested,
// the key itself.
func (m *KeyedMutex) Unlock() {
	entry := m.entry
	if entry == nil {
		panic("helpers: unlock of an unlocked KeyedMutex")
	}
	m.entry = nil
	entry.mu.Unlock()
	m.set.release(m.key, entry)
}

// ── Model calls (openai.Chat) ────────────────────────────────────────────────

// LLMRound is one request of an openai.Chat step, as its budget hook sees it
// before the request is sent.
type LLMRound struct {
	// Provider is "openai".
	Provider string
	// Model is the model the request names.
	Model string
	// Round counts the requests of one step from 0 (a tool loop makes several).
	Round int
	// MaxOutputTokens is the most the provider may answer with, reasoning
	// included (max_completion_tokens / max_tokens).
	MaxOutputTokens int
	// RequestBytes is the size of the JSON body. A token is at least one byte
	// of it, so this bounds the input tokens from above.
	RequestBytes int
}

// LLMUsage is what the provider reported for one request; zero when the
// request failed before an answer.
type LLMUsage struct {
	// InputTokens are the prompt tokens, CachedInputTokens included.
	InputTokens       int
	CachedInputTokens int
	// OutputTokens are the completion tokens, ReasoningTokens included.
	OutputTokens    int
	ReasoningTokens int
	TotalTokens     int
}

// LLMRoundUsage pairs a request with its usage (openai.Chat output_rounds).
type LLMRoundUsage struct {
	Round LLMRound
	Usage LLMUsage
}

// LLMBudget is the budget hook of an openai.Chat step (budget:). Reserve runs
// before every request; an error stops the step with that error and the
// request is not sent. Settle runs after every request that was reserved,
// with the usage and the request's error (nil on success), so a reservation
// is always closed; an error from Settle fails a step whose request succeeded.
type LLMBudget interface {
	Reserve(ctx context.Context, round LLMRound) error
	Settle(ctx context.Context, round LLMRound, usage LLMUsage, callErr error) error
}

// OpenAIURL is the OpenAI API address of path ("/chat/completions"):
// OPENAI_BASE_URL (for example a test double, "http://127.0.0.1:8164/v1"),
// else https://api.openai.com/v1.
func OpenAIURL(path string) string {
	base := strings.TrimRight(strings.TrimSpace(os.Getenv("OPENAI_BASE_URL")), "/")
	if base == "" {
		base = "https://api.openai.com/v1"
	}
	return base + path
}
