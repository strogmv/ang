	key := u.cellKey()
	for id, p := range r.state.Sanitary.Users {
		if id == except {
			continue
		}
		if other := cfg.unit(p.UnitID); other != nil && other.cellKey() == key {
			load++
			busy = busy || p.Phase != "queued"
		}
	}
	return load, busy
