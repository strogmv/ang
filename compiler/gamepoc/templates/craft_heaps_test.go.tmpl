// The heap slots of the produce stalls (world.market_goods stalls with heaps): the fill is the real stock of the
// stall's display, the slots are packed and laid out one by one, the consignment tops the stall up every morning.

func craftHeapStall(t *testing.T, r *Runtime) (craftStallDef, inv.Shopfront) {
	t.Helper()
	for _, s := range r.world.Craft.Stalls {
		if len(s.Heaps) == 0 {
			continue
		}
		for _, sh := range r.world.Inventory.Shopfronts {
			if sh.ID == s.Shop {
				return s, sh
			}
		}
	}
	t.Skip("content has no stall with heap slots")
	return craftStallDef{}, inv.Shopfront{}
}

func TestCraftHeapLevels(t *testing.T) {
