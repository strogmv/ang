// A rumour: a person who heard of Prokhor's absence tells the hero; the line is the rumour's, with its source word; once
// a confirmed fact refutes it, the refuted rumour is no longer what he knows of the place.
func TestLoadingScreenLineRumourAndRefuted(t *testing.T) {
	r := loadingFixture(t)
	const missing = "fact.prokhor.missing"
