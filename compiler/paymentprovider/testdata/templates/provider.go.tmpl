func {{ .ConstructorName }}({{ .ConstructorParams }}) *{{ .StructName }} {
	return &{{ .StructName }}{
		txPathLogger: txPathLogger,
{{- if .HasTDSRedirector }}
		tdsRedirector: tdsRedirector,
{{- end }}
{{- if .HasOTPFormRedirector }}
		formRedirector: formRedirector,
{{- end }}
{{- if .HasPaymentMethodSelector }}
		pmsRedirector: pmsRedirector,
{{- end }}
		httpClient: httpcli.NewHTTPTnxClient(ppSID, txPathLogger),
		log:        logrus.WithFields(logrus.Fields{"source": "{{ .Source }}"}),
{{- if and .CheckStatusThrottleConfig .CheckStatusThrottleConfig.Enabled }}
		lastStatusByTx: make(map[string]time.Time),
{{- end }}
{{- if and .Async3DSConfig .Async3DSConfig.Enabled }}
		async3DSNextCheck: make(map[string]time.Time),
{{- end }}
	}
}

func (pp *{{ .StructName }}) parseProviderSecrets(mc *model.MerchantCreds, op string) (*apiSecrets, error) {
	s, err := parseSecrets(mc.Secret)
	if err != nil {
		return nil, fmt.Errorf("parsing secrets for %s %s: %w", ppSID, op, err)
	}
	return s, nil
}

{{ if .HTTPAuth -}}
func (pp *{{ .StructName }}) authHeaders(secrets *apiSecrets) httpcli.Headers {
	h := httpcli.NewHeaders().Add("Content-Type", "{{ .HTTPAuth.ContentType }}")
{{- if eq .HTTPAuth.Type "header_token" }}
	return h.Add("{{ .HTTPAuth.Header }}", secrets.{{ .HTTPAuth.SecretKeyField }})
{{- else if eq .HTTPAuth.Type "bearer" }}
	return h.Add("Authorization", "{{ .HTTPAuth.Prefix }}"+secrets.{{ .HTTPAuth.SecretKeyField }})
{{- else if eq .HTTPAuth.Type "basic" }}
	return h.AddBasicAuth(secrets.{{ .PubKeyField }}, secrets.{{ .SecretKeyField }})
{{- else }}
	return h.Add("{{ .HTTPAuth.Header }}", secrets.{{ .HTTPAuth.SecretKeyField }})
{{- end }}
}
{{ else if .UseBasicAuth -}}
func (pp *{{ .StructName }}) authHeaders(secrets *apiSecrets) httpcli.Headers {
	return httpcli.NewHeaders().
		Add("Content-Type", "application/json").
		AddBasicAuth(secrets.{{ .PubKeyField }}, secrets.{{ .SecretKeyField }})
}
{{ else if .UseMacanP2P -}}
func (pp *{{ .StructName }}) authHeaders(secrets *apiSecrets) httpcli.Headers {
	return httpcli.NewHeaders().
		Add("Content-Type", "application/json").
		Add("Authorization-Token", secrets.apiToken)
}
{{ end -}}

