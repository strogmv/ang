		row := d.Chance[level.ID]
		if len(row) < 101 {
			continue
		}
		chance := row[skill]
		if chance >= row[100] {
			continue
		}
		if chance < w.Line.HopePercent || shown >= limit {
			break
		}
		parts = append(parts, heroFileFormat(text(w.Text.Level), "{difficulty}", text(level.Text), "{chance}", strconv.Itoa(chance)))
		shown++
	}
	return strings.Join(parts, r.localText(locale, w.Text.Separator, " · "))
}

// heroFileView: the whole file screen for a choice. Mode "new": any choice (none — the hero of the book). Mode
// "recheck": the running game's first check — the past and the portrait are its own and locked.
func (r *Runtime) heroFileView(locale string, req *pb.PocHeroFileRequest) *pb.PocHeroFileView {
	w := r.world.HeroFile
	v := &pb.PocHeroFileView{RequestId: req.RequestId, Mode: "new"}
	if w == nil {
		v.Problem = "the world has no hero file"
		return v
	}
	text := func(key string) string { return r.localText(locale, key, key) }
	sep := r.localText(locale, w.Text.Separator, " · ")
	c, err := w.read(req.Choice)
	if err != nil {
		v.Problem = r.localError(locale, err)
		c = w.Default.clone()
	}
	if req.Mode == "recheck" {
		v.Mode, v.PastLocked = "recheck", true
		f := r.state.HeroFile
		if f == nil || f.Legacy || f.Recheck != "offered" || !r.state.Active || r.heroInDanger() {
			v.Problem = text(w.Text.NoRecheck)
		} else {
			if req.Choice == nil || req.Choice.Profile == "" || err != nil {
				c = f.Choice.clone()
			}
			if !reflect.DeepEqual(c.Episodes, f.Choice.Episodes) || c.Portrait != f.Choice.Portrait {
				c.Episodes, c.Portrait = append([]string(nil), f.Choice.Episodes...), f.Choice.Portrait
				if v.Problem == "" {
					v.Problem = text(w.Text.PastLocked)
				}
			}
		}
	}
	if v.Problem == "" {
		if err := w.complete(c); err != nil {
			v.Problem = r.localError(locale, err)
		}
	}
	v.Ready = v.Problem == ""
	v.Choice = c.wire()
	v.Header, v.ChipTraining, v.ResetText, v.Club = text(w.Text.Header), text(w.Text.Training), text(w.Text.Reset), text(w.Club)
	confirm := w.Text.Confirm
	if v.Mode == "recheck" {
		confirm = w.Recheck.Confirm
	}
	v.Confirm = text(confirm)
	v.StartCap = int32(w.Strengths.StartCap)
	v.StrengthsLeft = int32(max(0, w.Strengths.Count-len(c.Strengths)))
	if d := r.world.DialogueRules; d != nil {
		for _, level := range d.Difficulties {
			if level.Value <= w.Strengths.StartCap {
				v.Marks = append(v.Marks, int32(level.Value))
			}
		}
	}
	chosen, _ := w.profile(c.Profile)
	v.Summary = text(chosen.Summary)
	for _, p := range w.Profiles {
		o := &pb.PocHeroFileOption{Id: p.ID, Title: text(p.Title), Text: r.heroFileProfileSkills(locale, p, sep), Selected: p.ID == c.Profile, Icon: p.Icon, Locked: false}
		if p.Canon {
			o.Recommended = text(w.Text.Recommended)
		}
		o.Give = []*pb.PocHeroFileGive{{Kind: "plus", Text: text(p.Summary)}}
		v.Profiles = append(v.Profiles, o)
	}
	values := w.start(c)
	for _, s := range w.Skills {
		v.Skills = append(v.Skills, r.heroFileSkill(locale, c, chosen, s, values[s]))
	}
	for _, e := range w.Episodes {
		v.Episodes = append(v.Episodes, &pb.PocHeroFileOption{Id: e.ID, Title: text(e.Title), Text: text(e.Plus), Minus: text(e.Minus), Selected: heroFileHas(c.Episodes, e.ID), Locked: v.PastLocked,
			Give: []*pb.PocHeroFileGive{{Kind: "plus", Text: text(e.Plus)}, {Kind: "minus", Text: text(e.Minus)}, {Kind: "first", Text: heroFileFormat(text(w.Text.First), "{where}", text(e.First))}}})
	}
	for _, t := range w.Traits {
		v.Traits = append(v.Traits, &pb.PocHeroFileOption{Id: t.ID, Title: text(t.Title), Text: text(t.Plus), Minus: text(t.Minus), Selected: c.Trait == t.ID,
			Give: []*pb.PocHeroFileGive{{Kind: "plus", Text: text(t.Plus)}, {Kind: "minus", Text: text(t.Minus)}, {Kind: "first", Text: heroFileFormat(text(w.Text.First), "{where}", text(t.First))}}})
	}
	v.Traits = append(v.Traits, &pb.PocHeroFileOption{Id: "", Title: text(w.NoTrait), Selected: c.Trait == "", Give: []*pb.PocHeroFileGive{{Kind: "none", Text: text(w.NoTrait)}}})
	for _, p := range w.Portraits {
		v.Portraits = append(v.Portraits, &pb.PocHeroFileOption{Id: p.ID, Image: p.Image, Selected: p.ID == c.Portrait, Locked: v.PastLocked})
	}
	return v
}

// heroFileFight: for the skill the hero's combat profile develops, the server's chance (whole percent, at most 100) of
// the file's weapon at the file's opponent before cover and armor (CombatRules.HitOdds), with the skill at before and at
// after — the fight number a strength gives.
func (r *Runtime) heroFileFight(skill string, before, after int) (int, int, bool) {
	w, c := r.world.HeroFile, r.world.CombatRuntime
	profile, ok := c.Profiles[c.Actors[playerActorID]]
	opponent, has := c.Profiles[w.Fight.Opponent]
	weapon, armed := c.Weapons[w.Fight.Weapon]
	if !ok || !has || !armed || profile.Develops == nil || profile.Develops.Skill != skill {
		return 0, 0, false
	}
	chance := func(value int) int {
		hero := behavior.Combatant{Skill: min(100, max(0, profile.Skill+value-profile.Develops.Base)), Weapon: weapon}
		odds := c.Rules.HitOdds(hero, behavior.Combatant{Skill: opponent.Skill, Weapon: opponent.Weapon}, 0, false)
		return int(math.Round(min(1, max(0, odds)) * 100))
	}
	return chance(before), chance(after), true
}

// heroFileProfileSkills: a profile card's three highest skills in the file's order, «Набл 45 · Обсл 35 · Речь 20».
func (r *Runtime) heroFileProfileSkills(locale string, p heroFileProfile, sep string) string {
	w := r.world.HeroFile
	top := map[string]bool{}
	for n := 0; n < 3 && n < len(w.Skills); n++ {
		best := ""
		for _, s := range w.Skills {
			if !top[s] && (best == "" || p.Skills[s] > p.Skills[best]) {
				best = s
			}
		}
		top[best] = true
	}
	var parts []string
	for _, s := range w.Skills {
		if top[s] {
			parts = append(parts, r.localText(locale, w.Text.Short[s], s)+" "+strconv.Itoa(p.Skills[s]))
		}
	}
	return strings.Join(parts, sep)
}

// heroFileSkill: one skill row — the start with this choice, the profile's value, what was added (and the cap that cut
// it), the server's line, and the panel: what marking it as a strength gives (the chance of the difficulty it moves
// most, the harder on a tie), where it is first heard, no minus.
func (r *Runtime) heroFileSkill(locale string, c heroFileChoice, p heroFileProfile, s string, value int) *pb.PocHeroFileSkill {
	w, d := r.world.HeroFile, r.world.DialogueRules
	text := func(key string) string { return r.localText(locale, key, key) }
	name := s
	out := &pb.PocHeroFileSkill{Id: s, Value: int32(value), Base: int32(p.Skills[s]), Strength: heroFileHas(c.Strengths, s), Line: r.heroFileLine(locale, value)}
	if d != nil {
		if tag, ok := d.Skills[s]; ok {
			name, out.Colour = text(tag.Name), tag.Colour
		}
	}
	out.Name = name
	if bonus := value - p.Skills[s]; bonus != 0 {
		added := 0
		for _, e := range w.effects(c) {
			if e.Skill != nil && e.Skill.ID == s {
				added += e.Skill.Add
			}
		}
		if out.Strength {
			added += w.Strengths.Bonus
		}
		format := w.Text.Raised
		if p.Skills[s]+added > value {
			format = w.Text.Capped
		}
		out.Detail = heroFileFormat(text(format), "{base}", strconv.Itoa(p.Skills[s]), "{bonus}", strconv.Itoa(bonus), "{cap}", strconv.Itoa(w.Strengths.StartCap))
	}
	without, with := c.clone(), c.clone()
	without.Strengths = nil
	for _, x := range c.Strengths {
		if x != s {
			without.Strengths = append(without.Strengths, x)
		}
	}
	if !out.Strength {
		with.Strengths = append(with.Strengths, s)
	}
	before, after := w.start(without)[s], w.start(with)[s]
	out.Give = append(out.Give, &pb.PocHeroFileGive{Kind: "plus", Text: heroFileFormat(text(w.Text.Strength), "{skill}", name, "{bonus}", strconv.Itoa(after-before))})
	if d != nil {
		best, gain := -1, 0
		for i, level := range d.Difficulties {
			if row := d.Chance[level.ID]; len(row) > max(before, after) {
				if g := row[after] - row[before]; g > 0 && g >= gain {
					best, gain = i, g
				}
			}
		}
		if best >= 0 {
			level := d.Difficulties[best]
			out.Give = append(out.Give, &pb.PocHeroFileGive{Kind: "chance", Text: heroFileFormat(text(w.Text.Chance), "{skill}", name, "{difficulty}", text(level.Text),
				"{before}", strconv.Itoa(d.Chance[level.ID][before]), "{after}", strconv.Itoa(d.Chance[level.ID][after]))})
		}
	}
	if before, after, ok := r.heroFileFight(s, before, after); ok {
		out.Give = append(out.Give, &pb.PocHeroFileGive{Kind: "fight", Text: heroFileFormat(text(w.Fight.Text), "{before}", strconv.Itoa(before), "{after}", strconv.Itoa(after))})
	}
	out.Give = append(out.Give, &pb.PocHeroFileGive{Kind: "first", Text: heroFileFormat(text(w.Text.First), "{where}", text(w.Text.FirstSkill[s]))},
		&pb.PocHeroFileGive{Kind: "none", Text: text(w.Text.NoMinus)})
	return out
}

// migrateHeroFile: a life save from before the file gets a legacy file — no choice, no effects, no first check — and the
// hero's development keeps his saved skills as its own start (each at most his value, the last receipt's skill at most
// its value before; his learning is the profile's, so that receipt is re-derived as before). A save with a file whose
// numbers were tuned since (a profile's value, the bonus, the cap, the learning) gets the file's start of this build,
// keeping what the hero earned (SetOwn); what does not validate is left for validateHeroFile to refuse.
func (r *Runtime) migrateHeroFile(s *state) {
	w := r.world.HeroFile
	if w == nil || !s.Life.Enabled {
		return
	}
	if f := s.HeroFile; f != nil {
		a, has := s.Life.Development.Actors[playerActorID]
		if _, ok := r.heroFilePractice(); !ok || !has || f.Legacy || a.Own == nil {
			return
		}
		c, err := w.read(f.Choice.wire())
		if err != nil || w.complete(c) != nil {
			return
		}
		want := w.own(c)
		if reflect.DeepEqual(a.Own.Start, want.Start) && (len(a.Own.LearnPermille)+len(want.LearnPermille) == 0 || reflect.DeepEqual(a.Own.LearnPermille, want.LearnPermille)) {
			return
		}
		development := s.Life.Development.Clone()
		if development.SetOwn(r.world.Life.Development, playerActorID, want, s.Tick) == nil {
			s.Life.Development = development
			r.heroFileSyncState(s)
		}
		return
	}
	s.HeroFile = &heroFileState{Legacy: true, StillSince: s.Life.Seconds}
	if h := s.Life.Actor(playerActorID); h != nil {
		s.HeroFile.WalkedMM = h.WalkedMM
	}
	p, ok := r.heroFilePractice()
	a, has := s.Life.Development.Actors[playerActorID]
	if !ok || !has || a.Own != nil {
		return
	}
	own := behavior.PracticeOwn{Start: map[string]int{}}
	for _, k := range w.Skills {
		v := int(a.Skills[k].ValueMilli / 1000)
		if a.Sequence > 0 && a.LastResult.Skill == k {
			v = min(v, int(a.LastResult.BeforeMilli/1000))
		}
		own.Start[k] = min(max(0, v), p.Skills[k].Cap)
	}
	a.Own = &own
	s.Life.Development.Actors[playerActorID] = a
}

// heroFileSyncState: what the hero's file feeds in a saved state after its numbers moved (a retune at load): the
// inspection's observer reads his file skills, his fighters carry the file's wound relief and fight with the developed
// skill (part 1b).
func (r *Runtime) heroFileSyncState(s *state) {
	w := r.world.HeroFile
	for _, k := range w.Skills {
		if _, ok := s.Life.Observer.Attributes[k]; ok {
			s.Life.Observer.Attributes[k] = s.Life.Development.Value(playerActorID, k)
		}
	}
	relief := w.woundRelief(s.HeroFile)
	profile := r.world.CombatRuntime.Profiles[r.world.CombatRuntime.Actors[playerActorID]]
	fix := func(c *behavior.Combatant) {
		c.WoundAPRelief = relief
		if profile.Develops != nil {
			c.Skill = developedCombatSkillOf(profile, s.Life.Development, playerActorID, c.Weapon)
		}
	}
	for i := range s.Combat.Actors {
		if s.Combat.Actors[i].ID == playerActorID {
			fix(&s.Combat.Actors[i])
		}
	}
	if c, ok := s.CombatRoster[playerActorID]; ok {
		fix(&c)
		s.CombatRoster[playerActorID] = c
	}
}

// validateHeroFile: the saved file names the world's own ids, complete and in the file's order (or is legacy without a
// choice); the hero's development carries exactly the choice's start and learning (legacy: its own start of the file
// skills, no own learning); his fighters carry the file's wound relief, nobody else any.
func (r *Runtime) validateHeroFile(s state) error {
	w, f := r.world.HeroFile, s.HeroFile
	if f == nil {
		if w != nil && s.Life.Enabled {
			return errors.New("a life save without the hero's file")
		}
		return nil
	}
	if w == nil || !s.Life.Enabled {
		return errors.New("a hero file outside a life world")
	}
	switch f.Recheck {
	case "", "offered", "done", "skipped", "lapsed":
	default:
		return fmt.Errorf("invalid first check state %q", f.Recheck)
	}
	if f.StillSince < 0 || f.StillSince > s.Life.Seconds || !(f.WalkedMM >= 0) {
		return errors.New("invalid hero file stillness")
	}
	if f.Legacy {
		if !reflect.DeepEqual(f.Choice, heroFileChoice{}) || f.Recheck != "" {
			return errors.New("a legacy hero file with a choice")
		}
	} else {
		c, err := w.read(f.Choice.wire())
		if err != nil || f.Choice.Profile == "" || !reflect.DeepEqual(c, f.Choice) {
			return errors.New("invalid saved hero file")
		}
		if err := w.complete(c); err != nil {
			return errors.New("incomplete saved hero file")
		}
	}
	a, has := s.Life.Development.Actors[playerActorID]
	if _, ok := r.heroFilePractice(); ok && has {
		if a.Own == nil {
			return errors.New("the hero's development lacks the file's start")
		}
		if f.Legacy {
			if len(a.Own.LearnPermille) != 0 || len(a.Own.Start) != len(w.Skills) {
				return errors.New("invalid legacy start of the hero's development")
			}
			for _, k := range w.Skills {
				if _, ok := a.Own.Start[k]; !ok {
					return errors.New("invalid legacy start of the hero's development")
				}
			}
		} else {
			want := w.own(f.Choice)
			if !reflect.DeepEqual(a.Own.Start, want.Start) || len(a.Own.LearnPermille)+len(want.LearnPermille) > 0 && !reflect.DeepEqual(a.Own.LearnPermille, want.LearnPermille) {
				return errors.New("the hero's development does not start as his file")
			}
		}
	} else if has && a.Own != nil {
		return errors.New("an own development start without the file's skills")
	}
	relief := w.woundRelief(f)
	check := func(c behavior.Combatant) error {
		if c.ID == playerActorID && c.WoundAPRelief != relief || c.ID != playerActorID && c.WoundAPRelief != 0 {
			return fmt.Errorf("invalid wound relief of %s", c.ID)
		}
		return nil
	}
	for _, c := range s.Combat.Actors {
		if err := check(c); err != nil {
			return err
		}
	}
	for _, c := range s.CombatRoster {
		if err := check(c); err != nil {
			return err
		}
	}
	return nil
}
