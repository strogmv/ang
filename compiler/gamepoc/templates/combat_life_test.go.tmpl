func combatWorldObserverID(t *testing.T, r *Runtime, exclude ...string) string {
	t.Helper()
	no := map[string]bool{playerActorID: true, "char.poc_hub_guard": true}
	for _, id := range exclude {
		no[id] = true
	}
	ids := []string{}
	for _, a := range r.state.Life.Actors {
		if !no[a.ID] && a.OnFloor() && a.Level == r.currentLevel() {
			ids = append(ids, a.ID)
		}
	}
	sort.Strings(ids)
	if len(ids) == 0 {
		t.Fatal("real life world has no bystander")
	}
	return ids[0]
}

// Only initial poses of already-existing people are arranged. Senses, event
// delivery, decisions, collision movement, joining and persistence are real.
func combatWorldPlace(t *testing.T, r *Runtime, id, targetID string, minMM, maxMM int, visible bool) {
	t.Helper()
	hero, target := r.state.Life.Actor(playerActorID), r.state.Life.Actor(targetID)
	a := r.state.Life.Actor(id)
	if a == nil {
		t.Fatal("missing existing actor", id)
	}
	model := r.state.Life.GateModel(r.world.Life)
	level := model.Locations[hero.Level]
	blocked := r.state.Life.BlockedCells(hero.Level, id)
	for y, row := range level.Terrain {
		for x := range row {
			at := behavior.Cell{X: x, Y: y}
			distance := r.combatWorldDistance(hero.Level, at, hero.Position)
			if !model.Walks(hero.Level, at) || blocked[at] || distance < minMM || distance > maxMM {
				continue
			}
			if v := r.world.Decks[hero.Level]; v != nil {
				_, _, surface, ok := v.Locate(hero.Position)
				_, _, candidate, stand := v.Locate(at)
				if !ok || !stand || surface != candidate {
					continue
				}
			}
			observer := combatLifeObserver{ID: id, Level: hero.Level, At: at}
			if visible && (!r.combatWorldVisible(observer, hero.Position) || !r.combatWorldVisible(observer, target.Position)) {
				continue
			}
			if !visible {
				if r.combatWorldVisible(observer, hero.Position) || r.combatWorldVisible(observer, target.Position) {
					continue
				}
				if _, heard := r.combatWorldHeard(observer, hero.Position, r.world.CombatLife.MeleeLoudness); !heard {
					continue
				}
			}
			a.Level = hero.Level
			a.Position = at
			a.Goal = at
			a.Path = nil
			a.PendingPath = nil
			a.Trip = nil
			a.ResidenceID = ""
			a.Manual = false
			a.Arrived = true
			a.OverrideLevel = ""
			a.OverrideEdge = ""
			a.CombatHold = false
			a.Safety = nil
			a.Body = nil
			a.MoveStartTick = r.lifeMotionTick()
			return
		}
	}
	t.Fatalf("no genuine floor pose for observer %s in range %d..%d visible=%t", id, minMM, maxMM, visible)
}
func TestCombatWorldExplicitHostilityStartsFromOrdinaryLife(t *testing.T) {
	r, _, target := combatLifeFixture(t, true)
	npc := r.state.Life.Actor(target)
	r.world.CombatLife.Aggressors = map[string][]string{}
	if err := r.state.Life.SetRelation(target, playerActorID, -1); err != nil {
		t.Fatal(err)
	}
	count := len(r.state.Life.Actors)
	if err := r.combatLifeAfterFrame(); err != nil {
		t.Fatal(err)
	}
	if r.state.Combat.Active {
		t.Fatal("dislike without an authored aggression intention started a fight")
	}
	r.world.CombatLife.Aggressors = map[string][]string{target: {playerActorID}}
	profile := r.world.CombatRuntime.Profiles["guard"]
	profile.Initiative = r.world.CombatRuntime.Profiles["hero"].Initiative + 1
	r.world.CombatRuntime.Profiles["guard"] = profile
	sight := r.world.CombatLife.SightRangeMM
	r.world.CombatLife.SightRangeMM = 1
	if err := r.combatLifeAfterFrame(); err != nil {
		t.Fatal(err)
	}
	if r.state.Combat.ID != "" {
		t.Fatal("authored hostility acted on an unseen target")
	}
	r.world.CombatLife.SightRangeMM = sight
	if err := r.combatLifeAfterFrame(); err != nil {
		t.Fatal(err)
	}
	npc = r.state.Life.Actor(target)
	if r.state.Combat.ID == "" || r.state.Combat.Actor(target) == nil || r.state.Combat.Actor(playerActorID) == nil || !npc.CombatHold || len(r.state.Life.Actors) != count {
		t.Fatal("ordinary hostile intention did not begin a real encounter between existing actors")
	}
	acted := false
	for _, event := range r.state.Combat.Events {
		if event.ActorID == target && event.Type == "attack" {
			acted = true
		}
	}
	if !acted {
		t.Fatal("automatic encounter did not execute the NPC's actual tactical action")
	}
	if r.state.CombatWorld.InitiatorID != target || r.state.CombatWorld.VictimID != playerActorID {
		t.Fatal("defensive violence lost its original cause")
	}
}
func TestCombatWorldUnseenNoiseHasNoAttackerIdentity(t *testing.T) {
	r, _, target := combatLifeFixture(t, false)
	r.world.CombatLife.Responders = map[string]combatResponder{}
	r.world.CombatLife.SightRangeMM = 1000
	id := combatWorldObserverID(t, r, target)
	combatWorldPlace(t, r, id, target, 2500, 6000, false)
	before := r.state.Life.Actor(id).Position
	if err := r.startCombat(target); err != nil {
		t.Fatal(err)
	}
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}); err != nil {
		t.Fatal(err)
	}
	memory := r.state.CombatWorld.Memories[id]
	if memory.Count("combat.noise") == 0 || memory.Count("combat.assault") != 0 {
		t.Fatal("unseen impact became a visual assault report")
	}
	for _, f := range memory.Facts {
		if f.Subject == playerActorID || f.Cause != "" || f.Source != "sound" {
			t.Fatal("noise revealed the hidden source identity", f)
		}
	}
	a := r.state.Life.Actor(id)
	if a.Safety == nil || a.Position != before {
		t.Fatal("hearing did not create a non-teleporting safety response")
	}
	prior := memory.Clone()
	if err := r.combatLifeAfterFrame(); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(prior, r.state.CombatWorld.Memories[id]) {
		t.Fatal("an old noise report refreshed itself without a new observation")
	}
}
func TestCombatWorldWitnessCallsExistingGuardWithoutTelepathy(t *testing.T) {
	r, _, target := combatLifeFixture(t, false)
	guardID := "char.poc_hub_guard"
	if r.state.Life.Actor(guardID) == nil {
		t.Fatal("existing guard missing")
	}
	r.world.CombatLife.SightRangeMM = 2000
	r.world.CombatLife.Responders = map[string]combatResponder{guardID: {Protect: []string{target}, Report: true, Levels: []string{r.currentLevel()}}}
	witnessID := combatWorldObserverID(t, r, target)
	combatWorldPlace(t, r, witnessID, target, 1000, 1800, true)
	combatWorldPlace(t, r, guardID, target, 4000, 7000, false)
	guardStart := r.state.Life.Actor(guardID).Position
	count := len(r.state.Life.Actors)
	if err := r.startCombat(target); err != nil {
		t.Fatal(err)
	}
	if r.state.Combat.Actor(guardID) != nil {
		t.Fatal("unwitnessed preparation recruited a remote guard")
	}
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}); err != nil {
		t.Fatal(err)
	}
	guard := r.state.Life.Actor(guardID)
	memory := r.state.CombatWorld.Memories[guardID]
	f, knowledge := memory.Lookup(playerActorID, "combat.assault")
	if knowledge != behavior.KnowledgeTrue || f.Source == guardID || f.Source == "" || f.Cause != target {
		t.Fatal("guard did not receive the original local witness report", f)
	}
	if guard.Position != guardStart || r.state.Combat.Actor(guardID) != nil || guard.Safety == nil || guard.Safety.Activity != "investigate" {
		t.Fatal("a heard report teleported/recruited a guard before personal sight")
	}
	for tick := 0; tick < 100 && r.state.Combat.Actor(guardID) == nil; tick++ {
		before := guard.Position
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
		if before != guard.Position && !r.world.Life.Adjacent(guard.Level, before, guard.Position) {
			t.Fatal("responder skipped physical path steps")
		}
	}
	if r.state.Combat.Actor(guardID) == nil || guard.Position == guardStart || len(r.state.Life.Actors) != count {
		t.Fatal("existing guard failed to walk to the reported incident and join on sight")
	}
	if actor := r.state.Combat.Actor(guardID); actor.AP != 0 {
		t.Fatal("reinforcement gained free AP before its own turn")
	}
}
func TestCombatWorldSafetyRefusesCommerceAndPersists(t *testing.T) {
	r, _, target := combatLifeFixture(t, false)
	r.world.CombatLife.Responders = map[string]combatResponder{}
	id := combatWorldObserverID(t, r, target)
	combatWorldPlace(t, r, id, target, 1000, 1500, true)
	if err := r.startCombat(target); err != nil {
		t.Fatal(err)
	}
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}); err != nil {
		t.Fatal(err)
	}
	if r.combatMerchantSafe(id) {
		t.Fatal("an unsafe proprietor was eligible to trade")
	}
	a := r.state.Life.Actor(id)
	if a.Safety == nil {
		t.Fatal("witness had no safety destination")
	}
	start := a.Position
	for i := 0; i < 12; i++ {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	if a.Position == start && a.Safety.Goal != start {
		t.Fatal("safety remained a label without movement")
	}
	before := r.snapshotState()
	clone := before.CombatWorld.Clone()
	m := clone.Memories[id]
	m.Facts[0].Position = behavior.Cell{X: -9, Y: -9}
	clone.Memories[id] = m
	if reflect.DeepEqual(clone, before.CombatWorld) {
		t.Fatal("combat world clone shares observer facts")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, before); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(before.CombatWorld, loaded.CombatWorld) || !reflect.DeepEqual(before.Life.Actor(id).Safety, loaded.Life.Actor(id).Safety) {
		t.Fatal("save lost local knowledge or physical safety destination")
	}
	tampered := loaded
	tampered.CombatWorld = loaded.CombatWorld.Clone()
	bad := tampered.CombatWorld.Memories[id]
	bad.Facts[0].Cause = "char.does_not_exist"
	tampered.CombatWorld.Memories[id] = bad
	if r.validateCombatWorld(tampered) == nil {
		t.Fatal("invented assault victim accepted in save")
	}
}

func TestCombatWorldOpenProprietorRefusesTradeInTheWitnessedAttackFrame(t *testing.T) {
	r, _, targetID := combatLifeFixture(t, false)
	r.world.CombatLife.Responders = map[string]combatResponder{}
	initial := r.snapshotState()
	for _, shop := range r.world.Inventory.Shopfronts {
		if shop.Owner == targetID || shop.Owner == playerActorID || shop.Service.Level != r.currentLevel() {
			continue
		}
		r.state = initial
		r.state.Life = initial.Life.Clone()
		r.state.Inventory = initial.Inventory.Clone()
		r.state.CombatWorld = initial.CombatWorld.Clone()
		owner, hero, target := r.state.Life.Actor(shop.Owner), r.state.Life.Actor(playerActorID), r.state.Life.Actor(targetID)
		if owner == nil {
			continue
		}
		service := behavior.Cell{X: shop.Service.At.X, Y: shop.Service.At.Y}
		model := r.state.Life.GateModel(r.world.Life)
		blocked := r.state.Life.BlockedCells(hero.Level, owner.ID)
		delete(blocked, hero.Position)
		delete(blocked, target.Position)
		if blocked[service] || !model.Walks(hero.Level, service) {
			continue
		}
		owner.Level = hero.Level
		owner.Position = service
		owner.Goal = service
		owner.Path = nil
		owner.PendingPath = nil
		owner.Trip = nil
		owner.ResidenceID = ""
		owner.Manual = false
		owner.Arrived = true
		owner.CombatHold = false
		owner.Safety = nil
		placed := false
		level := model.Locations[hero.Level]
		for y, row := range level.Terrain {
			if placed {
				break
			}
			for x := range row {
				if placed {
					break
				}
				victimAt := behavior.Cell{X: x, Y: y}
				if blocked[victimAt] || victimAt == service || !model.Walks(hero.Level, victimAt) || r.combatWorldDistance(hero.Level, service, victimAt) > 2500 {
					continue
				}
				for _, heroAt := range model.StepNeighbours(hero.Level, victimAt) {
					if heroAt == service || blocked[heroAt] || !model.Walks(hero.Level, heroAt) || r.combatWorldDistance(hero.Level, heroAt, victimAt) > r.world.CombatRuntime.Profiles["hero"].Weapon.RangeMM || !r.combatSight(hero.Level, heroAt, victimAt) {
						continue
					}
					observer := combatLifeObserver{ID: owner.ID, Level: hero.Level, At: service}
					if !r.combatWorldVisible(observer, heroAt) || !r.combatWorldVisible(observer, victimAt) {
						continue
					}
					if volume := r.world.Decks[hero.Level]; volume != nil {
						if !volume.CombatShotClear(heroAt, victimAt) {
							continue
						}
					}
					hero.Position = heroAt
					hero.Goal = heroAt
					hero.Path = nil
					hero.PendingPath = nil
					hero.Body = nil
					hero.Manual = true
					hero.Arrived = true
					target.Level = hero.Level
					target.Position = victimAt
					target.Goal = victimAt
					target.Path = nil
					target.PendingPath = nil
					target.Trip = nil
					target.ResidenceID = ""
					target.Arrived = true
					target.CombatHold = false
					target.Safety = nil
					r.state.Life.EnsureHeroBody(model)
					if err := r.state.Life.Validate(r.world.Life, r.state.Tick); err != nil {
						continue
					}
					r.syncLifeHero()
					placed = true
					break
				}
			}
		}
		if !placed {
			continue
		}
		if err := r.advanceMarketSupply(); err != nil {
			t.Fatal(err)
		}
		location := inv.Location{Kind: "store", Store: shop.DisplayStore}
		if !r.commerceAccessible(playerActorID, location) {
			continue
		}
		if err := r.startCombat(targetID); err != nil {
			t.Fatal(err)
		}
		if err := r.combatCommand(&pb.PocCombatCommand{Action: "attack", TargetId: targetID, ExpectedTurn: r.state.Combat.Turn}); err != nil {
			t.Fatal(err)
		}
		owner = r.state.Life.Actor(shop.Owner)
		if owner.Position != service || owner.Safety == nil {
			t.Fatal("witness response must precede, not teleport, the merchant's departure")
		}
		if r.commerceAccessible(playerActorID, location) {
			t.Fatal("an observed assault left the still-present proprietor eligible to sell")
		}
		return
	}
	t.Fatal("no existing open proprietor has a genuine adjacent witnessed melee arrangement")
}

func TestCombatWorldSafetyRetargetsNewPersonallySeenThreat(t *testing.T) {
	r, _, target := combatLifeFixture(t, false)
	r.world.CombatLife.Responders = map[string]combatResponder{}
	id := combatWorldObserverID(t, r, target)
	combatWorldPlace(t, r, id, target, 1000, 1800, true)
	if err := r.startCombat(target); err != nil {
		t.Fatal(err)
	}
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}); err != nil {
		t.Fatal(err)
	}
	witness := r.state.Life.Actor(id)
	hero := r.state.Life.Actor(playerActorID)
	if witness.Safety == nil || witness.Safety.ThreatAt != hero.Position {
		t.Fatal("initial personal observation was not saved on the safety response")
	}
	oldThreat := witness.Safety.ThreatAt
	observer := combatLifeObserver{ID: id, Level: witness.Level, At: witness.Position}
	model := r.state.Life.GateModel(r.world.Life)
	blocked := r.state.Life.BlockedCells(hero.Level, playerActorID)
	for _, at := range model.StepNeighbours(hero.Level, hero.Position) {
		if blocked[at] || !model.Walks(hero.Level, at) || !r.combatWorldVisible(observer, at) {
			continue
		}
		if err := r.combatCommand(&pb.PocCombatCommand{Action: "move", X: int32(at.X), Y: int32(at.Y), ExpectedTurn: r.state.Combat.Turn}); err != nil {
			continue
		}
		if err := r.combatLifeAfterFrame(); err != nil {
			t.Fatal(err)
		}
		witness = r.state.Life.Actor(id)
		hero = r.state.Life.Actor(playerActorID)
		if witness.Safety == nil || witness.Safety.ThreatAt == oldThreat || witness.Safety.ThreatAt != hero.Position {
			t.Fatal("a new visible threat position left the civilian committed to the old danger model")
		}
		return
	}
	t.Fatal("no physical visible one-step threat movement was available")
}

func TestCombatWorldBackgroundFightPreservesHeroControlAndOneActionPerFrame(t *testing.T) {
	r, c, initiatorID := combatLifeFixture(t, true)
	r.world.CombatLife.Responders = map[string]combatResponder{}
	victimID := combatWorldObserverID(t, r, initiatorID)
	combatWorldPlace(t, r, victimID, initiatorID, 1000, 1800, true)
	r.world.CombatLife.Aggressors = map[string][]string{initiatorID: {victimID}}
	if err := r.state.Life.SetRelation(initiatorID, victimID, -1); err != nil {
		t.Fatal(err)
	}
	battleLevel := r.currentLevel()
	model := r.state.Life.GateModel(r.world.Life)
	hero := r.state.Life.Actor(playerActorID)
	levels := []string{}
	for level := range model.Locations {
		if level != battleLevel && r.world.Decks[level] == nil {
			levels = append(levels, level)
		}
	}
	sort.Strings(levels)
	start, goal := behavior.Cell{}, behavior.Cell{}
	other := ""
	for _, level := range levels {
		if other != "" {
			break
		}
		l := model.Locations[level]
		blocked := r.state.Life.BlockedCells(level, playerActorID)
		for y, row := range l.Terrain {
			if other != "" {
				break
			}
			for x := range row {
				at := behavior.Cell{X: x, Y: y}
				if blocked[at] || !model.Walks(level, at) {
					continue
				}
				for _, delta := range []behavior.Cell{{X: 2}, {Y: 2}, {X: -2}, {Y: -2}} {
					to := behavior.Cell{X: at.X + delta.X, Y: at.Y + delta.Y}
					space := model.Space(level, blocked)
					if !model.Walks(level, to) || blocked[to] || len(space.Path(at, to, behavior.Cell{}, 0)) < 2 {
						continue
					}
					other = level
					start = at
					goal = to
					break
				}
				if other != "" {
					break
				}
			}
		}
	}
	if other == "" {
		t.Fatal("real Life world has no other ordinary walkable room")
	}
	hero.Level = other
	hero.Position = start
	hero.Goal = start
	hero.Path = nil
	hero.PendingPath = nil
	hero.Body = nil
	hero.Trip = nil
	hero.ResidenceID = ""
	hero.Manual = true
	hero.Arrived = true
	hero.OverrideLevel = ""
	hero.OverrideEdge = ""
	hero.CombatHold = false
	if hero.Visits == nil {
		hero.Visits = map[string]int{}
	}
	hero.Visits[other]++
	r.syncLifeHero()
	r.applyGateTerrain()
	epoch := r.state.Epoch
	r.lifeMove(c, &pb.MoveTo{Epoch: epoch, InputSeq: 91, X: int32(goal.X), Y: int32(goal.Y)})
	accepted := false
	for len(c.out) > 0 {
		if result := (<-c.out).GetMoveResult(); result != nil {
			accepted = result.Ok
		}
	}
	if !accepted {
		t.Fatal("ordinary hero route was not accepted before background fight")
	}
	started, moved := false, false
	for i := 0; i < 25; i++ {
		oldID, oldSeq := r.state.Combat.ID, r.state.Combat.ActionSeq
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
		if r.state.Combat.ID != "" {
			started = true
			if r.state.Combat.LevelID != battleLevel || r.state.Combat.Actor(playerActorID) != nil {
				t.Fatal("background fight commandeered the hero")
			}
			if oldID != r.state.Combat.ID {
				oldSeq = 0
			}
			if r.state.Combat.ActionSeq-oldSeq > 1 {
				t.Fatal("background fight executed more than one action in one Life frame")
			}
		}
		hero = r.state.Life.Actor(playerActorID)
		if hero.Position != start {
			moved = true
		}
		if r.state.Epoch != epoch || hero.CombatHold {
			t.Fatal("unknown background encounter reset the hero's input epoch or held its body")
		}
		message := &pb.PocGameState{}
		r.appendCombat(message)
		if message.Combat != nil {
			t.Fatal("a hidden encounter disclosed metadata to an uninvolved hero")
		}
	}
	if !started || !moved {
		t.Fatal("ordinary world did not simultaneously execute the NPC fight and accepted hero movement")
	}
}

// The map is an explicit initial data fixture connected to the real Life graph.
