	}
	return r.state.Inventory.Accounts[ids[0]], true
}
func (r *Runtime) medicalQuote(id string, u medicalUnit) (wounds.Quote, error) {
	c := r.combatant(id, "player")
	b := combatBody(c)
	chip := "none"
	if b.ID == id && b.Chip != "none" {
		if _, known := combatWounds.Chips[b.Chip]; known {
			chip = "own"
		}
	}
	a, _ := r.medicalAccount(id)
	return combatWounds.Quote(&b, u.Provider, wounds.Payer{Chip: chip, BalanceMinor: a.Balance, TrustPermille: r.state.Crafting.Law.Trust})
}
func medicalSameTerms(a, b wounds.Quote) bool {
	return a.Provider == b.Provider && a.Mode == b.Mode && a.PriceMinor == b.PriceMinor && a.Seconds == b.Seconds && reflect.DeepEqual(a.Journal, b.Journal)
