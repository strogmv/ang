func (p PopulationModel) Validate(l LifeModel) error {
	if p.MaxActors == 0 && len(p.Stages) == 0 && len(p.Anchors) == 0 && len(p.ShiftOffsets) == 0 && len(p.Profiles)==0 {
		return nil
	}
	if p.MaxActors < 1 || p.MaxActive < 1 || p.MaxActive > p.MaxActors || p.MoveTicks < 1 || p.ColdStepSeconds < 1 || len(p.Stages) == 0 || len(p.ShiftOffsets) == 0 {
		return fmt.Errorf("invalid population configuration")
	}
	shifts := map[int64]bool{}
	for _, offset := range p.ShiftOffsets {
		if offset < 0 || offset >= 86400 || shifts[offset] {
			return fmt.Errorf("invalid population shift")
		}
		shifts[offset] = true
	}
	ids := map[string]bool{}
	for i, stage := range p.Stages {
		if stage.ID == "" || ids[stage.ID] || stage.Activity == "" || stage.AtSecond < 0 || stage.AtSecond >= 86400 || (i == 0 && stage.AtSecond != 0) || (i > 0 && stage.AtSecond <= p.Stages[i-1].AtSecond) || len(p.Anchors[stage.Level]) == 0 {
			return fmt.Errorf("invalid population stage %s", stage.ID)
		}
		ids[stage.ID] = true
		next := p.Stages[(i+1)%len(p.Stages)]
		if stage.Level != next.Level && l.NextEdge(stage.Level, next.Level) == nil {
			return fmt.Errorf("unreachable population stage %s", stage.ID)
		}
	}
	for level, anchors := range p.Anchors {
		seen := map[Cell]bool{}
		if len(anchors) == 0 {
			return fmt.Errorf("empty population anchor list")
		}
		for _, at := range anchors {
			if !l.Walks(level, at) || seen[at] {
				return fmt.Errorf("invalid population anchor %s", level)
			}
			seen[at] = true
		}
	}
	return p.validateProfiles(l)
}
func (p PopulationModel) stage(seconds, offset int64) int {
	day := (seconds%86400 + offset) % 86400
	stage := 0
	for i, v := range p.Stages {
		if v.AtSecond <= day {
			stage = i
		}
	}
	return stage
}
// CUE lists anchors in a stable geometric order. A contiguous prefix would pack
// a small population into one doorway while leaving most of the level empty.
// A coprime stride spreads that prefix and still visits every authored anchor
// exactly once before repeating, without random retries or new allocations.
func populationAnchorStride(count int) int {
