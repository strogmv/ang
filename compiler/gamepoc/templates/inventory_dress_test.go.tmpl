func TestDressLegacyHudKeepsItsBagAndNestedItemIndices(t *testing.T) {
	r, _ := dressFixture(t)
	legacy := r.snapshotState()
	pack := r.dressPack(legacy.Inventory)
	bagID := legacy.Inventory.Stores[pack].Anchor.Item
	bag := legacy.Inventory.Items[bagID]
	bag.Location.Slot = ""
	legacy.Inventory.Items[bagID] = bag
	var nested inv.Item
	for _, id := range combatItemKeys(legacy.Inventory) {
		item := legacy.Inventory.Items[id]
		if item.Location.Store == pack && !item.Hidden {
			nested = item
			break
		}
	}
	if nested.ID == "" {
		t.Fatal("the fixture needs a nested starter item")
	}
	delete(legacy.Inventory.Stores, inv.DressStore(playerActorID, heroBelt))
	delete(legacy.Inventory.Stores, inv.DressStore(playerActorID, heroPockets))
	// The previous HUD already assigned the ready knife. Leave two holes to
	// verify that moving the bag and nested item does not reorder those cells.
	knife := inv.InstanceID("level.c7_market/place.c7_hero_backpack_knife", 0, 0)
	legacy.HudSlots = []string{knife, nested.ID, "", bagID, ""}
	if err := r.migrateDress(&legacy); err != nil {
		t.Fatal(err)
	}
	if err := legacy.Inventory.Validate(r.inventoryModelFor(true)); err != nil {
		t.Fatal(err)
	}
	r.state = legacy
	r.advanceChipHudSlots()
	if !reflect.DeepEqual(r.state.HudSlots, legacy.HudSlots) {
		t.Fatalf("migration lost the saved HUD positions: %v -> %v", legacy.HudSlots, r.state.HudSlots)
	}
	if r.dressPack(r.state.Inventory) != pack {
		t.Fatal("migration lost access to the carried bag")
	}
}

func TestDressLoadsPreviousBuildSaveAndRetainsHudIndices(t *testing.T) {
	file := os.Getenv("ANGELS_INVENTORY_LEGACY_SAVE")
	if file == "" {
		t.Skip("opt-in save produced by the previous server build")
	}
	data, err := os.ReadFile(file)
	if err != nil {
		t.Fatal(err)
	}
	var envelope saveFile
	if err := json.Unmarshal(data, &envelope); err != nil {
		t.Fatal(err)
	}
	var original state
	if err := json.Unmarshal(envelope.State, &original); err != nil {
		t.Fatal(err)
	}
	if _, exists := original.Inventory.Stores[inv.DressStore(playerActorID, heroBelt)]; exists {
		t.Fatal("the legacy proof was produced by a server that already has the belt")
	}
	r, _, _ := combatLifeFixture(t, true)
	slot := r.world.Config.SaveSlots[0]
	if err := os.WriteFile(r.slotFile(slot), data, 0644); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	r.state = loaded
	indices, _ := r.chipHudItemSlots()
	if !reflect.DeepEqual(original.HudSlots, loaded.HudSlots) || !reflect.DeepEqual(indices, loaded.HudSlots) {
		t.Fatalf("legacy HUD indices changed: before %v, saved %v, displayed %v", original.HudSlots, loaded.HudSlots, indices)
	}
	if err := r.writeSave(slot, loaded); err != nil {
		t.Fatal(err)
	}
	first, err := os.ReadFile(r.slotFile(slot))
	if err != nil {
		t.Fatal(err)
	}
	again, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if err := r.writeSave(slot, again); err != nil {
		t.Fatal(err)
	}
	second, err := os.ReadFile(r.slotFile(slot))
	if err != nil {
		t.Fatal(err)
	}
	if !bytes.Equal(first, second) {
		t.Fatal("a migrated previous-build save changed on load/save")
	}
}

func TestDressLegacyStarterKnifeUsesOnlyAFreeBeltCell(t *testing.T) {
 for _, full := range []bool{false,true} {
  t.Run(fmt.Sprint(full),func(t *testing.T){
   r,_,_:=combatLifeFixture(t,true)
   legacy:=r.snapshotState()
   pack:=r.dressPack(legacy.Inventory)
   knife:=inv.InstanceID("level.c7_market/place.c7_hero_backpack_knife",0,0)
   item:=legacy.Inventory.Items[knife]
   if item.Location.Store!=inv.DressStore(playerActorID,heroBelt){t.Fatal("default hero starter knife is not on the belt")}
   item.Location=inv.Location{Kind:"store",Store:pack}
   legacy.Inventory.Items[knife]=item
   legacy.HudSlots=nil
   if full {
    for n:=0;n<r.world.Inventory.Dress.Belt.Stacks;n++ {
     id:=fmt.Sprintf("test.legacy.belt.%d",n)
     dressSupply(t,r,id,"item.med_patch",pack)
     legacy.Inventory.Items[id]=r.state.Inventory.Items[id]
     legacy.HudSlots=append(legacy.HudSlots,id)
    }
   }
   delete(legacy.Inventory.Stores,inv.DressStore(playerActorID,heroBelt))
   delete(legacy.Inventory.Stores,inv.DressStore(playerActorID,heroPockets))
   if err:=r.migrateDress(&legacy);err!=nil{t.Fatal(err)}
   onBelt:=legacy.Inventory.Items[knife].Location.Store==inv.DressStore(playerActorID,heroBelt)
   if onBelt==full {t.Fatalf("full belt %t: knife on belt %t",full,onBelt)}
  })
 }
}

