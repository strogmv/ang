func TestScene19BeaconConditionProjectsOntoRealSignal(t *testing.T) {
	r := hub19Start(t, nil, 1)
	deck := r.liftingDeckForEdge("hub_copper_deck")
	item := r.storyPlacementItem(hub19Beacon)
	cases := []struct {
		name      string
		condition int64
		flashes   []bool
	}{
		{"intermittent", 500000, []bool{true, false, true, false}},
		{"repaired", 1000000, []bool{true, true, true, true}},
		{"failed", 0, []bool{false, false, false, false}},
	}
	for _, test := range cases {
		t.Run(test.name, func(t *testing.T) {
			fixture := r.state.Inventory.Items[item.ID]
			fixture.Condition = test.condition
			r.state.Inventory.Items[item.ID] = fixture
			for flash, expected := range test.flashes {
				machine := r.state.LiftingDecks[deck.ID]
				machine.Phase = "signal_down"
				machine.UpdatedNS = int64(flash) * deck.Timing.BeaconPeriod * 1000000
				r.state.LiftingDecks[deck.ID] = machine
				view := &pb.PocGameState{Life: &pb.PocLifeView{}}
				r.appendLiftingDecks(view, r.state.Life.Actor(playerActorID), "en")
				index := slices.IndexFunc(view.Life.LiftingDecks, func(signal *pb.PocLiftingDeckState) bool { return signal.Id == deck.ID })
				if index < 0 {
					t.Fatal("the real lifting deck has no projected signal")
				}
				signal := view.Life.LiftingDecks[index]
				if signal.Beacon != expected || !signal.Horn || !signal.SignalRed || signal.SignalGreen {
					t.Fatalf("fixture %s flash %d changed the wrong signal: %+v", test.name, flash, signal)
				}
			}
		})
	}
}

