# Generated by ANG. Shared book composition; geometry and roles are CUE data.
extends RefCounted
const Catalog = preload("res://generated/screens/catalog.gd")
var ui
var profile: Dictionary = {}
var heading: Control

func _init(screen):
	ui = screen

func build() -> VBoxContainer:
	profile = {}
	if ui.spec.chrome == "folk":
		profile = Catalog.specification().get("chrome_profiles", {}).get(ui.spec.get("chrome_profile", ""), {})
	if is_instance_valid(heading):
		heading.get_parent().remove_child(heading)
		heading.queue_free()
	var page := PanelContainer.new()
	page.theme_type_variation = "DialoguePanel"
	if ui.spec.layout in ["overlay", "hud"]:
		page.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	elif ui.spec.chrome == "folk" and not profile.is_empty():
		var plate: StyleBox = ui.theme.get_stylebox("panel", "DialoguePanel").duplicate()
		for side in range(4):
			plate.set_content_margin(side, profile.padding[side])
		page.add_theme_stylebox_override("panel", plate)
	elif ui.spec.chrome == "tactical":
		var plate := StyleBoxFlat.new()
		plate.bg_color = Color("18201ff5")
		plate.border_color = Color("7f8d83")
		for side in range(4):
			plate.set_content_margin(side, 24)
			plate.set_border_width(side, 1)
		page.add_theme_stylebox_override("panel", plate)
		page.add_theme_color_override("font_color", Color("e7e5d3"))
	ui.content = page
	ui.add_child(page)
	page.minimum_size_changed.connect(layout.call_deferred)
	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", int(profile.get("gap_px", 12)))
	page.add_child(column)
	heading = HBoxContainer.new()
	heading.add_theme_constant_override("separation", 20)
	if profile.get("heading_outside", false):
		ui.add_child(heading)
	else:
		column.add_child(heading)
	heading.visible = ui.spec.get("heading", true)
	var titles := VBoxContainer.new()
	titles.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	titles.add_theme_constant_override("separation", int(profile.get("heading_gap_px", 4)))
	heading.add_child(titles)
	if profile.get("heading_outside", false) and not ui.spec.get("kicker_key", "").is_empty():
		var kicker: Label = ui._label(titles, ui.tr(ui.spec.kicker_key), 14)
		kicker.theme_type_variation = "Imprint"
	var title: Label = ui._label(titles, ui.tr(ui.spec.title_key), int(profile.get("title_px", 26)))
	title.theme_type_variation = profile.get("title_role", "")
	var close := Button.new()
	close.action_mode = BaseButton.ACTION_MODE_BUTTON_PRESS
	close.name = "ScreenClose"
	close.theme_type_variation = "QuietButton"
	close.text = ui.tr(Catalog.specification().text.back)
	close.custom_minimum_size = Vector2(150, 48)
	close.add_theme_font_size_override("font_size", 24 if ui._large() else 19)
	close.set_meta("focus_id", "__close")
	close.set_meta("focus_uid", "__close#0")
	close.pressed.connect(ui._close)
	heading.add_child(close)
	close.visible = not ui.spec.get("hide_close", false)
	if close.visible:
		ui.rail.append(close)
		ui.focus_ids.append("__close")
	return column

func layout() -> void:
	if not is_instance_valid(ui.content):
		return
	var margins: Array = profile.get("frame_margins", [32, 54, 32, 32])
	if ui.spec.layout == "hud":
		margins = [0, 0, 0, 0]
	ui.content.position = Vector2(margins[0], margins[1])
	ui.content.size = Vector2(maxf(320, ui.size.x - margins[0] - margins[2]),
		maxf(200, ui.size.y - margins[1] - margins[3]))
	if is_instance_valid(heading) and profile.get("heading_outside", false):
		heading.position = Vector2(margins[0], profile.heading_y)
		heading.size = Vector2(ui.size.x - margins[0] - margins[2], profile.heading_height)

func guard_geometry() -> Dictionary:
	if profile.is_empty() or ui.spec.layout == "overlay":
		return {}
	var frame: Rect2 = ui.content.get_global_rect()
	var corner := Vector2(profile.ornament_size[0], profile.ornament_size[1])
	var corners: Array[Rect2] = []
	var shapes: Array = profile.get("ornament_rects", [[0, 0, corner.x, corner.y]])
	for bottom in [false, true]:
		var corner_shapes: Array = profile.get("bottom_ornament_rects", shapes) if bottom else shapes
		for data in corner_shapes:
			for right in [false, true]:
				var x: float = frame.end.x - data[0] - data[2] if right else frame.position.x + data[0]
				var y: float = frame.end.y - data[1] - data[3] if bottom else frame.position.y + data[1]
				corners.append(Rect2(x, y, data[2], data[3]))

	return {"frame": frame, "inner": frame.grow(-float(profile.inner_border_px)), "corners": corners}
