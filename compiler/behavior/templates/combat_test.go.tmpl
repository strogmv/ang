func TestCombatRealAITurnsFinishFightWithoutSyntheticDamage(t *testing.T) {
	r := combatFixtureRules()
	r.MinHit = .9
	r.MaxHit = .95
	space := combatFixtureSpace()
	a, b := combatFixtureActor("a", "blue", Cell{2, 2}), combatFixtureActor("b", "red", Cell{5, 2})
	a.Weapon.Damage = 42
	b.Weapon.Damage = 37
	s, err := NewCombat("headless", "level", 99, []Combatant{a, b}, r, space)
	if err != nil {
		t.Fatal(err)
	}
	for n := 0; n < 150 && s.Active; n++ {
		if err = s.StepAI(space, r); err != nil {
			t.Fatal(err)
		}
	}
	if s.Active {
		t.Fatalf("fight failed to resolve via actual AI/execution: turn=%d current=%+v last=%+v", s.Turn, s.Current(), s.Events[len(s.Events)-1])
	}
	fired := 0
	for _, e := range s.Events {
		if e.Type == "attack" {
			fired++
		}
	}
	if fired == 0 || s.ActionSeq == 0 {
		t.Fatal("no actual AI attacks")
	}
	if err = s.Validate(r, space); err != nil {
		t.Fatal(err)
	}
}

