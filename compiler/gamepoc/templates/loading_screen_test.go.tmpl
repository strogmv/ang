	r.state.Memory.Story.Rumours[speaker] = map[string]float64{missing: 0.8}
	r.learnStoryFromSpeaker(speaker, missing)
	if known := r.state.Memory.Story.Hero[missing]; known.Belief <= 0 || known.Belief >= 1 {
		t.Fatalf("the hero did not hear the rumour: %+v", known)
	}
	note := r.placeNote("ru", loadingMarket)
	if note == nil || note.Id != missing || note.Source != storyRumour || note.SourceText == "" ||
		note.SourceText != r.localText("ru", r.world.Memory.Journal.Sources[storyRumour], "") {
		t.Fatalf("rumour line: %+v", note)
	}
	// refuted (a confirmed fact proved it false): the rumour stays in the journal, not in the line
