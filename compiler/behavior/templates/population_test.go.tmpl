func TestPopulationVisibleWalkingUsesNeighborSteps(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 12, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 1, 1, "a", PopulationEnvironment{})
	previous := map[string]PopulationActor{}
	for _, a := range s.Actors {
		previous[a.ID] = a
	}
	moved := false
	for tick := int64(2); tick < 100; tick++ {
		populationAdvance(t, &s, p, l, 28800+tick, tick, "a", PopulationEnvironment{})
		for _, a := range s.Actors {
			old := previous[a.ID]
			if old.Materialized && a.Materialized && old.Level == a.Level && old.Position != a.Position {
				if Distance(old.Position, a.Position) != 1 {
					t.Fatal("visible population teleported")
				}
				moved = true
			}
			previous[a.ID] = a
		}
	}
	if !moved {
		t.Fatal("near population never physically walked")
	}
}
func TestPopulationRejectsInvalidSavedState(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 6, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 1, 1, "a", PopulationEnvironment{})
	for _, mutate := range []func(*PopulationState){func(s *PopulationState) { s.Actors[0].ID = "new_identity" }, func(s *PopulationState) { s.Actors[0].Stage = 99 }, func(s *PopulationState) { s.Actors[0].Position = Cell{-1, 0} }, func(s *PopulationState) { s.Actors[0].Visits = nil }, func(s *PopulationState) { s.Actors[0].ShiftSeconds = 1 }, func(s *PopulationState) { s.Actors[0].MoveStartTick = 100 }, func(s *PopulationState) { s.Actors[0].QueueReason = "invented" }} {
		bad := s.Clone()
		mutate(&bad)
		if bad.Validate(p, l, 1, 1) == nil {
			t.Fatal("invalid population state accepted")
		}
	}
	before := s.Clone()
	if err := s.Advance(p, l, 0, 0, "a", PopulationEnvironment{}); err == nil || !reflect.DeepEqual(s.Clone(), before) {
		t.Fatal("backwards clock mutated population")
	}
	if _, err := p.Start(l, 301, 0, 0); err == nil {
		t.Fatal("unbounded population count")
	}
	if err := (PopulationState{}).Validate(PopulationModel{}, l, 0, 0); err != nil {
		t.Fatal("empty legacy population rejected", err)
	}
}
func BenchmarkPopulation100And300(b *testing.B) {
	for _, count := range []int{100, 300} {
		for _, near := range []bool{false, true} {
			b.Run(fmt.Sprintf("actors=%d/near=%v", count, near), func(b *testing.B) {
				p, l := populationFixture()
				s, err := p.Start(l, count, 0, 0)
				if err != nil {
					b.Fatal(err)
				}
				level := ""
				if near {
					level = "a"
				}
				if err := s.Advance(p, l, 1, 1, level, PopulationEnvironment{}); err != nil {
					b.Fatal(err)
				}
				b.ReportAllocs()
				b.ResetTimer()
				for i := 0; i < b.N; i++ {
					if err := s.Advance(p, l, int64(i+2), int64(i+2), level, PopulationEnvironment{}); err != nil {
						b.Fatal(err)
					}
				}
			})
		}
	}
}

func TestPopulationTransitSaveReplay(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 30, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 28800, 1, "", PopulationEnvironment{})
	populationAdvance(t, &s, p, l, 28810, 2, "", PopulationEnvironment{})
	aboard := 0
	for _, a := range s.Actors {
		if a.Trip != nil {
			aboard++
		}
	}
	if aboard == 0 {
		t.Fatal("fixture has no active journey")
	}
	raw, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var restored PopulationState
	if err := json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	for tick := int64(3); tick < 50; tick++ {
		level := ""
		if tick > 20 {
			level = "b"
		}
		seconds := 28800 + tick*10
		populationAdvance(t, &s, p, l, seconds, tick, level, PopulationEnvironment{})
		populationAdvance(t, &restored, p, l, seconds, tick, level, PopulationEnvironment{})
		if !reflect.DeepEqual(s.Clone(), restored.Clone()) {
			t.Fatal("transit replay diverged")
		}
	}
}
func TestPopulationRejectsExternalCollisionBeforeMutation(t *testing.T) {
	p, l := populationFixture()
	s, err := p.Start(l, 3, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	populationAdvance(t, &s, p, l, 1, 1, "a", PopulationEnvironment{})
	at := s.Actors[0].Position
	before := s.Clone()
	env := PopulationEnvironment{Occupied: map[string]map[Cell]bool{"a": {at: true}}}
	if err := s.Advance(p, l, 2, 2, "a", env); err == nil || !reflect.DeepEqual(before, s.Clone()) {
		t.Fatal("conflicting host occupancy accepted or mutated population")
	}
	bad := s.Clone()
	bad.Actors = bad.Actors[:2]
	if bad.Validate(p, l, 1, 1) == nil {
		t.Fatal("truncated identity registry accepted")
	}
}
func BenchmarkPopulationShiftChange(b *testing.B) {
	for _, count := range []int{100, 300} {
		b.Run(fmt.Sprintf("actors=%d", count), func(b *testing.B) {
			p, l := populationFixture()
			initial, err := p.Start(l, count, 0, 0)
			if err != nil {
				b.Fatal(err)
			}
			if err := initial.Advance(p, l, 1, 1, "a", PopulationEnvironment{}); err != nil {
				b.Fatal(err)
			}
			b.ReportAllocs()
			b.ResetTimer()
			for i := 0; i < b.N; i++ {
				b.StopTimer()
				s := initial.Clone()
				b.StartTimer()
				if err := s.Advance(p, l, 28800, 2, "a", PopulationEnvironment{}); err != nil {
					b.Fatal(err)
				}
			}
		})
	}
}
