// memoryShown: the instance of the definition a person shows now — on his tray or his shop's display, for sale and not
// hidden; his stock is never a talk's thing; deterministic (the smaller stack, then by id).
func (r *Runtime) memoryShown(owner, definition string) (inv.Item, bool) {
	display := map[string]bool{}
	for _, p := range r.world.Peddlers.Peddlers {
		display[p.Tray] = true
	}
	for _, sh := range r.world.Inventory.Shopfronts {
		display[sh.DisplayStore] = true
	}
	ids := make([]string, 0)
	for id, i := range r.state.Inventory.Items {
		if i.Owner == owner && i.Definition == definition && i.Quantity > 0 && i.ForSale && !i.Hidden && i.Location.Kind == "store" && display[i.Location.Store] {
			ids = append(ids, id)
		}
	}
	if len(ids) == 0 {
		return inv.Item{}, false
	}
	sort.Slice(ids, func(a, b int) bool {
		x, y := r.state.Inventory.Items[ids[a]], r.state.Inventory.Items[ids[b]]
		if x.Quantity != y.Quantity {
			return x.Quantity < y.Quantity
		}
		return ids[a] < ids[b]
	})
	return r.state.Inventory.Items[ids[0]], true
}

// memoryCarried: an instance of the definition the hero has (any, by id).
func (r *Runtime) memoryCarried(definition string) (inv.Item, bool) {
	ids := make([]string, 0)
	for id, i := range r.state.Inventory.Items {
		if i.Owner == playerActorID && i.Definition == definition && i.Quantity > 0 {
			ids = append(ids, id)
		}
	}
	if len(ids) == 0 {
		return inv.Item{}, false
	}
	sort.Strings(ids)
	return r.state.Inventory.Items[ids[0]], true
}

// talkThings binds the things a talk is about when it opens (doc 09, 21.11): every item its conditions or effects name
// with an owner other than the hero is the exact instance he shows then; an effect acts on that one, and a line about it
// is hidden once it is gone. The trader's stock is never touched.
func (r *Runtime) talkThings(c talkCtx) {
	c.t.Things = nil
	var when func(w *memWhen)
	bind := func(owner, item string) {
		if owner == "hero" || owner == "" {
			return
		}
		who := c.person(owner)
		if it, ok := r.memoryShown(who, item); ok {
			if c.t.Things == nil {
				c.t.Things = map[string]string{}
			}
			c.t.Things[who+"|"+item] = it.ID
		}
	}
	when = func(w *memWhen) {
		if w == nil {
			return
		}
		if w.Item != nil {
			bind(w.Item.Owner, w.Item.Item)
		}
		for i := range w.Any {
			when(&w.Any[i])
		}
		when(w.Not)
	}
	do := func(list []memDo) {
		for _, d := range list {
			when(d.When)
			if d.GiveItem != nil {
				bind(d.GiveItem.From, d.GiveItem.Item)
			}
			if d.ItemCondition != nil {
				bind(d.ItemCondition.Owner, d.ItemCondition.Item)
			}
		}
	}
	for _, e := range c.conv.Entries {
		when(e.When)
	}
	for _, n := range c.conv.Nodes {
		for _, v := range n.Voices {
			when(v.When)
			do(v.Do)
		}
		for _, o := range n.Options {
			when(o.When)
			do(o.Do)
			if o.Fail != nil {
				do(o.Fail.Do)
			}
		}
	}
}

// memoryItem: the talk's thing of this owner and definition (the exact instance bound when the talk opened, still his), or
// the hero's own; without a talk, the instance the owner shows.
func (r *Runtime) memoryItem(c talkCtx, owner, definition string) (inv.Item, bool) {
	if owner == playerActorID {
		return r.memoryCarried(definition)
	}
	if c.t == nil {
		return r.memoryShown(owner, definition)
	}
	id := c.t.Things[owner+"|"+definition]
	it, ok := r.state.Inventory.Items[id]
	if id == "" || !ok || it.Owner != owner || it.Definition != definition || it.Quantity < 1 {
		return inv.Item{}, false
	}
	return it, true
}

