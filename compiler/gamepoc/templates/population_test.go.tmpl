func TestPopulationRuntimeHeroCannotClaimReservedStep(t *testing.T) {
	r := populationRuntimeFixture(t, 100)
	hero := r.state.Life.Actor(playerActorID)
	var target behavior.Cell
	var residentID string
	found := false
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if !a.Materialized || a.Level != hero.Level {
			continue
		}
		blocked := r.state.Life.BlockedCells(a.Level, "")
		for _, at := range []behavior.Cell{{X: a.Position.X + 1, Y: a.Position.Y}, {X: a.Position.X, Y: a.Position.Y + 1}, {X: a.Position.X - 1, Y: a.Position.Y}, {X: a.Position.X, Y: a.Position.Y - 1}} {
			if r.world.Life.Walks(a.Level, at) && !blocked[at] {
				a.Path = []behavior.Cell{at}
				a.Goal = at
				target = at
				residentID = a.ID
				found = true
				break
			}
		}
		if found {
			break
		}
	}
	if !found {
		t.Fatal("fixture has no free neighboring cell")
	}
	c := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{})}
	before := hero.Position
	r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1, X: int32(target.X), Y: int32(target.Y)})
	result := (<-c.out).GetMoveResult()
	// A future intention can be accepted, but cannot claim somebody else's
	// physical next step. Rejecting the whole command would reveal unseen traffic.
	if result == nil || !result.Ok || hero.Position != before || (len(hero.Path)>0 && hero.Path[0]==target) {
		t.Fatal("intent rejected hidden traffic or claimed population reservation")
	}
	for _,a:=range r.state.Life.Population.Actors{if a.ID==residentID&&(len(a.Path)==0||a.Path[0]!=target){t.Fatal("input cancelled the resident's accepted segment")}}
	r.state.Life.SecondsPerTick=1
	for i:=0;i<24;i++{r.step();if err:=r.validateLifeSave(r.snapshotState());err!=nil{t.Fatalf("tick %d: %v",r.state.Tick,err)}}
}
