    if(mark.shape=="line_x"){SenseLine(SpatialPaintPoint(at,tw,th,0,.5f+lane),SpatialPaintPoint(at,tw,th,1,.5f+lane),color);continue;}
    if(mark.shape=="line_y"){SenseLine(SpatialPaintPoint(at,tw,th,.5f+lane,0),SpatialPaintPoint(at,tw,th,.5f+lane,1),color);continue;}
    if(!string.IsNullOrEmpty(mark.symbol)){
     if(spatialSymbolStyle==null){spatialSymbolStyle=new GUIStyle(smallStyle){alignment=TextAnchor.MiddleCenter,fontSize=11,clipping=TextClipping.Clip,wordWrap=false};spatialSymbolStyle.normal.textColor=Color.white;}
     Vector2 center=SpatialPaintPoint(at,tw,th,.5f+lane,.5f-lane);Color before=GUI.color;GUI.color=color;GUI.Label(new Rect(center.x-8,center.y-7,16,14),mark.symbol,spatialSymbolStyle);GUI.color=before;continue;
    }
    float size=.25f+(mark.resolved_variant%3)*.08f;var previous=GUI.color;GUI.color=color;GUI.DrawTexture(new Rect(at.x+tw*(1-size)/2,at.y+th*(1-size)/2,tw*size,th*size),diamond);GUI.color=previous;
   }
  }
  void StartSpatialPreview(){spatialPreviewEpoch=state==null?null:state.Epoch;spatialPreviewPending=true;NewGame(resource.config.seed,"life100");}
  void AdvanceSpatialPreview(){if(!spatialPreviewPending||state==null||state.Life==null||!state.Life.Enabled||state.Epoch==spatialPreviewEpoch||!CanSend()||!string.IsNullOrEmpty(busy))return;spatialPreviewPending=false;LifeCommand("goto","level.c7_market");}
  bool SpatialProjectionProof(int x,int y){
   float previous=spatialZoom;bool ok=true;
   foreach(float zoom in new[]{SpatialZoomMin(),SpatialZoomDefault(),SpatialZoomMax()}){spatialZoom=zoom;Vector2 origin;float tw,th;GetSpatialProjection(out origin,out tw,out th);var screen=CellScreen(origin,tw,th,x,y);var grid=SpatialGridPoint(screen,origin,tw,th);if(Mathf.FloorToInt(grid.x)!=x||Mathf.FloorToInt(grid.y)!=y)ok=false;}
   spatialZoom=previous;return ok;
  }
  bool SpatialDoorProofReady(PocLifeMarker marker){
   if(state==null||state.Life==null||state.Life.Transit||state.Path.Count!=0||state.Life.Automatic)return false;
   return Mathf.Abs(state.PlayerX-marker.X)+Mathf.Abs(state.PlayerY-marker.Y)<=2;
  }
 }
