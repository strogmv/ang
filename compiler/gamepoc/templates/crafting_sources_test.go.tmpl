func craftingSetMoney(r *Runtime, minor int64) {
	a := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account]
	a.Balance = minor
	r.state.Inventory.Accounts[a.ID] = a
}
func craftingSetAccount(t *testing.T, r *Runtime, actor string, minor int64) {
	t.Helper()
	a, ok := r.craftingAccount(actor)
	if !ok {
		t.Fatalf("no account of %s", actor)
	}
	a.Balance = minor
	r.state.Inventory.Accounts[a.ID] = a
}
func craftingAtTerminal(t *testing.T, r *Runtime) {
	t.Helper()
	ts := r.world.Crafting.Law.Rebind.Terminals
	if len(ts) == 0 {
		t.Fatal("no equipment terminal")
	}
	a := r.state.Life.Actor(playerActorID)
	a.Level, a.Position, a.Path, a.Arrived, a.Trip = ts[0].Level, behavior.Cell{X: ts[0].At.X, Y: ts[0].At.Y}, nil, true, nil
}
func craftingBringNear(t *testing.T, r *Runtime, actor string) {
	t.Helper()
	h, a := r.state.Life.Actor(playerActorID), r.state.Life.Actor(actor)
	if h == nil || a == nil {
		t.Fatalf("no Life actor %s", actor)
	}
	a.Level, a.Position, a.Path, a.Arrived, a.Trip = h.Level, behavior.Cell{X: h.Position.X + 1, Y: h.Position.Y}, nil, true, nil
}
func craftingAnyItem(r *Runtime, definition string) inv.Item {
	for _, id := range sortedItemIDs(r.state.Inventory) {
		if i := r.state.Inventory.Items[id]; i.Definition == definition && i.Owner != playerActorID {
			return i
		}
	}
	return inv.Item{}
}
func craftingDoOn(r *Runtime, action, recipe, item, target string) error {
	return r.craftingCommand(&pb.PocCraftingCommand{RequestId: "t", Epoch: r.state.Epoch, Action: action, Recipe: recipe, ItemId: item, Target: target}, "ru")
}
func craftingRelate(t *testing.T, r *Runtime, from string, v float64) {
	t.Helper()
	if err := r.state.Life.SetRelation(from, playerActorID, v); err != nil {
		t.Fatal(err)
	}
}

func TestCraftingGreyCopyCarriesItsErrorUntilTheFirstBuildAndAMasterCorrectsIt(t *testing.T) {
	r := craftingFixture(t)
	m := r.world.Crafting
	c, _ := m.Carrier("item.schematic.copy_earphones")
	craftingStandAway(r)
	craftingGive(t, r, c.Item, 1)
	sheet := craftingHeroItem(r, c.Item)
	seed := int64(0)
	for s := int64(1); s < 400 && seed == 0; s++ {
		if m.CopyFlaw(s, sheet.ID, c) != "" {
			seed = s
		}
	}
	if seed == 0 {
		t.Fatal("no seed gives a flawed copy")
	}
	r.state.Seed = seed
	if err := craftingDo(r, "study", "", sheet.ID, ""); err != nil {
		t.Fatal(err)
	}
	craftingRun(t, r, c.StudyMinutes*60)
	a := r.state.Crafting.Actors[playerActorID]
	if !a.Known["craft.earphones"] || a.Flaws["craft.earphones"] == "" || a.Revealed["craft.earphones"] {
		t.Fatalf("the flawed copy must be in memory with a hidden error: %+v", a)
	}
	if craftingHeroItem(r, c.Item).ID == "" {
		t.Fatal("studying consumed the carrier (it stays a thing to sell or hand over)")
	}
	// the error shows in the book only after a build
	book := func() *pb.PocCraftingRecipe {
		for _, b := range craftingView(r, "ru").Book {
			if b.Id == "craft.earphones" {
				return b
			}
		}
		return nil
	}
	if b := book(); b == nil || b.Flawed {
		t.Fatal("the error is visible before the first build")
	}
	a.Points["electrics"] = 40000
	r.state.Crafting.Actors[playerActorID] = a
	craftingOpen(t, r, craftingMatvey)
	craftingStand(t, r, craftingMatvey)
	craftingGive(t, r, "item.part.speaker", 2)
	craftingGive(t, r, "item.part.braided_cable", 1)
	flawed, _ := m.Plan(r.craftingWorker(playerActorID), crafting.Request{Recipe: "craft.earphones", JobID: "x", Seed: seed}, r.craftingHeroStacks(""), nil, r.craftingBench(r.craftingHero()))
	clean := r.craftingWorker(playerActorID)
	clean.Flaws = nil
	honest, _ := m.Plan(clean, crafting.Request{Recipe: "craft.earphones", JobID: "x", Seed: seed}, r.craftingHeroStacks(""), nil, r.craftingBench(r.craftingHero()))
	if flawed.Flaw == "" || flawed.Quality > honest.Quality || flawed.RiskPermille < honest.RiskPermille || flawed.Quality == honest.Quality && flawed.RiskPermille == honest.RiskPermille {
		t.Fatalf("the error does not worsen the build: %+v vs %+v", flawed, honest)
	}
	if err := craftingDo(r, "start", "craft.earphones", "", ""); err != nil {
		t.Fatal(err)
	}
	craftingRun(t, r, 50*60)
	if b := book(); b == nil || !b.Flawed || b.Flaw == "" || !r.state.Crafting.Actors[playerActorID].Revealed["craft.earphones"] {
		t.Fatal("the first build did not show the error of the copy")
	}
	// a clean source (Matvey, who knows it) replaces the error
	craftingRelate(t, r, craftingMatvey, 0.3)
	if err := craftingDo(r, "apprentice", "craft.earphones", "", ""); err != nil {
		t.Fatal(err)
	}
	craftingRun(t, r, 4*3600)
	if f := r.state.Crafting.Actors[playerActorID].Flaws["craft.earphones"]; f != "" {
		t.Fatalf("apprenticeship did not correct the copy error %q", f)
	}
}

func TestCraftingApprenticeshipNeedsAWorkingWellDisposedMaster(t *testing.T) {
	r := craftingFixture(t)
	craftingOpen(t, r, craftingMatvey)
	craftingStand(t, r, craftingMatvey)
	before := r.snapshotState()
	if err := craftingDo(r, "apprentice", "craft.earphones", "", ""); err == nil {
		t.Fatal("Matvey taught a stranger (relation 0 below 0.2)")
	}
	if !reflectEqualCrafting(before, r.snapshotState()) {
		t.Fatal("a refusal changed the world")
	}
	craftingRelate(t, r, craftingMatvey, 0.25)
	hero0, money := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance, craftingMoney(r)
	if err := craftingDo(r, "apprentice", "craft.earphones", "", ""); err != nil {
		t.Fatal(err)
	}
	tch, _ := r.world.Crafting.Teaching(craftingMatvey, "craft.earphones")
	if r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance != hero0-tch.FeeMinor || craftingMoney(r) != money {
		t.Fatal("the fee did not go to Matvey")
	}
	craftingStandAway(r)
	craftingRun(t, r, 3600)
	if r.state.Crafting.Jobs[0].Progress != 0 {
		t.Fatal("the lesson went on with the pupil away from the bench")
	}
	craftingStand(t, r, craftingMatvey)
	rel0 := r.craftingRelation(craftingMatvey, playerActorID)
	craftingRun(t, r, tch.Hours*3600)
	if !r.craftingKnowsClean("craft.earphones") || len(r.state.Crafting.Jobs) != 0 || r.craftingRelation(craftingMatvey, playerActorID) <= rel0 {
		t.Fatal("the lesson did not teach the schematic or warm the master")
	}
}

