// The unit whose approach (2 rows in front of the face) the hero stands on, or -1.
func (r *Runtime) vendingHeroUnit() int {
	v := r.world.Vending
	hero := r.state.Life.Actor(playerActorID)
	if len(v.Units) == 0 || !r.state.Life.Enabled || hero == nil || !hero.OnFloor() || hero.Level != v.Level {
		return -1
	}
	at := inv.Cell{X: hero.Position.X, Y: hero.Position.Y}
	for i, u := range v.Units {
		for _, c := range u.Approach {
			if c == at {
				return i
			}
		}
	}
	return -1
}
