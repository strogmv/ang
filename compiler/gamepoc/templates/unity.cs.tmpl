                shownPosition = new Vector2(value.PlayerX, value.PlayerY);
                renderedSimNS = value.SimTimeNs; pendingMove = 0; beginPending = false; markerUntil = 0;
            }
            if (value.Paused || state == null || state.Paused) renderedSimNS = value.SimTimeNs;
            stateReceivedAt = clock.Elapsed.TotalSeconds;
            state = value;
            connected = true;
            if (message.StartsWith("Запускаем") || message.StartsWith("Связь прервана")) message = "Мир готов";
            if (openGame && state.Active) { page = "game"; openGame = false; }
        }

