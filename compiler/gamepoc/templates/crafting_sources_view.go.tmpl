// CraftingMinutes formats a duration of minutes for an option line.
func CraftingMinutes(minutes int64) string {
	if minutes >= 120 {
		return strconv.FormatInt(minutes/60, 10) + " h " + strconv.FormatInt(minutes%60, 10) + "'"
	}
	return strconv.FormatInt(minutes, 10) + "'"
}
