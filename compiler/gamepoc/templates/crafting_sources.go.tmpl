// craftingRelation: the directed relation of one actor to another (Life, -1..1) in permille.
func (r *Runtime) craftingRelation(from, to string) int64 {
	return int64(math.Round(r.state.Life.RelationTo(r.world.Life, from, to) * 1000))
}
func (r *Runtime) craftingShiftRelation(from, to string, delta int64) {
	v := float64(max(-1000, min(1000, r.craftingRelation(from, to)+delta))) / 1000
	_ = r.state.Life.SetRelation(from, to, v)
}
func craftingPermille(v int64) string {
	s := strconv.FormatFloat(float64(v)/1000, 'f', 2, 64)
	return s
}
func (r *Runtime) craftingActorName(locale, id string) string {
	return r.craftingText(locale, "actor."+id+".name")
}

// craftingHeroCarried: a carried instance of the hero (not in the work store).
func (r *Runtime) craftingHeroCarried(id string) (inv.Item, bool) {
	i, ok := r.state.Inventory.Items[id]
	if !ok || i.Owner != playerActorID || !r.carried(i) || (i.Location.Kind == "store" && i.Location.Store == r.world.Crafting.Hero.WorkStore) {
		return inv.Item{}, false
	}
	return i, true
}

// craftingKnowsClean: the hero has the schematic in memory without an error (or as general knowledge of the tier).
func (r *Runtime) craftingKnowsClean(recipe string) bool {
	m := r.world.Crafting
	rec, ok := m.Recipe(recipe)
	return ok && m.KnowsClean(r.craftingWorker(m.Hero.Actor), rec)
}
func (r *Runtime) craftingLearnJob(p crafting.Plan, note string) {
	m := r.world.Crafting
	now := r.state.Life.Seconds
	job := r.craftingJobID()
	r.state.Crafting.Serial++
	r.state.Crafting.Jobs = append(r.state.Crafting.Jobs, crafting.Job{ID: job, Worker: m.Hero.Actor, Plan: p, Store: m.Hero.WorkStore, Start: now, Due: now + p.Seconds})
	r.state.Crafting.Notice = crafting.Notice{Key: note, Recipe: p.Learn, Second: now}
}

// ---------------------------------------------------------------- commands
func (r *Runtime) craftingStudy(itemID string) error {
	m := r.world.Crafting
	if r.state.Crafting.JobOf(m.Hero.Actor) >= 0 {
		return textError{Key: "crafting.error.busy"}
	}
	i, ok := r.craftingHeroCarried(itemID)
	if !ok {
		return crafting.Refusal{Key: "crafting.error.no_target"}
	}
	c, ok := m.Carrier(i.Definition)
	if !ok {
		return textError{Key: "crafting.error.not_carrier"}
	}
	rec, _ := m.Recipe(c.Teaches)
	flaw := ""
	if c.Kind == "copy" {
		flaw = m.CopyFlaw(r.state.Seed, i.ID, c)
	}
	if r.craftingKnowsClean(rec.ID) {
		return textError{Key: "crafting.error.already_known"}
	}
	gain := m.Tuning.GainMilli["learn"] * int64(rec.Tier)
	r.craftingLearnJob(crafting.Plan{Recipe: rec.ID, Kind: "study", Worker: m.Hero.Actor, Target: i.ID, Seconds: c.StudyMinutes * 60, Quality: 3, Outcome: "success", Learn: rec.ID, Flaw: flaw, GainMilli: gain}, "crafting.notice.started")
	return nil
}
func (r *Runtime) craftingApprentice(hero *behavior.LifeActor, recipeID string) error {
	m := r.world.Crafting
	if r.state.Crafting.JobOf(m.Hero.Actor) >= 0 {
		return textError{Key: "crafting.error.busy"}
	}
	ms, ok := r.craftingCounter(hero)
	if !ok {
		return textError{Key: "crafting.error.no_master"}
	}
	t, ok := m.Teaching(ms.Actor, recipeID)
	if !ok {
		return textError{Key: "crafting.error.not_taught"}
	}
	if !r.storefrontOpen(ms.Shop) {
		return textError{Key: "crafting.error.master_closed"}
	}
	if r.craftingRelation(ms.Actor, m.Hero.Actor) < t.MinRelationPermille {
		return crafting.Refusal{Key: "crafting.error.refuses", Detail: ms.Actor}
	}
	if r.craftingKnowsClean(recipeID) {
		return textError{Key: "crafting.error.already_known"}
	}
	if t.FeeMinor > 0 {
		if r.state.Crafting.Law.Frozen {
			return textError{Key: "crafting.error.frozen"}
		}
		if r.state.Inventory.Accounts[m.Hero.Account].Balance < t.FeeMinor {
			return textError{Key: "crafting.error.no_money"}
		}
		if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Payments: []inv.Payment{r.craftingPayment(m.Hero.Account, ms.Account, t.FeeMinor)}}); err != nil {
			return textError{Key: "crafting.error.inventory"}
		}
	}
	rec, _ := m.Recipe(recipeID)
	r.craftingLearnJob(crafting.Plan{Recipe: recipeID, Kind: "apprentice", Worker: m.Hero.Actor, Target: ms.Actor, Station: ms.Station, Seconds: t.Hours * 3600, Quality: 3, Outcome: "success", Learn: recipeID, GainMilli: m.Tuning.GainMilli["learn"] * int64(rec.Tier), RentMinor: t.FeeMinor}, "crafting.notice.apprentice")
	return nil
}

// craftingAsk: a person within reach who knows the schematic tells it at once, if the relation allows.
func (r *Runtime) craftingAsk(hero *behavior.LifeActor, target, recipeID string) error {
	m := r.world.Crafting
	var teller *crafting.Oral
	for k := range m.Sources.Oral {
		o := m.Sources.Oral[k]
		a := r.state.Life.Actor(o.From)
		if o.Recipe != recipeID || (target != "" && target != o.From) || a == nil || a.Level != hero.Level || !craftingNear(hero.Position, crafting.Cell{X: a.Position.X, Y: a.Position.Y}, o.Reach) {
			continue
		}
		teller = &o
		break
	}
	if teller == nil {
		return textError{Key: "crafting.error.nobody"}
	}
	if r.craftingRelation(teller.From, m.Hero.Actor) < teller.MinRelationPermille {
		return crafting.Refusal{Key: "crafting.error.refuses", Detail: teller.From}
	}
	if r.craftingKnowsClean(recipeID) {
		return textError{Key: "crafting.error.already_known"}
	}
	rec, _ := m.Recipe(recipeID)
	a := r.state.Crafting.Actors[m.Hero.Actor]
	a.Learn(recipeID, "")
	a.Points[rec.Discipline] = min(a.Points[rec.Discipline]+m.Tuning.GainMilli["learn"]*int64(rec.Tier), m.Tuning.CapPoints*1000)
	r.state.Crafting.Actors[m.Hero.Actor] = a
	r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.studied", Recipe: recipeID, Second: r.state.Life.Seconds}
	return nil
}

// craftingSteal: a carrier lying in reach that is not the hero's is taken — theft, a case of the justice ladder.
func (r *Runtime) craftingSteal(hero *behavior.LifeActor, itemID string) error {
	m := r.world.Crafting
	i, ok := r.state.Inventory.Items[itemID]
	if !ok || i.Owner == playerActorID || r.carried(i) {
		return crafting.Refusal{Key: "crafting.error.no_target"}
	}
	if _, ok := m.Carrier(i.Definition); !ok {
		return textError{Key: "crafting.error.not_carrier"}
	}
	model := r.inventoryModelFor(true)
	root, err := r.state.Inventory.Root(model, i.Location)
	if err != nil || root.Kind != "world" || root.Level != hero.Level || !craftingNear(hero.Position, crafting.Cell{X: root.At.X, Y: root.At.Y}, model.Actions.ReachCells) {
		return crafting.Refusal{Key: "crafting.error.no_target"}
	}
	mv := inv.Relocate{Item: itemID, Quantity: 1, To: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, Owner: playerActorID}
	if i.Quantity > 1 {
		mv.Split = "instance:craft:steal:" + strconv.FormatUint(r.state.Crafting.Serial+1, 10)
		r.state.Crafting.Serial++
	}
	if _, err := r.state.Inventory.Transform(model, inv.Transform{Relocate: []inv.Relocate{mv}}); err != nil {
		return textError{Key: "crafting.error.inventory"}
	}
	taken := itemID
	if mv.Split != "" {
		taken = mv.Split
	}
	r.craftingOffence("theft", taken, r.craftingWitnesses(hero), false)
	r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.stolen", Detail: i.Definition, Second: r.state.Life.Seconds}
	return nil
}

// craftingInspect: looking a thing over shows a master's swap; caught, the master loses the relation both ways and
// returns part of the price (rumours at the yatai: hook — there is no rumour system yet).
func (r *Runtime) craftingInspect(itemID string) error {
	m := r.world.Crafting
	if _, ok := r.craftingHeroCarried(itemID); !ok {
		return crafting.Refusal{Key: "crafting.error.no_target"}
	}
	now := r.state.Life.Seconds
	sw, ok := r.state.Crafting.Market.Swaps[itemID]
	if !ok || sw.Seen {
		r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.clean", Second: now}
		return nil
	}
	sw.Seen = true
	r.state.Crafting.Market.Swaps[itemID] = sw
	r.craftingShiftRelation(sw.Master, m.Hero.Actor, m.Market.Caught.RelationDeltaPermille)
	r.craftingShiftRelation(m.Hero.Actor, sw.Master, m.Market.Caught.RelationDeltaPermille)
	if ms, ok := m.Master(sw.Master); ok && sw.Paid > 0 {
		refund := min(sw.Paid*m.Market.Caught.RefundPermille/1000, r.state.Inventory.Accounts[ms.Account].Balance)
		if refund > 0 {
			_, _ = r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Payments: []inv.Payment{r.craftingPayment(ms.Account, m.Hero.Account, refund)}})
		}
	}
	r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.swap", Second: now}
	return nil
}

// craftingCancelOrder: the hero takes the thing back at the counter before the order is done; the master returns the
// share of the refund rules and keeps his parts.
func (r *Runtime) craftingCancelOrder(hero *behavior.LifeActor, k int) error {
	m := r.world.Crafting
	j := r.state.Crafting.Jobs[k]
	if j.Client != m.Hero.Actor || j.Done {
		return textError{Key: "crafting.error.no_job"}
	}
	ms, ok := r.craftingCounter(hero)
	if !ok || ms.Actor != j.Worker {
		return textError{Key: "crafting.error.no_master"}
	}
	share := m.RefundPermille(j.Progress, j.Done)
	refund := min(j.PaidMinor*share/1000, r.state.Inventory.Accounts[ms.Account].Balance)
	back := inv.Location{Kind: "store", Store: ms.Stores[len(ms.Stores)-1]}
	t := inv.Transform{Relocate: r.craftingReturn(j, inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, &back)}
	if refund > 0 {
		t.Payments = append(t.Payments, r.craftingPayment(ms.Account, m.Hero.Account, refund))
	}
	if len(t.Relocate)+len(t.Payments) > 0 {
		if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), t); err != nil {
			return textError{Key: "crafting.error.inventory"}
		}
	}
	r.craftingRemove(k)
	r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.order_cancelled", Detail: strconv.FormatInt(share/10, 10), Second: r.state.Life.Seconds}
	return nil
}

// craftingLearnFinish ends a study or an apprenticeship: the schematic goes into memory (a flawed copy keeps its error),
// the discipline gains, the teacher warms to the pupil. A carrier lost during the study teaches nothing.
func (r *Runtime) craftingLearnFinish(k int) {
	m := r.world.Crafting
	j := r.state.Crafting.Jobs[k]
	now := r.state.Life.Seconds
	r.craftingRemove(k)
	if j.Plan.Kind == "study" {
		if _, ok := r.craftingHeroCarried(j.Plan.Target); !ok {
			r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.failure", Recipe: j.Plan.Learn, Second: now}
			return
		}
	}
	rec, _ := m.Recipe(j.Plan.Learn)
	a := r.state.Crafting.Actors[m.Hero.Actor]
	a.Learn(j.Plan.Learn, j.Plan.Flaw)
	a.Points[rec.Discipline] = min(a.Points[rec.Discipline]+j.Plan.GainMilli, m.Tuning.CapPoints*1000)
	r.state.Crafting.Actors[m.Hero.Actor] = a
	if j.Plan.Kind == "apprentice" {
		if t, ok := m.Teaching(j.Plan.Target, j.Plan.Learn); ok {
			r.craftingShiftRelation(t.Master, m.Hero.Actor, t.GainPermille)
		}
	}
	r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.studied", Recipe: j.Plan.Learn, Second: now}
}
