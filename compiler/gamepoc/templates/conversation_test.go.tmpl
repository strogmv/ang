}
func TestMemoryMissingStartsAtHallOpening(t *testing.T) {
	r := memoryDay(t, 3)
	e := r.world.CalendarEncounter
	day := e.FirstDays * 86400
	// Advance the real kernel so the save has matching game, motion and service clocks.
	encounterAdvanceTo(t, r, day+600)
	if _, ok := r.state.Memory.Facts[e.Facts.Missing]; ok {
		t.Fatal("missing fact written at night")
	}
	r.state = memoryRoundTripBytes(t, r, r.snapshotState())
	r.calendarEncounterAfterFrame()
	if _, ok := r.state.Memory.Facts[e.Facts.Missing]; ok {
		t.Fatal("load wrote missing fact at night")
	}
	encounterAdvanceTo(t, r, day+r.encounterHallOpening()-1)
	if _, ok := r.state.Memory.Facts[e.Facts.Missing]; ok {
		t.Fatal("fact before opening")
	}
	encounterAdvanceTo(t, r, day+r.encounterHallOpening())
	rec, ok := r.state.Memory.Facts[e.Facts.Missing]
	if !ok || rec.First != r.state.Life.Seconds {
		t.Fatalf("opening fact has wrong first time: %+v", rec)
	}
}
func TestMemoryFactArgumentSetsAndLegacySave(t *testing.T) {
	r := encounterFixture(t)
	if r.state.Memory.Migrated != memoryMigrationVersion {
		t.Fatal("new Life world lacks its migration mark")
	}
	e := r.world.CalendarEncounter
	id := r.encounterMetFact()
	c := talkCtx{self: e.Actor}
	r.memoryWrite(id, map[string]string{"how": "helped"}, c)
	r.memoryWrite(id, map[string]string{"how": "bought"}, c)
	if r.state.Memory.Facts[id].Count != 2 {
		t.Fatal("two writes did not bump Count to two")
	}
	r.memoryWrite(id, map[string]string{"how": "helped"}, c)
	for _, v := range []string{"helped", "bought"} {
		if !r.memoryHolds(c, &memWhen{Fact: &memFactWhen{ID: id, Args: map[string]string{"how": v}}}) {
			t.Fatalf("lost %s", v)
		}
	}
	if f := r.state.Memory.Facts[id]; f.Count != 3 || !reflect.DeepEqual(f.Args["how"], []string{"bought", "helped"}) {
		t.Fatalf("not a counted set: %+v", f)
	}
	r.state = memoryRoundTripBytes(t, r, r.snapshotState())
	var legacy memoryFact
	if err := json.Unmarshal([]byte(`{"First":0,"Second":0,"Count":1,"Args":{"how":"helped"}}`), &legacy); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(legacy.Args["how"], []string{"helped"}) {
		t.Fatal("legacy argument lost")
	}
}
func TestMemoryOnceSurvivesRemovedConversationFlow(t *testing.T) {
	r := encounterFixture(t)
	e := r.world.CalendarEncounter
	key := talkKey(e.Talk.Sack, e.Actor)
	d := r.world.Conversations[e.Talk.Sack]
	// Keep one once answer and one failed check; a removed node invalidates only the flow.
	once, check := "", ""
	var checkOption convOption
	for _, n := range d.Nodes {
		for _, o := range n.Options {
			if o.Once {
				once = o.ID
			}
			if o.Check != nil {
				check = o.ID
				checkOption = o
			}
		}
	}
	if once == "" || check == "" {
		t.Fatal("fixture needs a once answer and check")
	}
	tk := r.talkState(key)
	tk.Node = d.Entries[len(d.Entries)-1].Node
	tk.Nodes = []string{tk.Node}
	tk.Chosen = []string{once, "ask_work"}
	tk.Checks = map[string]dialogueCheckRecord{check: {Attempts: 1, Success: false, SkillAt: 100}}
	r.state.Memory.rememberTalk(key, tk)
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	editConversation(t, r, e.Talk.Sack, func(d *conversationDef) {
		for _, n := range d.Nodes {
			keep := n.Options[:0]
			for _, o := range n.Options {
				if o.ID != "ask_work" {
					keep = append(keep, o)
				}
			}
			n.Options = keep
		}
	})
	r.canonicalWorld.Conversations = r.world.Conversations
	d = r.world.Conversations[e.Talk.Sack]
	s, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if s.Memory.Talks[key] != nil {
		t.Fatal("invalid flow kept")
	}
	r.state = s
	tk = r.talkState(key)
	c := talkCtx{conv: d, key: key, self: e.Actor, t: tk}
	if !tk.chose(once) || tk.Checks[check].Success || tk.Checks[check].Attempts != 1 {
		t.Fatal("once outcomes lost")
	}
	if r.optionOwn(c, convOption{ID: once, Once: true}) {
		t.Fatal("once answer offered again")
	}
	if open, _ := r.dialogueCheckOpen(&tk.dialogueSession, check, *checkOption.Check); open {
		t.Fatal("failed check rerolled")
	}
	r.state = memoryRoundTripBytes(t, r, r.snapshotState())
}
func TestMemoryPreDialogueSaveCorpusIsStable(t *testing.T) {
	corpus := saveCorpus(t)
	count := 0
	for _, name := range saveCorpusNames(corpus) {
		r, slot := corpusRuntime(t, corpus[name])
		s, _, err := r.readSave(slot)
		if err != nil {
			t.Fatalf("%s: %v", name, err)
