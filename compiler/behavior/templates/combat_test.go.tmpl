func TestCombatV4CrampedHeavyAndCareThreat(t *testing.T){
 r,space,s:=combatV4Fixture(t);space.CellMM=500;s.Actor("b").Position=Cell{3,3};s.Actor("a").Weapon.RangeMM=1500;s.Observe(space,r)
 before:=s.Clone();if s.Execute(space,r,"a",CombatAction{Type:"attack",TargetID:"b",Mode:"heavy"})==nil||!reflect.DeepEqual(before,s){t.Fatal("heavy long swing allowed in knife contact or refusal mutated")}
 if !s.ThreatensCare(space,r,*s.Actor("a")){t.Fatal("near enemy cannot interrupt care")};s.Actor("b").Surrendered=true;if s.ThreatensCare(space,r,*s.Actor("a")){t.Fatal("surrendered enemy forbids care")}
 s.Actor("b").Surrendered=false;s.Actor("b").StunTurns=1;if s.ThreatensCare(space,r,*s.Actor("a")){t.Fatal("stunned enemy forbids care")}
}

