// Code generated by ANG. Riders of a vehicle and gates by pass (cargo to the market v1).
package behavior

import ("encoding/json";"reflect";"testing")

// Two levels joined by a walking edge and by a vehicle-only edge of the same pair.
func riderFixture()LifeModel{
 m:=lifeFixture();m.Edges=append(m.Edges,LifeEdge{ID:"ab_vehicle",From:"a",To:"b",Exit:Cell{4,0},Entry:Cell{0,0},Mode:"walk",TravelSeconds:5,Seats:4,Vehicle:true},LifeEdge{ID:"ba_vehicle",From:"b",To:"a",Exit:Cell{0,0},Entry:Cell{4,0},Mode:"walk",TravelSeconds:5,Seats:4,Vehicle:true})
 return m
}

// A vehicle-only edge is never a pedestrian's way, even when it is the fastest one.
func TestLifeRidersVehicleEdgeIsNoWayOnFoot(t *testing.T){
 m:=riderFixture();if err:=m.Validate();err!=nil{t.Fatal(err)}
 if e:=m.NextEdge("a","b");e==nil||e.Vehicle{t.Fatalf("pedestrian route chose %+v",e)}
 only:=riderFixture();only.Edges=[]LifeEdge{only.Edges[2],only.Edges[3]};if only.NextEdge("a","b")!=nil{t.Fatal("a vehicle-only edge connected two levels for people")}
 bad:=riderFixture();bad.Edges[2].Mode="rail";bad.Edges[2].PeriodSeconds=30;if bad.Validate()==nil{t.Fatal("a vehicle-only edge with a timetable was accepted")}
}

// Seated: no floor cell, no own step, carried across the edge by the host; Life never ends that trip itself.
// Afoot: a body on the floor that Life does not walk away. Released: the routine resumes.
func TestLifeRidersAreCarriedByTheirVehicleAndReleased(t *testing.T){
 m:=riderFixture();s:=m.Start();one:=s.Actor("one");seat:=one.Position
 if err:=s.Board("one","vehicle.test","driver");err!=nil{t.Fatal(err)}
 if s.Actor("one").OnFloor()||s.occupied("a",seat,"two"){t.Fatal("a seated rider still holds a floor cell")}
 if err:=s.Board("two","vehicle.other","driver");err!=nil{t.Fatal(err)};if err:=s.Board("two","vehicle.test","side");err==nil{t.Fatal("a rider boarded a second vehicle")};if err:=s.Dismount(m,"two","a",Cell{1,2});err!=nil{t.Fatal(err)}
 for tick:=int64(1);tick<=90;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)};if a:=s.Actor("one");a.Level!="a"||a.Position!=seat||len(a.Path)>0{t.Fatalf("Life moved a seated rider: %+v",a)}}
 if err:=s.Depart(m,"one","ab_vehicle",s.Seconds);err!=nil{t.Fatal(err)}
 arrival:=s.Actor("one").Trip.Arrival
 for tick:=int64(91);s.Seconds<arrival+30;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)};if a:=s.Actor("one");a.Trip==nil||a.Level!="a"{t.Fatalf("Life ended the vehicle's trip on its own: %+v",a)}}
 encoded,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var restored LifeState;if err=json.Unmarshal(encoded,&restored);err!=nil{t.Fatal(err)}
 if !reflect.DeepEqual(s.Clone(),restored.Clone())||restored.Actor("one").Mount==nil{t.Fatal("a rider in transit did not survive a save")}
 if err:=s.Carry(m,"one","b",Cell{0,0});err!=nil{t.Fatal(err)};if a:=s.Actor("one");a.Trip!=nil||a.Level!="b"||a.Visits["b"]<1{t.Fatalf("not carried: %+v",a)}
 tick:=int64(400);s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}
 if err:=s.StepDown(m,"one","b",Cell{0,2});err!=nil{t.Fatal(err)};a:=s.Actor("one")
 if !a.OnFloor()||!s.occupied("b",Cell{0,2},"two"){t.Fatal("an afoot rider is no body on the floor")}
 for ;tick<480;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)};if a:=s.Actor("one");a.Position!=(Cell{0,2}){t.Fatalf("Life walked an afoot rider away: %+v",a)}}
 if err:=s.Stand(m,"one",Cell{1,2});err!=nil{t.Fatal(err)};if err:=s.Dismount(m,"one","b",Cell{1,2});err!=nil{t.Fatal(err)}
 moved:=false;for ;tick<900&&!moved;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)};moved=s.Actor("one").Position!=(Cell{1,2})}
 if !moved{t.Fatal("a released rider did not resume his routine")}
}

// Gate 8 by pass: the vehicle named by a permit has the gate raised in its window only; a host body in the opening
// stops the descent like a person.
func TestLifeRidersGatePermitRaisesForTheVehicleInItsWindow(t *testing.T){
 m:=gateFixture();l:=m.Locations["g"];g:=l.Gates[0];g.Permits=[]LifeGatePermit{{FromSecond:22*3600+60,ToSecond:22*3600+600,Vehicle:"vehicle.test"}};l.Gates=[]LifeGate{g};m.Locations["g"]=l
 if err:=m.Validate();err!=nil{t.Fatal(err)};s:=m.Start()
 if s.SetGatePermit(m,"gate","vehicle.other")==nil{t.Fatal("a vehicle without a pass asked for the gate")}
 tick:=int64(1);for ;tick<=300;tick++{s.Advance(m,tick)};if st:=s.Gates["gate"].State;st!="locked"{t.Fatalf("schedule did not close the gate: %s",st)}
 if err:=s.SetGatePermit(m,"gate","vehicle.test");err!=nil{t.Fatal(err)}
 for ;tick<=500;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}};if st:=s.Gates["gate"].State;st!="open"{t.Fatalf("the pass did not raise the gate in its window: %s",st)}
 s.Vehicles=map[string]map[Cell]bool{"g":{{3,2}:true}}
 for ;s.Seconds<22*3600+700;tick++{s.Advance(m,tick)};if gs:=s.Gates["gate"];gs.Position(tick)<GateFull{t.Fatalf("the gate came down on a vehicle in its opening: %+v",gs)}
 s.Vehicles=nil;for end:=tick+400;tick<end;tick++{s.Advance(m,tick)};if st:=s.Gates["gate"].State;st!="locked"{t.Fatalf("the gate stayed up after the window: %s",st)}
}
