func observedReport(t *testing.T,r *Runtime,id string)*pb.PocRegionRumour{t.Helper();for _,q:=range rumourView(r).HeardRumours{if q.Id==id{return q}};t.Fatal("heard report missing");return nil}
func observationArrivalFixture(t *testing.T)(*Runtime,regionRumour){
 t.Helper();r:=lifeRuntimeFixture(t);q:=r.world.Region.Rumours[0];rumourApproach(t,r,q.SourceActorID);if err:=r.hearRegionRumour(q.SourceActorID);err!=nil{t.Fatal(err)}
 // Establish a workshop fixture, then cross the real authored edge through the kernel.
 h:=r.state.Life.Actor(playerActorID);h.Level="level.poc_work";h.Visits[h.Level]++;h.Position=behavior.Cell{X:20,Y:10};h.Goal=h.Position;h.Body=nil;h.Trip=nil;h.Path=nil;h.PendingPath=nil;r.syncLifeHero();r.syncRegionKnowledge()
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"enter",Destination:"work_service_stair"});err!=nil{t.Fatal(err)}
 for i:=0;i<300&&!r.regionRumourVisited(q);i++{r.step()};if !r.regionRumourVisited(q){t.Fatal("real stair arrival did not complete")};r.updateLifeExploration();return r,q
}
func TestRegionObservationBindingRequiresPersonalVisitAndPublicNode(t *testing.T){
 r:=lifeRuntimeFixture(t);q:=r.world.Region.Rumours[0];rumourApproach(t,r,q.SourceActorID);if err:=r.hearRegionRumour(q.SourceActorID);err!=nil{t.Fatal(err)}
 before:=observedReport(t,r,q.ID);if before.Visited||before.ObservedNodeId!=""||before.ObservationKey!=""{t.Fatal("unvisited testimony exposed actual observation binding")}
 r,q=observationArrivalFixture(t);report:=observedReport(t,r,q.ID);raw,err:=hex.DecodeString(report.ObservationKey);if !report.Visited||report.ObservedNodeId!=q.NodeID||err!=nil||len(raw)!=32{t.Fatal("visited observation lacks a stable SHA256 binding")}
 found:=false;for _,n:=range rumourView(r).Nodes{if n.Id==report.ObservedNodeId&&(n.Knowledge=="visited"||n.Knowledge=="known"){found=true}};if !found{t.Fatal("observation points outside the public known map")}
 empty:=&pb.PocRegionMap{};if id,key:=r.regionObservedBinding(empty,q,true);id!=""||key!=""{t.Fatal("private-only node exposed a binding")}
 if id,key:=r.regionObservedBinding(rumourView(r),q,false);id!=""||key!=""{t.Fatal("caller without visitation received a binding")}
}
func TestRegionObservationIgnoresTimestampsLiveActorsAndHiddenWorld(t *testing.T){
 r,q:=observationArrivalFixture(t);report:=observedReport(t,r,q.ID);level:=r.currentLevel();key:=report.ObservationKey
 changedTicks:=0;for index,cell:=range r.state.LifeExploration[level]{if cell.Tick!=0{changedTicks++};cell.Tick=0;r.state.LifeExploration[level][index]=cell};if changedTicks==0{t.Fatal("timestamp fixture did not actually change last-seen metadata")};if observedReport(t,r,q.ID).ObservationKey!=key{t.Fatal("last-seen timestamps changed geometry identity")}
 r.state.Tick++;if observedReport(t,r,q.ID).ObservationKey!=key{t.Fatal("ordinary tick changed geometry identity")}
 // Change a truly unremembered wall, and an offscreen actor. Neither may enter the digest.
 loc:=r.world.Life.Locations[level];rows:=append([]string(nil),loc.Terrain...);changed:=false
 for y,row:=range rows{for x:=range row{index:=y*len(row)+x;if _,known:=r.state.LifeExploration[level][index];known{continue};bytes:=[]byte(row);if bytes[x]=='#'{bytes[x]='.'}else{bytes[x]='#'};rows[y]=string(bytes);changed=true;break};if changed{break}};if !changed{t.Fatal("fixture has no hidden geometry")};loc.Terrain=rows;r.world.Life.Locations[level]=loc
 source:=r.state.Life.Actor(q.SourceActorID);source.Position.X++;if observedReport(t,r,q.ID).ObservationKey!=key{t.Fatal("live hidden world or NPC altered remembered geometry identity")}
 for index,cell:=range r.state.LifeExploration[level]{if cell.Glyph=="#"{cell.Glyph="."}else{cell.Glyph="#"};r.state.LifeExploration[level][index]=cell;break};if observedReport(t,r,q.ID).ObservationKey==key{t.Fatal("changed remembered geometry retained old signature")}
}
func TestRegionObservationGrowthSaveLoadCannotReuseFutureMemory(t *testing.T){
 r,q:=observationArrivalFixture(t);old:=observedReport(t,r,q.ID);oldKey:=old.ObservationKey;oldCount:=len(r.state.LifeExploration[r.currentLevel()]);slot:=r.world.Config.SaveSlots[0];before:=r.snapshotState();if err:=r.writeSave(slot,before);err!=nil{t.Fatal(err)}
 // Both points are authored proof waypoints on the landing, away from its exits.
 for _,at:=range []behavior.Cell{{X:12,Y:26},{X:16,Y:22}}{if !r.lifeWalkTo(at){t.Fatal("ordinary movement rejected stair proof waypoint")};for i:=0;i<300&&r.state.Life.Actor(playerActorID).Position!=at;i++{r.step()};if r.state.Life.Actor(playerActorID).Position!=at{t.Fatal("physical walk never reached stair proof waypoint")};r.updateLifeExploration()}
 future:=observedReport(t,r,q.ID);futureCount:=len(r.state.LifeExploration[r.currentLevel()]);if futureCount<=oldCount||future.ObservationKey==oldKey{t.Fatalf("physical exploration did not change remembered mask: %d -> %d",oldCount,futureCount)}
 loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};r.state=loaded;restored:=observedReport(t,r,q.ID);if restored.ObservationKey!=oldKey||restored.ObservationKey==future.ObservationKey||!reflect.DeepEqual(before.LifeExploration,r.state.LifeExploration){t.Fatal("older save reused future-mask observation identity")}
 t.Logf("physical stair exploration grew remembered cells %d -> %d; older save restored its own SHA256 key",oldCount,futureCount)
}
func TestRegionV1SaveMigrationPreservesHeardReports(t *testing.T){
 r:=lifeRuntimeFixture(t);for _,q:=range r.world.Region.Rumours{rumourApproach(t,r,q.SourceActorID);if err:=r.hearRegionRumour(q.SourceActorID);err!=nil{t.Fatal(err)}};before:=r.snapshotState();slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,before);err!=nil{t.Fatal(err)}
 file:=filepath.Join(r.data,slot+".json");data,err:=os.ReadFile(file);if err!=nil{t.Fatal(err)};var envelope saveFile;if err:=json.Unmarshal(data,&envelope);err!=nil{t.Fatal(err)};envelope.ContentHash="e770494a5766f25a0ad6acdbfcf00ac5b52c06dba364de4e6d1997280119a9d5";data,err=json.Marshal(envelope);if err!=nil{t.Fatal(err)};if err:=os.WriteFile(file,data,0600);err!=nil{t.Fatal(err)}
 loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};if !reflect.DeepEqual(before.Region,loaded.Region)||len(loaded.Region.Reports)!=2{t.Fatal("V1 migration wiped or changed heard testimony")}
}
