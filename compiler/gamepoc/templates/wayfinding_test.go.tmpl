 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_clear"});err!=nil{t.Fatal(err)};if !reflect.DeepEqual(before,r.snapshotState())||wayfindingView(r).SelectedDestinationId!=""{t.Fatal("clearing preview cancelled gameplay intent")}
