  func(m *LifeModel){m.Walkable["+"]=true},
 }{m:=gateFixture();l:=m.Locations["g"];l.Gates=append([]LifeGate(nil),l.Gates...);l.Gates[0].Opening=append([]Cell(nil),l.Gates[0].Opening...);m.Locations["g"]=l;change(&m);if m.Validate()==nil{t.Fatal("unsafe gate accepted")}}
