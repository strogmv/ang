  c.Anchor=anchor;c.Goals=goals;c.MemberKey=key;c.Focus=focus;c.Revision++
 }
 c.Status="gathering";if goalsReady(members,c.Goals)==len(members){c.Status="watching"}
 return ordersFor(members,c.Goals,"gather_watch",p.SafeDistance)
}


// Coordination is scoped to accepted, available members. Personality selects
// responsibilities; it never grants control over unrelated observers.
type CoordinationPolicy struct {
 PublicCall struct{CooldownTicks int64 `json:"cooldown_ticks"`; DisplayTicks int64 `json:"display_ticks"`; Line string `json:"line"`} `json:"public_call"`
 LeaderVector string `json:"leader_vector"`
 SpeakerVector string `json:"speaker_vector"`
 LeaderWeight int `json:"leader_route_weight"`
 OpeningLine string `json:"opening_line"`
 ReplyTicks int64 `json:"reply_window_ticks"`
}
type CoordinationState struct {
 Mode,LeaderID,SpeakerID string
 Offered bool
 OfferedBy,Utterance,OfferStatus string
 OfferedTick,ReplyUntil int64
}
func vectorRank(m Member,vector string)int{for i,v:=range m.Vectors{if v==vector{return i}};return 1<<20}
func vectorCandidate(members []Member,vector string)string{
 bestRank:=1<<20;best:=""
 for _,m:=range members{if !m.Available{continue};rank:=vectorRank(m,vector);if rank<bestRank||(rank==bestRank&&rank<1<<20&&(best==""||m.ID<best)){bestRank=rank;best=m.ID}}
 return best
}
func(c *CoordinationState) Assign(p CoordinationPolicy,members []Member){
 c.LeaderID=vectorCandidate(members,p.LeaderVector);c.SpeakerID=vectorCandidate(members,p.SpeakerVector)
 c.Mode="collective";if c.LeaderID!=""{c.Mode="led"}
}
func(c CoordinationState) Participants(p CoordinationPolicy,members []Member)[]Member{
 result:=append([]Member(nil),members...)
 for i:=range result{result[i].DecisionWeight=1;if result[i].ID==c.LeaderID{result[i].DecisionWeight=p.LeaderWeight}}
 sort.SliceStable(result,func(i,j int)bool{if (result[i].ID==c.LeaderID)!=(result[j].ID==c.LeaderID){return result[i].ID==c.LeaderID};return result[i].ID<result[j].ID})
 return result
}
// The adapter supplies audibility and sight. An opening is emitted once and its
// response window expires on server ticks, including after save/load.
func(c *CoordinationState) TryOpening(p CoordinationPolicy,tick int64,canAddress,alive bool)bool{
 if !alive{c.OfferStatus="not_applicable";return false}
 if c.Offered{if tick>=c.ReplyUntil{c.OfferStatus="no_reply"};return false}
 if c.SpeakerID==""{c.OfferStatus="no_speaker";return false}
 c.OfferStatus="waiting_for_contact";if !canAddress{return false}
 c.Offered=true;c.OfferedBy=c.SpeakerID;c.OfferedTick=tick;c.ReplyUntil=tick+p.ReplyTicks;c.Utterance=p.OpeningLine;c.OfferStatus="pending";return true
}
func(c CoordinationState) HoldContact(tick int64)bool{return c.Offered&&c.OfferStatus=="pending"&&tick<c.ReplyUntil}
func decisionWeight(m Member)int{if m.DecisionWeight<1{return 1};return m.DecisionWeight}

// supportedStaging handles corners and narrow doors: contact members approach
// distinct adjacent cells, with the rest holding nearby support positions.
func(s Space) supportedStaging(target Cell,members []Member,cohesion int)(map[string]Cell,map[string]Cell,bool){
 minimum:=s.MinContactMembers;if minimum<1||minimum>len(members){minimum=len(members)}
 support:=s.SupportDistance;if support<2{support=2}
 type option struct{stage,contact Cell;direct bool}
 var options []option
 for _,side:=range cardinal{contact:=Cell{target.X+side.X,target.Y+side.Y};if !s.CanStand(contact){continue};for _,delta:=range cardinal{stage:=Cell{contact.X+delta.X,contact.Y+delta.Y};if Distance(stage,target)!=2||!s.CanStand(stage){continue};options=append(options,option{stage,contact,true})}}
 for y:=target.Y-support;y<=target.Y+support;y++{for x:=target.X-support;x<=target.X+support;x++{p:=Cell{x,y};if Distance(p,target)<2||Distance(p,target)>support||!s.CanStand(p)||(s.Visible!=nil&&!s.Visible(p,target)){continue};options=append(options,option{p,p,false})}}
 goals:=make([]Cell,len(options));for j,o:=range options{goals[j]=o.stage}
 costs:=make([][]int,len(members));lengths:=make([][]int,len(members));for i,m:=range members{distances:=s.routeCosts(m.Position,goals,target,2);costs[i]=make([]int,len(options));lengths[i]=make([]int,len(options));for j,o:=range options{cost,ok:=distances[o.stage];if !ok{cost=1<<25};lengths[i][j]=cost;costs[i][j]=cost*decisionWeight(m)}}
 best:=1<<30;assignment:=make([]int,len(members));var stages,contacts map[string]Cell;pairCosts:=map[Cell]map[Cell]int{}
 nodes:=0;budget:=s.MaxFormationNodes;if budget<1{budget=4096}
 var choose func(int,int,int)
 choose=func(index,total,direct int){
  if nodes>=budget{return};nodes++
  if total>=best||direct+len(members)-index<minimum{return}
  if index==len(members){if direct<minimum{return};local:=true;for i:=range members{if lengths[i][assignment[i]]>2{local=false}}
   if !local{for i:=range members{for j:=0;j<i;j++{from:=options[assignment[i]].stage;distances,known:=pairCosts[from];if !known{distances=s.routeCosts(from,goals,target,2);pairCosts[from]=distances};n,ok:=distances[options[assignment[j]].stage];if !ok||n>cohesion{return}}}}
   best=total;stages=map[string]Cell{};contacts=map[string]Cell{};for i,m:=range members{o:=options[assignment[i]];stages[m.ID]=o.stage;contacts[m.ID]=o.contact};return}
  for j,o:=range options{if costs[index][j]>=1<<25{continue};if index==0&&s.ContactSide!=(Cell{})&&(!o.direct||o.contact!=(Cell{target.X+s.ContactSide.X,target.Y+s.ContactSide.Y})){continue};valid:=true
   for i:=0;i<index;i++{other:=options[assignment[i]];if o.stage==other.stage||o.contact==other.contact||Distance(o.stage,other.stage)>cohesion{valid=false;break}}
   if !valid{continue};assignment[index]=j;n:=direct;if o.direct{n++};penalty:=0;if !o.direct{penalty=100000}
   if s.ApproachBias&&members[index].Approach.ID!=""{c:=members[index].Approach;penalty=c.positionCost(members[index].Position,o.stage,o.contact,target,o.direct);if index>0{penalty+=c.BuddyWeight*Distance(o.stage,options[assignment[0]].stage)}}
   choose(index+1,total+costs[index][j]+penalty,n)
  }
 };choose(0,0,0);return stages,contacts,stages!=nil
}

// JointSteps chooses the largest compatible subset (groups are bounded to eight).
// Followers may enter cells vacated by the same batch. Shared destinations,
// stationary occupants and opposite traversal of an edge remain forbidden.
func(g GroupState) JointSteps(p GroupPolicy,members []Member,proposals map[string]Cell,blocked map[Cell]bool)map[string]Cell{
 if len(members)>8{return nil}
 var destinations [8]Cell
 eligible:=0;relaxed:=p;relaxed.Cohesion=1<<20
 for i,m:=range members {
  at,ok:=proposals[m.ID]
  if !ok||!m.Available||Distance(m.Position,at)!=1||blocked[at] {continue}
  if g.Phase!="escorting"&&!g.CanStep(m.ID,at,members,relaxed){continue}
  destinations[i]=at;eligible|=1<<i
 }
 needsCohesion:=false
 switch g.Phase {case "approaching","supplying","searching","in_position":needsCohesion=!(g.Phase=="approaching"&&g.LocalApproach)}
 bestMask,bestCount:=0,0
 // Ascending masks retain the existing deterministic tie break. Scratch state
 // stays on the stack; only the chosen result becomes a map.
 for mask:=1;mask<(1<<len(members));mask++{
  if mask & ^eligible !=0 {continue}
  count:=0;for bits:=mask;bits!=0;bits&=bits-1{count++}
  if count<=bestCount{continue}
  valid:=true
  for i,m:=range members {
   if mask&(1<<i)==0{continue};at:=destinations[i]
   for j,other:=range members{
    if i==j{continue};moving:=mask&(1<<j)!=0
    end:=other.Position;if moving{end=destinations[j]}
    if at==end || (at==other.Position && (!moving||end==m.Position)) || (needsCohesion&&Distance(at,end)>p.Cohesion) {valid=false;break}
   }
   if !valid{break}
  }
  if valid{bestMask,bestCount=mask,count}
 }
 if bestMask==0{return nil};result:=make(map[string]Cell,bestCount)
 for i,m:=range members{if bestMask&(1<<i)!=0{result[m.ID]=destinations[i]}}
 return result
}

// LocalSpace keeps informal encirclement in a small visible area. It cannot
// route a worker through an unseen room or allow a distant solo pursuit.
func(s Space) LocalSpace(target Cell,radius int)Space{
 walkable:=s.Walkable;visible:=s.Visible;allowed:=map[Cell]bool{}
 for y:=target.Y-radius;y<=target.Y+radius;y++{for x:=target.X-radius;x<=target.X+radius;x++{at:=Cell{x,y};if x>=0&&y>=0&&x<s.Width&&y<s.Height&&Distance(at,target)<=radius&&walkable(at)&&(visible==nil||visible(at,target)){allowed[at]=true}}}
 s.Walkable=func(at Cell)bool{return allowed[at]};return s
}
func(s Space) LocalStaging(target Cell,members []Member,radius,maxRoute int)(map[string]Cell,map[string]Cell,bool){
 if len(members)<2||len(members)>8||radius<2{return nil,nil,false}
 for _,m:=range members{if !m.Available||Distance(m.Position,target)>radius||(s.Visible!=nil&&!s.Visible(m.Position,target)){return nil,nil,false}}
 local:=s.LocalSpace(target,radius);local.ApproachBias=true;stages,contacts,ok:=local.supportedStaging(target,members,2*radius);if !ok{return nil,nil,false}
 for _,m:=range members{path:=local.Path(m.Position,stages[m.ID],target,2);if maxRoute>0&&len(path)>maxRoute{return nil,nil,false}}
 return stages,contacts,true
}
