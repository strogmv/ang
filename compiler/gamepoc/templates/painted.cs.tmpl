  static Rect PaintedVisibleCanvas(Rect viewport,Rect fit,float scale){return new Rect((viewport.x-fit.x)/scale,(viewport.y-fit.y)/scale,viewport.width/scale,viewport.height/scale);}
  void QueuePaintedActor(PocPaintedScene scene,PaintedCache cache,string id,Vector2 position,Rect visibleCanvas){
   // Visibility and the camera are separate: panning never changes observations.
   if(!ViewSees(Mathf.FloorToInt(position.x+.5f),Mathf.FloorToInt(position.y+.5f)))return;
   PaintedDraw draw;if(TryPaintedActorDraw(scene,cache,id,position,out draw)&&visibleCanvas.Overlaps(draw.rect))paintedDraws.Add(draw);
  }
  bool TryPaintedActorDraw(PocPaintedScene scene,PaintedCache cache,string id,Vector2 position,out PaintedDraw draw){
   draw=default(PaintedDraw);
   Texture2D texture;Rect uv;float w,h,feetX,feetY,height=scene.actor_height;
   PocPaintedActor binding;
   if(cache.actors.TryGetValue(id,out binding)){
    texture=ArtSceneTexture(binding.image);uv=ArtSceneUV(binding.source_rect,texture);w=binding.source_rect==null?texture.width:binding.source_rect.w;h=binding.source_rect==null?texture.height:binding.source_rect.h;feetX=binding.feet_x;feetY=binding.feet_y;if(binding.height>0)height=binding.height;
   }else{
    string key;PocCharacterSheet sheet;
    if(!ResolveCharacterSheet(id,out key)||!characterSheets.TryGetValue(key,out sheet)||!characterTextures.TryGetValue(key,out texture)||texture==null)return false;
    Texture2D idle;if(characterIdleTextures.TryGetValue(key,out idle)&&idle!=null)texture=idle;
    int row=sheet.rows!=null&&sheet.rows.Length>0?sheet.rows[0]:0;PocCharacterFrame frame=null;Dictionary<long,PocCharacterFrame> frames;
    if(characterFrames.TryGetValue(key,out frames))frames.TryGetValue(((long)row<<32)|(uint)sheet.idle,out frame);
    w=frame==null?sheet.frame_w:frame.w;h=frame==null?sheet.frame_h:frame.h;feetX=frame==null?w/2:frame.feet_x;feetY=frame==null?sheet.feet_y:frame.feet_y;
    float sx=frame==null?sheet.idle*sheet.frame_w:frame.x,sy=frame==null?row*sheet.frame_h:frame.y;uv=new Rect(sx/texture.width,1f-(sy+h)/texture.height,w/texture.width,h/texture.height);
    if(frame!=null&&frame.flip_x){feetX=w-feetX;uv.x+=uv.width;uv.width=-uv.width;}
   }
   float factor=height/h;var at=PaintedPoint(scene,position);
   draw=new PaintedDraw{id=id,texture=texture,rect=new Rect(at.x-feetX*factor,at.y-feetY*factor,w*factor,height),uv=uv,depth=at.y,tint=Color.white,kind=1};return true;
  }
  void HandlePaintedInput(PocPaintedScene scene,Rect viewport,Rect fit,float scale){
   // Automatic verification drives the shared pointer helper explicitly. A real
   // mouse must not replace the accepted proof route with an unrelated command.
   if(verify)return;
   var e=Event.current;if(e.type!=EventType.MouseDown||e.button!=0||!GUI.enabled)return;
   if(SendPaintedScreenPointer(scene,e.mousePosition,viewport,fit,scale))e.Use();
  }
  bool SendPaintedScreenPointer(PocPaintedScene scene,Vector2 screen,Rect viewport,Rect fit,float scale){
   if(!viewport.Contains(screen)||!fit.Contains(screen)||HudBlocksWorldInput(screen))return false;
   return SendPaintedPointer(scene,PaintedScreenToCanvas(screen,fit,scale));
  }
  bool SendPaintedPointer(PocPaintedScene scene,Vector2 canvas){
   var view=ObserverView();
   if(!CanSend()||state.Paused||state.Life.Transit||(view!=null&&view.ActorId!="char.hero"))return false;
   Vector2 grid;if(!PaintedInverse(scene,canvas,out grid))return false;
   int x=Mathf.FloorToInt(grid.x+.5f),y=Mathf.FloorToInt(grid.y+.5f);
   if(x<0||y<0||x>=state.Width||y>=state.Height||ViewCell(view,x,y)=='0')return false;
   foreach(var marker in state.Life.Markers)if(marker.X==x&&marker.Y==y&&LifeDoorVisible(marker)){LifeCommand("enter",marker.EdgeId);message="Идём к выходу: "+marker.Name;return true;}
   return ClickMove(x,y);
  }
  void DrawPaintedKnownDetails(PocPaintedScene scene,Rect fit,float scale,PocObserverView view){
   var mouse=Event.current.mousePosition;if(!PaintedViewport().Contains(mouse)||!fit.Contains(mouse)||HudBlocksWorldInput(mouse)||state.Life.Transit)return;
   Vector2 grid;if(!PaintedInverse(scene,PaintedScreenToCanvas(mouse,fit,scale),out grid))return;int x=Mathf.FloorToInt(grid.x+.5f),y=Mathf.FloorToInt(grid.y+.5f);
   if(ViewCell(view,x,y)=='0')return;
   foreach(var marker in state.Life.Markers)if(marker.X==x&&marker.Y==y&&LifeDoorVisible(marker)){HudFrame(new Rect(mouse.x+12,mouse.y-34,290,30),false);GUI.Label(new Rect(mouse.x+20,mouse.y-31,270,25),"Войти → "+marker.Name,smallStyle);return;}
   if(!ViewSees(x,y)||(view!=null&&view.ActorId!="char.hero"))return;
   foreach(var obj in state.Life.Inspections)if(obj.LevelId==state.Life.LevelId&&obj.X==x&&obj.Y==y){
    PrepareHud();string body=obj.BaseText;foreach(var line in obj.Fragments)body+="\n\n"+line.Text;
    float height=hudWrap.CalcHeight(new GUIContent(body),350)+65;var box=new Rect(Mathf.Clamp(mouse.x+15,25,880),Mathf.Clamp(mouse.y+15,130,Mathf.Max(130,680-height)),380,height);HudFrame(box,false);GUI.Label(new Rect(box.x+14,box.y+12,350,28),obj.Name,hudHeading);GUI.Label(new Rect(box.x+14,box.y+45,350,height-55),body,hudWrap);return;
   }
  }
  bool DrawPaintedGame(){
   var scene=CurrentPaintedScene();if(scene==null)return false;
   UpdateMotion();PrepareHud();var cache=PreparePaintedScene(scene);var view=ObserverView();
   long fogVersion=cache.fogVersion,fogStarted=verifyPainted?System.Diagnostics.Stopwatch.GetTimestamp():0;
   UpdatePaintedFog(scene,cache,view);
   if(verifyPainted&&cache.fogVersion!=fogVersion)RecordPaintedFogTiming((float)((System.Diagnostics.Stopwatch.GetTimestamp()-fogStarted)*1000d/System.Diagnostics.Stopwatch.Frequency),fogVersion==0);
   Rect viewport=PaintedViewport(),fit=PaintedCameraFit(scene,viewport,PaintedPoint(scene,shownPosition));float scale=fit.width/scene.width;
   Rect visibleCanvas=PaintedVisibleCanvas(viewport,fit,scale);
   HandlePaintedInput(scene,viewport,fit,scale);
   Color before=GUI.color;paintedDraws.Clear();
   if(scene.props!=null)foreach(var prop in scene.props){
    int x=Mathf.RoundToInt(prop.at.x),y=Mathf.RoundToInt(prop.at.y);char seen=ViewCell(view,x,y);if(seen=='0')continue;
    var at=PaintedPoint(scene,new Vector2(prop.at.x,prop.at.y));var rect=new Rect(at.x-prop.foot_x,at.y-prop.foot_y,prop.width,prop.height);
    if(!visibleCanvas.Overlaps(rect))continue;var texture=ArtSceneTexture(prop.image);
    paintedDraws.Add(new PaintedDraw{id=prop.id,texture=texture,rect=rect,uv=ArtSceneUV(prop.source_rect,texture),depth=at.y,tint=seen=='1'?new Color(.35f,.35f,.35f):Color.white,kind=0});
   }
   foreach(var actor in SceneActors()){if(!ViewSees(actor.X,actor.Y))continue;QueuePaintedActor(scene,cache,actor.Id,SampleNPC(actor),visibleCanvas);}
   if(!state.Life.Transit&&ViewSees(state.PlayerX,state.PlayerY)){
    var feet=PaintedPoint(scene,shownPosition);
    paintedDraws.Add(new PaintedDraw{id="hero.selection",texture=PaintedHeroRing(),rect=new Rect(feet.x-50,feet.y-17,100,36),uv=new Rect(0,0,1,1),depth=feet.y-.1f,tint=Color.white,kind=0});
    QueuePaintedActor(scene,cache,"char.hero",shownPosition,visibleCanvas);
   }
   foreach(var cut in cache.cutouts)if(visibleCanvas.Overlaps(cut.rect))paintedDraws.Add(new PaintedDraw{id=cut.id,texture=cut.texture,rect=cut.rect,uv=new Rect(0,0,1,1),depth=cut.depth,tint=Color.white,kind=2});
   paintedDraws.Sort(paintedComparison);
   if(verifyPainted)AuditPaintedDraws();
   GUI.BeginGroup(viewport);
   var localFit=fit;localFit.position-=viewport.position;
   GUI.color=Color.white;GUI.DrawTexture(localFit,cache.background,ScaleMode.StretchToFill,true);GUI.DrawTexture(localFit,cache.fog,ScaleMode.StretchToFill,true);
   foreach(var draw in paintedDraws){var target=PaintedTarget(draw.rect,fit,scale);target.position-=viewport.position;if(!new Rect(0,0,viewport.width,viewport.height).Overlaps(target))continue;GUI.color=draw.tint;GUI.DrawTextureWithTexCoords(target,draw.texture,draw.uv,true);}
   // Ground fog precedes actors. Foreground textures already sample the same
   // shaded field, so visible actor heads stay whole and polygon edges agree.
   GUI.EndGroup();GUI.color=before;
   if(state.Life.Transit){HudFrame(new Rect(330,330,620,90),false);GUI.Label(new Rect(348,346,584,56),state.Life.Activity,hudWrap);}
   DrawPaintedKnownDetails(scene,fit,scale,view);return true;
  }
