// Code generated by ANG. Controlled travel admission is paid at boarding only.
package poc

import (
 "sort"
 "strings"
 "fmt"
 "angelsdemons/server/internal/behavior"
 inv "angelsdemons/server/internal/inventory"
)

func(r *Runtime)lifeEdgeName(locale string,edge behavior.LifeEdge)string{
 name:=r.regionLevelName(locale,edge.To);if edge.NameKey!=""{name=r.localText(locale,edge.NameKey,name)}
 if edge.Fare!=nil{scale:=r.world.Inventory.Currencies[edge.Fare.Currency].Scale;name=strings.ReplaceAll(name,"{amount}",inv.FormatMoney(edge.Fare.AmountMinor,scale));name=strings.ReplaceAll(name,"{currency}",edge.Fare.Currency)}
 return name
}
// Kernel invokes this only for the controlled actor once exit, timetable and
// capacity are satisfied. Other residents' ticket accounting is not simulated.
func(r *Runtime)lifeFareAvailable(actorID string,edge behavior.LifeEdge)bool{
 if edge.Fare==nil{return true};fare:=edge.Fare;receiver,ok:=r.state.Inventory.Accounts[fare.ReceiverAccount];if !ok||receiver.Currency!=fare.Currency||receiver.Owner==actorID{return false};for _,payer:=range r.state.Inventory.Accounts{if payer.Owner==actorID&&payer.Currency==fare.Currency&&payer.Balance>=fare.AmountMinor{return true}};return false
}
func(r *Runtime)admitLifeTravel(actorID string,edge behavior.LifeEdge)bool{
 if edge.Fare==nil{return true};hero:=r.state.Life.Actor(actorID)
 if actorID!=playerActorID||hero==nil||hero.Trip!=nil||hero.Level!=edge.From||hero.Position!=edge.Exit||len(hero.Path)!=0{return false}
 return payLifeFare(&r.state.Inventory,r.inventoryModelFor(true),actorID,edge.Fare,fmt.Sprintf("transit:%s:%d:%d",edge.ID,hero.WaitingDeparture,r.state.Tick))
}
func payLifeFare(state *inv.State,model inv.Model,actorID string,fare *behavior.LifeFare,tag string)bool{
 if fare==nil{return true};receiver,ok:=state.Accounts[fare.ReceiverAccount];if !ok||receiver.Currency!=fare.Currency||receiver.Owner==actorID||fare.AmountMinor<=0{return false}
 currency,ok:=model.Currencies[fare.Currency];if !ok||currency.Carrier!="account"{return false}
 ids:=make([]string,0,len(state.Accounts));for id:=range state.Accounts{ids=append(ids,id)};sort.Strings(ids)
 for _,id:=range ids{payer:=state.Accounts[id];if payer.Owner!=actorID||payer.Currency!=fare.Currency||payer.Balance<fare.AmountMinor{continue}
  _,err:=state.Apply(model,inv.Transaction{Actor:actorID,Sequence:state.Cursors[actorID].Sequence+1,RequestTag:tag,Payments:[]inv.Payment{{From:id,To:receiver.ID,Currency:fare.Currency,Amount:fare.AmountMinor,FromRevision:payer.Revision,ToRevision:receiver.Revision}}});return err==nil
 };return false
}
