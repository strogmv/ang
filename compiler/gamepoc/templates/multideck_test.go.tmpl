func multideckStand(t *testing.T)(*Runtime,string,*behavior.DeckVolume){
 t.Helper();r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 for id,world:=range r.sdkWorlds{if v:=world.Decks[id];v!=nil{return r,id,v}}
 t.Skip("this world has no multi-deck SDK stand");return nil,"",nil
}
func multideckMove(t *testing.T,r *Runtime,target point,deck int32,seq uint64)*pb.PocMoveResult{
 t.Helper();c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})}
 r.move(c,&pb.MoveTo{X:int32(target.X),Y:int32(target.Y),Deck:deck,Epoch:r.state.Epoch,InputSeq:seq})
 result:=(<-c.out).GetMoveResult();if result==nil{t.Fatal("missing move result")};return result
}

// The hero climbs to an upper surface and back by ordinary steps, a save on a
// stair node validates and resumes, voids and wrong decks are rejected, and
// authored residents move between surfaces without overlapping anyone.
func TestMultideckStandMovementSaveAndResidents(t *testing.T){
 r,id,v:=multideckStand(t)
 if result:=sdkHostNew(t,r,"sdk:"+id,"md-start");!result.Ok{t.Fatal(result)}
 world:=r.sdkWorlds[id];if len(r.state.Life.Actors)!=len(world.Life.Actors){t.Fatal("stand residents missing")}
 var upper point;var upperDeck int32=-1
 for y,row:=range r.currentTerrain(){for x:=range row{p:=point{x,y};if row[x]!='.'{continue};d,ok:=v.SurfaceIndex(cell(p));if ok&&d>0&&d<len(v.Surfaces)&&upperDeck<0&&r.state.Life.StaticTravelSeconds(r.world.Life,id,cell(r.state.Player),cell(p))>0{upper,upperDeck=p,int32(d)}}}
 if upperDeck<0{t.Fatal("no reachable upper surface")}
 void:=point{-1,-1};for y,row:=range r.currentTerrain(){for x:=range row{if row[x]==' '&&void.X<0{void=point{x,y}}}}
 if multideckMove(t,r,void,0,1).Ok{t.Fatal("void accepted")}
 if multideckMove(t,r,upper,upperDeck+1,2).Ok{t.Fatal("wrong deck accepted")}
 if !multideckMove(t,r,upper,upperDeck,3).Ok{t.Fatal("upper surface rejected")}
 previous:=r.state.Player;stairs:=false;var saved *state
 for i:=0;i<4000&&r.state.Player!=upper;i++{
  r.step();hero:=r.state.Life.Actor(playerActorID)
  if r.state.Player!=previous&&!r.world.Life.Adjacent(id,cell(previous),cell(r.state.Player)){t.Fatalf("hero jumped %v -> %v",previous,r.state.Player)}
  previous=r.state.Player
  seen:=map[behavior.Cell]string{};for _,a:=range r.state.Life.Actors{if other,ok:=seen[a.Position];ok{t.Fatalf("%s and %s overlap",a.ID,other)};seen[a.Position]=a.ID}
  if d,_:=v.SurfaceIndex(hero.Position);d>=len(v.Surfaces){stairs=true;if saved==nil&&len(hero.Path)>0{snapshot:=r.snapshotState();saved=&snapshot}}
 }
 if r.state.Player!=upper||!stairs||saved==nil{t.Fatalf("hero did not climb by the stair: at %v stairs=%v",r.state.Player,stairs)}
 if err:=r.validateLifeSave(*saved);err!=nil{t.Fatalf("mid-stair save invalid: %v",err)}
 slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,*saved);err!=nil{t.Fatal(err)}
 loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};sdkHostLoad(t,r,loaded,"md-load")
 if d,_:=v.SurfaceIndex(cell(r.state.Player));d<len(v.Surfaces){t.Fatal("load did not restore the stair pose")}
 for i:=0;i<4000&&r.state.Player!=upper;i++{r.step()}
 if r.state.Player!=upper{t.Fatal("loaded mid-stair route did not continue")}
 c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{})};r.sendState(c);wire:=(<-c.out).GetGameState()
 if wire==nil||wire.PlayerDeck!=upperDeck{t.Fatalf("player deck not published: %v",wire.GetPlayerDeck())}
 visited:=false
 for i:=0;i<3000;i++{
  before:=map[string]behavior.Cell{};for _,a:=range r.state.Life.Actors{before[a.ID]=a.Position}
  r.step()
  seen:=map[behavior.Cell]string{}
  for _,a:=range r.state.Life.Actors{
   if other,ok:=seen[a.Position];ok{t.Fatalf("%s and %s overlap",a.ID,other)};seen[a.Position]=a.ID
   if a.Position!=before[a.ID]&&!r.world.Life.Adjacent(id,before[a.ID],a.Position){t.Fatalf("%s jumped",a.ID)}
   if d,ok:=v.SurfaceIndex(a.Position);a.ID!=playerActorID&&ok&&d>0&&d<len(v.Surfaces)&&before[a.ID]!=a.Position{visited=true}
  }
 }
 if len(world.Life.Actors)>1&&!visited{t.Fatal("no resident walked on an upper surface")}
}
