// An initial clinical condition, projected by the real CUE anatomy model.
// Consciousness and AP remain available; a broken femur prevents walking.
func combatGridBrokenFemur(t *testing.T, a *behavior.Combatant){
 t.Helper();b:=combatBody(*a)
 if _,err:=combatWounds.ApplyHit(&b,wounds.Hit{Weapon:"item.service_baton",Zone:"thigh",Depth:"deep",Structures:[]string{"femur"},Seed:31});err!=nil{t.Fatal(err)}
 projectWoundBody(a,b)
 if !a.Able()||a.BodyCanWalk{t.Fatal("fixture requires a conscious immobile body")}
}
func combatGridSharedCorner(t *testing.T,r *Runtime,id string)behavior.Cell{
 t.Helper();s:=r.state.Combat;space:=r.combatSpace(s);a:=s.Actor(id)
 for _,p:=range space.Grid.Members[space.Grid.Tile[a.Position]]{
  if r.combatWorldDistance(s.LevelID,a.Position,p)<700{continue}
  occupied:=false;for _,other:=range s.Actors{if other.ID!=id&&space.Grid.Same(other.Position,p){occupied=true}}
  if !occupied{return p}
 }
 t.Fatal("existing market body has no free physical corner in its metre cell");return behavior.Cell{}
}
