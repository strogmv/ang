func TestNPCWorldAuditDeterminism(t *testing.T) {
	if os.Getenv("NPC_WORLD_REPORT") == "" {
		t.Skip("audit only")
	}
	type res struct {
		Checkpoints     []int64  `json:"checkpoint_game_seconds"`
		RunA            []string `json:"run_a_sha256"`
		RunB            []string `json:"run_b_sha256"`
		SaveLoadResumed []string `json:"save_load_resumed_sha256"`
		Equal           bool     `json:"all_equal"`
		SeedDifferent   string   `json:"seed_99_sha256_at_end"`
		SeedAffects     bool     `json:"seed_changes_life_outcome"`
	}
	out := res{}
	a := worldAuditRuntime(t, 100)
	b := worldAuditRuntime(t, 100)
	c := worldAuditRuntime(t, 100)
	c.state.Seed = 99
	var resumed *Runtime
	start := a.state.Life.Seconds
	for a.state.Life.Seconds < start+6*3600 {
		for _, r := range []*Runtime{a, b, c} {
			r.state.Tick++
			if err := r.advanceLifeFrameBy(1); err != nil {
				t.Fatal(err)
			}
		}
		if resumed != nil {
			resumed.state.Tick++
			if err := resumed.advanceLifeFrameBy(1); err != nil {
				t.Fatal(err)
			}
		}
		el := a.state.Life.Seconds - start
		if el == 3*3600 {
			raw, err := json.Marshal(a.state)
			if err != nil {
				t.Fatal(err)
			}
			resumed = worldAuditRuntime(t, 0)
			var s state
			if err = json.Unmarshal(raw, &s); err != nil {
				t.Fatal(err)
			}
			resumed.state = s
		}
		if el%3600 == 0 {
			out.Checkpoints = append(out.Checkpoints, el)
			out.RunA = append(out.RunA, worldLifeHash(a))
			out.RunB = append(out.RunB, worldLifeHash(b))
			if resumed != nil {
				out.SaveLoadResumed = append(out.SaveLoadResumed, worldLifeHash(resumed))
			}
		}
	}
	out.Equal = reflect.DeepEqual(out.RunA, out.RunB)
	off := len(out.RunA) - len(out.SaveLoadResumed)
	for i := range out.SaveLoadResumed {
		if out.SaveLoadResumed[i] != out.RunA[off+i] {
			out.Equal = false
		}
	}
	out.SeedDifferent = worldLifeHash(c)
	out.SeedAffects = out.SeedDifferent != out.RunA[len(out.RunA)-1]
	worldAuditWrite(t, "determinism-life100-6h.json", out)
	if !out.Equal {
		t.Error("non-deterministic")
	}
}

