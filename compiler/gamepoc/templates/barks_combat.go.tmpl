// Code generated by ANG. The barks side of a fight (doc 94 §18, doc 96): once per Life frame it reads the encounter's
// new events and calls BarkEvent when a fighter's intent changes — he spots the hero, is hit, falls back hurt, sees an
// ally fall, reloads or gives up. It only listens: no decision, AP, wound or position of the fight is touched here.
// The cursor lives in memory; after a load or a jump of the clock it restarts at the current event, so an old fight is
// never shouted again. A shout that meets a speaker still talking waits up to 8 game seconds.
package poc

import (
	"sort"

	"angelsdemons/server/internal/behavior"
)

type barkCombatCursor struct {
	ready     bool
	encounter string
	seq       uint64
	tick      int64
	// A shout that met a still-talking speaker waits a few seconds instead of being lost.
	pending map[string]barkCombatPending
}

type barkCombatPending struct {
	intent string
	until  int64
}

func (r *Runtime) barkCombatFrame() {
	s := &r.state.Combat
	c := &r.barkCombat
	if !c.ready || r.state.Tick < c.tick || r.state.Tick > c.tick+600 {
		*c = barkCombatCursor{ready: true, encounter: s.ID, seq: s.EventSeq, tick: r.state.Tick}
		return
	}
	c.tick = r.state.Tick
	if s.ID == "" {
		c.encounter, c.seq = "", 0
		return
	}
	hero := r.state.Combat.Actor(playerActorID)
	// One shout per fighter and frame (a speaker who is still talking is busy): the most telling change wins.
	intent := map[string]string{}
	say := func(id, what string) {
		if id == "" || id == playerActorID {
			return
		}
		if old, ok := intent[id]; !ok || barkCombatRank[what] > barkCombatRank[old] {
			intent[id] = what
		}
	}
	if c.encounter != s.ID {
		c.encounter, c.seq = s.ID, 0
		// A new fight: each fighter facing the hero calls it out (the engine checks that the hero hears him).
		for _, a := range s.Actors {
			if a.Able() && (hero == nil || a.Team != hero.Team) {
				say(a.ID, "spotted")
			}
		}
	}
	hurt := map[string]bool{}
	for _, e := range s.Events {
		if e.Sequence <= c.seq {
			continue
		}
		c.seq = e.Sequence
		switch e.Type {
		case "attack", "blast_hit":
			t := s.Actor(e.TargetID)
			if !e.Hit || e.Amount < 1 || t == nil || t.ID == playerActorID {
				continue
			}
			if t.HP <= 0 {
				for _, ally := range s.Actors {
					if ally.ID != t.ID && ally.Team == t.Team && ally.Able() {
						say(ally.ID, "ally_down")
					}
				}
				continue
			}
			hurt[t.ID] = true
			say(t.ID, "wounded")
		case "move":
			a := s.Actor(e.ActorID)
			if a == nil || !barkCombatFallBack(e) {
				continue
			}
			if a.HP < a.MaxHP || hurt[a.ID] {
				say(a.ID, "wounded_retreat")
			} else {
				say(a.ID, "retreat")
			}
		case "reload":
			say(e.ActorID, "reload")
		case "surrender":
			say(e.ActorID, "surrender")
		}
	}
	if c.pending == nil {
		c.pending = map[string]barkCombatPending{}
	}
	now := r.state.Life.Seconds
	for id, p := range c.pending {
		if old, ok := intent[id]; p.until >= now && (!ok || barkCombatRank[p.intent] > barkCombatRank[old]) {
			intent[id] = p.intent
		}
		delete(c.pending, id)
	}
	ids := make([]string, 0, len(intent))
	for id := range intent {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		if a := s.Actor(id); a != nil && a.HP > 0 {
			if out := r.BarkEvent(id, intent[id], intent[id], ""); out.Reason == "busy" {
				c.pending[id] = barkCombatPending{intent: intent[id], until: now + 8}
			}
		}
	}
}

var barkCombatRank = map[string]int{"spotted": 1, "reload": 2, "wounded": 3, "retreat": 4, "wounded_retreat": 5, "ally_down": 6, "surrender": 7}

// barkCombatFallBack: the executor chose this step to gain distance from the danger or to reach cover for treatment.
func barkCombatFallBack(e behavior.CombatEvent) bool {
	return e.Reason == "increase separation from known danger" || e.Reason == "reach cover with AP reserved for treatment"
}
