func (r *Runtime) readSave(slot string) (state, int64, error) {
	if !r.validSlot(slot) {
		return state{}, 0, errors.New("unknown save slot")
	}
	s, created, err := r.readSaveFile(slot)
	if err == nil || errors.Is(err, os.ErrNotExist) {
		return s, created, err
	}
	var problem saveProblem
	if !errors.As(err, &problem) {
		// the file is whole (its checksum held): what refuses it now is the game it meets
		err = saveProblem{reason: err.Error()}
	}
	return s, created, err
