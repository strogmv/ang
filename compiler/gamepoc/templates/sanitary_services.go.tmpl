	if count == 0 {
		if err := r.sanitaryApproach(&p, *u); err != nil {
			return err
		}
	}
	a = r.state.Life.Actor(id)
	a.Manual = true
	a.Brain.InterruptService()
	sanitaryRestoreDutyBreak(a, p, false)
	a.Brain.AdvanceServiceNeeds(r.world.Life.Brain, id, r.state.Life.Seconds, r.state.Seed, 0)
	if r.state.Sanitary.Users == nil {
		r.state.Sanitary.Users = map[string]sanitaryUser{}
	}
	r.state.Sanitary.Serial = p.Serial
	r.state.Sanitary.Users[id] = p
