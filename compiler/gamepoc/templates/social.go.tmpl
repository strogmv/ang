func(r *Runtime) expireSounds(){
 d:=&r.state.Demo;ttl:=r.world.AI.Policy.Perception.Hearing.SoundTTLTicks;kept:=0
 for kept<len(d.Sounds)&&r.state.Tick-d.Sounds[kept].Tick>=ttl{kept++}
 if kept>0{d.Sounds=append([]behavior.Sound(nil),d.Sounds[kept:]...);d.HeardCursor-=kept;if d.HeardCursor<0{d.HeardCursor=0}}
}
// hearSounds delivers each new sound to its nearest bounded set of listeners. A heard sound is a
// memory fact with an uncertain place and unknown cause; alarms and sirens keep their kind so a
// hearer can relay or know the network is engaged.
func(r *Runtime) hearSounds(){
 d:=&r.state.Demo;hearing:=r.world.AI.Policy.Perception.Hearing;mp:=r.world.AI.Policy.Memory;space:=r.sceneSpace(nil)
 for ;d.HeardCursor<len(d.Sounds);d.HeardCursor++{
  snd:=d.Sounds[d.HeardCursor];var candidates []behavior.Listener
  for _,a:=range r.sceneActors(){if a.ID==snd.SourceID{continue};candidates=append(candidates,behavior.Listener{ID:a.ID,Position:cell(a.Position)})}
  for _,l:=range hearing.Listeners(snd,candidates){
   a:=r.sceneActor(l.ID);if a==nil{continue}
   heard,ok:=hearing.Hear(snd,l.Position,r.actorProfile(*a).HearingMul,space.Blockers(snd.Origin,l.Position),r.cellNoise(a.Position));if !ok{continue}
   kind,subject,cause:="sound",snd.ID,"unknown"
   switch snd.Kind{case "alarm","shout":kind,subject,cause="alarm",snd.SourceID,snd.Cause;case "siren":kind,subject,cause="siren",snd.SourceID,snd.Cause}
   a.Memory.Record(behavior.Fact{Subject:subject,Kind:kind,Source:"hearing",Cause:cause,Value:true,Position:heard.Estimate,Radius:heard.Radius,Strength:heard.Intensity,ObservedTick:r.state.Tick,ExpiresTick:r.state.Tick+hearing.SoundTTLTicks},mp)
  }
 }
}
func(r *Runtime) sceneActor(id string)*demoAgent{for _,a:=range r.sceneActors(){if a.ID==id{return a}};return nil}
// cameraStep: cameras are sensors. Their observations reach the monitoring post only; without an
// operator nobody decides anything, so a camera alone never raises an alarm.
func(r *Runtime) cameraStep(){
 cfg:=r.world.Config.CaptureDemo;if cfg.Monitoring.Operator==""||!r.offenceVisible(){return}
 i:=r.residentIndex(cfg.Monitoring.Operator);if i<0{return};operator:=&r.state.Demo.Residents[i]
 for _,cam:=range r.world.Scene.Cameras{
  if !cam.Online||manhattan(cam.Position,r.state.Player)>cam.Range||!r.sceneVisible(cell(cam.Position),cell(r.state.Player)){continue}
  operator.Memory.Record(behavior.Fact{Subject:"poc.hero",Kind:"incident",Source:"camera",Cause:"camera:"+cam.ID,Value:true,Position:cell(r.state.Player),ObservedTick:r.state.Tick},r.world.AI.Policy.Memory);break
 }
}
// raiseAlarm is an NPC decision: the operator calls the network, anyone else emits an audible alarm.
func(r *Runtime) raiseAlarm(a *demoAgent){
 d:=&r.state.Demo;cause:="incident";if f,k:=a.Memory.Lookup("poc.hero","incident");k==behavior.KnowledgeTrue&&f.Cause!=""{cause=f.Cause}else if alarm,ok:=a.Memory.Best("alarm");ok{cause="relay:"+alarm.Subject}
 a.AlarmRaisedTick=r.state.Tick
 if r.isOperator(a){if !d.Issued{r.issueDemoCall(cause)};return}
 kind:="shout";if r.demoAgentIndex(a.ID)>=0{kind="alarm"}
 r.emitSound(kind,a.Position,a.ID,cause)
 d.AlarmLog=append(d.AlarmLog,alarmRecord{Tick:r.state.Tick,ActorID:a.ID,Cause:cause,Kind:kind,At:a.Position});if len(d.AlarmLog)>32{d.AlarmLog=d.AlarmLog[len(d.AlarmLog)-32:]}
 r.demoEvent(fmt.Sprintf("%s: поднимает тревогу (%s) в (%d,%d)",a.Name,cause,a.Position.X,a.Position.Y))
}
func(r *Runtime) updateSceneAwareness(){
 d:=&r.state.Demo;p:=r.world.AI.Policy.Social
 if r.state.Tick%p.SenseEveryTicks!=0&&(!d.Issued||r.state.Tick!=d.IssuedTick){return}
 observation:=behavior.Observation{SubjectID:"poc.hero",Kind:"detention_incident",Source:"sight",Position:cell(r.state.Player),Tick:r.state.Tick,Active:d.Issued&&!d.Captured&&d.TargetAlive}
 for _,a:=range r.sceneActors(){
  memory:=&a.Reaction.Awareness;memory.Expire(r.state.Tick);a.Memory.Expire(r.state.Tick)
  if d.Issued&&r.state.Tick==d.IssuedTick{heard:=observation;heard.Source="hearing";heard.Position=cell(d.Call);memory.Observe(cell(a.Position),heard,p,true)}
  if d.Issued{memory.Observe(cell(a.Position),observation,p,r.sceneVisible(cell(a.Position),observation.Position))}
  seen:=r.recordSceneMemory(a,observation)
  if memory.Known&&memory.Active&&!d.Captured{for _,c:=range d.Candidates{if !c.Selected{continue};actor:=d.Agents[r.demoAgentIndex(c.AgentID)];if behavior.Distance(cell(a.Position),cell(actor.Position))<=p.SightRange&&r.sceneVisible(cell(a.Position),cell(actor.Position)){memory.ExpiresTick=r.state.Tick+p.MemoryTicks;if f,k:=a.Memory.Lookup("poc.hero","incident");k==behavior.KnowledgeTrue{f.ObservedTick=r.state.Tick;f.ExpiresTick=0;a.Memory.Record(f,r.world.AI.Policy.Memory)};break}}}
  if r.selectedActor(a.ID)&&!memory.Known{received:=observation;received.Position=cell(d.Call);received.Source="message";memory.Observe(cell(a.Position),received,p,false)}
  facts,signals:=r.sceneFacts(a,seen);known:=facts["danger.known"]
  roleID:=r.world.Config.CaptureDemo.ResidentRole;if r.demoAgentIndex(a.ID)>=0{roleID=r.world.Config.CaptureDemo.ResponderRole}
  a.Reaction.Decide(r.world.AI.Roles[roleID],facts,r.state.Tick,p.ReactionNodeBudget)
  previous:=a.Personal.GoalID
  a.Personal.Select(r.world.AI,r.world.Psyche.Law,r.world.Psyche.Actors[a.ID],r.actorProfile(*a),facts,signals,r.state.Tick)
  if a.Personal.GoalID!=previous&&(known||facts["sound.heard"]||facts["alarm.heard"]){r.demoEvent(a.Name+": "+a.Personal.Reason)}
  a.Reaction.HasLookTarget=false;a.Reaction.WatchSubjectID=""
