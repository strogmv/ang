func(r *Runtime) equippedItem(actor string)(inv.Item,bool){
 p:=r.world.Inventory.Preparation
 ids:=[]string{};for id:=range r.state.Inventory.Items{ids=append(ids,id)};sort.Strings(ids)
 for _,id:=range ids{i:=r.state.Inventory.Items[id];d:=r.world.Inventory.Definitions[i.Definition];if i.Location==(inv.Location{Kind:"store",Store:inv.ActorStore(actor),Slot:p.Slot})&&d.UseEffect==p.Effect&&i.Condition>=d.WearPerUse&&i.Condition>0{return i,true}}
 return inv.Item{},false
}
func(r *Runtime) groupEquipped()bool{members:=r.squadMembers();if len(members)<r.world.Config.CaptureDemo.RequiredResponders{return false};for _,m:=range members{if _,ok:=r.equippedItem(m.ID);!ok{return false}};return true}
func(r *Runtime) knownSupplyPoints()[]inv.IssuePoint{
 members:=r.squadMembers();result:=[]inv.IssuePoint{}
 for _,p:=range r.world.Inventory.IssuePoints{known:=false;for _,m:=range members{if r.knownIssue(m.ID,p){known=true}};if known{result=append(result,p)}}
 sort.Slice(result,func(i,j int)bool{return result[i].ID<result[j].ID});return result
}
func(r *Runtime) preparationNeeded()bool{return r.state.Demo.TargetAlive&&!r.state.Demo.Captured&&len(r.knownSupplyPoints())>0&&!r.groupEquipped()}
func(r *Runtime) supplyOwnsMovement()bool{switch r.state.Demo.Supply.Status{case "reserved","travelling","at_service","collecting":return true};return false}
func(r *Runtime) supplyPosition()point{p:=r.world.Inventory.IssuePoints[r.state.Demo.Supply.ServiceID];st:=r.state.Inventory.Stores[p.Store];return point{st.Anchor.At.X,st.Anchor.At.Y}}
func(r *Runtime) supplyCandidates(members []behavior.Member)([]behavior.SupplyPoint,string){
 result:=[]behavior.SupplyPoint{};reason:="stock_unavailable";policy:=r.world.Inventory.Preparation
 for _,p:=range r.knownSupplyPoints(){
  access:=true;for _,m:=range members{if !r.issueAccess(m.ID,p){access=false}};if !access{reason="access_denied";continue}
  st,ok:=r.state.Inventory.Stores[p.Store];if !ok||st.Locked{reason="storage_locked";continue}
  point:=behavior.SupplyPoint{ID:p.ID,Position:behavior.Cell{X:st.Anchor.At.X,Y:st.Anchor.At.Y}}
  for _,i:=range r.state.Inventory.Items{d:=r.world.Inventory.Definitions[i.Definition];if !i.Hidden&&i.Location.Kind=="store"&&i.Location.Store==p.Store&&i.Quantity==1&&i.Condition>=d.WearPerUse&&i.Condition>0&&d.UseEffect==policy.Effect&&d.EquipSlot==policy.Slot&&!r.state.Inventory.Reserved(r.inventoryModelFor(r.state.Life.Enabled),i.ID){point.Stock=append(point.Stock,behavior.SupplyItem{ID:i.ID})}}
  result=append(result,point)
 }
 return result,reason
}
func(r *Runtime) missingEquipment()[]behavior.Member{var missing []behavior.Member;for _,m:=range r.squadMembers(){if _,ok:=r.equippedItem(m.ID);!ok{missing=append(missing,m)}};return missing}
func(r *Runtime) availableSupply()(string,map[string]string,bool,string){
 missing:=r.missingEquipment();if len(missing)==0{return "",nil,false,"already_equipped"}
 controlled:=map[string]bool{};for _,m:=range r.squadMembers(){controlled[m.ID]=true};points,reason:=r.supplyCandidates(r.squadMembers());id,assignments,ok:=behavior.SelectSupply(r.sceneSpace(controlled),missing,points)
 if !ok{enough:=false;for _,p:=range points{if len(p.Stock)>=len(missing){enough=true}};if enough{reason="route_unavailable"}};return id,assignments,ok,reason
}
func(r *Runtime) preparationStep(){
 d:=&r.state.Demo;if d.Captured||!d.TargetAlive||!d.TeamReady||!r.preparationNeeded(){return}
 s:=&d.Supply;policy:=r.world.Inventory.Preparation
 if s.Status==""{s.Status="waiting_stock";s.StartedTick=r.state.Tick;s.DeadlineTick=r.state.Tick+policy.LeaseTicks}
 if r.state.Tick>=s.DeadlineTick{r.failMission("equipment_preparation_deadline");return}
 if r.supplyOwnsMovement(){
  valid:=true;for actor,id:=range s.Assignments{claim,ok:=r.state.Inventory.Reservations[id];if _,equipped:=r.equippedItem(actor);equipped{continue};if !ok||claim.Actor!=actor||claim.Purpose!=d.Squad.ID{valid=false}}
  if valid{return};r.state.Inventory.ReleasePurpose(d.Squad.ID);s.Assignments=nil;s.Goals=nil;s.Status="waiting_stock";d.Plan.Restart("event.stock_changed")
 }
 _,_,available,reason:=r.availableSupply();if available{s.Reason="stock_available";return};s.Reason=reason
 if r.state.Tick-s.StartedTick>=policy.UnavailableTicks{r.failMission("equipment_unavailable: "+reason)}
}
func(r *Runtime) reserveEquipment()(string,string){
 d:=&r.state.Demo;id,assignments,ok,reason:=r.availableSupply();if !ok{return "blocked",reason}
 s:=&d.Supply;if s.StartedTick==0{s.StartedTick=r.state.Tick;s.DeadlineTick=r.state.Tick+r.world.Inventory.Preparation.LeaseTicks}
 claims:=[]inv.Reservation{};actors:=[]string{};for actor:=range assignments{actors=append(actors,actor)};sort.Strings(actors)
 for _,actor:=range actors{item:=r.state.Inventory.Items[assignments[actor]];claims=append(claims,inv.Reservation{ID:fmt.Sprintf("%s/%d/%s",d.Squad.ID,s.StartedTick,actor),Item:item.ID,Actor:actor,Purpose:d.Squad.ID,Quantity:1,ExpectedRevision:item.Revision,CreatedTick:r.state.Tick,ExpiresTick:s.DeadlineTick})}
 if err:=r.state.Inventory.ReserveBatch(r.inventoryModelFor(r.state.Life.Enabled),claims);err!=nil{return "blocked",err.Error()}
 s.Status="reserved";s.ServiceID=id;s.Assignments=assignments;s.MemberKey="";for _,m:=range r.squadMembers(){s.MemberKey+=m.ID+";"};s.Goals=nil
 for _,m:=range r.squadMembers(){a:=r.sceneActor(m.ID);a.Path=nil;a.Goal=a.Position}
 r.demoEvent("Группа резервирует реальные предметы: "+r.world.Inventory.IssuePoints[id].Name);return "done",""
}
func(r *Runtime) supplyOrders(space behavior.Space,members []behavior.Member)[]behavior.Order{
 d:=&r.state.Demo;s:=&d.Supply
 if !r.supplyOwnsMovement(){return nil}
 // Keep a safe distance from the group's last observed threat while preparing.
 walkable:=space.Walkable;space.Walkable=func(p behavior.Cell)bool{return walkable(p)&&r.safeSupplyCell(p,members)}
 if s.Status=="at_service"||s.Status=="collecting"{return r.collectionOrders(space,members)}
 return s.Travel(space,members,cell(r.supplyPosition()),r.world.Inventory.Preparation.AssemblyRadius,r.world.AI.Policy.Group.WaypointHandoff=="while_moving",r.groupPolicy().Cohesion)
}
func(r *Runtime) atSupply()bool{if !r.supplyOwnsMovement(){return false};at:=r.supplyPosition();for _,m:=range r.squadMembers(){if !m.Available||behavior.Distance(m.Position,cell(at))>r.world.Inventory.Preparation.AssemblyRadius{return false}};return true}
func(r *Runtime) collectionOrders(space behavior.Space,members []behavior.Member)[]behavior.Order{
 s:=&r.state.Demo.Supply;s.Status="collecting";at:=cell(r.supplyPosition())
 if s.CurrentActor!=""{if _,done:=r.equippedItem(s.CurrentActor);!done{return supplyOrdersFor(members,s.Goals)}}
 s.CurrentActor="";s.Goals=map[string]behavior.Cell{};for _,m:=range members{s.Goals[m.ID]=m.Position}
 best:=int(^uint(0)>>1);var goal behavior.Cell
 for _,m:=range members{if _,done:=r.equippedItem(m.ID);done{continue};if _,assigned:=s.Assignments[m.ID];!assigned{continue}
  for _,d:=range []behavior.Cell{{X:1,Y:0},{X:0,Y:1},{X:-1,Y:0},{X:0,Y:-1}}{p:=behavior.Cell{X:at.X+d.X,Y:at.Y+d.Y};route:=space.Path(m.Position,p,at,0);cost:=len(route);if m.Position!=p&&cost==0{continue};if cost<best{best=cost;s.CurrentActor=m.ID;goal=p}}
 }
 if s.CurrentActor!=""{s.Goals[s.CurrentActor]=goal};return supplyOrdersFor(members,s.Goals)
}
func supplyOrdersFor(members []behavior.Member,goals map[string]behavior.Cell)[]behavior.Order{var orders []behavior.Order;for _,m:=range members{if p,ok:=goals[m.ID];ok{orders=append(orders,behavior.Order{ActorID:m.ID,Goal:p,Mode:"supplying"})}};return orders}
func(r *Runtime) equipGroup()(string,string){
 d:=&r.state.Demo;if !r.atSupply(){return "running","ожидание группы у выдачи"}
 if !r.groupEquipped(){
  actor:=d.Supply.CurrentActor;if actor==""{return "running","выбор следующего получателя"};a:=r.sceneActor(actor);if a==nil||len(a.Path)>0||manhattan(a.Position,r.supplyPosition())>1{return "running","получатель подходит к шкафу"}
  next:=r.state.Inventory.Clone();id:=d.Supply.Assignments[actor];item,ok:=next.Items[id];claim,leased:=next.Reservations[id];if !ok||!leased||claim.Actor!=actor{return "blocked","reserved stock changed"}
  issue:=inv.Action{Actor:actor,Kind:"issue",Item:id,Quantity:1,ExpectedRevision:item.Revision,Sequence:next.Cursors[actor].Sequence+1,Reservation:claim.ID}
  if _,err:=next.Execute(r.inventoryModelFor(r.state.Life.Enabled),issue,r.actorAccess(actor));err!=nil{return "blocked",err.Error()}
  item=next.Items[id];equip:=inv.Action{Actor:actor,Kind:"equip",Item:id,Quantity:1,ExpectedRevision:item.Revision,Sequence:next.Cursors[actor].Sequence+1}
  if _,err:=next.Execute(r.inventoryModelFor(r.state.Life.Enabled),equip,r.actorAccess(actor));err!=nil{return "blocked",err.Error()}
  r.state.Inventory=next;d.Supply.CurrentActor="";d.Supply.Goals=nil;r.demoEvent(a.Name+": получил и экипировал зарезервированный шокер")
  if !r.groupEquipped(){return "running","выдача следующему участнику"}
 }
 d.Supply.Status="equipped";d.Supply.Goals=nil;d.Squad.TravelGoals=nil;if d.Squad.Track.Known{d.Squad.Target=d.Squad.Track.Position};d.Squad.RallyValid=true;d.Squad.Assembled=true;d.Squad.Phase="assembling";d.Squad.RallyGoals=map[string]behavior.Cell{}
 for _,m:=range r.squadMembers(){if behavior.Distance(m.Position,cell(r.targetPosition()))<=r.world.AI.Policy.Social.SightRange&&r.sceneVisible(m.Position,cell(r.targetPosition())){d.Squad.Target=cell(r.targetPosition());d.Squad.HadSight=true;d.Squad.LastSeenTick=r.state.Tick;break}}
 for _,m:=range r.squadMembers(){if behavior.Distance(m.Position,d.Squad.Target)>r.groupPolicy().Standoff+1{d.Squad.RallyValid=false}}

 for _,m:=range r.squadMembers(){a:=r.sceneActor(m.ID);a.Path=nil;a.Goal=a.Position;d.Squad.RallyGoals[m.ID]=m.Position}
 r.demoEvent("Группа получила и экипировала зарезервированные шокеры");return "done",""
}
func(r *Runtime) useCaptureEquipment()error{
 if !r.groupEquipped(){return nil}
 actions:=[]inv.Action{};for _,m:=range r.squadMembers(){item,_:=r.equippedItem(m.ID);at,_:=r.actorPosition(m.ID);if manhattan(at,r.targetPosition())>r.world.Inventory.Definitions[item.Definition].UseReach{continue};actions=append(actions,inv.Action{Actor:m.ID,Kind:"use",Item:item.ID,Quantity:1,ExpectedRevision:item.Revision,Sequence:r.state.Inventory.Cursors[m.ID].Sequence+1,Target:r.missionActor()})}
 if len(actions)<r.world.Inventory.Preparation.MinContactMembers{return errors.New("not enough equipped contact members")}
 if _,err:=r.state.Inventory.ExecuteBatch(r.inventoryModelFor(r.state.Life.Enabled),actions,r.actorAccess);err!=nil{return err};r.demoEvent("Группа согласованно применила реальное снаряжение");return nil
}
func(r *Runtime) exchangeGroupSlots(waiter,blocker string)bool{
 d:=&r.state.Demo;if d.Squad.Phase!="supplying"{
  var goals map[string]behavior.Cell;minimum:=0
  switch d.Squad.Phase{case "assembling","regroup":goals=d.Squad.RallyGoals;minimum=r.groupPolicy().Standoff;case "approaching":goals=d.Squad.StageGoals;if len(d.Squad.TravelGoals)>0{goals=d.Squad.TravelGoals};minimum=2;case "searching","search_assembling":goals=d.Squad.Search.Goals;default:return false}
  a,okA:=goals[waiter];b,okB:=goals[blocker];if !okA||!okB{return false};wa,ba:=r.sceneActor(waiter),r.sceneActor(blocker);controlled:=map[string]bool{};for _,m:=range r.squadMembers(){controlled[m.ID]=true};space:=r.sceneSpace(controlled)
  cost:=func(from,to behavior.Cell)int{path:=space.Path(from,to,d.Squad.Target,minimum);if from!=to&&len(path)==0{return 100000};return len(path)}
  before:=cost(cell(wa.Position),a)+cost(cell(ba.Position),b);after:=cost(cell(wa.Position),b)+cost(cell(ba.Position),a)
  if after>before||(after==before&&cell(ba.Position)!=b){return false};return d.Squad.ExchangeSlots(waiter,blocker)
 }
 if d.Supply.Status=="collecting"{if _,already:=r.equippedItem(blocker);already{return false};if d.Supply.CurrentActor==waiter{d.Supply.CurrentActor=blocker}}
 goals:=d.Supply.Goals;a,okA:=goals[waiter];b,okB:=goals[blocker];if !okA||!okB||a==b{return false};goals[waiter],goals[blocker]=b,a;return true
}
func(r *Runtime) validatePreparation(s state)error{
 supply:=s.Demo.Supply
 if supply.Status==""{return nil}
 switch supply.Status{case "waiting_stock","reserved","travelling","at_service","collecting","equipped":default:return errors.New("invalid supply status")}
 if supply.StartedTick<0||supply.StartedTick>s.Tick||supply.DeadlineTick!=supply.StartedTick+r.world.Inventory.Preparation.LeaseTicks||len(supply.Assignments)>r.world.Config.CaptureDemo.RequiredResponders{return errors.New("invalid supply bounds")}
 if supply.ServiceID!=""{if _,ok:=r.world.Inventory.IssuePoints[supply.ServiceID];!ok{return errors.New("unknown issue point")}}
 used:=map[string]bool{};for actor,id:=range supply.Assignments{if !r.world.Inventory.Actors[actor]||used[id]{return errors.New("invalid assigned stock")};if _,ok:=s.Inventory.Items[id];!ok{return errors.New("missing assigned stock")};used[id]=true}
 for actor,goal:=range supply.Goals{if !r.world.Inventory.Actors[actor]||!r.walkable(location(goal)){return errors.New("invalid supply position")}}
 return nil
}

func(r *Runtime) safeSupplyCell(p behavior.Cell,members []behavior.Member)bool{
 if !r.preparationThreat(){return true};target:=r.state.Demo.Squad.Target;distance:=behavior.Distance(p,target);if distance>=2{return true};for _,m:=range members{at:=behavior.Distance(m.Position,target);if at<2&&distance>at{return true}};return false
}
func(r *Runtime) backOutForPassing(waiter,blocker *demoAgent,focus behavior.Cell,minimum int,desired []point)bool{
 if !r.selectedActor(waiter.ID)||!r.selectedActor(blocker.ID)||r.state.Demo.Supply.Status!="collecting"{return false}
 own:=r.sceneSpace(map[string]bool{waiter.ID:true});avoid:=map[behavior.Cell]bool{cell(blocker.Position):true};for _,p:=range desired{avoid[cell(p)]=true}
 var retreat,parking []behavior.Cell;var retreatGoal,parkingGoal behavior.Cell
 for attempt:=0;attempt<8;attempt++{
  retreat=own.YieldRoute(cell(waiter.Position),focus,minimum,avoid);if len(retreat)==0{return false};retreatGoal=retreat[len(retreat)-1]
  if !behavior.SupportedStep(waiter.ID,retreatGoal,r.squadMembers(),r.groupPolicy().Cohesion){avoid[retreatGoal]=true;continue}
  passage:=r.sceneSpace(map[string]bool{blocker.ID:true,waiter.ID:true});passage.Blocked[retreatGoal]=true;parkingAvoid:=map[behavior.Cell]bool{};for p,v:=range avoid{parkingAvoid[p]=v};parkingAvoid[cell(waiter.Position)]=true
  parking=passage.YieldRoute(cell(blocker.Position),focus,minimum,parkingAvoid);if len(parking)==0{avoid[retreatGoal]=true;continue};parkingGoal=parking[len(parking)-1]
  if !behavior.SupportedStep(blocker.ID,parkingGoal,r.squadMembers(),r.groupPolicy().Cohesion){avoid[retreatGoal]=true;parking=nil;continue};break
 }
 if len(parking)==0{return false}

 until:=r.state.Tick+r.world.AI.Policy.Social.YieldHoldTicks+int64(len(retreat)+len(parking))*r.world.Config.CaptureDemo.MoveEveryTicks
 for _,entry:=range []struct{a *demoAgent;route []behavior.Cell}{{waiter,retreat},{blocker,parking}}{a:=entry.a;a.YieldResumeTask=a.Task;a.YieldResumeGoal=a.Goal;a.Task="yielding";a.YieldUntil=until;a.Path=nil;for _,p:=range entry.route{a.Path=append(a.Path,location(p))};a.Goal=location(entry.route[len(entry.route)-1]);a.MoveStartNS=r.state.Tick*r.tickNS()}
 if r.state.Demo.Squad.Phase=="supplying"{r.state.Demo.Supply.Goals[blocker.ID]=parkingGoal}
 r.demoEvent(waiter.Name+": отступает, освобождая карман для прохода");return true
}

func(r *Runtime) preparationThreat()bool{
 at:=r.targetPosition();for _,m:=range r.squadMembers(){if behavior.Distance(m.Position,cell(at))<=r.world.AI.Policy.Social.SightRange&&r.sceneVisible(m.Position,cell(at)){return true}}
 known:=r.state.Demo.Squad.Target;for _,m:=range r.squadMembers(){if behavior.Distance(m.Position,known)<=r.world.AI.Policy.Social.SightRange&&r.sceneVisible(m.Position,known){return false}};return true
}
