 edges:=map[string]map[string]bool{};saved:=map[string]bool{};seenLegs:=[]string{};gateByPass:=int64(-1);hooked:=false
 opening:=map[string]int64{};for _,lot:=range r.world.CargoConvoys.Lots{if sh:=r.cargoLotShop(lot);sh!=nil{opening[lot.Shop]=morning+sh.OpenSecond}}
 deadline:=morning+12*3600;if rate>=30{deadline=morning+27*3600}
 var replay *Runtime;replayTicks:=0
 for r.state.Life.Seconds<deadline{
  r.step()
  if f:=r.state.Life.PopulationFailure;f!=""{t.Fatalf("the world stopped: %s",f)}
  if replay!=nil{replay.step();replayTicks++
   // the convoy, its riders and the lots' stores go on the same way (the hall's visitors keep caches outside the save)
   if !reflect.DeepEqual(r.state.CargoConvoys,replay.state.CargoConvoys)||!reflect.DeepEqual(cargoLotStock(r),cargoLotStock(replay)){t.Fatalf("a save at %s diverged after %d ticks",seenLegs[len(seenLegs)-1],replayTicks)}
   for _,m:=range v.Crew{a,b:=r.state.Life.Actor(m.ID),replay.state.Life.Actor(m.ID);if a.Level!=b.Level||a.Position!=b.Position||!reflect.DeepEqual(a.Mount,b.Mount)||!reflect.DeepEqual(a.Trip,b.Trip){t.Fatalf("a save at %s moved rider %s differently",seenLegs[len(seenLegs)-1],m.ID)}}
   if replayTicks>=40/int(min(rate,int64(4))){replay=nil}}
