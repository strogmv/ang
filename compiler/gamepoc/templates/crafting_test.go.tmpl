// Code generated by ANG. DO NOT EDIT.
// Crafting stage 1 (doc 93) through the real host: things add up for every job (no unit appears or vanishes outside the
// recipe), the outcome is a function of the seed, the tiers open schematics, a master works an order by the same law,
// a job survives save and load, and a job without the schematic, the tool, the parts or the place is refused untouched.
package poc

import (
	"reflect"
	"strings"
	"testing"

	behavior "angelsdemons/server/internal/behavior"
	crafting "angelsdemons/server/internal/crafting"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

const craftingMatvey, craftingTaya = "char.market_trader_matvey_khor", "char.market_trader_taya_ryzhova"

func craftingFixture(t *testing.T) *Runtime {
	t.Helper()
	r := lifeRuntimeFixture(t)
	if !r.craftingOn() {
		t.Skip("world has no crafting catalog")
	}
	r.state.Life.Seconds = 12 * 3600
	return r
}
func craftingShop(t *testing.T, r *Runtime, owner string) inv.Shopfront {
	t.Helper()
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.Owner == owner {
			return sh
		}
	}
	t.Fatalf("no shopfront of %s", owner)
	return inv.Shopfront{}
}

// craftingOpen stands a master at the own post with the stall open (as Life and commerce do in the day).
func craftingOpen(t *testing.T, r *Runtime, owner string) inv.Shopfront {
	t.Helper()
	sh := craftingShop(t, r, owner)
	a := r.state.Life.Actor(owner)
	if a == nil {
		t.Fatalf("master %s is not a Life actor", owner)
	}
	a.Level, a.Position, a.Path, a.Arrived = sh.Service.Level, behavior.Cell{X: sh.Service.At.X, Y: sh.Service.At.Y}, nil, true
	p := r.state.Inventory.Shopfronts[sh.ID]
	p.Open = true
	r.state.Inventory.Shopfronts[sh.ID] = p
	if !r.storefrontOpen(sh.ID) {
		t.Fatalf("stall %s did not open", sh.ID)
	}
	return sh
}
func craftingStand(t *testing.T, r *Runtime, master string) {
	t.Helper()
	ms, ok := r.world.Crafting.Master(master)
	if !ok {
		t.Fatalf("no crafting master %s", master)
	}
	a := r.state.Life.Actor(playerActorID)
	a.Level, a.Position, a.Path, a.Arrived = ms.Level, behavior.Cell{X: ms.Approach.X, Y: ms.Approach.Y}, nil, true
	a.Trip = nil
	r.syncLifeHero()
}
func craftingStandAway(r *Runtime) {
	a := r.state.Life.Actor(playerActorID)
	a.Level, a.Position, a.Path, a.Arrived, a.Trip = r.world.Crafting.Level, behavior.Cell{X: 2, Y: 2}, nil, true, nil
}

// craftingGive hands the hero some units of a definition taken from a stall (the purchase itself is the inventory's).
func craftingGive(t *testing.T, r *Runtime, definition string, n int64) {
	t.Helper()
	for _, id := range sortedItemIDs(r.state.Inventory) {
		i := r.state.Inventory.Items[id]
		if i.Definition != definition || i.Owner == playerActorID || i.Location.Kind != "store" || n == 0 {
			continue
		}
		take := min(n, i.Quantity)
		mv := inv.Relocate{Item: id, Quantity: take, To: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, Owner: playerActorID}
		if take < i.Quantity {
			mv.Split = "test:give:" + id
		}
		if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: []inv.Relocate{mv}}); err != nil {
			t.Fatalf("give %s: %v", definition, err)
		}
		n -= take
	}
	if n > 0 {
		t.Fatalf("the world has not enough %s", definition)
	}
}
func sortedItemIDs(s inv.State) []string {
	ids := make([]string, 0, len(s.Items))
	for id := range s.Items {
		ids = append(ids, id)
	}
	for i := 1; i < len(ids); i++ {
		for j := i; j > 0 && ids[j] < ids[j-1]; j-- {
			ids[j], ids[j-1] = ids[j-1], ids[j]
		}
	}
	return ids
}
func craftingUnits(r *Runtime) map[string]int64 {
	n := map[string]int64{}
	for _, i := range r.state.Inventory.Items {
		n[i.Definition] += i.Quantity
	}
	return n
}
func craftingMoney(r *Runtime) int64 {
	var n int64
	for _, a := range r.state.Inventory.Accounts {
		n += a.Balance
	}
	return n
}
func craftingHeroItem(r *Runtime, definition string) inv.Item {
	for _, id := range sortedItemIDs(r.state.Inventory) {
		i := r.state.Inventory.Items[id]
		if i.Definition == definition && i.Owner == playerActorID {
			return i
		}
	}
	return inv.Item{}
}
func craftingDo(r *Runtime, action, recipe, item, job string) error {
	return r.craftingCommand(&pb.PocCraftingCommand{RequestId: "t", Epoch: r.state.Epoch, Action: action, Recipe: recipe, ItemId: item, JobId: job}, "ru")
}
func craftingRun(t *testing.T, r *Runtime, seconds int64) {
	t.Helper()
	for left := seconds; left > 0; left -= 60 {
		r.state.Life.Seconds += min(60, left)
		if err := r.advanceCrafting(min(60, left)); err != nil {
			t.Fatal(err)
		}
	}
	if err := r.validateInventory(r.state); err != nil {
		t.Fatalf("inventory after crafting: %v", err)
	}
}
func craftingView(r *Runtime, locale string) *pb.PocCraftingView {
	msg := &pb.PocGameState{}
	r.appendCrafting(msg, locale)
	return msg.Crafting
}

func TestCraftingRepairOfTheHeirloomAtMatveysBenchConservesAndJournals(t *testing.T) {
	r := craftingFixture(t)
	craftingOpen(t, r, craftingMatvey)
	craftingStand(t, r, craftingMatvey)
	craftingGive(t, r, "item.part.leather", 2)
	headset := craftingHeroItem(r, "item.heirloom_headset")
	if headset.ID == "" || headset.Condition >= 1000000 {
		t.Fatal("the hero must start with the broken heirloom headset")
	}
	units, money := craftingUnits(r), craftingMoney(r)
	hero0 := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance
	if err := craftingDo(r, "start", "repair.grandfather_headset", headset.ID, ""); err != nil {
		t.Fatal(err)
	}
	j := r.state.Crafting.Jobs[0]
	if r.state.Inventory.Items[headset.ID].Location.Store != r.world.Crafting.Hero.WorkStore || j.Plan.Station != "station.matvey_soldering" || j.Plan.RentMinor < 1 {
		t.Fatalf("the headset is not on Matvey's bench or no rent: %+v", j.Plan)
	}
	if got := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance; got != hero0-j.Plan.RentMinor || craftingMoney(r) != money {
		t.Fatal("rent did not move from the hero to Matvey")
	}
	if !reflect.DeepEqual(units, craftingUnits(r)) {
		t.Fatal("starting a job created or destroyed things")
	}
	if craftingDo(r, "start", "craft.power_block", "", "") == nil {
		t.Fatal("a second own job accepted")
	}
	// walking away pauses a job that needs the station's tools
	craftingStandAway(r)
	craftingRun(t, r, 3600)
	if len(r.state.Crafting.Jobs) != 1 || r.state.Crafting.Jobs[0].Progress != 0 {
		t.Fatal("the job went on without the hero at the bench")
	}
	craftingStand(t, r, craftingMatvey)
	points0 := r.state.Crafting.Actors[playerActorID].Points["electrics"]
	craftingRun(t, r, 3600)
	if len(r.state.Crafting.Jobs) != 0 {
		t.Fatal("the repair did not finish in its hour")
	}
	after := craftingUnits(r)
	spent := map[string]int64{}
	for _, u := range j.Plan.Uses {
		spent[u.Definition] += u.Quantity
	}
	if j.Plan.Outcome != "success" {
		spent = map[string]int64{}
		for _, u := range j.Plan.Spoil {
			spent[u.Definition] += u.Quantity
		}
	}
	for d, n := range units {
		if after[d] != n-spent[d] {
			t.Fatalf("%s: %d before, %d after, %d spent by the recipe (%s)", d, n, after[d], spent[d], j.Plan.Outcome)
		}
	}
	h := r.state.Inventory.Items[headset.ID]
	if h.Location.Store != inv.ActorStore(playerActorID) || h.Owner != playerActorID {
		t.Fatal("the headset did not come back to the hero")
	}
	if j.Plan.Outcome == "success" && h.Condition < 900000 || j.Plan.Outcome == "failure" && h.Condition != headset.Condition {
		t.Fatalf("condition %d after %s", h.Condition, j.Plan.Outcome)
	}
	if len(r.state.Crafting.Journal[headset.ID]) != 1 || r.state.Crafting.Actors[playerActorID].Points["electrics"] <= points0 {
		t.Fatal("the heirloom has no journal line or the hero learnt nothing")
	}
	view := craftingView(r, "ru")
	found := false
	for _, th := range view.Things {
		found = found || th.ItemId == headset.ID && th.Heirloom && len(th.Journal) == 1
	}
	if !found || view.Notice == "" {
		t.Fatal("the snapshot does not show the heirloom with its journal")
	}
}

func TestCraftingOutcomeIsAFunctionOfTheSeed(t *testing.T) {
	run := func(seed int64) (crafting.State, map[string]int64) {
		r := craftingFixture(t)
		r.state.Seed = seed
		craftingStand(t, r, craftingTaya)
		craftingGive(t, r, "item.hub_light_headlamp", 3)
		for k := 0; k < 3; k++ {
			lamp := craftingHeroItem(r, "item.hub_light_headlamp")
			if err := craftingDo(r, "start", "disassemble.headlamp", lamp.ID, ""); err != nil {
				t.Fatal(err)
			}
			craftingRun(t, r, 15*60)
		}
		return r.state.Crafting.Clone(), craftingUnits(r)
	}
	a, ua := run(11)
	b, ub := run(11)
	if !reflect.DeepEqual(a, b) || !reflect.DeepEqual(ua, ub) {
		t.Fatal("the same seed gave different jobs")
	}
	if ua["item.hub_light_headlamp"] != ub["item.hub_light_headlamp"] {
		t.Fatal("salvage did not spend the lamps")
	}
	m := craftingFixture(t).world.Crafting
	w := m.NewState().Actors[m.Hero.Actor].Worker(m.Hero.Actor)
	lamp := &crafting.Stack{ID: "x", Definition: "item.hub_light_headlamp", Quantity: 1, Condition: 1000000}
	tools := []crafting.Stack{{ID: "s", Definition: "item.tool.screwdrivers", Quantity: 1, Condition: 1000000}}
	differ := false
	p0, _ := m.Plan(w, crafting.Request{Recipe: "disassemble.headlamp", Target: "x", JobID: "job.1", Seed: 1}, tools, lamp, crafting.Bench{})
	for seed := int64(2); seed < 40 && !differ; seed++ {
		p, _ := m.Plan(w, crafting.Request{Recipe: "disassemble.headlamp", Target: "x", JobID: "job.1", Seed: seed}, tools, lamp, crafting.Bench{})
		differ = !reflect.DeepEqual(p.Makes, p0.Makes) || p.Outcome != p0.Outcome
	}
	if !differ {
		t.Fatal("the seed never changes a salvage")
	}
}

func TestCraftingTierOpensSchematicsByTheSameLaw(t *testing.T) {
	r := craftingFixture(t)
	view := craftingView(r, "en")
	tier := func(v *pb.PocCraftingView) int32 {
		for _, d := range v.Disciplines {
			if d.Id == "electrics" {
				return d.Tier
			}
		}
		return 0
	}
	unlocked := func(v *pb.PocCraftingView, id string) bool {
		for _, b := range v.Book {
			if b.Id == id {
				return b.Unlocked
			}
		}
		return false
	}
	if tier(view) != 2 || unlocked(view, "craft.earphones") || !unlocked(view, "craft.power_block") {
		t.Fatal("the hero must start at electrics tier 2: power block open, earphones (tier 3) closed")
	}
	mp3, _ := r.world.Crafting.Recipe("disassemble.mp3_player")
	a := r.state.Crafting.Actors[playerActorID]
	a.Points["electrics"] = 34*1000 + 500
	r.state.Crafting.Actors[playerActorID] = a
	craftingStand(t, r, craftingTaya)
	craftingGive(t, r, "item.hub_light_cell", 4)
	craftingGive(t, r, "item.part.housing", 1)
	craftingGive(t, r, "item.part.circuit_board", 1)
	craftingGive(t, r, "item.tool.soldering_iron", 1)
	before := craftingUnits(r)
	if err := craftingDo(r, "start", "craft.power_block", "", ""); err != nil {
		t.Fatal(err)
	}
	p := r.state.Crafting.Jobs[0].Plan
	craftingRun(t, r, 40*60)
	after := craftingUnits(r)
	if p.Outcome == "success" && (after["item.power_block"] != before["item.power_block"]+1 || after["item.hub_light_cell"] != before["item.hub_light_cell"]-4) {
		t.Fatal("a successful power block must turn exactly its parts into one block")
	}
	view = craftingView(r, "en")
	// stage 2: earphones are no longer general knowledge (a master, a copy, a sample); the tier opens tier-3 salvage
	if tier(view) != 3 || !r.world.Crafting.Knows(r.craftingWorker(playerActorID), mp3) || unlocked(view, "craft.earphones") {
		t.Fatalf("finishing a tier-2 job above 34 points did not open tier 3 (%d points)", r.state.Crafting.Actors[playerActorID].Points["electrics"])
	}
	if p.Outcome == "success" {
		block := craftingHeroItem(r, "item.power_block")
		if block.Grade.Quality != p.Quality || block.Grade.Provenance != "handmade" {
			t.Fatal("the product does not carry the quality of the job")
		}
	}
}

func TestCraftingOrderAtMatveyIsPaidWorkedWhileOpenAndCollected(t *testing.T) {
	r := craftingFixture(t)
	craftingStand(t, r, craftingMatvey)
	headset := craftingHeroItem(r, "item.heirloom_headset")
	if craftingDo(r, "order", "repair.grandfather_headset", headset.ID, "") == nil {
		t.Fatal("an order at a closed stall accepted")
	}
	craftingOpen(t, r, craftingMatvey)
	view := craftingView(r, "ru")
	if view.Counter == nil || view.Counter.Master != craftingMatvey || len(view.Counter.Offers) == 0 {
		t.Fatal("the counter of Matvey offers nothing")
	}
	var offer *pb.PocCraftingRecipe
	for _, o := range view.Counter.Offers {
		if o.Id == "repair.grandfather_headset" {
			offer = o
		}
	}
	if offer == nil || !offer.CanStart || offer.Price == "" || offer.DueSeconds <= r.state.Life.Seconds {
		t.Fatalf("the headset repair is not offered with a price and a deadline: %+v", offer)
	}
	units, money := craftingUnits(r), craftingMoney(r)
	hero0 := r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance
	if err := craftingDo(r, "order", "repair.grandfather_headset", headset.ID, ""); err != nil {
		t.Fatal(err)
	}
	j := r.state.Crafting.Jobs[0]
	if j.Worker != craftingMatvey || j.Client != playerActorID || j.PaidMinor < 1 || r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance != hero0-j.PaidMinor || craftingMoney(r) != money {
		t.Fatal("the order was not paid to Matvey")
	}
	if !reflect.DeepEqual(units, craftingUnits(r)) || r.state.Inventory.Items[headset.ID].Location.Store != j.Store {
		t.Fatal("handing over the order created things or the headset is not on Matvey's shelf")
	}
	for _, u := range j.Plan.Uses {
		if r.state.Inventory.Items[u.Stack].Owner != craftingMatvey {
			t.Fatal("Matvey works with the hero's parts instead of his own")
		}
	}
	// the master works only at the open stall
	p := r.state.Inventory.Shopfronts[craftingShop(t, r, craftingMatvey).ID]
	p.Open = false
	r.state.Inventory.Shopfronts[craftingShop(t, r, craftingMatvey).ID] = p
	craftingRun(t, r, 2*3600)
	if r.state.Crafting.Jobs[0].Progress != 0 {
		t.Fatal("the order advanced while the stall was closed")
	}
	craftingOpen(t, r, craftingMatvey)
	if id, _, ok := r.craftingSellerWork(craftingMatvey); !ok || id != "solder" {
		t.Fatal("Matvey does not show the work action of his stall while the order runs")
	}
	points0 := r.state.Crafting.Actors[craftingMatvey].Points["electrics"]
	craftingRun(t, r, 3600)
	if len(r.state.Crafting.Jobs) != 1 || !r.state.Crafting.Jobs[0].Done {
		t.Fatal("the order did not finish")
	}
	if r.state.Crafting.Actors[craftingMatvey].Points["electrics"] <= points0 {
		t.Fatal("Matvey learnt nothing from the job (the same law as the hero)")
	}
	if j.Plan.Outcome != "success" && r.state.Inventory.Accounts[r.world.Crafting.Hero.Account].Balance != hero0 {
		t.Fatal("a failed order was not refunded")
	}
	craftingStandAway(r)
	if craftingDo(r, "collect", "", "", j.ID) == nil {
		t.Fatal("collected an order away from the counter")
	}
	craftingStand(t, r, craftingMatvey)
	if err := craftingDo(r, "collect", "", "", j.ID); err != nil {
		t.Fatal(err)
	}
	h := r.state.Inventory.Items[headset.ID]
	if h.Location.Store != inv.ActorStore(playerActorID) || len(r.state.Crafting.Jobs) != 0 {
		t.Fatal("the headset did not come back from Matvey")
	}
	if j.Plan.Outcome == "success" && h.Condition < 900000 {
		t.Fatal("a successful order did not repair the headset")
	}
	if craftingMoney(r) != money {
		t.Fatal("money appeared or vanished in the order")
	}
}

func TestCraftingJobSurvivesSaveAndLoad(t *testing.T) {
	r := craftingFixture(t)
	craftingStand(t, r, craftingTaya)
	craftingGive(t, r, "item.hub_light_headlamp", 1)
	lamp := craftingHeroItem(r, "item.hub_light_headlamp")
	if err := craftingDo(r, "start", "disassemble.headlamp", lamp.ID, ""); err != nil {
		t.Fatal(err)
	}
	craftingRun(t, r, 5*60)
	saved := r.snapshotState()
	if err := r.writeSave(r.world.Config.SaveSlots[0], saved); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(r.world.Config.SaveSlots[0])
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(loaded.Crafting, saved.Crafting) || !reflect.DeepEqual(loaded.Inventory.Items, saved.Inventory.Items) {
		t.Fatal("the crafting state or the held parts changed through save and load")
	}
	broken := r.snapshotState()
	delete(broken.Inventory.Items, lamp.ID)
	if r.validateCraftingSave(broken) == nil {
		t.Fatal("a save whose job lost its thing was accepted")
	}
	r.state = loaded
	craftingRun(t, r, 10*60)
	if len(r.state.Crafting.Jobs) != 0 {
		t.Fatal("the loaded job did not finish")
	}
}

func TestCraftingRefusesWithoutSchematicToolPartsOrPlaceAndChangesNothing(t *testing.T) {
	r := craftingFixture(t)
	craftingStandAway(r)
	before := r.snapshotState()
	cases := map[string][3]string{
		"unknown schematic": {"start", "craft.lantern", ""},
		"no parts":          {"start", "craft.power_block", ""},
		"no place":          {"start", "craft.tomato_seedling", ""},
		"not a master":      {"order", "repair.grandfather_headset", craftingHeroItem(r, "item.heirloom_headset").ID},
	}
	for name, c := range cases {
		if err := craftingDo(r, c[0], c[1], c[2], ""); err == nil || err.Error() == "" {
			t.Fatalf("%s: accepted", name)
		}
	}
	// no tool: the parts are there, the soldering iron is not (and no bench is near)
	craftingGive(t, r, "item.hub_light_cell", 4)
	craftingGive(t, r, "item.part.housing", 1)
	craftingGive(t, r, "item.part.circuit_board", 1)
	mid := r.snapshotState()
	if err := craftingDo(r, "start", "craft.power_block", "", ""); err == nil {
		t.Fatal("assembly without a soldering iron accepted")
	} else if want := r.craftingText("ru", "crafting.error.no_tool", "detail", r.craftingText("ru", "crafting.tool.soldering_iron")); err.Error() != want {
		t.Fatalf("refusal text %q, want %q", err.Error(), want)
	}
	if !reflect.DeepEqual(mid.Inventory, r.state.Inventory) || !reflect.DeepEqual(mid.Crafting, r.state.Crafting) {
		t.Fatal("a refused job changed the world")
	}
	if !reflect.DeepEqual(before.Crafting, mid.Crafting) {
		t.Fatal("refusals changed the crafting state")
	}
}

// Scenarios written as data in CUE (content/world/crafting/scenarios.cue).
func TestCraftingScenariosFromCUE(t *testing.T) {
	if len(craftingFixture(t).world.Crafting.Scenarios) == 0 {
		t.Skip("no crafting scenarios")
	}
	for _, sc := range craftingFixture(t).world.Crafting.Scenarios {
		t.Run(sc.ID, func(t *testing.T) {
			r := craftingFixture(t)
			a := r.state.Crafting.Actors[playerActorID]
			for d, p := range sc.Points {
				a.Points[d] = p * 1000
			}
			for _, id := range sc.Known {
				a.Known[id] = true
			}
			r.state.Crafting.Actors[playerActorID] = a
			if sc.Trust != nil {
				r.state.Crafting.Law.Trust = *sc.Trust
			}
			if sc.Money != nil {
				craftingSetMoney(r, *sc.Money)
			}
			if sc.Open != "" {
				craftingOpen(t, r, sc.Open)
			}
			if sc.Stand != "" {
				craftingStand(t, r, sc.Stand)
			} else {
				craftingStandAway(r)
			}
			if sc.Terminal {
				craftingAtTerminal(t, r)
			}
			if sc.Near != "" {
				craftingBringNear(t, r, sc.Near)
			}
			if sc.RelationPermille != nil {
				who := sc.Stand + sc.Near
				if err := r.state.Life.SetRelation(who, playerActorID, float64(*sc.RelationPermille)/1000); err != nil {
					t.Fatal(err)
				}
			}
			for _, g := range sc.Give {
				craftingGive(t, r, g.Item, g.N)
			}
			target := ""
			if sc.Target != "" {
				target = craftingHeroItem(r, sc.Target).ID
				if sc.Action == "steal" {
					target = craftingAnyItem(r, sc.Target).ID
				}
			}
			units, money := craftingUnits(r), craftingMoney(r)
			err := r.craftingCommand(&pb.PocCraftingCommand{RequestId: "t", Epoch: r.state.Epoch, Action: sc.Action, Recipe: sc.Recipe, ItemId: target, Target: sc.Near}, "ru")
			switch sc.Expect {
			case "started":
				if err != nil || len(r.state.Crafting.Jobs) != 1 {
					t.Fatalf("expected a started job: %v", err)
				}
			case "learned":
				if err != nil || !r.craftingKnowsClean(sc.Recipe) {
					t.Fatalf("expected the schematic in memory: %v", err)
				}
			case "done":
				if err != nil || r.state.Inventory.Items[target].Grade.Bound != crafting.Chip(playerActorID) {
					t.Fatalf("expected the thing bound to the hero: %v", err)
				}
			default:
				want := r.craftingText("ru", sc.Expect)
				if i := strings.Index(want, "{"); i == 0 {
					want = want[strings.Index(want, "}")+1:]
				} else if i > 0 {
					want = want[:i]
				}
				if err == nil || !strings.Contains(err.Error(), want) || len(r.state.Crafting.Jobs) != 0 {
					t.Fatalf("expected %s (%q), got %v", sc.Expect, want, err)
				}
			}
			if !reflect.DeepEqual(units, craftingUnits(r)) || money != craftingMoney(r) {
				t.Fatal("a command created or destroyed things or money")
			}
		})
	}
}
