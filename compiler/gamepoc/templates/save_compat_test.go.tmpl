// Code generated by ANG. DO NOT EDIT.
package poc

// Saves survive updates (owner 20.11, design/saves/compat-v1/BRIEF.md). A save depends on the save key — the server's
// runtime package without what only shows things (ANG save_key.go) — not on the content hash of the whole world. When
// the key differs, a save loads iff every strict part is unchanged and the full validation against this content passes.
// The corpus in testdata/save-corpus/<build>/ holds real saves of earlier builds; testdata/save-corpus/retired/ is
// skipped (a corpus retired on purpose, with the reason in its README).

import (
	"bytes"
	"compress/gzip"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"errors"
	"io"
	"os"
	"path/filepath"
	"reflect"
	"sort"
	"strings"
	"testing"
	"time"

	behavior "angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

// saveCorpus: build/name -> the save file as the build wrote it.
func saveCorpus(t *testing.T) map[string][]byte {
	t.Helper()
	files, err := filepath.Glob(filepath.Join("testdata", "save-corpus", "*", "*.json.gz"))
	if err != nil {
		t.Fatal(err)
	}
	out := map[string][]byte{}
	for _, file := range files {
		build := filepath.Base(filepath.Dir(file))
		if build == "retired" {
			continue
		}
		f, err := os.Open(file)
		if err != nil {
			t.Fatal(err)
		}
		z, err := gzip.NewReader(f)
		if err != nil {
			t.Fatal(err)
		}
		data, err := io.ReadAll(z)
		f.Close()
		if err != nil {
			t.Fatal(err)
		}
		out[build+"/"+strings.TrimSuffix(filepath.Base(file), ".json.gz")] = data
	}
	if len(out) == 0 {
		t.Fatal("no save corpus in testdata/save-corpus")
	}
	return out
}

func saveCorpusNames(corpus map[string][]byte) []string {
	names := make([]string, 0, len(corpus))
	for name := range corpus {
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}

// corpusRuntime: a fresh game whose first manual slot holds the corpus file.
func corpusRuntime(t *testing.T, raw []byte) (*Runtime, string) {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	slot := r.world.Config.SaveSlots[0]
	if err := os.WriteFile(r.slotFile(slot), raw, 0600); err != nil {
		t.Fatal(err)
	}
	return r, slot
}

// changeWorld applies a content change to both worlds a runtime holds (the disk worker reads the canonical one).
func changeWorld(r *Runtime, change func(w *worldData)) {
	change(&r.world)
	change(&r.canonicalWorld)
}

// changedKey makes the runtime a build whose given key parts changed, as ANG would hash them.
func changedKey(r *Runtime, parts ...string) {
	changeWorld(r, func(w *worldData) {
		next := map[string]string{}
		for k, v := range w.SaveKey.Parts {
			next[k] = v
		}
		for _, p := range parts {
			next[p] = "changed:" + p
		}
		w.SaveKey.Parts = next
		w.SaveKey.Hash = saveKeyRecordHash(next)
	})
}

// saveKeyRecordHash: the whole key from its parts, as ANG computes it (save_key.go).
func saveKeyRecordHash(parts map[string]string) string {
	names := make([]string, 0, len(parts))
	for name := range parts {
		names = append(names, name)
	}
	sort.Strings(names)
	h := sha256.New()
	for _, name := range names {
		h.Write([]byte(name))
		h.Write([]byte{0})
		h.Write([]byte(parts[name]))
		h.Write([]byte{'\n'})
	}
	return hex.EncodeToString(h.Sum(nil))
}

// loadAndRun loads the slot through the client's command, runs the world and saves it again.
func loadAndRun(t *testing.T, r *Runtime, slot, name string) {
	t.Helper()
	c := &connection{locale: "ru", out: make(chan *pb.ServerMessage, 4096), stop: make(chan struct{})}
	r.testCommand(c, loadRequest(r, "corpus.load", slot, ""))
	if a := answer(t, c, "corpus.load"); !a.Ok {
		t.Fatalf("%s: the load command refused: %s", name, a.Message)
	}
	if !r.state.Active {
		t.Fatalf("%s: no game after the load", name)
	}
	for i := 0; i < 40; i++ {
		r.step()
		for len(c.out) > 0 {
			<-c.out
		}
	}
	if r.state.Life.PopulationFailure != "" {
		t.Fatalf("%s: the loaded world stopped: %s", name, r.state.Life.PopulationFailure)
	}
	again := r.world.Config.SaveSlots[1]
	if err := r.writeSave(again, r.snapshotState()); err != nil {
		t.Fatalf("%s: the loaded world does not save: %v", name, err)
	}
	if _, _, err := r.storageRuntime().readSave(again); err != nil {
		t.Fatalf("%s: its next save does not load: %v", name, err)
	}
}

func corpusRefusal(build string, err error) string {
	return "the build refuses the real saves of " + build + ": " + err.Error() + ". If this content change is meant to " +
		"refuse older saves (a new resident before the growth migration, a changed strict part), move the corpus to " +
		"testdata/save-corpus/retired/ with the reason and write a fresh one: ANG_SAVE_CORPUS_WRITE=<dir> go test " +
		"./internal/poc -run TestWriteSaveCorpus"
}

func TestSaveKeyOfThisBuild(t *testing.T) {
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	k := r.world.SaveKey
	if len(k.Parts) == 0 || k.Hash != saveKeyRecordHash(k.Parts) {
		t.Fatalf("world.json save_key is not the hash of its parts: %s", k.Hash)
	}
	if len(k.Strict) == 0 {
		t.Fatal("nothing strict in the save key")
	}
	for _, p := range k.Strict {
		if k.Parts[p] == "" {
			t.Fatalf("strict part %s has no hash", p)
		}
	}
	if k.Legacy == nil || len(k.Legacy.Parts) == 0 {
		t.Fatal("no legacy key for the saves of earlier builds")
	}
	for _, key := range []string{"ui.screen.save.damaged", "ui.screen.save.old_version"} {
		for _, locale := range r.world.Localization.Locales {
			if r.localText(locale, key, key) == key {
				t.Fatalf("no %s text for %s", locale, key)
			}
		}
	}
}

// What the key leaves out as not read at all, the server does not decode: world.json without it decodes the same.
func TestSaveKeyUnreadPartsAreNotDecoded(t *testing.T) {
	// both sides go through the same compact re-encoding, so raw JSON the server keeps as is compares by its bytes
	decode := func(tree any) worldData {
		t.Helper()
		data, err := json.Marshal(tree)
		if err != nil {
			t.Fatal(err)
		}
		var w worldData
		if err := json.Unmarshal(data, &w); err != nil {
			t.Fatal(err)
		}
		return w
	}
	read := func() any {
		var tree any
		d := json.NewDecoder(bytes.NewReader(compiledJSON))
		d.UseNumber()
		if err := d.Decode(&tree); err != nil {
			t.Fatal(err)
		}
		return tree
	}
	whole := decode(read())
	if len(whole.SaveKey.Unread) == 0 {
		t.Fatal("the save key leaves nothing out unread")
	}
	tree := read()
	for _, path := range whole.SaveKey.Unread {
		if unreadRemove(tree, strings.Split(path, "/")) == 0 {
			t.Fatalf("unread part %s matches nothing", path)
		}
	}
	without := decode(tree)
	if !reflect.DeepEqual(whole, without) {
		v, w := reflect.ValueOf(whole), reflect.ValueOf(without)
		for i := 0; i < v.NumField(); i++ {
			if !reflect.DeepEqual(v.Field(i).Interface(), w.Field(i).Interface()) {
				t.Errorf("the server decodes what the save key calls unread, in %s", v.Type().Field(i).Name)
			}
		}
		t.FailNow()
	}
}

func unreadRemove(v any, segs []string) int {
	if len(segs) == 0 {
		return 0
	}
	seg, rest := segs[0], segs[1:]
	n := 0
	if seg == "**" {
		n += unreadRemove(v, rest)
		switch x := v.(type) {
		case map[string]any:
			for _, child := range x {
				n += unreadRemove(child, segs)
			}
		case []any:
			for _, child := range x {
				n += unreadRemove(child, segs)
			}
		}
		return n
	}
	switch x := v.(type) {
	case map[string]any:
		if len(rest) == 0 {
			if seg == "*" {
				n = len(x)
				for k := range x {
					delete(x, k)
				}
				return n
			}
			if _, ok := x[seg]; ok {
				delete(x, seg)
				return 1
			}
			return 0
		}
		if seg == "*" {
			for _, child := range x {
				n += unreadRemove(child, rest)
			}
			return n
		}
		if child, ok := x[seg]; ok {
			return unreadRemove(child, rest)
		}
	case []any:
		if seg != "*" || len(rest) == 0 {
			return 0
		}
		for _, child := range x {
			n += unreadRemove(child, rest)
		}
	}
	return n
}

// Every real save of the corpus loads in this build and its world runs on.
func TestSaveCorpusLoadsAndRuns(t *testing.T) {
	corpus := saveCorpus(t)
	for _, name := range saveCorpusNames(corpus) {
		r, slot := corpusRuntime(t, corpus[name])
		if _, _, err := r.storageRuntime().readSave(slot); err != nil {
			t.Fatalf("%s: %s", name, corpusRefusal(strings.Split(name, "/")[0], err))
		}
		loadAndRun(t, r, slot, name)
	}
}

// A patch of the world's data that the saved state names only by checked ids: the corpus loads and runs.
func TestSaveCorpusSurvivesAdditiveContent(t *testing.T) {
	corpus := saveCorpus(t)
	changes := map[string]struct {
		parts  []string
		change func(t *testing.T, w *worldData)
	}{
		"one more goods item": {[]string{"inventory"}, func(t *testing.T, w *worldData) {
			ids := make([]string, 0, len(w.Inventory.Definitions))
			for id, d := range w.Inventory.Definitions {
				if d.Carrier == "physical" && d.Currency == "" && d.ContainerVolume == 0 {
					ids = append(ids, id)
				}
			}
			sort.Strings(ids)
			if len(ids) == 0 {
				t.Fatal("no physical goods definition to copy")
			}
			d := w.Inventory.Definitions[ids[0]]
			d.ID = "item.save_compat_new_goods"
			d.Name = "Новый товар"
			w.Inventory.Definitions[d.ID] = d
		}},
		"a tuned number": {[]string{"vending"}, func(t *testing.T, w *worldData) {
			if w.Vending.ServingTicks < 1 {
				t.Fatal("no vending serving time to tune")
			}
			w.Vending.ServingTicks++
		}},
	}
	names := make([]string, 0, len(changes))
	for name := range changes {
		names = append(names, name)
	}
	sort.Strings(names)
	for _, change := range names {
		for _, name := range saveCorpusNames(corpus) {
			r, slot := corpusRuntime(t, corpus[name])
			c := changes[change]
			changeWorld(r, func(w *worldData) { c.change(t, w) })
			changedKey(r, c.parts...)
			if _, _, err := r.storageRuntime().readSave(slot); err != nil {
				t.Fatalf("%s, %s: refused: %v", change, name, err)
			}
			loadAndRun(t, r, slot, change+", "+name)
		}
	}
}

// growthTrader is the id of the resident the growth tests add: a copy of a trader of the market with his own wallet,
// stall stores and stock (saves growth, owner 20.11).
const growthTrader = "char.save_growth_new_trader"

// addTrader adds to both worlds of r a new resident copied from a trader of the content: his day, his practice, his own
// account, actor store, stall stores beside the original's and the stock of the original's sources in them. It returns
// the id of the trader copied.
func addTrader(t *testing.T, r *Runtime) string {
	t.Helper()
	m := r.world.Inventory
	owner := ""
	for _, src := range m.Sources {
		if st, ok := m.Stores[src.Location.Store]; ok && src.Location.Kind == "store" && st.Owner != "" && st.Anchor.Kind == "world" && r.world.Life.Person(st.Owner) != nil && st.Owner != playerActorID {
			if owner == "" || st.Owner < owner {
				owner = st.Owner
			}
		}
	}
	if owner == "" {
		t.Fatal("no trader with stock in the content")
	}
	changeWorld(r, func(w *worldData) {
		var person behavior.LifePerson
		for _, p := range w.Life.Actors {
			if p.ID == owner {
				person = p
			}
		}
		person.ID = growthTrader
		w.Life.Actors = append(append([]behavior.LifePerson(nil), w.Life.Actors...), person)
		if p, ok := w.Life.Development.Profiles[owner]; ok {
			w.Life.Development.Profiles[growthTrader] = p
		}
		m := &w.Inventory
		m.Actors[growthTrader], m.Owners[growthTrader] = true, true
		actorStore := "actor/" + growthTrader
		m.Stores[actorStore] = invStore(actorStore, growthTrader, m.Stores["actor/"+owner])
		for _, key := range sortedAccountKeys(m.Accounts) {
			if a := m.Accounts[key]; a.Owner == owner && a.Currency == w.Life.Brain.Currency {
				a.ID, a.Owner = "account.save_growth", growthTrader
				m.Accounts[a.ID] = a
				break
			}
		}
		var sources []inv.Source
		for _, src := range m.Sources {
			st, ok := m.Stores[src.Location.Store]
			if src.Location.Kind != "store" || !ok || st.Owner != owner || st.Anchor.Kind != "world" {
				continue
			}
			store := src.Location.Store + ".growth"
			m.Stores[store] = invStore(store, growthTrader, st)
			src.ID, src.Owner, src.Location.Store = src.ID+".growth", growthTrader, store
			sources = append(sources, src)
		}
		m.Sources = append(append([]inv.Source(nil), m.Sources...), sources...)
	})
	return owner
}

// One more resident (a new trader) is additive for a save now: on load he joins the saved world at his hour, with his
// wallet, stores and stock as a new game creates them, and the world runs and saves on. Nothing the save had changes.
func TestSaveCorpusGrowsANewResident(t *testing.T) {
	corpus := saveCorpus(t)
	for _, name := range saveCorpusNames(corpus) {
		r, slot := corpusRuntime(t, corpus[name])
		before, _, err := r.storageRuntime().readSave(slot)
		if err != nil {
			t.Fatal(err)
		}
		owner := addTrader(t, r)
		changedKey(r, "life", "inventory")
		s, _, err := r.storageRuntime().readSave(slot)
		if err != nil {
			t.Fatalf("%s: a new resident: %v", name, err)
		}
		// the growth is the same on every load of the same file
		if twice, _, err := r.storageRuntime().readSave(slot); err != nil || !reflect.DeepEqual(twice, s) {
			t.Fatalf("%s: a second load of the old save differs: %v", name, err)
		}
		// the growth leaves the game's own check value alone: an old save's derived value is the same with or without it
		if s.CheckSeed == 0 || s.CheckSeed != before.CheckSeed {
			t.Fatalf("%s: check value %d after the growth, %d without", name, s.CheckSeed, before.CheckSeed)
		}
		a := s.Life.Actor(growthTrader)
		if a == nil || len(s.Life.Actors) != len(before.Life.Actors)+1 {
			t.Fatalf("%s: the new trader did not join", name)
		}
		// he stands where nothing the save knows stands: its people and the host's bodies (walkers, cabinet, convoys)
		if a.OnFloor() {
			host := (&Runtime{world: r.world, state: s}).walkersDynamic(true, true)
			if host[a.Level][a.Position] || s.Life.BlockedCells(a.Level, a.ID)[a.Position] {
				t.Fatalf("%s: the new trader stands on a taken cell %v", name, a.Position)
			}
		}
		for _, b := range before.Life.Actors {
			if g := s.Life.Actor(b.ID); g == nil || !reflect.DeepEqual(*g, b) {
				t.Fatalf("%s: %s changed in the growth", name, b.ID)
			}
		}
		for id, item := range before.Inventory.Items {
			if !reflect.DeepEqual(s.Inventory.Items[id], item) {
				t.Fatalf("%s: thing %s changed in the growth", name, id)
			}
		}
		added, money := 0, int64(0)
		for id, item := range s.Inventory.Items {
			if _, had := before.Inventory.Items[id]; !had {
				if item.Owner != growthTrader && item.Location.Store != "actor/"+growthTrader {
					t.Fatalf("%s: %s is not the new trader's", name, id)
				}
				added++
			}
		}
		for id, acc := range s.Inventory.Accounts {
			if _, had := before.Inventory.Accounts[id]; !had {
				money += acc.Balance
			}
		}
		if added == 0 || s.Inventory.Accounts["account.save_growth"].Balance != r.world.Inventory.Accounts["account.save_growth"].Balance+r.world.Life.Brain.InitialBalance ||
			s.NPCEconomy.InitialSource != before.NPCEconomy.InitialSource+r.world.Life.Brain.InitialBalance || money != s.Inventory.Accounts["account.save_growth"].Balance {
			t.Fatalf("%s: the trader's stock %d, wallet %d, initial source %d -> %d", name, added, s.Inventory.Accounts["account.save_growth"].Balance, before.NPCEconomy.InitialSource, s.NPCEconomy.InitialSource)
		}
		if _, ok := s.Life.Development.Actors[growthTrader]; !ok && r.world.Life.Development.Profiles[owner].Skills != nil {
			t.Fatalf("%s: the new trader has no practice", name)
		}
		loadAndRun(t, r, slot, name+" with a new trader")
		if r.state.Life.Actor(growthTrader) == nil {
			t.Fatalf("%s: the new trader is gone after running", name)
		}
		// his save loads again in the same build, without his things twice
		again := r.world.Config.SaveSlots[1]
		grown, _, err := r.storageRuntime().readSave(again)
		if err != nil || len(grown.Life.Actors) != len(s.Life.Actors) {
			t.Fatalf("%s: the grown world's own save: %v", name, err)
		}
	}
}

// The real case (saves growth): saves written by a build whose content had no street musician yet
// (testdata/save-corpus/growth-no-musician) load in this content with the musician grown into them, his wallet and his
// things, and the line in save-problems.log says so.
func TestSaveCorpusGrowsTheMusician(t *testing.T) {
	corpus := saveCorpus(t)
	grown := 0
	for _, name := range saveCorpusNames(corpus) {
		if !strings.HasPrefix(name, "growth-no-musician/") {
			continue
		}
		r, slot := corpusRuntime(t, corpus[name])
		if r.world.Busker.Actor == "" {
			t.Skip("the content has no musician")
		}
		var file saveFile
		if err := json.Unmarshal(corpus[name], &file); err != nil {
			t.Fatal(err)
		}
		var before state
		if err := json.Unmarshal(file.State, &before); err != nil {
			t.Fatal(err)
		}
		if before.Life.Actor(r.world.Busker.Actor) != nil {
			t.Fatalf("%s already has the musician", name)
		}
		s, _, err := r.storageRuntime().readSave(slot)
		if err != nil {
			t.Fatalf("%s: %v", name, err)
		}
		if s.Life.Actor(r.world.Busker.Actor) == nil || len(s.Life.Actors) != len(r.world.Life.Actors) {
			t.Fatalf("%s: the musician did not join", name)
		}
		if _, ok := s.Inventory.Accounts[r.world.Busker.Account]; !ok {
			t.Fatalf("%s: the musician has no account", name)
		}
		log, _ := os.ReadFile(filepath.Join(r.data, saveProblemLog))
		if !strings.Contains(string(log), "older save grown") || !strings.Contains(string(log), r.world.Busker.Actor) {
			t.Fatalf("%s: no growth line in the log: %s", name, log)
		}
		loadAndRun(t, r, slot, name)
		grown++
	}
	if grown == 0 {
		t.Fatal("no growth-no-musician corpus")
	}
}

// A save of the earlier record form still refuses, with a clear reason, when what it refers into by position changed:
// a saved resident's steps (by his id), or, for a key no alias covers, the steps of all residents as one.
func TestSaveOldFormStillRefusesAChangedStrictPart(t *testing.T) {
	corpus := saveCorpus(t)
	for _, name := range saveCorpusNames(corpus) {
		if strings.HasPrefix(name, "growth-") {
			continue
		}
		r, slot := corpusRuntime(t, corpus[name])
		var each string
		for p := range r.world.SaveKey.Parts {
			if strings.HasPrefix(p, "life/actors/*/steps/*/activity[") && !strings.Contains(p, playerActorID) {
				if each == "" || p < each {
					each = p
				}
			}
		}
		changedKey(r, each)
		_, _, err := r.storageRuntime().readSave(slot)
		var problem saveProblem
		if err == nil || !errors.As(err, &problem) || problem.damaged || !strings.Contains(problem.reason, each) {
			t.Fatalf("%s: a resident's steps changed (%s): %v", name, each, err)
		}
		r, slot = corpusRuntime(t, corpus[name])
		changeWorld(r, func(w *worldData) {
			if w.SaveKey.Legacy != nil {
				legacy := *w.SaveKey.Legacy
				legacy.Aliases = nil
				w.SaveKey.Legacy = &legacy
			}
		})
		var file saveFile
		if err := json.Unmarshal(corpus[name], &file); err != nil {
			t.Fatal(err)
		}
		if file.SaveKey == nil {
			continue // a save without a key is read with the legacy record itself
		}
		changedKey(r, "life/actors/*/steps/*/activity")
		_, _, err = r.storageRuntime().readSave(slot)
		if err == nil || !errors.As(err, &problem) || problem.damaged || !strings.Contains(problem.reason, "life/actors/*/steps/*/activity") {
			t.Fatalf("%s: the steps as one changed for a key without alias: %v", name, err)
		}
	}
}

// A resident the content lost is no growth: the save refuses as from an older version and names him.
func TestSaveCorpusWithAResidentGoneRefusesWithHisName(t *testing.T) {
	corpus := saveCorpus(t)
	for _, name := range saveCorpusNames(corpus) {
		r, slot := corpusRuntime(t, corpus[name])
		gone := ""
		changeWorld(r, func(w *worldData) {
			actors := []behavior.LifePerson{}
			for _, p := range w.Life.Actors {
				if gone == "" && p.ID != playerActorID {
					gone = p.ID
					continue
				}
				if p.ID != gone {
					actors = append(actors, p)
				}
			}
			w.Life.Actors = actors
		})
		changedKey(r, "life")
		_, _, err := r.storageRuntime().readSave(slot)
		var problem saveProblem
		if err == nil || !errors.As(err, &problem) || problem.damaged || !strings.Contains(problem.reason, gone) {
			t.Fatalf("%s: a resident gone (%s): %v", name, gone, err)
		}
	}
}

func invStore(id, owner string, from inv.Store) inv.Store {
	from.ID, from.Owner = id, owner
	if from.Anchor.Kind == "actor" {
		from.Anchor.Actor = owner
	}
	return from
}

// A content id the save uses is gone: the load refuses as from an older version and says which.
func TestSaveRefusesARemovedID(t *testing.T) {
	corpus := saveCorpus(t)
	for _, name := range saveCorpusNames(corpus) {
		r, slot := corpusRuntime(t, corpus[name])
		s, _, err := r.storageRuntime().readSave(slot)
		if err != nil {
			t.Fatal(err)
		}
		ids := make([]string, 0)
		for id, i := range s.Inventory.Items {
			if i.Owner == playerActorID {
				ids = append(ids, id)
			}
		}
		sort.Strings(ids)
		if len(ids) == 0 {
			t.Fatalf("%s: the hero owns nothing", name)
		}
		item := s.Inventory.Items[ids[0]]
		changeWorld(r, func(w *worldData) {
			next := make(map[string]inv.Definition, len(w.Inventory.Definitions))
			for id, d := range w.Inventory.Definitions {
				if id != item.Definition {
					next[id] = d
				}
			}
			w.Inventory.Definitions = next
		})
		changedKey(r, "inventory")
		_, _, err = r.storageRuntime().readSave(slot)
		var problem saveProblem
		if err == nil || !errors.As(err, &problem) || problem.damaged || !strings.Contains(problem.reason, item.ID) {
			t.Fatalf("%s: removed definition %s of %s: %v", name, item.Definition, item.ID, err)
		}
	}
}

// A changed strict part refuses with its name; the card says «from an older version», a broken file «damaged», and
// the reason goes to save-problems.log in the data folder.
func TestSaveProblemsSayOlderOrDamaged(t *testing.T) {
	corpus := saveCorpus(t)
	// a save whose record knows every strict part of this build (a growth corpus lacks the parts new since it)
	name := ""
	for _, n := range saveCorpusNames(corpus) {
		if name == "" && !strings.HasPrefix(n, "growth-") {
			name = n
		}
	}
	r, slot := corpusRuntime(t, corpus[name])
	part := r.world.SaveKey.Strict[0]
	changedKey(r, part)
	_, _, err := r.storageRuntime().readSave(slot)
	var problem saveProblem
	if err == nil || !errors.As(err, &problem) || problem.damaged || !strings.Contains(problem.reason, part) {
		t.Fatalf("a changed strict part %s: %v", part, err)
	}
	broken := append([]byte(nil), corpus[name]...)
	at := bytes.Index(broken, []byte(`"State":`)) + 200
	broken[at] ^= 1
	damaged := r.world.Config.SaveSlots[1]
	if err := os.WriteFile(r.slotFile(damaged), broken, 0600); err != nil {
		t.Fatal(err)
	}
	cut := r.world.Config.SaveSlots[2]
	if err := os.WriteFile(r.slotFile(cut), corpus[name][:len(corpus[name])/2], 0600); err != nil {
		t.Fatal(err)
	}
	want := map[string]string{slot: "ui.screen.save.old_version", damaged: "ui.screen.save.damaged", cut: "ui.screen.save.damaged"}
	storage := r.storageRuntime()
	for _, s := range storage.readSlots() {
		if key, ok := want[s.Id]; ok {
			if !s.Exists || s.Valid || s.Problem != key {
				t.Fatalf("slot %s: problem %q, want %q", s.Id, s.Problem, key)
			}
			delete(want, s.Id)
		}
	}
	if len(want) != 0 {
		t.Fatalf("slots not listed: %v", want)
	}
	storage.readSlots()
	log, err := os.ReadFile(filepath.Join(r.data, saveProblemLog))
	if err != nil || !strings.Contains(string(log), part) || !strings.Contains(string(log), "checksum") || strings.Count(string(log), "\n") != 3 {
		t.Fatalf("save-problems.log: %v\n%s", err, log)
	}
	c := &connection{locale: "ru", out: make(chan *pb.ServerMessage, 256), stop: make(chan struct{})}
	r.testCommand(c, loadRequest(r, "corpus.old", slot, ""))
	if a := answer(t, c, "corpus.old"); a.Ok || a.Message != r.localText("ru", "ui.screen.save.old_version", "") {
		t.Fatalf("the load of an older save says %q", a.Message)
	}
}

// Every hash of the legacy list still loads a save of its build: a v1 file without a key goes through the list and the
// legacy key.
func TestSaveLegacyContentHashesLoad(t *testing.T) {
	corpus := saveCorpus(t)
	var legacy []byte
	for _, name := range saveCorpusNames(corpus) {
		var file saveFile
		if err := json.Unmarshal(corpus[name], &file); err != nil {
			t.Fatal(err)
		}
		if file.SaveKey == nil && strings.HasSuffix(name, "/market-new") {
			legacy = corpus[name]
		}
	}
	if legacy == nil {
		t.Fatal("no save of an earlier build without a key in the corpus")
	}
	r, slot := corpusRuntime(t, legacy)
	hashes := r.world.Config.SaveCompatibleHashes
	if len(hashes) == 0 {
		t.Fatal("no legacy content hashes")
	}
	for _, hash := range append(hashes, "not-an-earlier-build") {
		var file map[string]json.RawMessage
		if err := json.Unmarshal(legacy, &file); err != nil {
			t.Fatal(err)
		}
		file["ContentHash"], _ = json.Marshal(hash)
		data, _ := json.Marshal(file)
		if err := os.WriteFile(r.slotFile(slot), data, 0600); err != nil {
			t.Fatal(err)
		}
		_, _, err := r.storageRuntime().readSave(slot)
		if hash == "not-an-earlier-build" {
			var problem saveProblem
			if err == nil || !errors.As(err, &problem) || problem.damaged {
				t.Fatalf("an unknown earlier build: %v", err)
			}
			continue
		}
		if err != nil {
			t.Fatalf("legacy content %s: %v", hash, err)
		}
	}
}

// TestWriteSaveCorpus writes real saves of this build (ANG_SAVE_CORPUS_WRITE=<dir>): a new game in the market, mid-day
// after buying and walking, a quick save and an autosave of it, after a level change, in a fight with wounds.
func TestWriteSaveCorpus(t *testing.T) {
	out := os.Getenv("ANG_SAVE_CORPUS_WRITE")
	if out == "" {
		t.Skip("set ANG_SAVE_CORPUS_WRITE to a directory to write the save corpus of this build")
	}
	if err := os.MkdirAll(out, 0o755); err != nil {
		t.Fatal(err)
	}
	keep := func(r *Runtime, slot, name string) {
		t.Helper()
		data, err := os.ReadFile(r.slotFile(slot))
		if err != nil {
			t.Fatal(err)
		}
		if _, _, err := r.storageRuntime().readSave(slot); err != nil {
			t.Fatalf("%s does not load in its own build: %v", name, err)
		}
		var buf bytes.Buffer
		z, _ := gzip.NewWriterLevel(&buf, gzip.BestCompression)
		if _, err := z.Write(data); err != nil {
			t.Fatal(err)
		}
		if err := z.Close(); err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(filepath.Join(out, name+".json.gz"), buf.Bytes(), 0o644); err != nil {
			t.Fatal(err)
		}
		t.Logf("%s: %d bytes, tick %d, level %s, life %d s", name, len(data), r.state.Tick, r.currentLevel(), r.state.Life.Seconds)
	}
	drain := func(c *connection) {
		for len(c.out) > 0 {
			<-c.out
		}
	}
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	c := &connection{locale: "ru", out: make(chan *pb.ServerMessage, 4096), stop: make(chan struct{})}
	// a new game as the client starts it (link_controls.gd): seed, name, scenario life, then to the market
	r.testCommand(c, input{msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "corpus.new", Seed: 20261107, PlayerName: "Godot", Scenario: "life"}}}})
	if a := answer(t, c, "corpus.new"); !a.Ok {
		t.Fatal(a.Message)
	}
	market := "level.c7_market"
	if r.currentLevel() != market {
		if err := r.lifeCommand(&pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: "corpus.goto.market", Action: "goto", Destination: market}); err != nil {
			t.Fatal(err)
		}
	}
	// the client stops the hero where he stands once in the market (link_controls.gd: a move to his own cell)
	at := location(r.state.Life.Actor(playerActorID).Position)
	r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: c.lastMoveSeq + 1, X: int32(at.X), Y: int32(at.Y)})
	for i := 0; i < 50; i++ {
		r.step()
	}
	drain(c)
	if r.currentLevel() != market {
		t.Fatalf("not in the market: %s", r.currentLevel())
	}
	manual := r.world.Config.SaveSlots
	if err := r.writeSave(manual[0], r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	keep(r, manual[0], "market-new")

	// mid-day: the time runs at 30 s a tick until noon; the hero buys at a vending terminal and walks off
	r.state.Life.SecondsPerTick = 30
	for i := 0; i < 20000 && r.state.Life.Seconds%86400 < 12*3600; i++ {
		r.step()
		drain(c)
	}
	r.state.Life.SecondsPerTick = 1
	if r.currentLevel() != market {
		t.Fatalf("the hero left the market before noon: %s", r.currentLevel())
	}
	v := r.world.Vending
	if len(v.Units) == 0 {
		t.Fatal("no vending terminal in the market")
	}
	hero := r.state.Life.Actor(playerActorID)
	model := r.state.Life.GateModel(r.world.Life)
	space := model.Space(hero.Level, r.state.Life.BlockedCells(hero.Level, hero.ID))
	bought := false
	for _, unit := range v.Units {
		stand := behavior.Cell{X: -1}
		for _, a := range unit.Approach {
			cell := behavior.Cell{X: a.X, Y: a.Y}
			if r.world.Life.Walks(hero.Level, cell) && !space.Blocked[cell] {
				stand = cell
				break
			}
		}
		if stand.X < 0 {
			continue
		}
		hero.Position, hero.Goal = stand, stand
		hero.Path, hero.PendingPath, hero.Body = nil, nil, nil
		hero.Manual, hero.Arrived = true, true
		hero.OverrideLevel, hero.OverrideEdge = "", ""
		hero.MoveStartTick = r.lifeMotionTick()
		r.state.Life.EnsureHeroBody(model)
		r.syncLifeHero()
		r.updateLifeExploration()
		ids := []string{}
		for id, i := range r.state.Inventory.Items {
			if i.Location.Kind == "store" && i.Location.Store == unit.DisplayStore && i.ForSale {
				ids = append(ids, id)
			}
		}
		sort.Strings(ids)
		for _, id := range ids {
			item := r.state.Inventory.Items[id]
			if inventoryRequest(t, r, &pb.PocInventoryCommand{Epoch: r.state.Epoch, Sequence: r.state.Inventory.Cursors[playerActorID].Sequence + 1, Action: "buy", ItemId: item.ID, Quantity: 1, ExpectedRevision: item.Revision}) {
				t.Logf("bought %s at %s", item.Definition, unit.ID)
				bought = true
				break
			}
		}
		if bought {
			break
		}
	}
	if !bought {
		t.Fatal("nothing bought at a vending terminal")
	}
	for i := 0; i < 20; i++ {
		r.step()
	}
	drain(c)
	from := location(r.state.Life.Actor(playerActorID).Position)
	moved := false
	for d := 6; d <= 14 && !moved; d++ {
		for _, to := range []point{{from.X + d, from.Y}, {from.X - d, from.Y}, {from.X, from.Y + d}, {from.X, from.Y - d}} {
			seq := c.lastMoveSeq + 1
			r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: seq, X: int32(to.X), Y: int32(to.Y)})
			for len(c.out) > 0 {
				if m := (<-c.out).GetMoveResult(); m != nil && m.InputSeq == seq && m.Ok {
					moved = true
				}
			}
			if moved {
				break
			}
		}
	}
	if !moved {
		t.Fatal("the hero found nowhere to walk")
	}
	for i := 0; i < 3; i++ {
		r.step()
	}
	drain(c)
	if err := r.writeSave(manual[1], r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	keep(r, manual[1], "market-midday")
	r.testCommand(c, saveRequest(r, "corpus.quick", "", "quick"))
	if a := answer(t, c, "corpus.quick"); !a.Ok {
		t.Fatal(a.Message)
	}
	keep(r, r.world.Config.QuickSave.Slots[0], "market-quick")
	time.Sleep(3 * time.Millisecond)
	r.saves.playedNS = r.world.Config.AutoSave.EveryPlayMinutes * int64(time.Minute)
	r.autosaveWhenDue()
	drainDisk(r)
	drain(c)
	keep(r, r.world.Config.AutoSave.Slots[0], "market-auto")

	// a level change: the hero goes to another level of the region and arrives
	known := []string{}
	for id := range r.world.Life.Locations {
		if id != market && r.regionCanGoto(id) {
			known = append(known, id)
		}
	}
	sort.Strings(known)
	saved := r.snapshotState()
	changed := false
	for _, level := range known {
		if err := r.lifeCommand(&pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: "corpus.goto." + level, Action: "goto", Destination: level}); err == nil {
			for i := 0; i < 4000 && (r.currentLevel() != level || r.state.Life.Actor(playerActorID).Trip != nil); i++ {
				r.step()
				drain(c)
			}
		}
		if r.currentLevel() == level && r.state.Life.Actor(playerActorID).Trip == nil {
			changed = true
			break
		}
		r.state = saved
		saved = r.snapshotState()
	}
	if !changed {
		t.Fatalf("no level change from the market among %v", known)
	}
	for i := 0; i < 30; i++ {
		r.step()
	}
	drain(c)
	if err := r.writeSave(manual[2], r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	keep(r, manual[2], "level-change")

	// a fight with wounds: the market save loaded, the hero beside a resident, blows until someone is wounded
	f, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	fc := &connection{locale: "ru", out: make(chan *pb.ServerMessage, 4096), stop: make(chan struct{})}
	data, err := os.ReadFile(r.slotFile(manual[0]))
	if err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(f.slotFile(manual[0]), data, 0o600); err != nil {
		t.Fatal(err)
	}
	f.testCommand(fc, loadRequest(f, "corpus.fight.load", manual[0], ""))
	if a := answer(t, fc, "corpus.fight.load"); !a.Ok {
		t.Fatal(a.Message)
	}
	f.state.Life.SecondsPerTick = 1
	fh := f.state.Life.Actor(playerActorID)
	fm := f.state.Life.GateModel(f.world.Life)
	fs := fm.Space(fh.Level, f.state.Life.BlockedCells(fh.Level, fh.ID))
	residents := []string{}
	for _, a := range f.state.Life.Actors {
		if a.ID != fh.ID && a.Level == fh.Level && a.OnFloor() {
			residents = append(residents, a.ID)
		}
	}
	sort.Strings(residents)
	target := ""
	for _, id := range residents {
		ta := f.state.Life.Actor(id)
		for _, d := range []behavior.Cell{{X: 1}, {X: -1}, {Y: 1}, {Y: -1}} {
			cell := behavior.Cell{X: ta.Position.X + d.X, Y: ta.Position.Y + d.Y}
			if cell.X < 0 || cell.Y < 0 || cell.X >= fs.Width || cell.Y >= fs.Height || !fs.Walkable(cell) || fs.Blocked[cell] || f.combatDistance(cell, ta.Position) > f.world.CombatRuntime.Profiles["hero"].Weapon.RangeMM || !f.sightLine(location(cell), location(ta.Position)) {
				continue
			}
			fh.Position, fh.Goal = cell, cell
			fh.Path, fh.PendingPath, fh.Body = nil, nil, nil
			fh.Manual, fh.Arrived = true, true
			fh.OverrideLevel, fh.OverrideEdge = "", ""
			fh.MoveStartTick = f.lifeMotionTick()
			f.state.Life.EnsureHeroBody(fm)
			f.syncLifeHero()
			f.updateLifeExploration()
			target = id
			break
		}
		if target != "" {
			break
		}
	}
	if target == "" {
		t.Fatal("no resident to fight")
	}
	combatStart(t, f, fc, target)
	wounded := func() bool {
		for _, b := range f.state.Wounds.Bodies {
			if len(b.Wounds) > 0 {
				return true
			}
		}
		return false
	}
	for round := 0; round < 60 && !wounded() && f.state.Combat.Active; round++ {
		if cur := f.state.Combat.Current(); cur != nil && cur.ID == playerActorID {
			id := "corpus.attack." + string(rune('a'+round%26)) + string(rune('a'+round/26))
			if res, _ := combatWire(t, f, fc, &pb.PocCombatCommand{RequestId: id, Action: "attack", TargetId: target, ExpectedTurn: f.state.Combat.Turn}); !res.Ok {
				combatWire(t, f, fc, &pb.PocCombatCommand{RequestId: id + ".end", Action: "end", ExpectedTurn: f.state.Combat.Turn})
			}
		} else {
			f.step()
			drain(fc)
		}
	}
	if !wounded() || !f.state.Combat.Active {
		t.Fatal("no fight with wounds")
	}
	if err := f.writeSave(manual[1], f.snapshotState()); err != nil {
		t.Fatal(err)
	}
	keep(f, manual[1], "fight-wounds")
}
