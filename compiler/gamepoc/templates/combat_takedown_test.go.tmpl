var combatM2Report = flag.String("combat-m2-report", "", "directory for the moment 2 seeded fixtures")

const throatMode = "throat_cut"

// The hero walks on real commands until he arrives or a fight starts.
func throatWalk(t *testing.T, r *Runtime, c *connection, to behavior.Cell, mode string) {
	t.Helper()
	if mode != "" {
		if err := r.stealthCommand(mode); err != nil {
			t.Fatal(err)
		}
	}
	r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: uint64(r.state.Tick) + 1, X: int32(to.X), Y: int32(to.Y)})
	playableDrain(c)
	for frame := 0; frame < 2400 && !r.heroInCombat(); frame++ {
		h := r.state.Life.Actor(playerActorID)
		if h.Position == to && (h.Body == nil || !h.Body.Moving) {
			return
		}
		r.step()
	}
}

func throatFixture(t *testing.T) (*Runtime, *connection, playableSceneDefinition) {
	t.Helper()
	r, c, d := combatEpisodeFixture(t, "combat_throat", "ru")
	for frame := 0; frame < 10; frame++ {
		r.step()
	}
	if r.state.Life.Actor(d.Guard).Position != d.GuardRoute[0] {
		t.Fatalf("the watchman left his post: %+v", r.state.Life.Actor(d.Guard).Position)
	}
	return r, c, d
}

// bodySeconds: the body seconds of the wound and of the fall, from the events of the encounter.
func throatSeconds(s behavior.CombatState, target string) (int64, int64) {
	wound, down := int64(-1), int64(-1)
	for _, e := range s.Events {
		if e.Type == "wound" && e.TargetID == target && wound < 0 {
			wound = e.BodySecond
		}
		if e.Type == "down" && e.TargetID == target && down < 0 {
			down = e.BodySecond
		}
	}
	return wound, down
}

var throatStandoff = behavior.Cell{X: 21, Y: 15}

func TestThroatCrouchedAndUprightFromStealth(t *testing.T) {
	for _, mode := range []string{"on", "upright"} {
		t.Run(mode, func(t *testing.T) {
			r, c, d := throatFixture(t)
			throatWalk(t, r, c, throatStandoff, mode)
			if r.heroInCombat() {
				t.Fatalf("noticed on a quiet approach (%s)", mode)
			}
			h := r.state.Life.Actor(playerActorID)
			if want := mode == "upright"; h.SneakUpright != want {
				t.Fatalf("upright flag %v", h.SneakUpright)
			}
			if err := r.takedownCheck(playerActorID, d.Guard, throatMode); err != nil {
				t.Fatalf("refused at the stand-off: %v", err)
			}
			msg := &pb.PocGameState{}
			r.appendTakedownOptions(msg, "ru")
			if len(msg.Takedowns) != 1 || !msg.Takedowns[0].Enabled || !strings.Contains(strings.ToLower(msg.Takedowns[0].Label), "горло") {
				t.Fatalf("the offer: %+v", msg.Takedowns)
			}
			if err := r.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: d.Guard, Mode: throatMode}); err != nil {
				t.Fatal(err)
			}
			s := r.state.Combat
			if s.Active || !strings.HasPrefix(s.Winner, "player") {
				t.Fatalf("the encounter did not end with the hold: active %v winner %q", s.Active, s.Winner)
			}
			wound, down := throatSeconds(s, d.Guard)
			if wound < 0 || down < 0 || down-wound < 2 || down-wound > 3 {
				t.Fatalf("grab to limp: %d .. %d", wound, down)
			}
			stance, hold := "", 0
			shifted := ""
			parried := false
			for _, e := range s.Events {
				if e.Type == "parry" {
					parried = true
				}
				if e.Type == "hold" {
					if !e.Hit {
						t.Fatal("the hold was interrupted with nobody around")
					}
					stance, hold = e.Mode, e.Amount
				}
				if e.Type == "fall_shift" && e.ActorID == d.Guard {
					shifted = e.Mode
					if e.From != e.To {
						t.Fatal("the lowered body moved its server cell")
					}
				}
			}
			wantStance := map[string]string{"on": "crouch", "upright": "stand"}[mode]
			if stance != wantStance || hold != int(down-wound) || parried || shifted != "throat" {
				t.Fatalf("stance %s hold %d parried %v fall %q", stance, hold, parried, shifted)
			}
			// No instant death and no multiplier: the blood of the same wound model.
			guard := r.state.CombatRoster[d.Guard]
			body := combatBody(guard)
			if body.Dead || len(body.Wounds) != 1 || body.Wounds[0].Author != playerActorID {
				t.Fatalf("after the hold: %+v", body.Wounds)
			}
			deadAt := int64(0)
			for frame := 0; frame < 4000 && deadAt == 0; frame++ {
				r.step()
				if b := combatBody(r.state.CombatRoster[d.Guard]); b.Dead {
					deadAt = b.DeadAt
				}
			}
			if deadAt-wound < 100 || deadAt-wound > 240 {
				t.Fatalf("death %d s after the cut", deadAt-wound)
			}
			found := false
			for _, e := range r.state.WoundCrimes {
				found = found || e.Body == d.Guard && e.Culprit == playerActorID
			}
			if !found {
				t.Fatalf("the death is not on the author of the wound: %+v", r.state.WoundCrimes)
			}
		})
	}
}

// A normal walk is heard, the watchman turns and it is an ordinary fight: the same transition as ever, no technique on offer.
func TestThroatNoticedOnTheApproachIsAnOrdinaryFight(t *testing.T) {
	r, c, d := throatFixture(t)
	throatWalk(t, r, c, throatStandoff, "")
	if !r.heroInCombat() {
		t.Fatal("a normal walk up to the watchman stayed unnoticed")
	}
	for _, e := range r.state.Combat.Events {
		if e.Type == "hold" {
			t.Fatal("a held technique in an ordinary fight")
		}
	}
	found := false
	for _, o := range r.combatOptions("ru") {
		if o.Mode == throatMode {
			found = true
			if o.Enabled || o.Reason == "" {
				t.Fatalf("the fight row: %+v", o)
			}
		}
	}
	if !found {
		t.Fatal("no row with the reason in the fight panel")
	}
	if err := r.performCombatAction(playerActorID, &behavior.CombatAction{Type: "attack", TargetID: d.Guard, Mode: throatMode, BodyPart: "neck"}); err == nil {
		t.Fatal("a client command started the held technique in a fight")
	}
}

func TestThroatRefusals(t *testing.T) {
	r, _, d := throatFixture(t)
	h, g := r.state.Life.Actor(playerActorID), r.state.Life.Actor(d.Guard)
	put := func(x, y int) {
		h.Position = behavior.Cell{X: g.Position.X + x, Y: g.Position.Y + y}
		h.Body = nil
	}
	cases := []struct {
		x, y int
		key  string
	}{{2, -2, ""}, {1, -1, "error.takedown.near"}, {4, -4, "error.takedown.reach"}, {-2, 2, "error.takedown.noticed"}, {2, 2, "error.takedown.rear"}}
	for _, q := range cases {
		put(q.x, q.y)
		err := r.takedownCheck(playerActorID, d.Guard, throatMode)
		got := ""
		if refusal, ok := err.(textError); ok {
			got = refusal.Key
		}
		if got != q.key {
			t.Fatalf("at %d,%d: %q, want %q", q.x, q.y, got, q.key)
		}
	}
	put(2, -2)
	o := r.state.Stealth.Observers[d.Guard]
	o.Contact.HasSeen = true
	r.state.Stealth.Observers[d.Guard] = o
	if refusal, ok := r.takedownCheck(playerActorID, d.Guard, throatMode).(textError); !ok || refusal.Key != "error.takedown.noticed" {
		t.Fatalf("a watchman who has seen him: %v", refusal)
	}
	o.Contact.HasSeen = false
	r.state.Stealth.Observers[d.Guard] = o
	for _, id := range combatItemKeys(r.state.Inventory) {
		i := r.state.Inventory.Items[id]
		if i.Definition == "item.knife_simple" && i.Owner == playerActorID {
			i.Location.Slot = ""
			r.state.Inventory.Items[id] = i
		}
	}
	if refusal, ok := r.takedownCheck(playerActorID, d.Guard, throatMode).(textError); !ok || refusal.Key != "error.takedown.weapon.blade" {
		t.Fatalf("no blade in hand: %v", refusal)
	}
}

// «Interrupted»: the holder stops holding before the limp second. The wound stays, the ordinary carotid clock applies, the victim reacts by the wound rules.
func TestThroatInterruptedLeavesAWoundedDangerousTarget(t *testing.T) {
	for seed := int64(1); seed <= 40; seed++ {
		r, c, d := throatFixture(t)
		r.state.Seed = seed
		throatWalk(t, r, c, throatStandoff, "on")
		// The holder himself passes out on the next second: an arterial wound of his own whose clock runs out.
		hero := r.combatant(playerActorID, "player")
		body := combatBody(hero)
		if _, err := combatWounds.ApplyHit(&body, wounds.Hit{Author: d.Guard, Weapon: "item.knife_simple", Mode: "heavy", Zone: "neck", Depth: "deep", Structures: []string{"neck_skin", "carotid"}, Seed: seed}); err != nil {
			t.Fatal(err)
		}
		for i := range body.Wounds {
			for j := range body.Wounds[i].Bleeds {
				if body.Wounds[i].Bleeds[j].KnockoutAt > 0 {
					body.Wounds[i].Bleeds[j].KnockoutAt = body.Clock + 1
				}
			}
		}
		projectWoundBody(&hero, body)
		if r.state.CombatRoster == nil {
			r.state.CombatRoster = map[string]behavior.Combatant{}
		}
		r.state.CombatRoster[playerActorID] = hero
		r.storeWoundBody(hero)
		if err := r.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: d.Guard, Mode: throatMode}); err != nil {
			t.Fatal(err)
		}
		var hold *behavior.CombatEvent
		for i := range r.state.Combat.Events {
			if e := &r.state.Combat.Events[i]; e.Type == "hold" {
				hold = e
			}
		}
		if hold == nil || hold.Hit || hold.Amount != 1 {
			t.Fatalf("seed %d hold: %+v", seed, hold)
		}
		g := r.state.Combat.Actor(d.Guard)
		b := combatBody(*g)
		if b.Dead || !combatWounds.Status(b).Conscious || combatWounds.HoldSeconds(b) != 0 {
			t.Fatalf("seed %d: the released target: %+v", seed, combatWounds.Status(b))
		}
		if g.FightResponse == "held" {
			t.Fatalf("seed %d: still marked held", seed)
		}
		ko := int64(0)
		for i := int64(1); i <= 30 && ko == 0; i++ {
			combatWounds.Tick(&b, 1)
			if !combatWounds.Status(b).Conscious {
				ko = i
			}
		}
		if ko+int64(hold.Amount) < 8 || ko+int64(hold.Amount) > 15 {
			t.Fatalf("seed %d: the ordinary clock is gone: limp %d s after the cut", seed, ko+int64(hold.Amount))
		}
	}
}

// A third person who sees it and protects the victim breaks the hold; nobody near, nothing breaks it.
func TestThroatBreakerIsARealPersonNearby(t *testing.T) {
	r, _, d := throatFixture(t)
	h, g := r.state.Life.Actor(playerActorID), r.state.Life.Actor(d.Guard)
	h.Position = behavior.Cell{X: g.Position.X + 2, Y: g.Position.Y - 2}
	t0 := r.world.CombatRuntime.Rules.Techniques[throatMode]
	s := &behavior.CombatState{LevelID: d.Level, Actors: []behavior.Combatant{{ID: playerActorID, Position: h.Position}, {ID: d.Guard, Position: g.Position}}}
	if id := r.takedownBreaker(s, playerActorID, d.Guard, t0, 0); id != "" {
		t.Fatalf("a breaker out of nowhere: %s", id)
	}
	third := *g
	third.ID = "char.third_for_test"
	third.Position = behavior.Cell{X: h.Position.X + 1, Y: h.Position.Y + 1}
	r.state.Life.Actors = append(r.state.Life.Actors, third)
	r.world.CombatLife.Responders = map[string]combatResponder{third.ID: {Protect: []string{d.Guard}, Levels: []string{d.Level}}}
	if id := r.takedownBreaker(s, playerActorID, d.Guard, t0, 0); id != third.ID {
		t.Fatalf("the responder beside them did not break it: %q", id)
	}
	r.state.Life.Actor(third.ID).Position = behavior.Cell{X: h.Position.X + 8, Y: h.Position.Y}
	if id := r.takedownBreaker(s, playerActorID, d.Guard, t0, 0); id != "" {
		t.Fatalf("a breaker %s beyond the reach", id)
	}
}

// Two bodies do not enter each other: the exception of the two high castes is a flag in the data, off by default.
func TestBodyEntryExceptionIsOffUntilTheFlag(t *testing.T) {
	r, _, d := throatFixture(t)
	if r.world.CombatSpacing.HighCasteMayEnter {
		t.Fatal("the exception is on by default")
	}
	if r.combatEntersBodies(playerActorID) || r.combatEntersBodies(d.Guard) {
		t.Fatal("somebody enters bodies with the flag off")
	}
	r.world.CombatSpacing.HighCasteMayEnter = true
	r.world.CombatSpacing.HighCastes = []string{r.bodyChip(d.Guard)}
	if !r.combatEntersBodies(d.Guard) {
		t.Fatal("the flag is not read")
	}
	r.world.CombatSpacing.HighCastes = []string{"platinum"}
	if r.bodyChip(d.Guard) != "platinum" && r.combatEntersBodies(d.Guard) {
		t.Fatal("a caste outside the list enters")
	}
}

// The same rule for an NPC: an authored intention, the same check and command, the hero as the target.
func TestThroatByAnNPCFromAnAuthoredIntention(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_knife_npc", "ru")
	r.world.CombatLife.Aggressors = map[string][]string{}
	r.world.CombatLife.Takedowns = map[string]combatTakedownIntent{d.Guard: {Target: playerActorID, Technique: throatMode}}
	g := r.state.Life.Actor(d.Guard)
	// The hero walks away from the watchman, his back to him, and stops two cells off.
	h := r.state.Life.Actor(playerActorID)
	h.Position = behavior.Cell{X: g.Position.X + 6, Y: g.Position.Y - 6}
	h.Body = nil
	r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
	throatWalk(t, r, c, behavior.Cell{X: g.Position.X + 2, Y: g.Position.Y - 2}, "")
	if r.state.Combat.ID != "" {
		// walking away from him he may have reached the distance while still moving
		_ = c
	}
	r.state.Stealth.HeroFaceX, r.state.Stealth.HeroFaceY = .7071, -.7071
	r.state.Life.Actor(d.Guard).Position = behavior.Cell{X: r.state.Life.Actor(playerActorID).Position.X - 2, Y: r.state.Life.Actor(playerActorID).Position.Y + 2}
	if err := r.takedownCheck(d.Guard, playerActorID, throatMode); err != nil {
		t.Fatalf("the NPC's check: %v", err)
	}
	if err := r.combatLifeAfterFrame(); err != nil {
		t.Fatal(err)
	}
	if r.state.Combat.ID == "" {
		t.Fatal("the intention did not start anything")
	}
	wound, down := throatSeconds(r.state.Combat, playerActorID)
	if down-wound < 2 || down-wound > 3 {
		t.Fatalf("the hero as a target: %d .. %d", wound, down)
	}
	body := combatBody(*r.state.Combat.Actor(playerActorID))
	if len(body.Wounds) == 0 || body.Wounds[0].Author != d.Guard {
		t.Fatalf("the wound's author: %+v", body.Wounds)
	}
}

// Opt-in: one real save per outcome of the stand, the seed found by running the real commands headless. The Player loads the save and walks on its own.
func TestCombatMoment2Probes(t *testing.T) {
	if *combatM2Report == "" {
		t.Skip("opt-in moment 2 fixtures")
	}
	type want struct {
		Name, Mode string
		Hold       int
	}
	index := []map[string]any{}
	for _, q := range []want{{"2a", "on", 3}, {"2b", "upright", 3}, {"2a_two", "on", 2}, {"2b_two", "upright", 2}, {"noticed", "", 0}} {
		found := false
		for seed := int64(1); seed <= 400 && !found; seed++ {
			r, c, d := throatFixture(t)
			r.state.Seed = seed
			base := r.snapshotState()
			throatWalk(t, r, c, throatStandoff, q.Mode)
			events := []behavior.CombatEvent{}
			hold := 0
			if q.Mode != "" {
				if r.heroInCombat() {
					t.Fatalf("%s: noticed on a quiet approach", q.Name)
				}
				if err := r.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: d.Guard, Mode: throatMode}); err != nil {
					t.Fatal(err)
				}
				events = append(events, r.state.Combat.Events...)
				for _, e := range events {
					if e.Type == "hold" {
						hold = e.Amount
					}
				}
				if hold != q.Hold {
					continue
				}
			} else if !r.heroInCombat() {
				t.Fatal("a normal walk stayed unnoticed")
			} else {
				events = append(events, r.state.Combat.Events...)
			}
			r.state = base
			out := filepath.Join(*combatM2Report, q.Name)
			if err := os.MkdirAll(out, 0755); err != nil {
				t.Fatal(err)
			}
			r.data = out
			if err := r.writeSave("slot3", base); err != nil {
				t.Fatal(err)
			}
			if _, _, err := r.readSave("slot3"); err != nil {
				t.Fatal(q.Name, "strict load", err)
			}
			wound, down := int64(-1), int64(-1)
			for _, e := range events {
				if e.Type == "wound" && e.TargetID == d.Guard && wound < 0 {
					wound = e.BodySecond
				}
				if e.Type == "down" && e.TargetID == d.Guard && down < 0 {
					down = e.BodySecond
				}
			}
			row := map[string]any{"name": q.Name, "seed": seed, "episode": d.ID, "mode": q.Mode, "hold_s": hold, "wound_s": wound, "down_s": down, "standoff": throatStandoff}
			meta, _ := json.MarshalIndent(map[string]any{"row": row, "events": events}, "", "  ")
			if err := os.WriteFile(filepath.Join(out, "setup.json"), meta, 0644); err != nil {
				t.Fatal(err)
			}
			index = append(index, row)
			found = true
		}
		if !found {
			t.Errorf("no seed for %s", q.Name)
		}
	}
	raw, _ := json.MarshalIndent(index, "", "  ")
	if err := os.WriteFile(filepath.Join(*combatM2Report, "index.json"), raw, 0644); err != nil {
		t.Fatal(err)
	}
}
