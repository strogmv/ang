// Code generated by ANG. Incremental spatial occupancy; never serialized.
package behavior

import ("sort";"sync")

type trafficCell struct { level string; at Cell }
type trafficBody struct { id,level string; position,next Cell; present,hasNext bool; extra [3]Cell; extras int }
type lifeTraffic struct {
 cells map[trafficCell][]int
 bodies []trafficBody
 named int
 current int
 // baseline fixes: the cell each waiting named person wants next, for one frame (by id, cell and goal)
 wantTick int64
 want map[lifeWantKey]lifeWant
 follow lifeFollowers
}
type lifeWantKey struct{id string;at,goal Cell}
// lifeFollowers: the walkers of this frame whose next cell was taken by a person walking on ahead (lifeFollowOn)
type lifeFollowers struct{tick int64;index []int}
type lifeWant struct{at Cell;ok bool}
func (s *LifeState) beginTraffic() bool {
 if s.trafficActive{return false}
 n:=len(s.Actors)+len(s.Population.Actors)
 if s.traffic==nil||len(s.traffic.bodies)!=n||s.traffic.named!=len(s.Actors){s.traffic=&lifeTraffic{cells:map[trafficCell][]int{},bodies:make([]trafficBody,n),named:len(s.Actors),current:-1}}
 for i:=0;i<n;i++{s.syncTrafficBody(i)}
 s.trafficActive=true;return true
}
func(s *LifeState) endTraffic(owned bool){if owned{s.syncTrafficCurrent();s.traffic.current=-1;s.trafficActive=false}}
func(s *LifeState) syncTrafficCurrent(){if s.traffic!=nil&&s.traffic.current>=0{s.syncTrafficBody(s.traffic.current)}}
func(s *LifeState) trafficActor(index int){s.syncTrafficCurrent();s.traffic.current=index}
func(s *LifeState) syncTrafficBody(index int){
 if s.traffic==nil{return};g:=s.traffic;b:=trafficBody{}
 if index<len(s.Actors){a:=&s.Actors[index];b=trafficBody{id:a.ID,level:a.Level,position:a.Position,present:a.OnFloor()};if len(a.Path)>0{b.hasNext=true;b.next=a.Path[0]};if a.Body!=nil{for _,c:=range a.Body.Cells{if c!=b.position&&(!b.hasNext||c!=b.next)&&b.extras<len(b.extra){b.extra[b.extras]=c;b.extras++}}}}else{a:=&s.Population.Actors[index-len(s.Actors)];b=trafficBody{id:a.ID,level:a.Level,position:a.Position,present:(a.Materialized||a.CombatHold)&&a.Trip==nil};if len(a.Path)>0{b.hasNext=true;b.next=a.Path[0]}}
 old:=g.bodies[index];if old==b{return}
 remove:=func(at Cell){key:=trafficCell{old.level,at};ids:=g.cells[key];for j,id:=range ids{if id==index{copy(ids[j:],ids[j+1:]);ids=ids[:len(ids)-1];break}};if len(ids)==0{delete(g.cells,key)}else{g.cells[key]=ids}}
 if old.present{remove(old.position);if old.hasNext&&old.next!=old.position{remove(old.next)};for j:=0;j<old.extras;j++{remove(old.extra[j])}}
 g.bodies[index]=b
 if b.present{key:=trafficCell{b.level,b.position};g.cells[key]=append(g.cells[key],index);if b.hasNext&&b.next!=b.position{key.at=b.next;g.cells[key]=append(g.cells[key],index)};for j:=0;j<b.extras;j++{key.at=b.extra[j];g.cells[key]=append(g.cells[key],index)}}
}
func(s LifeState) indexedOccupied(level string,at Cell,except string)bool{
 s.syncTrafficCurrent();for _,i:=range s.traffic.cells[trafficCell{level,at}]{if s.traffic.bodies[i].id!=except{return true}};return false
}
// Classify only queried cells. The index survives ticks; willingness is evaluated
// against current duty, cooldown, relation and requester, never cached across them.
func(s *LifeState) yieldCell(m LifeModel,level string,at Cell,tick int64,who string,autonomous bool)(bool,lifeYieldResident,bool){
 s.syncTrafficCurrent();hard,found:=s.Dynamic[level][at],false;resident:=lifeYieldResident{};best:=-1
 for _,index:=range s.traffic.cells[trafficCell{level,at}]{
  b:=s.traffic.bodies[index]
  if index<len(s.Actors){a:=s.Actors[index];repair,repairing:=s.maintenanceStep(m,a.ID);atWork:=repairing&&a.Level==repair.Level&&a.Position==repair.At
   namedNow:=s.Seconds-m.StartSeconds
   eligible:=(s.ControlledActorID!=""||autonomous)&&a.ID!=s.ControlledActorID&&a.ID!=who&&!a.Manual&&!a.Arrived&&a.Activity=="walking"&&a.Goal!=a.Position&&len(a.Path)==0&&namedNow>=a.YieldUntil&&namedNow>=a.YieldCooldownUntil&&!atWork&&s.courtesyNamedWilling(m,a,who)&&!s.courtesyFinishingAhead(m,who,a.ID,a.Level,a.Position,a.Goal)
   courteous:=s.courtesyNamed(m,a,who,namedNow)
   if (eligible||courteous)&&at==b.position{if index>best{resident=lifeYieldResident{index,true,!eligible&&courteous};best=index;found=true}}else{hard=true}
  }else{j:=index-len(s.Actors);a:=s.Population.Actors[j];if s.courtesyPopulation(m,a,who,tick)&&at==b.position{if index>best{resident=lifeYieldResident{j,false,false};best=index;found=true}}else{hard=true}}
 };return hard,resident,found
}

// The host's small named-body layer also persists between frames. Public
// PopulationEnvironment still returns an independent snapshot for callers;
// this cache is borrowed only for the synchronous population kernel call.
func(s *LifeState)cachedPopulationEnvironment()PopulationEnvironment{
 owned:=s.beginTraffic();defer s.endTraffic(owned)
 if s.populationEnv==nil{s.populationEnv=&PopulationEnvironment{Occupied:map[string]map[Cell]bool{},GoalClaims:map[string]map[Cell]bool{}}}
 env:=s.populationEnv;env.SecondsPerTick=s.SecondsPerTick;env.Trips=env.Trips[:0]
 for level,cells:=range env.Occupied{for at:=range cells{present:=s.Dynamic[level][at];for _,i:=range s.traffic.cells[trafficCell{level,at}]{if i<len(s.Actors){present=true;break}};if !present{delete(cells,at)}}}
 // walkers v1: the host's bodies (hall visitors, the service cabinet) are external occupancy of the crowd too
 for level,cells:=range s.Dynamic{if env.Occupied[level]==nil{env.Occupied[level]=map[Cell]bool{}};for at:=range cells{env.Occupied[level][at]=true}}
 for _,cells:=range env.GoalClaims{clear(cells)}
 for _,a:=range s.Actors{
  if a.ResidenceID!=""{continue};if a.Trip!=nil{env.Trips=append(env.Trips,*a.Trip);continue}
  if env.Occupied[a.Level]==nil{env.Occupied[a.Level]=map[Cell]bool{}};cells:=env.Occupied[a.Level]
  if !cells[a.Position]{cells[a.Position]=true};if len(a.Path)>0&&!cells[a.Path[0]]{cells[a.Path[0]]=true};if a.Body!=nil{for _,c:=range a.Body.Cells{cells[c]=true}}
  if a.ID!=s.ControlledActorID&&!a.Manual&&!a.Arrived{if env.GoalClaims[a.Level]==nil{env.GoalClaims[a.Level]=map[Cell]bool{}};env.GoalClaims[a.Level][a.Goal]=true}
 };return *env
}

// ---- Baseline fixes (21.11.2026, design/world-life/baseline-fixes/BRIEF.md, plan 1–2): the Life's own people meet in a
// passage. Before this a named walker whose way ran into another named walker planned round all bodies or asked a short
// courtesy hold of 8 steps; in the corridor of the housing block (two or three cells wide) two opposite morning flows
// stood for hours at ×10 and ×30, and in a one-cell doorway three people gave way to each other for over a day: a hold of
// 24 game seconds is shorter than one frame of ×30, so the one who stepped aside stepped back in the next frame. The rules:
//   - lanes: in a passage up to four cells wide a person keeps to the right of the way he walks (a step into a cell
//     costs one more for each floor cell to its right), so two flows take two lanes instead of meeting head-on;
//   - follow: a body ahead that walks on (not towards him) is followed, not gone round through the oncoming lane;
//   - meeting: two who wait for each other (head-on, or a short ring) — the one who waited less gives way: to a free
//     cell off the other's way, along free floor or past people of his own side who then give way too, and keeps giving
//     way to that person until his way is clear (state, not a timer: the same at every calendar rate); the turn passes
//     when the one whose turn it is has no such cell;
//   - a co-worker standing at his own place in a work area steps into a free cell of the area off the way of a co-worker
//     whose own place lies beyond him, and returns to it after him (CombatHold, a route footprint, a manual person, a
//     service attachment, a seat and the hero are never moved; guards have no work area).

// lifeLaneNarrow: a run of public floor across the way up to this many cells is a passage with lanes; wider is a hall.
const lifeLaneNarrow = 4
// lifeGiveWaySight: the cells of the passer's way the one who gives way keeps clear (and looks for a pocket within).
const lifeGiveWaySight = 16
// lifeGiveWayMax: a give-way is let go after this many game seconds whatever happens (the passer stuck elsewhere).
const lifeGiveWayMax = 1800
// lifeGiveWayTurnSeconds: two who waited alike take turns to give way, this long each.
const lifeGiveWayTurnSeconds = 60

// lifeLanes: for every public floor cell of a level (floor that is no work cell), the floor run to each side, counted to
// lifeLaneRun. Built for every level with the route cache (so a loaded game has the same); never saved.
type lifeLanes struct{width int;west,east,north,south []int8}
// lifeLaneScratch: one search's marks, reused between searches (a stamp per search). Pooled outside the state: two
// states that made a different number of searches stay equal.
type lifeLaneScratch struct{stamp,done []uint32;dist,prev []int32;cur uint32}
var lifeLaneScratchPool sync.Pool
// lifeLaneRun: runs are counted this far (a passage is long against its width: at least twice it and two more).
const lifeLaneRun = 16
func(s LifeState)lifeLanesFor(m LifeModel,level string)*lifeLanes{if s.routes==nil{return nil};return s.routes.lanes[level]}
func buildLifeLanes(m LifeModel,level string)*lifeLanes{
 loc:=m.Locations[level];if len(loc.Terrain)==0{return nil};w,h:=len(loc.Terrain[0]),len(loc.Terrain)
 l:=&lifeLanes{width:w,west:make([]int8,w*h),east:make([]int8,w*h),north:make([]int8,w*h),south:make([]int8,w*h)}
 for y:=0;y<h;y++{for x:=0;x<w;x++{l.measure(m,level,h,x,y)}}
 return l
}
// measure: the runs of one cell over the floor as it is now (all zero off the public floor).
func(l *lifeLanes)measure(m LifeModel,level string,h,x,y int){
 w:=l.width;if x<0||y<0||x>=w||y>=h{return}
 public:=func(x,y int)bool{c:=Cell{x,y};return x>=0&&y>=0&&x<w&&y<h&&m.Walks(level,c)&&m.WorkArea(level,c)==nil}
 i:=y*w+x;if !public(x,y){l.west[i],l.east[i],l.north[i],l.south[i]=0,0,0,0;return}
 run:=func(dx,dy int)int8{n:=int8(0);for n<lifeLaneRun&&public(x+dx*int(n+1),y+dy*int(n+1)){n++};return n}
 l.west[i],l.east[i],l.north[i],l.south[i]=run(-1,0),run(1,0),run(0,-1),run(0,1)
}
// updateLifeLanes: the lanes of a level after a few of its cells changed (a door, a deck, a barrier): only the runs that
// can reach a changed cell — the cells within lifeLaneRun of it along its row and its column — are measured again; the
// result is the same as buildLifeLanes. prev is never written (a cloned state may share it). The profile of 21.11: the
// route cache is rebuilt whenever any level's terrain changes, and building every level's lanes each time took a third
// of the frame at ×30.
func updateLifeLanes(prev *lifeLanes,m LifeModel,level string,old []string)*lifeLanes{
 loc:=m.Locations[level];if prev==nil||len(loc.Terrain)==0||len(old)!=len(loc.Terrain)||prev.width!=len(loc.Terrain[0]){return buildLifeLanes(m,level)}
 var changed []Cell
 for y,row:=range loc.Terrain{if row==old[y]{continue};if len(row)!=len(old[y]){return buildLifeLanes(m,level)};for x:=0;x<len(row);x++{if row[x]!=old[y][x]{changed=append(changed,Cell{x,y})}}}
 if len(changed)==0{return prev}
 if len(changed)>64{return buildLifeLanes(m,level)}
 h:=len(loc.Terrain);l:=&lifeLanes{width:prev.width,west:append([]int8(nil),prev.west...),east:append([]int8(nil),prev.east...),north:append([]int8(nil),prev.north...),south:append([]int8(nil),prev.south...)}
 for _,c:=range changed{for d:=-lifeLaneRun;d<=lifeLaneRun;d++{l.measure(m,level,h,c.X+d,c.Y);l.measure(m,level,h,c.X,c.Y+d)}}
 return l
}
// penalty: the extra cost of stepping into `at` walking `d`: the floor cells to the right of the way in a passage, and
// whether the step keeps to his own half of the passage (the right lane of two, right and middle of three, right two of
// four; a step across the passage always does).
func(l *lifeLanes)penalty(at,d Cell)(int,bool){
 i:=at.Y*l.width+at.X;if i<0||i>=len(l.west){return 0,true};var left,right,along int
 switch{case d.Y<0:left,right,along=int(l.west[i]),int(l.east[i]),int(l.north[i])+int(l.south[i]);case d.Y>0:left,right,along=int(l.east[i]),int(l.west[i]),int(l.north[i])+int(l.south[i]);case d.X>0:left,right,along=int(l.north[i]),int(l.south[i]),int(l.west[i])+int(l.east[i]);case d.X<0:left,right,along=int(l.south[i]),int(l.north[i]),int(l.west[i])+int(l.east[i]);default:return 0,true}
 // a passage: narrow across and long along (a small room is no passage)
 width:=left+right+1;if width>lifeLaneNarrow||along+1<2*width+2{return 0,true};return right,right<=(width-1)/2
}
// lanePath: Space.Path with lanes (a bucket queue over step cost 1 + penalty; ties in the order of Space.Path), nil when
// the level has no lanes cache. Links (stair ends) cost one step.
func(s LifeState)lanePath(m LifeModel,space Space,level string,from,to Cell)[]Cell{return s.lanePathBy(m,space,level,from,to,false,nil)}
// lifeCrowdStepCost: a step into a cell of another walker costs this much more — he waits behind him in a passage,
// but in a hall he goes round a crowd over free floor rather than through it.
const lifeCrowdStepCost = 3
// lanePathBy with strict: no step along a passage outside his own half of it (the goal cell excepted); crowd: the cells
// of walkers that may be walked through (lifeCrowdStepCost each).
func(s LifeState)lanePathBy(m LifeModel,space Space,level string,from,to Cell,strict bool,crowd func(Cell)bool)[]Cell{
 l:=s.lifeLanesFor(m,level);if l==nil{return space.Path(from,to,Cell{},0)}
 if from==to||!space.CanStand(to){return nil}
 w,n:=l.width,len(l.west);index:=func(c Cell)int{if c.X<0||c.Y<0||c.X>=w||c.Y*w+c.X>=n{return -1};return c.Y*w+c.X}
 fi:=index(from);if fi<0{return nil}
 sc,_:=lifeLaneScratchPool.Get().(*lifeLaneScratch);if sc==nil||len(sc.stamp)<n{sc=&lifeLaneScratch{stamp:make([]uint32,n),dist:make([]int32,n),prev:make([]int32,n),done:make([]uint32,n)}};defer lifeLaneScratchPool.Put(sc)
 sc.cur++;if sc.cur==0{clear(sc.stamp);clear(sc.done);sc.cur=1};cur:=sc.cur
 seen:=func(i int)bool{return sc.stamp[i]==cur}
 const span=lifeLaneNarrow+1+lifeCrowdStepCost
 var buckets [span][]int32;sc.stamp[fi],sc.dist[fi],sc.prev[fi]=cur,0,-1
 buckets[0]=append(buckets[0],int32(fi));pending,cost,pops:=1,0,0;limit:=space.MaxSearchCells;if limit<=0{limit=256}
 for pending>0&&pops<limit{
  b:=&buckets[cost%span];if len(*b)==0{cost++;continue}
  ai:=int((*b)[0]);*b=(*b)[1:];pending--
  if sc.done[ai]==cur||int(sc.dist[ai])!=cost{continue};sc.done[ai]=cur;pops++
  at:=Cell{ai%w,ai/w}
  if at==to{var path []Cell;for i:=ai;i!=fi;i=int(sc.prev[i]){path=append(path,Cell{i%w,i/w})};for i,j:=0,len(path)-1;i<j;i,j=i+1,j-1{path[i],path[j]=path[j],path[i]};return path}
  links:=space.Links[at]
  for k:=0;k<len(cardinal)+len(links);k++{
   var next Cell;step:=1
   if k<len(cardinal){d:=cardinal[k];next=Cell{at.X+d.X,at.Y+d.Y};extra,own:=l.penalty(next,d)
    // a step across a passage is judged by the way he came along it: no crossing into the oncoming lane
    if pi:=int(sc.prev[ai]);pi>=0{back:=Cell{pi%w,pi/w};if a0:=(Cell{at.X-back.X,at.Y-back.Y});a0.X*d.X+a0.Y*d.Y==0{if e,o:=l.penalty(next,a0);e>extra{extra,own=e,o}}}
    if strict&&!own&&next!=to{continue};step+=extra
   }else{next=links[k-len(cardinal)]}
   ni:=index(next);if ni<0||sc.done[ni]==cur||!space.CanStand(next) || space.StepAllowed != nil && !space.StepAllowed(at, next){continue}
   if crowd!=nil&&next!=to&&crowd(next){step+=lifeCrowdStepCost}
   if seen(ni)&&int(sc.dist[ni])<=cost+step{continue}
   sc.stamp[ni],sc.dist[ni],sc.prev[ni]=cur,int32(cost+step),int32(ai);buckets[(cost+step)%span]=append(buckets[(cost+step)%span],int32(ni));pending++
  }
 }
 return nil
}
// lifeStaticWay: the way of a named person to his current goal over the floor as it is built (bodies aside), with lanes.
func(s LifeState)lifeStaticWay(m LifeModel,a *LifeActor)[]Cell{
 if a.Position==a.Goal{return nil};return s.lanePath(m,m.SpaceFor(a.Level,nil,a.ID),a.Level,a.Position,a.Goal)
}
// lifeIntendedWay: where a person is going: his accepted steps, else the way he would plan now (in his lane, past the
// walkers, round the rest), else his way over the floor as it is built.
func(s *LifeState)lifeIntendedWay(m LifeModel,a *LifeActor)[]Cell{
 if len(a.Path)>0{return a.Path};if a.Position==a.Goal{return nil}
 space:=m.SpaceFor(a.Level,s.courtesyNamedPassage(m,*a),a.ID)
 if way:=s.lifePlanOccupied(m,space,a.Level,a.ID,a.Position,a.Goal);len(way)>0{return way}
 // past the walkers (they can give way), round everybody else
 people:=s.peopleOccupied(a.Level,a.ID);walkers:=s.lifeWalkerCells(a.Level,a.ID);space.Occupied=func(c Cell)bool{return people(c)&&!walkers[c]}
 if way:=s.lanePath(m,space,a.Level,a.Position,a.Goal);len(way)>0{return way}
 return s.lifeStaticWay(m,a)
}
// lifeTrafficSight: other walkers of the Life this near make a person plan in his lane (lifePlanOccupied).
const lifeTrafficSight = 8
// lifeTrafficNear: another walker of the Life is on the level within lifeTrafficSight of `at`.
func(s LifeState)lifeTrafficNear(level,id string,at Cell)bool{
 for i:=range s.Actors{o:=&s.Actors[i];if o.ID!=id&&o.Level==level&&Distance(o.Position,at)<=lifeTrafficSight&&s.lifeWalker(o){return true}};return false
}
// lifeWalkerCells: the cells of the walkers of a level (where they stand and step into).
func(s LifeState)lifeWalkerCells(level,except string)map[Cell]bool{
 out:=map[Cell]bool{};for i:=range s.Actors{o:=&s.Actors[i];if o.ID!=except&&o.Level==level&&s.lifeWalker(o){out[o.Position]=true;if len(o.Path)>0{out[o.Path[0]]=true}}};return out
}
// namedAt: the index of the named person standing on a cell (not one stepping into it), or -1.
func(s *LifeState)namedAt(level string,at Cell,except string)int{
 if s.trafficActive&&s.traffic!=nil{s.syncTrafficCurrent();for _,i:=range s.traffic.cells[trafficCell{level,at}]{if i<len(s.Actors)&&s.traffic.bodies[i].position==at&&s.traffic.bodies[i].present&&s.Actors[i].ID!=except{return i}};return -1}
 for i:=range s.Actors{a:=&s.Actors[i];if a.ID!=except&&a.OnFloor()&&a.Level==level&&a.Position==at{return i}};return -1
}
// lifeWalker: a named person of the Life walking his own way, who may meet and give way.
func(s LifeState)lifeWalker(a *LifeActor)bool{
 return a!=nil&&a.ID!=s.ControlledActorID&&!a.Manual&&a.OnFloor()&&a.ServiceAttachment==""&&a.BoardedEdge==""&&a.Mount==nil&&!a.CombatHold&&len(a.RouteFootprint)==0&&a.Body==nil&&a.YieldRequester==""&&!a.Arrived&&a.Goal!=a.Position&&(a.Activity=="walking"||a.Activity=="yielding")
}
// lifeFollows: the next cell is taken by a person who walks on and not towards me: wait for him, keep the way.
func(s *LifeState)lifeFollows(m LifeModel,a *LifeActor,next Cell)bool{
 if a.ID==s.ControlledActorID||a.Manual||s.Dynamic[a.Level][next]{return false}
 if i:=s.namedAt(a.Level,next,a.ID);i>=0{o:=&s.Actors[i];return len(o.Path)>0&&o.Path[0]!=a.Position&&o.BlockedSince==0&&o.GiveWayTo!=a.ID}
 return false
}
// lifeOncoming: stepping into `next` enters a passage one cell wide in which somebody comes towards me: I wait at its
// mouth (the visitors' rule of walkers v1 meets them inside; at the mouth nobody has to back out).
func(s *LifeState)lifeOncoming(m LifeModel,a *LifeActor,path []Cell)bool{
 if len(path)==0||!s.lifeWalker(a){return false};l:=s.lifeLanesFor(m,a.Level);if l==nil{return false};next:=path[0]
 narrow:=func(from,to Cell)bool{d:=Cell{to.X-from.X,to.Y-from.Y};i:=to.Y*l.width+to.X;if i<0||i>=len(l.west){return false};switch{case d.X==0:return l.west[i]==0&&l.east[i]==0;default:return l.north[i]==0&&l.south[i]==0}}
 if !narrow(a.Position,next){return false}
 prev,at:=a.Position,next
 for k:=0;k<lifeGiveWaySight;k++{
  if i:=s.namedAt(a.Level,at,a.ID);i>=0{o:=&s.Actors[i];if s.lifeWalker(o){if w,ok:=s.lifeWanted(m,o);ok&&w==prev{return true}}}
  if k+1>=len(path){break};nx:=path[k+1];if !narrow(at,nx){break};prev,at=at,nx
 }
 return false
}
// lifeStepNow: the start of a step asked of somebody else, due at once — if he comes later in this frame he takes it
// in this frame (one frame of ×30 is ten steps; a step asked for the next frame made every knot ten times slower there).
func(s *LifeState)lifeStepNow(m LifeModel,tick int64)int64{return max(0,tick-s.SecondsPerTick+1-m.MoveTicks)}
// lifeDoor: a door of the level — a home's entry or return cell, an exit or an arrival of a way to another level. Nobody
// steps aside into a door (a home's door in a dead end trapped the one who stood there and everybody going home).
func(m LifeModel)lifeDoor(level string,c Cell)bool{
 for _,r:=range m.Residences{if r.Level==level&&(r.Entry==c||r.ReturnAt==c){return true}}
 for _,e:=range m.Edges{if e.From==level&&e.Exit==c||e.To==level&&e.Entry==c{return true}};return false
}
// lifeFollowLater: a walker whose next cell a person walking on ahead still holds keeps his step due; after everybody
// has moved this frame he takes the cells that freed (lifeFollowOn). At ×30 a frame is ten steps: a queue that moved
// only when each one came after the one ahead of him in the frame's order crept a person a frame.
func(s *LifeState)lifeFollowLater(i int){if s.traffic==nil{return};f:=&s.traffic.follow;if f.tick!=s.Tick{f.tick=s.Tick;f.index=f.index[:0]};for _,j:=range f.index{if j==i{return}};f.index=append(f.index,i)}
func(s *LifeState)lifeFollowOn(m LifeModel){
 if s.traffic==nil||s.traffic.follow.tick!=s.Tick||len(s.traffic.follow.index)==0{s.lifeTrafficFrameDone();return};f:=&s.traffic.follow
 for pass:=0;pass<4;pass++{
  moved:=false
  for _,i:=range f.index{
   s.trafficActor(i);a:=&s.Actors[i];tick:=s.ActorMotionTick(m,s.Tick,a);pace:=m.NamedMoveTicks(a)
   for len(a.Path)>0&&tick>=a.MoveStartTick+pace{
    next:=a.Path[0];if s.lifeOncoming(m,a,a.Path){a.Path=nil;a.MoveStartTick=tick;break}
    if !m.allowsSafetyStep(a.Safety,a.Position,next)||!m.WalksFor(a.Level,next,a.ID)||!m.Adjacent(a.Level,a.Position,next){a.Path=nil;a.MoveStartTick=tick;break}
    if s.occupied(a.Level,next,a.ID){if !s.lifeFollows(m,a,next){a.Path=nil;a.MoveStartTick=tick};break}
    a.WalkedMM+=m.lifeStepMM(a.Level,a.Position,next);a.Position=next;a.Path=a.Path[1:];a.MoveStartTick+=pace;if a.GiveWayTo==""{a.BlockedSince=0};moved=true
   }
  }
  if !moved{break}
 }
 // what is still due waits for the next frame like any blocked step
 for _,i:=range f.index{s.trafficActor(i);a:=&s.Actors[i];tick:=s.ActorMotionTick(m,s.Tick,a);if len(a.Path)>0&&tick>=a.MoveStartTick+m.NamedMoveTicks(a){a.MoveStartTick=tick}}
 f.index,f.tick=nil,0
}
// lifeTrafficFrameDone: the frame's own notes go (a loaded game, which never had them, goes on the same way).
func(s *LifeState)lifeTrafficFrameDone(){if s.traffic!=nil{s.traffic.want,s.traffic.wantTick=nil,0;s.traffic.follow=lifeFollowers{}}}
// lifeSlotTaken: another person of the Life stands on the cell or his brain heads for it.
func(s *LifeState)lifeSlotTaken(level string,at Cell,self string)bool{
 for i:=range s.Actors{a:=&s.Actors[i];if a.ID==self||a.Level!=level{continue};if a.OnFloor()&&a.Position==at||a.Brain.Place.ID!=""&&a.Brain.Target.Level==level&&a.Brain.Target.At==at{return true}};return false
}
// lifeYieldHold: an ordinary courtesy hold in motion ticks — eight steps, and at least two frames at the calendar's rate
// (a hold shorter than a frame of ×30 ended before the other could step, and the one aside stepped back).
func(m LifeModel)lifeYieldHold(secondsPerTick int64)int64{return max(8*m.MoveTicks,2*secondsPerTick)}
func lifeTurn(seconds int64,a,b string)bool{return (seconds/lifeGiveWayTurnSeconds%2==0)==(a>b)}
// lifeWanted: the cell a person wants next: his accepted step, else the first cell of his way.
func(s *LifeState)lifeWanted(m LifeModel,a *LifeActor)(Cell,bool){
 if len(a.Path)>0{return a.Path[0],true}
 key:=lifeWantKey{a.ID,a.Position,a.Goal}
 if s.traffic!=nil{if s.traffic.wantTick!=s.Tick||s.traffic.want==nil{s.traffic.want=map[lifeWantKey]lifeWant{};s.traffic.wantTick=s.Tick};if w,ok:=s.traffic.want[key];ok{return w.at,w.ok}}
 way:=s.lifeIntendedWay(m,a);w:=lifeWant{};if len(way)>0{w=lifeWant{way[0],true}}
 if s.traffic!=nil{s.traffic.want[key]=w};return w.at,w.ok
}
// lifeWaitCycle: following who waits for whom (each wants the cell the next one stands on) from b back to a — a knot
// of a crowd where nobody can move first; the members from a, nil when the chain ends elsewhere.
func(s *LifeState)lifeWaitCycle(m LifeModel,ai,bi int)[]int{
 a:=&s.Actors[ai];cycle:=[]int{ai,bi};seen:=map[int]bool{ai:true,bi:true};x:=bi
 for hop:=0;hop<lifeWaitCycleLength;hop++{
  w,ok:=s.lifeWanted(m,&s.Actors[x]);if !ok{return nil};if w==a.Position{return cycle}
  y:=s.namedAt(a.Level,w,s.Actors[x].ID);if y<0||seen[y]||!s.lifeWalker(&s.Actors[y])||s.Actors[y].BlockedSince==0&&len(s.Actors[y].Path)>0{return nil}
  cycle=append(cycle,y);seen[y]=true;x=y
 }
 return nil
}
// lifeWaitCycleLength: the longest knot looked for.
const lifeWaitCycleLength = 12
// lifeWayCells: the passer's next cells of his way (and his own cell), the cells to keep clear.
func(s *LifeState)lifeWayCells(m LifeModel,p *LifeActor)map[Cell]bool{
 out:=map[Cell]bool{p.Position:true};for i,c:=range s.lifeIntendedWay(m,p){if i>=lifeGiveWaySight{break};out[c]=true};return out
}
// lifeGiveWayStep: y clears the way of p — the nearest free cell off p's way, reached along free floor or past people
// of his own side, who are asked to give way to p as well. False when there is no such cell near (nothing changes).
func(s *LifeState)lifeGiveWayStep(m LifeModel,yi int,p *LifeActor,tick int64)bool{return s.lifeGiveWayBy(m,yi,p,tick,true)}
// lifeGiveWayFree: lifeGiveWayStep over free floor only.
func(s *LifeState)lifeGiveWayFree(m LifeModel,yi int,p *LifeActor,tick int64)bool{return s.lifeGiveWayBy(m,yi,p,tick,false)}
func(s *LifeState)lifeGiveWayBy(m LifeModel,yi int,p *LifeActor,tick int64,others bool)bool{
 y:=&s.Actors[yi];if !s.lifeWalker(y){return false};way:=s.lifeWayCells(m,p)
 // first over free floor only; then also past people of my side (who are asked to give way to p as well)
 passes:=[]bool{false};if others{passes=append(passes,true)}
 for _,past:=range passes{
  type node struct{at Cell;parent,hops int}
  seen:=map[Cell]bool{y.Position:true};queue:=[]node{};found:=-1
  for _,c:=range m.StepNeighbours(y.Level,y.Position){if !m.WalksFor(y.Level,c,y.ID)||c==p.Position||!m.Adjacent(y.Level,y.Position,c){continue};seen[c]=true;queue=append(queue,node{c,-1,1})}
  for head:=0;head<len(queue)&&head<128;head++{
   n:=queue[head]
   if s.occupied(y.Level,n.at,y.ID){if !past{continue};o:=s.namedAt(y.Level,n.at,y.ID);if o<0||!s.lifeWalker(&s.Actors[o])||s.Actors[o].ID==p.ID||s.Actors[o].GiveWayTo!=""&&s.Actors[o].GiveWayTo!=p.ID{continue}}else if !way[n.at]&&!m.lifeDoor(y.Level,n.at){found=head;break}
   if n.hops>=lifeGiveWaySight{continue}
   for _,c:=range m.StepNeighbours(y.Level,n.at){if seen[c]||!m.WalksFor(y.Level,c,y.ID)||c==p.Position||!m.Adjacent(y.Level,n.at,c){continue};seen[c]=true;queue=append(queue,node{c,head,n.hops+1})}
  }
  if found<0{continue}
  // the way to the pocket, and its free beginning (he walks it at his pace: one frame of ×30 may take the whole of it)
  var steps []Cell;for k:=found;k>=0;k=queue[k].parent{steps=append(steps,queue[k].at)};for i,j:=0,len(steps)-1;i<j;i,j=i+1,j-1{steps[i],steps[j]=steps[j],steps[i]}
  free:=0;for free<len(steps)&&!s.occupied(y.Level,steps[free],y.ID){free++}
  if y.GiveWayTo!=p.ID{y.GiveWayTo=p.ID;y.GiveWaySince=s.Seconds};if p.GiveWayTo==y.ID{p.GiveWayTo="";p.GiveWaySince=0};p.Brain.PathRetrySecond=0
  y.Activity="yielding";y.Label="Уступает проход"
  if free>0{y.Path=append([]Cell(nil),steps[:free]...);y.MoveStartTick=s.lifeStepNow(m,tick);y.YieldUntil=tick+m.MoveTicks;y.YieldCooldownUntil=tick+m.MoveTicks;s.syncTrafficBody(yi);return true}
  // the way to the pocket runs past people of my side: the last of them (nearest the pocket) walks into it now and
  // stays a while (an ordinary courtesy hold, at least two frames at any rate), so the one before him can step next
  last:=-1;for k:=range steps{if s.occupied(y.Level,steps[k],y.ID){last=k}}
  if last>=0&&last+1<len(steps){if o:=s.namedAt(y.Level,steps[last],y.ID);o>=0{x:=&s.Actors[o];rest:=steps[last+1:];free:=true;for _,c:=range rest{if s.occupied(y.Level,c,x.ID){free=false;break}};if free&&s.lifeWalker(x)&&len(x.Path)==0&&x.GiveWayTo==""&&tick>=x.YieldUntil{x.Activity="yielding";x.Label="Уступает проход";x.Path=append([]Cell(nil),rest...);x.MoveStartTick=s.lifeStepNow(m,tick);x.YieldUntil=tick+m.lifeYieldHold(s.SecondsPerTick);x.YieldCooldownUntil=tick+m.MoveTicks;s.syncTrafficBody(o)}}}
  return true
 }
 return false
}
// lifeMeet: a walker with no way among the bodies; true when the meeting rule decided (he waits or gives way).
func(s *LifeState)lifeMeet(m LifeModel,ai int,way []Cell,tick int64)bool{
 a:=&s.Actors[ai];if !s.lifeWalker(a){return false}
 if s.lifeMeetBy(m,ai,way,tick){if a.Brain.PathRetrySecond>s.Seconds+m.MoveTicks{a.Brain.PathRetrySecond=s.Seconds+m.MoveTicks};return true};return false
}
func(s *LifeState)lifeMeetBy(m LifeModel,ai int,way []Cell,tick int64)bool{
 a:=&s.Actors[ai]
 if len(way)==0{way=s.lifeIntendedWay(m,a)};if len(way)==0{return false}
 bi:=s.namedAt(a.Level,way[0],a.ID);if bi<0{return false};b:=&s.Actors[bi]
 if b.GiveWayTo==a.ID{return true}
 if !s.lifeWalker(b){return s.lifeCoworkerGiveWay(m,ai,bi,way,tick)}
 // a person of my side ahead (walking on, or waiting for somebody else): I wait behind him, nobody is pushed —
 // unless the waiting closes into a knot: then the one who waited least among those with a free cell off the way of
 // the one behind him steps there
 wb,ok:=s.lifeWanted(m,b)
 if !(ok&&wb==a.Position){
  if len(b.Path)>0&&b.BlockedSince==0{return true}
  cycle:=s.lifeWaitCycle(m,ai,bi);if cycle==nil{return true}
  order:=append([]int(nil),cycle...);sort.SliceStable(order,func(i,j int)bool{return s.Actors[order[i]].BlockedSince>s.Actors[order[j]].BlockedSince})
  for _,y:=range order{k:=0;for k<len(cycle)&&cycle[k]!=y{k++};p:=cycle[(k+len(cycle)-1)%len(cycle)];if s.lifeGiveWayFree(m,y,&s.Actors[p],tick){return true}}
  return true
 }
 if a.BlockedSince==0{a.BlockedSince=s.Seconds};bw:=b.BlockedSince;if bw==0{bw=s.Seconds}
 // who gives way: the one with more people coming towards him beyond the other (they would stop him next anyway),
 // then the one who waited less, then by turns
 ca,cb:=s.lifeOncomingCount(m,a,way,b.ID),s.lifeOncomingCount(m,b,nil,a.ID)
 mine:=ca>cb||ca==cb&&(a.BlockedSince>bw||a.BlockedSince==bw&&lifeTurn(s.Seconds,a.ID,b.ID))
 // the one whose turn it is gives way; with no cell for it, the other does
 if mine{if s.lifeGiveWayStep(m,ai,b,tick){return true};return s.lifeGiveWayStep(m,bi,a,tick)}
 if s.lifeGiveWayStep(m,bi,a,tick){return true};return s.lifeGiveWayStep(m,ai,b,tick)
}
// lifeOncomingCount: the walkers on the next cells of his way (past `skip`) who come towards him.
func(s *LifeState)lifeOncomingCount(m LifeModel,a *LifeActor,way []Cell,skip string)int{
 if len(way)==0{way=s.lifeIntendedWay(m,a)};n:=0;prev:=a.Position
 for k,c:=range way{if k>=lifeGiveWaySight{break};if i:=s.namedAt(a.Level,c,a.ID);i>=0&&s.Actors[i].ID!=skip{o:=&s.Actors[i];if s.lifeWalker(o){if w,ok:=s.lifeWanted(m,o);ok&&w==prev{n++}}};prev=c}
 return n
}
// lifeGiveWayHold: a person who gives way keeps doing it while the passer still needs his cell or the cell he wants
// next; true while he holds (no way of his own is planned this frame).
func(s *LifeState)lifeGiveWayHold(m LifeModel,ai int,tick int64)bool{
 a:=&s.Actors[ai];p:=s.Actor(a.GiveWayTo)
 release:=p==nil||!p.OnFloor()||p.Level!=a.Level||p.Position==p.Goal&&len(p.Path)==0||s.Seconds-a.GiveWaySince>lifeGiveWayMax||p.GiveWayTo==a.ID||a.Manual||a.ID==s.ControlledActorID||a.CombatHold
 var way map[Cell]bool
 if !release{way=s.lifeWayCells(m,p);own:=s.lifeStaticWay(m,a);if len(a.Path)==0{if w:=s.lifeIntendedWay(m,a);len(w)>0{own=w}};release=!way[a.Position]&&!(len(own)>0&&way[own[0]])}
 if release{a.GiveWayTo="";a.GiveWaySince=0;a.Brain.PathRetrySecond=0;if a.Activity=="yielding"&&!a.Arrived{a.Activity="walking"};return false}
 if way[a.Position]&&len(a.Path)==0{s.lifeGiveWayStep(m,ai,p,tick)}
 a.Activity="yielding";a.Label="Уступает проход";return true
}
// lifeCoworkerGiveWay (plan 2): b stands at his own place in a work area, a's goal lies in the same area and both work
// there: b steps into a free cell of the area next to him, off a's way, with a's way still open round it.
func(s *LifeState)lifeCoworkerGiveWay(m LifeModel,ai,bi int,way []Cell,tick int64)bool{
 a,b:=&s.Actors[ai],&s.Actors[bi];area:=m.WorkArea(a.Level,b.Position)
 if area==nil||area!=m.WorkArea(a.Level,a.Goal){return false}
 mine:=func(id string)bool{for _,w:=range area.Workers{if w==id{return true}};return false}
 if !mine(a.ID)||!mine(b.ID)||b.ID==s.ControlledActorID||b.Manual||b.CombatHold||len(b.RouteFootprint)>0||b.ServiceAttachment!=""||b.BoardedEdge!=""||b.Mount!=nil||b.Body!=nil||!b.OnFloor()||b.Safety!=nil||b.YieldRequester!=""||courtesySeated(b.Brain,b.Position)||!b.Arrived||b.Position!=b.Goal||len(b.Path)>0{return false}
 on:=map[Cell]bool{};for _,c:=range way{on[c]=true}
 for _,c:=range m.StepNeighbours(b.Level,b.Position){
  if on[c]||m.WorkArea(b.Level,c)!=area||!m.WalksFor(b.Level,c,b.ID)||!m.Adjacent(b.Level,b.Position,c)||s.occupied(b.Level,c,b.ID){continue}
  if len(m.SpaceFor(a.Level,map[Cell]bool{c:true},a.ID).Path(a.Position,a.Goal,Cell{},0))==0{continue}
  b.Path=[]Cell{c};b.MoveStartTick=s.lifeStepNow(m,tick);b.Arrived=false;b.Activity="yielding";b.Label="Уступает проход";b.GiveWayTo=a.ID;b.GiveWaySince=s.Seconds;b.YieldUntil=tick+m.MoveTicks;b.YieldCooldownUntil=tick+m.MoveTicks;s.syncTrafficBody(bi);return true
 }
 return false
}

// lifeLanePlan: the way of a walker in passages — through the cells of other walkers (he waits behind them or meets
// them there), round everybody else: in his own lane first, else with lanes as a preference (round a person standing in
// his lane); nil when there is no such way (then he plans round all bodies as before).
// It returns the occupancy it planned against and whether the way kept to his lane (a way round a visitor near by is
// planned the same way, lifePlanOccupied).
func(s LifeState)lifeLanePlan(m LifeModel,space Space,level,id string,from,to Cell,people func(Cell)bool)([]Cell,func(Cell)bool,bool){
 var a *LifeActor;for i:=range s.Actors{if s.Actors[i].ID==id{a=&s.Actors[i];break}}
 if a==nil||!s.lifeWalker(a){return nil,nil,false}
 walkers:=s.lifeWalkerCells(level,id)
 occupied:=func(c Cell)bool{return people(c)&&!walkers[c]}
 past:=space;past.Occupied=occupied;crowd:=func(c Cell)bool{return walkers[c]}
 if way:=s.lanePathBy(m,past,level,from,to,true,crowd);len(way)>0{return way,occupied,true}
 return s.lanePathBy(m,past,level,from,to,false,crowd),occupied,false
}
