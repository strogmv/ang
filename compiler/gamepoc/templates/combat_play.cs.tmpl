   if(session!=null&&!ReferenceEquals(session,combatHookedSession)){combatHookedSession=session;session.OnActionResult+=r=>{if(r.Ok&&(r.Action=="load"||r.Action=="new"))CombatResetPresentation(true);CombatActionResult(r);};}
