     if(block.yMin-fixH<safe.yMin)block.y=safe.yMin+fixH;if(block.yMax>safe.yMax)block.y=safe.yMax-h;
     for(int guard=0;guard<6;guard++){bool moved=false;foreach(var r in barkPlaced){var me=new Rect(block.x-6,block.y-fixH-4,block.width+12,block.height+fixH+8);if(me.Overlaps(r)){block.y=r.yMin-block.height-8;moved=true;}}if(!moved)break;}
