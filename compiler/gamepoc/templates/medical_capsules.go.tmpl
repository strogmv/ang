	r.state.Medical.Doors[id] = medicalDoor{StartNS: r.simNS(), EndNS: r.simNS() + int64(r.world.MedicalCapsules.DoorSeconds*1e9), From: medicalDoorValue(d, r.simNS()), To: to}
}
func (r *Runtime) medicalBusy(unit, except string) bool {
