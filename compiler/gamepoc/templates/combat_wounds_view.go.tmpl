// Code generated by ANG. A self view is medical; every other view contains signs only.
package poc

import (
	"angelsdemons/server/internal/behavior"
	crafting "angelsdemons/server/internal/crafting"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"angelsdemons/server/internal/wounds"
	"errors"
	"fmt"
	"strings"
)

func (r *Runtime) appendWoundViews(msg *pb.PocGameState, locale string) {
	text := func(key string) string { return r.localText(r.validLocale(locale), key, key) }
 // Seat activity is a separate channel. Publish an observable fallen pose
 // for ordinary Life bodies too, so the client can play combat_look.down after combat.
 for _,agent:=range msg.SceneAgents{if actor,ok:=r.state.CombatRoster[agent.Id];ok&&len(actor.Body)>0{
  if !combatWounds.Status(combatBody(actor)).Standing{agent.Activity="down";agent.Task=text("ui.combat.down")}else if actor.Surrendered{agent.Activity="surrendered";agent.Task=text("ui.combat.surrendered")}
 }}
	own := func(v *pb.PocCombatActor, c behavior.Combatant) {
		if v == nil || len(c.Body) == 0 {
			return
		}
		body := combatBody(c)
		view := combatWounds.ViewSelf(body, 7*86400)
		forecast := strings.NewReplacer("{minutes}", fmt.Sprint(view.Minutes), "{hours}", fmt.Sprint(view.Hours)).Replace(text(view.ForecastKey))
		v.BodyLines = append(v.BodyLines, text(view.State))
		for _, line := range view.Lines {
			names := []string{}
			for _, key := range line.Structures {
				names = append(names, text(key))
			}
			if len(names)==0{names=append(names,text(line.Mechanism))}
			value := strings.NewReplacer("{zone}", text(line.Zone), "{structure}", strings.Join(names, ", "), "{forecast}", forecast).Replace(text("wounds.wound.line"))
			if line.Danger {
				value = "! " + value
			}
			for _, control := range line.Controls {
				value += " · " + text(control)
			}
			v.BodyLines = append(v.BodyLines, value)
			for _, effect := range line.Effects {
				v.BodyLines = append(v.BodyLines, text(effect))
			}
		}
		if len(view.Lines) == 0 && !body.Dead {
			v.BodyLines = append(v.BodyLines, forecast)
		}
		if c.Aid != nil {
			v.BodyLines = append(v.BodyLines, strings.NewReplacer("{seconds}", fmt.Sprint(c.Aid.RemainingS)).Replace(text("ui.combat.aid_progress")))
		}
		if !r.heroInCombat() {
			v.AidOptions = r.outsideWoundAidOptions(c, locale)
		}

	}
	if msg.PlayerCondition != nil {
		c := r.combatant(playerActorID, "player")
		if a := r.state.Combat.Actor(playerActorID); r.state.Combat.Active && a != nil {
			c = *a
		}
		own(msg.PlayerCondition, c)
	}
	if msg.Combat == nil {
		return
	}
	for _, v := range msg.Combat.Actors {
		a := r.state.Combat.Actor(v.Id)
		if a == nil {
			continue
		}
		if a.ID == playerActorID {
			own(v, *a)
		} else {
			for _, key := range combatWounds.ViewOther(combatBody(*a)) {
				v.Signs = append(v.Signs, text(key))
			}
		}
	}
}
func (r *Runtime) woundKillingCase(event wounds.Event) {
	act, ok := r.world.Crafting.Act("killing")
	if !ok {
		return
	}
	law := &r.state.Crafting.Law
	law.Serial++
	law.Cases = append(law.Cases, crafting.Case{ID: fmt.Sprintf("case.%d", law.Serial), Act: "killing", Suspect: event.Culprit, Item: event.Body, Opened: r.state.Life.Seconds, Evidence: []crafting.Evidence{{Kind: act.Evidence, Weight: act.WeightPermille, Second: r.state.Life.Seconds}}})
}

func (r *Runtime) outsideWoundAidOptions(c behavior.Combatant, locale string) []*pb.PocCombatOption {
	text := func(key string) string { return r.localText(r.validLocale(locale), key, key) }
	var out []*pb.PocCombatOption
	add := func(action behavior.CombatAction, label string) {
		o := &pb.PocCombatOption{Id: action.Type + "." + action.TargetID + "." + action.Mode, Action: action.Type, TargetId: action.TargetID, Mode: action.Mode, ItemId: action.ItemID, Group: "care", Label: label}
		_, err := r.woundAidPlan(c, action)
		if err == nil {
			o.Enabled = true
		} else {
			var why textError
			if errors.As(err, &why) {
				o.Reason = strings.ReplaceAll(text(why.Key),"{aid}",text("wounds.aid."+action.Mode))
			} else {
				o.Reason = text("error.combat.other")
			}
		}
		out = append(out, o)
	}
	if c.Aid != nil {
		add(behavior.CombatAction{Type: "aid_continue"}, text("ui.combat.aid_continue"))
	}
	for _, w := range combatBody(c).Wounds {
		z, _ := combatWounds.Zone(w.Zone)
		for _, q := range []struct{ kind, item string }{{"pressure", ""}, {"tourniquet", "item.med_tourniquet"}, {"packing", "item.med_gauze"}, {"dressing", "item.med_patch"}, {"medkit", "item.medkit_guard"}} {
			add(behavior.CombatAction{Type: "aid", TargetID: w.ID, Mode: q.kind, ItemID: q.item}, text("wounds.aid."+q.kind)+" · "+text(z.Name)+" ("+w.ID+")")
		}
	}
	return out
}
