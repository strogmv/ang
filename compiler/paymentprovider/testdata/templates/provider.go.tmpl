{{ if and .CheckStatusThrottleConfig .CheckStatusThrottleConfig.Enabled -}}
func (pp *{{ .StructName }}) isCheckStatusThrottled(txID string) bool {
{{- if and .CrossInstanceStateConfig .CrossInstanceStateConfig.Enabled }}
	windowStore, errStore := time.ParseDuration("{{ .CheckStatusThrottleConfig.Period }}")
	if errStore == nil && pp.checkStatusStore != nil {
		throttled, storeErr := pp.checkStatusStore.IsThrottled(txID)
		if storeErr == nil {
			return throttled
		}
		_ = windowStore // keep config validated before local fallback
	}
{{- end }}
	pp.throttleMu.Lock()
	defer pp.throttleMu.Unlock()

	last, ok := pp.lastStatusByTx[txID]
	if !ok {
		return false
	}
	window, err := time.ParseDuration("{{ .CheckStatusThrottleConfig.Period }}")
	if err != nil {
		// Invalid config should not break status checks in runtime.
		return false
	}
	return time.Since(last) < window
}

func (pp *{{ .StructName }}) markCheckStatusCall(txID string) {
{{- if and .CrossInstanceStateConfig .CrossInstanceStateConfig.Enabled }}
	window, err := time.ParseDuration("{{ .CheckStatusThrottleConfig.Period }}")
	if err == nil && pp.checkStatusStore != nil {
		_ = pp.checkStatusStore.Mark(txID, window)
		return
	}
{{- end }}
	pp.throttleMu.Lock()
	pp.lastStatusByTx[txID] = time.Now()
	pp.throttleMu.Unlock()
}
{{ end }}

{{ if and .CrossInstanceStateConfig .CrossInstanceStateConfig.Enabled -}}
// checkStatusStore allows shared throttling across instances (e.g. redis-backed).
// Generated provider falls back to in-memory throttling when store is not configured.
type checkStatusStore interface {
	IsThrottled(txID string) (bool, error)
	Mark(txID string, ttl time.Duration) error
}
{{ end }}

{{ if and .StatusConfirmationConfig .StatusConfirmationConfig.Enabled -}}
// statusConfirmer allows provider-specific confirmation of pending statuses
// (e.g. extra transaction-list lookup) without forking generated flow.
type statusConfirmer interface {
	ConfirmPendingStatus(mc *model.MerchantCreds, tx *model.Transaction, current *model.StatusResponse) (*model.StatusResponse, bool, error)
}

func (pp *{{ .StructName }}) tryConfirmPendingStatus(mc *model.MerchantCreds, tx *model.Transaction, current *model.StatusResponse) (*model.StatusResponse, error) {
	if current == nil || current.Status != tnxStatusPending || pp.statusConfirmer == nil {
		return current, nil
	}
	confirmed, ok, err := pp.statusConfirmer.ConfirmPendingStatus(mc, tx, current)
	if err != nil {
		return nil, err
	}
	if ok && confirmed != nil {
		return confirmed, nil
	}
	return current, nil
}
{{ end }}

{{ if and .Async3DSConfig .Async3DSConfig.Enabled -}}
// async3DSCoordinator allows provider-specific asynchronous 3DS completion logic
// (e.g. deferred capture/charge after callback) without forking generated callback flow.
type async3DSCoordinator interface {
	HandleFinishCallback(mc *model.MerchantCreds, tx *model.Transaction, cd *model.CallbackData, current *model.StatusResponse) (*model.StatusResponse, bool, error)
}

func (pp *{{ .StructName }}) tryAsync3DSCallback(mc *model.MerchantCreds, tx *model.Transaction, cd *model.CallbackData, current *model.StatusResponse) (*model.StatusResponse, error) {
	if current == nil || !current.Status.Pending() {
		return current, nil
	}
	if pp.async3DSCoordinator != nil {
		next, ok, err := pp.async3DSCoordinator.HandleFinishCallback(mc, tx, cd, current)
		if err != nil {
			return nil, err
		}
		if ok && next != nil {
			return next, nil
		}
	}
	return pp.tryAsync3DSDefault(mc, tx, current), nil
}

func (pp *{{ .StructName }}) tryAsync3DSDefault(mc *model.MerchantCreds, tx *model.Transaction, current *model.StatusResponse) *model.StatusResponse {
	waitTimeout := time.Duration(0)
{{- if .Async3DSConfig.FinishCallbackWaitTimeout }}
	if d, err := time.ParseDuration("{{ .Async3DSConfig.FinishCallbackWaitTimeout }}"); err == nil {
		waitTimeout = d
	}
{{- end }}
	autoChargeAfter := time.Duration(0)
{{- if .Async3DSConfig.AutoChargeAfter }}
	if d, err := time.ParseDuration("{{ .Async3DSConfig.AutoChargeAfter }}"); err == nil {
		autoChargeAfter = d
	}
{{- end }}
	staleGrace := time.Duration(0)
{{- if .Async3DSConfig.StalePendingGrace }}
	if d, err := time.ParseDuration("{{ .Async3DSConfig.StalePendingGrace }}"); err == nil {
		staleGrace = d
	}
{{- end }}

	now := time.Now()
	if waitTimeout > 0 && !tx.Created.IsZero() {
		age := now.Sub(tx.Created)
		if age > waitTimeout+staleGrace {
			pp.clearAsync3DSCooldown(tx.Id)
			return &model.StatusResponse{
				Status:  tnxStatusError,
				Code:    model.SCodeTimeouted,
				Message: model.SCodeTimeouted.Description(),
			}
		}
	}
	if !pp.async3DSCanCheckNow(tx.Id, now, autoChargeAfter) {
		return current
	}
	statusResp, err := pp.CheckStatus(mc, tx)
	pp.markAsync3DSCooldown(tx.Id, now, autoChargeAfter)
	if err != nil || statusResp == nil {
		return current
	}
	if statusResp.Status.Pending() {
		return current
	}
	pp.clearAsync3DSCooldown(tx.Id)
	return statusResp
}

func (pp *{{ .StructName }}) async3DSCanCheckNow(txID string, now time.Time, cooldown time.Duration) bool {
	if cooldown <= 0 {
		return true
	}
	key := "async3ds:" + txID
{{- if and .CrossInstanceStateConfig .CrossInstanceStateConfig.Enabled }}
	if pp.checkStatusStore != nil {
		if throttled, err := pp.checkStatusStore.IsThrottled(key); err == nil && throttled {
			return false
		}
	}
{{- end }}
	pp.async3DSMu.Lock()
	defer pp.async3DSMu.Unlock()
	nextAt, ok := pp.async3DSNextCheck[txID]
	if !ok {
		return true
	}
	return !now.Before(nextAt)
}

func (pp *{{ .StructName }}) markAsync3DSCooldown(txID string, now time.Time, cooldown time.Duration) {
	if cooldown <= 0 {
		return
	}
	key := "async3ds:" + txID
{{- if and .CrossInstanceStateConfig .CrossInstanceStateConfig.Enabled }}
	if pp.checkStatusStore != nil {
		_ = pp.checkStatusStore.Mark(key, cooldown)
	}
{{- end }}
	pp.async3DSMu.Lock()
	pp.async3DSNextCheck[txID] = now.Add(cooldown)
	pp.async3DSMu.Unlock()
}

func (pp *{{ .StructName }}) clearAsync3DSCooldown(txID string) {
	pp.async3DSMu.Lock()
	delete(pp.async3DSNextCheck, txID)
	pp.async3DSMu.Unlock()
}
{{ end }}

