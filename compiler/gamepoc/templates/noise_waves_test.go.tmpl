		t.Fatal("waves switched off in the data still reached the client")
	}
}

// Each serial once, gone after publish_s; a load does not replay an old blow.
func TestNoiseWavesExpireAndDoNotReplay(t *testing.T) {
	r, _, d := combatEpisodeFixture(t, "combat_throat", "ru")
	noiseBaseline(t, r)
	r.noiseOwn("test", d.Level, r.state.Life.Actor(playerActorID).Position, .9, 0)
	first := noiseView(r)
	if len(first) != 1 || first[0].Serial == 0 {
		t.Fatalf("%+v", first)
	}
	if again := noiseView(r); len(again) != 1 || again[0].Serial != first[0].Serial {
		t.Fatal("a wave must stay in the snapshots of its window under one serial")
	}
	r.state.Tick += int64(r.world.NoiseWaves.PublishS*float64(r.world.Config.TickHz)) + 1
	if gone := noiseView(r); len(gone) != 0 {
		t.Fatal("a wave outlived its window")
	}
	r.state.Tick = 1
	r.state.Combat.ID = "loaded"
	r.state.Combat.Events = []behavior.CombatEvent{{Sequence: 9, Type: "attack", ActorID: d.Guard, From: r.state.Life.Actor(playerActorID).Position}}
	if loaded := noiseView(r); len(loaded) != 0 {
		t.Fatal("a load replayed an old blow as a new sound")
	}
}
