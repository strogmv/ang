	act, ok := m.Act(actID)
	if !ok {
		return
	}
	law := &r.state.Crafting.Law
	now := r.state.Life.Seconds
	law.Serial++
	c := crafting.Case{ID: "case." + strconv.FormatUint(law.Serial, 10), Act: actID, Suspect: m.Hero.Actor, Item: item, Opened: now}
	if direct {
		c.Evidence = []crafting.Evidence{{Kind: act.Evidence, Weight: act.WeightPermille, Second: now}}
	} else {
		for _, e := range m.Reports(r.state.Seed, c.ID, act, witnesses, now) {
			if e.Second <= now {
				c.Evidence = append(c.Evidence, e)
			} else {
				c.Pending = append(c.Pending, e)
			}
		}
	}
	if len(c.Evidence)+len(c.Pending) == 0 {
		return // nobody saw it and nothing recorded it: no case
	}
	law.Cases = append(law.Cases, c)
}

// craftingDetect rolls a way of detection once per act, thing and day (the seed decides).
