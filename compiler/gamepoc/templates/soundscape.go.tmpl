func (r *Runtime) soundWhenHolds(w soundWhen, day int64) bool {
	if w.ShopOpen != "" && !r.storefrontOpen(w.ShopOpen) {
		return false
	}
	if w.Window != nil {
		in := day >= w.Window.From && day < w.Window.To
		if w.Window.From > w.Window.To {
			in = day >= w.Window.From || day < w.Window.To
		}
		if !in {
			return false
		}
	}
	if w.Vending {
		any := false
		for i := range r.world.Vending.Units {
			any = any || r.vendingInService(i) || r.vendingStatus(i) == "working" || r.vendingStatus(i) == "serving"
		}
		if !any {
			return false
		}
	}
	return true
}

func (r *Runtime) soundEvent(clip string, x, y int, up, gain, minM, maxM float64, pick int32) {
	s := &r.sound
	s.serial++
	s.events = append(s.events, &pb.PocSoundEvent{Serial: s.serial, Clip: clip, X: int32(x), Y: int32(y), UpM: float32(up), GainDb: float32(gain), MinM: float32(minM), MaxM: float32(maxM), Tick: r.state.Tick, Pick: pick})
}

// soundPeople: the real people around the hero, the hero not counted; in a multi-deck place by plan and height, so the gallery above is farther than the floor beside him.
func (r *Runtime) soundPeople(hero *behavior.LifeActor) int32 {
	radius := r.world.Soundscape.Crowd.RadiusM
	v := r.deckVolume()
	hx, hy, hz := float64(hero.Position.X)*.5, float64(hero.Position.Y)*.5, 0.0
	place := func(at behavior.Cell) (float64, float64, float64, bool) {
		if v != nil {
			plan, height, _, ok := v.Locate(at)
			if !ok {
				return 0, 0, 0, false
			}
			return float64(plan.X) * .5, float64(plan.Y) * .5, float64(height) / 1000, true
		}
		return float64(at.X) * .5, float64(at.Y) * .5, 0, true
	}
	if x, y, z, ok := place(hero.Position); ok {
		hx, hy, hz = x, y, z
	}
	near := func(at behavior.Cell) bool {
		x, y, z, ok := place(at)
		if !ok {
			return false
		}
		dx, dy, dz := x-hx, y-hy, z-hz
		return dx*dx+dy*dy+dz*dz <= radius*radius
	}
	n := int32(0)
	for i := range r.state.Life.Actors {
		a := &r.state.Life.Actors[i]
		if a.ID != playerActorID && a.Level == hero.Level && a.OnFloor() && near(a.Position) {
			n++
		}
	}
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if a.Level == hero.Level && a.Trip == nil && a.Materialized && near(a.Position) {
			n++
		}
	}
	return n
}

// advanceSoundscape runs once per Life frame, after the people moved and the shops opened or shut.
func (r *Runtime) advanceSoundscape() {
	g := &r.world.Soundscape
	s := &r.sound
	hero := r.state.Life.Actor(playerActorID)
	if g.LevelID == "" || hero == nil {
		return
	}
	tick := r.state.Tick
	// a load or a new game: start again from the world as it is, without a false shutter
	fresh := !s.ready || tick < s.lastTick || tick-s.lastTick > 600
	if fresh {
		s.hours, s.opened, s.sales = map[string]bool{}, map[string]bool{}, map[string]int64{}
		s.events = nil
	}
	s.lastTick = tick
	day := ((r.state.Life.Seconds % 86400) + 86400) % 86400
	keep := s.events[:0]
	age := int64(g.PublishSeconds * float64(r.world.Config.TickHz))
	for _, e := range s.events {
		if tick-e.Tick <= age {
			keep = append(keep, e)
		}
	}
	s.events = keep
	// a shop: down when the inventory says it shuts (its hours end, or its person goes on a declared break: the shutter on screen comes down too), up when its person stands at the post again.
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.Mobile() || sh.Service.Level != g.LevelID {
			continue
		}
		hours, _ := r.state.Inventory.ShopStatus(sh)
		open := r.storefrontOpen(sh.ID)
		if !fresh {
			if s.hours[sh.ID] && !hours && s.opened[sh.ID] {
				r.soundEvent(g.Roller.Down, sh.Service.At.X, sh.Service.At.Y, g.Roller.UpM, g.Roller.GainDB, g.Roller.MinM, g.Roller.MaxM, int32(craftHash(sh.ID)%64))
			}
			if hours && open && !s.opened[sh.ID] {
				r.soundEvent(g.Roller.Up, sh.Service.At.X, sh.Service.At.Y, g.Roller.UpM, g.Roller.GainDB, g.Roller.MinM, g.Roller.MaxM, int32(craftHash(sh.ID)%64))
			}
		}
		switch {
		case !hours:
			s.opened[sh.ID] = false
		case open || fresh: // already open when the game was loaded
			s.opened[sh.ID] = true
		}
		s.hours[sh.ID] = hours
	}
	// a sale at a unit of the vending block
	for i, u := range r.world.Vending.Units {
		st := r.vendingUnitState(u.ID)
		if !fresh && st.Sales > s.sales[u.ID] && len(u.Lane) > 0 {
			r.soundEvent(g.Vending.Clip, u.Lane[0].X, u.Lane[0].Y, g.Vending.UpM, g.Vending.GainDB, g.Vending.MinM, g.Vending.MaxM, int32(i))
		}
		s.sales[u.ID] = st.Sales
	}
	// the seeded shots: one moment in each period of ticks, from the seed
	hz := float64(r.world.Config.TickHz)
	for _, shot := range g.Shots {
		period := int64(shot.EveryS * hz)
		if period < 1 {
			period = 1
		}
		slot := tick / period
		at := slot*period + int64(barks.Roll(r.state.Seed, "sound.when", shot.ID, slot)%uint64(period))
		if tick != at || int(barks.Roll(r.state.Seed, "sound.chance", shot.ID, slot)%1000000) >= shot.ChancePPM || !r.soundWhenHolds(shot.When, day) {
			continue
		}
		roll := barks.Roll(r.state.Seed, "sound.pick", shot.ID, slot)
		c := shot.At[int(roll%uint64(len(shot.At)))]
		r.soundEvent(shot.Clips[int((roll>>16)%uint64(len(shot.Clips)))], c.X, c.Y, shot.UpM, shot.GainDB, shot.MinM, shot.MaxM, int32((roll>>32)%64))
	}
	s.active = s.active[:0]
	if hero.Level == g.LevelID {
		for i, l := range g.Loops {
			if r.soundWhenHolds(l.When, day) {
				s.active = append(s.active, int32(i))
			}
		}
		s.people = r.soundPeople(hero)
	} else {
		s.people = 0
	}
	s.ready = true
}

// appendSoundscape: the hero's level only. The client plays what is here.
func (r *Runtime) appendSoundscape(view *pb.PocLifeView, hero *behavior.LifeActor) {
	g := &r.world.Soundscape
	if g.LevelID == "" || hero == nil || hero.Level != g.LevelID || hero.Trip != nil {
		return
	}
	view.Soundscape = &pb.PocSoundscape{Active: append([]int32(nil), r.sound.active...), CrowdPeople: r.sound.people, Events: append([]*pb.PocSoundEvent(nil), r.sound.events...)}
}
