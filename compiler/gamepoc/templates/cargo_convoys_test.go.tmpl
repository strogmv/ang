 if end:=r.cargoTrailerAt("stand.market.cargo","b2");end==""||end==start{t.Fatalf("the trailers were not swapped on B2: %q before, %q after",start,end)}
 if rate==1&&gateByPass<0{t.Fatal("gate 8 did not rise by pass before 06:00")}
