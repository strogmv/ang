 r.state.Active=true;r.state.Speed=1;r.initLifeState(life);r.state.Life.SecondsPerTick=1;r.state.Life.Actor(playerActorID).Manual=true
 if r.state.Life.Seconds!=7*3600{t.Fatal("overnight fixture must start at07:00")}
 report:=merchantHostProof{Scope:"actual Runtime.advanceLifeFrameBy + inventory, continuous Life100 day1 07:00 to day2 12:00; no Unity/network-frame/FPS claim",ContentHash:r.world.ContentHash,Start:r.state.Life.Seconds,Rate:1,InitialTotal:commerceTotal(r.state.Inventory)}
 defer func(){report.Pass=!t.Failed();report.End=r.state.Life.Seconds;report.FinalTotal=commerceTotal(r.state.Inventory);report.PopulationIDs=r.state.Life.Population.Count;b,_:=json.MarshalIndent(report,"","  ");t.Logf("MERCHANT_HOST_PROOF %s",b);if file:=os.Getenv("ANG_MARKET_SUPPLY_REPORT");file!=""{if err:=os.MkdirAll(filepath.Dir(file),0700);err!=nil{t.Error(err)}else if err=os.WriteFile(file,b,0600);err!=nil{t.Error(err)}}}()
 initialItems:=r.state.Inventory.Clone().Items
 initialSource,initialDisplay,initialReserve:=map[string]int64{},map[string]int64{},map[string]int64{}
 shops:=map[string]inv.Shopfront{};for _,sh:=range r.world.Inventory.Shopfronts{shops[sh.Owner]=sh;initialDisplay[sh.ID]=commerceQuantity(r.state.Inventory,sh.DisplayStore);initialReserve[sh.ID]=commerceQuantity(r.state.Inventory,sh.ReserveStore)}
 records:=map[string]*merchantHostDelivery{};for _,d:=range r.world.Inventory.Deliveries{initialSource[d.ID]=commerceQuantity(r.state.Inventory,d.SourceStore);if d.Quantity!=3||initialSource[d.ID]<3{t.Fatal("fixture requires finite three-unit consignments")};sh:=shops[d.Carrier];records[d.ID]=&merchantHostDelivery{ID:d.ID,Carrier:d.Carrier,SourceBefore:initialSource[d.ID],ShopBefore:initialDisplay[sh.ID]+initialReserve[sh.ID]}}
 picked,delivered,inside:=map[string]bool{},map[string]bool{},map[string]bool{};closed,saved:=false,false;var replay *Runtime
 for r.state.Life.Seconds<86400+12*3600 {
  r.state.Tick++;if err=r.advanceLifeFrameBy(1);err!=nil{t.Fatal(err)}
  if replay!=nil{replay.state.Tick++;if err=replay.advanceLifeFrameBy(1);err!=nil{t.Fatal(err)};if !reflect.DeepEqual(r.state.Inventory,replay.state.Inventory)||!reflect.DeepEqual(r.state.Life.Clone(),replay.state.Life.Clone()){t.Fatal("in-flight delivery diverged after disk save")};report.ReplayTicks++}
  if r.state.Life.Seconds==22*3600 {
   closed=true
   for _,sh:=range r.world.Inventory.Shopfronts{
    if open,_:=r.state.Inventory.ShopStatus(sh);open||r.state.Inventory.ShopAccess(r.world.Inventory,playerActorID,sh.DisplayStore,r.state.Life.Seconds){t.Fatal("night shop stayed open")}
    display,reserve:=commerceQuantity(r.state.Inventory,sh.DisplayStore),commerceQuantity(r.state.Inventory,sh.ReserveStore)
    for id,old:=range initialItems{if old.Location!=(inv.Location{Kind:"store",Store:sh.DisplayStore}){continue};now,ok:=r.state.Inventory.Items[id];target:=sh.DisplayStore;if sh.PackAway{target=sh.ReserveStore};if !ok||now.ID!=old.ID||now.Owner!=old.Owner||now.Definition!=old.Definition||now.Quantity!=old.Quantity||now.Location!=(inv.Location{Kind:"store",Store:target}){t.Fatal("night closure replaced or lost an existing physical item")}}
    if sh.PackAway{report.Packed++;if display!=0||reserve!=initialDisplay[sh.ID]+initialReserve[sh.ID]{t.Fatal("night packing failed to transfer the same finite stock")}}else{report.Protected++;if display!=initialDisplay[sh.ID]||reserve!=initialReserve[sh.ID]{t.Fatal("protected display moved or lost its stock")}}
   }
  }
  for _,d:=range r.world.Inventory.Deliveries{
   p:=r.state.Inventory.Deliveries[d.ID];a:=r.state.Life.Actor(d.Carrier);rec:=records[d.ID];sh:=shops[d.Carrier]
   if a.ResidenceID!=""{inside[a.ID]=true;if a.OnFloor(){t.Fatal("private resident is still a physical actor")}}
   if p.Phase=="carrying"&&!picked[d.ID]{
