func(r *Runtime) applySocialOrder(a *demoAgent,order behavior.Order,focus behavior.Cell){
 if a.Task=="considering"{return}
 if a.YieldUntil>r.state.Tick{return}
 goal:=location(order.Goal)
 r.observeMovement(a,order.Mode,goal)
 if a.Progress.Status=="failed"{return}
 if len(a.Path)==0&&a.Position!=goal&&!a.Progress.RetryReady(r.state.Tick,r.world.AI.Policy.Recovery.Movement){return}
 if a.Goal==goal&&a.Task==order.Mode&&len(a.Path)>0{return}
