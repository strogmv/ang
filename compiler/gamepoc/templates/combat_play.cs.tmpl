  // Advance the queue in real time (the turn order is the server's; a beat only waits for its own presentation).
  void AdvanceCombatBeats(){
   if(combatQueue.Count==0||locationSDKLevel==null)return;
   if(CombatNow<combatPauseUntil)return;
   var b=combatQueue[0];
   if(combatBeatAt<0&&b.kind!="move"&&!string.IsNullOrEmpty(b.actor)&&CombatCellValid(b.from)){
    // The server had the actor at the event's cell: if the shown body is elsewhere (a step not seen), it walks there first.
    var shown=CombatShownCell(b.actor);if(shown.HasValue&&shown.Value!=b.from){var step=new CombatBeat{kind="move",actor=b.actor,from=shown.Value,to=b.from,valid=true};step.path.Add(b.from);combatQueue.Insert(0,step);b=step;}
    else if(!string.IsNullOrEmpty(b.target)&&CombatCellValid(b.to)&&b.kind=="attack"){var tb=CombatBodyOf(b.target);var ts=CombatShownCell(b.target);if(ts.HasValue&&ts.Value!=b.to){tb.cell=b.to;tb.placed=true;}}
   }
   if(combatBeatAt<0)CombatBeginBeat(b);
   float t=CombatNow-combatBeatAt;
   if(b.pair)CombatPairFx(b,t);else if(b.kind=="attack"&&!b.fxDone&&t>=b.lead+CombatClipSecondsOf(b)*b.impact){b.fxDone=true;CombatImpact(b);}
   {var bl=CombatLook()==null?null:CombatLook().baton;if(bl!=null&&b.batonStrike&&b.hit&&b.targetDown&&!b.pairBody&&t>=b.lead+CombatClipSecondsOf(b)*b.impact+bl.fall_thud_s){b.pairBody=true;CombatPairSound(bl.sound_fall,b);}}
   if(b.kind=="equip"&&!b.propDone&&t>=b.seconds*.5f){b.propDone=true;CombatBody body=CombatBodyOf(b.actor);body.held=CombatHeld(b.actor);CombatFloat(b.actor,L("ui.combat.fx.equip"),new Color(.85f,.85f,.75f));}
   if(b.kind=="reload"&&!b.fxDone&&t>=b.seconds*.6f){b.fxDone=true;CombatFloat(b.actor,L("ui.combat.fx.reload"),new Color(.85f,.85f,.75f));}
   if((b.kind=="bandage"||b.kind=="heal")&&!b.fxDone&&t>=b.seconds*.5f){b.fxDone=true;CombatFloat(b.actor,L("ui.combat.fx.bandage"),new Color(.6f,.95f,.6f));}
   if(t<b.seconds)return;
   if(b.kind=="roll"||b.kind=="fall_shift"){var shifted=CombatBodyOf(b.actor);shifted.cell=b.to;shifted.placed=true;}
   if(b.kind=="move"){var body=CombatBodyOf(b.actor);if(b.path.Count>0){body.cell=b.path[b.path.Count-1];body.placed=true;}}
   if(b.victimShift){var victim=CombatBodyOf(b.target);victim.cell=b.victimTo;victim.placed=true;}
   if(combatAutoDir!=null&&b.kind=="attack"&&!float.IsInfinity(b.missMinSkin))combatM1Rows.Add("{\"miss_min_skin_m\":"+CombatF(b.missMinSkin)+",\"miss_min_body_no_arms_m\":"+CombatF(b.missMinBody)+",\"actor\":"+CombatJ(b.actor)+"}");
   combatQueue.RemoveAt(0);combatBeatAt=-1;CombatPlayedBeats++;
   if(combatQueue.Count>0&&combatQueue[0].actor!=b.actor&&b.kind!="end"){var look=CombatLook();combatPauseUntil=CombatNow+(look==null?.3f:look.pause_seconds);}
  }
  // The striker's own clip time (the beat may be longer: it waits for the target's reaction).
  float CombatClipSecondsOf(CombatBeat b){var h=CombatHumanoid(b.actor);return CombatClipSeconds(h==null?null:h.animator,b.clip,b.seconds);}
  void CombatImpact(CombatBeat b){
   NoiseWaveRelease(b.sequence);
   if(string.IsNullOrEmpty(b.target))return;
   CombatAutoImpact(b.actor,b.target,b.hit,b.from,b.to);
   // The authoritative inventory may already contain a disarm. Keep the old
   // prop through wind-up, then release it at the accepted impact.
   if(b.hit)CombatBodyOf(b.target).held=CombatHeld(b.target);
   if(b.parried&&!b.hit)CombatFloat(b.target,L("ui.combat.fx.parry"),new Color(.75f,.85f,1f));
   else if(!b.hit)CombatFloat(b.target,L("ui.combat.fx.miss"),new Color(.8f,.8f,.8f));
   else{string where=!string.IsNullOrEmpty(b.zone)?b.zone:b.part;string part=string.IsNullOrEmpty(where)?"":" · "+L("ui.combat.body."+where);CombatFloat(b.target,L("ui.combat.fx.wound")+part,new Color(1f,.42f,.32f));if(!b.bodyStrike)CombatFlash(b.target);}
   if(b.bodyStrike)CombatSoundOf(b);
   if(b.outcome=="surrender")CombatFloat(b.target,L("ui.combat.surrendered"),new Color(.9f,.9f,.9f));
   if(b.outcome=="flee")CombatFloat(b.target,L("ui.combat.retreat"),new Color(.9f,.9f,.9f));
   if(b.targetDown){CombatFloat(b.target,L("ui.combat.down"),new Color(1f,.85f,.35f),.5f);CombatAutoShotLater("knocked-out");}
   if(b.targetStunned&&!b.targetDown){CombatFloat(b.target,L("ui.combat.stunned"),new Color(1f,.85f,.35f),.5f);CombatAutoShotLater("stunned");}
  }
  // Where a body is shown now: the cell of its last played step while it has waiting beats, else the server's cell.
  Vector2Int? CombatShownCell(string id){
   CombatBody body;if(combatBodies.TryGetValue(id,out body)&&body.placed)return body.cell;
   foreach(var q in combatQueue){if(q.actor==id&&(q.kind=="move"||q.kind=="attack"||q.kind=="roll"||q.kind=="fall_shift"||q.kind=="stand")&&CombatCellValid(q.from))return q.from;if(q.kind=="attack"&&q.target==id&&CombatCellValid(q.to))return q.to;}
   if(id=="char.hero")return state==null?(Vector2Int?)null:new Vector2Int(state.PlayerX,state.PlayerY);
   if(state!=null)foreach(var a in state.SceneAgents)if(a.Id==id)return new Vector2Int(a.X,a.Y);
   return null;
  }
  CombatBody CombatBodyOf(string id){CombatBody body;if(!combatBodies.TryGetValue(id,out body)){body=new CombatBody();combatBodies[id]=body;}return body;}
  void CombatFloat(string actor,string text,Color color,float delay=0){if(string.IsNullOrEmpty(actor)||string.IsNullOrEmpty(text))return;combatFx.RemoveAll(f=>f.actor==actor&&f.text==text);combatFx.Add(new CombatFx{actor=actor,text=text,color=color,start=CombatNow+delay,until=CombatNow+delay+1.6f});}
  void CombatFlash(string actor){CombatBodyOf(actor).flashUntil=CombatNow+.18f;}

  // A layer clip at time t (seconds into its played part, -1 = held / looping) with its fade envelope.
  struct CombatLayerPose {public PocCombatClip clip;public float t,weight;public bool held;}
  static float CombatSmooth(float x){x=Mathf.Clamp01(x);return x*x*(3-2*x);}
  float CombatEnvelope(Animator an,PocCombatClip c,float t){
   float len=CombatClipSeconds(an,c,1f);float a=c.blend_in<=0?1:CombatSmooth(t/c.blend_in),b=c.blend_out<=0||c.hold?1:CombatSmooth((len-t)/c.blend_out);return c.weight*Mathf.Min(a,b);
  }

  // The humanoid hook: true when a combat beat or combat stance owns this body this frame.
  bool CombatPresentHumanoid(LocationSDKHumanoid h,string id,Vector3 feet,double nowNS,bool held){
   var look=CombatLook();if(look==null||locationSDKLevel==null)return false;
