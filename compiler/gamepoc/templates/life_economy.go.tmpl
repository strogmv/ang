// Code generated by ANG. NPC commerce uses the same inventory transactions as the player.
package poc
import("fmt";"sort";"strings";"angelsdemons/server/internal/behavior";inv "angelsdemons/server/internal/inventory";pb "angelsdemons/server/internal/transport/grpc/pb/game/v1")

type npcEconomyState struct {
 InitialSource int64 `json:"initial_source_minor"`
 Employer string `json:"employer"`
 WageSource int64 `json:"wage_source_minor"`
 Purchases int64 `json:"purchases"`
 FoodConsumed int64 `json:"food_consumed"`
 Turnover int64 `json:"turnover_minor"`
 BySeller map[string]int64 `json:"by_seller"`
 // Units sold per seller (debug acceptance: visible display stock vs. NPC sales).
 UnitsBySeller map[string]int64 `json:"units_by_seller,omitempty"`
}
func(s npcEconomyState)clone()npcEconomyState{if s.BySeller!=nil{m:=map[string]int64{};for id,n:=range s.BySeller{m[id]=n};s.BySeller=m};if s.UnitsBySeller!=nil{m:=map[string]int64{};for id,n:=range s.UnitsBySeller{m[id]=n};s.UnitsBySeller=m};return s}
// CUE declares the finite identity budget and initial endowment. Dormant
// population wallets are zero: only instantiated citizens receive start funds.
func(r *Runtime)prepareNPCInventory(){
 c:=r.world.Life.Brain;if !c.Enabled{return};m:=&r.world.Inventory
 ids:=[]string{};for _,a:=range r.world.Life.Actors{ids=append(ids,a.ID)}
 for i:=1;i<=c.PopulationAccounts;i++{id:=fmt.Sprintf("population.%04d",i);ids=append(ids,id);m.Actors[id]=true;m.Owners[id]=true;sid:=inv.ActorStore(id);m.Stores[sid]=inv.Store{ID:sid,Kind:"actor",Anchor:inv.Anchor{Kind:"actor",Actor:id},Owner:id,Capacity:inv.Capacity{Mass:25000,Volume:25000,Stacks:128}}}
 for _,id:=range ids{found:=false;for _,a:=range m.Accounts{if a.Owner==id&&a.Currency==c.Currency{found=true;break}};if !found{key:="account.npc."+id;m.Accounts[key]=inv.Account{ID:key,Owner:id,Currency:c.Currency}}}
 r.npcAccountIDs=map[string]string{};for key,a:=range m.Accounts{if a.Currency==c.Currency{r.npcAccountIDs[a.Owner]=key}}
}
func(r *Runtime)npcAccount(id string)(inv.Account,bool){
 if r.npcAccountIDs==nil{r.npcAccountIDs=map[string]string{};for key,a:=range r.world.Inventory.Accounts{if a.Currency==r.world.Life.Brain.Currency{r.npcAccountIDs[a.Owner]=key}}}
 key:=r.npcAccountIDs[id];a,ok:=r.state.Inventory.Accounts[key];return a,ok
}
func(r *Runtime)initNPCEconomy(){
 if !r.world.Life.Brain.Enabled{return};r.state.NPCEconomy=npcEconomyState{Employer:r.world.Life.Brain.Employer}
 ids:=[]string{};for _,a:=range r.state.Life.Actors{if a.ID!=playerActorID{ids=append(ids,a.ID)}};for _,a:=range r.state.Life.Population.Actors{ids=append(ids,a.ID)}
 for _,id:=range ids{a,ok:=r.npcAccount(id);if !ok{continue};a.Balance+=r.world.Life.Brain.InitialBalance;r.state.NPCEconomy.InitialSource+=r.world.Life.Brain.InitialBalance;r.state.Inventory.Accounts[a.ID]=a}
}
func(r *Runtime)npcServices()behavior.LifeBrainServices{return behavior.LifeBrainServices{
 Balance:func(id string)int64{a,_:=r.npcAccount(id);return a.Balance}, Offers:r.npcOffers,Buy:r.npcBuy,
 TravelSeconds:func(level string,from,to behavior.Cell)int64{return r.state.Life.StaticTravelSeconds(r.world.Life,level,from,to)},
 Pay:func(id string,amount int64)bool{a,ok:=r.npcAccount(id);if !ok||amount<1||a.Balance>9000000000000000-amount{return false};a.Balance+=amount;a.Revision++;r.state.Inventory.Accounts[a.ID]=a;r.state.Inventory.Revision++;r.state.NPCEconomy.WageSource+=amount;return true},
}}
func(r *Runtime)npcOfferItem(id string,p behavior.LifeAffordance)(inv.Item,bool){
 staffed:=false;for _,sh:=range r.world.Inventory.Shopfronts{if sh.DisplayStore!=p.Store{continue};a:=r.state.Life.Actor(sh.Owner);staffed=a!=nil&&a.OnFloor()&&len(a.Path)==0&&a.Level==sh.Service.Level&&a.Position==(behavior.Cell{X:sh.Service.At.X,Y:sh.Service.At.Y});break};if !staffed{return inv.Item{},false}
 if !r.commerceAccessible(id,inv.Location{Kind:"store",Store:p.Store}){return inv.Item{},false}
 defs:=r.world.Life.Brain.FoodDefinitions;if p.Kind=="market_goods"{defs=r.world.Life.Brain.GoodsDefinitions}
 account,ok:=r.npcAccount(id);if !ok{return inv.Item{},false};best:=inv.Item{}
 for _,i:=range r.state.Inventory.Items{if i.Location.Kind!="store"||i.Location.Store!=p.Store||!i.ForSale||i.Owner==id||i.Hidden||i.Quantity<1{continue};allowed:=false;for _,d:=range defs{if d==i.Definition{allowed=true}};if !allowed{continue};d:=r.world.Inventory.Definitions[i.Definition];price,err:=inv.Quote(d,1);if err!=nil||d.PriceUnit!=account.Currency||price>account.Balance{continue};if best.ID==""||i.ID<best.ID{best=i}}
 return best,best.ID!=""
}
func(r *Runtime)npcOffers(id,kind,level string)[]behavior.LifeAffordance{
 var offers []behavior.LifeAffordance
 for _,p:=range r.world.Life.Brain.Places{if p.Kind!=kind||p.Level!=level{continue};if _,ok:=r.npcOfferItem(id,p);ok{offers=append(offers,p)}};return offers
}
func(r *Runtime)npcBuy(id string,p behavior.LifeAffordance,food bool)bool{
 present:=false
 if a:=r.state.Life.Actor(id);a!=nil{present=a.OnFloor()&&a.Arrived&&len(a.Path)==0&&a.Level==p.Level&&a.Position==p.At}else{for _,a:=range r.state.Life.Population.Actors{if a.ID==id{present=a.Trip==nil&&a.Arrived&&len(a.Path)==0&&a.Level==p.Level&&a.Position==p.At;break}}}
 if !present{return false}
 item,ok:=r.npcOfferItem(id,p);if !ok{return false};model:=r.inventoryModelFor(true)
 result,err:=r.state.Inventory.Execute(model,inv.Action{Actor:id,Kind:"buy",Item:item.ID,Quantity:1,Sequence:r.state.Inventory.Cursors[id].Sequence+1,ExpectedRevision:item.Revision},inv.Access{Level:p.Level,At:inv.Cell{X:p.At.X,Y:p.At.Y},Known:func(i inv.Item)bool{return i.ID==item.ID},Reach:func(a inv.Anchor)bool{return a.Kind=="world"&&a.Level==p.Level&&manhattan(point{a.At.X,a.At.Y},point{p.At.X,p.At.Y})<=model.Actions.ReachCells}})
 if err!=nil{return false};bought:=item.ID;if len(result.Created)>0{bought=result.Created[0]}
 if food{if err:=r.state.Inventory.Consume(model,id,bought,1);err!=nil{panic(err)};r.state.NPCEconomy.FoodConsumed++}
 amount,_:=inv.Quote(model.Definitions[item.Definition],1);r.state.NPCEconomy.Purchases++;r.state.NPCEconomy.Turnover+=amount
 if r.state.NPCEconomy.BySeller==nil{r.state.NPCEconomy.BySeller=map[string]int64{}};r.state.NPCEconomy.BySeller[item.Owner]+=amount
 if r.state.NPCEconomy.UnitsBySeller==nil{r.state.NPCEconomy.UnitsBySeller=map[string]int64{}};r.state.NPCEconomy.UnitsBySeller[item.Owner]++
 return true
}
// NPCDebugJournalLines is the HUD "Отладка" projection of the Life/population
// decision journals and NPC commerce counters. Development telemetry only:
// sent with debug_perception, never part of the hero's knowledge.
const npcDebugDecisionLines=16
func(r *Runtime)npcDebugJournalLines()[]string{
 named,population:=r.LifeDecisionLog();type row struct{d behavior.LifeDecision;pop bool};rows:=make([]row,0,len(named)+len(population))
 for _,d:=range named{rows=append(rows,row{d,false})};for _,d:=range population{rows=append(rows,row{d,true})}
 sort.SliceStable(rows,func(i,j int)bool{if rows[i].d.Tick!=rows[j].d.Tick{return rows[i].d.Tick<rows[j].d.Tick};if rows[i].pop!=rows[j].pop{return !rows[i].pop};return rows[i].d.Sequence<rows[j].d.Sequence})
 if len(rows)>npcDebugDecisionLines{rows=rows[len(rows)-npcDebugDecisionLines:]}
 out:=make([]string,0,len(rows)+1)
 for _,x:=range rows{d:=x.d;name:=d.Actor;if !x.pop{if p:=r.world.Life.Person(d.Actor);p!=nil&&p.Name!=""{name=p.Name}};sec:=d.Seconds%86400;line:=fmt.Sprintf("Решение NPC %02d:%02d:%02d · %s · %s · причина: %s",sec/3600,sec/60%60,sec%60,name,d.Decision,d.Reason);if d.Previous!=""{line+=" · было: "+d.Previous};alts:=[]string{};for _,a:=range d.Alternatives{if a!=""{alts=append(alts,a)}};if len(alts)>0{line+=" · вместо: "+strings.Join(alts,", ")};out=append(out,line)}
 if r.world.Life.Brain.Enabled{e:=r.state.NPCEconomy;var total int64;for _,a:=range r.state.Inventory.Accounts{total+=a.Balance};sellers:=make([]string,0,len(e.UnitsBySeller));for id:=range e.UnitsBySeller{sellers=append(sellers,id)};sort.Strings(sellers);parts:=make([]string,0,len(sellers));for _,id:=range sellers{parts=append(parts,fmt.Sprintf("%s=%d/%d",id,e.UnitsBySeller[id],e.BySeller[id]))}
  out=append(out,fmt.Sprintf("Экономика NPC · покупок %d · оборот %d · съедено %d · зарплаты %d · начальные %d · сумма счетов %d · продано %s",e.Purchases,e.Turnover,e.FoodConsumed,e.WageSource,e.InitialSource,total,strings.Join(parts,",")))}
 return out
}
func(r *Runtime)appendNPCDebugJournal(view *pb.PocLifeView){if !r.world.Config.DebugPerception{return};view.Events=append(view.Events,r.npcDebugJournalLines()...)}
