func sanitaryPrivate(p sanitaryUser, u sanitaryUnit) bool {
	return u.Kind != "basin" && (p.Phase == "sealing" || p.Phase == "using" || p.Phase == "opening_exit")
}
func (r *Runtime) sanitaryPose(p sanitaryUser, u sanitaryUnit) medicalPose {
	t := 0.0
	if p.PhaseEndNS > p.PhaseStartNS {
		t = math.Max(0, math.Min(1, float64(r.simNS()-p.PhaseStartNS)/float64(p.PhaseEndNS-p.PhaseStartNS)))
	}
	switch p.Phase {
	case "entry":
		v := medicalLerp(u.EntryPose, u.InsidePose, math.Min(1, t/.8))
		v.YawDegrees = u.EntryPose.YawDegrees
		if t > .8 {
			delta := math.Mod(u.InsidePose.YawDegrees-u.EntryPose.YawDegrees+540, 360) - 180
			v.YawDegrees = math.Mod(u.EntryPose.YawDegrees+delta*(t-.8)/.2+360, 360)
		}
		return v
	case "exit":
		v := medicalLerp(u.InsidePose, u.EntryPose, t)
		v.YawDegrees = math.Mod(math.Atan2(u.EntryPose.X-u.InsidePose.X, u.EntryPose.Z-u.InsidePose.Z)*180/math.Pi+360, 360)
		return v
	case "sealing", "using", "opening_exit":
		return u.InsidePose
	}
	return u.EntryPose
}
