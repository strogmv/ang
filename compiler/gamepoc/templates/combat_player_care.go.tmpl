// Code generated by ANG. Explicit finite first aid outside a controlled encounter.
package poc
import "angelsdemons/server/internal/behavior"

func(r *Runtime)treatOutsideCombat(action string)error{
 if !r.state.Life.Enabled||r.state.Paused||r.heroInCombat(){return textError{Key:"error.combat_unavailable"}}
 hero:=r.state.Life.Actor(playerActorID)
 if hero==nil||!hero.OnFloor()||hero.CombatHold||len(hero.Path)>0||hero.Body!=nil&&hero.Body.Moving{return textError{Key:"error.combat_actor_inactive"}}
 c:=r.combatant(playerActorID,"player");c.Position=hero.Position
 if !c.Able()||c.StunTurns>0{return textError{Key:"error.combat_actor_inactive"}}
 if c.Medkits<1{return textError{Key:"error.combat_no_medkit"}}
 if action=="bandage"&&c.Bleeding==0||action=="heal"&&c.HP>=c.MaxHP{return textError{Key:"error.combat_not_wounded"}}
 trial:=&Runtime{world:r.world,state:r.snapshotState(),npcAccountIDs:r.npcAccountIDs}
 used:=false
 for _,id:=range r.world.CombatRuntime.MedicalDefinitions{if trial.combatCount(trial.state.Inventory,playerActorID,id,nil)>0{if err:=trial.consumeCombatStock(&trial.state.Inventory,playerActorID,id,1,nil);err!=nil{return err};used=true;break}}
 if !used{return textError{Key:"error.combat_no_medkit"}}
 switch action{case "bandage":c.Bleeding=max(0,c.Bleeding-r.world.CombatRuntime.Rules.BandageAmount);case "heal":c.HP=min(c.MaxHP,c.HP+r.world.CombatRuntime.Rules.HealAmount);default:return textError{Key:"error.combat_invalid_action"}}
 trial.refreshCombatEquipment(trial.state.Inventory,&c)
 if trial.state.CombatRoster==nil{trial.state.CombatRoster=map[string]behavior.Combatant{}}
 trial.state.CombatRoster[playerActorID]=cloneCombatant(c)
 // First aid costs real world time too. Only this isolated draft advances;
 // any failure leaves the original wound, supplies and clocks unchanged.
 if err:=trial.advanceLifeFrameBy(r.world.CombatRuntime.CareActionSeconds);err!=nil{return err}
 r.state=trial.state
 return nil
}
