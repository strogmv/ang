		t.Fatalf("API94 must publish canonical grip height: got %g want %g", public.Carts[0].GripYM, cfg.GripYM)
	}
	if strings.Contains(visibleRaw, "sanitary.test") || strings.Contains(visibleRaw, "place_id") || strings.Contains(visibleRaw, "inventory") {
		t.Fatal("private owner/service/inventory leaked")
	}
	raw := r.cartParkingJSON(hero, nil)
	var empty struct {
		Carts []any `json:"carts"`
	}
	if err := json.Unmarshal([]byte(raw), &empty); err != nil || len(empty.Carts) != 0 {
		t.Fatal("nil perception must not reveal hidden cart")
	}
