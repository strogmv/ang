// Code generated by ANG. Event-time observation, not retrospective unfogging.
package poc

import ("angelsdemons/server/internal/behavior";"math")

func(r *Runtime)capturePublicCombatEvents(){r.capturePublicCombatEventsFrom(r.state.Combat)}
func(r *Runtime)capturePublicCombatEventsFrom(previous behavior.CombatState){
 poses:=map[string]behavior.Combatant{};for _,a:=range previous.Actors{poses[a.ID]=cloneCombatant(a)}
 observer,inside:=poses[playerActorID]
 if !inside{observer=behavior.Combatant{ID:playerActorID,Position:behavior.Cell{X:r.state.Player.X,Y:r.state.Player.Y}}}
 level:=r.state.Combat.LevelID;model:=r.world.Life.Locations[level];radius:=model.PlayerRangeCells;if radius<1{radius=r.world.Visibility.PlayerRange};unit:=model.CellMM;if unit<1{unit=1000}
 rules:=r.world.CombatRuntime.Rules;rules.SightRangeMM=radius*unit
 space:=r.combatSpace(r.state.Combat)
 for _,raw:=range r.state.Combat.Events{
  if raw.Sequence<=r.state.CombatPublicSeq{continue};r.state.CombatPublicSeq=raw.Sequence
  from:=poses[raw.ActorID];from.Position=raw.From
  to:=poses[raw.TargetID];to.Position=raw.To
  seenFrom:=r.currentLevel()==level&&space.ActorVisible(observer,from,rules)
  seenTo:=r.currentLevel()==level&&space.ActorVisible(observer,to,rules)
  // Apply the path's steps and stance changes in event order. Coming around
  // the corner later in this SAME command does not reveal an earlier attacker.
  if p,ok:=poses[raw.ActorID];ok{
   switch raw.Type{case "move","move_stop","roll","fall_shift":p.Position=raw.To;case "prone":p.Prone=true;p.Crouched=false;case "crouch":p.Crouched=true;p.Prone=false;case "stand":p.Prone=false;p.Crouched=false
   // the weapon readied in this command is in the hand from its event on (the event names the carried item)
   case "equip":if it,ok:=r.state.Inventory.Items[raw.ItemID];ok{if w,known:=r.world.CombatRuntime.Weapons[it.Definition];known{p.Weapon=w}}}
   poses[p.ID]=p;if p.ID==playerActorID{observer=p}
  }
  if raw.Type=="down"||raw.Type=="dead"||raw.Type=="fall"{if p,ok:=poses[raw.TargetID];ok{p.Prone=true;p.Crouched=false;poses[p.ID]=p}}
  if r.currentLevel()!=level{continue}
  // An invisible explosion victim produces no hit count, damage or sequence
  // gap on the wire. The throw/detonation itself may still be observable.
  if raw.Type=="blast_hit"&&raw.TargetID!=playerActorID&&!seenTo{continue}
  if raw.ActorID!=playerActorID&&raw.TargetID!=playerActorID&&!seenFrom&&!seenTo{continue}
  event:=raw;event.Reason="";event.AmmoSpent=0;event.MedkitsSpent=0;event.WeaponUses=0;event.ItemsSpent=0;event.ArmorBlocked=0
  // the weapon a blow is struck with is seen with the blow (the client draws the blow with it; the fight's state is
  // unchanged): the one in the striker's hand at the blow's moment (his pose of this event), not after the command
  if (raw.Type=="attack"||raw.Type=="reaction")&&event.ItemID==""{
   weapon:="";if p,ok:=poses[raw.ActorID];ok{weapon=p.Weapon.ID}else if a:=r.state.Combat.Actor(raw.ActorID);a!=nil{weapon=a.Weapon.ID}
   if weapon!=""{event.ItemID=weapon}
  }
  if event.ActorID!=playerActorID&&!seenFrom{event.ActorID="";event.From=behavior.Cell{X:-1,Y:-1};event.ItemID=""}
  if event.TargetID!=playerActorID&&!seenTo{event.TargetID="";event.To=behavior.Cell{X:-1,Y:-1};event.Amount=0;event.Hit=false;event.BodyPart="";if event.Type=="wound"{event.Mode=""}}
  if event.TargetID!=playerActorID {switch event.Type{case "wound","condition","blocked","down","dead","weak","confused","care_done","stopped":event.ItemID=""}}
  r.state.CombatPublicSerial++;event.Sequence=r.state.CombatPublicSerial
  r.state.CombatPublicEvents=append(r.state.CombatPublicEvents,event)
  if len(r.state.CombatPublicEvents)>64{r.state.CombatPublicEvents=append([]behavior.CombatEvent(nil),r.state.CombatPublicEvents[len(r.state.CombatPublicEvents)-64:]...)}
 }
}

// Reuse the physical combat poses for the ordinary SceneAgents projection too;
// hiding only the combat panel would still expose the prone enemy in the world.
func(r *Runtime)combatPoseSight(from,to point,radius int)(bool,bool){
 if !r.state.Combat.Active||r.state.Combat.LevelID!=r.currentLevel(){return false,false}
 var target *behavior.Combatant
 for i:=range r.state.Combat.Actors{if r.state.Combat.Actors[i].Position==(behavior.Cell{X:to.X,Y:to.Y}){target=&r.state.Combat.Actors[i];break}}
 if target==nil{return false,false}
 observer:=behavior.Combatant{Position:behavior.Cell{X:from.X,Y:from.Y}}
 for _,a:=range r.state.Combat.Actors{if a.Position==observer.Position{observer=cloneCombatant(a);break}}
 unit:=r.world.Life.Locations[r.currentLevel()].CellMM;if unit<1{unit=1000};rules:=r.world.CombatRuntime.Rules;rules.SightRangeMM=radius*unit
 return r.combatSpace(r.state.Combat).ActorVisible(observer,*target,rules),true
}

// A playback certificate uses world millimetres, never navigation-array offsets.
// The conservative domain is visible, upright movement on one flat surface.
// Stairs, changes of deck/height, prone poses and uncertain geometry stay serial.
type combatPlaybackGeometry struct {
 locate func(behavior.Cell)(behavior.DeckPointMM,int,bool)
 visible func(string,behavior.Cell)bool
 radius func(string)(float64,bool)
 clear func(string,[]behavior.DeckPointMM,float64)bool
 hero behavior.DeckPointMM
 surface int
}
type combatPlaybackLane struct{ points []behavior.DeckPointMM; radius float64 }
func playbackPointSegment(p,a,b behavior.DeckPointMM)float64{
 dx,dy:=b.X-a.X,b.Y-a.Y;t:=0.0
 if d:=dx*dx+dy*dy;d>0{t=math.Max(0,math.Min(1,((p.X-a.X)*dx+(p.Y-a.Y)*dy)/d))}
 return math.Hypot(p.X-a.X-t*dx,p.Y-a.Y-t*dy)
}
func playbackCross(a,b,c behavior.DeckPointMM)float64{return (b.X-a.X)*(c.Y-a.Y)-(b.Y-a.Y)*(c.X-a.X)}
func playbackSegments(a,b,c,d behavior.DeckPointMM)float64{
 if playbackCross(a,b,c)*playbackCross(a,b,d)<=0&&playbackCross(c,d,a)*playbackCross(c,d,b)<=0&&math.Max(math.Min(a.X,b.X),math.Min(c.X,d.X))<=math.Min(math.Max(a.X,b.X),math.Max(c.X,d.X))&&math.Max(math.Min(a.Y,b.Y),math.Min(c.Y,d.Y))<=math.Min(math.Max(a.Y,b.Y),math.Max(c.Y,d.Y)){return 0}
 return math.Min(math.Min(playbackPointSegment(a,c,d),playbackPointSegment(b,c,d)),math.Min(playbackPointSegment(c,a,b),playbackPointSegment(d,a,b)))
}
func playbackInFan(p,h,a,b behavior.DeckPointMM)bool{
 if playbackCross(h,a,b)==0{return false}
 x,y,z:=playbackCross(h,a,p),playbackCross(a,b,p),playbackCross(b,h,p)
 return x>=0&&y>=0&&z>=0||x<=0&&y<=0&&z<=0
}
func playbackFanDistance(a,b,h,c,d behavior.DeckPointMM)float64{
 if playbackInFan(a,h,c,d)||playbackInFan(b,h,c,d){return 0}
 return math.Min(playbackSegments(a,b,h,c),math.Min(playbackSegments(a,b,h,d),playbackSegments(a,b,c,d)))
}
func playbackIndependent(a,b combatPlaybackLane,hero behavior.DeckPointMM)bool{
 for i:=1;i<len(a.points);i++{for j:=1;j<len(b.points);j++{
  p,q,u,v:=a.points[i-1],a.points[i],b.points[j-1],b.points[j];width:=a.radius+b.radius
  if playbackSegments(p,q,u,v)<=width||playbackFanDistance(p,q,hero,u,v)<=width||playbackFanDistance(u,v,hero,p,q)<=width{return false}
 }}
 return true
}
func(r *Runtime)combatPlaybackGeometry()combatPlaybackGeometry{
 cfg:=combatPlaybackGeometry{}
 s:=r.state.Combat;v:=r.world.Decks[s.LevelID];hero:=s.Actor(playerActorID)
 if v==nil||hero==nil||hero.Prone||hero.Crouched||r.world.CombatSpacing.BodyMM<=0{return cfg}
 locate:=func(at behavior.Cell)(behavior.DeckPointMM,int,bool){_,h,layer,ok:=v.Locate(at);points:=v.BodyLightPoints(at,behavior.Combatant{});p:=points[0];p.Z=float64(h);return p,layer,ok}
 observer,layer,ok:=locate(hero.Position);if !ok||layer<0{return cfg}
 width:=float64(max(r.world.CombatSpacing.BodyMM,r.world.CombatSpacing.FallWidthMM))/2
 rest:=float64(r.world.CombatSpacing.FallLengthMM)+width
 unsafe:=map[string]bool{};radii:=map[string]float64{}
 for _,a:=range s.Actors{radii[a.ID]=width;if a.Prone||a.Crouched||a.FallShifted{unsafe[a.ID]=true;radii[a.ID]=rest}}
 for _,e:=range s.Events{switch e.Type{case "prone","crouch","stand","roll","fall_shift":unsafe[e.ActorID]=true;radii[e.ActorID]=rest;case "down","dead","fall":unsafe[e.TargetID]=true;radii[e.TargetID]=rest}}
 type occupied struct{id string;a,b behavior.DeckPointMM;radius float64}
 var obstacles []occupied
 add:=func(id string,from,to behavior.Cell){if id==""{return};a,_,okA:=locate(from);b,_,okB:=locate(to);if !okA||!okB{return};radius:=radii[id];if radius<=0{radius=rest};if math.Min(a.Z,b.Z)>observer.Z+float64(r.world.CombatSpacing.FallLengthMM)||math.Max(a.Z,b.Z)+float64(r.world.CombatSpacing.FallLengthMM)<observer.Z{return};obstacles=append(obstacles,occupied{id,a,b,radius})}
 for _,a:=range s.Actors{add(a.ID,a.Position,a.Position)}
 // Unknown event-time occupancy cannot be reconstructed from final positions.
 // Keep the union of every published physical sweep, even outside this group.
 for _,e:=range s.Events{switch e.Type{case "move","move_stop","roll","fall_shift":add(e.ActorID,e.From,e.To)}}
 rules:=r.world.CombatRuntime.Rules
 cfg=combatPlaybackGeometry{locate:locate,hero:observer,surface:layer}
 cfg.radius=func(id string)(float64,bool){_,known:=radii[id];return radii[id],known&&!unsafe[id]}
 cfg.visible=func(id string,at behavior.Cell)bool{a:=s.Actor(id);if a==nil{return false};pose:=cloneCombatant(*a);pose.Position=at;return v.CombatRangeMM(hero.Position,at)<=rules.SightRangeMM&&r.combatPoseProtection(s.LevelID,hero.Position,at,*hero,pose,"")<1}
 cfg.clear=func(id string,points []behavior.DeckPointMM,radius float64)bool{
  for _,body:=range obstacles{if body.id==id{continue};for i:=1;i<len(points);i++{if playbackSegments(points[i-1],points[i],body.a,body.b)<=radius+body.radius{return false}}};return true
 }
 return cfg
}
// Full authoritative events retain unseen interrupts as barriers. Physical
// certificates affect presentation only: execution, RNG, AP and saves stay serial.
func combatPlaybackGroups(events []behavior.CombatEvent,currentTurn int64,cfg combatPlaybackGeometry)map[int64]int64{
 groups:=map[int64]int64{}
 if cfg.locate==nil||cfg.visible==nil||cfg.radius==nil{return groups}
 type turn struct{id int64;actor string;cells []behavior.Cell;safe,moved,ended bool;lane combatPlaybackLane}
 turns:=[]turn{};lastHero:=-1
 for index,e:=range events{if e.ActorID==playerActorID||e.TargetID==playerActorID{lastHero=index}}
 for index,e:=range events{
  if len(turns)==0||turns[len(turns)-1].id!=e.Turn{turns=append(turns,turn{id:e.Turn,actor:e.ActorID,safe:e.Turn>0&&e.ActorID!=""&&e.ActorID!=playerActorID&&index>lastHero})}
  q:=&turns[len(turns)-1];if q.actor!=e.ActorID||e.TargetID!=""&&e.TargetID!=e.ActorID{q.safe=false}
  switch e.Type{case "move":if q.ended||len(q.cells)>0&&q.cells[len(q.cells)-1]!=e.From{q.safe=false};q.moved=true;q.cells=append(q.cells,e.From,e.To);case "end":q.ended=true;default:q.safe=false}
 }
 for i:=range turns{
  q:=&turns[i];if q.id<currentTurn{q.ended=true};if !q.safe||!q.moved||!q.ended{q.safe=false;continue}
  radius,ok:=cfg.radius(q.actor);if !ok||radius<=0{q.safe=false;continue};q.lane.radius=radius
  for _,cell:=range q.cells{p,layer,known:=cfg.locate(cell);if !known||layer<0||layer!=cfg.surface||p.Z!=cfg.hero.Z||!cfg.visible(q.actor,cell){q.safe=false;break};q.lane.points=append(q.lane.points,p)}
  if q.safe&&cfg.clear!=nil&&!cfg.clear(q.actor,q.lane.points,radius){q.safe=false}
 }
 if len(turns)>0&&len(events)>0&&events[0].Sequence>1{turns[0].safe=false}
 for i:=0;i<len(turns);{
  first:=turns[i];if !first.safe{i++;continue};j:=i+1
  for ;j<len(turns);j++{next:=turns[j];if !next.safe||next.id!=turns[j-1].id+1{break};independent:=true
   for k:=i;k<j&&independent;k++{if turns[k].actor==next.actor||!playbackIndependent(turns[k].lane,next.lane,cfg.hero){independent=false}}
   if !independent{break}
  }
  if j-i>1{for k:=i;k<j;k++{groups[turns[k].id]=first.id}};i=j
 }
 return groups
}
