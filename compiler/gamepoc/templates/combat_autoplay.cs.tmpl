    case 4:if(loadingActive||!CanSend()||Time.unscaledTime<combatAutoSaveAt+2f||state.Combat==null||!state.Combat.Active)return;
     string now=CombatAutoSnapshot();combatAutoSaveResult="{\"saved\":"+CombatJ(combatAutoSnap)+",\"loaded\":"+CombatJ(now)+",\"equal\":"+(now==combatAutoSnap?"true":"false")+"}";
     CombatAutoNote("loaded: "+now+(now==combatAutoSnap?" == saved":" != saved"));CombatAutoShot("after-load");combatAutoSave=-1;
     // The player's own memory goes back with the slot: what was undone by the load may be done again.
     combatAutoHealed=combatAutoSavedHealed;combatAutoGuarded=combatAutoSavedGuarded;combatAutoAttacks=combatAutoSavedAttacks;combatAutoFlee=combatAutoSavedFlee;combatAutoOver=false;return;
   }
  }
  string CombatAutoSnapshot(){var sb=new StringBuilder();sb.Append(state.Combat.EncounterId).Append(" turn ").Append(state.Combat.Turn);foreach(var a in state.Combat.Actors){sb.Append(" | ").Append(a.Id).Append(" @").Append(a.X).Append(',').Append(a.Y).Append(" ").Append(a.Stance);if(a.Id=="char.hero")sb.Append(" wounds ").Append(string.Join(" / ",a.BodyLines)).Append(" ap ").Append(a.Ap).Append(" bleed ").Append(a.Bleeding).Append(" ").Append(a.HeldItem);}return sb.ToString();}
  void CombatAutoShot(string name){if(combatAutoDir==null)return;combatAutoKey++;string path=Path.Combine(combatAutoDir,"key-"+combatAutoKey.ToString("00")+"-"+name+".png");ScreenCapture.CaptureScreenshot(path);CombatAutoNote("key shot "+Path.GetFileName(path));}
  internal void CombatAutoShotLater(string name){if(combatAutoDir!=null)StartCoroutine(CombatAutoShotAfter(name));}
  IEnumerator CombatAutoShotAfter(string name){yield return new WaitForSecondsRealtime(1.2f);CombatAutoShot(name);}
  IEnumerator CombatAutoCapture(string path){yield return new WaitForEndOfFrame();var tex=ScreenCapture.CaptureScreenshotAsTexture();try{File.WriteAllBytes(path,tex.EncodeToJPG(88));}finally{Destroy(tex);}}
  void CombatAutoFinish(){
   combatAutoDone=true;
   string json="{\"content_hash\":"+CombatJ(state==null?"":state.ContentHash)+",\"final_game_seconds\":"+(state==null?0:state.GameSeconds)+",\"final_own_lines\":["+string.Join(",",state==null||state.PlayerCondition==null?new List<string>():new List<string>(state.PlayerCondition.BodyLines).ConvertAll(CombatJ))+"],\"scene\":"+CombatJ(PlayableView()==null?"":PlayableView().Id)+",\"seconds\":"+CombatF(CombatAutoTime)+",\"frames\":"+combatAutoFrame+",\"hero_turns\":"+combatAutoHeroTurns+",\"attacks\":"+combatAutoAttacks+",\"beats_played\":"+CombatPlayedBeats+",\"pose_feet_vs_root_deg\":{"+string.Join(",",new List<string>(combatAutoPoseFacing.Keys).ConvertAll(k=>CombatJ(k)+":"+CombatF(combatAutoPoseFacing[k])))+"},\"facing_max_deg\":"+CombatF(combatAutoFacingMax)+",\"facing_ok\":"+(combatAutoFacingMax<=(CombatLook()==null?7.6f:CombatLook().facing_tolerance_deg)?"true":"false")+",\"missing_states\":["+string.Join(",",new List<string>(combatMissingStates).ConvertAll(CombatJ))+"],\"save_load\":"+(combatAutoSaveResult==""?"null":combatAutoSaveResult)+",\"log\":["+combatAutoLog+"],\"beats\":["+string.Join(",",combatAutoBeats)+"],\"impacts\":["+string.Join(",",combatAutoImpacts)+"],\"panels\":["+string.Join(",",combatAutoPanels)+"]}";
   File.WriteAllText(Path.Combine(combatAutoDir,"motion.csv"),combatAutoMotion.ToString());
   File.WriteAllText(Path.Combine(combatAutoDir,"report.json"),json);File.WriteAllText(Path.Combine(combatAutoDir,"frames.tsv"),combatAutoFrames.ToString());Debug.Log("COMBAT_AUTOPLAY_DONE "+combatAutoDir);
   StartCoroutine(CombatAutoQuit());
  }
  IEnumerator CombatAutoQuit(){yield return new WaitForSecondsRealtime(1.5f);Application.Quit();}
 }
