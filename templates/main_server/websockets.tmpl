{{ define "main_server_websockets" }}
	{{- if .HasNats }}
	if natsClient != nil {
		{{- range $svcName, $events := .WSEventMap }}
		{{- range $evtName, $evtFields := $events }}
		{{- $roomField := RoomFieldForEventIR $.EndpointsIR $.ServicesIR $svcName $evtName }}
		{{- $hasRoomField := HasEventFieldIR $.EventPayloads $evtName $roomField }}
		if _, err := natsClient.SubscribeRaw("{{ $evtName }}", func(data []byte) (handlerErr error) {
			// A panic becomes the handler's error: logged with its stack and
			// counted (ang_panics_recovered_total) instead of killing the process.
			defer func() {
				if r := recover(); r != nil {
					handlerErr = logger.PanicError("nats-ws", "{{ $evtName }}", r)
				}
			}()
			var event domain.{{ ExportName $evtName }}
			if err := json.Unmarshal(data, &event); err != nil {
				return err
			}
			{{- if and $roomField $hasRoomField }}
			transport.Broadcast{{ $evtName }}(event.{{ $roomField | ExportName }}, event)
			{{- else }}
			transport.Broadcast{{ $evtName }}("", event)
			{{- end }}
			return nil
		}); err != nil {
			log.Error("Failed to subscribe to {{ $evtName }}", "error", err)
		}
		{{- end }}
		{{- end }}
		{{- if HasLiveRoomsIR $.EndpointsIR }}
		// Live rooms: per-viewer snapshots from JetStream (see ws_live.go).
		transport.StartLiveRooms(ctx, natsClient.Conn(), log)
		{{- end }}
	}
	{{- end }}
{{ end }}
