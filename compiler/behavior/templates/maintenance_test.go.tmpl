func TestMaintenanceAbsentCrewExpiresFromLastProgressAndRecovers(t *testing.T){
 for _,phase:=range []string{"repairing","testing"}{t.Run(phase,func(t *testing.T){
  m,s:=maintenanceProgressFixture(phase);s.Actor("one").Position=Cell{0,0};s.Actor("one").Arrived=false
  // No work can advance while one member is physically absent. The old
  // assignment date must not expire a job that was progressing a moment ago.
  s.Seconds=129;s.Tick=129;s.planMaintenance(m,1);s.finishMaintenanceTick(m,1,nil)
  if u:=s.Maintenance.Units[0];len(u.Crew)!=2||u.Phase!=phase||u.Elapsed!=3||u.LastProgressAt!=100{t.Fatalf("premature timeout or remote work: %+v",u)}
  raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var restored LifeState;if err=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)}
  for _,state:=range []*LifeState{&s,&restored}{state.Seconds=130;state.Tick=130;state.planMaintenance(m,1);if err:=state.Validate(m,130);err!=nil{t.Fatal(err)}}
  if !reflect.DeepEqual(s,restored){t.Fatal("stalled-job timeout changed after save/load")}
  if u:=s.Maintenance.Units[0];len(u.Crew)!=0||u.Phase!="waiting_crew"||u.Elapsed!=0||!u.PartsInstalled{t.Fatalf("absent crew retained forever or installed part lost: %+v",u)}
  for tick:=int64(131);tick<400;tick++{s.AdvanceWithMaintenance(m,tick,func(MaintenanceAsset,string)error{t.Fatal("consumed second part after interruption");return nil});if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)};if s.Maintenance.Units[0].Replacements==1{return}}
  t.Fatalf("released crew could not recover job: %+v",s.Maintenance.Units[0])
 })}
}

