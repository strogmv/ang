// Code generated by ANG. Physical packs, partial reloads, custody and wire replay.
package poc

import (
	"reflect"
	"testing"

	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

const combatFixtureAmmoPack = "fixture.combat.ammo_pack"
const combatFixtureEmptyPack = "fixture.combat.empty_pack"

func combatAmmoPackFixture(t *testing.T) (*Runtime, *connection, string, map[string]string) {
	t.Helper()
	r, c, target := combatLifeFixture(t, true)
	ids := combatPhysicalFixture(t, r, target, false)
	m := r.world.Inventory
	m.Definitions[combatFixtureAmmoPack] = inv.Definition{ID: combatFixtureAmmoPack, Name: "test ten-round clip", Carrier: "physical", Mass: 40, Volume: 30, StackLimit: 20}
	m.Definitions[combatFixtureEmptyPack] = inv.Definition{ID: combatFixtureEmptyPack, Name: "test empty spring clip", Carrier: "physical", Mass: 30, Volume: 20, StackLimit: 20}
	// Keep the incompatible, foreign, locked and second-gun rounds. The only
	// accessible reserve for the equipped gun is two actual packed clips.
	sources := make([]inv.Source, 0, len(m.Sources)+4)
	for _, src := range m.Sources {
		if src.ID != "combat.test.loaded" && src.ID != "combat.test.reserve" {
			sources = append(sources, src)
		}
	}
	grade := inv.Grade{Quality: 4, Provenance: "heirloom"}
	for _, p := range []struct {
		name, owner, store string
		n                  int64
	}{
		{"pack", playerActorID, inv.ActorStore(playerActorID), 2},
		{"foreign_pack", target, inv.ActorStore(playerActorID), 1},
		{"locked_pack", playerActorID, inv.ItemStore(ids["bag"]), 1},
		{"other_gun_pack", playerActorID, inv.ItemStore(ids["othergun"]), 1},
	} {
		name := "combat.pack.test." + p.name
		ids[p.name] = inv.InstanceID(name, 0, 0)
		sources = append(sources, inv.Source{ID: name, Definition: combatFixtureAmmoPack, Quantity: p.n, Condition: 750000, Owner: p.owner, Location: inv.Location{Kind: "store", Store: p.store}, Grade: grade})
	}
	m.Sources = sources
	r.world.Inventory = m
	r.lifeInventory = lifeInventoryCache{}
	var err error
	r.state.Inventory, err = inv.New(r.inventoryModelFor(true), r.state.Seed)
	if err != nil {
		t.Fatal(err)
	}
	locked := r.state.Inventory.Stores[inv.ItemStore(ids["bag"])]
	locked.Locked = true
	r.state.Inventory.Stores[locked.ID] = locked
	if r.world.CombatRuntime.AmmoPacks == nil {
		r.world.CombatRuntime.AmmoPacks = map[string]combatAmmoPack{}
	}
	r.world.CombatRuntime.AmmoPacks[combatFixtureAmmoPack] = combatAmmoPack{AmmoDefinition: combatFixtureRound, Rounds: 10, EmptyDefinition: combatFixtureEmptyPack}
	if err := r.world.CombatRuntime.ValidateInventory(r.inventoryModelFor(true)); err != nil {
		t.Fatal(err)
	}
	return r, c, target, ids
}

func combatPhysicalMassVolume(r *Runtime, s inv.State) (mass, volume int64) {
	for _, i := range s.Items {
		d := r.world.Inventory.Definitions[i.Definition]
		mass += i.Quantity * d.Mass
		volume += i.Quantity * d.Volume
	}
	return mass, volume
}

func TestCombatAmmoPacksPartialReloadKeepsRemainderCarrierAndFiniteRounds(t *testing.T) {
	r, _, _, ids := combatAmmoPackFixture(t)
	a := behavior.Combatant{ID: playerActorID}
	r.refreshCombatEquipment(r.state.Inventory, &a)
	if a.Ammo != 0 || a.ReserveAmmo != 20 {
		t.Fatalf("packed physical projection: %d loaded / %d reserve", a.Ammo, a.ReserveAmmo)
	}
	options := r.combatEquipmentOptions(playerActorID)
	found := false
	for _, option := range options {
		if option.ID == ids["othergun"] {
			found = true
			if option.ReserveAmmo != 20 {
				t.Fatal("equipment planner omitted packed reserve")
			}
		}
	}
	if !found {
		t.Fatal("real carried second firearm missing")
	}
	before := r.state.Inventory.Clone()
	mass, volume := combatPhysicalMassVolume(r, before)
	if err := r.reloadPhysicalCombat(&r.state.Inventory, playerActorID, 6); err != nil {
		t.Fatal(err)
	}
	if afterMass, afterVolume := combatPhysicalMassVolume(r, r.state.Inventory); afterMass != mass || afterVolume != volume {
		t.Fatal("unpacking changed physical mass or volume")
	}
	if r.state.Inventory.Items[ids["pack"]].Quantity != 1 || combatPhysicalQuantity(r.state.Inventory, combatFixtureEmptyPack, "") != 1 || combatPhysicalQuantity(r.state.Inventory, combatFixtureRound, inv.ItemStore(ids["gun"])) != 6 || r.combatReserveAmmo(r.state.Inventory, playerActorID, combatFixtureRound) != 14 {
		t.Fatal("partial reload lost a clip, its unused needles or its empty carrier")
	}
	for _, i := range r.state.Inventory.Items {
		if i.Origin != "combat.pack.test.pack" {
			continue
		}
		if i.Grade != before.Items[ids["pack"]].Grade || i.Condition != 750000 || i.Owner != playerActorID {
			t.Fatal("unpacking lost source grade, condition, provenance or ownership")
		}
	}
	// Same accepted input on the same saved inventory produces the same instance
	// identities, cursor and custody, including split remainder and empty shell.
	replayed := before.Clone()
	if err := r.reloadPhysicalCombat(&replayed, playerActorID, 6); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(replayed, r.state.Inventory) {
		t.Fatal("reloaded physical inventory diverged after replay")
	}
	consume := func(n int) {
		t.Helper()
		if err := r.consumeCombatStock(&r.state.Inventory, playerActorID, combatFixtureRound, n, func(i inv.Item) bool { return i.Location.Store == inv.ItemStore(ids["gun"]) }); err != nil {
			t.Fatal(err)
		}
	}
	consume(6)
	for _, n := range []int{6, 6, 2} {
		if err := r.reloadPhysicalCombat(&r.state.Inventory, playerActorID, n); err != nil {
			t.Fatal(err)
		}
		consume(n)
	}
	if _, exists := r.state.Inventory.Items[ids["pack"]]; exists || r.combatReserveAmmo(r.state.Inventory, playerActorID, combatFixtureRound) != 0 || combatPhysicalQuantity(r.state.Inventory, combatFixtureEmptyPack, "") != 2 {
		t.Fatal("two clips did not provide exactly twenty usable rounds and two empty carriers")
	}
	final := r.state.Inventory.Clone()
	if err := r.reloadPhysicalCombat(&r.state.Inventory, playerActorID, 1); err == nil || !reflect.DeepEqual(final, r.state.Inventory) {
		t.Fatal("empty reserve yielded a free round or changed failed reload state")
	}
	for _, name := range []string{"foreign_pack", "locked_pack", "other_gun_pack"} {
		if r.state.Inventory.Items[ids[name]] != before.Items[ids[name]] {
			t.Fatalf("unpacking touched protected pack %s", name)
		}
	}
}

func TestCombatAmmoPacksWireReloadBurstAndDuplicateRequestSpendOnce(t *testing.T) {
	r, c, target, ids := combatAmmoPackFixture(t)
	combatStart(t, r, c, target)
	combatPhysicalWire(t, r, c, "ammo.pack.reload", "reload", "")
	q := &pb.PocCombatCommand{RequestId: "ammo.pack.burst", Action: "attack", Mode: "burst", TargetId: target, ExpectedTurn: r.state.Combat.Turn}
	result, _ := combatWire(t, r, c, q)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	if combatPhysicalQuantity(r.state.Inventory, combatFixtureRound, inv.ItemStore(ids["gun"])) != 3 || r.state.Inventory.Items[ids["pack"]].Quantity != 1 || r.state.Combat.Actor(playerActorID).ReserveAmmo != 14 {
		t.Fatal("accepted burst did not consume three loaded needles from its real opened clip")
	}
	before, encounter := r.state.Inventory.Clone(), r.state.Combat.Clone()
	result, _ = combatWire(t, r, c, q)
	if !result.Ok || !reflect.DeepEqual(before, r.state.Inventory) || !reflect.DeepEqual(encounter, r.state.Combat) {
		t.Fatal("duplicate attack spent pack ammunition or wear twice")
	}
}

func TestCombatAmmoPacksLockedReservedAndCapacityFailureAreAtomic(t *testing.T) {
	for _, test := range []string{"reserved", "locked-magazine", "capacity", "insufficient"} {
		t.Run(test, func(t *testing.T) {
			r, _, _, ids := combatAmmoPackFixture(t)
			switch test {
			case "reserved":
				i := r.state.Inventory.Items[ids["pack"]]
				if err := r.state.Inventory.ReserveBatch(r.inventoryModelFor(true), []inv.Reservation{{ID: "pack.reservation", Item: i.ID, Actor: playerActorID, Purpose: "test reserve", Quantity: i.Quantity, ExpectedRevision: i.Revision, CreatedTick: r.state.Inventory.Clock, ExpiresTick: r.state.Inventory.Clock + 10}}); err != nil {
					t.Fatal(err)
				}
				if r.combatReserveAmmo(r.state.Inventory, playerActorID, combatFixtureRound) != 0 {
					t.Fatal("reserved pack still counted as usable ammunition")
				}
			case "locked-magazine":
				store := r.state.Inventory.Stores[inv.ItemStore(ids["gun"])]
				store.Locked = true
				r.state.Inventory.Stores[store.ID] = store
			case "capacity":
				store := r.state.Inventory.Stores[inv.ActorStore(playerActorID)]
				store.Capacity.Stacks = 0
				for _, i := range r.state.Inventory.Items {
					if i.Location.Store == store.ID {
						store.Capacity.Stacks++
					}
				}
				r.world.Inventory.Stores[store.ID], r.state.Inventory.Stores[store.ID] = store, store
				r.lifeInventory = lifeInventoryCache{}
			case "insufficient":
				if err := r.state.Inventory.Consume(r.inventoryModelFor(true), playerActorID, ids["pack"], 2); err != nil {
					t.Fatal(err)
				}
			}
			before := r.state.Inventory.Clone()
			if err := r.reloadPhysicalCombat(&r.state.Inventory, playerActorID, 6); err == nil || !reflect.DeepEqual(before, r.state.Inventory) {
				t.Fatal("rejected reload committed pack, needles, shell, cursor or revision")
			}
		})
	}
}

func TestCombatAmmoPackCatalogRejectsNonConservingOrRecursiveContracts(t *testing.T) {
	r, _, _, _ := combatAmmoPackFixture(t)
	for _, test := range []string{"wrong-count", "recursive-ammo", "recursive-shell", "missing-shell", "container-ammo"} {
		t.Run(test, func(t *testing.T) {
			c := r.world.CombatRuntime
			c.AmmoPacks = map[string]combatAmmoPack{combatFixtureAmmoPack: {AmmoDefinition: combatFixtureRound, Rounds: 10, EmptyDefinition: combatFixtureEmptyPack}}
			m := r.inventoryModelFor(true)
			p := c.AmmoPacks[combatFixtureAmmoPack]
			switch test {
			case "wrong-count":
				p.Rounds = 9
			case "recursive-ammo":
				p.AmmoDefinition = combatFixtureAmmoPack
			case "recursive-shell":
				p.EmptyDefinition = combatFixtureAmmoPack
			case "missing-shell":
				p.EmptyDefinition = "no.such.carrier"
			case "container-ammo":
				p.AmmoDefinition = combatFixtureBag
			}
			c.AmmoPacks[combatFixtureAmmoPack] = p
			if err := c.ValidateInventory(m); err == nil {
				t.Fatal("accepted ambiguous or nonconserving physical ammunition pack")
			}
		})
	}
}
