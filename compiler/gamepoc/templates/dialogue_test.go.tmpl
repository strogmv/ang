// Every answer of the custody changes the world by its data: the outcome, the rating (refusing, the gate), the trust of
// the person (the custody's cost; a heard lie costs more), and who leads him (a forced one goes under the guard).
func TestDialogueAnswersChangeTheWorldByTheirData(t *testing.T) {
	probe := dialogueCustody(t, nil)
	e := probe.world.CalendarEncounter
	type answer struct {
		id     string
		failed bool
	}
	cases := []answer{}
	for _, c := range e.Choices {
		cases = append(cases, answer{c.ID, false})
		if c.Check != nil {
			cases = append(cases, answer{c.ID, true})
		}
	}
	for _, a := range cases {
		name := a.id
		if a.failed {
			name += "/failed"
		}
		t.Run(name, func(t *testing.T) {
			r := dialogueCustody(t, nil)
			var c EncounterChoice
			for _, choice := range e.Choices {
				if choice.ID == a.id {
					c = choice
				}
			}
			if c.RequiresContact {
				r.state.CalendarEncounter.Met = true
			}
			if c.Check != nil {
				chance := r.dialogueChance(*c.Check)
				for seed := int64(1); ; seed++ {
					if (dialogueDie(r.state.Seed, seed, e.ID, c.ID, 1) >= chance) == a.failed {
						r.state.CheckSeed = seed
						break
					}
				}
			}
			rating := r.state.Crafting.Law.Trust
			trust := r.state.Life.RelationTo(r.world.Life, e.Actor, playerActorID)
			if err := r.encounterCommand(&pb.PocLifeCommand{Action: "encounter_choice", Destination: c.ID}); err != nil {
				t.Fatal(err)
			}
			s := r.state.CalendarEncounter
			outcome, cost := c.Outcome, 0.0
			if a.failed {
				outcome, cost = c.Fail.Outcome, c.Fail.TrustCost
			}
			if outcome == "willing" || outcome == "forced" {
				cost += e.Duty.TrustCost
			}
			if s.Outcome != outcome {
				t.Fatalf("outcome %s, want %s", s.Outcome, outcome)
			}
			wantRating := rating
			if outcome == "refuse" || outcome == "escape" {
				wantRating = max(0, rating-e.Duty.RatingPenalty)
			}
			if r.state.Crafting.Law.Trust != wantRating {
				t.Fatalf("rating %d, want %d", r.state.Crafting.Law.Trust, wantRating)
			}
			if got := r.state.Life.RelationTo(r.world.Life, e.Actor, playerActorID); got < max(-1, trust+cost)-1e-9 || got > max(-1, trust+cost)+1e-9 {
				t.Fatalf("trust %.3f, want %.3f (before %.3f, cost %.3f)", got, max(-1, trust+cost), trust, cost)
			}
			// forced or refused: the guard leads him (alone after a refusal); willing walks, escape heads for the gate
			if led := r.guardEscortTarget(e.Guard); (outcome == "forced" || outcome == "refuse") != (led == e.Actor) {
				t.Fatalf("outcome %s: the guard leads %q", outcome, led)
			}
			if a.failed && cost >= e.Duty.TrustCost {
				t.Fatal("a heard lie costs no more trust than the custody")
			}
		})
	}
}

// A new game draws its own check value; a fixed one is taken only in a debug build (proofs).
func TestDialogueNewGameCheckValue(t *testing.T) {
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	c := &connection{out: make(chan *pb.ServerMessage, 256), stop: make(chan struct{})}
	games := 0
	start := func(value int64) {
		// each its own request: a repeated request id is answered from its receipt, not run again
		games++
		r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: fmt.Sprintf("check.new.%d", games), Scenario: "life", Seed: 777, CheckSeed: value}}}})
	}
	r.canonicalWorld.Config.DebugPerception = true
	start(5)
	if r.state.CheckSeed != 5 {
		t.Fatalf("a debug build did not take the fixed value: %d", r.state.CheckSeed)
	}
	start(0)
	drawn := r.state.CheckSeed
	if drawn <= 0 || drawn == 5 {
		t.Fatalf("a new game did not draw its own value: %d", drawn)
	}
	r.canonicalWorld.Config.DebugPerception = false
	epoch := r.state.Epoch
	start(9)
	if r.state.CheckSeed == 9 || r.state.Epoch != epoch {
		t.Fatal("a release build took a fixed check value")
	}
	// a save from before the value: derived from its epoch, the same at every load
	s := r.snapshotState()
	s.CheckSeed = 0
	migrateCheckSeed(&s)
	again := r.snapshotState()
	again.CheckSeed = 0
	migrateCheckSeed(&again)
	if s.CheckSeed <= 0 || s.CheckSeed != again.CheckSeed {
		t.Fatalf("an old save's check value is not stable: %d %d", s.CheckSeed, again.CheckSeed)
	}
	other := r.snapshotState()
	other.CheckSeed, other.Epoch = 0, other.Epoch+"x"
	migrateCheckSeed(&other)
	if other.CheckSeed == s.CheckSeed {
		t.Fatal("two games derived the same check value")
	}
}

// Asking a plain question again writes nothing twice: its answer is already in the log.
func TestDialogueAskingAgainWritesNothingTwice(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	if len(e.Questions) == 0 {
		t.Skip("no questions")
	}
	q := e.Questions[0]
	if err := r.encounterCommand(&pb.PocLifeCommand{Action: "encounter_choice", Destination: q.ID}); err != nil {
		t.Fatal(err)
	}
	lines := len(r.state.CalendarEncounter.Talk.Lines)
	for i := 0; i < 80; i++ {
		if err := r.encounterCommand(&pb.PocLifeCommand{Action: "encounter_choice", Destination: q.ID}); err != nil {
			t.Fatal(err)
		}
	}
	if got := len(r.state.CalendarEncounter.Talk.Lines); got != lines {
		t.Fatalf("asking again wrote %d more lines", got-lines)
	}
}
