}

// sanitaryPhaseSpan: the length of a timed phase — real seconds for the hero; for a person of the Life the same in game
// seconds at the calendar rate the phase began at (a save may be made after the rate changed).
func sanitaryPhaseSpan(p sanitaryUser, duration float64, rate int64) bool {
	span := p.PhaseEndNS - p.PhaseStartNS
	if span == int64(duration*1e9) {
		return true
	}
	if p.ActorID == playerActorID {
		return false
	}
	for k := int64(2); k <= max(rate, 120); k++ {
		if span == int64(duration/float64(k)*1e9) {
			return true
		}
	}
	return false
}

func (r *Runtime) sanitaryPhase(p *sanitaryUser, phase string, duration float64) {
