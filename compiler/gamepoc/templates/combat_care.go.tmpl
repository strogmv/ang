// Code generated by ANG. Persistent injuries follow the physical Life clock.
package poc

import (
	"angelsdemons/server/internal/behavior"
	"errors"
	"sort"
)

type combatCareState struct {
	Clocks map[string]int64 `json:"clocks,omitempty"`
}

func (s combatCareState) Clone() combatCareState {
	if s.Clocks != nil {
		m := make(map[string]int64, len(s.Clocks))
		for id, at := range s.Clocks {
			m[id] = at
		}
		s.Clocks = m
	}
	return s
}

// Called when an injury is first stored. Existing nonparticipants retain their
// fractional interval; repeated presentation/sync calls cannot stop blood loss.
func (r *Runtime) combatCareTrack() {
	if len(r.state.CombatRoster) == 0 {
		return
	}
	if r.state.CombatCare.Clocks == nil {
		r.state.CombatCare.Clocks = map[string]int64{}
	}
	for id, c := range r.state.CombatRoster {
		_, known := r.state.CombatCare.Clocks[id]
		if !known || r.state.Combat.Active && r.state.Combat.Actor(id) != nil {
			r.state.CombatCare.Clocks[id] = r.state.Life.Seconds
		}
		if !r.state.Combat.Active || r.state.Combat.Actor(id) == nil {
			r.combatCareHold(c)
		}
	}
}

func (r *Runtime) combatCareOnFloor(id string) (behavior.Cell, bool) {
	if a := r.state.Life.Actor(id); a != nil {
		return a.Position, a.OnFloor()
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.ID == id {
			return a.Position, a.Trip == nil && (a.Materialized || a.CombatHold)
		}
	}
	return behavior.Cell{}, false
}

func (r *Runtime) combatCareHold(c behavior.Combatant) {
	held := !c.Able() || c.StunTurns > 0
	activity, label := "stunned", "ui.combat.stunned"
	if c.HP <= 0 {
		activity, label = "down", "ui.combat.down"
	} else if c.Surrendered {
		activity, label = "surrendered", "ui.combat.surrendered"
	}
	if a := r.state.Life.Actor(c.ID); a != nil {
		if !a.OnFloor() {
			return
		}
		was := a.CombatHold
		a.CombatHold = held
		if held {
			a.Safety = nil
			a.Brain.InterruptService()
			a.Path = nil
			a.PendingPath = nil
			a.Goal = a.Position
			a.Activity = activity
			a.Label = label
			a.MoveStartTick = r.lifeMotionTick()
		} else if was {
			a.Arrived = c.ID == playerActorID
			a.Activity = "rest"
			a.Label = "ui.combat.finished"
			a.Brain.NextDecision = 0
		}
		return
	}
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if a.ID != c.ID {
			continue
		}
		if a.Trip != nil || !a.Materialized && !a.CombatHold {
			return
		}
		was := a.CombatHold
		a.CombatHold = held
		if held {
			a.Safety = nil
			a.Brain.InterruptService()
			a.Path = nil
			a.Goal = a.Position
			a.Activity = activity
			a.MoveStartTick = r.lifeMotionTick()
		} else if was {
			a.Arrived = false
			a.Activity = "rest"
			a.Brain.NextDecision = 0
		}
		return
	}
}

// Saturating recovery avoids products involving arbitrarily long elapsed time.
func combatCareRecover(value, ceiling, rate int, ticks int64) int {
	if value >= ceiling || rate <= 0 || ticks <= 0 {
		return value
	}
	needed := ceiling - value
	if ticks >= int64((needed+rate-1)/rate) {
		return ceiling
	}
	return value + int(ticks)*rate
}
func combatCareLoss(c *behavior.Combatant, ticks int64) {
	if c.HP <= 0 || c.Bleeding <= 0 || ticks <= 0 {
		return
	}
	damage := c.HP
	if ticks < int64((c.HP+c.Bleeding-1)/c.Bleeding) {
		damage = int(ticks) * c.Bleeding
	}
	c.HP -= damage
	c.Morale = max(0, c.Morale-(damage*50+c.MaxHP-1)/c.MaxHP)
	if c.HP == 0 {
		c.Bleeding = 0
		c.AP = 0
		c.Prone = true
		c.Crouched = false
	}
}

func (r *Runtime) combatCarePatch(c *behavior.Combatant) error {
	for _, id := range r.world.CombatRuntime.MedicalDefinitions {
		if r.combatCount(r.state.Inventory, c.ID, id, nil) < 1 {
			continue
		}
		if err := r.consumeCombatStock(&r.state.Inventory, c.ID, id, 1, nil); err != nil {
			return err
		}
		c.Bleeding = max(0, c.Bleeding-r.world.CombatRuntime.Rules.BandageAmount)
		r.refreshCombatEquipment(r.state.Inventory, c)
		return nil
	}
	return errors.New("carried medical stock changed during care")
}

func (r *Runtime) advanceCombatCare() error {
	r.combatCareTrack()
	interval := r.world.CombatRuntime.InjuryIntervalSeconds
	if interval <= 0 {
		return nil
	}
	ids := make([]string, 0, len(r.state.CombatRoster))
	for id := range r.state.CombatRoster {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		if r.state.Combat.Active && r.state.Combat.Actor(id) != nil {
			r.state.CombatCare.Clocks[id] = r.state.Life.Seconds
			continue
		}
		position, onFloor := r.combatCareOnFloor(id)
		// Travel and cold population do not acquire a body at a historical cell.
		// Their elapsed injury time is caught up when they physically arrive/materialize.
		if !onFloor {
			continue
		}
		c := cloneCombatant(r.state.CombatRoster[id])
		c.Position = position
		r.combatCareHold(c)
		at := r.state.CombatCare.Clocks[id]
		ticks := (r.state.Life.Seconds - at) / interval
		if ticks <= 0 {
			continue
		}
		r.state.CombatCare.Clocks[id] = at + ticks*interval
		remaining := ticks
		r.refreshCombatEquipment(r.state.Inventory, &c)
		// Only real, conscious NPCs can use their own finite carried materials.
		// Stunned/no-stock spans are aggregated; the loop is bounded by physical
		// medkits (<=10000), not by the number of seconds or elapsed days.
		for remaining > 0 && c.HP > 0 && c.Bleeding > 0 {
			if id == playerActorID || c.Surrendered || c.Medkits < 1 || r.world.CombatRuntime.Rules.BandageAmount < 1 || c.StunTurns > 0 {
				span := remaining
				if id != playerActorID && !c.Surrendered && c.Medkits > 0 && r.world.CombatRuntime.Rules.BandageAmount > 0 && c.StunTurns > 0 {
					span = min(span, int64(c.StunTurns))
				}
				combatCareLoss(&c, span)
				c.StunTurns = max(0, c.StunTurns-int(min(span, int64(c.StunTurns))))
				remaining -= span
				continue
			}
			combatCareLoss(&c, 1)
			remaining--
			if c.HP > 0 {
				if err := r.combatCarePatch(&c); err != nil {
					return err
				}
			}
		}
		c.StunTurns = max(0, c.StunTurns-int(min(remaining, int64(c.StunTurns))))
		rules := r.world.CombatRuntime.Rules
		c.Suppression = rules.MaxSuppression - combatCareRecover(rules.MaxSuppression-c.Suppression, rules.MaxSuppression, rules.SuppressionRecovery, ticks)
		if c.Morale < c.Courage {
			c.Morale = combatCareRecover(c.Morale, c.Courage, rules.MoraleRecovery, ticks)
		}
		c.Overwatch = false
		c.Guarding = false
		c.ReservedAP = 0
		r.state.CombatRoster[id] = c
		r.combatCareHold(c)
	}
	return nil
}

func (r *Runtime) validateCombatCare(s state) error {
	if len(s.CombatCare.Clocks) != len(s.CombatRoster) {
		return errors.New("orphaned injury clock")
	}
	for id, at := range s.CombatCare.Clocks {
		if _, ok := s.CombatRoster[id]; !ok || at < 0 || at > s.Life.Seconds {
			return errors.New("invalid injury clock")
		}
	}
	return nil
}
