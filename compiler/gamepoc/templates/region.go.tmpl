// Code generated by ANG. Region maps expose only the hero's durable knowledge.
package poc

import (
 "fmt"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

type regionDeck struct {ID string `json:"id"`;Name string `json:"name"`;ElevationM float64 `json:"elevation_m"`}
type regionNode struct {ID string `json:"id"`;Name string `json:"name"`;Label string `json:"label,omitempty"`;Kind string `json:"kind,omitempty"`;DeckID string `json:"deck_id"`;X float64 `json:"x"`;Y float64 `json:"y"`;Width float64 `json:"width"`;Height float64 `json:"height"`;LevelID string `json:"level_id"`;InitialKnowledge string `json:"initial_knowledge"`;Description string `json:"description"`}
type regionLink struct {ID string `json:"id"`;FromNode string `json:"from_node"`;ToNode string `json:"to_node"`;Mode string `json:"mode"`;InitialKnown bool `json:"initial_known"`;LifeEdges []string `json:"life_edges,omitempty"`}
type regionCatalog struct {ID string `json:"id"`;Name string `json:"name"`;Decks []regionDeck `json:"decks"`;Nodes []regionNode `json:"nodes"`;Links []regionLink `json:"links"`}
// Initialized empty maps are valid durable knowledge, not missing state. Keep
// their JSON fields so a save before the first discovered link reloads as {}.
type regionKnowledge struct {Initialized bool `json:"initialized,omitempty"`;KnownNodes map[string]bool `json:"known_nodes"`;KnownLinks map[string]bool `json:"known_links"`;Visited map[string]int64 `json:"visited"`}

func(k regionKnowledge)clone()regionKnowledge{
 out:=k
 if k.KnownNodes!=nil{out.KnownNodes=map[string]bool{};for id,v:=range k.KnownNodes{out.KnownNodes[id]=v}}
 if k.KnownLinks!=nil{out.KnownLinks=map[string]bool{};for id,v:=range k.KnownLinks{out.KnownLinks[id]=v}}
 if k.Visited!=nil{out.Visited=map[string]int64{};for id,v:=range k.Visited{out.Visited[id]=v}}
 return out
}
func(r *Runtime)syncRegionKnowledge(){
 if !r.state.Life.Enabled||r.world.Region.ID==""{return}
 k:=&r.state.Region
 if !k.Initialized{
  k.KnownNodes=map[string]bool{};k.KnownLinks=map[string]bool{};k.Visited=map[string]int64{}
  for _,n:=range r.world.Region.Nodes{if n.InitialKnowledge!="unknown"{k.KnownNodes[n.ID]=true};if n.InitialKnowledge=="visited"{k.Visited[n.ID]=r.state.Life.Seconds}}
  for _,e:=range r.world.Region.Links{if e.InitialKnown&&k.KnownNodes[e.FromNode]&&k.KnownNodes[e.ToNode]{k.KnownLinks[e.ID]=true}}
  k.Initialized=true
 }
 hero:=r.state.Life.Actor(playerActorID);if hero==nil{return}
 for _,n:=range r.world.Region.Nodes{if n.LevelID!=""&&hero.Visits[n.LevelID]>0{k.KnownNodes[n.ID]=true;if _,ok:=k.Visited[n.ID];!ok{k.Visited[n.ID]=r.state.Life.Seconds}}}
}
// A real completed trip is evidence of this exact connection. Mere proximity,
// knowledge of both rooms, or discovering an adjacent door is not evidence of
// any parallel hidden passage. life_edges is private authoring data only.
func(r *Runtime)learnRegionTraversal(edgeID string){
 if edgeID==""||r.world.Region.ID==""{return};edge:=r.world.Life.Edge(edgeID);hero:=r.state.Life.Actor(playerActorID)
 if edge==nil||hero==nil||hero.Trip!=nil||hero.Level!=edge.To||hero.Visits[edge.To]==0{return}
 from,to:=r.regionNodeForLevel(edge.From),r.regionNodeForLevel(edge.To);if from==nil||to==nil{return}
 k:=&r.state.Region;if !k.Initialized||!k.KnownNodes[from.ID]||!k.KnownNodes[to.ID]{return}
 for _,link:=range r.world.Region.Links{matches:=(link.FromNode==from.ID&&link.ToNode==to.ID)||(link.FromNode==to.ID&&link.ToNode==from.ID);if !matches{continue};for _,id:=range link.LifeEdges{if id==edgeID{k.KnownLinks[link.ID]=true;break}}}
}
func(r *Runtime)validateRegionKnowledge(s state)error{
 k:=s.Region
 if !k.Initialized{if len(k.KnownNodes)>0||len(k.KnownLinks)>0||len(k.Visited)>0{return fmt.Errorf("uninitialized region knowledge")};return nil}
 if k.KnownNodes==nil||k.KnownLinks==nil||k.Visited==nil||r.world.Region.ID==""{return fmt.Errorf("missing region knowledge")}
 nodes:=map[string]bool{};links:=map[string]regionLink{}
 for _,n:=range r.world.Region.Nodes{nodes[n.ID]=true};for _,e:=range r.world.Region.Links{links[e.ID]=e}
 for id,v:=range k.KnownNodes{if !nodes[id]||!v{return fmt.Errorf("invalid known region node")}}
 for id,v:=range k.KnownLinks{e,ok:=links[id];if !ok||!v||!k.KnownNodes[e.FromNode]||!k.KnownNodes[e.ToNode]{return fmt.Errorf("invalid known region link")}}
 for id,at:=range k.Visited{if !k.KnownNodes[id]||at<0||at>s.Life.Seconds{return fmt.Errorf("invalid region visit")}}
 return nil
}
func(r *Runtime)regionNodeForLevel(level string)*regionNode{for i:=range r.world.Region.Nodes{if r.world.Region.Nodes[i].LevelID==level{return &r.world.Region.Nodes[i]}};return nil}
func(r *Runtime)regionLevelName(locale,level string)string{
 fallback:=r.world.Life.Locations[level].Name;if node:=r.regionNodeForLevel(level);node!=nil{return r.localText(locale,"region.node."+node.ID+".name",fallback)};return fallback
}
func(r *Runtime)regionPlaceKnown(level string)bool{
 if r.world.Region.ID==""{return true};r.syncRegionKnowledge();n:=r.regionNodeForLevel(level);return n!=nil&&r.state.Region.KnownNodes[n.ID]
}
func(r *Runtime)regionConnected(from,to string)bool{
 if from==to{return true};known:=r.state.Region.KnownNodes;if !known[from]||!known[to]{return false}
 queue:=[]string{from};seen:=map[string]bool{from:true}
 for i:=0;i<len(queue);i++{at:=queue[i];for _,e:=range r.world.Region.Links{
  if !r.state.Region.KnownLinks[e.ID]||!known[e.FromNode]||!known[e.ToNode]{continue};next:="";if e.FromNode==at{next=e.ToNode}else if e.ToNode==at{next=e.FromNode};if next==""||seen[next]{continue};if next==to{return true};seen[next]=true;queue=append(queue,next)
 }};return false
}
func(r *Runtime)regionCanGoto(level string)bool{
 if r.world.Region.ID==""{return true};r.syncRegionKnowledge();hero:=r.state.Life.Actor(playerActorID);if hero==nil||hero.Trip!=nil{return false}
 from,to:=r.regionNodeForLevel(hero.Level),r.regionNodeForLevel(level)
 return from!=nil&&to!=nil&&r.state.Region.KnownNodes[to.ID]&&r.regionConnected(from.ID,to.ID)
}
// Highlight only the already selected actionable local connection. The full
// private binding catalog and a speculative remote itinerary stay server-side.
func(r *Runtime)appendRegionSelectedLeg(out *pb.PocRegionMap,locale string){
 hero:=r.state.Life.Actor(playerActorID);if hero==nil||hero.Trip!=nil||r.wayfinding.Epoch!=r.state.Epoch||r.wayfinding.Level!=hero.Level||r.wayfinding.Selected==""{return}
 selected:=r.regionNodeForLevel(r.wayfinding.Selected);if selected==nil||!r.state.Region.KnownNodes[selected.ID]{return};resolved,ok:=r.wayfindingRegional(locale,r.wayfinding.Selected);if !ok{return}
 out.SelectedDestinationId=r.wayfinding.Selected
 for _,link:=range r.world.Region.Links{if !r.state.Region.KnownLinks[link.ID]||!r.state.Region.KnownNodes[link.FromNode]||!r.state.Region.KnownNodes[link.ToNode]{continue};for _,edge:=range link.LifeEdges{if edge==resolved.EdgeID{out.SelectedLocalLinkIds=append(out.SelectedLocalLinkIds,link.ID);break}}}
}
func(r *Runtime)appendRegionMap(view *pb.PocLifeView,locales ...string){
 if r.world.Region.ID==""{return};r.syncRegionKnowledge();k:=r.state.Region;hero:=r.state.Life.Actor(playerActorID);if hero==nil{return}
 locale:="";if len(locales)>0{locale=locales[0]};result:=&pb.PocRegionMap{Id:r.world.Region.ID,Name:r.localText(locale,"region.map."+r.world.Region.ID+".name",r.world.Region.Name)};visibleDecks:=map[string]bool{}
 if hero.Trip==nil{if current:=r.regionNodeForLevel(hero.Level);current!=nil&&k.KnownNodes[current.ID]{result.CurrentNode=current.ID;result.CurrentDeck=current.DeckID}}
 // A BFS once per projection supplies reachability for every destination.
 reachable:=map[string]bool{};if result.CurrentNode!=""{queue:=[]string{result.CurrentNode};reachable[result.CurrentNode]=true;for i:=0;i<len(queue);i++{for _,e:=range r.world.Region.Links{if !k.KnownLinks[e.ID]||!k.KnownNodes[e.FromNode]||!k.KnownNodes[e.ToNode]{continue};next:="";if e.FromNode==queue[i]{next=e.ToNode}else if e.ToNode==queue[i]{next=e.FromNode};if next!=""&&!reachable[next]{reachable[next]=true;queue=append(queue,next)}}}}
 for _,n:=range r.world.Region.Nodes{
  if !k.KnownNodes[n.ID]{continue};knowledge:="known";if _,ok:=k.Visited[n.ID];ok{knowledge="visited"};current:=result.CurrentNode==n.ID
  canTravel:=false;if !current&&n.LevelID!=""&&hero.Trip==nil&&reachable[n.ID]{_,exists:=r.world.Life.Locations[n.LevelID];canTravel=exists&&r.world.Life.NextEdge(hero.Level,n.LevelID)!=nil}
  name:=r.localText(locale,"region.node."+n.ID+".name",n.Name);label:=n.Label;if label==""{label=name};label=r.localText(locale,"region.node."+n.ID+".label",label)
  result.Nodes=append(result.Nodes,&pb.PocRegionNode{Id:n.ID,Name:name,Label:label,Kind:n.Kind,DeckId:n.DeckID,X:n.X,Y:n.Y,Width:n.Width,Height:n.Height,Knowledge:knowledge,LevelId:n.LevelID,Current:current,CanTravel:canTravel,Description:r.localText(locale,"region.node."+n.ID+".description",n.Description)});visibleDecks[n.DeckID]=true
 }
 for _,e:=range r.world.Region.Links{if k.KnownLinks[e.ID]&&k.KnownNodes[e.FromNode]&&k.KnownNodes[e.ToNode]{result.Links=append(result.Links,&pb.PocRegionLink{Id:e.ID,FromNode:e.FromNode,ToNode:e.ToNode,Mode:e.Mode})}}
 for _,d:=range r.world.Region.Decks{if visibleDecks[d.ID]{result.Decks=append(result.Decks,&pb.PocRegionDeck{Id:d.ID,Name:r.localText(locale,"region.deck."+d.ID+".name",d.Name),ElevationM:d.ElevationM})}}
 r.appendRegionSelectedLeg(result,locale)
 view.RegionMap=result
}
