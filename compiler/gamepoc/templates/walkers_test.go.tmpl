			continue
		}
		b := walkersBody{id: a.ID, worker: a.ID, cells: []behavior.Cell{a.Position}}
		if a.Body != nil {
			for _, c := range a.Body.Cells {
				if c != a.Position {
					b.cells = append(b.cells, c)
				}
			}
		}
		out = append(out, b)
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.Level == level && (a.Materialized || a.CombatHold) && a.Trip == nil {
			out = append(out, walkersBody{id: a.ID, cells: []behavior.Cell{a.Position}})
		}
	}
	if r.visitorsOn() && r.world.Visitors.Level == level {
		for _, v := range r.state.Visitors.Bodies {
			b := walkersBody{id: fmt.Sprintf("visitor.%d", v.Serial), cells: []behavior.Cell{v.At}}
			if v.Going && len(v.Path) > 0 {
				b.cells = append(b.cells, v.Path[0])
			}
			out = append(out, b)
		}
	}
	if r.world.Vending.Level == level {
		if cells := r.vendingRobotCells(); len(cells) > 0 {
			out = append(out, walkersBody{id: "vending.cabinet", cells: cells})
		}
	}
	return out
}

// walkersCheck: no body stands on a fixture or in somebody else's work cells, and no two bodies share a cell.
func walkersCheck(r *Runtime, level string) error {
	held := map[behavior.Cell]string{}
	for _, b := range walkersBodies(r, level) {
		for _, c := range b.cells {
			if !r.world.Life.Walks(level, c) {
				return fmt.Errorf("%s stands on a fixture or a wall at %v", b.id, c)
			}
			if r.world.Life.Forbidden(level, c, b.worker) {
				return fmt.Errorf("%s stands in the work cells of %s at %v", b.id, r.world.Life.WorkArea(level, c).ID, c)
			}
			if other, ok := held[c]; ok && other != b.id {
				return fmt.Errorf("%s and %s share %v", other, b.id, c)
			}
			held[c] = b.id
		}
	}
	return nil
}

