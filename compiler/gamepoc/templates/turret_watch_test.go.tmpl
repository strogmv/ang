// turretWatchFixture: the real world with the hero standing on the level of the first turret post, far from
// its object, and every other person of that level moved off it, so a test places exactly whom it needs.
func turretWatchFixture(t *testing.T) (*Runtime, []turretWatchPost) {
	t.Helper()
	r := lifeRuntimeFixture(t)
	if r.world.TurretWatch == nil || len(r.world.TurretWatch.Posts) == 0 {
		t.Skip("content has no turret posts")
	}
	level := r.world.TurretWatch.Posts[0].LevelID
	var posts []turretWatchPost
	for _, p := range r.world.TurretWatch.Posts {
		if p.LevelID == level {
			posts = append(posts, p)
		}
	}
	away := ""
	for id := range r.world.Life.Locations {
		if id != level && (away == "" || id < away) {
			away = id
		}
	}
	for i := range r.state.Life.Actors {
		if a := &r.state.Life.Actors[i]; a.ID != playerActorID && a.Level == level {
			a.Level, a.Path, a.PendingPath = away, nil, nil
		}
	}
	for i := range r.state.Life.Population.Actors {
		if a := &r.state.Life.Population.Actors[i]; a.Level == level {
			a.Level, a.Path = away, nil
		}
	}
	r.state.Visitors.Bodies = nil
	turretWatchPlace(t, r, playerActorID, turretWatchFar(t, r, posts))
	r.state.Turrets = nil
	return r, posts
}

// turretWatchPlace stands a Life person on a cell of the posts' level (no route, on the floor).
func turretWatchPlace(t *testing.T, r *Runtime, id string, at behavior.Cell) {
	t.Helper()
	a := r.state.Life.Actor(id)
	if a == nil {
		t.Fatalf("no Life person %s", id)
	}
	a.Level, a.Position, a.Goal, a.Path, a.PendingPath = r.world.TurretWatch.Posts[0].LevelID, at, at, nil, nil
	a.Trip, a.BoardedEdge, a.ResidenceID, a.ServiceAttachment, a.Body = nil, "", "", "", nil
	a.OverrideLevel, a.OverrideEdge = "", ""
}

func turretWatchCentre(r *Runtime, p turretWatchPost, at behavior.Cell) (int64, int64) {
	cell := r.turretWatchCellMM(p.LevelID)
	return int64(at.X)*cell + cell/2, int64(at.Y)*cell + cell/2
}

func turretWatchDistance(r *Runtime, p turretWatchPost, at behavior.Cell) float64 {
	x, y := turretWatchCentre(r, p, at)
	return math.Hypot(float64(x)/1000-p.Object.XM, float64(y)/1000-p.Object.YM)
}

func turretWatchPivotCell(r *Runtime, p turretWatchPost) behavior.Cell {
	cell := float64(r.turretWatchCellMM(p.LevelID))
	return behavior.Cell{X: int(math.Floor(p.PivotM[0] * 1000 / cell)), Y: int(math.Floor(p.PivotM[1] * 1000 / cell))}
}

// turretWatchOpen: floor cells inside the range that every post can point at and see, nearest first.
func turretWatchOpen(t *testing.T, r *Runtime, posts []turretWatchPost) []behavior.Cell {
	t.Helper()
	p := posts[0]
	terrain := r.world.Life.Locations[p.LevelID].Terrain
	height := int64(math.Round(r.world.TurretWatch.Rule.AimHeightM * 1000))
	var cells []behavior.Cell
	for y := range terrain {
		for x := range len(terrain[y]) {
			at := behavior.Cell{X: x, Y: y}
			if terrain[y][x] != '.' || turretWatchDistance(r, p, at) > r.world.TurretWatch.Rule.RangeM-.3 {
				continue
			}
			ok := true
			for _, q := range posts {
				px, py := turretWatchCentre(r, q, at)
				_, _, aim := q.aim(r.world.TurretWatch.Rule, px, py, height)
				ok = ok && aim && r.turretWatchSees(q, turretWatchPivotCell(r, q), turretWatchPerson{ID: "probe", XMM: px, YMM: py, Cell: at}, height)
			}
			if ok {
				cells = append(cells, at)
			}
		}
	}
	for i := 1; i < len(cells); i++ {
		for j := i; j > 0 && turretWatchDistance(r, p, cells[j]) < turretWatchDistance(r, p, cells[j-1]); j-- {
			cells[j], cells[j-1] = cells[j-1], cells[j]
		}
	}
	if len(cells) < 2 {
		t.Fatal("the guarded object has no open floor in range of its turrets")
	}
	return cells
}

// turretWatchFar: a floor cell well outside the range of every post.
func turretWatchFar(t *testing.T, r *Runtime, posts []turretWatchPost) behavior.Cell {
	t.Helper()
	terrain := r.world.Life.Locations[posts[0].LevelID].Terrain
	for y := len(terrain) - 1; y >= 0; y-- {
		for x := range len(terrain[y]) {
			at := behavior.Cell{X: x, Y: y}
			if terrain[y][x] == '.' && turretWatchDistance(r, posts[0], at) > r.world.TurretWatch.Rule.RangeM+3 {
				return at
			}
		}
	}
	t.Fatal("no floor outside the turret range")
	return behavior.Cell{}
}

// turretWatchNPC: a Life person who is not a guard of any post, taken onto the level.
func turretWatchNPC(t *testing.T, r *Runtime, posts []turretWatchPost, skip string) string {
	t.Helper()
	for _, a := range r.state.Life.Actors {
		guard := false
		for _, p := range posts {
			guard = guard || p.guard(a.ID)
		}
		if a.ID != playerActorID && a.ID != skip && !guard && !r.sanitaryPrivateActor(a.ID) {
			return a.ID
		}
	}
	t.Fatal("no ordinary Life person to bring onto the level")
	return ""
}

func turretWatchTick(r *Runtime, n int) {
	for range n {
		r.state.Tick++
		r.advanceTurretWatch()
	}
}

func turretWatchStateOf(t *testing.T, r *Runtime, id string) turretWatchState {
	t.Helper()
	for _, s := range r.state.Turrets {
		if s.ID == id {
			return s
		}
	}
	t.Fatalf("turret %s keeps no state on the hero's level", id)
	return turretWatchState{}
}

func TestTurretWatchNearestNonGuardInRangeIsWatched(t *testing.T) {
	r, posts := turretWatchFixture(t)
	turretWatchTick(r, 3)
	for _, p := range posts {
		if s := turretWatchStateOf(t, r, p.ID); s.Phase != "rest" || s.Target != "" || s.HeadingMdeg != p.RestHeadingMdeg || s.PitchMdeg != p.RestPitchMdeg || s.EyePPM != 0 {
			t.Fatalf("%s is not at rest with nobody near: %+v", p.ID, s)
		}
	}
	open := turretWatchOpen(t, r, posts)
	near := open[0]
	far := open[len(open)-1]
	for _, c := range open {
		if turretWatchDistance(r, posts[0], c)-turretWatchDistance(r, posts[0], near) > r.world.TurretWatch.Rule.SwitchMarginM+1 {
			far = c
			break
		}
	}
	other := turretWatchNPC(t, r, posts, "")
	// The hero walks up alone: both turn to him.
	turretWatchPlace(t, r, playerActorID, far)
	turretWatchTick(r, 40)
	for _, p := range posts {
		s := turretWatchStateOf(t, r, p.ID)
		x, y := turretWatchCentre(r, p, far)
		h, pitch, _ := p.aim(r.world.TurretWatch.Rule, x, y, int64(math.Round(r.world.TurretWatch.Rule.AimHeightM*1000)))
		if s.Phase != "tracking" || s.Target != playerActorID || s.HeadingMdeg != h || s.PitchMdeg != pitch || s.EyePPM != 1000000 {
			t.Fatalf("%s does not watch the hero alone in range: %+v (want heading %d pitch %d)", p.ID, s, h, pitch)
		}
	}
	// Two people near: both watch the nearer one, whoever he is.
	for _, order := range [][2]string{{other, playerActorID}, {playerActorID, other}} {
		turretWatchPlace(t, r, order[0], near)
		turretWatchPlace(t, r, order[1], far)
		turretWatchTick(r, 2)
		for _, p := range posts {
			if s := turretWatchStateOf(t, r, p.ID); s.Target != order[0] {
				t.Fatalf("%s watches %q, not the nearer %s", p.ID, s.Target, order[0])
			}
		}
	}
	// Ties are settled by id: two people at the same distance, the smaller id wins on both turrets.
	twin := behavior.Cell{}
	found := false
	for _, c := range open[1:] {
		if c != near && turretWatchDistance(r, posts[0], c) == turretWatchDistance(r, posts[0], near) {
			twin, found = c, true
			break
		}
	}
	if found {
		r.state.Turrets = nil
		turretWatchPlace(t, r, playerActorID, near)
		turretWatchPlace(t, r, other, twin)
		turretWatchTick(r, 1)
		want := min(playerActorID, other)
		for _, p := range posts {
			if s := turretWatchStateOf(t, r, p.ID); s.Target != want {
				t.Fatalf("%s breaks a tie for %q, not %q", p.ID, s.Target, want)
			}
		}
	}
	// A person farther by less than the switch margin does not take the turret away.
	r.state.Turrets = nil
	turretWatchPlace(t, r, other, far)
	turretWatchPlace(t, r, playerActorID, turretWatchFar(t, r, posts))
	turretWatchTick(r, 1)
	tested := false
	for _, c := range open {
		gain := turretWatchDistance(r, posts[0], far) - turretWatchDistance(r, posts[0], c)
		if gain > 0.01 && gain <= r.world.TurretWatch.Rule.SwitchMarginM-0.01 {
			turretWatchPlace(t, r, playerActorID, c)
			turretWatchTick(r, 1)
			if s := turretWatchStateOf(t, r, posts[0].ID); s.Target != other {
				t.Fatalf("a newcomer %.2f m nearer took the turret: %+v", gain, s)
			}
			tested = true
			break
		}
	}
	if !tested {
		t.Fatal("no floor cell to test the switch margin")
	}
}

func TestTurretWatchIgnoresGuards(t *testing.T) {
	r, posts := turretWatchFixture(t)
	open := turretWatchOpen(t, r, posts)
	guard := posts[0].Guards[0]
	turretWatchPlace(t, r, guard, open[0])
	turretWatchTick(r, 30)
	for _, p := range posts {
		if s := turretWatchStateOf(t, r, p.ID); s.Phase != "rest" || s.Target != "" || s.EyePPM != 0 {
			t.Fatalf("%s watches its own guard: %+v", p.ID, s)
		}
	}
	// The guard nearest to the door, the hero behind him: the turrets watch the hero.
	turretWatchPlace(t, r, playerActorID, open[len(open)-1])
	turretWatchTick(r, 2)
	for _, p := range posts {
		if s := turretWatchStateOf(t, r, p.ID); s.Target != playerActorID {
			t.Fatalf("%s does not pass over the guard to the hero: %+v", p.ID, s)
		}
	}
	// A saved state that watches a guard is refused.
	bad := r.snapshotState()
	bad.Turrets = append([]turretWatchState(nil), bad.Turrets...)
	bad.Turrets[0].Target = guard
	if r.validateTurretWatch(bad) == nil {
		t.Fatal("a save that watches a guard was accepted")
	}
}

func TestTurretWatchNeedsItsOwnLineOfSight(t *testing.T) {
	r, posts := turretWatchFixture(t)
	open := turretWatchOpen(t, r, posts)
	p := posts[0]
	pivot := turretWatchPivotCell(r, p)
	// Pick an open cell at least four cells from the mount; a short wall goes up halfway to it.
	var at behavior.Cell
	found := false
	for _, c := range open {
		if max(c.X-pivot.X, pivot.X-c.X, c.Y-pivot.Y, pivot.Y-c.Y) >= 4 {
			at, found = c, true
			break
		}
	}
	if !found {
		t.Fatal("no open floor four cells from the mount")
	}
	mid := behavior.Cell{X: (at.X + pivot.X) / 2, Y: (at.Y + pivot.Y) / 2}
	turretWatchPlace(t, r, playerActorID, at)
	turretWatchTick(r, 20)
	if s := turretWatchStateOf(t, r, p.ID); s.Target != playerActorID {
		t.Fatalf("%s does not watch the hero in plain sight: %+v", p.ID, s)
	}
	if r.world.Decks[p.LevelID] != nil && r.turretWatchCellMM(p.LevelID) == 500 {
		// A 3D level: a solid box (as a closed gate leaf would be) stands on the floor halfway to the hero.
		c := r.world.Illumination.Levels[p.LevelID]
		x, y := turretWatchCentre(r, p, at)
		mx, my := (float64(x)+p.PivotM[0]*1000)/2, (float64(y)+p.PivotM[1]*1000)/2
		_, floor, _, _ := r.world.Decks[p.LevelID].Locate(at)
		c.StaticOccluders = append(append([]behavior.DeckRayBox(nil), c.StaticOccluders...), behavior.DeckRayBox{
			Min: behavior.DeckPointMM{X: mx - 300, Y: my - 300, Z: float64(floor)}, Max: behavior.DeckPointMM{X: mx + 300, Y: my + 300, Z: float64(floor) + 4000}})
		if r.world.Illumination.Levels == nil {
			r.world.Illumination.Levels = map[string]illuminationLevel{}
		}
		r.world.Illumination.Levels[p.LevelID] = c
	} else {
		if !r.world.Opaque["#"] {
			t.Skip("content has no '#' wall glyph")
		}
		l := r.world.Life.Locations[p.LevelID]
		rows := append([]string(nil), l.Terrain...)
		for y := mid.Y - 1; y <= mid.Y+1; y++ {
			b := []byte(rows[y])
			for x := mid.X - 1; x <= mid.X+1; x++ {
				if (behavior.Cell{X: x, Y: y}) != at && (behavior.Cell{X: x, Y: y}) != pivot {
					b[x] = '#'
				}
			}
			rows[y] = string(b)
		}
		l.Terrain = rows
		r.world.Life.Locations[p.LevelID] = l
	}
	height := int64(math.Round(r.world.TurretWatch.Rule.AimHeightM * 1000))
	hx, hy := turretWatchCentre(r, p, at)
	if r.turretWatchSees(p, pivot, turretWatchPerson{ID: playerActorID, XMM: hx, YMM: hy, Cell: at}, height) {
		t.Fatal("the test wall does not stand between the mount and the hero")
	}
	turretWatchTick(r, 1)
	if s := turretWatchStateOf(t, r, p.ID); s.Phase != "holding" || s.Target != "" {
		t.Fatalf("%s keeps watching through a wall: %+v", p.ID, s)
	}
	for _, q := range posts[1:] {
		if r.turretWatchSees(q, turretWatchPivotCell(r, q), turretWatchPerson{ID: playerActorID, XMM: hx, YMM: hy, Cell: at}, height) {
			if s := turretWatchStateOf(t, r, q.ID); s.Target != playerActorID {
				t.Fatalf("%s lost the hero it still sees: %+v", q.ID, s)
			}
		}
	}
}

func TestTurretWatchReturnsToRest(t *testing.T) {
	r, posts := turretWatchFixture(t)
	rule := r.world.TurretWatch.Rule
	open := turretWatchOpen(t, r, posts)
	turretWatchPlace(t, r, playerActorID, open[len(open)/2])
	turretWatchTick(r, 40)
	turretWatchPlace(t, r, playerActorID, turretWatchFar(t, r, posts))
	tick := r.tickNS()
	holdTicks := int(rule.HoldMS*1000000/tick) - 1
	before := map[string]turretWatchState{}
	for _, s := range r.state.Turrets {
		before[s.ID] = s
	}
	turretWatchTick(r, 1)
	for _, p := range posts {
		s := turretWatchStateOf(t, r, p.ID)
		if s.Phase != "holding" || s.HeadingMdeg != before[p.ID].HeadingMdeg || s.PitchMdeg != before[p.ID].PitchMdeg {
			t.Fatalf("%s did not hold its last aim: %+v", p.ID, s)
		}
	}
	turretWatchTick(r, holdTicks)
	for _, p := range posts {
		if s := turretWatchStateOf(t, r, p.ID); s.Phase != "holding" {
			t.Fatalf("%s let go before its hold time: %+v", p.ID, s)
		}
	}
	returning := map[string]bool{}
	for step := 0; step < 2000; step++ {
		previous := map[string]turretWatchState{}
		for _, s := range r.state.Turrets {
			previous[s.ID] = s
		}
		turretWatchTick(r, 1)
		done := true
		for _, p := range posts {
			s := turretWatchStateOf(t, r, p.ID)
			returning[p.ID] = returning[p.ID] || s.Phase == "returning"
			limit := turretWatchMdeg(rule.ReturnSlewDegS)*tick/1000000000 + 1
			if d := turretWatchWrap(s.HeadingMdeg - previous[p.ID].HeadingMdeg); d > limit || -d > limit {
				t.Fatalf("%s returned faster than its return slew: %d mdeg in a tick", p.ID, d)
			}
			if d := s.PitchMdeg - previous[p.ID].PitchMdeg; d > limit || -d > limit {
				t.Fatalf("%s tilted back faster than its return slew: %d mdeg in a tick", p.ID, d)
			}
			done = done && s.Phase == "rest"
		}
		if done {
			break
		}
	}
	for _, p := range posts {
		s := turretWatchStateOf(t, r, p.ID)
		if !returning[p.ID] || s.Phase != "rest" || s.HeadingMdeg != p.RestHeadingMdeg || s.PitchMdeg != p.RestPitchMdeg || s.EyePPM != 0 || s.Target != "" {
			t.Fatalf("%s did not come back to rest: %+v", p.ID, s)
		}
	}
	// Leaving the level drops every turret state (nothing is kept where the player is not).
	for id := range r.world.Life.Locations {
		if id != posts[0].LevelID {
			r.state.Life.Actor(playerActorID).Level = id
			break
		}
	}
	turretWatchTick(r, 1)
	if len(r.state.Turrets) != 0 {
		t.Fatalf("turrets kept state away from the hero: %+v", r.state.Turrets)
	}
}

func TestTurretWatchIsDeterministicAndPublished(t *testing.T) {
	run := func() ([]byte, *Runtime) {
		r, posts := turretWatchFixture(t)
		open := turretWatchOpen(t, r, posts)
		other := turretWatchNPC(t, r, posts, "")
		var log []turretWatchState
		for i, c := range open {
			if i%3 != 0 {
				continue
			}
			turretWatchPlace(t, r, playerActorID, c)
			turretWatchPlace(t, r, other, open[(i*7)%len(open)])
			turretWatchTick(r, 3)
			log = append(log, r.state.Turrets...)
		}
		raw, err := json.Marshal(log)
		if err != nil {
			t.Fatal(err)
		}
		return raw, r
	}
	a, r := run()
	b, _ := run()
	if string(a) != string(b) {
		t.Fatal("the same seed and the same moves gave different turret states")
	}
	if err := r.validateTurretWatch(r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	// A snapshot does not change when the turrets move on.
	snap := r.snapshotState()
	saved := append([]turretWatchState(nil), snap.Turrets...)
	turretWatchPlace(t, r, playerActorID, turretWatchFar(t, r, turretWatchPostsOfLevel(r)))
	turretWatchTick(r, 5)
	if !reflect.DeepEqual(saved, snap.Turrets) {
		t.Fatal("a snapshot shares the live turret state")
	}
	// Published through the real send: states every frame, specs once.
	r.syncLifeHero()
	r.syncRegionKnowledge()
	r.updateLifeExploration()
	c := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{}), delivery: pb.NewViewProjector(&pb.ViewSubscription{StaticOnChange: true})}
	for frame := 0; frame < 2; frame++ {
		r.sendState(c)
		life := (<-c.out).GetGameState().GetLife()
		if len(life.GetTurretWatch()) != len(turretWatchPostsOfLevel(r)) {
			t.Fatalf("frame %d carries %d turret states", frame, len(life.GetTurretWatch()))
		}
		if frame == 0 && len(life.GetTurretWatchSpecs()) != len(turretWatchPostsOfLevel(r)) {
			t.Fatal("the first frame lost the turret specs")
		}
		if frame == 1 && len(life.GetTurretWatchSpecs()) != 0 {
			t.Fatal("unchanged turret specs repeated")
		}
	}
}

func turretWatchPostsOfLevel(r *Runtime) []turretWatchPost {
	var posts []turretWatchPost
	for _, p := range r.world.TurretWatch.Posts {
		if p.LevelID == r.world.TurretWatch.Posts[0].LevelID {
			posts = append(posts, p)
		}
	}
	return posts
}
