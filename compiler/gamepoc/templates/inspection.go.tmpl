// Code generated by ANG. Authoritative contextual inspection.
package poc

import (
 "errors"
 "sort"
 "angelsdemons/server/internal/behavior"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

// Only the server evaluates capabilities, knowledge, live facts and perception.
// Unity receives already filtered prose, so hovering never requires a round trip.
func(r *Runtime)appendLifeInspection(msg *pb.PocGameState,v *Runtime,hero *behavior.LifeActor){
 if r.world.Config.DebugPerception{
  keys:=make([]string,0,len(r.state.Life.Observer.Attributes));for key:=range r.state.Life.Observer.Attributes{keys=append(keys,key)};sort.Strings(keys)
  for _,key:=range keys{msg.Life.InspectionAttributes=append(msg.Life.InspectionAttributes,&pb.PocInspectionAttribute{Id:key,Value:int32(r.state.Life.Observer.Attributes[key])})}
 }
 if hero.Trip!=nil{return}
 phases:=make(map[string]string,len(r.state.Life.Maintenance.Units));for _,unit:=range r.state.Life.Maintenance.Units{phases[unit.ID]=unit.Phase}
 for _,obj:=range r.world.Life.Inspection.Objects{
  if obj.Level!=hero.Level||!viewSees(msg.PlayerView,int32(obj.At.X),int32(obj.At.Y)){continue}
  facts:=map[string]string{}
  if phase,ok:=phases[obj.ID];ok{facts["equipment_phase"]=phase}
  evidence:=behavior.InspectionEvidence{Visible:true,Distance:behavior.Distance(hero.Position,obj.At),SmellReachable:v.sightLine(location(hero.Position),location(obj.At)),Facts:facts}
  description,ok:=obj.Describe(r.state.Life.Observer,evidence);if !ok{continue}
  item:=&pb.PocInspectionObject{Id:obj.ID,Name:description.Name,LevelId:obj.Level,X:int32(obj.At.X),Y:int32(obj.At.Y),TextKey:description.TextKey,BaseText:description.BaseText}
  for _,line:=range description.Fragments{item.Fragments=append(item.Fragments,&pb.PocInspectionLine{Id:line.ID,TextKey:line.TextKey,Text:line.Text,Sense:line.Sense})}
  msg.Life.Inspections=append(msg.Life.Inspections,item)
 }
}
func(r *Runtime)setInspectionAttribute(key string,value int)error{
 if !r.world.Config.DebugPerception{return errors.New("Изменение способностей доступно только в отладке")}
 if _,ok:=r.world.Life.Inspection.Observer.Attributes[key];!ok||value<0||value>100{return errors.New("Неизвестная способность или значение вне 0–100")}
 if r.state.Life.Observer.Attributes==nil{return errors.New("Профиль восприятия отсутствует")}
 r.state.Life.Observer.Attributes[key]=value;return nil
}
