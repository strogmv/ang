// Code generated by ANG. Host side of server-authoritative gates (docs 83/85).
package poc

import (
 "angelsdemons/server/internal/behavior"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
 "errors"
)

// applyGateTerrain overlays the live gate glyphs on the session's Life model:
// MoveTo planning, crowd steps and hero sight between frames see the opening
// exactly as the last frame moved bodies against it. Base worlds stay intact.
func(r *Runtime)applyGateTerrain(){if len(r.state.Life.Gates)==0{return};r.world.Life=r.state.Life.GateModel(r.world.Life)}

// appendGates projects the gates of the hero's level whose opening the hero
// sees now. Unseen gates are not published; Unity keeps their last drawn pose.
// The travel segment is absolute in simulation time, so the client draws the
// lift as a pure function of server time, with no Animator clock of its own.
func(r *Runtime)appendGates(view *pb.PocLifeView,hero *behavior.LifeActor,perception *pb.PocObserverView){
 if hero==nil||hero.Trip!=nil{return}
 location:=r.world.Life.Locations[hero.Level];if len(location.Gates)==0{return}
 for _,d:=range location.Gates{
  g,ok:=r.state.Life.Gates[d.ID];if !ok{continue}
  // A gate of public, known architecture (a 10 m portal with its beacons and traffic heads, demo-hub) is drawn in its
  // real pose anywhere on the hero's level; elsewhere only while its opening is in sight.
  seen:=location.InitialLayoutKnown;for _,c:=range d.Opening{if seen{break};if viewSees(perception,int32(c.X),int32(c.Y)){seen=true}};if !seen{continue}
  st:=&pb.PocGateState{Id:d.ID,State:g.State,Cause:g.Cause,Direction:int32(g.Direction),PositionPpm:g.Position(g.Updated),FromPpm:g.From,ToPpm:g.To,Linear:g.Linear,Lockdown:g.Lockdown,PowerLost:g.PowerLost,Passable:g.Passable(),SeeThrough:g.SeeThrough(d),Stops:g.Stops}
  st.PhaseStartNs=r.lifeMotionStartNS(g.Start,r.state.Life,r.state.Tick)
  if g.Duration>0{st.SegmentStartNs=st.PhaseStartNs;st.SegmentDurationNs=r.lifeMotionDurationNS(g.Duration);if g.Ramp>0&&!g.Linear{st.RampNs=r.lifeMotionDurationNS(g.Ramp)}}
  view.Gates=append(view.Gates,st)
 }
}

// gateCommand drives the controller inputs on an isolated SDK stand only. In
// the story the alarm and the mains come from the security system and the
// power network, never from a player button.
func(r *Runtime)gateCommand(action,id string)error{
 if r.state.SDKLayout==""{return errors.New("Команда ворот доступна только на стенде")}
 switch action{
 case "gate_lockdown":return r.state.Life.SetGateLockdown(r.world.Life,id,true)
 case "gate_release":return r.state.Life.SetGateLockdown(r.world.Life,id,false)
 case "gate_power_off":return r.state.Life.SetGatePower(r.world.Life,id,false)
 case "gate_power_on":return r.state.Life.SetGatePower(r.world.Life,id,true)
 }
 return errors.New("Неизвестное действие")
}
