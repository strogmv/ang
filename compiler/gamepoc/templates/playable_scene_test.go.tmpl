func playableFixture(t *testing.T, hostile bool) (*Runtime, *connection, playableSceneDefinition) {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	d, ok := r.world.PlayableScenes["stealth"]
	if !ok {
		t.Skip("world has no authored playable stealth scene")
	}
	c := &connection{locale: "en", out: make(chan *pb.ServerMessage, 4096), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "scene.new", Scenario: d.Scenario, Seed: 711}}}})
	answer, _ := playableDrain(c)
	if answer == nil || !answer.Ok || r.state.Playable.ID != d.ID || r.world.PlayableID != d.ID || !r.state.Life.Enabled || r.state.SDKLayout != "" {
		t.Fatalf("real NewGame did not enter the authored Life scene: %+v", answer)
	}
	if !hostile {
		// Isolate interaction/resource tests from an encounter interrupting their
		// walk. The separate recognition test keeps authored aggression intact.
		// No position, successful action, evidence, item or AI outcome is injected.
		r.world.CombatLife.Aggressors = map[string][]string{}
	}
	return r, c, d
}
func playableDrain(c *connection) (*pb.PocActionResult, *pb.PocGameState) {
	var result *pb.PocActionResult
	var state *pb.PocGameState
	for len(c.out) > 0 {
		m := <-c.out
		if a := m.GetActionResult(); a != nil {
			result = a
		}
		if s := m.GetGameState(); s != nil {
			state = s
		}
	}
	return result, state
}
func playableAction(t *testing.T, r *Runtime, c *connection, id, request string) (*pb.PocActionResult, *pb.PocGameState) {
	t.Helper()
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_LifeCommand{LifeCommand: &pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: request, Action: "interact", Destination: id}}}})
	result, state := playableDrain(c)
	if result == nil {
		t.Fatal("interaction wire returned no receipt")
	}
	return result, state
}
func playableFind(t *testing.T, d playableSceneDefinition, effect string) playableInteraction {
	t.Helper()
	for _, action := range d.Interactions {
		if action.Effect == effect {
			return action
		}
	}
	t.Fatal("authored scene lacks interaction", effect)
	return playableInteraction{}
}
func playableTakeAction(t *testing.T, d playableSceneDefinition, source string) playableInteraction {
	t.Helper()
	for _, action := range d.Interactions {
		if action.Effect == "take" && action.Target == source {
			return action
		}
	}
	t.Fatal("authored scene lacks take action for source", source)
	return playableInteraction{}
}
func playableWalk(t *testing.T, r *Runtime, c *connection, at behavior.Cell) {
	t.Helper()
	h := r.state.Life.Actor(playerActorID)
	seq := uint64(r.state.Tick) + 1
	if h.Body != nil {
		seq += h.Body.Seq
	}
	r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: seq, X: int32(at.X), Y: int32(at.Y)})
	var accepted bool
	var rejection string
	for len(c.out) > 0 {
		m := <-c.out
		if result := m.GetMoveResult(); result != nil {
			accepted = result.Ok
			rejection = result.Reason
		}
	}
	if !accepted {
		t.Fatalf("real movement refused scene approach %+v from %+v: %s; elapsed=%d combat=%t guard=%+v observer=%+v light=%+v", at, h.Position, rejection, r.state.Life.Seconds-r.world.PlayableScenes[r.world.PlayableID].StartSecond, r.heroInCombat(), r.state.Life.Actor(r.world.PlayableScenes[r.world.PlayableID].Guard), r.state.Stealth.Observers[r.world.PlayableScenes[r.world.PlayableID].Guard], r.illuminationBody(h))
	}
	for frame := 0; frame < 2400; frame++ {
		h = r.state.Life.Actor(playerActorID)
		if h.Position == at && (h.Body == nil || !h.Body.Moving) {
			return
		}
		if r.heroInCombat() {
			t.Fatalf("encounter interrupted interaction fixture walk to %+v at %+v elapsed=%d guard=%+v observer=%+v light=%+v", at, h.Position, r.state.Life.Seconds-r.world.PlayableScenes[r.world.PlayableID].StartSecond, r.state.Life.Actor(r.world.PlayableScenes[r.world.PlayableID].Guard), r.state.Stealth.Observers[r.world.PlayableScenes[r.world.PlayableID].Guard], r.illuminationBody(h))
		}
		r.step()
		playableDrain(c)
	}
	t.Fatalf("ordinary Life movement never reached %+v; hero=%+v", at, r.state.Life.Actor(playerActorID))
}
func playableUse(t *testing.T, r *Runtime, c *connection, action playableInteraction, request string) *pb.PocGameState {
	t.Helper()
	playableWalk(t, r, c, action.At)
	result, wire := playableAction(t, r, c, action.ID, request)
	if !result.Ok {
		t.Fatalf("real interaction %s failed: %+v", action.ID, result)
	}
	return wire
}
func playableSceneItem(t *testing.T, r *Runtime, origin string) inv.Item {
	t.Helper()
	var found []inv.Item
	for _, item := range r.state.Inventory.Items {
		if item.Origin == origin {
			found = append(found, item)
		}
	}
	if len(found) != 1 {
		t.Fatalf("finite source %s has %d real instances", origin, len(found))
	}
	return found[0]
}

func TestPlayableSceneNewGameKeepsSharedSystemsAndCanonicalWorldIndependent(t *testing.T) {
	r, c, d := playableFixture(t, false)
	if len(r.state.Life.Actors) != 2 || r.state.Life.Population.Count != 0 || !r.state.Life.Actor(playerActorID).Manual || r.state.Life.Actor(d.Guard).Manual || r.state.Life.SecondsPerTick != 1 || !r.world.Stealth.Enabled || !r.world.Illumination.Enabled || r.world.CombatRuntime.DefaultProfile == "" || r.world.Config.DebugPerception {
		t.Fatal("playable preset became a debug/SDK or counter-only world")
	}
	if r.state.Life.Actor(playerActorID).Position != d.Spawn || r.state.Life.Actor(d.Guard).Position != d.GuardRoute[0] || r.state.Life.Seconds != d.StartSecond || r.state.Life.Gates[d.Gate].State != "locked" {
		t.Fatal("authored start did not use actual Life/gate state")
	}
	baton := playableSceneItem(t, r, "scene.stealth.guard_baton")
	if baton.Owner != d.Guard || baton.Location.Store != inv.ActorStore(d.Guard) || baton.Location.Slot != "hand.main" || r.combatant(d.Guard, "guard").Weapon.ID != baton.Definition {
		t.Fatal("guard equipment came from a free tactical profile")
	}
	for _, source := range r.canonicalWorld.Inventory.Sources {
		if strings.HasPrefix(source.ID, "scene.stealth.") {
			t.Fatal("scene stock escaped into the normal inventory catalog")
		}
	}
	if len(r.canonicalWorld.Life.Actors) <= 2 || r.canonicalWorld.Life.Person(d.Guard).Steps[0].Level == d.Level {
		t.Fatal("normal guard/routines were repositioned")
	}
	canonicalAt := r.canonicalWorld.Life.Locations[d.Level].Terrain[0]
	copyLocation := r.world.Life.Locations[d.Level]
	changedRow := []byte(copyLocation.Terrain[0])
	if changedRow[0] == '#' {
		changedRow[0] = '.'
	} else {
		changedRow[0] = '#'
	}
	copyLocation.Terrain[0] = string(changedRow)
	r.world.Life.Locations[d.Level] = copyLocation
	if r.canonicalWorld.Life.Locations[d.Level].Terrain[0] != canonicalAt {
		t.Fatal("variant still aliases canonical terrain")
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "scene.back.normal", Scenario: "life"}}}})
	result, _ := playableDrain(c)
	if result == nil || !result.Ok || r.state.Playable.ID != "" || r.world.PlayableID != "" || len(r.state.Life.Actors) <= 2 {
		t.Fatal("normal NewGame inherited scene/session identity", result)
	}
	for _, item := range r.state.Inventory.Items {
		if strings.HasPrefix(item.Origin, "scene.stealth.") {
			t.Fatal("normal new game inherited scene items")
		}
	}
}

func TestPlayableSceneStartIsSafeWhileThePlayerReadsTheObjective(t *testing.T) {
	r, c, d := playableFixture(t, true)
	start := r.state.Life.Actor(playerActorID).Position
	for r.state.Life.Seconds < d.StartSecond+180 {
		r.step()
		playableDrain(c)
		if r.heroInCombat() || r.state.CombatSerial != 0 {
			t.Fatal("authored start exposes the stationary player before leaving cover")
		}
	}
	h, guard := r.state.Life.Actor(playerActorID), r.state.Life.Actor(d.Guard)
	if h.Position != start || h.Sneaking || guard.WalkedMM == 0 {
		t.Fatal("safe start was obtained by moving/crouching the player or disabling patrol")
	}
}

func TestPlayableScenePowerRequiresPhysicalApproachAndReplayIsAtomic(t *testing.T) {
	r, c, d := playableFixture(t, false)
	panel := playableFind(t, d, "power_toggle")
	far := playableTakeAction(t, d, d.GoalSource)
	before := r.snapshotState()
	if r.playableInteract(far.ID) == nil || !reflect.DeepEqual(before, r.snapshotState()) {
		t.Fatal("remote interaction succeeded or partly changed state")
	}
	playableWalk(t, r, c, panel.At)
	lightBefore := r.illuminationBody(r.state.Life.Actor(playerActorID))
	result, wire := playableAction(t, r, c, panel.ID, "scene.power")
	if !result.Ok || !r.state.Illumination.Off[d.Level][panel.Target] || wire == nil || wire.Life == nil || wire.Life.PlayableScene == nil {
		t.Fatal("ordinary player panel did not change real feed/public scene state", result)
	}
	lightAfter := r.illuminationBody(r.state.Life.Actor(playerActorID))
	if !lightAfter.Known || illuminationMean(lightAfter.Lux) > illuminationMean(lightBefore.Lux)+1e-8 {
		t.Fatal("opening the authored feeder increased direct light")
	}
	for _, e := range r.world.Illumination.Levels[d.Level].Emitters {
		if e.PowerRef == panel.Target && r.illuminationSourceFactor(d.Level, r.world.Illumination.Levels[d.Level], e, lightAfter.Weights) != 0 {
			t.Fatal("real switched branch remained lit")
		}
	}
	accepted := r.snapshotState()
	if replay, _ := playableAction(t, r, c, panel.ID, "scene.power"); !replay.Ok || !reflect.DeepEqual(accepted, r.snapshotState()) {
		t.Fatal("replayed interaction toggled power twice")
	}
	paused := r.snapshotState()
	r.state.Paused = true
	paused.Paused = true
	if r.playableInteract(panel.ID) == nil || !reflect.DeepEqual(paused, r.snapshotState()) {
		t.Fatal("paused panel changed physical state")
	}
}

func TestPlayableScenePhysicalKeyGateObjectiveAndSaveLoad(t *testing.T) {
	r, c, d := playableFixture(t, false)
	gate := playableFind(t, d, "gate_toggle")
	playableWalk(t, r, c, gate.At)
	before := r.snapshotState()
	if r.playableInteract(gate.ID) == nil || !reflect.DeepEqual(before, r.snapshotState()) {
		t.Fatal("locked scene gate accepted a missing physical key")
	}
	var keySource string
	for _, source := range d.Sources {
		if source.Definition == d.KeyDefinition {
			keySource = source.ID
		}
	}
	key := playableSceneItem(t, r, keySource)
	playableUse(t, r, c, playableTakeAction(t, d, keySource), "scene.take.key")
	keyAfter := playableSceneItem(t, r, keySource)
	if keyAfter.ID != key.ID || keyAfter.Owner != playerActorID || !r.carried(keyAfter) || keyAfter.Revision <= key.Revision {
		t.Fatal("take fabricated a key instead of moving its finite instance")
	}
	playableUse(t, r, c, gate, "scene.unlock")
	if g := r.state.Life.Gates[d.Gate]; !g.RequestOpen || g.Position(g.Updated) != 0 {
		t.Fatal("unlock teleported the physical gate instead of requesting its controller")
	}
	for frame := 0; frame < 600 && !r.state.Life.Gates[d.Gate].Passable(); frame++ {
		r.step()
	}
	if !r.state.Life.Gates[d.Gate].Passable() {
		t.Fatal("requested gate never actually opened")
	}
	goal := playableSceneItem(t, r, d.GoalSource)
	wire := playableUse(t, r, c, playableTakeAction(t, d, d.GoalSource), "scene.take.objective")
	if acquired := playableSceneItem(t, r, d.GoalSource); acquired.ID != goal.ID || !r.carried(acquired) || acquired.Owner != playerActorID || !wire.Life.PlayableScene.GoalCarried || r.state.Playable.Completed {
		t.Fatal("objective was fabricated/completed before reaching the exit")
	}
	playableUse(t, r, c, playableFind(t, d, "exit"), "scene.finish")
	if !r.state.Playable.Completed {
		t.Fatal("real return with the objective did not complete the scene")
	}
	if err := r.validatePlayableScene(r.state); err != nil {
		t.Fatal(err)
	}
	copyState := r.snapshotState()
	copyState.Playable.Cooldowns["fixture.alias"] = 1
	if _, aliased := r.state.Playable.Cooldowns["fixture.alias"]; aliased {
		t.Fatal("scene snapshot aliases live cooldowns")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal("real save validation failed", err)
	}
	if loaded.Playable.ID != d.ID || !loaded.Playable.Completed || loaded.Inventory.Items[goal.ID].Owner != playerActorID || !loaded.Life.Gates[d.Gate].RequestOpen {
		t.Fatal("save lost scene, finite objective or physical door controller")
	}
	sdkHostLoad(t, r, loaded, "scene.restore")
	if r.world.PlayableID != d.ID || r.state.Playable.ID != d.ID || !r.state.Playable.Completed {
		t.Fatal("real load did not select the matching Life variant")
	}
}

func TestPlayableSceneGuardPatrolUsesOrdinaryLifePaths(t *testing.T) {
	r, c, d := playableFixture(t, false)
	initial := r.state.Life.Actor(d.Guard).Position
	moved := false
	for frame := 0; frame < 120; frame++ {
		previous := r.state.Life.Actor(d.Guard).Position
		r.step()
		guard := r.state.Life.Actor(d.Guard)
		if guard.Position != previous && !r.world.Life.Adjacent(d.Level, previous, guard.Position) {
			t.Fatal("patrol teleported instead of walking")
		}
		moved = moved || guard.Position != initial
	}
	if !moved {
		t.Fatal("guard never left its physical patrol post")
	}
	if err := r.validatePlayableScene(r.state); err != nil {
		t.Fatal(err)
	}
	// Real anonymous hearing, uncertain destinations and physical arrival are
	// exercised by TestStealthRealBellReachesTheRememberedEstimateWithinExistingBudget.
	// Keep the patrol replay independent of later player movements/noise.
	playableDrain(c)
}

func TestPlayableScenePublicProjectionAndMalformedSavedProgress(t *testing.T) {
	r, c, d := playableFixture(t, true)
	r.sendState(c)
	_, wire := playableDrain(c)
	if wire == nil || wire.Life == nil || wire.Life.PlayableScene == nil {
		t.Fatal("ordinary wire omitted the authored scene")
	}
	public := wire.Life.PlayableScene
	if public.Id != d.ID || public.Name == d.NameKey || public.Objective == d.ObjectiveKey || len(public.Lights) == 0 || public.GoalCarried || public.KeyCarried {
		t.Fatal("scene projection has untranslated text or invented progress", public)
	}
	for _, action := range public.Actions {
		if !viewSees(wire.PlayerView, action.X, action.Y) {
			t.Fatal("unseen interaction escaped server filtering")
		}
	}
	encoded, err := json.Marshal(public)
	if err != nil || strings.Contains(string(encoded), "LastSeen") || strings.Contains(string(encoded), "Contact") || strings.Contains(string(encoded), d.Guard) {
		t.Fatal("public scene state includes private guard knowledge")
	}
	for name, change := range map[string]func(*state){
		"wrong id":          func(s *state) { s.Playable.ID = "missing" },
		"patrol index":      func(s *state) { s.Playable.PatrolIndex = len(d.GuardRoute) },
		"future wait":       func(s *state) { s.Playable.WaitUntil = s.Life.Seconds + d.PatrolPauseSeconds + 1 },
		"unknown cooldown":  func(s *state) { s.Playable.Cooldowns["unknown"] = s.Life.Seconds },
		"goal without item": func(s *state) { s.Playable.Completed = true },
	} {
		t.Run(name, func(t *testing.T) {
			s := r.snapshotState()
			change(&s)
			if r.validatePlayableScene(s) == nil {
				t.Fatal("malformed playable save accepted", name)
			}
		})
	}
	if err := r.validatePlayableScene(r.state); err != nil {
		t.Fatal(fmt.Errorf("ordinary fresh scene invalid: %w", err))
	}
}

func TestPlayableSceneApproachingTheRealGuardStartsSharedCombat(t *testing.T) {
	r, c, d := playableFixture(t, true)
	// Wait for the patrol to vacate its first post, then walk to that known
	// authored post. Detection/hostility, encounter creation and attacks are
	// ordinary host decisions; the test never supplies a recognition outcome.
	for frame := 0; frame < 120 && r.state.Life.Actor(d.Guard).Position == d.GuardRoute[0]; frame++ {
		r.step()
	}
	seq := uint64(r.state.Tick) + 1
	r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: seq, X: int32(d.GuardRoute[0].X), Y: int32(d.GuardRoute[0].Y)})
	accepted := false
	for len(c.out) > 0 {
		if result := (<-c.out).GetMoveResult(); result != nil {
			accepted = result.Ok
		}
	}
	if !accepted {
		t.Fatal("player could not approach the guard's vacated real post")
	}
	for frame := 0; frame < 2400 && !r.heroInCombat(); frame++ {
		r.step()
	}
	if !r.heroInCombat() || r.state.Combat.Actor(d.Guard) == nil || r.state.Combat.Actor(playerActorID) == nil || !r.state.Life.Actor(d.Guard).CombatHold {
		t.Fatal("actual recognition/hostility never entered shared combat")
	}
	before := r.state.Life.Actor(d.Guard).Position
	for turn := 0; turn < 8 && r.state.Combat.Active; turn++ {
		result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: fmt.Sprintf("scene.combat.end.%d", turn), Action: "end", ExpectedTurn: r.state.Combat.Turn})
		if !result.Ok {
			t.Fatal(result)
		}
		for _, event := range r.state.Combat.Events {
			if event.ActorID == d.Guard && event.Type == "attack" {
				baton := playableSceneItem(t, r, "scene.stealth.guard_baton")
				if baton.Condition >= 1000000 {
					t.Fatal("guard attacked without wearing its physical baton")
				}
				return
			}
		}
	}
	t.Fatalf("shared guard never executed a physical tactical attack; from=%+v now=%+v", before, r.state.Life.Actor(d.Guard).Position)
}

func TestPlayableSceneAuthoredHostileQuietRetrievalCanActuallyBeCompleted(t *testing.T) {
	r, c, d := playableFixture(t, true)
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_LifeCommand{LifeCommand: &pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: "scene.route.quiet", Action: "stealth", Destination: "on"}}}})
	if result, _ := playableDrain(c); result == nil || !result.Ok {
		t.Fatal("ordinary quiet-walk command failed", result)
	}
	panel := playableFind(t, d, "power_toggle")
	playableUse(t, r, c, panel, "scene.route.dark")
	bell := playableFind(t, d, "noise")
	// The real interaction allows an adjacent standing point. Ring from the
	// east side of the post so retreat does not first walk toward the west wall.
	playableWalk(t, r, c, behavior.Cell{X: bell.At.X + 1, Y: bell.At.Y})
	// This repeatable route waits one authored game minute from entry: the
	// guard is on the far side of its public patrol. No perception score,
	// target position, NPC pose or clock is assigned to make that happen.
	for r.state.Life.Seconds < d.StartSecond+60 {
		if r.heroInCombat() {
			t.Fatal("guard detected the stationary quiet player before distraction")
		}
		r.step()
	}
	if result, _ := playableAction(t, r, c, bell.ID, "scene.route.bell"); !result.Ok {
		t.Fatal(result)
	}
	if guard := r.state.Life.Actor(d.Guard); guard.Safety == nil || guard.Safety.Reason != "stealth observation" {
		t.Fatalf("authored bell failed to draw the actual guard at %d: %+v", r.state.Life.Seconds-d.StartSecond, guard)
	}
	// Cross the real south opening of the service screen while the guard
	// heads toward the anonymous sound. These are ordinary MoveTo waypoints.
	playableWalk(t, r, c, behavior.Cell{X: 4, Y: 21})
	playableWalk(t, r, c, behavior.Cell{X: 7, Y: 21})
	playableWalk(t, r, c, behavior.Cell{X: 9, Y: 16})
	playableWalk(t, r, c, behavior.Cell{X: 11, Y: 15})
	playableWalk(t, r, c, behavior.Cell{X: 18, Y: 15})
	playableWalk(t, r, c, behavior.Cell{X: 18, Y: 18})
	var keySource string
	for _, source := range d.Sources {
		if source.Definition == d.KeyDefinition {
			keySource = source.ID
		}
	}
	playableUse(t, r, c, playableTakeAction(t, d, keySource), "scene.route.key")
	gate := playableFind(t, d, "gate_toggle")
	playableUse(t, r, c, gate, "scene.route.gate")
	for frame := 0; frame < 600 && !r.state.Life.Gates[d.Gate].Passable(); frame++ {
		if r.heroInCombat() {
			t.Fatal("actual guard detected the quiet player waiting behind cover")
		}
		r.step()
	}
	if !r.state.Life.Gates[d.Gate].Passable() {
		t.Fatal("real gate never cleared for the quiet route")
	}
	playableUse(t, r, c, playableTakeAction(t, d, d.GoalSource), "scene.route.objective")
	// Return along the same cover and south edge. The shortest route through
	// row20 is still lit by the independent emergency tube after main power off.
	playableWalk(t, r, c, behavior.Cell{X: 18, Y: 15})
	playableWalk(t, r, c, behavior.Cell{X: 11, Y: 15})
	playableWalk(t, r, c, behavior.Cell{X: 9, Y: 16})
	playableWalk(t, r, c, behavior.Cell{X: 7, Y: 21})
	playableWalk(t, r, c, behavior.Cell{X: 4, Y: 21})
	playableUse(t, r, c, playableFind(t, d, "exit"), "scene.route.exit")
	if !r.state.Playable.Completed || !r.state.Paused || !r.playableGoalCarried(d) || r.heroInCombat() || r.state.CombatSerial != 0 {
		t.Fatal("individually green systems did not form an undetected playable route")
	}
}
