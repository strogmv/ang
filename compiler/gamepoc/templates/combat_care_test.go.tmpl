// Code generated by ANG. Injuries originate in real accepted strikes, not preset outcomes.
package poc

import (
	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"reflect"
	"testing"
)

func combatCareInjury(t *testing.T, stun, patches bool) (*Runtime, *connection, string) {
	t.Helper()
	r, c, target := combatLifeFixture(t, true)
	combatPhysicalFixture(t, r, target, false)
	r.world.CombatLife.Responders = map[string]combatResponder{}
	r.world.CombatRuntime.InjuryIntervalSeconds = 6
	w := r.world.CombatRuntime.Weapons[combatFixtureGun]
	w.Damage = 8
	w.Bleed = 4
	w.Suppression = 20
	if stun {
		w = behavior.CombatWeapon{ID: combatFixtureGun, Kind: "blunt", Damage: 40, RangeMM: 12000, AttackAP: 3, HeavyAP: 4, HeavyDamagePercent: 100}
		r.world.CombatRuntime.Armor[combatFixtureHelmet] = behavior.CombatArmor{}
	}
	r.world.CombatRuntime.Weapons[combatFixtureGun] = w
	if patches {
		m := r.inventoryModelFor(true)
		m.Sources = append(m.Sources, inv.Source{ID: "combat.care.medical", Definition: "item.med_patch", Quantity: 2, Condition: 1000000, Owner: target, Location: inv.Location{Kind: "store", Store: inv.ActorStore(target)}})
		r.world.Inventory = m
		r.lifeInventory = lifeInventoryCache{}
		var err error
		r.state.Inventory, err = inv.New(r.inventoryModelFor(true), r.state.Seed)
		if err != nil {
			t.Fatal(err)
		}
	}
	combatStart(t, r, c, target)
	command := &pb.PocCombatCommand{RequestId: "care.injury", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}
	if stun {
		command.Mode = "heavy"
		command.BodyPart = "head"
	}
	result, _ := combatWire(t, r, c, command)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	injured := r.state.Combat.Actor(target)
	if injured == nil || injured.HP <= 0 || stun && injured.StunTurns == 0 || !stun && injured.Bleeding == 0 {
		t.Fatalf("actual strike did not cause expected surviving injury: %+v", injured)
	}
	result, _ = combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "care.real.surrender", Action: "surrender", ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok || r.state.Combat.Active {
		t.Fatal("accepted surrender did not finish encounter", result)
	}
	return r, c, target
}

func TestCombatCareBloodFollowsLifeClockAndSurvivesSave(t *testing.T) {
	r, _, target := combatCareInjury(t, false, false)
	old := r.state.CombatRoster[target]
	ownPatches := r.combatCount(r.state.Inventory, target, "item.med_patch", nil)
	for i := 0; i < 5; i++ {
		r.combatCareTrack()
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	if r.state.CombatRoster[target].HP != old.HP {
		t.Fatal("fractional injury interval was charged early")
	}
	r.state.Tick++
	if err := r.advanceLifeFrameBy(1); err != nil {
		t.Fatal(err)
	}
	after := r.state.CombatRoster[target]
	if after.HP != old.HP-old.Bleeding || after.Bleeding != old.Bleeding || r.combatCount(r.state.Inventory, target, "item.med_patch", nil) != ownPatches {
		t.Fatalf("blood/physical stock mismatch old=%+v after=%+v", old, after)
	}
	if after.Suppression >= old.Suppression && old.Suppression > 0 {
		t.Fatal("suppression froze outside the encounter")
	}
	// Repeated publication of inactive encounter history must not resurrect its
	// old health, supplies or physical position over the current world.
	body := r.state.Life.Actor(target).Position
	r.syncCombatLife()
	if r.state.CombatRoster[target].HP != after.HP || r.state.CombatRoster[target].Bleeding != after.Bleeding || r.state.Life.Actor(target).Position != body {
		t.Fatal("inactive encounter republished historical injury/body over current care")
	}
	saved := r.snapshotState()
	clone := saved.CombatCare.Clone()
	clone.Clocks[target]--
	if clone.Clocks[target] == r.state.CombatCare.Clocks[target] {
		t.Fatal("care clocks share mutable storage")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, saved); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(saved.CombatCare, loaded.CombatCare) || loaded.CombatRoster[target].HP != after.HP {
		t.Fatal("save restored health or lost interval remainder")
	}
	bad := saved
	bad.CombatCare = saved.CombatCare.Clone()
	bad.CombatCare.Clocks[target] = saved.Life.Seconds + 1
	if r.validateCombatCare(bad) == nil {
		t.Fatal("future injury clock accepted")
	}
	bad.CombatCare = saved.CombatCare.Clone()
	delete(bad.CombatCare.Clocks, target)
	if r.validateCombatCare(bad) == nil {
		t.Fatal("missing injury clock could postpone blood on load")
	}
}
func TestCombatCareNPCBandagesWithOwnedFiniteMaterialsWithoutHealing(t *testing.T) {
	r, _, target := combatCareInjury(t, false, true)
	old := r.state.CombatRoster[target]
	own := r.combatCount(r.state.Inventory, target, "item.med_patch", nil)
	hero := r.combatCount(r.state.Inventory, playerActorID, "item.med_patch", nil)
	r.state.Tick++
	if err := r.advanceLifeFrameBy(6); err != nil {
		t.Fatal(err)
	}
	after := r.state.CombatRoster[target]
	if own != 2 || r.combatCount(r.state.Inventory, target, "item.med_patch", nil) != own-1 || r.combatCount(r.state.Inventory, playerActorID, "item.med_patch", nil) != hero {
		t.Fatal("NPC bandaging did not debit exactly its own physical patch")
	}
	if after.HP != old.HP-old.Bleeding || after.Bleeding != max(0, old.Bleeding-r.world.CombatRuntime.Rules.BandageAmount) {
		t.Fatal("bandage healed HP or left blood loss unchanged")
	}
	r.state.Tick++
	if err := r.advanceLifeFrameBy(60); err != nil {
		t.Fatal(err)
	}
	if r.combatCount(r.state.Inventory, target, "item.med_patch", nil) != own-1 || r.state.CombatRoster[target].HP != after.HP {
		t.Fatal("healthy interval fabricated healing or wasted materials")
	}
}
func TestCombatCareStunPinsActualBodyThenReleasesWithoutHealing(t *testing.T) {
	r, _, target := combatCareInjury(t, true, false)
	old := r.state.CombatRoster[target]
	at := r.state.Life.Actor(target).Position
	if !r.state.Life.Actor(target).CombatHold {
		t.Fatal("finished encounter released an unconscious body")
	}
	r.state.Tick++
	if err := r.advanceLifeFrameBy(5); err != nil {
		t.Fatal(err)
	}
	if r.state.Life.Actor(target).Position != at || !r.state.Life.Actor(target).CombatHold || r.state.CombatRoster[target].StunTurns != old.StunTurns {
		t.Fatal("stunned actor moved or recovered before physical time elapsed")
	}
	r.state.Tick++
	if err := r.advanceLifeFrameBy(1); err != nil {
		t.Fatal(err)
	}
	if r.state.Life.Actor(target).CombatHold || r.state.CombatRoster[target].StunTurns != 0 || r.state.CombatRoster[target].HP != old.HP {
		t.Fatal("stun expiry did not release only capability, preserving HP")
	}
}
func TestCombatCareTransitDefersInjuryWithoutHistoricalBodyTeleport(t *testing.T) {
	r, _, target := combatCareInjury(t, false, false)
	actor := r.state.Life.Actor(target)
	// Initial transport fixture: an actual catalog edge and its departure floor.
	// No physiology or injury outcome is assigned; it came from the accepted shot.
	var edge *behavior.LifeEdge
	for i := range r.world.Life.Edges {
		e := &r.world.Life.Edges[i]
		if e.Mode == "walk" && e.TravelSeconds >= 2 {
			edge = e
			break
		}
	}
	if edge == nil {
		t.Fatal("world lacks authored walk edge")
	}
	actor.Level = edge.From
	actor.Position = edge.Exit
	actor.Goal = edge.Entry
	actor.Path = nil
	actor.PendingPath = nil
	actor.Trip = &behavior.LifeTrip{Edge: edge.ID, Departure: r.state.Life.Seconds, Arrival: r.state.Life.Seconds + edge.TravelSeconds}
	actor.ResidenceID = ""
	actor.Safety = nil
	actor.CombatHold = false
	before := r.state.CombatRoster[target]
	clock := r.state.CombatCare.Clocks[target]
	elapsed := min(int64(30), edge.TravelSeconds/2)
	r.state.Life.Seconds += elapsed
	if err := r.advanceCombatCare(); err != nil {
		t.Fatal(err)
	}
	if actor.Trip == nil || actor.Position != edge.Exit || actor.CombatHold || r.state.CombatRoster[target].HP != before.HP || r.state.CombatCare.Clocks[target] != clock {
		t.Fatal("care materialized an injured passenger or lost deferred time")
	}
	// Arrival is performed by the real transport kernel, then care sees the new
	// physical floor. Catch-up can kill there, never at the old combat position.
	r.state.Tick++
	if err := r.advanceLifeFrameBy(edge.TravelSeconds - elapsed); err != nil {
		t.Fatal(err)
	}
	actor = r.state.Life.Actor(target)
	if actor.Trip != nil || actor.Level != edge.To || !r.world.Life.Walks(actor.Level, actor.Position) {
		t.Fatalf("real transport arrival changed: %+v edge=%+v", actor, edge)
	}
	after := r.state.CombatRoster[target]
	if after.HP != max(0, before.HP-int((r.state.Life.Seconds-clock)/6)*before.Bleeding) || after.Position != actor.Position {
		t.Fatal("physical arrival did not catch up untreated blood at its actual floor")
	}
	if after.HP == 0 && !actor.CombatHold {
		t.Fatal("fatal arrival failed to preserve physical body")
	}
}
