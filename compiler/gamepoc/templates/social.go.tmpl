func(r *Runtime) recordSceneMemory(a *demoAgent,observation behavior.Observation)(seen bool){
 d:=&r.state.Demo;p:=r.world.AI.Policy.Social;mp:=r.world.AI.Policy.Memory;tick:=r.state.Tick
 if !d.Issued&&!r.offenceVisible(){return false}
 if d.Issued&&tick==d.IssuedTick&&behavior.Distance(cell(a.Position),cell(d.Call))<=p.HearingRange{a.Memory.Record(behavior.Fact{Subject:observation.SubjectID,Kind:"incident",Source:"hearing",Cause:d.CallCause,Value:observation.Active,Position:cell(d.Call),ObservedTick:tick},mp)}
