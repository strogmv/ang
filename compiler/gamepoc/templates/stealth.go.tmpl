// Code generated by ANG. Pre-combat stealth extends combat v2's Life and hearing.
package poc

import (
	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"container/heap"
	"errors"
	"fmt"
	"math"
	"sort"
)

type stealthWatcher struct {
	FaceX            float64 `json:"face_x"`
	FaceY            float64 `json:"face_y"`
	InvestigateSteps bool    `json:"investigate_steps"`
}
type stealthCatalog struct {
	FrameSeconds int64 `json:"frame_seconds"`
	behavior.StealthPolicy
	StepMM          int                       `json:"step_mm"`
	SneakSpeed      float64                   `json:"sneak_speed"`
	SurfaceLoudness map[string]float64        `json:"surface_loudness"`
	Watchers        map[string]stealthWatcher `json:"watchers"`
}

func (c stealthCatalog) Validate(l behavior.LifeModel, combat combatLifeCatalog) error {
	if !c.Enabled {
		return nil
	}
	if err := c.StealthPolicy.Validate(); err != nil {
		return err
	}
	if c.FrameSeconds != 1 || !combat.Enabled || c.StepMM < 200 || c.StepMM > 2000 || !(c.SneakSpeed >= .2 && c.SneakSpeed <= .9) || c.SneakSpeed != l.HeroBody.SneakFactor || c.SoundMemorySeconds > combat.ThreatMemorySeconds || len(c.Watchers) > combat.MaxWitnesses {
		return errors.New("invalid stealth world policy")
	}
	for id, w := range c.Watchers {
		n := math.Hypot(w.FaceX, w.FaceY)
		if id == playerActorID || l.Person(id) == nil || !(n > 0 && n <= 1.01) {
			return errors.New("invalid stealth observer")
		}
	}
	for _, v := range c.SurfaceLoudness {
		if !(v > 0 && v <= 3) {
			return errors.New("invalid step surface")
		}
	}
	return nil
}

type stealthObserver struct {
	Level        string
	At           behavior.Cell
	FaceX, FaceY float64
	Contact      behavior.StealthContact
}
type stealthState struct {
	Observers                  map[string]stealthObserver
	Sampled                    bool
	Level                      string
	X, Y, WalkedMM, FootfallMM float64
	NoiseSequence              uint64
	// The hero's last real direction of motion: what another actor's takedown check reads as his facing.
	HeroFaceX, HeroFaceY float64
}

func (s stealthState) Clone() stealthState {
	if s.Observers != nil {
		m := map[string]stealthObserver{}
		for id, o := range s.Observers {
			m[id] = o
		}
		s.Observers = m
	}
	return s
}
func (r *Runtime) stealthPlan(level string, at behavior.Cell) (float64, float64) {
	unit := r.world.Life.Locations[level].CellMM
	if unit < 1 {
		unit = 1000
	}
	if v := r.world.Decks[level]; v != nil {
		p, _, _, ok := v.Locate(at)
		if ok {
			at = p
		}
	}
	return (float64(at.X) + .5) * float64(unit), (float64(at.Y) + .5) * float64(unit)
}
func (r *Runtime) stealthCommand(mode string) error {
	h := r.state.Life.Actor(playerActorID)
	if !r.world.Stealth.Enabled || r.state.Paused || h == nil || !h.OnFloor() || h.CombatHold || r.heroInCombat() {
		return textError{Key: "error.stealth.unavailable"}
	}
	if mode != "on" && mode != "off" && mode != "upright" {
		return textError{Key: "error.stealth.mode"}
	}
	r.heroBodyNow()
	h.Sneaking = mode != "off"
	h.SneakUpright = mode == "upright"
	if h.Sneaking {
		r.state.Life.SecondsPerTick = r.world.Stealth.FrameSeconds
	}
	if h.Body != nil && h.Sneaking {
		h.Body.Run = false
	}
	h.Manual = true
	return nil
}

// Only authored observers use gradual identification. Ordinary neutral people
// retain their existing social perception; a quiet walk is not itself an offence.
func (r *Runtime) combatWorldIdentifies(observer combatLifeObserver, targetID string) bool {
	target, present := r.combatWorldActor(targetID)
	if !present || target.Level != observer.Level {
		return false
	}
	if targetID != playerActorID || !r.world.Stealth.Enabled {
		return r.combatWorldVisible(observer, target.At)
	}
	if _, watched := r.world.Stealth.Watchers[observer.ID]; !watched {
		return r.combatWorldVisible(observer, target.At)
	}
	o, ok := r.state.Stealth.Observers[observer.ID]
	return ok && o.Level == observer.Level && o.At == observer.At && o.Contact.LastSeen == target.At && o.Contact.Visible && o.Contact.SeenAt == r.state.Life.Seconds
}
func (r *Runtime) stealthEvidence(h *behavior.LifeActor, o combatLifeObserver, face stealthObserver, moving bool, light illuminationBodySample) behavior.StealthEvidence {
	x, y := r.stealthPlan(o.Level, o.At)
	tx, ty := r.stealthPlan(h.Level, h.Position)
	if h.Body != nil {
		tx, ty = h.Body.X, h.Body.Y
	}
	dx, dy := tx-x, ty-y
	length := math.Hypot(dx, dy)
	dot := 1.0
	if length > 0 {
		dot = math.Max(-1, math.Min(1, (dx*face.FaceX+dy*face.FaceY)/length))
	}
	exposure := 0.0
	lightFactor := 1.0
	if r.combatObserverSees(o.Level, o.ID, o.At, h.Position) {
		exposure = 1
	}
	if v := r.world.Decks[o.Level]; v != nil {
		target := behavior.Combatant{ID: h.ID, Position: h.Position, Crouched: h.Sneaking && !h.SneakUpright}
		exposure = 1 - v.CombatPoseProtection(o.At, h.Position, behavior.Combatant{ID: o.ID, Position: o.At}, target, "")

		if light.Known {
			// With authored light use the same precise XYZ rays for sight and
			// shadow. A half-raised gate reveals the actual body parts below it.
			eye := v.BodyLightPoints(o.At, behavior.Combatant{})[2]
			eye.Z -= 50
			optical := r.world.Illumination.Levels[o.Level]
			boxes := r.illuminationBoxes(optical)
			total, weighted := 0.0, 0.0
			for i, p := range light.Points {
				if optical.rays != nil && optical.rays.RayClearMM(eye, p, boxes) {
					total++
					weighted += light.Factor[i]
				}
			}
			exposure = total / 3
			if total > 0 {
				lightFactor = weighted / total
			} else {
				lightFactor = 0
			}
		} else if r.combatGateBlocks(o.Level, o.At, h.Position) {
			exposure = 0
		}

	}
	heightDelta := 0.0
	if v := r.world.Decks[o.Level]; v != nil {
		_, oh, _, oko := v.Locate(o.At)
		_, th, _, okt := v.Locate(h.Position)
		if oko && okt {
			heightDelta = float64(th - oh)
		}
	}
	return behavior.StealthEvidence{DistanceMM: int(math.Ceil(math.Hypot(length, heightDelta))), FacingDot: dot, Exposure: exposure, Moving: moving, Sneaking: h.Sneaking && !h.SneakUpright, LightKnown: light.Known, LightFactor: lightFactor}
}
func (r *Runtime) advanceStealth() error {
	if !r.world.Stealth.Enabled || !r.state.Life.Enabled || !r.state.Active || r.state.Paused {
		return nil
	}
	s := &r.state.Stealth
	for id, o := range s.Observers {
		a := r.state.Life.Actor(id)
		if a == nil || a.Level != o.Level || !a.OnFloor() {
			delete(s.Observers, id)
		}
	}
	h := r.state.Life.Actor(playerActorID)
	if h == nil || !h.OnFloor() || h.CombatHold {
		s.Sampled = false
		return nil
	}
	x, y := r.stealthPlan(h.Level, h.Position)
	running := false
	if h.Body != nil {
		x, y = h.Body.X, h.Body.Y
		running = h.Body.Run
	}
	moving, step := false, false
	if s.Sampled && s.Level == h.Level {
		distance := math.Max(0, h.WalkedMM-s.WalkedMM)
		moving = distance > .01
		s.FootfallMM += distance
		if s.FootfallMM >= float64(r.world.Stealth.StepMM) {
			step = true
			s.FootfallMM = math.Mod(s.FootfallMM, float64(r.world.Stealth.StepMM))
			if s.NoiseSequence < 1<<50 {
				s.NoiseSequence++
			}
		}
	} else {
		s.FootfallMM = 0
	}
	if s.Sampled && s.Level == h.Level && moving && math.Hypot(x-s.X, y-s.Y) > .01 {
		n := math.Hypot(x-s.X, y-s.Y)
		s.HeroFaceX, s.HeroFaceY = (x-s.X)/n, (y-s.Y)/n
	}
	s.Sampled = true
	s.Level = h.Level
	s.X = x
	s.Y = y
	s.WalkedMM = h.WalkedMM
	if s.Observers == nil {
		s.Observers = map[string]stealthObserver{}
	}
	light := r.illuminationBody(h)
	ids := make([]string, 0, len(r.world.Stealth.Watchers))
	for id := range r.world.Stealth.Watchers {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	noiseListeners := map[string]bool{}
	if step {
		candidates := []behavior.Listener{}
		for _, id := range ids {
			a := r.state.Life.Actor(id)
			if a == nil || !a.OnFloor() || a.Level != h.Level || !r.world.Stealth.Watchers[id].InvestigateSteps {
				continue
			}
			px, py := r.stealthPlan(a.Level, a.Position)
			candidates = append(candidates, behavior.Listener{ID: id, Position: behavior.Cell{X: int(px), Y: int(py)}})
		}
		for _, listener := range r.world.AI.Policy.Perception.Hearing.Listeners(behavior.Sound{Origin: behavior.Cell{X: int(x), Y: int(y)}}, candidates) {
			noiseListeners[listener.ID] = true
		}
	}
	now := r.state.Life.Seconds
	activities := r.lifeActivityBodies(h.Level)
	for _, id := range ids {
		profile := r.world.Stealth.Watchers[id]
		a := r.state.Life.Actor(id)
		if a == nil || !a.OnFloor() || a.Level != h.Level || a.CombatHold || !r.combatWorldConscious(id) {
			delete(s.Observers, id)
			continue
		}
		o, exists := s.Observers[id]
		if !exists || o.Level != a.Level {
			o = stealthObserver{Level: a.Level, At: a.Position, FaceX: profile.FaceX, FaceY: profile.FaceY, Contact: behavior.StealthContact{UpdatedAt: max(0, now-1)}}
		}
		px, py := r.stealthPlan(a.Level, o.At)
		nx, ny := r.stealthPlan(a.Level, a.Position)
		dx, dy := nx-px, ny-py
		if length := math.Hypot(dx, dy); length > .01 {
			o.FaceX = dx / length
			o.FaceY = dy / length
		}
		if b, ok := activities[id]; ok {
			view := &pb.PocAgentState{}
			r.setLifeActivity(view, b)
			if view.ActivitySpot != nil {
				yaw := view.ActivitySpot.YawDeg * math.Pi / 180
				o.FaceX, o.FaceY = math.Sin(yaw), math.Cos(yaw)
			}
		}
		norm := math.Hypot(o.FaceX, o.FaceY)
		o.FaceX /= norm
		o.FaceY /= norm
		o.At = a.Position
		observer := combatLifeObserver{ID: id, Level: a.Level, At: a.Position}
		o.Contact.Advance(r.world.Stealth.StealthPolicy, r.stealthEvidence(h, observer, o, moving, light), h.Position, now)
		if step && profile.InvestigateSteps && noiseListeners[id] {
			surface := 1.0
			if tile := r.world.Life.Locations[h.Level].Terrain[h.Position.Y][h.Position.X]; r.world.Stealth.SurfaceLoudness[string(tile)] > 0 {
				surface = r.world.Stealth.SurfaceLoudness[string(tile)]
			}
			loudness := r.world.AI.Policy.Perception.Hearing.Loudness("step", h.Sneaking, surface)
			if running && !h.Sneaking {
				loudness = math.Min(1, loudness*r.world.Life.HeroBody.RunFactor)
			}
			if heard, ok := r.combatWorldHeard(observer, h.Position, loudness); ok {
				r.combatWorldRemember(id, behavior.Fact{Subject: fmt.Sprintf("noise.steps.%d", s.NoiseSequence), Kind: "combat.noise", Source: "sound", Value: true, Position: heard.Estimate, Radius: heard.Radius, Strength: heard.Intensity, ObservedTick: now, ExpiresTick: now + r.world.Stealth.SoundMemorySeconds, Priority: 10})
				// Orient to the uncertain sound, never to the unheard true source.
				hx, hy := r.stealthPlan(a.Level, heard.Estimate)
				dx, dy = hx-nx, hy-ny
				if length := math.Hypot(dx, dy); length > .01 {
					o.FaceX = dx / length
					o.FaceY = dy / length
				}
			}
		}
		s.Observers[id] = o
		if !profile.InvestigateSteps {
			continue
		}
		if o.Contact.Visible {
			r.clearStealthSearch(id)
			continue
		}
		at, until, known := behavior.Cell{}, int64(0), false
		if o.Contact.HasSeen {
			at, until, known = o.Contact.LastSeen, o.Contact.SeenAt+r.world.Stealth.ForgetSeconds, true
		}
		m := r.state.CombatWorld.Memories[id]
		if f, ok := m.Best("combat.noise"); ok && f.ExpiresTick > now && (!known || f.ObservedTick > o.Contact.SeenAt) {
			at, until, known = f.Position, f.ExpiresTick, true
		}
		if known && until > now {
			r.stealthSearch(observer, at, until)
		} else {
			r.clearStealthSearch(id)
		}
	}
	return nil
}
func (r *Runtime) clearStealthSearch(id string) {
	if a := r.state.Life.Actor(id); a != nil && a.Safety != nil && a.Safety.Reason == "stealth observation" {
		r.state.Life.ClearSafety(id)
	}
}

type stealthSearchNode struct {
	At              behavior.Cell
	Steps, Distance int
}
type stealthSearchQueue []stealthSearchNode

func (q stealthSearchQueue) Len() int { return len(q) }
func (q stealthSearchQueue) Less(i, j int) bool {
	a, b := q[i], q[j]
	if af, bf := a.Distance+a.Steps*100, b.Distance+b.Steps*100; af != bf {
		return af < bf
	}
	if a.Distance != b.Distance {
		return a.Distance < b.Distance
	}
	if a.Steps != b.Steps {
		return a.Steps < b.Steps
	}
	if a.At.Y != b.At.Y {
		return a.At.Y < b.At.Y
	}
	return a.At.X < b.At.X
}
func (q stealthSearchQueue) Swap(i, j int) { q[i], q[j] = q[j], q[i] }
func (q *stealthSearchQueue) Push(v any)   { *q = append(*q, v.(stealthSearchNode)) }
func (q *stealthSearchQueue) Pop() any {
	old := *q
	n := len(old)
	v := old[n-1]
	*q = old[:n-1]
	return v
}

// Prefer the remembered place over breadth-first expansion into unrelated
// rooms. The cap counts discovered cells, including the actor's own cell;
// neither hidden occupants nor the hero's current position enter this search.
func (r *Runtime) stealthSearchGoal(model behavior.LifeModel, level string, start, estimate behavior.Cell) behavior.Cell {
	seen := map[behavior.Cell]bool{start: true}
	first := stealthSearchNode{At: start, Distance: r.combatWorldDistance(level, start, estimate)}
	queue := stealthSearchQueue{first}
	best := first
	for queue.Len() > 0 {
		at := heap.Pop(&queue).(stealthSearchNode)
		if at.At == estimate {
			return estimate
		}
		if at.Distance < best.Distance || at.Distance == best.Distance && at.Steps < best.Steps {
			best = at
		}
		neighbours := stealthSearchQueue{}
		for _, next := range model.StepNeighbours(level, at.At) {
			if seen[next] || !model.Walks(level, next) {
				continue
			}
			neighbours = append(neighbours, stealthSearchNode{At: next, Steps: at.Steps + 1, Distance: r.combatWorldDistance(level, next, estimate)})
		}
		// The final available slot must follow the same priority as the open
		// frontier, rather than favouring north merely because it was listed first.
		sort.Sort(neighbours)
		for _, next := range neighbours {
			if len(seen) >= r.world.CombatLife.MaxSafetyCells {
				break
			}
			if seen[next.At] {
				continue
			}
			seen[next.At] = true
			heap.Push(&queue, next)
		}
	}
	return best.At
}

// Plan from static familiar geometry and the remembered estimate. Actual bodies
// can interrupt execution, but their hidden positions cannot steer this search.
func (r *Runtime) stealthSearch(o combatLifeObserver, estimate behavior.Cell, until int64) {
	a := r.state.Life.Actor(o.ID)
	if a == nil || a.Manual || a.CombatHold {
		return
	}
	if a.Safety != nil && a.Safety.Reason != "stealth observation" {
		return
	}
	if until <= r.state.Life.Seconds {
		r.clearStealthSearch(o.ID)
		return
	}
	if a.Safety != nil && a.Safety.ThreatAt == estimate {
		a.Safety.Until = until
		if !a.Arrived || a.Position != a.Safety.Goal || a.Position == estimate || r.state.Life.Seconds < a.Brain.PathRetrySecond && a.StartedAt != r.state.Life.Seconds {
			return
		}
	}
	// GateModel is the existing physical door adapter. It still exposes global
	// gate glyphs; this change does not introduce per-observer door knowledge.
	model := r.state.Life.GateModel(r.world.Life)
	best := r.stealthSearchGoal(model, o.Level, o.At, estimate)
	if a.Safety != nil && a.Safety.ThreatAt == estimate && a.Safety.Goal == best {
		// Reuse Life's saved ordinary path-retry clock for an unreachable or
		// exhausted local minimum, rather than resetting the actor every frame.
		a.Brain.PathRetrySecond = r.state.Life.Seconds + 10
		return
	}
	if err := r.state.Life.ApplySafety(model, o.ID, behavior.LifeSafetyOverride{Level: o.Level, Goal: best, ThreatAt: estimate, Until: until, LabelKey: "life.stealth.investigate", Activity: "investigate", Reason: "stealth observation"}); err == nil && best == a.Position && best != estimate {
		a.Brain.PathRetrySecond = r.state.Life.Seconds + 10
	}
}
func (r *Runtime) validateStealth(s state) error {
	if s.Stealth.NoiseSequence > 1<<50 || len(s.Stealth.Observers) > len(r.world.Stealth.Watchers) || !(s.Stealth.FootfallMM >= 0 && s.Stealth.FootfallMM < float64(max(1, r.world.Stealth.StepMM))) {
		return errors.New("invalid stealth state")
	}
	if !(s.Stealth.WalkedMM >= 0 && s.Stealth.WalkedMM <= 1e15) {
		return errors.New("invalid sampled walking distance")
	}
	if s.Stealth.Sampled {
		if _, ok := r.world.Life.Locations[s.Stealth.Level]; !ok || !finiteStealth(s.Stealth.X) || !finiteStealth(s.Stealth.Y) {
			return errors.New("invalid stealth movement sample")
		}
	}
	for id, o := range s.Stealth.Observers {
		if _, ok := r.world.Stealth.Watchers[id]; !ok {
			return errors.New("unknown stealth observer")
		}
		a := s.Life.Actor(id)
		c := o.Contact
		n := math.Hypot(o.FaceX, o.FaceY)
		if a == nil || o.Level != a.Level || !r.world.Life.Walks(o.Level, o.At) || !(n > .99 && n < 1.01) || !(c.Score >= 0 && c.Score <= 1000) || c.UpdatedAt < 0 || c.UpdatedAt > s.Life.Seconds || c.SeenAt < 0 || c.SeenAt > c.UpdatedAt || c.Visible && (!c.HasSeen || c.Score < 1000) || c.HasSeen && !r.world.Life.Walks(o.Level, c.LastSeen) {
			return errors.New("invalid private stealth observation")
		}
	}
	for _, a := range s.Life.Actors {
		if a.Sneaking && (a.ID != playerActorID || !r.world.Stealth.Enabled) {
			return errors.New("invalid sneaking actor")
		}
	}
	return nil
}
func finiteStealth(v float64) bool { return !math.IsNaN(v) && !math.IsInf(v, 0) && v >= 0 && v <= 1e9 }
