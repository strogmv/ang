  canTravel:=false;if !current&&n.LevelID!=""&&hero.Trip==nil&&reachable[n.ID]{_,exists:=r.world.Life.Locations[n.LevelID];canTravel=exists&&r.world.Life.NextEdge(hero.Level,n.LevelID)!=nil}
  result.Nodes=append(result.Nodes,&pb.PocRegionNode{Id:n.ID,Name:r.localText(locale,"region.node."+n.ID+".name",n.Name),DeckId:n.DeckID,X:n.X,Y:n.Y,Width:n.Width,Height:n.Height,Knowledge:knowledge,LevelId:n.LevelID,Current:current,CanTravel:canTravel,Description:r.localText(locale,"region.node."+n.ID+".description",n.Description)});visibleDecks[n.DeckID]=true
 }
 for _,e:=range r.world.Region.Links{if k.KnownLinks[e.ID]&&k.KnownNodes[e.FromNode]&&k.KnownNodes[e.ToNode]{result.Links=append(result.Links,&pb.PocRegionLink{Id:e.ID,FromNode:e.FromNode,ToNode:e.ToNode,Mode:e.Mode})}}
