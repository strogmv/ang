// Real runtime inventory, model data and machine clock. The physical carrier is
// deliberately waiting at its actual receiving point: even at x30 it cannot
// collect a future consignment before the mechanism's receiving handoff.
func TestLiftingDeckMarketFreightConservationClocksAndSave(t *testing.T){
 for _,rate:=range []int64{1,10,30}{t.Run(map[int64]string{1:"1",10:"10",30:"30"}[rate],func(t *testing.T){
  r:=lifeRuntimeFixture(t);var d liftingDeckDefinition;for _,candidate:=range r.world.LiftingDecks.Decks{if candidate.Freight!=nil{d=candidate;break}};if d.Freight==nil{t.Skip("no inbound deck freight")}
  r.state.Life.Seconds=86400+d.Freight.FirstSecond-1;r.initLiftingDecks();total:=commerceTotal(r.state.Inventory)
  for _,delivery:=range r.world.Inventory.Deliveries{actor:=r.state.Life.Actor(delivery.Carrier);actor.Level=delivery.Pickup.Level;actor.Position=behavior.Cell{X:delivery.Pickup.At.X,Y:delivery.Pickup.At.Y};actor.Goal=actor.Position;actor.Manual=true;actor.Path=nil;actor.Trip=nil;actor.ResidenceID="";actor.Body=nil}
  manifest:=map[string][]string{};onDeck,received,saved:=false,false,false;var replay *Runtime
  for tick:=0;tick<1400;tick++{
   r.state.Tick++;r.state.Life.Tick=r.state.Tick;r.state.Life.Seconds+=rate;r.advanceLiftingDecks(r.state.Life.Seconds);if err:=r.advanceMarketSupply();err!=nil{t.Fatal(err)}
   if replay!=nil{replay.state.Tick++;replay.state.Life.Tick=replay.state.Tick;replay.state.Life.Seconds+=rate;replay.advanceLiftingDecks(replay.state.Life.Seconds);if err:=replay.advanceMarketSupply();err!=nil{t.Fatal(err)};if !reflect.DeepEqual(r.state.Inventory,replay.state.Inventory)||!reflect.DeepEqual(r.state.LiftingDecks,replay.state.LiftingDecks){t.Fatal("saved cargo/physical cycle diverged")}}
   g:=r.state.LiftingDecks[d.ID];rows:=r.liftingDeckCargo(d,g);deckQty,receivingQty:=int64(0),int64(0)
   for _,row:=range rows{if row.Stage=="deck"{deckQty+=row.Quantity;manifest[row.Id]=append([]string(nil),row.ItemIds...)}else{receivingQty+=row.Quantity;if len(manifest[row.Id])==0||!reflect.DeepEqual(manifest[row.Id],row.ItemIds){t.Fatal("receiving handoff replaced manifested item IDs")}}}
   if deckQty>0{onDeck=true;if deckQty!=int64(len(d.Freight.Routes))*3{t.Fatal("incomplete incoming market consignment")}}
   if receivingQty>0{received=true;if g.FreightLandedNS<=0||g.Phase!="loading"{t.Fatal("cargo received before a real flush landing")}}
   for _,delivery:=range r.world.Inventory.Deliveries{if r.state.Inventory.Deliveries[delivery.ID].Phase=="carrying"&&(!received||g.UpdatedNS-g.FreightLandedNS<d.Freight.ReceivingDwellS*1000000000){t.Fatal("calendar let a trader collect cargo before physical receiving")}}
   if commerceTotal(r.state.Inventory)!=total{t.Fatal("deck transfer minted or lost stock")}
   if onDeck&&!saved&&g.Phase=="rising"{snapshot:=r.snapshotState();slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,snapshot);err!=nil{t.Fatal(err)};restored,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};replay=&Runtime{world:r.world,canonicalWorld:r.canonicalWorld,sdkWorlds:r.sdkWorlds,state:restored};saved=true}
   picked:=0;for _,delivery:=range r.world.Inventory.Deliveries{if r.state.Inventory.Deliveries[delivery.ID].Phase=="carrying"{picked++}}
   if picked==len(d.Freight.Routes){break}
  }
  if !onDeck||!received||!saved{t.Fatal("incomplete actual freight/save proof",onDeck,received,saved)}
  for _,route:=range d.Freight.Routes{
   if commerceQuantity(r.state.Inventory,route.CopperStore)!=9||commerceQuantity(r.state.Inventory,route.DeckStore)!=0||commerceQuantity(r.state.Inventory,route.ReceivingStore)!=0{t.Fatal("finite stock did not move Copper → deck → receiving → carrier")}
   progress:=r.state.Inventory.Deliveries[route.DeliveryID];if progress.Phase!="carrying"||len(progress.Cargo)==0{t.Fatal("existing market delivery did not collect landed stock")};ids:=[]string{};for _,cargo:=range progress.Cargo{ids=append(ids,cargo.Item)};if !reflect.DeepEqual(ids,manifest[route.DeliveryID]){t.Fatal("trader pickup replaced actual cargo IDs")}
  }
 })}
}

