func TestDialogueSaveAndLoadInTheMiddleOfTheConversation(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	for _, q := range e.Questions {
		if err := r.encounterCommand(&pb.PocLifeCommand{Action: "encounter_choice", Destination: q.ID}); err != nil {
			t.Fatal(err)
		}
	}
	view := dialogueView(t, r, "ru")
	for _, q := range e.Questions {
		if o := dialogueOption(t, view, q.ID); o == nil || !o.Seen {
			t.Fatalf("an asked question is not dimmed: %+v", o)
		}
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(r.state.CalendarEncounter, loaded.CalendarEncounter) || loaded.CheckSeed != r.state.CheckSeed {
		t.Fatal("the conversation or the game's check value changed in the save")
	}
	other := encounterFixture(t)
	other.state = loaded
	a, _ := json.Marshal(view)
	b, _ := json.Marshal(dialogueView(t, other, "ru"))
	if string(a) != string(b) {
		t.Fatalf("the loaded conversation shows differently:\n%s\n%s", a, b)
	}
	if err := other.encounterCommand(&pb.PocLifeCommand{Action: "encounter_choice", Destination: e.Choices[0].ID}); err != nil {
		t.Fatalf("the loaded conversation cannot go on: %v", err)
	}
	// a saved answer that no longer exists refuses the load, with the reason
	r.state.CalendarEncounter.Talk.Chosen = append(r.state.CalendarEncounter.Talk.Chosen, "answer.removed")
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave(slot); err == nil || !strings.Contains(err.Error(), "answer.removed") {
		t.Fatalf("a save with a removed answer loaded: %v", err)
	}
}

func TestDialogueCustodyViewIsReadOnlyAndComplete(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	before, _ := json.Marshal(r.snapshotState())
	for _, locale := range []string{"ru", "en"} {
		v := dialogueView(t, r, locale)
		if v.Leave || v.SpeakerColour == "" || len(v.Lines) < len(e.Prompt) || len(v.Choices) < len(e.Questions)+1 {
			t.Fatalf("%s: incomplete custody view: %+v", locale, v)
		}
		for i, l := range e.Prompt {
			if v.Lines[i].Kind != "line" || v.Lines[i].Speaker != l.Speaker || v.Lines[i].Name == "" || v.Lines[i].Colour == "" || v.Lines[i].Text != r.localText(locale, l.Text, "") {
				t.Fatalf("%s: prompt line %d shown as %+v", locale, i, v.Lines[i])
			}
		}
		for i, q := range e.Questions {
			if v.Choices[i].Id != q.ID || v.Choices[i].Action != "encounter_choice" {
				t.Fatalf("%s: questions come first: %+v", locale, v.Choices[i])
			}
		}
	}
	if after, _ := json.Marshal(r.snapshotState()); string(before) != string(after) {
		t.Fatal("the conversation view changed the world")
	}
}

