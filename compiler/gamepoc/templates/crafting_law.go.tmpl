		law.RaidDay = day + 1
		take := []inv.Relocate{}
		owner := r.world.Inventory.Stores[m.Law.Rebind.ConfiscateStore].Owner
		for _, id := range sortedCraftingItems(r.state.Inventory) {
			i, ok := r.craftingHeroCarried(id)
			if !ok {
				continue
			}
