		if cfg.unit(id) == nil || n < 0 || n > 9000000000000000 {
			return fmt.Errorf("invalid sanitary water meter")
		}
	}
	for id, n := range s.Sanitary.Completed {
		if cfg.unit(id) == nil || n > s.Sanitary.Serial || n > uint64(s.Sanitary.WaterML[id]/cfg.unit(id).WaterML) {
			return fmt.Errorf("invalid sanitary completion meter")
		}
