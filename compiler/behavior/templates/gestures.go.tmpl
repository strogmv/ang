// Code generated by ANG. Visual communication uses each recipient's own observation.
package behavior
import "fmt"
type GesturePolicy struct {
 Range int `json:"range_cells"`
 AttentionTicks int64 `json:"attention_ticks"`
 WaveTicks int64 `json:"wave_ticks"`
 CooldownTicks int64 `json:"cooldown_ticks"`
 AttentionMemoryTicks int64 `json:"attention_memory_ticks"`
}
type Gesture struct {Sequence,StartedTick int64; Meaning,Purpose string; At Cell}
type GestureAttention struct {Sender string; Sequence,UntilTick int64}
func(p Profile)HasSkill(skill string)bool{for _,s:=range p.Skills{if s==skill{return true}};return false}
func(p Profile)UnderstandsGesture(meaning string)bool{switch meaning{case "beckon":return true;case "cover":return p.HasSkill("tactical_signals")&&p.HasSkill("cover_partner");case "stack":return p.HasSkill("tactical_signals")&&p.HasSkill("room_entry");case "robot_advance":return p.HasSkill("tactical_signals")&&p.HasSkill("robot_coordination")};return false}
func(g *Gesture)Begin(profile Profile,meaning,purpose string,at Cell,tick int64,p GesturePolicy)bool{
 if !profile.UnderstandsGesture(meaning)||p.AttentionTicks<1||p.WaveTicks<1||g.Purpose==purpose{return false}
 if g.Sequence>0&&(tick<g.StartedTick+p.CooldownTicks||tick<g.StartedTick+p.AttentionTicks+p.WaveTicks){return false}
 g.Sequence++;g.StartedTick=tick;g.Meaning=meaning;g.Purpose=purpose;g.At=at;return true
}
func(g Gesture)Phase(tick int64,p GesturePolicy)(string,int64){
 if g.Sequence==0||tick<g.StartedTick{return "",0};if tick<g.StartedTick+p.AttentionTicks{return "raise_hand",g.StartedTick+p.AttentionTicks};if tick<g.StartedTick+p.AttentionTicks+p.WaveTicks{return "wave",g.StartedTick+p.AttentionTicks+p.WaveTicks};return "",0
}
// Seeing the attention phase is necessary. Hearing never acknowledges a gesture.
func(a *GestureAttention)Observe(sender string,g Gesture,profile Profile,tick int64,p GesturePolicy,canSee bool)bool{
 if !canSee{return false};phase,_:=g.Phase(tick,p)
 if phase=="raise_hand"{*a=GestureAttention{Sender:sender,Sequence:g.Sequence,UntilTick:tick+p.AttentionMemoryTicks};return false}
 return phase=="wave"&&a.Sender==sender&&a.Sequence==g.Sequence&&tick<a.UntilTick&&profile.UnderstandsGesture(g.Meaning)
}
func(g Gesture)Validate(tick int64,p GesturePolicy)error{
 if g.Sequence==0{if g!=(Gesture{}){return fmt.Errorf("invalid inactive gesture")};return nil}
 if g.Sequence<0||g.StartedTick<0||g.StartedTick>tick||g.Purpose==""||p.AttentionTicks<1||p.WaveTicks<1{return fmt.Errorf("invalid gesture clocks")}
 switch g.Meaning{case "beckon","cover","stack","robot_advance":return nil};return fmt.Errorf("unknown gesture")
}
