  void MedicalReviewHinges(MedicalReviewActor row,LocationSDKHumanoid h){var an=h.animator;if(an==null||!an.isHuman)return;var rest=CombatRestOf(an);row.knee_left=CombatHinge(an,HumanBodyBones.LeftUpperLeg,HumanBodyBones.LeftLowerLeg,HumanBodyBones.LeftFoot,-rest.capL);row.knee_right=CombatHinge(an,HumanBodyBones.RightUpperLeg,HumanBodyBones.RightLowerLeg,HumanBodyBones.RightFoot,-rest.capR);row.elbow_left=CombatHinge(an,HumanBodyBones.LeftUpperArm,HumanBodyBones.LeftLowerArm,HumanBodyBones.LeftHand,rest.armL);row.elbow_right=CombatHinge(an,HumanBodyBones.RightUpperArm,HumanBodyBones.RightLowerArm,HumanBodyBones.RightHand,rest.armR);foreach(double flex in new[]{row.knee_left,row.knee_right,row.elbow_left,row.elbow_right}){medicalReviewMaxFlex=Math.Max(medicalReviewMaxFlex,flex);medicalReviewMinFlex=Math.Min(medicalReviewMinFlex,flex);}}
