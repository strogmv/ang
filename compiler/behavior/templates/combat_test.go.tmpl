func TestCombatSaveContinuationDeterministicAndDeepClone(t *testing.T) {
	r := combatFixtureRules()
	space := combatFixtureSpace()
	a, b := combatFixtureActor("a", "blue", Cell{1, 1}), combatFixtureActor("b", "red", Cell{4, 1})
	a.Controlled = true
	b.Controlled = true
	s := combatFixture(t, space, a, b)
	combatDo(t, &s, space, r, "a", CombatAction{Type: "attack", TargetID: "b"})
	payload, _ := json.Marshal(s)
	var restored CombatState
	if err := json.Unmarshal(payload, &restored); err != nil {
		t.Fatal(err)
	}
	if err := restored.Validate(r, space); err != nil {
		t.Fatal(err)
	}
	clone := restored.Clone()
	clone.Actor("a").Contacts[0].Position = Cell{9, 5}
	if reflect.DeepEqual(clone.Actor("a").Contacts, restored.Actor("a").Contacts) {
		t.Fatal("clone aliased personal memory")
	}
	for _, pair := range []struct {
		id     string
		action CombatAction
	}{{"a", CombatAction{Type: "attack", TargetID: "b"}}, {"b", CombatAction{Type: "attack", TargetID: "a"}}, {"b", CombatAction{Type: "attack", TargetID: "a"}}, {"a", CombatAction{Type: "reload"}}} {
		if !s.Active {
			break
		}
		combatDo(t, &s, space, r, pair.id, pair.action)
		combatDo(t, &restored, space, r, pair.id, pair.action)
	}
	one, _ := json.Marshal(s)
	two, _ := json.Marshal(restored)
	if string(one) != string(two) {
		t.Fatal("save/load rerolled or diverged combat")
	}
}

