func TestCartParkingSaveRejectsInvalidPoseAndDuplicateIdentity(t *testing.T) {
	r, _, _ := cartTestRuntime(t)
	good := r.snapshotState()
	if err := r.validateCartParkingSave(good); err != nil {
		t.Fatal(err)
	}
	bad := good
	bad.Peddlers = good.Peddlers.clone()
	s := bad.Peddlers.Carts[r.world.CartParking.CartID]
	s.Pose.X = math.Inf(1)
	bad.Peddlers.Carts[r.world.CartParking.CartID] = s
	if r.validateCartParkingSave(bad) == nil {
		t.Fatal("nonfinite cart save accepted")
	}
	bad = good
	bad.Peddlers = good.Peddlers.clone()
	bad.Peddlers.Carts["duplicate"] = s
	if r.validateCartParkingSave(bad) == nil {
		t.Fatal("duplicate cart accepted")
	}
}

func TestCartParkingActualOwnerWalkSeatSaveAndReturn(t *testing.T) {
	r, _, b := cartTestRuntime(t)
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 30}); err != nil {
		t.Fatal(err)
	}
	for r.state.Life.Seconds < 8*3600 {
		r.step()
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
		t.Fatal(err)
	}
	cfg := r.world.CartParking
	a := r.state.Life.Actor(cfg.OwnerActorID)
	a.Trip = nil
	a.ResidenceID = ""
	a.Level = cfg.LevelID
	a.Position = behavior.Cell{X: b.PreHandle.X + 2, Y: b.PreHandle.Y}
	a.Path = nil
	a.PendingPath = nil
	a.Goal = a.Position
	a.Arrived = false
	a.Manual = false
	a.CombatHold = false
	a.ServiceAttachment = ""
	place, ok := r.world.Life.Brain.SeatedPlace(b.PlaceID)
	if !ok {
		t.Fatal("authored Yatai missing")
	}
	taken := r.npcSeatsTaken(a.Level, place.ID, a.ID)
	seat := behavior.LifeSpot{}
	for _, candidate := range place.Seating.Seats {
		if !taken[candidate.At] {
			seat = candidate
			break
		}
	}
	if seat.ID == "" {
		t.Fatal("fixture needs one actual free seat")
	}
	place.At = seat.At
	place.Seating = nil
	a.Brain.Place = place
	a.Brain.Seat = seat.ID
	a.Brain.SeatQueue = false
	a.Brain.SeatedAt = 0
	a.Brain.SitUntil = 0
	a.Brain.RiseAt = 0
	a.Brain.QueueSince = 0
	a.Brain.BreakKind = ""
	a.Brain.Returning = false
	a.Brain.Target = behavior.LifeStep{Level: cfg.LevelID, At: seat.At, Activity: "eat", Label: "life.npc.seated_food"}
	a.Brain.NextDecision = r.state.Life.Seconds + 60
	r.initCartParking()
	walked := a.WalkedMM
	startItems := map[string]string{}
	for id, item := range r.state.Inventory.Items {
		if item.Location.Store == cfg.StoreID {
			raw, _ := json.Marshal(item)
			startItems[id] = string(raw)
		}
	}
	parked, seated, saved, picked := false, false, false, false
	previous := a.Position
	for i := 0; i < 3500; i++ {
		r.step()
		a = r.state.Life.Actor(cfg.OwnerActorID)
		s := r.state.Peddlers.Carts[cfg.CartID]
		if a.Level == cfg.LevelID && behavior.Distance(previous, a.Position) > 1 {
			t.Fatalf("ordinary actor teleported %v -> %v", previous, a.Position)
		}
		previous = a.Position
		if s.Phase == "parked" {
			parked = true
			if s.Pose != b.Pose {
				t.Fatal("parked cart followed owner")
			}
			if a.Position != b.Handle && a.Position != b.PreHandle && !saved {
				before := r.snapshotState()
				r.state.Paused = true
				clock := r.simNS()
				r.step()
				if r.simNS() != clock || r.state.Peddlers.Carts[cfg.CartID] != before.Peddlers.Carts[cfg.CartID] {
					t.Fatal("pause moved independent cart")
				}
				if err := r.writeSave("slot3", r.snapshotState()); err != nil {
					t.Fatal(err)
				}
				restored, _, err := r.readSave("slot3")
				if err != nil {
					t.Fatal(err)
				}
				if !reflect.DeepEqual(restored.Peddlers.Carts, r.state.Peddlers.Carts) {
					t.Fatal("save changed independent cart")
				}
				r.state = restored
				r.state.Paused = false
				saved = true
			}
		}
		if a.Brain.SeatedAt > 0 {
			seated = true
			if s.Phase != "parked" {
				t.Fatal("owner sat with attached cart")
			}
		}
		if s.PickupCount == 1 && s.Phase == "attached" {
			picked = true
			break
		}
	}
	if !parked || !seated || !saved || !picked || a.WalkedMM <= walked {
		t.Fatalf("physical cycle incomplete: park=%v seated=%v save=%v pickup=%v phase=%+v owner=%+v", parked, seated, saved, picked, r.state.Peddlers.Carts[cfg.CartID], a)
	}
	for id, raw := range startItems {
		item, ok := r.state.Inventory.Items[id]
		now, _ := json.Marshal(item)
		if !ok || string(now) != raw {
			t.Fatal("parking lost/duplicated/traded cart goods away from service")
		}
	}
}

func TestCartParkingActualSanitaryServiceKeepsIndependentCart(t *testing.T) {
	r, _, _ := cartTestRuntime(t)
	cfg := r.world.CartParking
	b := cfg.Bays[1]
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 30}); err != nil {
		t.Fatal(err)
	}
	for r.state.Life.Seconds < 8*3600 {
		r.step()
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
		t.Fatal(err)
	}
	a := r.state.Life.Actor(cfg.OwnerActorID)
	a.Level = cfg.LevelID
	a.Trip = nil
	a.ResidenceID = ""
	a.ServiceAttachment = ""
	a.Manual = false
	a.CombatHold = false
	a.Position = behavior.Cell{X: 15, Y: 54}
	a.Path = nil
	a.PendingPath = nil
	a.Goal = a.Position
	a.Arrived = false
	a.Brain.InterruptService()
	a.Brain.BreakKind = ""
	a.Brain.Returning = false
	a.Brain.Needs[2] = 800000
	a.RoutineOverride = &behavior.LifeStep{Level: a.Level, At: a.Position, Activity: "rest", Label: "fixture off-duty rest"}
	for _, place := range r.world.Life.Brain.Places {
		if place.ID == b.PlaceID {
			a.Brain.Place = place
			a.Brain.Target = behavior.LifeStep{Level: place.Level, At: place.At, Activity: "hygiene", Label: "life.npc.hygiene"}
		}
	}
	a.Brain.NextDecision = r.state.Life.Seconds + 120
	r.initCartParking()
	seenParking, seenInside, seenPickup := false, false, false
	startNeed := a.Brain.Needs[2]
	water := int64(0)
	for _, n := range r.state.Sanitary.WaterML {
		water += n
	}
	lastPhase := ""
	for i := 0; i < 2500; i++ {
		r.step()
		a = r.state.Life.Actor(cfg.OwnerActorID)
		s := r.state.Peddlers.Carts[cfg.CartID]
		if s.Phase != lastPhase {
			if lastPhase == "parked" && s.Phase == "approach" {
				t.Fatalf("cart reset without pickup: %+v", s)
			}
			t.Logf("cart=%s at=%v place=%s manual=%v service=%+v", s.Phase, a.Position, a.Brain.Place.ID, a.Manual, r.state.Sanitary.Users[a.ID])
			lastPhase = s.Phase
		}
		if s.Phase == "parked" {
			if !seenParking {
				probe := &Runtime{world: r.world, state: r.snapshotState()}
				t.Logf("parked admission: now=%d break=%s return=%d probe=%v", r.state.Life.Seconds, a.Brain.BreakKind, a.Brain.BreakReturnAt, probe.sanitaryRequest(a.ID, r.world.SanitaryServices.Units[4].ID))
			}
			seenParking = true
		}
		if a.ServiceAttachment != "" {
			seenInside = true
			if s.Phase != "parked" || s.Pose != b.Pose {
				t.Fatal("cart entered sanitary cabin with owner")
			}
		}
		if s.PickupCount > 0 && s.Phase == "attached" {
			seenPickup = true
			break
		}
	}
	afterWater := int64(0)
	for _, n := range r.state.Sanitary.WaterML {
		afterWater += n
	}
	if !seenParking || !seenInside || !seenPickup || a.Brain.Needs[2] >= startNeed || afterWater <= water {
		t.Fatalf("real sanitary cycle incomplete park=%v inside=%v pickup=%v need=%d/%d water=%d/%d cart=%+v", seenParking, seenInside, seenPickup, a.Brain.Needs[2], startNeed, afterWater, water, r.state.Peddlers.Carts[cfg.CartID])
	}
}

func TestCartParkingDoesNotExtendDutyBreakForPickup(t *testing.T) {
	r, a, b := cartTestRuntime(t)
	a.Level = r.world.CartParking.LevelID
	a.Position = b.PreHandle
	a.Path = nil
	a.Trip = nil
	a.ResidenceID = ""
	a.Brain.Place = behavior.LifeAffordance{ID: b.PlaceID, Kind: "seated_food"}
	wanted := behavior.LifeStep{Level: a.Level, At: behavior.Cell{X: 81, Y: 63}, Activity: "eat"}
	a.Brain.BreakKind = "lunch"
	a.Brain.BreakStarted = r.state.Life.Seconds
	a.Brain.BreakUntil = r.state.Life.Seconds + 1800
	a.Brain.BreakReturnAt = r.state.Life.Seconds + 1200
	a.Brain.BreakPost = behavior.LifeStep{Level: a.Level, At: behavior.Cell{X: 88, Y: 66}, Activity: "work"}
	until := a.Brain.BreakUntil
	before := a.Brain.BreakReturnAt
	r.cartRouteDetour(a, wanted)
	reserved := a.Brain.BreakReturnAt
	if reserved >= before || a.Brain.BreakUntil != until {
		t.Fatal("pickup must reserve time inside original break")
	}
	r.cartRouteDetour(a, wanted)
	if a.Brain.BreakReturnAt != reserved {
		t.Fatal("repeated poll reserved pickup twice")
	}
	r.initCartParking()
	a.Brain.Place = behavior.LifeAffordance{ID: b.PlaceID, Kind: "seated_food"}
	a.Brain.BreakReturnAt = r.state.Life.Seconds + 1
	need := a.Brain.Needs
	r.cartRouteDetour(a, wanted)
	if r.state.Peddlers.Carts[r.world.CartParking.CartID].Phase != "attached" || !a.Brain.Returning || a.Brain.Needs != need || a.Brain.BreakUntil != until {
		t.Fatal("impossible service must return without free relief or extended work break")
	}
}

// No seeded owner position, need, goal, wallet, injury or manual override. The
// ordinary world chooses a real meal; the hero walks to the public observation cell.
func TestCartParkingNativeFixture(t *testing.T) {
	dir := os.Getenv("ANG_CART_NATIVE_DIR")
	if dir == "" {
		t.Skip("explicit canonical cart-review save export")
	}
	r, _, b := cartTestRuntime(t)
	c := &connection{out: make(chan *pb.ServerMessage, 64), stop: make(chan struct{})}
	r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1001, X: 85, Y: 68})
	result := (<-c.out).GetMoveResult()
	if result == nil || !result.Ok {
		t.Fatalf("ordinary observation walk rejected: %+v", result)
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 1000; i++ {
		h := r.state.Life.Actor(playerActorID)
		if h.Arrived && h.Position == (behavior.Cell{X: 85, Y: 68}) {
			break
		}
		r.step()
	}
	h := r.state.Life.Actor(playerActorID)
	if h.Position != (behavior.Cell{X: 85, Y: 68}) || !h.Arrived {
		t.Fatalf("hero did not walk to public observation: %+v", h.Position)
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 30}); err != nil {
		t.Fatal(err)
	}
	found := false
	for i := 0; i < 12000; i++ {
		r.step()
		s := r.state.Peddlers.Carts[r.world.CartParking.CartID]
		if s.Phase == "approach" && s.BayID == b.ID {
			found = true
			break
		}
		if r.state.Life.PopulationFailure != "" {
			t.Fatal(r.state.Life.PopulationFailure)
		}
	}
	if !found {
		t.Fatalf("ordinary Akim never selected Yatai with cart: %+v", r.state.Life.Actor(r.world.CartParking.OwnerActorID))
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
		t.Fatal(err)
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_GameOptions{GameOptions: &pb.PocOptionsRequest{Epoch: r.state.Epoch, RequestId: "cart.native.pause", Paused: true, Speed: 1}}}})
	if !r.state.Paused {
		t.Fatal("ordinary pause failed")
	}
	if err := r.writeSave("slot3", r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave("slot3"); err != nil {
		t.Fatal(err)
	}
	if err := os.MkdirAll(dir, 0755); err != nil {
		t.Fatal(err)
	}
	raw, err := os.ReadFile(filepath.Join(r.data, "slot3.json"))
	if err != nil {
		t.Fatal(err)
	}
	if err = os.WriteFile(filepath.Join(dir, "slot3.json"), raw, 0600); err != nil {
		t.Fatal(err)
	}
	a := r.state.Life.Actor(r.world.CartParking.OwnerActorID)
	report := map[string]any{"creation": "canonical NewGame Life, ordinary hero MoveTo, ordinary rate and Runtime.step; no owner manipulation", "actor_id": a.ID, "cart_id": r.world.CartParking.CartID, "store_id": r.world.CartParking.StoreID, "hero_cell": h.Position, "owner_cell": a.Position, "life_seconds": r.state.Life.Seconds, "tick": r.state.Tick, "sim_ns": r.simNS(), "cart": r.state.Peddlers.Carts[r.world.CartParking.CartID]}
	raw, _ = json.MarshalIndent(report, "", "  ")
	if err = os.WriteFile(filepath.Join(dir, "provenance.json"), append(raw, '\n'), 0644); err != nil {
		t.Fatal(err)
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_GameOptions{GameOptions: &pb.PocOptionsRequest{Epoch: r.state.Epoch, RequestId: "cart.native.resume", Paused: false, Speed: 1}}}})
	began := r.simNS()
	events := map[string]float64{}
	initialPickups := r.state.Peddlers.Carts[r.world.CartParking.CartID].PickupCount
	hiddenAt := behavior.Cell{}
	hiddenConfirmed := false
	move := func(at behavior.Cell, seq uint64) {
		for len(c.out) > 0 {
			<-c.out
		}
		r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: seq, X: int32(at.X), Y: int32(at.Y)})
		v := (<-c.out).GetMoveResult()
		if v == nil || !v.Ok {
			t.Fatalf("ordinary review walk failed %+v: %+v", at, v)
		}
	}
	for i := 0; i < 4000; i++ {
		r.step()
		owner := r.state.Life.Actor(r.world.CartParking.OwnerActorID)
		cart := r.state.Peddlers.Carts[r.world.CartParking.CartID]
		elapsed := float64(r.simNS()-began) / 1e9
		if _, ok := events[cart.Phase]; !ok {
			events[cart.Phase] = elapsed
		}
		if owner.Brain.SeatedAt > 0 {
			if _, ok := events["seated"]; !ok {
				events["seated"] = elapsed
				v := r.lifeViewRuntime()
				best := 100000
				blocked := r.state.Life.BlockedCells(r.world.CartParking.LevelID, playerActorID)
				for y := 40; y < 71; y++ {
					for x := 8; x < 104; x++ {
						at := behavior.Cell{X: x, Y: y}
						if !r.world.Life.Walks(r.world.CartParking.LevelID, at) || blocked[at] {
							continue
						}
						from := point{x, y}
						cartCell := point{int(math.Floor(b.Pose.X / .5)), int(math.Floor(b.Pose.Z / .5))}
						if v.sightWithin(from, cartCell, 24) && !v.sightWithin(from, location(owner.Position), 24) {
							distance := behavior.Distance(at, r.state.Life.Actor(playerActorID).Position)
							if distance < best && r.state.Life.StaticTravelSeconds(r.world.Life, r.world.CartParking.LevelID, r.state.Life.Actor(playerActorID).Position, at) >= 0 {
								best = distance
								hiddenAt = at
							}
						}
					}
				}
				if best == 100000 {
					t.Fatal("no ordinary observer waypoint hides seated owner while seeing parked cart")
				}
				move(hiddenAt, 1002)
			}
		}
		hero := r.state.Life.Actor(playerActorID)
		if hiddenAt != (behavior.Cell{}) && !hiddenConfirmed && hero.Arrived && hero.Position == hiddenAt {
			v := r.lifeViewRuntime()
			perception := v.observerView(playerActorID, location(hero.Position), false)
			var published struct {
				Carts []struct {
					OwnerVisible bool `json:"owner_visible"`
					HandContact  bool `json:"hand_contact"`
				} `json:"carts"`
			}
			if err := json.Unmarshal([]byte(r.cartParkingJSON(hero, perception)), &published); err != nil || len(published.Carts) != 1 || published.Carts[0].OwnerVisible || published.Carts[0].HandContact {
				t.Fatal("ordinary observer movement did not preserve independent cart visibility")
			}
			hiddenConfirmed = true
			events["hidden_owner_cart_visible"] = elapsed
			move(behavior.Cell{X: 85, Y: 68}, 1003)
		}
		if cart.PickupCount > initialPickups && cart.Phase == "attached" {
			events["collected"] = elapsed
			break
		}
	}
	if events["parked"] == 0 || events["seated"] == 0 || events["collected"] == 0 || !hiddenConfirmed {
		t.Fatalf("canonical seed does not demonstrate a completed ordinary meal, hidden-owner visibility and retrieval: %+v", events)
	}
	report["hidden_owner_waypoint"] = hiddenAt
	raw, _ = json.MarshalIndent(report, "", "  ")
	if err = os.WriteFile(filepath.Join(dir, "provenance.json"), append(raw, '\n'), 0644); err != nil {
		t.Fatal(err)
	}
	raw, _ = json.MarshalIndent(events, "", "  ")
	if err = os.WriteFile(filepath.Join(dir, "ordinary-continuation.json"), append(raw, '\n'), 0644); err != nil {
		t.Fatal(err)
	}
}

func TestCartParkingBlockedRetrievalSavesAndWaitsForOrdinaryExit(t *testing.T) {
	r, a, b := cartTestRuntime(t)
	cfg := r.world.CartParking
	a.Level = cfg.LevelID
	a.Trip = nil
	a.ResidenceID = ""
	a.Position = behavior.Cell{X: 84, Y: 66}
	a.Path = nil
	a.PendingPath = nil
	a.Goal = a.Position
	a.Manual = false
	a.Arrived = false
	a.Brain.InterruptService()
	a.RoutineOverride = &behavior.LifeStep{Level: a.Level, At: behavior.Cell{X: 90, Y: 66}, Activity: "rest", Label: "fixture return post"}
	s := r.state.Peddlers.Carts[cfg.CartID]
	s.Phase = "parked"
	s.BayID = b.ID
	s.PlaceID = b.PlaceID
	s.LevelID = cfg.LevelID
	s.Pose = b.Pose
	s.ParkCount = 1
	r.state.Peddlers.Carts[cfg.CartID] = s
	hero := r.state.Life.Actor(playerActorID)
	hero.Level = cfg.LevelID
	hero.Position = b.PreHandle
	hero.Goal = hero.Position
	hero.Body = nil
	hero.Path = nil
	hero.PendingPath = nil
	hero.Manual = true
	hero.Arrived = true
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 160; i++ {
		r.step()
		s = r.state.Peddlers.Carts[cfg.CartID]
		if s.Phase != "returning" || s.Pose != b.Pose || s.PickupCount != 0 {
			t.Fatal("blocked handle teleported cart/owner or detached without retrieval")
		}
	}
	if err := r.writeSave("slot3", r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	saved, _, err := r.readSave("slot3")
	if err != nil {
		t.Fatal(err)
	}
	r.state = saved
	c := &connection{out: make(chan *pb.ServerMessage, 64), stop: make(chan struct{})}
	r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 2001, X: 85, Y: 68})
	if m := (<-c.out).GetMoveResult(); m == nil || !m.Ok {
		t.Fatalf("ordinary blocker exit failed %+v", m)
	}
	for i := 0; i < 500; i++ {
		r.step()
		s = r.state.Peddlers.Carts[cfg.CartID]
		if s.Phase == "attached" && s.PickupCount == 1 {
			return
		}
	}
	t.Fatal("cart was not collected after the ordinary observer exit freed its approach")
}

func TestCartParkingArcSweepRadiusReservationAndSave(t *testing.T) {
	r, a, b := cartTestRuntime(t)
	cfg := r.world.CartParking
	a.Level = cfg.LevelID
	a.Trip = nil
	a.ResidenceID = ""
	a.Position = b.Handle
	a.Goal = a.Position
	a.Path = nil
	a.PendingPath = nil
	a.Arrived = false
	s := r.state.Peddlers.Carts[cfg.CartID]
	s.Phase = "pickup"
	s.BayID = b.ID
	s.PlaceID = b.PlaceID
	s.LevelID = cfg.LevelID
	s.Pose = b.Pose
	s.ParkCount = 1
	wanted := behavior.LifeStep{Level: a.Level, At: behavior.Cell{X: 90, Y: 66}, Activity: "rest", Label: "return"}
	if !r.cartBeginTurn(a, b, wanted, &s) || !r.cartArcClear(a, b, s.Motion) || len(a.RouteFootprint) == 0 {
		t.Fatal("authored bay has no safe ordinary first step")
	}
	previous := s.Motion.From
	for i := 0; i <= 100; i++ {
		p := cartArcPose(s.Motion, s.Motion.StartNS+(s.Motion.EndNS-s.Motion.StartNS)*int64(i)/100)
		if math.Abs(math.Hypot(p.X-s.Motion.PivotX, p.Z-s.Motion.PivotZ)-cfg.CouplingForwardM) > 1e-9 || math.Hypot(p.X-previous.X, p.Z-previous.Z) > .05 {
			t.Fatal("pickup arc crossed the owner or teleported")
		}
		previous = p
	}
	hero := r.state.Life.Actor(playerActorID)
	old := *hero
	found := false
	for _, at := range a.RouteFootprint {
		if at != a.Position && r.world.Life.Walks(a.Level, at) {
			hero.Position = at
			hero.Goal = at
			hero.Body = nil
			hero.Path = nil
			hero.PendingPath = nil
			found = true
			break
		}
	}
	if !found || r.cartArcClear(a, b, s.Motion) {
		t.Fatal("full cart/handle sweep ignored an occupied cell")
	}
	*hero = old
	r.state.Peddlers.Carts[cfg.CartID] = s
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 5; i++ {
		r.step()
	}
	s = r.state.Peddlers.Carts[cfg.CartID]
	if s.Phase != "turning" {
		t.Fatal("turn ended before authored duration")
	}
	r.state.Paused = true
	before := r.cartParkingJSON(r.state.Life.Actor(playerActorID), nil)
	r.step()
	if before != r.cartParkingJSON(r.state.Life.Actor(playerActorID), nil) {
		t.Fatal("paused arc advanced")
	}
	if err := r.writeSave("slot3", r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	saved, _, err := r.readSave("slot3")
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(saved.Peddlers.Carts, r.state.Peddlers.Carts) || !reflect.DeepEqual(saved.Life.Actor(a.ID).RouteFootprint, a.RouteFootprint) {
		t.Fatal("arc/reservation changed after disk load")
	}
	bad := saved
	bad.Peddlers = saved.Peddlers.clone()
	v := bad.Peddlers.Carts[cfg.CartID]
	v.Motion.PivotX = math.NaN()
	bad.Peddlers.Carts[cfg.CartID] = v
	if r.validateCartParkingSave(bad) == nil {
		t.Fatal("forged arc pivot accepted")
	}
	bad = saved
	bad.Life = saved.Life.Clone()
	bad.Life.Actor(a.ID).RouteFootprint = nil
	if r.validateCartParkingSave(bad) == nil {
		t.Fatal("missing saved arc occupancy accepted")
	}
}

// A saved nonzero motion keeps its deadline; only a newly aligned endpoint is immediate.
func TestCartParkingNonzeroMotionKeepsClockAcrossPauseAndSave(t *testing.T) {
	r, a, b := cartTestRuntime(t)
	cfg := r.world.CartParking
	a.Level = cfg.LevelID
	a.Trip = nil
	a.ResidenceID = ""
	a.Manual = false
	a.Position = b.Handle
	a.Goal = b.Handle
	a.Path = nil
	a.PendingPath = nil
	a.Brain.Place = behavior.LifeAffordance{ID: b.PlaceID, Kind: "seated_food"}
	wanted := behavior.LifeStep{Level: a.Level, At: behavior.Cell{X: 81, Y: 63}, Activity: "eat", Label: "life.npc.seated_food"}
	a.Brain.Target = wanted
	s := r.state.Peddlers.Carts[cfg.CartID]
	s.Phase = "approach"
	s.BayID = b.ID
	s.PlaceID = b.PlaceID
	s.LevelID = cfg.LevelID
	s.LastCell = b.Handle
	s.HandleLeg = true
	s.Pose.YawDegrees = 90
	s.StartedNS = r.simNS()
	s.DeadlineNS = s.StartedNS + cfg.ApproachTimeoutSeconds*1e9
	r.state.Peddlers.Carts[cfg.CartID] = s
	if r.cartAttachedPose(a, 90) == b.Pose {
		t.Fatal("fixture is already aligned")
	}
	r.cartRouteDetour(a, wanted)
	s = r.state.Peddlers.Carts[cfg.CartID]
	if s.Phase != "parking" || s.Motion.EndNS-s.Motion.StartNS != int64(cfg.ReleaseSeconds*1e9) {
		t.Fatal("nonzero attached endpoint lost authored timing")
	}
	// Exercise an existing in-flight nonzero save independently of a new approach.
	s.Motion.From.X += .1
	r.state.Peddlers.Carts[cfg.CartID] = s
	r.state.Paused = true
	for i := 0; i < 8; i++ {
		r.step()
		r.cartRouteDetour(a, wanted)
	}
	if !reflect.DeepEqual(s, r.state.Peddlers.Carts[cfg.CartID]) {
		t.Fatal("pause/polls advanced nonzero parking")
	}
	if err := r.writeSave("slot3", r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave("slot3")
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(s, loaded.Peddlers.Carts[cfg.CartID]) {
		t.Fatal("saved nonzero motion or deadline changed")
	}
	r.state = loaded
	r.state.Paused = false
	a = r.state.Life.Actor(cfg.OwnerActorID)
	cartAdvanceNS(r, 2)
	r.cartRouteDetour(a, wanted)
	if got := r.state.Peddlers.Carts[cfg.CartID]; got.Phase != "parked" || got.ParkCount != 1 {
		t.Fatal("nonzero motion did not complete once after its real deadline")
	}
}
