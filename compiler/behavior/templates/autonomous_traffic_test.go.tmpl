   autonomousMixedFlowAdvance(t,m,&s,tick)
   if saved!=nil{autonomousMixedFlowAdvance(t,m,saved,tick);if !reflect.DeepEqual(s.Clone(),saved.Clone()){t.Fatalf("opposing autonomous flow/save diverged at tick%d",tick)}}
   if !reflect.DeepEqual(*s.Actor("hero"),*initial.Actor("hero"))||!reflect.DeepEqual(s.Observer,initial.Observer)||s.ControlledActorID!="hero"{t.Fatal("autonomous passage commandeered the idle observer or changed observer knowledge")}
   for _,a:=range s.Actors{if a.ID=="hero"{continue};if a.Manual||a.OverrideLevel!=""||a.Step!=1||a.Goal!=goals[a.ID]{t.Fatal("negotiation replaced an autonomous named task")};if a.YieldUntil>tick{yielded[a.ID]=true};if a.Arrived&&a.Position==goals[a.ID]&&a.Activity=="work"{finished[a.ID]=true}}
   for i,a:=range s.Population.Actors{if !reflect.DeepEqual(a.Profile,initial.Population.Actors[i].Profile){t.Fatal("passing changed a resident's durable address")};if a.YieldUntil>tick{yielded[a.ID]=true};if a.Arrived&&a.Position==goals[a.ID]&&a.Activity=="work"{finished[a.ID]=true}}
   // Reading a familiar route is not a request to move anyone. Distant traffic
   // cannot change its acceptance/shape or insert facts into the chip's memory.
   hero:=s.Actor("hero");hidden:=true;for _,a:=range s.Actors{if a.ID!=hero.ID&&s.courtesyAware(m,hero.ID,a.Level,a.Position){hidden=false}};for _,a:=range s.Population.Actors{if s.courtesyAware(m,hero.ID,a.Level,a.Position){hidden=false}}
   if hidden{target:=Cell{15,3};if mirror{target=Cell{1,3}};before:=s.Clone();route,ok:=s.MoveRoute(m,hero.ID,hero.Level,hero.Position,target,tick);want:=m.Space(hero.Level,nil).Path(hero.Position,target,Cell{},0);if !ok||!reflect.DeepEqual(route,want)||!reflect.DeepEqual(before,s.Clone()){t.Fatal("hidden autonomous negotiation leaked through a read-only player route")};knowledgeReads++}
   if saved==nil&&len(yielded)>0{raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};saved=&LifeState{};if err=json.Unmarshal(raw,saved);err!=nil{t.Fatal(err)}}
   if len(finished)==len(goals){break}
  }
  if len(finished)!=len(goals)||len(yielded)==0||saved==nil||knowledgeReads==0{t.Logf("named=%+v population=%+v",s.Actors,s.Population.Actors);t.Fatalf("two-way autonomous flow stalled: completed=%v yielding=%v saved=%v knowledgeReads=%d",finished,yielded,saved!=nil,knowledgeReads)}
 })}}
}

// The isolated population kernel cannot negotiate with the host's named and
// controlled actors. This control reproduces the missing host coordination:
// both real commuters freeze before contact despite a free passing pocket.
// It proves the positive pure-population case does not pass because the fixture
// happens to avoid opposing traffic or because named workers clear the lane.
func TestLifeAutonomousFlowNeedsHostContactCoordination(t *testing.T){
 for _,mirror:=range []bool{false,true}{
  m,s,goals:=autonomousMixedFlowFixture(t,mirror,false);initial:=s.Clone()
  for tick:=int64(1);tick<=300;tick++{
   s.Advance(m,tick)
   if err:=s.Population.Advance(m.Population,m,s.Seconds,tick,"hall",s.PopulationEnvironment());err!=nil{t.Fatal(err)}
   if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}
  }
  a,b:=s.Population.Actors[0],s.Population.Actors[1]
  if a.Position!=initial.Population.Actors[0].Position||b.Position!=initial.Population.Actors[1].Position||a.Position==goals[a.ID]||b.Position==goals[b.ID]||len(a.Path)>0||len(b.Path)>0||s.occupied("hall",Cell{8,2},"")||len(m.Space("hall",nil).Path(a.Position,a.Goal,Cell{},0))==0||len(m.Space("hall",nil).Path(b.Position,b.Goal,Cell{},0))==0{t.Fatalf("control did not reproduce distant-occupancy freeze before a free passing pocket: %+v %+v",a,b)}
 }
}

// A player following the normal schedule is not Manual, but remains controlled.
// Population contact must not replace that player's pending route with a side
// step. The real pending intent is produced by walking toward a busy workplace;
// no route or yield state is injected by the fixture.
func TestLifeAutonomousContactPreservesScheduledControlledActor(t *testing.T){
