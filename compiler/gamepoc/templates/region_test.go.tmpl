// Code generated by ANG. Player knowledge, map travel and durable memory.
package poc

import (
 "bytes"
 "reflect"
 "testing"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
 "google.golang.org/protobuf/proto"
)

func TestRegionProjectionHidesUnknownPlacesLinksAndDecks(t *testing.T){
 r:=lifeRuntimeFixture(t);view:=&pb.PocLifeView{};r.appendRegionMap(view)
 if view.RegionMap==nil||len(view.RegionMap.Nodes)==0||len(view.RegionMap.Nodes)>=len(r.world.Region.Nodes){t.Fatal("region map missing or private catalog exposed")}
 wire,err:=proto.Marshal(view.RegionMap);if err!=nil{t.Fatal(err)}
 for _,n:=range r.world.Region.Nodes{if !r.state.Region.KnownNodes[n.ID]&&(bytes.Contains(wire,[]byte(n.ID))||bytes.Contains(wire,[]byte(n.Name))){t.Fatalf("unknown region node leaked: %s",n.ID)}}
 for _,e:=range r.world.Region.Links{if !r.state.Region.KnownLinks[e.ID]&&bytes.Contains(wire,[]byte(e.ID)){t.Fatalf("unknown region link leaked: %s",e.ID)}}
 for _,d:=range view.RegionMap.Decks{found:=false;for _,n:=range view.RegionMap.Nodes{if n.DeckId==d.Id{found=true}};if !found{t.Fatal("hidden-only deck leaked")}}
 current:=false;for _,n:=range view.RegionMap.Nodes{if n.Current{current=true;if n.Id!=view.RegionMap.CurrentNode||n.LevelId!=r.currentLevel()||n.CanTravel{t.Fatal("wrong current map node")}};if n.LevelId==""&&n.CanTravel{t.Fatal("reference landmark offered fake playable travel")}}
 if !current{t.Fatal("hero missing from floor map")}
}
func TestRegionLocalePreferenceChangesTextWithoutChangingSimulation(t *testing.T){
 r:=lifeRuntimeFixture(t);r.world.Config.DebugPerception=false
 ru,en:=&pb.PocLifeView{},&pb.PocLifeView{};r.appendRegionMap(ru,"ru");r.appendRegionMap(en,"en")
 if ru.RegionMap.Name==en.RegionMap.Name||en.RegionMap.Name==""{t.Fatal("region title was not translated")}
 raw,err:=proto.Marshal(en.RegionMap);if err!=nil{t.Fatal(err)}
 for _,node:=range r.world.Region.Nodes{if !r.state.Region.KnownNodes[node.ID]{name:=r.localText("en","region.node."+node.ID+".name",node.Name);if bytes.Contains(raw,[]byte(node.ID))||bytes.Contains(raw,[]byte(name)){t.Fatalf("unknown English place leaked: %s",node.ID)}}}
 before:=r.snapshotState();c:=&connection{out:make(chan *pb.ServerMessage,8),stop:make(chan struct{}),locale:"ru"}
 r.command(input{client:c,msg:&pb.ClientMessage{Msg:&pb.ClientMessage_Locale{Locale:&pb.PocLocaleRequest{Locale:"en"}}}})
 msg:=(<-c.out).GetGameState();if c.locale!="en"||msg==nil||msg.Life.RegionMap.Name!=en.RegionMap.Name{t.Fatal("locale preference did not refresh server projection")}
 after:=r.snapshotState();if !reflect.DeepEqual(before,after){t.Fatal("presentation locale changed simulation or knowledge")}
 localized:=r.localError("en",textError{Key:"error.route_unknown"});if localized=="error.route_unknown"||localized==r.localError("ru",textError{Key:"error.route_unknown"}){t.Fatal("keyed map error was not localized")}
}
func TestRegionTravelUsesRealDoorsAndPreservesKnowledgeInSave(t *testing.T){
 r:=lifeRuntimeFixture(t);r.state.Life.SecondsPerTick=30
 if !r.regionCanGoto("level.poc_housing"){t.Fatal("known house route unavailable")}
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"goto",Destination:"level.poc_housing"});err!=nil{t.Fatal(err)}
 if r.currentLevel()=="level.poc_housing"{t.Fatal("map travel teleported the player")}
 for i:=0;i<450&&r.currentLevel()!="level.poc_housing";i++{r.step()}
 if r.currentLevel()!="level.poc_housing"{t.Fatal("map travel did not complete ordinary walking/doors")}
 view:=&pb.PocLifeView{};r.appendRegionMap(view);node:=r.regionNodeForLevel("level.poc_housing")
 if node==nil||view.RegionMap.CurrentNode!=node.ID||!r.state.Region.KnownNodes[node.ID]{t.Fatal("arrival did not update map knowledge")}
 before:=r.snapshotState();slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,before);err!=nil{t.Fatal(err)};loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)}
 if !reflect.DeepEqual(before.Region,loaded.Region){t.Fatal("floor memory lost during disk save/load")}
 copy:=r.snapshotState();delete(copy.Region.KnownNodes,node.ID);if !r.state.Region.KnownNodes[node.ID]{t.Fatal("snapshot aliases floor memory")}
}
func TestRegionUnknownDestinationAndTamperedMemoryRejected(t *testing.T){
 r:=lifeRuntimeFixture(t);node:=r.regionNodeForLevel("level.poc_work");if node==nil{t.Fatal("missing configured work")}
 delete(r.state.Region.KnownNodes,node.ID);delete(r.state.Region.Visited,node.ID)
 for _,edge:=range r.world.Region.Links{if edge.FromNode==node.ID||edge.ToNode==node.ID{delete(r.state.Region.KnownLinks,edge.ID)}}
 if err:=r.validateRegionKnowledge(r.state);err!=nil{t.Fatal(err)}
 before:=r.state.Life.Clone();if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"goto",Destination:node.LevelID});err==nil||!reflect.DeepEqual(before,r.state.Life){t.Fatal("unknown map destination changed the hero task")}
 view:=&pb.PocLifeView{};r.appendRegionMap(view);for _,n:=range view.RegionMap.Nodes{if n.Id==node.ID{t.Fatal("forgotten place was advertised")}}
 bad:=r.snapshotState();bad.Region.KnownNodes["unknown.secret.id"]=true;if r.validateLifeSave(bad)==nil{t.Fatal("unknown saved region ID accepted")}
 bad=r.snapshotState();bad.Region.KnownLinks["unknown.secret.link"]=true;if r.validateLifeSave(bad)==nil{t.Fatal("unknown saved region link accepted")}
}

func TestRegionLearnsOnlyActuallyCompletedPhysicalConnectionAndSavesIt(t *testing.T){
 r:=lifeRuntimeFixture(t);hero:=r.state.Life.Actor(playerActorID);origin:=hero.Level
 var edgeID,reverseID,target string
 for _,edge:=range r.world.Life.Edges{if edge.From==origin{edgeID,target=edge.ID,edge.To;break}}
 if edgeID==""{t.Fatal("fixture needs an actual exit")}
 for _,edge:=range r.world.Life.Edges{if edge.From==target&&edge.To==origin{reverseID=edge.ID;break}}
 if reverseID==""{t.Fatal("fixture needs an actual reverse transition")}
 r.world.Region=regionCatalog{ID:"test.discovery",Name:"Discovery",Decks:[]regionDeck{{ID:"deck",Name:"Deck"}},Nodes:[]regionNode{
  {ID:"here",Name:"Here",DeckID:"deck",Width:20,Height:20,LevelID:origin,InitialKnowledge:"visited"},
  {ID:"next",Name:"Next",DeckID:"deck",X:30,Width:20,Height:20,LevelID:target,InitialKnowledge:"unknown"},
  {ID:"hidden.neighbour",Name:"PRIVATE_NEIGHBOUR",DeckID:"deck",X:60,Width:20,Height:20,InitialKnowledge:"unknown"},
 },Links:[]regionLink{
  {ID:"actually.crossed",FromNode:"here",ToNode:"next",Mode:"stairs",LifeEdges:[]string{edgeID,reverseID}},
  {ID:"unused.parallel",FromNode:"here",ToNode:"next",Mode:"lift"},
  {ID:"hidden.adjacent",FromNode:"next",ToNode:"hidden.neighbour",Mode:"corridor"},
 }}
 r.state.Region=regionKnowledge{};r.syncRegionKnowledge()
 if r.regionCanGoto(target){t.Fatal("unvisited unknown passage advertised as travel")}
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"enter",Destination:edgeID});err!=nil{t.Fatal(err)}
 if r.state.Region.KnownNodes["next"]||r.state.Region.KnownLinks["actually.crossed"]{t.Fatal("accepting a command learned the destination before crossing")}
 saved,arrived:=false,false
 for tick:=0;tick<500;tick++{
  r.step();hero=r.state.Life.Actor(playerActorID)
  if hero.Trip!=nil&&!saved{
   if r.state.Region.KnownNodes["next"]||r.state.Region.KnownLinks["actually.crossed"]{t.Fatal("transit exposed the unseen destination")}
   slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,r.snapshotState());err!=nil{t.Fatal(err)};loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};r.state=loaded;saved=true
  }
  if hero.Level==target&&hero.Trip==nil{arrived=true;break}
 }
 if !saved||!arrived||!r.state.Region.KnownNodes["next"]||!r.state.Region.KnownLinks["actually.crossed"]{t.Fatal("real saved crossing did not teach its destination and connection")}
 if r.state.Region.KnownLinks["unused.parallel"]||r.state.Region.KnownLinks["hidden.adjacent"]||r.state.Region.KnownNodes["hidden.neighbour"]{t.Fatal("crossing taught an untravelled private passage")}
 if !r.regionCanGoto(origin){t.Fatal("discovered physical connection did not enable a normal return route")}
 slot:=r.world.Config.SaveSlots[0];before:=r.snapshotState();if err:=r.writeSave(slot,before);err!=nil{t.Fatal(err)};loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)}
 if !reflect.DeepEqual(before.Region,loaded.Region){t.Fatal("discovered transition knowledge lost in save")}
 view:=&pb.PocLifeView{};r.appendRegionMap(view);raw,err:=proto.Marshal(view.RegionMap);if err!=nil{t.Fatal(err)}
 for _,secret:=range []string{"unused.parallel","hidden.adjacent","hidden.neighbour","PRIVATE_NEIGHBOUR"}{if bytes.Contains(raw,[]byte(secret)){t.Fatalf("untravelled connection leaked: %s",secret)}}
}
