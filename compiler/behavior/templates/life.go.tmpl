 // Immutable validated content guarantees the kernel's only mid-pass error
 // (an unknown trip edge) cannot occur. Preflight also protects direct callers.
 for _,a:=range s.Population.Actors{if a.Trip!=nil&&m.Edge(a.Trip.Edge)==nil{return fmt.Errorf("population trip references unknown edge")}}
