func passThroughDeck(t *testing.T,r *Runtime)liftingDeckDefinition{
 if r.world.LiftingDecks!=nil{for _,d:=range r.world.LiftingDecks.Decks{if d.Lower!=nil{return d}}}
 t.Skip("content has no pass-through deck");return liftingDeckDefinition{}
}
func parkActor(r *Runtime,id,level string,at behavior.Cell)*behavior.LifeActor{
 a:=r.state.Life.Actor(id);a.Level=level;a.Position=at;a.Goal=at;a.Path=nil;a.PendingPath=nil;a.Body=nil;a.Trip=nil;a.Manual=true;a.Arrived=true;a.OverrideLevel="";a.OverrideEdge="";a.Visits[level]=1;return a
}

// Each landing has its own open side, barrier and approach; the two sides are opposite.
func TestPassThroughDeckLandingsOpenOnOppositeSides(t *testing.T){
 r:=lifeRuntimeFixture(t);d:=passThroughDeck(t,r);l:=d.Lower
 if d.OpenSide==l.OpenSide{t.Fatal("both landings open on the same side: a convoy would have to reverse")}
 side:=func(open string,rect,barrier struct{X,Y,W,H int},approachY int)bool{if open=="south"{return barrier.Y==rect.Y+rect.H&&approachY>barrier.Y};return barrier.Y+barrier.H==rect.Y&&approachY<barrier.Y}
 if !side(d.OpenSide,d.Rect,d.BarrierRect,d.Approach.Y)||!side(l.OpenSide,l.Rect,l.BarrierRect,l.Approach.Y){t.Fatal("a barrier or approach is not on its landing's open side")}
 up,down:=r.world.Life.Edge(d.ReturnEdge),r.world.Life.Edge(d.TravelEdge)
 if up==nil||down==nil||!l.contains(up.Exit)||!d.contains(down.Exit){t.Fatal("riders must leave standing on the deck")}
 // They step off beyond the barrier line of the other landing, on its open side: floor at every moment.
 if d.contains(up.Entry)||up.Entry.Y<=d.BarrierRect.Y||l.contains(down.Entry)||down.Entry.Y>=l.BarrierRect.Y{t.Fatal("riders must step off on the open side of the other landing")}
}

// Upward: ten physical seconds of signal at the lower landing, nobody on its barrier line,
// riders standing on the deck leave when the leaves above start to move and step off only on the open hub deck.
func TestPassThroughDeckRidesUpFromTheLowerLanding(t *testing.T){
 r:=lifeRuntimeFixture(t);d:=passThroughDeck(t,r);l:=d.Lower;r.state.Life.SecondsPerTick=1
 parkActor(r,playerActorID,l.LevelID,behavior.Cell{X:l.Approach.X,Y:l.Approach.Y});r.syncLifeHero();r.updateLifeExploration()
 up:=r.world.Life.Edge(d.ReturnEdge)
 rider:=parkActor(r,"char.poc_hub_guard",l.LevelID,up.Exit)
 blocker:=parkActor(r,r.world.CargoConvoys.Convoys[0].Loaders[0],l.LevelID,behavior.Cell{X:l.BarrierRect.X+1,Y:l.BarrierRect.Y})
 g:=r.state.LiftingDecks[d.ID];if _,_,open:=g.lowerPose(d);!open||g.lowerPhase(d)!="lower_open"{t.Fatal("the deck does not stand open at the lower landing between runs")}
 if r.world.Life.Locations[l.LevelID].Terrain[l.Rect.Y][l.Rect.X]!='.'{t.Fatal("the standing deck is not floor")}
 g.NextRunSecond=r.state.Life.Seconds;r.state.LiftingDecks[d.ID]=g
 signalStart:=int64(-1)
 for tick:=0;tick<400;tick++{
  r.step();g=r.state.LiftingDecks[d.ID]
  if g.Phase=="equalising"&&signalStart<0{signalStart=g.UpdatedNS}
  if g.LowerAway||g.pose(g.UpdatedNS).Barrier>0{t.Fatalf("the deck moved with a person on the lower barrier line (phase %s)",g.Phase)}
  if tick>10&&g.lowerPhase(d)!="lower_signal"{t.Fatalf("lower landing shows %s while the signal holds",g.lowerPhase(d))}
 }
 if g.Phase!="signal_up"{t.Fatalf("occupied lower edge did not hold the signal: %s",g.Phase)}
 parkActor(r,blocker.ID,l.LevelID,behavior.Cell{X:l.Approach.X+2,Y:l.Approach.Y})
 left:=int64(-1)
 for tick:=0;tick<300&&left<0;tick++{r.step();g=r.state.LiftingDecks[d.ID];if g.LowerAway{left=g.UpdatedNS}}
 if left<0{t.Fatal("the deck never left the lower landing")}
 if left-signalStart<d.SignalBeforeOpenS*1000000000{t.Fatalf("lower signal lasted %d ns before departure, less than ten seconds",left-signalStart)}
 rider=r.state.Life.Actor(rider.ID);if rider.Trip==nil||rider.Trip.Edge!=up.ID{t.Fatalf("the rider on the deck did not leave with it: %+v",rider)}
 if r.world.Life.Locations[l.LevelID].Terrain[l.Rect.Y][l.Rect.X]=='.'||r.world.Life.Locations[l.LevelID].Terrain[l.BarrierRect.Y][l.BarrierRect.X]=='.'{t.Fatal("the empty lower landing is still walkable")}
 for tick:=0;tick<600;tick++{
  r.step();g=r.state.LiftingDecks[d.ID];rider=r.state.Life.Actor(rider.ID)
  if rider.Trip==nil{p:=g.pose(g.UpdatedNS);if rider.Level!=d.LevelID||d.contains(rider.Position)||rider.Position.Y<=d.BarrierRect.Y||!(g.Phase=="loading"||g.Phase=="signal_down")||p.Deck!=liftingDeckFull||p.Barrier!=0{t.Fatalf("rider stepped off at %s %v during %s",rider.Level,rider.Position,g.Phase)};return}
 }
 t.Fatal("the rider never arrived on the hub deck")
}

// Downward: riders on the hub deck leave at the descent and step off only when the deck stands open below.
func TestPassThroughDeckRidesDownToTheLowerLanding(t *testing.T){
 r:=lifeRuntimeFixture(t);d:=passThroughDeck(t,r);l:=d.Lower;r.state.Life.SecondsPerTick=1
 parkActor(r,playerActorID,d.LevelID,behavior.Cell{X:d.Approach.X,Y:d.Approach.Y+4});r.syncLifeHero();r.updateLifeExploration()
 down:=r.world.Life.Edge(d.TravelEdge)
 g:=r.state.LiftingDecks[d.ID];g.NextRunSecond=r.state.Life.Seconds;r.state.LiftingDecks[d.ID]=g
 for tick:=0;tick<800&&r.state.LiftingDecks[d.ID].Phase!="loading";tick++{r.step()}
 if r.state.LiftingDecks[d.ID].Phase!="loading"{t.Fatal("the deck never opened in the hub")}
 rider:=parkActor(r,"char.poc_hub_guard",d.LevelID,down.Exit)
 for tick:=0;tick<600&&r.state.Life.Actor(rider.ID).Trip==nil;tick++{
  r.step();g=r.state.LiftingDecks[d.ID]
  // The rider stands on floor through the signal and the rising barrier, until the deck takes him down.
  if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatalf("a rider waiting on the hub deck is not a valid Life state during %s: %v",g.Phase,err)}
  if (g.Phase=="signal_down"||g.Phase=="departure_barrier")&&r.liftingDeckLowerEdgeBusy(d){t.Fatal("unexpected body on the lower edge")}
 }
 rider=r.state.Life.Actor(rider.ID);if rider.Trip==nil||rider.Trip.Edge!=down.ID{t.Fatal("the rider did not leave with the descending deck")}
 g=r.state.LiftingDecks[d.ID];if !g.LowerAway||g.LowerArriveSecond!=rider.Trip.Arrival{t.Fatalf("the deck and its rider disagree about the arrival below: %d vs %d",g.LowerArriveSecond,rider.Trip.Arrival)}
 for tick:=0;tick<800;tick++{
  r.step();g=r.state.LiftingDecks[d.ID];rider=r.state.Life.Actor(rider.ID)
  if rider.Trip==nil{if _,_,open:=g.lowerPose(d);!open||rider.Level!=l.LevelID||l.contains(rider.Position)||rider.Position.Y>=l.BarrierRect.Y{t.Fatalf("rider stepped off below at %s %v, landing phase %s",rider.Level,rider.Position,g.lowerPhase(d))};return}
 }
 t.Fatal("the rider never arrived at the lower landing")
}

// The tracks are straight through the deck: the heading at the end of each boarding track equals the
// heading at the start of the leaving track at the other landing, and the convoy stands on the same place of the deck.
func TestCargoConvoyDrivesStraightThroughTheDeck(t *testing.T){
 r:=lifeRuntimeFixture(t);if r.world.CargoConvoys==nil{t.Skip("no cargo convoys")}
 for _,v:=range r.world.CargoConvoys.Convoys{
  heading:=func(track [][2]float64,s float64)float64{a,_:=v.poses(track,s,0);return a.Yaw}
  turn:=func(a,b float64)float64{d:=math.Mod(a-b+540,360)-180;return math.Abs(d)}
  if turn(heading(v.Lower.Board,cargoTrackLength(v.Lower.Board)),heading(v.Upper.Leave,0))>0.01{t.Fatalf("%s turns on the deck going up",v.ID)}
  if turn(heading(v.Upper.Board,cargoTrackLength(v.Upper.Board)),heading(v.Lower.Leave,0))>0.01{t.Fatalf("%s turns on the deck going down",v.ID)}
  if turn(heading(v.Upper.Leave,0),heading(v.Upper.Board,cargoTrackLength(v.Upper.Board)))<179.99{t.Fatalf("%s does not come back nose-first",v.ID)}
  // On every sample of the two boarding tracks the convoy moves forward along its own heading: no reversing.
  for _,track:=range [][][2]float64{v.Lower.Board,v.Upper.Board,v.Lower.Leave,v.Upper.Leave,v.Upper.Turn}{for at:=0.5;at<cargoTrackLength(track);at+=0.5{ax,az:=cargoTrackAt(track,at-0.1);bx,bz:=cargoTrackAt(track,at+0.1);if turn(math.Atan2(bz-az,bx-ax)*180/math.Pi,heading(track,at))>15{t.Fatalf("%s moves against its heading",v.ID)}}}
  // Seven metres straight off the lower landing before any turn.
  d:=r.cargoConvoyDeck(v);edge:=float64(d.Lower.Rect.Y)*0.5;start:=heading(v.Lower.Leave,0)
  for s:=0.0;s<cargoTrackLength(v.Lower.Leave);s+=0.25{_,z:=cargoTrackAt(v.Lower.Leave,s);if turn(heading(v.Lower.Leave,s),start)>0.5{if edge-z<7{t.Fatalf("%s begins to turn %.2f m after the lower landing edge",v.ID,edge-z)};break}}
 }
}

func cargoCrewDay(t *testing.T,rate int64){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 if r.world.CargoConvoys==nil||len(r.world.CargoConvoys.Convoys)==0{t.Skip("no cargo convoys")}
 if !r.world.Life.Brain.Enabled{t.Skip("content has no enabled brain")}
 v:=r.world.CargoConvoys.Convoys[0];d:=*r.cargoConvoyDeck(v);l:=d.Lower
 cellHero(r);r.state.Active=true;r.state.Speed=1;r.initLife()
 crew:=append([]string{v.Driver},v.Loaders...)
 held:=func(pick func(route int)string)int64{n:=int64(0);for i:=range d.Freight.Routes{for _,item:=range r.state.Inventory.Items{if item.Location.Kind=="store"&&item.Location.Store==pick(i){n+=item.Quantity}}};return n}
 deckStore:=func(i int)string{return d.Freight.Routes[i].DeckStore};receiving:=func(i int)string{return d.Freight.Routes[i].ReceivingStore}
 morning:=(r.state.Life.Seconds/86400+1)*86400
 r.state.Life.SecondsPerTick=30;for r.state.Life.Seconds<morning+v.LoadSecond-300{r.step()}
 for _,id:=range crew{a:=r.state.Life.Actor(id);if a.Level!=l.LevelID||!a.OnFloor(){t.Fatalf("%s is not at the dock before the shift: %s %v",id,a.Level,a.Position)}}
 r.state.Life.SecondsPerTick=rate
 seen:=[]string{};last:="";unloadedDuring:="";rodeUp,rodeDown:=map[string]bool{},map[string]bool{};saved:=map[string]bool{}
 // The deck's signals and motion run in physical seconds, so at a fast clock one deck cycle spans more game time:
 // four game hours hold the day at x1 and x10, x30 gets three times that.
 deadline:=morning+d.Freight.FirstSecond+4*3600*max(int64(1),rate/10)
 for r.state.Life.Seconds<deadline{
  beforeReceiving:=held(receiving)
  r.step()
  c:=r.state.CargoConvoys[v.ID];g:=r.state.LiftingDecks[d.ID];p:=g.pose(g.UpdatedNS)
  if c.Phase!=last{seen=append(seen,c.Phase);last=c.Phase}
  // Every moment of the crew day is a valid Life state: nobody stands on a cell that is not floor.
  if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatalf("invalid Life state during %s (deck %s): %v",c.Phase,g.Phase,err)}
  if held(receiving)>beforeReceiving&&unloadedDuring==""{unloadedDuring=c.Phase}
  if held(deckStore)>0&&c.Phase!="lower_on_deck"&&c.Phase!="riding_up"&&c.Phase!="upper_leaving"&&c.Phase!="unloading"{t.Fatalf("freight is on the deck store while the convoy is %s",c.Phase)}
  _,lowerBarrier,_:=g.lowerPose(d)
  for _,id:=range crew{
   a:=r.state.Life.Actor(id)
   if a.Trip!=nil{if a.Trip.Edge==d.ReturnEdge{rodeUp[id]=true};if a.Trip.Edge==d.TravelEdge{rodeDown[id]=true};continue}
   // Nobody of the crew stands on a barrier line while that barrier is moving or up.
   if a.Level==l.LevelID&&lowerBarrier>0&&l.onBarrier(a.Position){t.Fatalf("%s stands on the lower barrier line during %s",id,g.lowerPhase(d))}
   if a.Level==d.LevelID&&p.Barrier>0&&a.Position.Y>=d.BarrierRect.Y&&a.Position.Y<d.BarrierRect.Y+d.BarrierRect.H&&a.Position.X>=d.BarrierRect.X&&a.Position.X<d.BarrierRect.X+d.BarrierRect.W{t.Fatalf("%s stands on the hub barrier line during %s",id,g.Phase)}
   // A person is on the hub deck only while it stands flush there.
   if a.Level==d.LevelID&&d.contains(a.Position)&&p.Deck!=liftingDeckFull&&p.Leaves!=0{t.Fatalf("%s is on a moving hub deck as a body",id)}
  }
  if (c.Phase=="riding_up"||c.Phase=="unloading"||c.Phase=="upper_staged"||c.Phase=="riding_down")&&!saved[c.Phase]{
   saved[c.Phase]=true;snapshot:=r.snapshotState();if err:=r.validateLifeSave(snapshot);err!=nil{t.Fatalf("state during %s is not a valid save: %v",c.Phase,err)}
  }
  if c.Phase=="parked"&&len(seen)>3{break}
 }
 want:=[]string{"loading","lower_boarding","lower_on_deck","riding_up","upper_leaving","unloading","upper_turning","upper_staged","upper_boarding","upper_on_deck","riding_down","lower_leaving","parked"}
 at:=0;for _,phase:=range seen{if at<len(want)&&phase==want[at]{at++}}
 if at!=len(want){t.Fatalf("the crew day stopped after %v; phases seen %v",want[:at],seen)}
 if unloadedDuring!="unloading"{t.Fatalf("freight reached the receiving marks during %q, not while the crew unloaded",unloadedDuring)}
 for _,id:=range crew{
  a:=r.state.Life.Actor(id)
  if !rodeUp[id]||!rodeDown[id]{t.Fatalf("%s did not ride the deck both ways (up %v, down %v)",id,rodeUp[id],rodeDown[id])}
  if a.Level!=l.LevelID{t.Fatalf("%s did not come back to the dock: %s",id,a.Level)}
 }
 t.Logf("rate x%d: crew day finished at %02d:%02d, phases %v",rate,r.state.Life.Seconds%86400/3600,r.state.Life.Seconds%3600/60,seen)
}
func TestCargoCrewDayRate1(t *testing.T){cargoCrewDay(t,1)}
func TestCargoCrewDayRate10(t *testing.T){cargoCrewDay(t,10)}
func TestCargoCrewDayRate30(t *testing.T){cargoCrewDay(t,30)}
