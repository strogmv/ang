		}
		for k, v := range f.Args {
			if !memoryIn(rec.Args[k], v) {
				return false
			}
		}
		if f.WithinHours > 0 && now-rec.Second > f.WithinHours*3600 {
			return false
		}
		if f.BeforeToday && rec.First >= now/86400*86400 {
			return false
		}
	}
	if _, ok := facts[w.NotFact]; w.NotFact != "" && ok {
		return false
	}
	if _, ok := r.state.Memory.Topics[w.Topic]; w.Topic != "" && !ok {
		return false
	}
	if _, ok := r.state.Memory.Topics[w.NotTopic]; w.NotTopic != "" && ok {
		return false
	}
	if w.Knows != nil && !r.memoryKnows(c.person(w.Knows.Who), w.Knows.Fact) {
		return false
	}
	if t := w.Trust; t != nil {
		v := r.state.Life.RelationTo(r.world.Life, c.person(t.Who), playerActorID)
		if t.AtLeast != nil && v < *t.AtLeast || t.Below != nil && v >= *t.Below {
			return false
		}
	}
	if w.Skill != nil && r.dialogueSkill(w.Skill.ID) < w.Skill.AtLeast {
		return false
	}
	if d := w.Day; d != nil {
		day := r.memoryDay()
		if d.From > 0 && day < d.From || d.To > 0 && day > d.To {
			return false
		}
	}
	if t := c.t; t != nil {
		if w.Asked != "" && !t.chose(w.Asked) || w.NotAsked != "" && t.chose(w.NotAsked) {
			return false
		}
		if w.Voiced != "" && !t.voiced(w.Voiced) || w.Entry != "" && t.Entry != w.Entry {
			return false
		}
		if w.Interjected != nil && t.Interjected != *w.Interjected {
			return false
		}
	} else if w.Asked != "" || w.Voiced != "" || w.Entry != "" || w.Interjected != nil && *w.Interjected {
		return false
	}
	if len(w.Speaker) > 0 && !memoryIn(w.Speaker, c.self) || len(w.Caste) > 0 && !memoryIn(w.Caste, barkCatalog.Castes[c.self]) {
		return false
	}
	if it := w.Item; it != nil {
		owner := c.person(it.Owner)
		if it.Owner == "hero" {
			owner = playerActorID
		}
		item, ok := r.memoryItem(c, owner, it.Item)
		if !ok {
			return false
		}
		if it.ConditionBelow != nil && item.Condition >= int64(*it.ConditionBelow*1000000) || it.ConditionAtLeast != nil && item.Condition < int64(*it.ConditionAtLeast*1000000) {
			return false
		}
	}
	switch w.World {
	case "passage_open":
		if !r.encounterPassageOpen() {
			return false
		}
	case "self_trades":
		if !r.talkSelfTrades(c.self) {
			return false
		}
	}
	if w.SeenBy != "" && !r.memorySeenBy(c, w.SeenBy) || w.NotSeenBy != "" && r.memorySeenBy(c, w.NotSeenBy) {
		return false
	}
	if len(w.Any) > 0 {
		any := false
		for i := range w.Any {
			any = any || r.memoryHolds(c, &w.Any[i])
		}
		if !any {
			return false
		}
	}
	return w.Not == nil || !r.memoryHolds(c, w.Not)
}

func memoryIn(list []string, v string) bool {
	for _, x := range list {
		if x == v {
			return true
		}
	}
	return false
}

// memorySeenBy: the person identifies the hero now (the fight's sight and identification), or did, as saved.
func (r *Runtime) memorySeenBy(c talkCtx, id string) bool {
	if c.seen != nil {
		return c.seen[id]
	}
	a := r.state.Life.Actor(id)
	return a != nil && a.OnFloor() && r.combatWorldIdentifies(combatLifeObserver{ID: id, Level: a.Level, At: a.Position}, playerActorID)
}

// memoryDo applies effects in order; an effect whose thing is gone (a sold lamp) does nothing.
func (r *Runtime) memoryDo(c talkCtx, list []memDo) {
	for _, d := range list {
		if !r.memoryHolds(c, d.When) {
			continue
		}
		switch {
		case d.Fact != "":
			r.memoryWrite(d.Fact, d.Args, c)
		case d.Topic != "":
			r.memoryTopic(d.Topic)
		case d.Trust != nil:
			who := c.person(d.Trust.Who)
			old := r.state.Life.RelationTo(r.world.Life, who, playerActorID)
			if r.state.Life.RelationOverrides == nil {
				r.state.Life.RelationOverrides = map[string]map[string]float64{}
			}
			if r.state.Life.RelationOverrides[who] == nil {
				r.state.Life.RelationOverrides[who] = map[string]float64{}
			}
			r.state.Life.RelationOverrides[who][playerActorID] = max(-1, min(1, old+d.Trust.Delta))
		case d.GiveItem != nil:
			if item, ok := r.memoryItem(c, c.person(d.GiveItem.From), d.GiveItem.Item); ok {
				split := fmt.Sprintf("%s.given.%d", item.ID, r.state.Inventory.Revision)
				_, _ = r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: []inv.Relocate{{Item: item.ID, Quantity: 1, Split: split, To: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, Owner: playerActorID}}})
			}
		case d.ItemCondition != nil:
			// one thing mended or broken, not its whole stack
			if item, ok := r.memoryItem(c, c.person(d.ItemCondition.Owner), d.ItemCondition.Item); ok {
				one, moves := r.memoryOne(item)
				if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: moves, Restore: []inv.Restore{{Item: one, Condition: int64(d.ItemCondition.Set * 1000000)}}}); err == nil && c.t != nil && c.t.Things != nil {
					// the talk's thing is the one mended or broken (split off a stack, it has its own id)
					c.t.Things[c.person(d.ItemCondition.Owner)+"|"+d.ItemCondition.Item] = one
				}
			}
		}
	}
}

// memoryOnTrade: the hero bought from this person; facts that a purchase writes (Prokhor: met{bought}).
func (r *Runtime) memoryOnTrade(seller string) {
	m := r.world.Memory
	if m == nil {
		return
	}
	ids := make([]string, 0)
	for id, f := range m.Facts {
		if f.OnTrade != nil && f.OnTrade.Seller == seller {
			ids = append(ids, id)
		}
	}
	sort.Strings(ids)
	for _, id := range ids {
		r.memoryWrite(id, m.Facts[id].OnTrade.Args, talkCtx{self: seller})
	}
}

// lineText: the first variant whose condition holds, or the line's own text.
func (r *Runtime) lineText(c talkCtx, text string, variants []convVariant) string {
	for i := range variants {
		if r.memoryHolds(c, &variants[i].When) {
			return variants[i].Text
		}
	}
	return text
}

// talkSpeak writes the lines whose condition holds to the log, each with the text of its first holding variant.
func (r *Runtime) talkSpeak(c talkCtx, lines []convLine) {
	for _, l := range lines {
		if !r.memoryHolds(c, l.When) {
			continue
		}
		r.dialogueSay(&c.t.dialogueSession, dialogueEntry{Kind: "line", Speaker: c.person(l.Speaker), Text: r.lineText(c, l.Text, l.Variants)})
	}
}

// talkEnter: the node's lines once per talk, then the hero's voices that have not spoken with this person and hold.
func (r *Runtime) talkEnter(c talkCtx, node string) {
	n := c.conv.Nodes[node]
	if n == nil {
		return
	}
	c.t.Node = node
	for _, seen := range c.t.Nodes {
		if seen == node {
			return
		}
	}
	c.t.Nodes = append(c.t.Nodes, node)
	r.talkSpeak(c, n.Lines)
	for _, v := range n.Voices {
		if c.t.voiced(v.ID) || r.dialogueSkill(v.Skill) < v.AtLeast || !r.memoryHolds(c, v.When) {
			continue
		}
		r.dialogueSay(&c.t.dialogueSession, dialogueEntry{Kind: "voice", Skill: v.Skill, Text: r.lineText(c, v.Text, v.Variants)})
		c.t.Voiced = append(c.t.Voiced, v.ID)
		r.memoryDo(c, v.Do)
	}
}

// talkInterjection: the freshest fact the person knows himself (belief 1), fresh enough, not yet said by him, whose
// condition holds — his first line in any conversation of his (doc 103 §4.3).
func (r *Runtime) talkInterjection(c talkCtx) *interjectionDef {
	m := r.world.Memory
	if m == nil {
		return nil
	}
	var best *interjectionDef
	bestAt := int64(-1)
	for i := range m.Interjections {
		in := &m.Interjections[i]
		if in.Speaker != c.self || in.Belief != "witness" {
			continue
		}
		if _, said := r.state.Memory.Said[c.self+"|"+in.Fact]; said {
			continue
		}
		rec, ok := r.state.Memory.Facts[in.Fact]
		if !ok || r.state.Life.Seconds-rec.Second > m.InterjectionRules.FreshDays*86400 || !r.memoryKnows(c.self, in.Fact) || !r.memoryHolds(c, in.When) {
			continue
		}
		if rec.Second > bestAt || rec.Second == bestAt && best != nil && in.ID < best.ID {
			best, bestAt = in, rec.Second
		}
	}
	return best
}

// talkEntry: the first entry whose condition holds.
func (r *Runtime) talkEntry(c talkCtx) *convEntryDef {
	for i := range c.conv.Entries {
		if r.memoryHolds(c, c.conv.Entries[i].When) {
			return &c.conv.Entries[i]
		}
	}
	return nil
}

func (r *Runtime) talkState(key string) *talkState {
	if r.state.Memory.Talks == nil {
		r.state.Memory.Talks = map[string]*talkState{}
	}
	t := r.state.Memory.Talks[key]
	if t == nil {
		t = &talkState{}
		r.state.Memory.Talks[key] = t
	}
	if h, ok := r.state.Memory.Once[key]; ok {
		t.Chosen, t.Checks = h.Chosen, h.Checks
	}
	return t
}

// talkOpen opens a talk with a person: his interjection, the entry, its node. Another open talk ends without a word.
func (r *Runtime) talkOpen(conv, self string) error {
	d := r.world.Conversations[conv]
	if d == nil {
		return textError{Key: "error.encounter.unavailable"}
	}
	key := talkKey(conv, self)
	r.talkDrop()
	t := r.talkState(key)
	r.state.Memory.Serial++
	t.Lines, t.Nodes, t.Interjected, t.Until, t.Close, t.Entry, t.Node, t.Ticks, t.Hidden = nil, nil, false, 0, "", "", "", 0, false
	t.Opened, t.Serial = r.state.Life.Seconds, r.state.Memory.Serial
	r.state.Memory.Open = key
	c := talkCtx{conv: d, key: key, self: self, t: t}
	r.talkThings(c)
	if in := r.talkInterjection(c); in != nil {
		if r.state.Memory.Said == nil {
			r.state.Memory.Said = map[string]int64{}
		}
		r.state.Memory.Said[self+"|"+in.Fact] = r.state.Life.Seconds
		t.Interjected = true
		r.dialogueSay(&t.dialogueSession, dialogueEntry{Kind: "line", Speaker: self, Text: in.Text})
		if v := in.Voice; v != nil && r.dialogueSkill(v.Skill) >= v.AtLeast && r.memoryHolds(c, v.When) {
			r.dialogueSay(&t.dialogueSession, dialogueEntry{Kind: "voice", Skill: v.Skill, Text: v.Text})
		}
		r.memoryDo(c, in.Do)
	}
	e := r.talkEntry(c)
	if e == nil {
		r.talkDrop()
		return textError{Key: "error.encounter.unavailable"}
	}
	t.Entry = e.ID
	r.talkSpeak(c, e.Lines)
	r.talkEnter(c, e.Node)
	return nil
}

// talkOpenNow: the talk on now (not lingering), with its context.
func (r *Runtime) talkOpenNow() (talkCtx, bool) {
	key := r.state.Memory.Open
	t := r.state.Memory.Talks[key]
	if key == "" || t == nil || t.Until > 0 {
		return talkCtx{}, false
	}
	conv, self, _ := strings.Cut(key, "|")
	d := r.world.Conversations[conv]
	if d == nil {
		return talkCtx{}, false
	}
	return talkCtx{conv: d, key: key, self: self, t: t}, true
}

// talkDrop ends the open talk without a word (the hero walked away, a fight began, another talk opened).
func (r *Runtime) talkDrop() {
	if t := r.state.Memory.Talks[r.state.Memory.Open]; t != nil {
		t.Lines, t.Nodes, t.Until = nil, nil, 0
	}
	r.state.Memory.Open = ""
}

// talkClose: the talk closed with a word; its log stays for the conversation's linger (real seconds: server ticks).
func (r *Runtime) talkClose(c talkCtx, word string) {
	c.t.Close = word
	c.t.Until = r.state.Tick + max(1, c.conv.LingerSeconds*int64(r.world.Config.TickHz))
}

// talkHolds: a talk is on, shown and held by its owner — the world waits for the hero's answer (owner 21.11: the
// player must have time to read; conversation.go counts the talk's own time instead).
func (r *Runtime) talkHolds() bool {
	c, ok := r.talkOpenNow()
	return ok && !c.t.Hidden && r.talkAllowed(c)
}

// talkTick: one server tick of the open talk while the world waits; a talk that waits for an answer only so long hands
// its timeout to its owner.
func (r *Runtime) talkTick() {
	c, ok := r.talkOpenNow()
	if !ok {
		return
	}
	c.t.Ticks++
	if c.conv.AnswerSeconds > 0 && c.t.Ticks >= c.conv.AnswerSeconds*int64(r.world.Config.TickHz) {
		if word := r.talkEvent("timeout"); word != "" {
			r.talkClosed(c, word, false)
		}
	}
}

// optionShown: an answer of the node the hero may pick now (a locked retry check is shown, locked); an answer another
// shown answer replaces is not.
func (r *Runtime) optionShown(c talkCtx, o convOption) bool {
	if !r.optionOwn(c, o) {
		return false
	}
	if n := c.conv.Nodes[c.t.Node]; n != nil {
		for _, other := range n.Options {
			if other.Replaces == o.ID && r.optionOwn(c, other) {
				return false
			}
		}
	}
	return true
}

// optionOwn: the answer's own condition, once and check.
func (r *Runtime) optionOwn(c talkCtx, o convOption) bool {
	if o.Once && c.t.chose(o.ID) || !r.memoryHolds(c, o.When) {
		return false
	}
	if o.Check != nil {
		if open, locked := r.dialogueCheckOpen(&c.t.dialogueSession, o.ID, *o.Check); !open && !locked {
			return false
		}
	}
	return true
}

// talkChoose: the hero's answer in the open talk. It returns the closing word ("" when the talk goes on) and whether the
// answer's check failed; an answer that opens trade closes the talk at once with the word "trade".
func (r *Runtime) talkChoose(id string) (string, bool, error) {
	c, ok := r.talkOpenNow()
	if !ok {
		return "", false, textError{Key: "error.encounter.unavailable"}
	}
	defer func() { r.state.Memory.rememberTalk(c.key, c.t) }()
	n := c.conv.Nodes[c.t.Node]
	if n == nil {
		return "", false, textError{Key: "error.encounter.unavailable"}
	}
	for _, o := range n.Options {
		if o.ID != id {
			continue
		}
		if !r.optionShown(c, o) {
			return "", false, textError{Key: "error.encounter.condition"}
		}
		if o.Check != nil {
			if open, _ := r.dialogueCheckOpen(&c.t.dialogueSession, o.ID, *o.Check); !open {
				return "", false, textError{Key: "error.dialogue.closed"}
			}
		}
		// asked before (no check to try again): the answer is in the log already, nothing is written twice
		if o.question() && o.Check == nil && c.t.chose(o.ID) {
			return "", false, nil
		}
		r.dialogueAnswer(&c.t.dialogueSession, o.ID, r.lineText(c, o.Text, o.Variants))
		if o.Trade {
			r.talkDrop()
			return "trade", false, nil
		}
		reply, do, next, word := o.Reply, o.Do, o.Next, o.Close
		failed := false
		if o.Check != nil && !r.dialogueRoll(&c.t.dialogueSession, c.key, o.ID, *o.Check) {
			failed = true
			reply, do, next, word = o.Fail.Reply, o.Fail.Do, o.Fail.Next, o.Fail.Close
		}
		r.talkSpeak(c, reply)
		r.memoryDo(c, do)
		switch {
		case next != "":
			r.talkEnter(c, next)
		case word != "":
			r.talkClose(c, word)
		}
		return word, failed, nil
	}
	return "", false, textError{Key: "error.encounter.unavailable"}
}

// talkEvent: an event of the owner (the custody's timeout): its lines, effects and closing word.
func (r *Runtime) talkEvent(event string) string {
	c, ok := r.talkOpenNow()
	if !ok {
		return ""
	}
	e := c.conv.Events[event]
	if e == nil {
		return ""
	}
	r.talkSpeak(c, e.Lines)
	r.memoryDo(c, e.Do)
	r.talkClose(c, e.Close)
	return e.Close
}

// talkOf: the conversation a person opens now through world.memory.talks (not the encounter's).
func (r *Runtime) talkOf(person string) (*memoryTalkDef, bool) {
	m := r.world.Memory
	if m == nil {
		return nil, false
	}
	for i := range m.Talks {
		for _, p := range m.Talks[i].People {
			if p == person {
				return &m.Talks[i], true
			}
		}
	}
	return nil, false
}

// talkSelfTrades: the person trades now (a peddler on his round, a stall keeper at his counter).
func (r *Runtime) talkSelfTrades(self string) bool {
	if p, ok := r.peddlerOfActor(self); ok {
		return r.encounterTradeAllowed(self) && r.peddlerStopNow(p) != ""
	}
	a := r.state.Life.Actor(self)
	if a == nil || !a.OnFloor() {
		return false
	}
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.Owner == self && sh.ServesCell(a.Level, inv.Cell{X: a.Position.X, Y: a.Position.Y}) {
			return true
		}
	}
	return false
}

// talkNear: the hero and the person stand on one level within the conversation's reach, both on their feet, no fight.
func (r *Runtime) talkNear(self string, reach int) bool {
	h, a := r.state.Life.Actor(playerActorID), r.state.Life.Actor(self)
	return h != nil && a != nil && h.OnFloor() && a.OnFloor() && !a.CombatHold && h.Level == a.Level && behavior.Distance(h.Position, a.Position) <= reach && !r.heroInCombat() && r.bodyCanSpeak(self)
}

// talkNews: a person with something to say — an interjection he has not said, or a question not yet asked of him.
func (r *Runtime) talkNews(conv, self string) bool {
	d := r.world.Conversations[conv]
	if d == nil {
		return false
	}
	key := talkKey(conv, self)
	t := r.state.Memory.Talks[key]
	probe := &talkState{}
	if t != nil {
		probe.dialogueSession = t.dialogueSession.clone()
		probe.Voiced = t.Voiced
	}
	if h, ok := r.state.Memory.Once[key]; ok {
		probe.Chosen, probe.Checks = h.Chosen, h.Checks
	}
	c := talkCtx{conv: d, key: key, self: self, t: probe}
	r.talkThings(c)
	if r.talkInterjection(c) != nil {
		return true
	}
	e := r.talkEntry(c)
	if e == nil {
		return false
	}
	probe.Entry = e.ID
	for _, o := range d.Nodes[e.Node].Options {
		if o.question() && !probe.chose(o.ID) && r.optionShown(c, o) {
			return true
		}
	}
	return false
}

// talkAvailable: the conversation a person would open now with the hero, by its owner (the encounter first).
func (r *Runtime) talkAvailable(person string) (string, bool) {
	if conv, ok := r.encounterTalkOf(person); ok {
		return conv, true
	}
	t, ok := r.talkOf(person)
	if !ok || !r.talkNear(person, 24) {
		return "", false
	}
	if t.Open == "news" && !r.talkNews(t.Conversation, person) {
		return "", false
	}
	return t.Conversation, true
}

// conversationCommand: the hero opens a talk with a person, or answers in the one open.
func (r *Runtime) conversationCommand(q *pb.PocLifeCommand) error {
	switch q.Action {
	case "conversation_open":
		conv, ok := r.talkAvailable(q.Destination)
		if !ok || !r.talkNear(q.Destination, r.world.Conversations[conv].Reach) {
			return textError{Key: "error.encounter.unavailable"}
		}
		// the talk the hero stepped away from comes back as it was
		if key := talkKey(conv, q.Destination); r.state.Memory.Open == key {
			if t := r.state.Memory.Talks[key]; t != nil && t.Hidden && t.Until == 0 {
				t.Hidden = false
				return nil
			}
		}
		// an event talk on now (the custody, even stepped away from) is not left for another
		if c, on := r.talkOpenNow(); on && c.conv.Event {
			return textError{Key: "error.encounter.unavailable"}
		}
		return r.talkOpen(conv, q.Destination)
	case "conversation_leave":
		// the hero closed the column: an ordinary talk ends, a talk that waits for its owner steps aside, last words go
		key := r.state.Memory.Open
		t := r.state.Memory.Talks[key]
		conv, _, _ := strings.Cut(key, "|")
		if t == nil {
			return nil
		}
		if d := r.world.Conversations[conv]; d != nil && d.Event && t.Until == 0 {
			t.Hidden = true
			return nil
		}
		r.talkDrop()
		return nil
	case "conversation_choice", "encounter_choice":
		c, ok := r.talkOpenNow()
		if !ok || !r.talkAllowed(c) {
			return textError{Key: "error.encounter.unavailable"}
		}
		word, failed, err := r.talkChoose(q.Destination)
		if err != nil {
			return err
		}
		if word != "" {
			r.talkClosed(c, word, failed)
		}
		return nil
	}
	return textError{Key: "error.encounter.unavailable"}
}

// talkAllowed: the open talk may go on — its owner still holds it (the encounter's phase and guard) and the hero stands
// within the conversation's reach.
func (r *Runtime) talkAllowed(c talkCtx) bool {
	if owned, ok := r.encounterTalkAllowed(c.conv.ID); owned {
		return ok
	}
	_, talks := r.talkOf(c.self)
	return talks && r.talkNear(c.self, c.conv.Reach)
}

// talkClosed hands the closing word to the conversation's owner (the encounter turns the custody's into an outcome).
func (r *Runtime) talkClosed(c talkCtx, word string, failed bool) {
	r.encounterTalkClosed(c.conv.ID, c.self, word, failed)
}

// memoryAfterFrame: topics from heard barks; the lingering log goes when its time is up; a talk whose owner or reach is
// gone ends without a word.
func (r *Runtime) memoryAfterFrame() {
	m := r.world.Memory
	if m == nil {
		return
	}
	if hero := r.state.Life.Actor(playerActorID); hero != nil && hero.OnFloor() {
		topics := make([]string, 0, len(m.Topics))
		for id := range m.Topics {
			topics = append(topics, id)
		}
		sort.Strings(topics)
		for _, sp := range r.state.Barks.Visible(r.state.Tick) {
			for _, id := range topics {
				t := m.Topics[id]
				if !memoryIn(t.FromBarks, sp.Line) {
					continue
				}
				if level, at, ok := r.barkActorAt(sp.Speaker); ok && level == hero.Level && behavior.Distance(at, hero.Position) <= t.HearingCells {
					r.memoryTopic(id)
				}
			}
		}
	}
	key := r.state.Memory.Open
	t := r.state.Memory.Talks[key]
	switch {
	case key == "":
	case t == nil:
		r.state.Memory.Open = ""
	case t.Until > 0:
		if r.state.Tick >= t.Until {
			r.talkDrop()
		}
	default:
		// an ordinary talk ends when the hero walks away; an event talk (the custody) waits for its owner
		if c, ok := r.talkOpenNow(); !ok || !c.conv.Event && !r.talkAllowed(c) {
			r.talkDrop()
		}
	}
}

// appendTalkTargets: the people of the hero's level who have something to say now (the world action «Talk»).
func (r *Runtime) appendTalkTargets(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView, locale string) {
	if hero == nil || !hero.OnFloor() || r.world.Memory == nil || r.heroInCombat() {
		return
	}
	if _, on := r.talkOpenNow(); on {
		return
	}
	people := []string{}
	if e := r.world.CalendarEncounter; e != nil {
		people = append(people, e.Actor)
	}
	for _, t := range r.world.Memory.Talks {
		people = append(people, t.People...)
	}
	for _, id := range people {
		a := r.state.Life.Actor(id)
		if a == nil || a.Level != hero.Level || !a.OnFloor() || !viewSees(perception, int32(a.Position.X), int32(a.Position.Y)) {
			continue
		}
		if _, ok := r.talkAvailable(id); ok {
			view.TalkTargets = append(view.TalkTargets, &pb.PocTalkTarget{Id: id, Name: r.craftingActorName(locale, id)})
		}
	}
}

// appendConversation: the talk on now (or its last words while they linger) as the conversation column shows it.
func (r *Runtime) appendConversation(msg *pb.PocGameState, locale string) {
	key := r.state.Memory.Open
	t := r.state.Memory.Talks[key]
	if key == "" || t == nil {
		return
	}
	conv, self, _ := strings.Cut(key, "|")
	d := r.world.Conversations[conv]
	if d == nil {
		return
	}
	c := talkCtx{conv: d, key: key, self: self, t: t}
	// a talk its owner does not hold now (the guard stepped away), or one the hero stepped away from, is not shown; it is kept
	if t.Until == 0 && (t.Hidden || !r.talkAllowed(c)) {
		return
	}
	speaker, text := self, ""
	for _, l := range t.Lines {
		if l.Kind == "line" {
			speaker, text = l.Speaker, l.Text
		}
	}
	v := &pb.PocConversation{Kind: "talk", Id: fmt.Sprintf("%s#%d", key, t.Serial), Speaker: speaker, Text: r.dialogueText(locale, text), Lines: r.dialogueLog(locale, t.dialogueSession)}
	if t.Until > 0 {
		v.Kind, v.Leave = "reply", true
	} else if n := d.Nodes[t.Node]; n != nil {
		for _, o := range n.Options {
			if !r.optionShown(c, o) {
				continue
			}
			choice := r.dialogueChoice(locale, t.dialogueSession, o.ID, r.lineText(c, o.Text, o.Variants), o.Check)
			choice.Action = "conversation_choice"
			if o.Trade {
				choice.TradeWith = self
			}
			v.Choices = append(v.Choices, choice)
		}
	}
	v.SpeakerName = r.craftingActorName(locale, v.Speaker)
	v.Skin = barkCatalog.Castes[v.Speaker]
	if v.Skin != "copper" && v.Skin != "silver" && v.Skin != "gold" {
		v.Skin = "copper"
	}
	v.CasteName = r.localText(locale, "ui.caste."+v.Skin, "")
	v.SpeakerColour = r.dialogueCasteColour(v.Speaker)
	msg.Conversation = v
}

// sanitizeMemory: a saved memory keeps only what the content still has (a fact, topic, person, conversation, answer,
// voice or node that is gone is dropped); an older save gets the facts its calendar encounter already settled.
func (r *Runtime) sanitizeMemory(s *state) {
	m := r.world.Memory
	if m == nil {
		s.Memory = memoryState{}
		return
	}
	people := map[string]bool{}
	for _, a := range s.Life.Actors {
		people[a.ID] = true
	}
	for id, f := range s.Memory.Facts {
		if m.Facts[id] == nil {
			delete(s.Memory.Facts, id)
			continue
		}
		keep := f.Witnesses[:0]
		for _, w := range f.Witnesses {
			if people[w] {
				keep = append(keep, w)
			}
		}
		f.Witnesses = keep
		for k, values := range f.Args {
			keep := values[:0]
			for _, v := range values {
				if memoryIn(m.Facts[id].Args[k], v) && !memoryIn(keep, v) {
					keep = append(keep, v)
				}
			}
			if len(keep) == 0 {
				delete(f.Args, k)
			} else {
				sort.Strings(keep)
				f.Args[k] = keep
			}
		}
		s.Memory.Facts[id] = f
	}
	for id := range s.Memory.Topics {
		if m.Topics[id] == nil {
			delete(s.Memory.Topics, id)
		}
	}
	for id := range s.Memory.Said {
		person, fact, _ := strings.Cut(id, "|")
		if !people[person] || m.Facts[fact] == nil {
			delete(s.Memory.Said, id)
		}
	}
	if s.Memory.Migrated < memoryMigrationVersion {
		for key, t := range s.Memory.Talks {
			s.Memory.rememberTalk(key, t)
		}
	}
	resetFlows := map[string]bool{}
	for key, h := range s.Memory.Once {
		conv, self, _ := strings.Cut(key, "|")
		d := r.world.Conversations[conv]
		if d == nil || !people[self] {
			delete(s.Memory.Once, key)
			continue
		}
		options := map[string]bool{}
		for _, n := range d.Nodes {
			for _, o := range n.Options {
				options[o.ID] = true
			}
		}
		keep := h.Chosen[:0]
		for _, id := range h.Chosen {
			if options[id] && !memoryIn(keep, id) {
				keep = append(keep, id)
			} else if !options[id] {
				resetFlows[key] = true
			}
		}
		h.Chosen = keep
		for id := range h.Checks {
			if !options[id] {
				delete(h.Checks, id)
				resetFlows[key] = true
			}
		}
		if len(h.Chosen)+len(h.Checks) == 0 {
			delete(s.Memory.Once, key)
		} else {
			s.Memory.Once[key] = h
		}
	}
	for key, t := range s.Memory.Talks {
		conv, self, _ := strings.Cut(key, "|")
		d := r.world.Conversations[conv]
		if d == nil || !people[self] || t == nil {
			delete(s.Memory.Talks, key)
			continue
		}
		options, nodes, voices := map[string]bool{}, map[string]bool{}, map[string]bool{}
		for id, n := range d.Nodes {
			nodes[id] = true
			for _, o := range n.Options {
				options[o.ID] = true
			}
			for _, v := range n.Voices {
				voices[v.ID] = true
			}
		}
		speakers := map[string]bool{self: true}
		for _, sp := range d.Speakers {
			speakers[sp] = true
		}
		invalid := resetFlows[key] || r.validateDialogueSession(t.dialogueSession, options, nodes, speakers) != nil || t.Node != "" && !nodes[t.Node]
		t.Chosen, t.Checks = nil, nil
		if h, ok := s.Memory.Once[key]; ok {
			t.Chosen, t.Checks = h.Chosen, h.Checks
		}
		if invalid {
			// The log names removed content: reset its flow; the independent once ledger survives.
			if key == s.Memory.Open {
				s.Memory.Open = ""
			}
			delete(s.Memory.Talks, key)
			continue
		}
		keep := t.Voiced[:0]
		for _, v := range t.Voiced {
			if voices[v] {
				keep = append(keep, v)
			}
		}
		t.Voiced = keep
	}
	if s.Memory.Talks[s.Memory.Open] == nil {
		s.Memory.Open = ""
	}
	r.migrateEncounterMemory(s)
}

// validateMemorySave: times within the game's clock and sizes within the content.
func (r *Runtime) validateMemorySave(s state) error {
	if r.world.Memory == nil {
		return nil
	}
	now := s.Life.Seconds
	for id, f := range s.Memory.Facts {
		if f.First < 0 || f.Second < f.First || f.Second > now || f.Count < 1 || len(f.Witnesses) > len(s.Life.Actors) {
			return fmt.Errorf("saved memory: invalid fact %s", id)
		}
	}
	for id, at := range s.Memory.Topics {
		if at < 0 || at > now {
			return fmt.Errorf("saved memory: invalid topic %s", id)
		}
	}
	for id, at := range s.Memory.Said {
		if at < 0 || at > now {
			return fmt.Errorf("saved memory: invalid interjection %s", id)
		}
	}
	for key, t := range s.Memory.Talks {
		if t.Opened < 0 || t.Opened > now || t.Serial < 0 || t.Serial > s.Memory.Serial || t.Ticks < 0 || t.Until < 0 {
			return fmt.Errorf("saved memory: invalid talk %s", key)
		}
	}
	for key, h := range s.Memory.Once {
		conv, _, _ := strings.Cut(key, "|")
		options := map[string]bool{}
		for _, n := range r.world.Conversations[conv].Nodes {
			for _, o := range n.Options {
				options[o.ID] = true
			}
		}
		if err := r.validateDialogueSession(dialogueSession{Chosen: h.Chosen, Checks: h.Checks}, options, nil, nil); err != nil {
			return err
		}
	}
	if s.Memory.Migrated < 0 || s.Memory.Migrated > memoryMigrationVersion {
		return errors.New("saved memory: invalid migration version")
	}
	if len(s.Memory.Once) > 4096 {
		return errors.New("saved memory: too many once histories")
	}
	if len(s.Memory.Talks) > 4096 || len(s.Memory.Said) > 4096 {
		return errors.New("saved memory: too large")
	}
	return nil
}
