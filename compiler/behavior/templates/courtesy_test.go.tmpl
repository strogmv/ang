func TestLifeCourtesyAcceptedGoalPassesIdleFriendAndRestoresTask(t *testing.T) {
	m, s := courtesyFixture()
	if err := m.Validate(); err != nil {
		t.Fatal(err)
	}
	origin, goal := s.Actor("friend").Position, Cell{5, 2}
	courtesyAccept(t, m, &s, goal)
	yielded, passed, restored := false, false, false
	for tick := int64(1); tick <= 60; tick++ {
		courtesyAdvance(t, m, &s, tick)
		hero, friend := s.Actor("hero"), s.Actor("friend")
		if hero.Goal != goal || !hero.Manual || friend.Goal != origin || friend.Step != 0 || friend.Manual {
			t.Fatalf("accepted goal or NPC task lost at tick %d", tick)
		}
		if friend.YieldUntil > 0 {
			yielded = true
		}
		passed = passed || hero.Position == goal && hero.Arrived && len(hero.Path) == 0
		restored = restored || passed && friend.Position == origin && friend.Arrived && friend.Activity == "rest" && len(friend.Path) == 0
	}
	if !yielded || !passed || !restored {
		t.Fatalf("ordinary passage/task restoration incomplete: yielded=%v passed=%v restored=%v hero=%+v friend=%+v", yielded, passed, restored, s.Actor("hero"), s.Actor("friend"))
	}
}

