func practiceFixture() PracticeModel {
	return PracticeModel{Skills: []PracticeSkillDefinition{{ID: "shooting", Name: "Shooting"}, {ID: "melee", Name: "Melee"}}, Rules: []PracticeRule{{ID: "aimed_shot", Name: "Aimed shot", Skill: "shooting", BaseGainMilli: 1000, Difficulty: 50, SuccessPermille: 1000, FailurePermille: 300, CooldownTicks: 2, RepeatWindowTicks: 1000, RepeatScale: 10}, {ID: "melee_exchange", Name: "Melee exchange", Skill: "melee", BaseGainMilli: 1000, Difficulty: 50, SuccessPermille: 1000, FailurePermille: 300, CooldownTicks: 2, RepeatWindowTicks: 1000, RepeatScale: 10}}, Profiles: map[string]PracticeProfile{"hero": {Skills: map[string]PracticeSkillInitial{"shooting": {Start: 20, Cap: 80}, "melee": {Start: 10, Cap: 70}}, LearnPermille: 1000}, "worker": {Skills: map[string]PracticeSkillInitial{"shooting": {Start: 20, Cap: 80}, "melee": {Start: 10, Cap: 70}}, LearnPermille: 1000}}}
