func (r *Runtime) combatDistance(a, b behavior.Cell) int {
	if v := r.deckVolume(); v != nil {
		return v.CombatRangeMM(a, b)
	}
	unit := r.world.Life.Locations[r.currentLevel()].CellMM
	if unit < 1 {
		unit = 1000
	}
	return int(math.Ceil(math.Hypot(float64(a.X-b.X), float64(a.Y-b.Y)) * float64(unit)))
}
func (r *Runtime) startCombat(targetID string) error {
