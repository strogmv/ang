func TestLifeCourtesyAcceptedGoalPassesIdleFriendAndRestoresTask(t *testing.T) {
	m, s := courtesyFixture()
	if err := m.Validate(); err != nil {
		t.Fatal(err)
	}
	origin, goal := s.Actor("friend").Position, Cell{5, 2}
	courtesyAccept(t, m, &s, goal)
	yielded, passed, restored := false, false, false
	for tick := int64(1); tick <= 60; tick++ {
		courtesyAdvance(t, m, &s, tick)
		hero, friend := s.Actor("hero"), s.Actor("friend")
		if hero.Goal != goal || !hero.Manual || friend.Goal != origin || friend.Step != 0 || friend.Manual {
			t.Fatalf("accepted goal or NPC task lost at tick %d", tick)
		}
		if friend.YieldUntil > 0 {
			yielded = true
		}
		passed = passed || hero.Position == goal && hero.Arrived && len(hero.Path) == 0
		restored = restored || passed && friend.Position == origin && friend.Arrived && friend.Activity == "rest" && len(friend.Path) == 0
	}
	if !yielded || !passed || !restored {
		t.Fatalf("ordinary passage/task restoration incomplete: yielded=%v passed=%v restored=%v hero=%+v friend=%+v", yielded, passed, restored, s.Actor("hero"), s.Actor("friend"))
	}
}

func TestLifeCourtesyOnlyPositiveDirectedAttitudeGrantsStationaryPassage(t *testing.T) {
	for _, kind := range []string{"missing", "zero", "negative", "only_reverse", "negative_with_positive_reverse", "wrong_control", "missing_control"} {
		t.Run(kind, func(t *testing.T) {
			m, s := courtesyFixture()
			switch kind {
			case "missing", "only_reverse":
				m.Actors[1].Relations = nil
			case "zero":
				m.Actors[1].Relations[0].Strength = 0
			case "negative", "negative_with_positive_reverse":
				m.Actors[1].Relations[0].Strength = -.2
			case "wrong_control":
				s.ControlledActorID = "friend"
			case "missing_control":
				s.ControlledActorID = ""
			}
			if kind == "only_reverse" || kind == "negative_with_positive_reverse" {
				m.Actors[0].Relations = []LifeRelation{{To: "friend", Strength: 1}}
			}
			before := s.Clone()
			authorized := kind != "wrong_control" && kind != "missing_control"
			if path, ok := s.MoveRoute(m, "hero", "hall", Cell{1, 2}, Cell{5, 2}, 0); ok != authorized || (authorized && len(path) != 4) {
				t.Fatalf("intent used a private relation or an unauthorized route: %v", path)
			}
			if s.yieldPopulationFor(m, "hall", Cell{3, 2}, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) {
				t.Fatal("stationary nonfriend or unauthorized requester enlisted")
			}
			if !reflect.DeepEqual(before, s.Clone()) {
				t.Fatal("rejected courtesy changed state")
			}
		})
	}
}

