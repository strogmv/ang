// Code generated by ANG. Remembered testimony is separate from observed geography.
package poc

import (
 "fmt"
 "crypto/sha256"
 "encoding/binary"
 "encoding/hex"
 "sort"
 "angelsdemons/server/internal/behavior"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

type regionRumourImage struct{ID string `json:"id"`;ResourcePath string `json:"resource_path"`}
type regionRumour struct {
 ID string `json:"id"`
 SubjectID string `json:"subject_id"`
 NodeID string `json:"node_id"`
 SourceActorID string `json:"source_actor_id"`
 TextKey string `json:"text_key"`
 ContextKey string `json:"context_key"`
 ImageVariant string `json:"image_variant"`
}
type regionReportMemory struct {ID string `json:"id"`;HeardSecond int64 `json:"heard_second"`}
func(r *Runtime)regionRumourByID(id string)*regionRumour {for i:=range r.world.Region.Rumours{if r.world.Region.Rumours[i].ID==id{return &r.world.Region.Rumours[i]}};return nil}
func(r *Runtime)regionRumourVisited(q regionRumour)bool {
 hero:=r.state.Life.Actor(playerActorID);if hero==nil{return false}
 for _,n:=range r.world.Region.Nodes{if n.ID==q.NodeID{return n.LevelID!=""&&hero.Visits[n.LevelID]>0}};return false
}
// The client supplies an actor ID, never the private report or subject binding.
// A uniform refusal does not distinguish forged IDs from unseen/remote sources.
func(r *Runtime)regionRumourSourceAvailable(id string)bool {
 hero,source:=r.state.Life.Actor(playerActorID),r.state.Life.Actor(id)
 if hero==nil||source==nil||id==playerActorID||hero.Level!=source.Level||!hero.OnFloor()||!source.OnFloor()||hero.CombatHold||source.CombatHold||!r.barkCanSpeak(id)||!r.barkCanSpeak(playerActorID){return false}
 if behavior.Distance(hero.Position,source.Position)>2{return false}
 v:=r.lifeViewRuntime();return v!=nil&&v.sightWithin(location(hero.Position),location(source.Position),2)
}
func(r *Runtime)hearRegionRumour(sourceID string)error {
 var choice *regionRumour
 for i:=range r.world.Region.Rumours {q:=&r.world.Region.Rumours[i];if q.SourceActorID!=sourceID{continue};choice=q;heard:=false;for _,m:=range r.state.Region.Reports{if m.ID==q.ID{heard=true;break}};if !heard{break}}
 if choice==nil||!r.regionRumourSourceAvailable(sourceID){return textError{Key:"rumour.error.source_unavailable"}}
 for _,m:=range r.state.Region.Reports{if m.ID==choice.ID{return nil}}
 if !r.state.Region.Initialized{return fmt.Errorf("missing initialized region knowledge")}
 r.state.Region.Reports=append(r.state.Region.Reports,regionReportMemory{ID:choice.ID,HeardSecond:r.state.Life.Seconds})
 if r.state.Region.ActiveReports==nil{r.state.Region.ActiveReports=map[string]string{}}
 r.state.Region.ActiveReports[choice.SubjectID]=choice.ID
 return nil
}
func(r *Runtime)validateRegionRumours(s state)error {
 if len(s.Region.Reports)>len(r.world.Region.Rumours){return fmt.Errorf("too many remembered region reports")}
 heard:=map[string]bool{};latest:=map[string]string{};previous:=int64(-1)
 for _,m:=range s.Region.Reports{
  q:=r.regionRumourByID(m.ID);if q==nil||heard[m.ID]||m.HeardSecond<0||m.HeardSecond>s.Life.Seconds||m.HeardSecond<previous{return fmt.Errorf("invalid remembered region report")}
  heard[m.ID]=true;latest[q.SubjectID]=q.ID;previous=m.HeardSecond
 }
 if len(latest)!=len(s.Region.ActiveReports){return fmt.Errorf("invalid active region report count")}
 for subject,id:=range s.Region.ActiveReports{if latest[subject]!=id{return fmt.Errorf("invalid active region report")}}
 return nil
}
func(r *Runtime)regionRumourSourceName(locale,id string)string {
 fallback:=id;if a:=r.world.Life.Person(id);a!=nil{fallback=a.Name};return r.localText(locale,"actor."+id+".name",fallback)
}
// The signature contains only remembered cell indices and glyphs. Ticks, live
// geometry, people and every other private runtime detail are deliberately absent.
func regionObservationKey(nodeID string,memory map[int]seenCell)string {
 if nodeID==""||len(memory)==0{return ""}
 h:=sha256.New();h.Write([]byte("region-observation-v1\x00"));h.Write([]byte(nodeID));h.Write([]byte{0})
 keys:=make([]int,0,len(memory));for key:=range memory{keys=append(keys,key)};sort.Ints(keys)
 var b [8]byte
 for _,key:=range keys{glyph:=memory[key].Glyph;binary.BigEndian.PutUint64(b[:],uint64(key));h.Write(b[:]);binary.BigEndian.PutUint64(b[:],uint64(len(glyph)));h.Write(b[:]);h.Write([]byte(glyph))}
 return hex.EncodeToString(h.Sum(nil))
}
func(r *Runtime)regionObservedBinding(out *pb.PocRegionMap,q regionRumour,visited bool)(string,string){
 if !visited{return "",""}
 for _,node:=range out.Nodes {if node.Id!=q.NodeID||(node.Knowledge!="known"&&node.Knowledge!="visited")||node.LevelId==""{continue};key:=regionObservationKey(node.Id,r.state.LifeExploration[node.LevelId]);if key!=""{return node.Id,key}}
 return "",""
}
func(r *Runtime)appendRegionRumours(out *pb.PocRegionMap,locale string){
 sources:=map[string]bool{}
 for _,q:=range r.world.Region.Rumours {if !sources[q.SourceActorID]&&r.regionRumourSourceAvailable(q.SourceActorID){sources[q.SourceActorID]=true;out.RumourSources=append(out.RumourSources,&pb.PocRegionRumourSource{ActorId:q.SourceActorID,Name:r.regionRumourSourceName(locale,q.SourceActorID)})}}
 for _,m:=range r.state.Region.Reports{
  q:=r.regionRumourByID(m.ID);if q==nil{continue};visited:=r.regionRumourVisited(*q);observed,key:=r.regionObservedBinding(out,*q,visited)
  out.HeardRumours=append(out.HeardRumours,&pb.PocRegionRumour{Id:q.ID,SubjectId:q.SubjectID,SourceActorId:q.SourceActorID,SourceName:r.regionRumourSourceName(locale,q.SourceActorID),Text:r.localText(locale,q.TextKey,q.TextKey),Context:r.localText(locale,q.ContextKey,q.ContextKey),ImageVariant:q.ImageVariant,Active:!visited&&r.state.Region.ActiveReports[q.SubjectID]==q.ID,Visited:visited,ObservedNodeId:observed,ObservationKey:key})
 }
}
