func (pp *{{ .StructName }}) validateStatusHints(opKind, statusVal, detailsVal string) error {
	op, ok := operationTransports[opKind]
	if !ok {
		return nil
	}
	strategy := pp.operationStatusStrategy(op)
	switch strategy {
	case "macan":
		if op.StatusField != "" {
			want := op.StatusField
			if want != "payIn.status" && want != "payOut.status" {
				return fmt.Errorf("%s: unsupported status_field hint %q for %s (strategy=macan)", ppSID, want, opKind)
			}
		}
		if op.StatusDetailsField != "" {
			want := op.StatusDetailsField
			if want != "payIn.statusDetails" && want != "payOut.statusDetails" {
				return fmt.Errorf("%s: unsupported status_details_field hint %q for %s (strategy=macan)", ppSID, want, opKind)
			}
		}
	case "direct":
		if op.StatusField != "" && op.StatusField != "status" {
			return fmt.Errorf("%s: unsupported status_field hint %q for %s (strategy=direct)", ppSID, op.StatusField, opKind)
		}
		if op.StatusDetailsField != "" && op.StatusDetailsField != "status_details" && op.StatusDetailsField != "statusDetails" {
			return fmt.Errorf("%s: unsupported status_details_field hint %q for %s (strategy=direct)", ppSID, op.StatusDetailsField, opKind)
		}
	default:
		return fmt.Errorf("%s: unsupported status strategy %q for %s", ppSID, strategy, opKind)
	}
	if op.StatusField != "" && statusVal == "" {
		return fmt.Errorf("%s: empty status value for %s", ppSID, opKind)
	}
	_ = detailsVal // details may be legitimately empty for many statuses.
	return nil
}

