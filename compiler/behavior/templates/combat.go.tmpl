var ErrCombatExecutionBlocked = errors.New("combat shot blocked by a body during execution")

func (s CombatSpace) rangeMM(a, b Cell) int {
	if s.RangeMM != nil {
		v := s.RangeMM(a, b)
		if v < 0 || v > 1000000000 {
			return 1000000000
		}
		return v
	}
	return int(math.Round(math.Hypot(float64(a.X-b.X), float64(a.Y-b.Y)) * float64(s.CellMM)))
}
func (s CombatSpace) visible(a, b Cell, r CombatRules) bool {
	return s.rangeMM(a, b) <= r.SightRangeMM && s.Space.Visible != nil && s.Space.Visible(a, b)
}

// ActorVisible uses actual pose rays where available. The legacy standing-eye
// ray must not veto two prone bodies seeing below an overhead beam.
func (s CombatSpace) ActorVisible(observer, target Combatant, r CombatRules) bool {
	if s.rangeMM(observer.Position, target.Position) > r.SightRangeMM {
		return false
	}
	if s.Protection != nil {
		return s.protection(observer.Position, target.Position, observer, target, "") < 1
	}
	return s.Space.Visible != nil && s.Space.Visible(observer.Position, target.Position)
}
func (s CombatSpace) shotClear(a, b Cell) bool {
	if s.ShotClear != nil {
		return s.ShotClear(a, b)
	}
	return s.Space.Visible != nil && s.Space.Visible(a, b)
}
func (s CombatSpace) ballisticClear(from, to Cell, a, b Combatant, part string) bool {
	if s.PoseShotClear != nil {
		return s.PoseShotClear(from, to, a, b, part)
	}
	return s.shotClear(from, to)
}
func (s CombatSpace) cover(a, b Cell, crouched bool) float64 {
	c := 0.0
	if s.Cover != nil {
		c = s.Cover(a, b)
	}
	if math.IsNaN(c) || math.IsInf(c, 0) {
		return 1
	}
	c = math.Max(0, math.Min(1, c))
	if crouched && c > 0 {
		c = math.Min(1, c+(1-c)*.2)
	}
	return c
}
func (s CombatSpace) standable(at Cell) bool {
	return at.X >= 0 && at.Y >= 0 && at.X < s.Space.Width && at.Y < s.Space.Height && s.Space.Walkable != nil && s.Space.Walkable(at) && !s.Space.Blocked[at]
}
func (s CombatSpace) canCommunicate(a, b Combatant, r CombatRules) bool {
	if s.Communicate != nil {
		return s.Communicate(a, b)
	}
	return s.rangeMM(a.Position, b.Position) <= r.ShareRangeMM && s.visible(a.Position, b.Position, r)
}
func (r CombatRules) Validate() error {
 for _,t:=range r.Techniques{if t.AP<1||t.AP>r.APPerTurn||t.ReachMM<1||t.ReachMM>3000||t.BreakReachMM<0||t.BreakReachMM>5000||t.WeaponKind==""||t.BodyPart==""||t.FallStyle==""||math.IsNaN(t.Loudness)||t.Loudness<0||t.Loudness>1{return errors.New("invalid combat technique")}}
 if math.IsNaN(r.MeleeSkillScale)||math.IsInf(r.MeleeSkillScale,0)||r.MeleeSkillScale<0||r.MeleeSkillScale>2{return errors.New("invalid melee skill scale")}
 if r.CloseMM<0||r.CloseMM>3000||r.RetreatAP<0||r.RetreatAP>r.APPerTurn||r.GuardBonus<0||r.GuardBonus>80||r.RollAP<0||r.RollAP>r.APPerTurn||r.GetUpAP<0||r.GetUpAP>r.APPerTurn{return errors.New("invalid v4 combat costs")}
 for _,v:=range []float64{r.CrampedAccuracy,r.CrampedParry,r.UntrainedReactionAccuracy,r.RollAccuracy}{if math.IsNaN(v)||math.IsInf(v,0)||v<0||v>1{return errors.New("invalid v4 accuracy")}}
 for _,t:=range r.Targets{if t.Accuracy<=0||t.Accuracy>1||math.IsNaN(t.Accuracy)||t.ExtraAP<0||t.ExtraAP>r.APPerTurn||t.BladeValue<0||t.StopValue<0{return errors.New("invalid combat target")}}

	for _, n := range []int{r.EquipAP, r.GuardAP, r.ProneAP, r.BandageAP, r.ReactionAP} {
		if n < 0 || n > 100 {
			return errors.New("invalid tactical stance/aid/reaction cost")
		}
	}
	if r.BandageAmount < 0 || r.BandageAmount > 1000000 || r.MaxSuppression < 0 || r.MaxSuppression > 1000 || r.SuppressionPerAP < 0 || r.SuppressionPerAP > 1000 || r.SuppressionRecovery < 0 || r.SuppressionRecovery > 1000 || r.MoraleRecovery < 0 || r.MoraleRecovery > 100 {
		return errors.New("invalid tactical wound/suppression rule")
	}
	if math.IsNaN(r.SuppressionAccuracyPenalty) || math.IsInf(r.SuppressionAccuracyPenalty, 0) || r.SuppressionAccuracyPenalty < 0 || r.SuppressionAccuracyPenalty > 1 {
		return errors.New("invalid suppression accuracy rule")
	}
	if r.MaxSuppression > 0 && r.SuppressionPerAP < 1 {
		return errors.New("incomplete tactical aid/suppression rules")
	}

	if r.APPerTurn < 1 || r.APPerTurn > 100 || r.MoveAPPerMeter < 1 || r.MoveAPPerMeter > 100 || r.ReloadAP < 1 || r.ReloadAP > 100 || r.HealAP < 1 || r.HealAP > 100 || r.CrouchAP < 1 || r.CrouchAP > 100 || r.ReportAP < 1 || r.ReportAP > 100 || r.HealAmount > 1000000 || r.MemoryTurns < 1 || r.MemoryTurns > 1000 || r.SightRangeMM < 1 || r.SightRangeMM > 10000000 || r.HearingRangeMM < 1 || r.HearingRangeMM > 10000000 || r.ShareRangeMM < 1 || r.ShareRangeMM > 10000000 || r.MaxSearchCells < 1 || r.MaxSearchCells > 65536 || r.MaxActionsPerTurn < 1 || r.MaxActionsPerTurn > 256 || r.EstimatedDefense < 0 || r.EstimatedDefense > 100 {
		return errors.New("invalid tactical costs or budgets")
	}
	if math.IsNaN(r.MinHit) || math.IsNaN(r.MaxHit) || math.IsInf(r.MinHit, 0) || math.IsInf(r.MaxHit, 0) || r.MinHit < 0 || r.MaxHit > 1 || r.MinHit > r.MaxHit {
		return errors.New("invalid tactical hit limits")
	}
	if math.IsNaN(r.DamageMin) || math.IsNaN(r.DamageMax) || math.IsInf(r.DamageMin, 0) || math.IsInf(r.DamageMax, 0) || r.DamageMin <= 0 || r.DamageMax < r.DamageMin || r.DamageMax > 1000 {
		return errors.New("invalid tactical damage spread")
	}
	for _, v := range []float64{r.CoverWeight, r.AttackWeight, r.MoveWeight, r.HealWeight, r.RetreatWeight} {
		if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1000 {
			return errors.New("invalid tactical weight")
		}
	}
	return nil
}
func NewCombat(id, level string, seed int64, actors []Combatant, r CombatRules, space CombatSpace) (CombatState, error) {
	s := CombatState{ID: id, LevelID: level, Seed: seed, Turn: 1, Active: true, Actors: append([]Combatant(nil), actors...)}
	for i := range s.Actors {
		s.Actors[i].AP = r.APPerTurn
		s.Actors[i].Guarding = false
		s.Actors[i].Overwatch = false
		s.Actors[i].ReservedAP = 0
		if s.Actors[i].WeaponUsesRemaining > 0 {
			s.Actors[i].WeaponUsesLimited = true
		}
		if !s.Actors[i].TacticalInitialized {
			s.Actors[i].Morale = s.Actors[i].Courage
			s.Actors[i].TacticalInitialized = true
		}
		s.Actors[i].Contacts = nil
	}
	sort.SliceStable(s.Actors, func(i, j int) bool {
		a, b := s.Actors[i], s.Actors[j]
		if a.Initiative != b.Initiative {
			return a.Initiative > b.Initiative
		}
		return a.ID < b.ID
	})
	if err := s.Validate(r, space); err != nil {
		return CombatState{}, err
	}
	teams := map[string]bool{}
	for _, a := range s.Actors {
		if a.Able() {
			teams[a.Team] = true
		}
	}
	if len(teams) < 2 {
		return CombatState{}, errors.New("combat needs opposing able teams")
	}
	if !s.beginTurn(r, space) && s.Active {
		s.nextTurn(r, space)
	}
	s.Observe(space, r)
	return s, nil
}
func (s *CombatState) Actor(id string) *Combatant {
	for i := range s.Actors {
		if s.Actors[i].ID == id {
			return &s.Actors[i]
		}
	}
	return nil
}
func (s *CombatState) Current() *Combatant {
	if !s.Active || s.CurrentIndex < 0 || s.CurrentIndex >= len(s.Actors) {
		return nil
	}
	return &s.Actors[s.CurrentIndex]
}
func (s CombatState) Clone() CombatState {
	s.Actors = append([]Combatant(nil), s.Actors...)
	for i := range s.Actors {
		if s.Actors[i].Aid!=nil{a:=*s.Actors[i].Aid;s.Actors[i].Aid=&a}
		s.Actors[i].Body = append(json.RawMessage(nil), s.Actors[i].Body...)
		s.Actors[i].BodyEffects=append([]string(nil),s.Actors[i].BodyEffects...)
		s.Actors[i].Contacts = append([]CombatContact(nil), s.Actors[i].Contacts...)
		s.Actors[i].Explosives = append([]CombatExplosiveStock(nil), s.Actors[i].Explosives...)
	}
	s.Events = append([]CombatEvent(nil), s.Events...)
	return s
}

// Validate checks an actor's durable resources/physiology independently of
// any current location, turn cursor or historical contact positions.
func (a Combatant) Validate(r CombatRules) error {
	if err := r.Validate(); err != nil {
		return err
	}
	if err := validateCombatantTactics(a, r); err != nil {
		return err
	}
	if err := validateExplosiveStock(a); err != nil {
		return err
	}
	if len(a.ID) > 256 || len(a.Team) > 256 || len(a.Weapon.ID) > 256 || a.MaxHP > 1000000 || a.Armor > 1000000 || a.Ammo > 1000000 || a.ReserveAmmo > 1000000 || a.Medkits > 10000 || a.Weapon.Damage > 1000000 || a.Weapon.RangeMM > 10000000 || a.Weapon.Magazine > 1000000 || a.Weapon.AttackAP > 100 || a.Initiative < -1000000 || a.Initiative > 1000000 {
		return errors.New("combatant stat bounds exceeded")
	}
	if a.ID == "" || a.Team == "" || a.MaxHP < 1 || a.HP < 0 || a.HP > a.MaxHP || a.AP < 0 || a.AP > r.APPerTurn || a.Armor < 0 || a.Skill < 0 || a.Skill > 100 || a.Courage < 0 || a.Courage > 100 || a.Ammo < 0 || a.Ammo > a.Weapon.Magazine || a.ReserveAmmo < 0 || a.Medkits < 0 || a.Weapon.Damage < 0 || a.Weapon.RangeMM < 0 || a.Weapon.AttackAP < 0 || a.Weapon.Magazine < 0 {
		return fmt.Errorf("invalid combatant %s", a.ID)
	}
	if a.Weapon.Damage > 0 && (a.Weapon.RangeMM < 1 || a.Weapon.AttackAP < 1) {
		return fmt.Errorf("invalid combat weapon %s", a.ID)
	}
	if len(a.Contacts) > 512 {
		return errors.New("combat contact capacity exceeded")
	}
	return nil
}
func (s CombatState) Validate(r CombatRules, space CombatSpace) error {
	if err := r.Validate(); err != nil {
		return err
	}
	if s.ID == "" || len(s.ID) > 256 || s.LevelID == "" || len(s.LevelID) > 256 || s.Turn < 1 || s.Turn > 1<<50 || s.ActionSeq > 1<<60 || s.EventSeq > 1<<60 || len(s.Actors) < 2 || len(s.Actors) > 256 || s.CurrentIndex < 0 || s.CurrentIndex >= len(s.Actors) || space.CellMM < 1 || space.CellMM > 100000 || space.Space.Width < 1 || space.Space.Width > 1<<20 || space.Space.Height < 1 || space.Space.Height > 1<<20 || int64(space.Space.Width)*int64(space.Space.Height) > 1<<22 {
		return errors.New("invalid combat identity or topology")
	}
	ids := map[string]bool{}
	cells := map[Cell]bool{}
	for _, a := range s.Actors {
		if err := a.Validate(r); err != nil {
			return err
		}
		if ids[a.ID] {
			return fmt.Errorf("duplicate combatant %s", a.ID)
		}
		if !space.standable(a.Position) || cells[a.Position] {
			return fmt.Errorf("invalid combat position %s", a.ID)
		}
		cells[a.Position] = true
		ids[a.ID] = true
		if len(a.Contacts) > 512 {
			return errors.New("combat contact capacity exceeded")
		}
		seen := map[string]bool{}
		for _, c := range a.Contacts {
			if c.SubjectID == "" || len(c.SubjectID) > 256 || seen[c.SubjectID] || c.ObservedTurn < 1 || c.ObservedTurn > s.Turn || c.ReceivedTurn < c.ObservedTurn || c.ReceivedTurn > s.Turn || c.ObservedAction > s.ActionSeq || c.CheckedTurn < 0 || c.CheckedTurn > s.Turn || c.CheckedAction > s.ActionSeq || c.Radius < 0 || c.Radius > 1000000 || c.ThreatDamage < 0 || c.ThreatDamage > 1000000 || c.ThreatRangeMM < 0 || c.ThreatRangeMM > 10000000 || c.Position.X < 0 || c.Position.X >= space.Space.Width || c.Position.Y < 0 || c.Position.Y >= space.Space.Height {
				return errors.New("invalid combat contact")
			}
			seen[c.SubjectID] = true
		}
	}
	if s.Active && !s.Actors[s.CurrentIndex].Able() {
		return errors.New("incapable current combat actor")
	}
	if len(s.Events) > 512 {
		return errors.New("combat event capacity exceeded")
	}
	previousEvent := uint64(0)
	for _, e := range s.Events {
		if e.Sequence == 0 || e.Sequence <= previousEvent || e.Sequence > s.EventSeq || e.Turn > s.Turn || e.Turn < 1 || e.AmmoSpent < 0 || e.MedkitsSpent < 0 || e.WeaponUses < 0 || e.ItemsSpent < 0 || e.AmmoSpent > 1000000 || e.MedkitsSpent > 10000 || e.WeaponUses > 1000000 || e.ItemsSpent > 10000 || e.ArmorBlocked < 0 || e.ArmorBlocked > 2000000 {
			return errors.New("invalid combat event clock/resource")
		}
		previousEvent = e.Sequence
	}
	if len(s.Events) > 0 && previousEvent != s.EventSeq || len(s.Events) == 0 && s.EventSeq != 0 {
		return errors.New("combat event cursor does not match durable tail")
	}
	return nil
}

func combatContact(a *Combatant, id string) *CombatContact {
	for i := range a.Contacts {
		if a.Contacts[i].SubjectID == id {
			return &a.Contacts[i]
		}
	}
	return nil
}
func combatContactNewer(c CombatContact, old *CombatContact) bool {
	if old == nil {
		return true
	}
	if c.ObservedTurn != old.ObservedTurn {
		return c.ObservedTurn > old.ObservedTurn
	}
	if c.ObservedAction != old.ObservedAction {
		return c.ObservedAction > old.ObservedAction
	}
	return c.Checked && (!old.Checked || c.CheckedTurn > old.CheckedTurn || c.CheckedAction > old.CheckedAction)
}

// A fresh personal LOS sample is not necessarily a new message for a teammate.
// Keep observation freshness/provenance intact; only report usefulness is
// deduplicated within one turn. A changed position/verdict or a later observed
// turn remains useful, including negative evidence relayed by another actor.
func combatReportUseful(c CombatContact, old *CombatContact) bool {
	if !combatContactNewer(c, old) {
		return false
	}
	return old == nil || c.ObservedTurn > old.ObservedTurn || c.Position != old.Position || c.Radius != old.Radius || c.Team != old.Team || c.ThreatDamage != old.ThreatDamage || c.ThreatRangeMM != old.ThreatRangeMM || c.Checked != old.Checked
}

func (s *CombatState) remember(a *Combatant, c CombatContact) {
	if old := combatContact(a, c.SubjectID); old != nil {
		if c.ObservedTurn < old.ObservedTurn || (c.ObservedTurn == old.ObservedTurn && c.ObservedAction < old.ObservedAction) {
			return
		}
		if c.Source != "sight" && old.Visible {
			return
		}
		if c.Source != "sight" && !combatContactNewer(c, old) {
			return
		}
		*old = c
		return
	}
	if len(a.Contacts) < 512 {
		a.Contacts = append(a.Contacts, c)
	}
	sort.Slice(a.Contacts, func(i, j int) bool { return a.Contacts[i].SubjectID < a.Contacts[j].SubjectID })
}

func combatAreaConfirmedEmpty(space CombatSpace, r CombatRules, observer Combatant, c CombatContact) bool {
	checked := 0
	for y := max(0, c.Position.Y-c.Radius); y <= min(space.Space.Height-1, c.Position.Y+c.Radius); y++ {
		for x := max(0, c.Position.X-c.Radius); x <= min(space.Space.Width-1, c.Position.X+c.Radius); x++ {
			at := Cell{x, y}
			if !space.standable(at) {
				continue
			}
			checked++
			if checked > r.MaxSearchCells {
				return false
			}
			if !space.ActorVisible(observer, Combatant{Position: at, Prone: true, HP: 1}, r) {
				return false
			}
		}
	}
	return checked > 0
}

// Observe never copies unseen current coordinates into a contact. Empty last
// known locations can be checked, but do not reveal where a subject moved.
func (s *CombatState) Observe(space CombatSpace, r CombatRules) {
	for i := range s.Actors {
		a := &s.Actors[i]
		kept := a.Contacts[:0]
		for _, c := range a.Contacts {
			if s.Turn-c.ObservedTurn <= r.MemoryTurns {
				c.Visible = false
				kept = append(kept, c)
			}
		}
		a.Contacts = kept
		if !a.Able() {
			continue
		}
		for _, other := range s.Actors {
			if a.ID == other.ID || a.Team == other.Team || !space.ActorVisible(*a, other, r) {
				continue
			}
			c := CombatContact{SubjectID: other.ID, Team: other.Team, Position: other.Position, ObservedTurn: s.Turn, ObservedAction: s.ActionSeq, ReceivedTurn: s.Turn, Source: "sight", SourceID: a.ID, Visible: true, ThreatDamage: other.WeaponRisk(), ThreatRangeMM: other.Weapon.RangeMM}
			if !other.Able() {
				c.Checked = true
				c.CheckedTurn, c.CheckedAction = s.Turn, s.ActionSeq
			}
			s.remember(a, c)
		}
		for j := range a.Contacts {
			c := &a.Contacts[j]
			if !c.Visible && !c.Checked && combatAreaConfirmedEmpty(space, r, *a, *c) {
				c.Checked = true
				c.CheckedTurn, c.CheckedAction = s.Turn, s.ActionSeq
			}
		}
	}
}
func (s *CombatState) event(e CombatEvent) {
	e.Turn = s.Turn
	s.EventSeq++
	e.Sequence = s.EventSeq
	s.Events = append(s.Events, e)
	if len(s.Events) > 512 {
		s.Events = append([]CombatEvent(nil), s.Events[len(s.Events)-512:]...)
	}
}
func (s *CombatState) finishIfResolved() {
	teams := map[string]bool{}
	for _, a := range s.Actors {
		if a.Able() {
			teams[a.Team] = true
		}
	}
	if len(teams) > 1 {
		return
	}
	s.Active = false
	s.Winner = "draw"
	for team := range teams {
		s.Winner = team
	}
}

// ResolveCasualties reconciles a host-applied injury with initiative, without
// replaying an action or opening another reaction window.
func (s *CombatState) ResolveCasualties(r CombatRules, spaces ...CombatSpace) {
 var space CombatSpace;if len(spaces)>0{space=spaces[0]}
 if s.ID==""{return}
 s.finishIfResolved()
 if a:=s.Current();a!=nil&&(!a.Able()||a.StunTurns>0){s.nextTurn(r, space)}
}

// Passive losses occur once at the beginning of that actor's own turn. They
// produce durable events, so a reload cannot erase bleeding or suppression.
func (s *CombatState) beginTurn(r CombatRules, space CombatSpace) bool {
	a := &s.Actors[s.CurrentIndex]
	a.Overwatch = false
	a.Guarding = false
	a.ReservedAP = 0
	if !a.Able() {
		return false
	}
	if a.StunTurns > 0 {
		a.AP = 0
		s.event(CombatEvent{Type: "stunned", ActorID: a.ID, TargetID: a.ID, From: a.Position, To: a.Position, Amount: 1, Reason: "recovering from a concussive blow"})
		return false
	}
	penalty := 0
	if r.SuppressionPerAP > 0 {
		penalty = a.Suppression / r.SuppressionPerAP
	}
	penalty+=a.BodyAPPenalty
	a.AP = max(1, r.APPerTurn-penalty)
	a.Suppression = max(0, a.Suppression-r.SuppressionRecovery)
	a.Morale = min(100, a.Morale+r.MoraleRecovery)
	return true
}
func (s *CombatState) nextTurn(r CombatRules, space CombatSpace) {
 if space.AdvanceTime!=nil {
  seconds:=r.TurnSeconds;if seconds<1{seconds=6}
  space.AdvanceTime(s,int64(max(0,seconds-s.TurnSpentS)))
 }
 s.TurnSpentS=0
	s.finishIfResolved()
	if !s.Active {
		return
	}
	// StunTurns is bounded by ten, so even a whole stunned team cannot turn
	// this loop into an unbounded wait or be incorrectly declared a draw.
	for n := 0; n < len(s.Actors)*11; n++ {
		s.CurrentIndex = (s.CurrentIndex + 1) % len(s.Actors)
		if !s.Actors[s.CurrentIndex].Able() {
			continue
		}
		s.Turn++
		if s.beginTurn(r, space) {
			return
		}
		if !s.Active {return}
  if space.AdvanceTime!=nil{seconds:=r.TurnSeconds;if seconds<1{seconds=6};space.AdvanceTime(s,int64(seconds));s.finishIfResolved();if !s.Active{return}}
 }
 s.Active=false;s.Winner="draw"
}
func (s CombatState) occupied(at Cell, except string, space CombatSpace, r CombatRules, observer Cell, knownOnly bool) bool {
	looker := s.Actor(except)
	view := Combatant{Position: observer, HP: 1}
	if looker != nil {
		view = *looker
		view.Position = observer
	}
	for _, a := range s.Actors {
		if a.ID != except && (a.Position == at || space.BodyBlocks!=nil&&space.BodyBlocks(view,a,at)) && (!knownOnly || space.ActorVisible(view, a, r)) {
			return true
		}
	}
	return false
}

// crowded: a destination closer than the host's body spacing to a standing participant
// (in planning only to one the mover sees, like occupancy).
func (s CombatState) crowded(space CombatSpace, r CombatRules, a Combatant, at Cell, planning bool) bool {
	if space.EndSpacingMM == nil {
		return false
	}
	for _, b := range s.Actors {
		if b.ID == a.ID || b.HP <= 0 || planning && !space.ActorVisible(a, b, r) {
			continue
		}
		if space.rangeMM(at, b.Position) < space.EndSpacingMM(a, b) {
			return true
		}
	}
	return false
}

type combatReach struct {
	At     Cell
	MM, AP int
	Path   []Cell
}

func combatMovementScale(a Combatant) int {
	scale := 100 + a.LegWound
 if len(a.Body)>0{scale=max(100,a.BodyMoveScale)}
	if a.Prone {
		scale *= 2
	}
	return scale
}
func combatMoveUnitsAP(units int64, r CombatRules) int {
	return int((units*int64(r.MoveAPPerMeter) + 99999) / 100000)
}
func combatActorMoveAP(mm int, r CombatRules, a Combatant) int {
	return combatMoveUnitsAP(int64(mm)*int64(combatMovementScale(a)), r)
}

// Bounded Dijkstra is shared by preview and execution. Links use the same host
// metric as ordinary steps; the host supplies physical distances on stairs.
func (s CombatState) reachable(space CombatSpace, r CombatRules, a Combatant, maxAP int, planning bool) ([]combatReach, bool) {
 if len(a.Body)>0&&!a.BodyCanWalk{return []combatReach{{At:a.Position}},false}
	type node struct {
		at Cell
		mm int
	}
	open := []node{{a.Position, 0}}
	best := map[Cell]int{a.Position: 0}
	prev := map[Cell]Cell{}
	closed := map[Cell]bool{}
	var results []combatReach
	for len(open) > 0 && len(results) < r.MaxSearchCells {
		pick := 0
		for i := 1; i < len(open); i++ {
			if open[i].mm < open[pick].mm || (open[i].mm == open[pick].mm && (open[i].at.Y < open[pick].at.Y || open[i].at.Y == open[pick].at.Y && open[i].at.X < open[pick].at.X)) {
				pick = i
			}
		}
		n := open[pick]
		open = append(open[:pick], open[pick+1:]...)
		if closed[n.at] || best[n.at] != n.mm {
			continue
		}
		closed[n.at] = true
		var path []Cell
		for at := n.at; at != a.Position; at = prev[at] {
			path = append(path, at)
		}
		for i, j := 0, len(path)-1; i < j; i, j = i+1, j-1 {
			path[i], path[j] = path[j], path[i]
		}
		if n.at == a.Position || !s.crowded(space, r, a, n.at, planning) && (space.EndPositionClear==nil||space.EndPositionClear(a,n.at)) {
			results = append(results, combatReach{n.at, n.mm, combatActorMoveAP(n.mm, r, a)+s.retreatCost(space,r,a,n.at), path})
		}
		neighbors := []Cell{{n.at.X + 1, n.at.Y}, {n.at.X, n.at.Y + 1}, {n.at.X - 1, n.at.Y}, {n.at.X, n.at.Y - 1}}
		neighbors = append(neighbors, space.Space.Links[n.at]...)
		for _, to := range neighbors {
			if !space.standable(to) || s.occupied(to, a.ID, space, r, a.Position, planning) || (space.Space.Occupied != nil && (!planning || space.visible(a.Position, to, r)) && space.Space.Occupied(to)) || to == a.Position {
				continue
			}
			if n.at == a.Position && space.Space.FirstStepAllowed != nil && !space.Space.FirstStepAllowed(to) {
				continue
			}
			cost := space.rangeMM(n.at, to)
			if cost < 1 {
				continue
			}
			mm := n.mm + cost
			if combatActorMoveAP(mm, r, a)+s.retreatCost(space,r,a,to) > maxAP {
				continue
			}
			if old, ok := best[to]; ok && old <= mm {
				continue
			}
			best[to] = mm
			prev[to] = n.at
			open = append(open, node{to, mm})
		}
	}
	return results, len(open) > 0
}
func (s CombatState) movement(space CombatSpace, r CombatRules, a Combatant, to Cell) (combatReach, error) {
 if len(a.Body)>0&&!a.BodyCanWalk{return combatReach{},errors.New("wounds: cannot walk")}
	if to == a.Position {
		return combatReach{}, errors.New("already at combat destination")
	}
	options, truncated := s.reachable(space, r, a, a.AP, false)
	for _, p := range options {
		if p.At == to {
			return p, nil
		}
	}
	if truncated {
		return combatReach{}, errors.New("combat route calculation budget exhausted")
	}
	return combatReach{}, errors.New("combat destination blocked or exceeds AP")
}
func combatOnSegment(p, a, b Cell) bool {
	// A conservative capsule around the actual cell-centre shot segment.
	x, y := float64(p.X-a.X), float64(p.Y-a.Y)
	dx, dy := float64(b.X-a.X), float64(b.Y-a.Y)
	length := dx*dx + dy*dy
	if length == 0 {
		return false
	}
	t := (x*dx + y*dy) / length
	return t > 0 && t < 1 && math.Hypot(x-t*dx, y-t*dy) < .45
}
func CombatWeaponKind(w CombatWeapon) string { return combatWeaponKind(w) }
func combatWeaponKind(w CombatWeapon) string {
	if w.Kind != "" {
		return w.Kind
	}
	if w.Magazine > 0 {
		return "firearm"
	}
	return "blunt"
}
func validateCombatantTactics(a Combatant, r CombatRules) error {
	for _, n := range []int{a.BodyArmor.Head, a.BodyArmor.Torso, a.BodyArmor.Arms, a.BodyArmor.Legs} {
		if n < 0 || n > 1000000 {
			return errors.New("invalid physical body armour")
		}
	}

	w := a.Weapon
	if w.Kind != "" && w.Kind != "blunt" && w.Kind != "blade" && w.Kind != "firearm" {
		return errors.New("unknown combat weapon kind")
	}
	for _, n := range []int{w.AimAP, w.BurstAP, w.QuickAP, w.HeavyAP} {
		if n < 0 || n > 100 {
			return errors.New("invalid weapon mode cost")
		}
	}
	if len(w.AmmoDefinition) > 256 || w.AimBonus < 0 || w.AimBonus > 100 || w.BurstSize < 0 || w.BurstSize > 10 || w.BurstSize == 1 || w.BurstPenalty < 0 || w.BurstPenalty > 100 || w.ParryPercent < 0 || w.ParryPercent > 90 || w.QuickDamagePercent < 0 || w.QuickDamagePercent > 300 || w.HeavyDamagePercent < 0 || w.HeavyDamagePercent > 300 || w.Suppression < 0 || w.Suppression > 1000 || w.Bleed < 0 || w.Bleed > 1000000 {
		return errors.New("invalid weapon mode parameters")
	}
	if w.AimAP > 0 && w.AimBonus == 0 {
		return errors.New("incomplete weapon mode")
	}
	if combatWeaponKind(w) == "firearm" && w.Magazine < 1 || combatWeaponKind(w) != "firearm" && w.Magazine > 0 {
		return errors.New("weapon kind and ammunition disagree")
	}
	if a.Bleeding < 0 || a.Bleeding > a.MaxHP || a.Suppression < 0 || a.Suppression > r.MaxSuppression || a.Morale < 0 || a.Morale > 100 || a.ReservedAP < 0 || a.ReservedAP > r.APPerTurn || a.HeadWound < 0 || a.HeadWound > 100 || a.ArmWound < 0 || a.ArmWound > 100 || a.LegWound < 0 || a.LegWound > 100 || a.StunTurns < 0 || a.StunTurns > 10 || a.WeaponUsesRemaining < 0 || a.WeaponUsesRemaining > 1000000 || a.Prone && a.Crouched {
		return errors.New("invalid tactical injury/pose/reserve")
	}
	if !r.AutomaticReserve && !a.Overwatch && !a.Guarding && a.ReservedAP != 0 || a.Overwatch && a.Guarding || a.Overwatch && combatWeaponKind(w) != "firearm" || a.Guarding && combatWeaponKind(w) == "firearm" || (a.Overwatch || a.Guarding) && (a.ReservedAP == 0 || a.WeaponUsesLimited && a.WeaponUsesRemaining == 0) {
		return errors.New("invalid reaction reserve")
	}
	return nil
}

type combatShotSpec struct {
	Mode, BodyPart                  string
	Aim, Shots, Cost, DamagePercent int
	// The blade is already at the neck of a target who does not know: no dodge roll, no parry.
	Held bool
}

func combatShot(a Combatant, action CombatAction, r CombatRules) (combatShotSpec, error) {
	q := combatShotSpec{Mode: action.Mode, BodyPart: action.BodyPart, Aim: action.Aim, Shots: 1, Cost: a.Weapon.AttackAP, DamagePercent: 100}
	if q.Mode == "" {
		q.Mode = "single"
	}
	if q.BodyPart == "" {
		q.BodyPart = "torso"
	}
	if _,ok:=r.Targets[q.BodyPart]; !ok && q.BodyPart != "torso" && q.BodyPart != "head" && q.BodyPart != "arms" && q.BodyPart != "legs" {
		return q, errors.New("unknown attack body part")
	}
	if q.Aim < 0 || q.Aim > 3 || q.Mode != "aimed" && q.Aim != 0 {
		return q, errors.New("invalid aiming level")
	}
	kind := combatWeaponKind(a.Weapon)
	switch q.Mode {
	case "single":
	case "stun_blow":
 if kind!="blunt"||a.Weapon.ID=="unarmed"{return q,errors.New("stun blow needs a blunt weapon")};q.Cost=max(3,a.Weapon.HeavyAP);q.BodyPart="head"
 case "chokehold":
 if a.Weapon.ID!="unarmed"{return q,errors.New("choke needs free hands")};q.Cost=6;q.BodyPart="head"
 case "quick":
		if kind == "firearm" || a.Weapon.QuickAP < 1 {
			return q, errors.New("quick strike unavailable")
		}
		q.Cost = a.Weapon.QuickAP
		q.DamagePercent = a.Weapon.QuickDamagePercent;if q.DamagePercent==0{q.DamagePercent=100}
	case "heavy":
		if kind == "firearm" || a.Weapon.HeavyAP < 1 {
			return q, errors.New("heavy strike unavailable")
		}
		q.Cost = a.Weapon.HeavyAP
		q.DamagePercent = a.Weapon.HeavyDamagePercent;if q.DamagePercent==0{q.DamagePercent=100}
	case "aimed":
		if kind != "firearm" || a.Weapon.AimAP < 1 || q.Aim < 1 {
			return q, errors.New("aimed shot unavailable")
		}
		q.Cost += q.Aim * a.Weapon.AimAP
	case "burst":
		if kind != "firearm" || a.Weapon.BurstSize < 2 {
			return q, errors.New("burst unavailable")
		}
		q.Shots = a.Weapon.BurstSize
		q.Cost += a.Weapon.BurstAP
	default:
		t,ok:=r.Techniques[q.Mode];if !ok{return q, errors.New("unknown attack mode")}
		if kind!=t.WeaponKind{return q,errors.New("technique needs another weapon")}
		q.Cost=t.AP;q.BodyPart=t.BodyPart;q.Held=true
	}
	if a.WeaponUsesLimited && a.WeaponUsesRemaining < q.Shots {
		return q, errors.New("weapon condition insufficient for attack")
	}
	if kind == "firearm" && a.Ammo < q.Shots {
		return q, errors.New("attack ammunition insufficient")
	}
	if target,ok:=r.Targets[q.BodyPart];ok&&q.Mode!="chokehold"&&q.Mode!="stun_blow"&&!q.Held {q.Cost+=target.ExtraAP}
 return q, nil
}
func (s CombatSpace) protection(from, to Cell, a, b Combatant, part string) float64 {
	if s.Protection != nil {
		v := s.Protection(from, to, a, b, part)
		if math.IsNaN(v) || math.IsInf(v, 0) {
			return 1
		}
		return math.Max(0, math.Min(1, v))
	}
	c := s.cover(from, to, b.Crouched)
	if b.Prone && c > 0 {
		c = math.Min(1, c+(1-c)*.4)
	}
	return c
}
func (s CombatState) friendlyFire(space CombatSpace, r CombatRules, from Cell, a, target Combatant, planning bool, part string) bool {
	for _, b := range s.Actors {
		if planning && !space.ActorVisible(a, b, r) {
			continue
		}
		contains := combatOnSegment(b.Position, from, target.Position)
		if space.BodyOnShot != nil {
			contains = space.BodyOnShot(from, target.Position, b.Position)
		}
		if space.BodyIntersects != nil {
			contains = space.BodyIntersects(from, target.Position, a, target, b, part)
		}
		if b.ID != a.ID && b.ID != target.ID && b.Team == a.Team && b.HP > 0 && contains {
			return true
		}
	}
	return false
}
func (s CombatState) shotChance(space CombatSpace, r CombatRules, a, b Combatant, from Cell, q combatShotSpec, round int) float64 {
	distance := space.rangeMM(from, b.Position)
	falloff := 1 - .5*float64(distance)/float64(a.Weapon.RangeMM)
 if combatWeaponKind(a.Weapon)!="firearm"&&r.MeleeSkillScale>0{falloff=r.MeleeSkillScale}
	if b.RollingUntilTurn>=s.Turn&&b.RollingUntilTurn>0{falloff*=r.RollAccuracy}
 chance := float64(a.Skill) / float64(a.Skill+b.Skill+1) * falloff * (1 - space.protection(from, b.Position, a, b, r.PhysicalPart(q.BodyPart)))
	if a.Crouched {
		chance *= 1.08
	}
	if a.Prone && combatWeaponKind(a.Weapon) == "firearm" {
		chance *= 1.15
	}
	if b.Prone && space.Protection == nil && distance > 1500 {
		chance *= .75
	}
	if a.Guarding {
		chance *= .95
	}
	chance *= math.Max(.2, 1-float64(a.ArmWound)*.004-float64(a.HeadWound)*.002)
	if r.MaxSuppression > 0 {
		chance *= math.Max(.2, 1-float64(a.Suppression)*r.SuppressionAccuracyPenalty)
		chance *= .6 + .4*float64(a.Morale)/100
	}
 if t,ok:=r.Targets[q.BodyPart];ok {chance*=t.Accuracy} else {
 switch q.BodyPart {case "head":chance*=.55;case "arms":chance*=.75;case "legs":chance*=.8}
 }
 if r.CloseMM>0 && a.Weapon.RangeMM>r.CloseMM && combatWeaponKind(a.Weapon)!="firearm" && distance<=r.CloseMM {chance*=r.CrampedAccuracy}
	if q.Mode == "aimed" {
		chance += float64(q.Aim*a.Weapon.AimBonus) / 100
	}
	if q.Mode == "burst" {
		chance -= float64(round*a.Weapon.BurstPenalty) / 100
	}
	if q.Mode == "quick" {
		chance *= 1.08
	}
	if q.Mode == "heavy" {
		chance *= .85
	}
	return math.Max(r.MinHit, math.Min(r.MaxHit, chance))
}
func (s CombatState) hitChance(space CombatSpace, r CombatRules, a, b Combatant, from Cell) float64 {
	return s.shotChance(space, r, a, b, from, combatShotSpec{Mode: "single", BodyPart: "torso", Shots: 1, DamagePercent: 100}, 0)
}
func (s CombatState) canAttackAction(space CombatSpace, r CombatRules, a, b Combatant, from Cell, ap int, planning bool, action CombatAction) (combatShotSpec, bool) {
	if combatWeaponKind(a.Weapon)=="firearm"&&space.CanUseWeapon!=nil&&!space.CanUseWeapon(a){return combatShotSpec{},false}
	q, err := combatShot(a, action, r)
 if r.CloseMM>0&&q.Mode=="heavy"&&a.Weapon.RangeMM>r.CloseMM&&combatWeaponKind(a.Weapon)!="firearm"&&space.rangeMM(from,b.Position)<=r.CloseMM{return q,false}
	if err != nil {
		return q, false
	}
	c := combatContact(&a, b.ID)
	observer := a
	observer.Position = from
	reach:=a.Weapon.RangeMM;if q.Held{reach=r.Techniques[q.Mode].ReachMM}
	valid := (!q.Held||action.Unnoticed) && ((q.Mode!="stun_blow"&&q.Mode!="chokehold"&&!q.Held)||space.AttackAngle!=nil&&space.AttackAngle(a,b)=="rear") && (len(a.Body)==0||a.BodyCanHold) && !a.Noncombatant && a.Able() && a.StunTurns == 0 && (b.Able() || action.Type=="assault"&&b.HP>0&&!b.Withdrawn&&!b.Prone) && a.Team != b.Team && a.Weapon.Damage > 0 && ap >= q.Cost && c != nil && c.Visible && space.ActorVisible(observer, b, r) && space.rangeMM(from, b.Position) <= reach && space.protection(from, b.Position, a, b, r.PhysicalPart(q.BodyPart)) < 1 && space.ballisticClear(from, b.Position, observer, b, r.PhysicalPart(q.BodyPart)) && !s.friendlyFire(space, r, from, a, b, planning, r.PhysicalPart(q.BodyPart))
	return q, valid
}
func (s CombatState) canAttack(space CombatSpace, r CombatRules, a, b Combatant, from Cell, ap int, planning bool) bool {
	_, ok := s.canAttackAction(space, r, a, b, from, ap, planning, CombatAction{Type: "attack"})
	return ok
}

// ApplyDamage applies one resolved physical impact. It never draws random
// numbers or creates observations; callers emit their own accepted outcome.
func (s *CombatState) ApplyDamage(space CombatSpace, r CombatRules, sourceID, targetID string, rawDamage, bleed, suppression int, bodyPart string, modes ...string) int {
	b := s.Actor(targetID)
	if b == nil || b.HP <= 0 {
		return 0
	}
	if source:=s.Actor(sourceID);source!=nil&&rawDamage>0{b.LastHitFrom=source.Position}
 physicalPart:=bodyPart;if t,ok:=r.Targets[bodyPart];ok{physicalPart=t.Part}
 blocked := CombatArmorBlocked(*b, rawDamage, physicalPart)
	// The host previews the same finite physical wear on a private inventory.
	// A later projectile sees reduced protection, while no planning path invokes
	// this hook and the real transaction is committed only by the host.
	if blocked > 0 && space.ArmorAfterDamage != nil {
		b.BodyArmor = space.ArmorAfterDamage(*b, blocked, physicalPart)
	}
	oldPenalty := 0
	if r.SuppressionPerAP > 0 {
		oldPenalty = b.Suppression / r.SuppressionPerAP
	}
	b.Suppression = min(r.MaxSuppression, b.Suppression+max(0, suppression))
	newPenalty := 0
	if r.SuppressionPerAP > 0 {
		newPenalty = b.Suppression / r.SuppressionPerAP
	}
	b.AP = max(0, b.AP-max(0, newPenalty-oldPenalty))
	b.ReservedAP = max(0, b.ReservedAP-max(0, newPenalty-oldPenalty))
	if b.ReservedAP == 0 {
		b.Overwatch = false
		b.Guarding = false
	}
 // Physiology belongs to the host's wound model. A missing host never
 // creates a second damage/healing model or silently changes body projections.
 b.Morale=max(0,b.Morale-max(0,suppression)/4)
 if rawDamage>0&&space.ApplyImpact!=nil {mode:="single";if len(modes)>0{mode=modes[0]};return space.ApplyImpact(s,sourceID,targetID,bodyPart,mode)}
 return 0
}
func (s *CombatState) gunshot(space CombatSpace, r CombatRules, a Combatant) {
	for i := range s.Actors {
		other := &s.Actors[i]
		if !other.Able() || other.ID == a.ID || other.Team == a.Team || space.rangeMM(other.Position, a.Position) > r.HearingRangeMM || space.ActorVisible(*other, a, r) {
			continue
		}
		if space.CanHear != nil && !space.CanHear(*other, a) {
			continue
		}
		// A heard source has no actor identity. Coarse location is quantized, never
		// the exact cell plus a question mark. No faction or hidden weapon is sent.
		pos := Cell{a.Position.X / 3 * 3, a.Position.Y / 3 * 3}
		s.remember(other, CombatContact{SubjectID: "noise." + strconv.FormatUint(s.ActionSeq, 10), Position: pos, ObservedTurn: s.Turn, ObservedAction: s.ActionSeq, ReceivedTurn: s.Turn, Source: "hearing", SourceID: other.ID, Radius: 3})
	}
}

// fireImpact resolves one projectile or strike from an already accepted action.
// A burst has separate events/resource debits for every projectile; ActionSeq
// remains the command/RNG clock while EventSeq orders all consequences.
func (s *CombatState) fireImpact(space CombatSpace, r CombatRules, actorID, targetID string, q combatShotSpec, round int, eventType string, cost int) {
	a, b := s.Actor(actorID), s.Actor(targetID)
 a.Facing=Cell{X:b.Position.X-a.Position.X,Y:b.Position.Y-a.Position.Y}
	chance := s.shotChance(space, r, *a, *b, a.Position, q, round)
 parried:=false
 blockFailed:=false
 if eventType=="attack" && !q.Held && combatWeaponKind(a.Weapon)!="firearm" && combatWeaponKind(b.Weapon)!="firearm" && b.Able()&&b.StunTurns==0&&(r.AutomaticReserve||b.Guarding)&&b.ReservedAP>=r.GuardAP&&r.GuardAP>0&&space.ActorVisible(*b,*a,r)&&(len(b.Body)==0||b.BodyCanHold)&&(!b.WeaponUsesLimited||b.WeaponUsesRemaining>0){
  b.ReservedAP-=r.GuardAP
  rate:=b.Weapon.ParryPercent
  if b.Guarding{rate+=r.GuardBonus}
  if r.CloseMM>0&&b.Weapon.RangeMM>r.CloseMM&&space.rangeMM(a.Position,b.Position)<=r.CloseMM{rate=int(float64(rate)*r.CrampedParry)}
  parried=int(CounterRandom(s.Seed,b.ID,s.Turn,"parry/"+strconv.FormatUint(s.ActionSeq,10)+"/"+strconv.FormatUint(s.EventSeq,10))%100)<min(95,rate)
  uses:=1;if b.WeaponUsesLimited{b.WeaponUsesRemaining--}
  s.event(CombatEvent{Type:"parry",ActorID:b.ID,TargetID:a.ID,From:b.Position,To:a.Position,AP:r.GuardAP,WeaponUses:uses,Hit:parried,Reason:"reserved AP deflection"})
  blockFailed=!parried&&b.Weapon.ID=="unarmed"&&combatWeaponKind(a.Weapon)=="blade"
  if b.ReservedAP==0||b.WeaponUsesLimited&&b.WeaponUsesRemaining==0{b.Guarding=false;b.Overwatch=false;b.ReservedAP=0}
 }
	if a.WeaponUsesLimited {
		a.WeaponUsesRemaining--
	}
	e := CombatEvent{Type: eventType, ActorID: actorID, TargetID: targetID, From: a.Position, To: b.Position, AP: cost, Mode:q.Mode, BodyPart: q.BodyPart, WeaponUses: 1}
	if a.Weapon.Magazine > 0 {
		a.Ammo--
		e.AmmoSpent = 1
	}
	stream := "combat.v2/" + s.ID + "/" + strconv.FormatUint(s.ActionSeq, 10) + "/" + eventType + "/" + targetID + "/" + strconv.Itoa(round) + "/" + strconv.FormatUint(s.EventSeq, 10)
	roll := float64(CounterRandom(s.Seed, a.ID, s.Turn, stream+"/hit")>>11) * (1.0 / (1 << 53))
	e.Hit = !parried && (blockFailed||q.Held||roll < chance)
 if blockFailed&&e.Hit {q.BodyPart="arms";e.BodyPart="arms"}
 if parried {e.Reason="parried"}
	raw := 0
	if e.Hit {
		spread := r.DamageMin + (r.DamageMax-r.DamageMin)*float64(CounterRandom(s.Seed, a.ID, s.Turn, stream+"/damage")>>11)*(1.0/(1<<53))
		raw = int(math.Round(float64(a.Weapon.Damage) * float64(q.DamagePercent) / 100 * spread))
		e.Reason = "hit"
	} else {
		if !parried{e.Reason = "miss"}
	}
	bleed := a.Weapon.Bleed
	if combatWeaponKind(a.Weapon) == "blunt" {
		bleed = 0
	}
	e.ArmorBlocked = CombatArmorBlocked(*b, raw, r.PhysicalPart(q.BodyPart))
	e.Amount = s.ApplyDamage(space, r, a.ID, b.ID, raw, bleed, a.Weapon.Suppression, q.BodyPart, q.Mode)

	s.event(e)
	if a.Weapon.Magazine > 0 {
		s.gunshot(space, r, *a)
		// Near impacts also threaten bodies that really occupy that area. This is
		// execution-only physics; their hidden positions never enter the scorer.
		if a.Weapon.Suppression > 0 {
			for i := range s.Actors {
				other := &s.Actors[i]
				if other.ID != a.ID && other.ID != b.ID && other.HP > 0 && space.rangeMM(other.Position, b.Position) <= 1000 && space.shotClear(a.Position, other.Position) {
					s.ApplyDamage(space, r, a.ID, other.ID, 0, 0, a.Weapon.Suppression/2, "torso")
				}
			}
		}
		if space.AfterShot!=nil{space.AfterShot(s,s.Events[len(s.Events)-1])}
	}
}
func (s *CombatState) reactionWindow(space CombatSpace, r CombatRules, actorID string, triggers ...string) {
	trigger:="attack";if len(triggers)>0{trigger=triggers[0]}
 target := s.Actor(actorID)
	if target == nil || !target.Able() {
		return
	}
	for i := range s.Actors {
		watcher := &s.Actors[i]
		if watcher.ID == actorID || watcher.Team == target.Team || !watcher.Able() || watcher.StunTurns > 0 || (!r.AutomaticReserve && !watcher.Overwatch && !watcher.Guarding) || watcher.ReservedAP < 1 || watcher.WeaponUsesLimited && watcher.WeaponUsesRemaining == 0 {
			continue
		}
		if watcher.Guarding && combatWeaponKind(watcher.Weapon)=="firearm" || trigger=="exit"&&combatWeaponKind(watcher.Weapon)=="firearm" {
			continue
		}
		s.Observe(space, r)
		q, ok := s.canAttackAction(space, r, *watcher, *target, watcher.Position, watcher.ReservedAP, false, CombatAction{Type: "attack"})
  if watcher.Overwatch&&watcher.Weapon.AimAP>0{if aimed,legal:=s.canAttackAction(space,r,*watcher,*target,watcher.Position,watcher.ReservedAP,false,CombatAction{Type:"attack",Mode:"aimed",Aim:1});legal{q=aimed;ok=true}}
  if !ok&&combatWeaponKind(watcher.Weapon)!="firearm"{q,ok=s.canAttackAction(space,r,*watcher,*target,watcher.Position,watcher.ReservedAP,false,CombatAction{Type:"attack",Mode:"quick"})}
  // The same public-information target policy applies to a reserved counter and an ordinary strike.
  if combatWeaponKind(watcher.Weapon)!="firearm"&&len(r.Targets)>0 {if choice,legal:=s.bestAttack(space,r,combatReactionView(*watcher,target.ID),watcher.Position,watcher.ReservedAP);legal{q,ok=s.canAttackAction(space,r,*watcher,*target,watcher.Position,watcher.ReservedAP,false,choice.Action)}}
		if !ok || space.ExecutionShotBlocked != nil && space.ExecutionShotBlocked(watcher.Position, target.Position) {
			continue
		}
		watcher.ReservedAP -= q.Cost
		if combatWeaponKind(watcher.Weapon)=="firearm"&&!watcher.Trained&&r.UntrainedReactionAccuracy>0 {
   // Only the private shot copy is penalized; the persistent skill stays unchanged.
   skill:=watcher.Skill;watcher.Skill=int(float64(skill)*r.UntrainedReactionAccuracy)
   s.fireImpact(space,r,watcher.ID,target.ID,q,0,"reaction",q.Cost);watcher.Skill=skill
  }else{s.fireImpact(space, r, watcher.ID, target.ID, q, 0, "reaction", q.Cost)}
		if watcher.ReservedAP == 0 || watcher.WeaponUsesLimited && watcher.WeaponUsesRemaining == 0 {
			watcher.Overwatch = false
			watcher.Guarding = false
			watcher.ReservedAP = 0
		}
		s.finishIfResolved()
		if !s.Active || !target.Able() || target.StunTurns > 0 {
			return
		}
	}
}

// holdTechnique: the seconds a held blade takes, one body second at a time. «Interrupted» has one meaning: in some second the holder
// stopped holding — he is out, stunned or his hand gave way, a blow reached him, or someone able stands within break_reach and sees it.
// Interrupted, the wound stays and the victim's ordinary perfusion clock and reaction apply (the host decides both from the wound rules).
func(s *CombatState)holdTechnique(space CombatSpace,r CombatRules,actorID,targetID,mode string,fromCrouch bool){
 t:=r.Techniques[mode];hold:=0;if space.HoldSeconds!=nil{hold=space.HoldSeconds(s,targetID)}
 done:=true;held:=0;seq:=s.EventSeq
 for held<hold&&done{
  if space.AdvanceTime!=nil{space.AdvanceTime(s,1)};s.TurnSpentS++;held++
  if s.Active{s.reactionWindow(space,r,actorID)}
  a:=s.Actor(actorID)
  done=a!=nil&&a.Able()&&a.StunTurns==0&&(len(a.Body)==0||a.BodyCanHold)
  for _,e:=range s.Events{if e.Sequence>seq&&e.TargetID==actorID&&e.Hit&&(e.Type=="reaction"||e.Type=="attack"){done=false}}
  if done&&space.HoldBreaker!=nil&&space.HoldBreaker(s,actorID,targetID,t)!=""{done=false}
 }
 if space.EndHold!=nil{space.EndHold(s,actorID,targetID,t,done)}
 stance:="stand";if fromCrouch{stance="crouch"}
 a,b:=s.Actor(actorID),s.Actor(targetID);e:=CombatEvent{Type:"hold",ActorID:actorID,TargetID:targetID,Mode:stance,ItemID:mode,Amount:held,Hit:done,Reason:"held technique"}
 if a!=nil{e.From=a.Position};if b!=nil{e.To=b.Position};s.event(e)
}

// AfterAction is shared with the explosive executor. Triggered fire is bounded
// by physical reserves and never recursively triggers more reactions.
func (s *CombatState) AfterAction(space CombatSpace, r CombatRules, actorID string, action CombatAction, elapsed ...int) {
 if space.AdvanceTime!=nil&&len(elapsed)>0&&elapsed[0]>0{space.AdvanceTime(s,int64(elapsed[0]));s.TurnSpentS+=elapsed[0]}
	a := s.Actor(actorID)
	s.finishIfResolved()
	if s.Active && (action.Type=="attack"||action.Type=="throw") {
		s.reactionWindow(space, r, actorID)
	}
	s.finishIfResolved()
	if s.Active && (action.Type == "end" || action.Type == "surrender" || !a.Able() || a.AP == 0 || a.StunTurns > 0) {
		s.nextTurn(r, space)
	}
	if s.Active {
		s.Observe(space, r)
	}
}

// Execute checks the entire requested action before changing AP, RNG counters,
// ammunition, health or positions. Failed inputs cannot reroll or advance turns.
// ExecuteAssault reuses the same physical strike, resources and body clock after a
// surrendered encounter. It never restores the victim's AP, guard or willingness.
func(s *CombatState)ExecuteAssault(space CombatSpace,r CombatRules,actorID string,action CombatAction)error{
 if action.Type!="assault"{return errors.New("explicit assault required")}
 draft:=s.Clone();actor:=draft.Actor(actorID);victim:=draft.Actor(action.TargetID)
 if actor==nil||!actor.Able()||victim==nil||victim.HP<=0||victim.Prone||!victim.Surrendered||victim.Withdrawn{return errors.New("no standing surrendered target")}
 if !draft.Active{draft.Active=true;draft.Winner="";draft.Turn++;draft.TurnSpentS=0;actor.AP=max(1,r.APPerTurn-actor.BodyAPPenalty);for i:=range draft.Actors{if draft.Actors[i].ID==actorID{draft.CurrentIndex=i}}}
 if err:=draft.Execute(space,r,actorID,action);err!=nil{return err};*s=draft;return nil
}
func (s *CombatState) Execute(space CombatSpace, r CombatRules, actorID string, action CombatAction) error {
	if action.Type == "throw" {
		return s.executeThrow(space, r, actorID, action)
	}
	if err := r.Validate(); err != nil {
		return err
	}
	a := s.Current()
	if a == nil || a.ID != actorID || !a.Able() || a.StunTurns > 0 {
		return errors.New("not the current combat actor")
	}
	observed := s.Clone()
	observed.Observe(space, r)
	actor := observed.Actor(actorID)
	if actor.WeaponUsesRemaining > 0 {
		actor.WeaponUsesLimited = true
	}
	var destination combatReach
	cost := 0
	var target *Combatant
	var shot combatShotSpec
	var equipment CombatEquipmentOption
	switch action.Type {
	case "roll":
  if r.RollAP<1||!actor.BodyCanWalk||actor.Prone||len(actor.Body)==0{return errors.New("roll unavailable")}
  for _,effect:=range actor.BodyEffects{for _,forbidden:=range r.RollForbiddenEffects{if effect==forbidden{return errors.New("wounds prevent rolling")}}}
  dx,dy:=action.To.X-actor.Position.X,action.To.Y-actor.Position.Y;steps:=max(combatAbs(dx),combatAbs(dy))
  if steps<1||dx!=0&&dy!=0||space.rangeMM(actor.Position,action.To)!=r.RollDistanceMM{return errors.New("roll needs the authored straight distance")}
  sx,sy:=dx/steps,dy/steps
  for n:=0;n<=steps;n++{at:=Cell{actor.Position.X+n*sx,actor.Position.Y+n*sy};for _,off:=range []Cell{{0,0},{sy,-sx},{-sy,sx}}{p:=Cell{at.X+off.X,at.Y+off.Y};if !space.standable(p)||s.occupied(p,actorID,space,r,actor.Position,false){return errors.New("roll strip blocked")}}}
  var err error;destination,err=observed.movement(space,r,*actor,action.To);if err!=nil{return err}
  for _,at:=range []Cell{actor.Position,action.To}{for _,d:=range []Cell{{1,0},{-1,0},{0,1},{0,-1}}{if space.rangeMM(at,Cell{at.X+d.X,at.Y+d.Y})<=r.RollClearanceMM&&!space.standable(Cell{at.X+d.X,at.Y+d.Y}){return errors.New("not enough room to roll")}}}
  cost=r.RollAP
 case "move":
		var err error
		destination, err = observed.movement(space, r, *actor, action.To)
		if err != nil {
			return err
		}
		cost = destination.AP
	case "attack", "assault":
		target = observed.Actor(action.TargetID)
		var ok bool
		if target != nil {
			shot, ok = observed.canAttackAction(space, r, *actor, *target, actor.Position, actor.AP, false, action)
		}
		if !ok {
			return errors.New("attack unavailable: mode, target, sight, range, AP, ammo, condition or friendly fire")
		}
		if space.ExecutionShotBlocked != nil && space.ExecutionShotBlocked(actor.Position, target.Position) {
			return ErrCombatExecutionBlocked
		}
		cost = shot.Cost
	case "equip":
 if len(actor.Body)>0&&!actor.BodyCanHold{return errors.New("wounds: cannot hold a weapon")}
		if r.EquipAP < 1 || space.Equipment == nil || action.ItemID == "" {
			return errors.New("equipping unavailable")
		}
		found := false
		for _, option := range space.Equipment(actorID) {
			if option.ID != action.ItemID {
				continue
			}
			if found {
				return errors.New("ambiguous equipment option")
			}
			equipment = option
			found = true
		}
		if !found || len(equipment.ID) > 256 || equipment.Weapon.ID == "" || equipment.UsesRemaining < 1 {
			return errors.New("carried usable weapon unavailable")
		}
		next := *actor
		next.Weapon = equipment.Weapon
		next.Ammo = equipment.Ammo
		next.ReserveAmmo = equipment.ReserveAmmo
		next.WeaponUsesRemaining = equipment.UsesRemaining
		next.WeaponUsesLimited = true
		if err := next.Validate(r); err != nil {
			return err
		}
		cost = r.EquipAP
	case "reload":
		if actor.Weapon.Magazine < 1 || actor.ReserveAmmo < 1 || actor.Ammo >= actor.Weapon.Magazine {
			return errors.New("reload unavailable")
		}
		cost = r.ReloadAP
 case "heal", "bandage", "aid", "aid_continue":
  return errors.New("first aid requires the wound host and a physical item")
	case "crouch":
		if actor.Crouched {
			return errors.New("already crouched")
		}
		cost = r.CrouchAP
	case "prone":
		if actor.Prone || r.ProneAP < 1 {
			return errors.New("prone stance unavailable")
		}
		cost = r.ProneAP
	case "stand":
 if len(actor.Body)>0&&!actor.BodyCanStand{return errors.New("wounds: cannot stand")}
		if !actor.Crouched && !actor.Prone {
			return errors.New("already standing")
		}
		cost = r.CrouchAP
		if actor.Prone {
			cost = r.ProneAP;if r.GetUpAP>0{cost=r.GetUpAP}
		}
	case "guard":
		if len(actor.Body)>0&&!actor.BodyCanHold||r.GuardAP < 1 || combatWeaponKind(actor.Weapon) == "firearm" || actor.Noncombatant || actor.Weapon.Damage < 1 || actor.AP <= r.GuardAP || actor.WeaponUsesLimited && actor.WeaponUsesRemaining == 0 {
			return errors.New("guard reserve unavailable")
		}
		cost = r.GuardAP
	case "overwatch":
		if r.ReactionAP < 1 || actor.Noncombatant || combatWeaponKind(actor.Weapon) != "firearm" || actor.Ammo < 1 || actor.AP < r.ReactionAP+actor.Weapon.AttackAP || actor.WeaponUsesLimited && actor.WeaponUsesRemaining == 0 {
			return errors.New("overwatch reserve unavailable")
		}
		cost = r.ReactionAP
	case "report":
		target = observed.Actor(action.TargetID)
		if !actor.Trained || target == nil || !target.Able() || target.Team != actor.Team || target.ID == actor.ID || !space.canCommunicate(*actor, *target, r) {
			return errors.New("report channel unavailable")
		}
		useful := false
		for _, c := range actor.Contacts {
			if c.Team != actor.Team && c.Source != "hearing" && combatReportUseful(c, combatContact(target, c.SubjectID)) {
				useful = true
			}
		}
		if !useful {
			return errors.New("no new report information")
		}
		cost = r.ReportAP
	case "stop_pursuit":
 if !observed.pursuitSpent(space,r,*actor){return errors.New("pursuit still has an immediate contact or travel budget")}
 case "disengage":
 if !observed.canLeaveCombat(space,r,*actor){return errors.New("wounds: break distance first")}
 case "surrender", "end":
	default:
		return errors.New("unknown combat action")
	}
	if actor.AP < cost {
		return errors.New("insufficient combat AP")
	}
	*s = observed
	a = s.Actor(actorID)
 if action.Type!="aid"&&action.Type!="aid_continue"{a.Aid=nil}
	s.ActionSeq++
	if action.Type == "move" {
		spent := 0
		distanceUnits := int64(0)
		old := a.Position
		for _, to := range destination.Path {
			segment := space.rangeMM(a.Position, to)
			nextUnits := distanceUnits + int64(segment)*int64(combatMovementScale(*a))
			nextSpent := combatMoveUnitsAP(nextUnits, r)
			delta := nextSpent - spent
   if spent==0{delta+=s.retreatCost(space,r,*a,to)}
			if !a.Able() || a.StunTurns > 0 || a.AP < delta {
				break
