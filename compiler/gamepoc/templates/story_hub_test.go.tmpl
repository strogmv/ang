						savedInTrip = true
					}
				}
				if hero.Level == "level.c7_copper_dock" && hero.OnFloor() {
					break
				}
				// Inspect the authoritative frames inside the ordinary travel fast-forward.
				r.state.Tick++
				if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
					t.Fatal(err)
				}
				if err := r.advanceLifeFrameBy(r.state.Life.SecondsPerTick); err != nil {
					t.Fatal(err)
				}
			}
			if !sharedTrip || !savedInTrip {
				t.Fatalf("Savely and the hero did not share one physical departure at rate %d: hero=%+v Savely=%+v", rate, r.state.Life.Actor(playerActorID), r.state.Life.Actor(hub19Savely))
