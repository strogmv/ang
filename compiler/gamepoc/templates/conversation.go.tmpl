// memoryKnows (step 1): the person was a witness of the fact (it is still in his memory), or the fact is in the dome's
// record and he is silver; belief 1. Rumours with a belief below 1 are step 2.
func (r *Runtime) memoryKnows(who, fact string) bool {
	m := r.world.Memory
	if m == nil {
		return false
	}
	def, rec := m.Facts[fact], r.state.Memory.Facts[fact]
	if def == nil || rec.Count == 0 || r.state.Life.Seconds-rec.Second > def.MemoryDays*86400 {
		return false
	}
	for _, w := range rec.Witnesses {
		if w == who {
			return true
		}
	}
	return def.Recorded && barkCatalog.Castes[who] == "silver"
}

