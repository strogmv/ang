// The evening after an escape: Prokhor in the gate passage talks once, within the window, as the event its entries keep.
func TestMemoryGateEveningAfterTheEscape(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	if err := choose(r, "escape"); err != nil {
		t.Fatal(err)
	}
	r.talkDrop()
	s := &r.state.CalendarEncounter
	if s.Outcome != "escape" {
		t.Fatalf("no escape: %+v", s)
	}
	s.Phase = "done"
	a, h := r.state.Life.Actor(e.Actor), r.state.Life.Actor(playerActorID)
	a.Level, a.Position, a.Path, a.Trip = e.Gate.Level, behavior.Cell{X: e.Gate.At.X, Y: e.Gate.At.Y}, nil, nil
	h.Level, h.Position, h.Path, h.Trip, h.Body = e.Gate.Level, behavior.Cell{X: e.Gate.At.X + 1, Y: e.Gate.At.Y}, nil, nil, nil
	conv, ok := r.talkAvailable(e.Actor)
	if !ok || conv != e.Talk.Gate {
		t.Fatalf("no evening talk at the gate: %q %v", conv, ok)
	}
	if err := r.conversationCommand(&pb.PocLifeCommand{Action: "conversation_open", Destination: e.Actor}); err != nil {
		t.Fatal(err)
	}
	tk := r.state.Memory.Talks[talkKey(e.Talk.Gate, e.Actor)]
	if tk == nil || (tk.Entry != "e.seen" && tk.Entry != "e.unseen") {
		t.Fatalf("the gate talk opened by %+v", tk)
	}
	if err := choose(r, "bye"); err != nil {
		t.Fatal(err)
	}
	r.talkDrop()
	if _, ok := r.talkAvailable(e.Actor); ok {
		t.Fatal("the gate talk opens again after his goodbye")
	}
	// outside the window: nothing (12 game hours)
	w := dialogueCustody(t, nil)
	if err := choose(w, "escape"); err != nil {
		t.Fatal(err)
	}
	w.talkDrop()
	w.state.CalendarEncounter.Phase = "done"
	for id, f := range w.state.Memory.Facts {
		f.Second -= 13 * 3600
		f.First = f.Second
		w.state.Memory.Facts[id] = f
	}
	a, h = w.state.Life.Actor(e.Actor), w.state.Life.Actor(playerActorID)
	a.Level, a.Position, a.Path, a.Trip = e.Gate.Level, behavior.Cell{X: e.Gate.At.X, Y: e.Gate.At.Y}, nil, nil
	h.Level, h.Position, h.Path, h.Trip, h.Body = e.Gate.Level, behavior.Cell{X: e.Gate.At.X + 1, Y: e.Gate.At.Y}, nil, nil, nil
	if _, ok := w.talkAvailable(e.Actor); ok {
		t.Fatal("the gate talk opens after its evening")
	}
}

// A fact's answer replaces the general one (owner 21.11, at most nine on screen): acquainted, «known» stands in place of
// «kind»; a stranger sees «kind».
func TestMemoryFactAnswerReplacesTheGeneralOne(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	var replacer, replaced string
	for _, o := range custodyNode(t, r).Options {
		if o.Replaces != "" {
			replacer, replaced = o.ID, o.Replaces
		}
	}
	if replacer == "" {
		t.Skip("no replacing answer")
	}
	shown := shownIDs(dialogueView(t, r, "ru"))
	if !shown[replaced] || shown[replacer] {
		t.Fatalf("a stranger: %v", shown)
	}
	if choose(r, replacer) == nil {
		t.Fatal("a hidden answer was taken")
	}
	r.memoryWrite(r.encounterMetFact(), map[string]string{"how": "greeted"}, talkCtx{self: e.Actor})
	shown = shownIDs(dialogueView(t, r, "ru"))
	if shown[replaced] || !shown[replacer] {
		t.Fatalf("acquainted: %v", shown)
	}
	if choose(r, replaced) == nil {
		t.Fatal("the replaced answer was taken")
	}
	if len(shown) > 9 {
		t.Fatalf("%d answers on screen", len(shown))
	}
}

// A talk acts on the exact thing it opened about (doc 09, 21.11): the lamp on the tray when the talk opened. Sold or gone
// meanwhile, the line about it is hidden and nothing else of his is touched.
func TestMemoryTalkThingIsTheExactInstance(t *testing.T) {
	r := memoryDay(t, 1)
	e := r.world.CalendarEncounter
	atTheSack(t, r)
	r.calendarEncounterAfterFrame()
	if !shownIDs(dialogueView(t, r, "ru"))["fix_lamp"] {
		t.Skip("no lamp to mend in this world")
	}
	lamp, ok := r.memoryShown(e.Actor, "item.hub_light_headlamp")
	if !ok || sackTalk(r).Things[e.Actor+"|item.hub_light_headlamp"] != lamp.ID {
		t.Fatalf("the talk did not bind the lamp on his tray: %v", sackTalk(r).Things)
	}
	before := map[string]inv.Item{}
	for id, i := range r.state.Inventory.Items {
		if i.Owner == e.Actor && i.Definition == "item.hub_light_headlamp" && id != lamp.ID {
			before[id] = i
		}
	}
	// the lamp leaves his tray (someone bought it): the line about it goes, his stock stays as it was
	if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: []inv.Relocate{{Item: lamp.ID, Quantity: 1, To: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}, Owner: playerActorID}}}); err != nil {
		t.Fatal(err)
	}
	if shownIDs(dialogueView(t, r, "ru"))["fix_lamp"] {
		t.Fatal("the line about a lamp he no longer has is still offered")
	}
	if choose(r, "fix_lamp") == nil {
		t.Fatal("a hidden line was taken")
	}
	for id, i := range before {
		if !reflect.DeepEqual(r.state.Inventory.Items[id], i) {
			t.Fatalf("his stock %s was touched", id)
		}
	}
}
