# Generated by ANG. DO NOT EDIT. Metrics and atlas are a single hashed contract.
extends Node3D
signal locale_changed(locale: String)
@export var initialize_on_ready := true
@export var level_id := ""
var runtime: Dictionary = {}
var faces: Dictionary = {}
var slots: Array = []
var batches: Dictionary = {}
var attachments: Dictionary = {}
var audit: Dictionary = {}
var built_locale := ""
var rebuild_count := 0
var enabled := true
var deformation_sources: Array[ShaderMaterial] = []
var shader_materials: Array[ShaderMaterial] = []
var surface_cache: Dictionary = {}
var surface_batches: Dictionary = {}
var surface_nodes: Array[MeshInstance3D] = []
var surface_poses: Array[Transform3D] = []
var surface_visibility: Array[bool] = []
var pose_image: Image
var pose_texture: ImageTexture
const ROOT := "res://generated/world_text/"

func _ready() -> void:
	if initialize_on_ready:
		initialize()

func initialize() -> void:
	if level_id.is_empty():
		level_id = String(get_parent().get_meta("layout_id", ""))
	assert(not level_id.is_empty(), "ANG world text requires the generated layout_id")
	if not runtime.is_empty():
		return
	if not _verify_assets():
		return
	runtime = JSON.parse_string(FileAccess.get_file_as_string(ROOT + "runtime.json"))
	assert(runtime.world_frame == "ang.world.east-up-north.v1")
	for ref in runtime.fonts:
		var m: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(ROOT + String(ref.metrics).get_file() + ".json"))
		var image := Image.new()
		assert(image.load_png_from_buffer(FileAccess.get_file_as_bytes(ROOT + String(m.atlas.texture).get_file() + ".bytes")) == OK)
		image.generate_mipmaps()
		var glyphs: Dictionary = {}
		for g in m.glyphs:
			glyphs[g.c] = g
		faces[ref.style] = {"metrics": m, "ref": ref, "glyphs": glyphs, "atlas": ImageTexture.create_from_image(image)}
	for slot in runtime.slots:
		if slot.level_id == level_id:
			slots.append(slot)
	# Translation notifications are event-driven; no frame loop rebuilds the text.
	call_deferred("rebuild")

func _verify_assets() -> bool:
	var manifest: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(ROOT + "assets-manifest.json"))
	assert(manifest.schema == "ang.world_text.assets.v1")
	for file in manifest.files:
		if FileAccess.get_sha256(ROOT + file.file) != file.sha256:
			push_error("ANG world text SHA mismatch: " + file.file)
			return false
	return true

func _notification(what: int) -> void:
	if what == NOTIFICATION_TRANSLATION_CHANGED and is_node_ready() and not runtime.is_empty():
		if built_locale != TranslationServer.get_locale().get_slice("_", 0).get_slice("-", 0):
			call_deferred("rebuild")

func _v(a: Array) -> Vector3:
	return Vector3(a[0], a[1], a[2])

func _find(root: Node, source_name: String) -> Node3D:
	# Godot's glTF importer replaces dots and punctuation in node names. The
	# exported model may also retain Blender's unique .001 suffix. Exact match
	# wins; a sanitized source-name match must be unambiguous.
	if root == null or source_name.is_empty():
		return null
	var exact := root.find_child(source_name, true, false) as Node3D
	if exact != null:
		return exact
	var label := source_name
	for c in [".", ":", "/", "@"]:
		label = label.replace(c, "_")
	var matches: Array[Node3D] = []
	for node in root.find_children("*", "Node3D", true, false):
		if String(node.name) == label or String(node.name) == label + "_001":
			matches.append(node)
	return matches[0] if matches.size() == 1 else null

func _host(instance: String) -> Node3D:
	for node in get_tree().current_scene.find_children("*", "Node3D", true, false):
		if String(node.get_meta("instance_id", "")) == instance:
			return node
	return null

func _locale_text(slot: Dictionary, locale: String) -> Dictionary:
	for t in slot.texts:
		if t.locale == locale:
			return t
	# Unsupported languages use the project's declared fallback, never a glyph.
	for t in slot.texts:
		if t.locale == ProjectSettings.get_setting("internationalization/locale/fallback", "en"):
			return t
	assert(false, "ANG world text has no locale/fallback: " + slot.id)
	return {}

func _width(line: String, face: Dictionary, em: float) -> float:
	var advance := 0.0
	for c in line:
		assert(face.glyphs.has(c), "ANG world text missing glyph: " + c)
		advance += float(face.glyphs[c].adv)
	return (advance + maxf(0, line.length() - 1) * float(face.ref.tracking_em)) * em

func rebuild() -> void:
	var locale := TranslationServer.get_locale().get_slice("_", 0).get_slice("-", 0)
	if built_locale == locale:
		return
	for child in get_children():
		child.free()
	batches.clear()
	deformation_sources.clear()
	shader_materials.clear()
	surface_cache.clear()
	surface_batches.clear()
	surface_nodes.clear()
	surface_poses.clear()
	surface_visibility.clear()
	for a in attachments.values():
		if is_instance_valid(a.node):
			a.node.visibility_changed.disconnect(a.callback)
	attachments.clear()
	rebuild_count += 1
	audit = {"locale": locale, "compiled_slots": slots.size(), "drawn_slots": 0, "glyphs": 0,
		"missing_glyphs": 0, "unresolved_keys": 0, "glyph_quads": 0, "max_width_deviation_mm": 0.0,
		"slots": [], "anchor_fallbacks": [], "strip_fallbacks": [], "batch_drawables": 0, "surface_projection_misses": 0, "projection_issues": [], "surface_edge_clips": 0,
		"rebuild_count": rebuild_count, "visibility_note": "Only authored node ancestors; no slot state bindings are declared."}
	for slot in slots:
		_build_slot(slot, _locale_text(slot, locale))
	for style in batches:
		_finish_batch(style)
	if not surface_batches.is_empty():
		pose_image = Image.create(4,surface_nodes.size(),false,Image.FORMAT_RGBAF)
		_update_surface_poses()
		pose_texture = ImageTexture.create_from_image(pose_image)
		for style in surface_batches:
			_finish_surface_batch(style)
	for key in attachments:
		var a: Dictionary = attachments[key]
		a.callback = _update_attachment.bind(key)
		a.node.visibility_changed.connect(a.callback)
		_update_attachment(key)
	built_locale = locale
	locale_changed.emit(locale)

func _build_slot(slot: Dictionary, text: Dictionary) -> void:
	var first_glyph: int = audit.glyphs
	var first_quad: int = audit.glyph_quads
	var face: Dictionary = faces[slot.style]
	var cap := float(text.glyph_mm) * 0.001
	var em := cap / float(face.metrics.metrics.cap_height)
	var u := _v(slot.frame.right)
	var up := _v(slot.frame.up)
	var n := _v(slot.frame.normal)
	var center := _v(slot.frame.center)
	var host := _host(slot.get("instance", ""))
	var anchor: Node3D = _find(host, slot.get("anchor", ""))
	if not slot.get("anchor", "").is_empty():
		if anchor != null:
			center = anchor.global_position
		else:
			audit.anchor_fallbacks.append({"slot": slot.id, "node": slot.anchor, "method": "compiled CUE center"})
	else:
		# Unhosted CUE slots have a real locator at their compiled world pose.
		# Blender-authoritative import updates that pose before generation.
		anchor = Node3D.new()
		anchor.name = "SlotLocator_" + slot.id
		anchor.set_meta("cue_slot_locator", slot.id)
		add_child(anchor)
		anchor.global_position = center
	var strip_centers: Array[float] = []
	var strip_nodes: Array = []
	if slot.has_strips:
		var found: Array = []
		for name in slot.strips.get("nodes", []):
			var node := _find(host, name)
			if node == null:
				found.clear()
				break
			var pos := node.global_position
			if node is MeshInstance3D:
				pos = node.to_global(node.get_aabb().get_center())
			found.append({"x": (pos-center).dot(u), "node": node})
		if found.size() == int(slot.strips.count):
			found.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a.x < b.x)
			for k in range(found.size()):
				var f: Dictionary = found[k]
				# ANG fit uses the authored pitch; node bounds select reading order,
				# while projection below binds the glyph to the actual curved surface.
				strip_centers.append(-slot.width_mm*0.0005+(k*slot.strips.pitch_mm+slot.strips.width_mm*0.5)*0.001)
				strip_nodes.append(f.node)
		else:
			audit.strip_fallbacks.append(slot.id)
			for i in range(slot.strips.count):
				strip_centers.append(-slot.width_mm*0.0005+(i*slot.strips.pitch_mm+slot.strips.width_mm*0.5)*0.001)
				strip_nodes.append(null)
	var widths: Array = []
	var deviation := 0.0
	for i in range(text.lines.size()):
		var line: String = text.lines[i]
		assert(not line.begins_with("ui."), "Unresolved ANG key: " + slot.id)
		var w := _width(line, face, em)
		widths.append(w * 1000.0)
		deviation = maxf(deviation, absf(w*1000.0-float(text.widths_mm[i])))
	audit.max_width_deviation_mm = maxf(audit.max_width_deviation_mm, deviation)
	var layout_width_mm := 0.0
	if text.mode == "per_strip":
		var k := int(text.first_strip)
		var first_edge := INF
		var last_edge := -INF
		for c in text.lines[0]:
			if c == " ":
				continue
			assert(k < strip_centers.size())
			var g: Dictionary = face.glyphs[c]
			first_edge = minf(first_edge,strip_centers[k]-g.adv*em*0.5)
			last_edge = maxf(last_edge,strip_centers[k]+g.adv*em*0.5)
			_put_glyph(slot, text, g, em, strip_centers[k]-g.adv*em*0.5, -cap*0.5,
				center, u, up, n, strip_centers, strip_nodes, anchor if anchor != null else host, k)
			k += 1
		layout_width_mm = (last_edge-first_edge)*1000.0
	else:
		var pitch := float(face.ref.line_pitch)*cap
		var baseline: float = cap*(1+(text.lines.size()-1)*float(face.ref.line_pitch))*0.5-cap
		for i in range(text.lines.size()):
			var pen := -float(widths[i])*0.0005
			var begin := pen
			for c in text.lines[i]:
				var g: Dictionary = face.glyphs[c]
				_put_glyph(slot, text, g, em, pen, baseline-i*pitch, center, u, up, n,
					strip_centers, strip_nodes, anchor if anchor != null else host)
				pen += (float(g.adv)+float(face.ref.tracking_em))*em
			var actual_width := (pen-begin-float(face.ref.tracking_em)*em)*1000.0
			widths[i] = actual_width
			layout_width_mm = maxf(layout_width_mm,actual_width)
	deviation = maxf(deviation,absf(layout_width_mm-float(text.layout_width_mm)))
	audit.max_width_deviation_mm = maxf(audit.max_width_deviation_mm,deviation)
	if slot.has_plate:
		_plate(slot, center, u, up, n)
	elif slot.has("backing"):
		var backed := slot.duplicate()
		backed.plate = slot.backing
		_plate(backed,center,u,up,n)
	audit.drawn_slots += 1
	audit.slots.append({"id": slot.id, "style": slot.style, "lines": text.lines,
		"mode": text.mode, "glyph_mm": text.glyph_mm, "rendered_widths_mm": widths,
		"glyphs": audit.glyphs-first_glyph, "glyph_quads": audit.glyph_quads-first_quad,
		"locator_resolved": anchor != null, "locator_path": String(anchor.get_path()) if anchor != null else "",
		"locator_source": "model_attachment" if not slot.get("anchor", "").is_empty() else "compiled_cue",
		"compiled_widths_mm": text.widths_mm, "rendered_layout_width_mm": layout_width_mm, "compiled_layout_width_mm": text.layout_width_mm, "max_deviation_mm": deviation,
		"center": [center.x, center.y, center.z], "normal": [n.x,n.y,n.z]})

func _put_glyph(slot: Dictionary, text: Dictionary, g: Dictionary, em: float, pen: float, baseline: float,
	center: Vector3, u: Vector3, up: Vector3, n: Vector3, strips: Array, nodes: Array, host: Node3D, only := -1) -> void:
	if int(g.a[2]) == 0:
		return
	audit.glyphs += 1
	var q := Rect2(pen+float(g.q[0])*em, baseline+float(g.q[1])*em,
		(float(g.q[2])-float(g.q[0]))*em, (float(g.q[3])-float(g.q[1]))*em)
	var m: Dictionary = faces[slot.style].metrics
	var uv := Rect2(float(g.a[0])/m.atlas.width, float(g.a[1])/m.atlas.height,
		float(g.a[2])/m.atlas.width, float(g.a[3])/m.atlas.height)
	if strips.is_empty():
		_quad(slot, text, q, uv, center, u, up, n, host, false)
	else:
		# Clip BOTH layout modes, including spread padding on per-strip glyphs.
		for k in range(strips.size()):
			if only >= 0 and only != k:
				continue
			var left := maxf(q.position.x, strips[k]-slot.strips.width_mm*0.0005)
			var right := minf(q.end.x, strips[k]+slot.strips.width_mm*0.0005)
			if right <= left:
				continue
			var clipped := Rect2(left, q.position.y, right-left, q.size.y)
			var tex := Rect2(uv.position.x+(left-q.position.x)/q.size.x*uv.size.x, uv.position.y,
				(right-left)/q.size.x*uv.size.x, uv.size.y)
			_quad(slot, text, clipped, tex, center, u, up, n, nodes[k] if nodes[k] != null else host, nodes[k] != null)

func _quad(slot: Dictionary, text: Dictionary, q: Rect2, uv: Rect2, center: Vector3,
	u: Vector3, up: Vector3, n: Vector3, host: Node3D, project_surface: bool) -> void:
	audit.glyph_quads += 1
	if not batches.has(slot.style):
		batches[slot.style] = []
	var transform := Transform3D(Basis(u*q.size.x, up*q.size.y, n),
		center+u*q.get_center().x+up*q.get_center().y+n*(0.004 if slot.has_strips else 0.003))
	var record := {"transform": transform, "uv": uv, "q": q, "ink": Color(slot.ink).srgb_to_linear(),
		"wear": slot.wear*0.001, "seed": float(_seed(slot.id))*0.137,
		"surface": ["pvc", "steel", "concrete", "board", "screen"].find(slot.surface),
		"pitch": maxf(4.0, float(text.glyph_mm)/11.0), "host": host}
	if project_surface and host is MeshInstance3D:
		_surface_quad(slot.style,record,host)
	else:
		batches[slot.style].append(record)

func _seed(id: String) -> int:
	# Explicit deterministic seed, independent of runtime string hashing.
	var result := 0
	for c in id:
		result = (result*31+c.unicode_at(0)) & 1023
	return result

func _finish_batch(style: String) -> void:
	var records: Array = batches[style]
	if records.is_empty():
		return
	var data := Image.create(4, records.size(), false, Image.FORMAT_RGBAF)
	var multi := MultiMesh.new()
	multi.transform_format = MultiMesh.TRANSFORM_3D
	multi.use_custom_data = true
	multi.mesh = QuadMesh.new()
	multi.instance_count = records.size()
	for i in range(records.size()):
		var r: Dictionary = records[i]
		multi.set_instance_transform(i, r.transform)
		multi.set_instance_custom_data(i, Color(float(i), 0, 0, 0))
		data.set_pixel(0,i,Color(r.uv.position.x,r.uv.position.y,r.uv.size.x,r.uv.size.y))
		data.set_pixel(1,i,Color(r.q.position.x*1000,r.q.position.y*1000,r.q.size.x*1000,r.q.size.y*1000))
		data.set_pixel(2,i,Color(r.wear,r.surface,r.seed,r.pitch))
		data.set_pixel(3,i,r.ink)
		var host: Node3D = r.host
		if host != null:
			var key := host.get_instance_id()
			if not attachments.has(key):
				attachments[key] = {"node": host,"last": host.global_transform,"records": []}
			attachments[key].records.append({"local": host.global_transform.affine_inverse()*r.transform,"multi": multi,"index": i})
	var material := ShaderMaterial.new()
	material.shader = load(ROOT + "world_text.gdshader")
	shader_materials.append(material)
	material.set_shader_parameter("atlas", faces[style].atlas)
	material.set_shader_parameter("glyph_data", ImageTexture.create_from_image(data))
	material.set_shader_parameter("style", ["stencil","chalk","matrix"].find(style))
	var drawable := MultiMeshInstance3D.new()
	drawable.name = "WorldText_" + style
	drawable.multimesh = multi
	drawable.material_override = material
	drawable.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(drawable)
	drawable.visible = enabled
	audit.batch_drawables += 1

func _update_attachment(key: int) -> void:
	var a: Dictionary = attachments[key]
	if not is_instance_valid(a.node):
		return
	a.last = a.node.global_transform
	for r in a.records:
		var pose: Transform3D = a.last*r.local
		if not a.node.is_visible_in_tree():
			pose.basis = Basis.from_scale(Vector3.ZERO)
		r.multi.set_instance_transform(r.index,pose)

func _process(_delta: float) -> void:
	if not deformation_sources.is_empty():
		var times := PackedFloat32Array()
		times.resize(64)
		for i in range(deformation_sources.size()):
			times[i] = float(deformation_sources[i].get_shader_parameter("wind_time"))
		for material in shader_materials:
			material.set_shader_parameter("deformation_times",times)
	if pose_image != null and _update_surface_poses():
		pose_texture.update(pose_image)
	# Only actual host/node motion changes matrices; no glyph layout rebuild.
	for key in attachments:
		var a: Dictionary = attachments[key]
		if is_instance_valid(a.node) and a.last != a.node.global_transform:
			_update_attachment(key)

func set_lettering_enabled(value: bool) -> void:
	enabled = value
	for node in get_children():
		if node is GeometryInstance3D:
			node.visible = value

func _plate(slot: Dictionary, center: Vector3, u: Vector3, up: Vector3, n: Vector3) -> void:
	var multi: MultiMesh
	var drawable := get_node_or_null("WorldText_plates") as MultiMeshInstance3D
	if drawable == null:
		drawable = MultiMeshInstance3D.new()
		drawable.name = "WorldText_plates"
		multi = MultiMesh.new()
		multi.transform_format = MultiMesh.TRANSFORM_3D
		multi.use_colors = true
		multi.mesh = BoxMesh.new()
		multi.instance_count = slots.filter(func(s: Dictionary) -> bool: return s.has_plate or s.has("backing")).size()
		drawable.multimesh = multi
		var mat := StandardMaterial3D.new()
		mat.vertex_color_use_as_albedo = true
		mat.metallic = 0.25
		mat.roughness = 0.7
		drawable.material_override = mat
		add_child(drawable)
		drawable.visible = enabled
		drawable.set_meta("next", 0)
		audit.batch_drawables += 1
	multi = drawable.multimesh
	var i := int(drawable.get_meta("next"))
	var rim := float(slot.plate.get("rim_mm",0))*0.001
	var depth := maxf(0.002, float(slot.plate.depth_mm)*0.001)
	multi.set_instance_transform(i,Transform3D(Basis(u*(slot.width_mm*0.001+2*rim),up*(slot.height_mm*0.001+2*rim),n*depth),center-n*(depth*0.5+0.0015)))
	multi.set_instance_color(i,Color(slot.plate.color))
	drawable.set_meta("next",i+1)

# Surface glyphs are clipped to the original mesh triangles, so every interior
# point stays on the same deformed surface, not just the four glyph corners.
func _surface_quad(style: String, record: Dictionary, node: MeshInstance3D) -> void:
	var local: Transform3D = node.global_transform.affine_inverse()*record.transform
	var glyph_from_source := local.affine_inverse()
	var direction := local.basis.z.normalized()
	if not surface_cache.has(node.mesh):
		var triangles: Array = []
		for surface in range(node.mesh.get_surface_count()):
			var arrays := node.mesh.surface_get_arrays(surface)
			var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
			var normals: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
			var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
			if indices.is_empty():
				for i in range(vertices.size()):
					indices.append(i)
			for i in range(0,indices.size(),3):
				triangles.append([vertices[indices[i]],vertices[indices[i+1]],vertices[indices[i+2]],normals[indices[i]],normals[indices[i+1]],normals[indices[i+2]]])
		surface_cache[node.mesh] = triangles
	if not surface_batches.has(style):
		surface_batches[style] = []
	if node not in surface_nodes:
		surface_nodes.append(node)
		surface_poses.append(Transform3D(Basis.from_scale(Vector3.ZERO),Vector3.ZERO))
		surface_visibility.append(false)
	var node_index := surface_nodes.find(node)
	var deform := Color(-1,0,0,0)
	var phase := 0.0
	if node.has_meta("ang_world_text_deformation"):
		var spec: Dictionary = node.get_meta("ang_world_text_deformation")
		assert(spec.mode == "cloth_v1")
		var material: ShaderMaterial = spec.material
		if material not in deformation_sources:
			assert(deformation_sources.size() < 64)
			deformation_sources.append(material)
		deform = Color(deformation_sources.find(material),material.get_shader_parameter("amplitude"),material.get_shader_parameter("anchor_y"),material.get_shader_parameter("cloth_height"))
		phase = spec.phase
	var count := 0
	for tri in surface_cache[node.mesh]:
		if (tri[3]+tri[4]+tri[5]).dot(direction) <= 0:
			continue
		var polygon: Array = []
		for i in range(3):
			var point: Vector3 = glyph_from_source*tri[i]
			var bary := Vector3.ZERO
			bary[i] = 1
			polygon.append({"p":Vector2(point.x,point.y),"source":tri[i],"bary":bary})
		for plane in [Vector3(1,0,-0.5),Vector3(-1,0,-0.5),Vector3(0,1,-0.5),Vector3(0,-1,-0.5)]:
			polygon = _clip_surface(polygon,plane)
		if polygon.size() < 3:
			continue
		for k in range(1,polygon.size()-1):
			for corner in [polygon[0],polygon[k],polygon[k+1]]:
				var p: Vector2 = corner.p
				var uv: Vector2 = record.uv.position+Vector2(p.x+0.5,0.5-p.y)*record.uv.size
				var slot: Vector2 = record.q.position+(p+Vector2(0.5,0.5))*record.q.size
				surface_batches[style].append({"point":corner.source+direction*0.004,"bary":corner.bary,"normal":direction,
					"uv":uv,"slot":slot,"tri":tri,"deform":deform,"phase":phase,"node":node_index,"record":record})
			count += 1
	assert(count > 0,"ANG strip glyph has no authored surface")
	audit["surface_triangles"] = int(audit.get("surface_triangles",0))+count

func _clip_surface(polygon: Array, plane: Vector3) -> Array:
	if polygon.is_empty():
		return []
	var result: Array = []
	var previous: Dictionary = polygon[-1]
	var pd: float = previous.p.dot(Vector2(plane.x,plane.y))-plane.z
	for current in polygon:
		var cd: float = current.p.dot(Vector2(plane.x,plane.y))-plane.z
		if (pd >= 0) != (cd >= 0):
			var t := pd/(pd-cd)
			result.append({"p":previous.p.lerp(current.p,t),"source":previous.source.lerp(current.source,t),"bary":previous.bary.lerp(current.bary,t)})
		if cd >= 0:
			result.append(current)
		previous = current
		pd = cd
	return result

func _update_surface_poses() -> bool:
	var changed := false
	for i in range(surface_nodes.size()):
		var pose := surface_nodes[i].global_transform
		var visible_now := surface_nodes[i].is_visible_in_tree()
		if pose == surface_poses[i] and visible_now == surface_visibility[i]:
			continue
		surface_poses[i] = pose
		surface_visibility[i] = visible_now
		changed = true
		pose_image.set_pixel(0,i,Color(pose.origin.x,pose.origin.y,pose.origin.z,1 if surface_nodes[i].is_visible_in_tree() else 0))
		for k in range(3):
			var axis: Vector3 = pose.basis[k]
			pose_image.set_pixel(k+1,i,Color(axis.x,axis.y,axis.z,0))
	if changed and not surface_nodes.is_empty():
		var bounds := surface_nodes[0].global_transform*surface_nodes[0].get_aabb()
		for node in surface_nodes:
			bounds = bounds.merge(node.global_transform*node.get_aabb())
		for child in get_children():
			if String(child.name).begins_with("WorldText_surface_"):
				child.custom_aabb = bounds.grow(0.1)
	return changed

func _finish_surface_batch(style: String) -> void:
	var rows: Array = surface_batches[style]
	var data := Image.create(25,rows.size(),false,Image.FORMAT_RGBAF)
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var row_indices := PackedVector2Array()
	for i in range(rows.size()):
		var r: Dictionary = rows[i]
		var original: Dictionary = r.record
		vertices.append(surface_nodes[r.node].to_global(r.point))
		normals.append(surface_nodes[r.node].global_basis*r.normal)
		row_indices.append(Vector2(i,0))
		data.set_pixel(0,i,Color(r.uv.x,r.uv.y,0,0))
		data.set_pixel(1,i,Color(r.slot.x*1000,r.slot.y*1000,0,0))
		data.set_pixel(2,i,Color(original.wear,original.surface,original.seed,original.pitch))
		data.set_pixel(3,i,original.ink)
		data.set_pixel(4,i,Color(r.node,0,0,0))
		data.set_pixel(5,i,r.deform)
		data.set_pixel(6,i,Color(r.point.x,r.point.y,r.point.z,r.phase))
		data.set_pixel(10,i,Color(r.normal.x,r.normal.y,r.normal.z,0))
		for j in range(6):
			var value: Vector3 = r.tri[j]
			data.set_pixel(18+j,i,Color(value.x,value.y,value.z,0))
		data.set_pixel(24,i,Color(r.bary.x,r.bary.y,r.bary.z,0))
	var arrays: Array = []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_TEX_UV2] = row_indices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
	var material := ShaderMaterial.new()
	material.shader = load(ROOT+"world_text.gdshader")
	material.set_shader_parameter("atlas",faces[style].atlas)
	material.set_shader_parameter("glyph_data",ImageTexture.create_from_image(data))
	material.set_shader_parameter("surface_poses",pose_texture)
	material.set_shader_parameter("surface_mesh",true)
	material.set_shader_parameter("style",["stencil","chalk","matrix"].find(style))
	shader_materials.append(material)
	var drawable := MeshInstance3D.new()
	drawable.name = "WorldText_surface_"+style
	drawable.mesh = mesh
	drawable.custom_aabb = mesh.get_aabb().grow(0.1)
	drawable.material_override = material
	drawable.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(drawable)
	drawable.visible = enabled
	audit.batch_drawables += 1
