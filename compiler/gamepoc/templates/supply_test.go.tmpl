    for _,cargo:=range rec.Cargo{item,ok:=r.state.Inventory.Items[cargo.Item];if !ok||item.ID!=cargo.Item||item.Quantity!=cargo.Quantity||item.Definition!=d.Definition||item.Owner!=d.Carrier||item.Location.Kind!="store"||(item.Location.Store!=sh.DisplayStore&&item.Location.Store!=sh.ReserveStore){t.Fatal("delivered physical cargo identity changed")}}
    if commerceTotal(r.state.Inventory)!=report.InitialTotal{t.Fatal("dropoff minted or lost stock")}
   }
  }
 }
 report.PrivateHomes=len(inside);for _,d:=range r.world.Inventory.Deliveries{report.Deliveries=append(report.Deliveries,*records[d.ID]);if commerceQuantity(r.state.Inventory,d.SourceStore)!=initialSource[d.ID]-3{t.Fatal("source was reused or replenished without a transaction")}}
 if !closed||report.Packed==0||report.Protected==0||len(picked)!=8||len(delivered)!=8||len(inside)!=8||!saved||report.ReplayTicks<1000||r.state.Life.Population.Count!=100{t.Fatalf("incomplete real commerce: closed%v pickup%d delivered%d private%d save%v replay%d",closed,len(picked),len(delivered),len(inside),saved,report.ReplayTicks)}
 if commerceTotal(r.state.Inventory)!=report.InitialTotal{t.Fatal("overall physical quantity changed")}
 if err=r.validateLifeSave(r.state);err!=nil{t.Fatal(err)}
}
func TestStorefrontProjectionHidesClosedStockAndOffscreenShops(t *testing.T){
 r:=lifeRuntimeFixture(t);if len(r.world.Inventory.Shopfronts)==0{t.Skip("no authored shopfront")};hero:=r.state.Life.Actor(playerActorID);shop:=r.world.Inventory.Shopfronts[0]
 view:=&pb.PocLifeView{};r.appendStorefrontState(view,hero,&pb.PocObserverView{});if len(view.Storefronts)!=0{t.Fatal("offscreen stock leaked")}
 perception:=&pb.PocObserverView{};terrain:=r.world.Life.Locations[shop.Service.Level].Terrain;for _,line:=range terrain{perception.Cells=append(perception.Cells,strings.Repeat("0",len(line)))};row:=[]byte(perception.Cells[shop.Service.At.Y]);row[shop.Service.At.X]='2';perception.Cells[shop.Service.At.Y]=string(row)
 base:=r.state.Inventory.Clone()
 for _,kind:=range []string{"closed_stocked","closed_empty","open_empty","open_hidden_only","open_stocked"}{t.Run(kind,func(t *testing.T){
  r.state.Inventory=base.Clone();open:=strings.HasPrefix(kind,"open_");r.state.Inventory.Shopfronts[shop.ID]=inv.ShopProgress{Open:open}
  for id,item:=range r.state.Inventory.Items{if item.Location.Kind!="store"||item.Location.Store!=shop.DisplayStore{continue};if strings.HasSuffix(kind,"empty"){item.Location.Store=shop.ReserveStore};if kind=="open_hidden_only"{item.Hidden=true};r.state.Inventory.Items[id]=item}
  view:=&pb.PocLifeView{};r.appendStorefrontState(view,hero,perception);stocked:=kind=="open_stocked"
  if len(view.Storefronts)!=1||view.Storefronts[0].Open!=open||view.Storefronts[0].Stocked!=stocked{t.Fatal("public shop state exposed closed, reserve or hidden stock")}
  key:="";if !open{key="market.stall.closed"}else if !stocked{key="market.stall.empty"}
  ru,en:="",""
  for _,locale:=range []string{"ru","en"}{msg:=&pb.PocGameState{Life:&pb.PocLifeView{Storefronts:view.Storefronts,Inspections:[]*pb.PocInspectionObject{{Id:shop.InspectionID,TextKey:"authored.stall",BaseText:"VISIBLE_GOODS"}}}};r.appendStorefrontInspection(msg,locale);object:=msg.Life.Inspections[0]
   if key==""{if object.BaseText!="VISIBLE_GOODS"||object.TextKey!="authored.stall"{t.Fatal("open stocked description replaced")};continue}
   want:=r.localText(locale,key,"");if want==""||want==key||object.TextKey!=key||object.BaseText!=want{t.Fatal("closed/empty inspection is missing, untranslated or exposes goods")};if locale=="ru"{ru=object.BaseText}else{en=object.BaseText}
  }
  if key!=""&&ru==en{t.Fatal("RU/EN inspection did not select distinct localized text")}
 })}
