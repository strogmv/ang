func TestCombatMalformedSavedIntegersAreRejectedWithoutArithmeticOverflow(t *testing.T) {
	r, space := combatFixtureRules(), combatFixtureSpace()
	a, b := combatFixtureActor("a", "blue", Cell{1, 1}), combatFixtureActor("b", "red", Cell{3, 1})
	s := combatFixture(t, space, a, b)
	mutations := []func(*CombatState){
		func(s *CombatState) { s.Actor("a").Weapon.Magazine = math.MaxInt },
		func(s *CombatState) { s.Actor("a").Weapon.Damage = math.MaxInt },
		func(s *CombatState) { s.Actor("a").Weapon.RangeMM = math.MaxInt },
		func(s *CombatState) { s.Actor("a").ReserveAmmo = math.MaxInt },
		func(s *CombatState) { s.Actor("a").Medkits = math.MaxInt },
		func(s *CombatState) { s.Actor("a").MaxHP = math.MaxInt },
		func(s *CombatState) { s.Actor("a").Armor = math.MaxInt },
		func(s *CombatState) { s.Turn = math.MaxInt64 },
		func(s *CombatState) { s.ActionSeq = math.MaxUint64 },
	}
	for i, change := range mutations {
		copy := s.Clone()
		change(&copy)
		if err := copy.Validate(r, space); err == nil {
			t.Fatalf("accepted malformed integer mutation %d", i)
		}
	}
	r.MoveAPPerMeter = math.MaxInt
	if err := r.Validate(); err == nil {
		t.Fatal("accepted overflow-prone movement cost")
	}
}

func TestCombatHypotheticalCornerViewDoesNotRevealHiddenTarget(t *testing.T) {
	r, space := combatFixtureRules(), combatFixtureSpace()
	space.Space.Visible = func(from, to Cell) bool {
		// An actor at the actual x=1 position cannot see beyond the corner.
		// Reachable hypothetical x>=3 positions would see either hidden area.
		return from == to || from.X >= 3 || to.X <= 2
	}
	a, b := combatFixtureActor("a", "blue", Cell{1, 2}), combatFixtureActor("b", "red", Cell{7, 2})
	s := combatFixture(t, space, a, b)
	if len(s.Actor("a").Contacts) != 0 {
		t.Fatal("hidden target was initially known")
	}
	one := s.Decide(space, r)
	s.Actor("b").Position = Cell{8, 5}
	two := s.Decide(space, r)
	if !reflect.DeepEqual(one, two) {
		t.Fatalf("hypothetical sight peeked into hidden target position: %+v / %+v", one.Chosen, two.Chosen)
	}
	for _, candidate := range two.Candidates {
		if candidate.Action.Type == "attack" || strings.Contains(candidate.Reason, "legal attack") {
			t.Fatal("candidate included an undiscovered attack opportunity")
		}
	}
	// A received report still authorizes investigation only, never a shot
	// planned with coordinates obtained from the future viewing position.
	s.Actor("a").Contacts = []CombatContact{{SubjectID: "b", Team: "red", Position: Cell{6, 2}, ObservedTurn: s.Turn, ObservedAction: s.ActionSeq, ReceivedTurn: s.Turn, Source: "report", SourceID: "scout"}}
	one = s.Decide(space, r)
	s.Actor("b").Position = Cell{7, 4}
	two = s.Decide(space, r)
	if !reflect.DeepEqual(one, two) {
		t.Fatal("reported contact let hypothetical vision track actual hidden target")
	}
	for _, candidate := range two.Candidates {
		if strings.Contains(candidate.Reason, "legal attack") {
			t.Fatal("report generated move+attack instead of search")
		}
	}
}
