// The per-key mutexes of mutex.With steps. A key is forgotten once nobody
// holds or waits for it, so locking per tender does not grow the process.
var _{{ .Service.Name }}FlowMutexRegistry helpers.KeyedMutexes

func _{{ .Service.Name }}FlowMutexForKey(key string) *helpers.KeyedMutex {
	if key == "" {
		key = "__default__"
	}
	return _{{ .Service.Name }}FlowMutexRegistry.For(key)
}

