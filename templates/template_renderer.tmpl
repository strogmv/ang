package templaterender

import (
	"bytes"
	htmltemplate "html/template"
	texttemplate "text/template"
)

// RenderString renders a plain-text template with missing keys defaulting to
// zero values. Use it for subjects and text bodies — anything whose output is
// read as text and interpreted by nothing.
//
// Do not use it for HTML. See RenderHTML.
func RenderString(src string, data any) (string, error) {
	if src == "" {
		return "", nil
	}
	t, err := texttemplate.New("tpl").Option("missingkey=zero").Parse(src)
	if err != nil {
		return "", err
	}
	var buf bytes.Buffer
	if err := t.Execute(&buf, data); err != nil {
		return "", err
	}
	return buf.String(), nil
}

// RenderHTML renders an HTML template, escaping every value according to where
// it lands — text, attribute, URL or script context.
//
// The values in these templates are not ours: a company name, a tender title,
// somebody's own message, typed by whoever signed up. Rendered with the text
// engine, a name containing markup becomes markup in a mail sent to somebody
// else's inbox, and a link built from a value can be pointed anywhere.
// html/template knows the difference between those positions and text/template
// does not, which is the whole reason the two exist.
func RenderHTML(src string, data any) (string, error) {
	if src == "" {
		return "", nil
	}
	t, err := htmltemplate.New("tpl").Option("missingkey=zero").Parse(src)
	if err != nil {
		return "", err
	}
	var buf bytes.Buffer
	if err := t.Execute(&buf, data); err != nil {
		return "", err
	}
	return buf.String(), nil
}
