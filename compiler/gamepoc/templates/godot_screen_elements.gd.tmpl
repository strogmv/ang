# Generated by ANG. Shared screen mechanics, configured by the catalog.
extends RefCounted
const C=preload("res://generated/game_contract.gd")
const Catalog=preload("res://generated/screens/catalog.gd")
var ui
func _init(screen):ui=screen
func _label(parent: Node, copy: String, px: int) -> Label:
	var label := Label.new()
	label.set_meta("font_px",px)
	label.text = copy
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.add_theme_font_size_override("font_size",roundi(px*(1.25 if ui._large() else 1.0)))
	if ui.spec.chrome == "tactical": label.add_theme_color_override("font_color",Color("e7e5d3"))
	parent.add_child(label)
	return label


func _button(parent: Node, copy: String, callback: Callable, id: String, wrap := false, px := 19) -> Button:
	var button: Button
	if wrap and ui.spec.chrome == "folk" and not Catalog.specification().get("response","").is_empty():
		button = Catalog.response()
		parent.add_child(button)
		button.reduced_motion = ui._motion()
		button.configure(ui.rail.size()+1,copy)
		button.copy_label.set_meta("font_px",px)
		button.copy_label.add_theme_font_size_override("font_size",roundi(px*(1.25 if ui._large() else 1.0)))
	else:
		button = Button.new()
		button.theme_type_variation = &"QuietButton"
		button.text = copy if not wrap else ""
		button.custom_minimum_size = Vector2(156,48)
		button.add_theme_font_size_override("font_size",roundi(px*(1.25 if ui._large() else 1.0)))
		parent.add_child(button)
		if wrap:
			var label := _label(button,copy,px)
			label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
			label.offset_left=18;label.offset_right=-18;label.offset_top=10;label.offset_bottom=-10
			label.mouse_filter=Control.MOUSE_FILTER_IGNORE
			label.vertical_alignment=VERTICAL_ALIGNMENT_CENTER
			button.accessibility_name=copy
			button.resized.connect(func():
				var pixels := label.get_theme_font_size("font_size")
				var measured := label.get_theme_font("font").get_multiline_string_size(copy,HORIZONTAL_ALIGNMENT_LEFT,maxf(264,button.size.x-36),pixels)
				button.custom_minimum_size.y=maxf(48,ceilf(measured.y)+20))
	button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	button.set_meta("focus_id",id)
	button.set_meta("focus_uid",id+"@"+scope(parent)+"#"+str(ui.focus_ids.count(id)))
	button.pressed.connect(callback)
	ui.rail.append(button); ui.focus_ids.append(id)
	return button


func _copy(n: Dictionary, row: C.ProtoMessage) -> String:
	var parts: Array[String] = []
	if not n.get("text_key","").is_empty(): parts.append(ui.tr(n.text_key))
	for field in ["text","title","meta","reason"]:
		if n.get("bind",{}).has(field):
			var v = ui.value(n.bind[field],row)
			if v is Array:
				for line in v: parts.append(str(line))
			elif v != null and not str(v).is_empty():
				if n.get("formatter","")=="datetime":
					var date:=Time.get_datetime_dict_from_unix_time(int(v)/1000)
					var fields:={}
					for key in date:fields[key]=str(date[key]).pad_zeros(4 if key=="year" else 2)
					parts.append(ui.tr(n.format_key).format(fields))
				else:parts.append(str(v))
	return str(n.get("join","\n")).join(parts)


func _row_title(nodes: Array, row: C.ProtoMessage) -> String:
	for n in nodes:
		if n.kind=="label":
			var copy := _copy(n,row)
			if not copy.is_empty(): return copy
		elif n.kind!="list":
			var copy := _row_title(n.get("children",[]),row)
			if not copy.is_empty(): return copy
	return ""


func _truth(v: Variant) -> bool:
	if v == null: return false
	if v is bool: return v
	if v is String or v is Array or v is Dictionary: return not v.is_empty()
	return true


func _node(n: Dictionary, parent: Node, row: C.ProtoMessage) -> void:
	var bindings: Dictionary = n.get("bind",{})
	if bindings.has("visible") and not _truth(ui.value(bindings.visible,row)): return
	if bindings.has("visible_not") and _truth(ui.value(bindings.visible_not,row)):return
	match n.kind:
		"region":
			var panel := PanelContainer.new()
			var plate := StyleBoxFlat.new()
			plate.bg_color=Color("18201fee");plate.border_color=Color("7f8d83")
			for side in range(4):plate.set_content_margin(side,12);plate.set_border_width(side,1)
			panel.add_theme_stylebox_override("panel",plate)
			parent.add_child(panel)
			panel.position=Vector2(n.rect[0],n.rect[1]);panel.size=Vector2(n.rect[2],n.rect[3])
			var scroll := ScrollContainer.new()
			scroll.horizontal_scroll_mode=ScrollContainer.SCROLL_MODE_DISABLED
			scroll.follow_focus=true;scroll.set_meta("scroll_id",ui.screen_id+"/"+n.id)
			var column:=VBoxContainer.new()
			panel.add_child(column)
			for child in n.get("children",[]):
				if child.get("dock","")=="top":_node(child,column,row)
			scroll.size_flags_vertical=Control.SIZE_EXPAND_FILL
			column.add_child(scroll)
			if n.get("focusable",false):
				scroll.focus_mode=Control.FOCUS_ALL;scroll.set_meta("focus_id",n.id);scroll.set_meta("focus_uid",n.id+"#0");ui.rail.append(scroll);ui.focus_ids.append(n.id)
			var box := VBoxContainer.new()
			box.size_flags_horizontal=Control.SIZE_EXPAND_FILL
			scroll.add_child(box)
			for child in n.get("children",[]):
				if child.get("dock","")!="top":_node(child,box,row)
		"label":
			var copy := _copy(n,row)
			if not copy.is_empty():
				var label:=_label(parent,copy,n.font_px)
				label.theme_type_variation=n.get("style","")
				label.set_meta("control_id",n.id)
		"button":
			var b := _button(parent,_copy(n,row),ui._act.bind(n.action,row),n.id,n.get("mode","")=="response",n.font_px)
			b.set_meta("row",row)
			# Refused actions stay reachable; selecting one shows the server reason.
			if bindings.has("enabled") and not ui.value(bindings.enabled,row): b.modulate.a = 0.65
		"list":
			var rows: Array=rows_for(n,row)
			if rows.is_empty():
				_label(parent,ui.tr(n.get("empty_key","") if not n.get("empty_key","").is_empty() else Catalog.specification().text.empty),18)
				return
			if n.get("mode","")=="choices":
				var flow := HFlowContainer.new()
				parent.add_child(flow)
				for item in rows:
					var b:=_button(flow,_row_title(n.get("children",[]),item),ui._select.bind(n.id,item),n.id,true)
					b.custom_minimum_size.x=300
					b.set_meta("row",item);b.toggle_mode=true;b.button_pressed=item==ui.selected.get(n.id)
				return
			if n.get("mode","select") == "cards":
				for item in rows:
					var card := VBoxContainer.new()
					card.add_theme_constant_override("separation",8)
					card.set_meta("row_scope",n.id+"="+identity(n,item))
					parent.add_child(card)
					for child in n.get("children",[]): _node(child,card,item)
					parent.add_child(HSeparator.new())
				return
			var split := HBoxContainer.new()
			split.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			split.size_flags_vertical = Control.SIZE_EXPAND_FILL
			split.add_theme_constant_override("separation",24)
			parent.add_child(split)
			var list_scroll := ScrollContainer.new()
			list_scroll.set_meta("scroll_id",ui.screen_id+"/"+n.id+"/list")
			list_scroll.custom_minimum_size = Vector2(330,240)
			list_scroll.follow_focus = true
			list_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
			split.add_child(list_scroll)
			var list := VBoxContainer.new()
			list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			list_scroll.add_child(list)
			var current: C.ProtoMessage=ui.selected.get(n.id,rows[0])
			ui.selected[n.id] = current
			for index in range(rows.size()):
				var item: C.ProtoMessage = rows[index]
				var copy := _row_title(n.get("children",[]),item)
				if copy.is_empty(): copy = ui.tr(Catalog.specification().text.inspect)+" "+str(index+1)
				var b := _button(list,copy,ui._select.bind(n.id,item),n.id,true)
				b.set_meta("row",item)
				b.set_meta("focus_uid",n.id+"="+identity(n,item))
				b.set_meta("selected",item==current)
				b.toggle_mode=true
				b.button_pressed=item==current
				b.custom_minimum_size.x = 300
			var detail_scroll := ScrollContainer.new()
			detail_scroll.set_meta("scroll_id",ui.screen_id+"/"+n.id+"/detail")
			ui.scroll_targets.append(detail_scroll)
			detail_scroll.custom_minimum_size.y = 240
			detail_scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			detail_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
			detail_scroll.follow_focus = true
			detail_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
			split.add_child(detail_scroll)
			var detail := VBoxContainer.new()
			detail.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			detail.add_theme_constant_override("separation",10)
			detail_scroll.add_child(detail)
			for child in n.get("children",[]): _node(child,detail,current)
		"image":
			var art:=TextureRect.new()
			art.texture=Catalog.image(n.widget);art.expand_mode=TextureRect.EXPAND_IGNORE_SIZE;art.stretch_mode=TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			art.custom_minimum_size.y=n.get("height_px",320);art.mouse_filter=Control.MOUSE_FILTER_IGNORE;parent.add_child(art)
		"custom":
			var widget: Control=Catalog.widget(n.widget)
			parent.add_child(widget)
			widget.custom_minimum_size.y=n.get("height_px",320)
			widget.size_flags_horizontal=Control.SIZE_EXPAND_FILL
			var values:={}
			for key in bindings:values[key]=ui.value(bindings[key],row)
			var context:={"host":ui.host,"theme":ui.theme,"reduced_motion":ui._motion(),"text_scale":1.25 if ui._large() else 1.0,"portrait_fallback":Catalog.specification().get("portrait_fallback","")}
			var selected_row:=func(item):
				if n.has("action"):ui._act(n.action,item)
			var focus: Array=widget.configure_screen(values,context,selected_row)
			if not n.get("passive",false):
				for b in focus:
					b.set_meta("focus_id",n.id);b.set_meta("focus_uid",n.id+"#"+str(ui.focus_ids.count(n.id)));ui.rail.append(b);ui.focus_ids.append(n.id)

		_:
			var box := BoxContainer.new()
			box.vertical = n.kind != "row"
			box.size_flags_stretch_ratio=n.get("weight",1.0)
			box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			box.add_theme_constant_override("separation",12)
			parent.add_child(box)
			for child in n.get("children",[]): _node(child,box,row)


func rows_for(n: Dictionary,row: C.ProtoMessage) -> Array:
	var rows=ui.value(n.bind.source,row)
	if not rows is Array:return []
	if n.has("where"):return rows.filter(func(item):return _truth(ui.value(n.where,item)))
	return rows
func identity(n: Dictionary,row: C.ProtoMessage) -> String:
	var data: Dictionary=row.to_dict()
	var keys: Array=n.get("row_keys",[]).duplicate()
	if not n.get("row_key","").is_empty():keys.append(n.row_key)
	if keys.is_empty():return JSON.stringify(data)
	var result:=[]
	for key in keys:result.append(data.get(key))
	return JSON.stringify(result)
func scope(parent: Node) -> String:
	var result: Array[String]=[]
	var node:=parent
	while node!=null and node!=ui.content:
		if node.has_meta("row_scope"):result.append(str(node.get_meta("row_scope")))
		node=node.get_parent()
	return "/".join(result)
