// buskerBeforeFrame: the routine override for this frame by the plan and the phase.
func (r *Runtime) buskerBeforeFrame() {
	if !r.buskerOn() {
		return
	}
	b := r.world.Busker
	a := r.state.Life.Actor(b.Actor)
	if a.CombatHold || r.serviceReserved(b.Actor) {
		return
	}
	s := &r.state.Busker
	want, block, p := r.buskerWant()
	var step *behavior.LifeStep
	switch {
	case s.Phase != "":
		// set up: he stays on his stool until he has packed
		label := map[string]string{"unpack": b.Day.Labels.Unpack, "play": b.Day.Labels.Play, "rest": b.Day.Labels.Rest, "pack": b.Day.Labels.Pack}[s.Phase]
		step = &behavior.LifeStep{Level: b.Level, At: b.Spot.Seat.cell(), Activity: "post", Label: label, Obligation: true}
	case want == "spot":
		step = &behavior.LifeStep{Level: b.Level, At: b.Spot.Seat.cell(), Activity: "post", Label: b.Day.Labels.Walk, Obligation: true}
	case want == "tea":
		br := b.Day.Breaks[p.Blocks[block].Break]
		step = &behavior.LifeStep{Level: br.At.Level, At: br.SeatCells[s.Seat-1].cell(), Activity: "post", Label: br.Label, Obligation: true}
	case want != "home" && block >= 0:
		br := b.Day.Breaks[p.Blocks[block].Break]
		step = &behavior.LifeStep{Level: br.At.Level, At: br.At.At.cell(), Activity: "rest", Label: br.Label, Obligation: true}
	}
	if step == nil {
		if a.RoutineOverride != nil {
			a.RoutineOverride = nil
			a.Arrived, a.Path = false, nil
		}
		return
	}
	if o := a.RoutineOverride; o == nil || o.Level != step.Level || o.At != step.At || o.Label != step.Label {
		if o == nil || o.Level != step.Level || o.At != step.At {
			a.Arrived, a.Path = false, nil
		}
		a.RoutineOverride = step
		// a new label on the cell he holds: the observed activity follows at once
		if a.Arrived && a.Level == step.Level && a.Position == step.At {
			a.Label = step.Label
		}
	}
}

// advanceBusker: after the Life frame — the phase at the spot, the tune, the hero by the case.
func (r *Runtime) advanceBusker() {
	if !r.buskerOn() {
		return
	}
	b := r.world.Busker
	s := &r.state.Busker
	now := r.state.Life.Seconds
	want, block, p := r.buskerWant()
	setKind := ""
	if block >= 0 && want == "spot" {
		setKind = p.Blocks[block].Kind
		if setKind == "tea" {
			setKind = "rest"
		}
	}
	if want == "spot" && block < 0 {
		setKind = "rest"
	}
	enter := func(phase string) {
		if s.Phase == "play" && phase != "play" {
			s.Tune = 0
		}
		s.Phase, s.Since = phase, now
		if phase == "play" {
			s.Tune, s.TuneTick = 0, r.state.Tick+buskerSpan(r.buskerDraw(p.Day, fmt.Sprintf("gap.%d", s.Tunes)), b.GapTicks)/2
		}
	}
	switch s.Phase {
	case "":
		if want == "spot" && r.buskerAtSeat() {
			enter("unpack")
		}
	case "unpack":
		if now-s.Since >= b.Day.UnpackSeconds {
			switch {
			case want != "spot":
				enter("pack")
			case setKind == "set":
				enter("play")
			default:
				enter("rest")
			}
		}
	case "play", "rest":
		next := "pack"
		if want == "spot" {
			next = "rest"
			if setKind == "set" {
				next = "play"
			}
		}
		if next != s.Phase {
			// a tune near its end is played out (20 s); a longer one stops at once
			if s.Phase == "play" && s.Tune > 0 {
				t := b.Tunes[s.Tune-1]
				if left := s.TuneTick + t.Ticks - r.state.Tick; left > 0 && left <= int64(20*b.TickHz) {
					break
				}
			}
			enter(next)
		}
	case "pack":
		if now-s.Since >= b.Day.PackSeconds {
			s.Phase, s.Since, s.Tune = "", now, 0
		}
	}
	// he was moved off his stool (a fight, an order): not set up any more
	if s.Phase != "" && !r.buskerAtSeat() {
		s.Phase, s.Tune = "", 0
	}
	if s.Phase == "play" {
		r.buskerTunes()
	}
	r.buskerHero()
}

// buskerTunes: the tune that sounds (server ticks: the music is real time at every calendar rate).
func (r *Runtime) buskerTunes() {
	b := r.world.Busker
	s := &r.state.Busker
	tick := r.state.Tick
	if s.Tune > 0 {
		if tick < s.TuneTick+b.Tunes[s.Tune-1].Ticks {
			return
		}
		s.Tune = 0
		s.TuneTick = tick + buskerSpan(r.buskerDraw(s.Tunes, "gap"), b.GapTicks)
		return
	}
	if tick < s.TuneTick {
		return
	}
	// the next tune by the draw, never the one just played
	n := int(r.buskerDraw(s.Tunes, "tune") % uint64(len(b.Tunes)))
	if n == s.Last-1 && len(b.Tunes) > 1 {
		n = (n + 1) % len(b.Tunes)
	}
	s.Tunes++
	s.Tune, s.TuneTick, s.Last = n+1, tick, n+1
}

// buskerTuneNow: the tune that sounds (nil: none).
func (r *Runtime) buskerTuneNow() *buskerTune {
	if !r.buskerPlaying() {
		return nil
	}
	return &r.world.Busker.Tunes[r.state.Busker.Tune-1]
}

// buskerNear: the hero stands still within cells of the case on the musician's level.
func (r *Runtime) buskerNear(cells int) bool {
	b := r.world.Busker
	h := r.state.Life.Actor(playerActorID)
	if h == nil || h.Trip != nil || h.Level != b.Level {
		return false
	}
	return behavior.Distance(h.Position, b.Spot.Case.cell()) <= cells
}

// buskerHero: the conversation by the case opens when the hero has stopped next to it while the musician is set up
// (playing or resting), once per approach; it closes when he walks off.
func (r *Runtime) buskerHero() {
	b := r.world.Busker
	s := &r.state.Busker
	h := r.state.Life.Actor(playerActorID)
	if h == nil || !r.buskerNear(b.Hero.LeaveCells) || (s.Phase != "play" && s.Phase != "rest") {
		s.Open, s.Closed, s.Reply, s.ReplyArg = false, false, "", ""
		return
	}
	still := len(h.Path) == 0 && (h.Body == nil || !h.Body.Moving)
	if !s.Open && !s.Closed && still && r.buskerNear(b.Hero.ReachCells) && !r.heroInCombat() {
		s.Open = true
	}
}

// appendBuskerConversation: the hero's lines with the musician (state.conversation), unless another conversation is open.
func (r *Runtime) appendBuskerConversation(msg *pb.PocGameState, locale string) {
	if msg.Conversation != nil || !r.buskerOn() {
		return
	}
	b := r.world.Busker
	s := r.state.Busker
	if !s.Open || s.Closed || r.heroInCombat() {
		return
	}
	text := func(key string) string { return r.localText(locale, key, key) }
	body := text(b.Lines["intro_rest"])
	if s.Phase == "play" {
		body = text(b.Lines["intro_play"])
	}
	if s.Reply != "" {
		body = strings.ReplaceAll(text(s.Reply), "{tune}", text(s.ReplyArg))
	}
	v := &pb.PocConversation{Kind: "busker", Id: "busker", Speaker: b.Actor, Text: body}
	add := func(id, key string) {
		v.Choices = append(v.Choices, &pb.PocConversationChoice{Id: id, Text: text(key), Action: "busker_choice"})
	}
	add("tune", b.Lines["ask_tune"])
	add("bayan", b.Lines["ask_bayan"])
	add("why", b.Lines["ask_why"])
	for i, amount := range b.Hero.TipsMinor {
		v.Choices = append(v.Choices, &pb.PocConversationChoice{Id: "tip." + strconv.Itoa(i), Text: strings.ReplaceAll(text(b.Lines["tip"]), "{crd}", r.buskerMoney(amount)), Action: "busker_choice"})
	}
	add("listen", b.Lines["listen"])
	add("bye", b.Lines["bye"])
	v.SpeakerName = r.craftingActorName(locale, b.Actor)
	v.Skin = "copper"
	v.CasteName = r.localText(locale, "ui.caste."+v.Skin, "")
	msg.Conversation = v
}

func (r *Runtime) buskerMoney(minor int64) string {
	scale := r.world.Inventory.Currencies["CRD"].Scale
	if scale < 1 {
		scale = 1
	}
	return inv.FormatMoney(minor, scale)
}

// buskerCommand: the hero's choice in the conversation by the case.
func (r *Runtime) buskerCommand(q *pb.PocLifeCommand) error {
	if !r.buskerOn() {
		return textError{Key: "error.encounter.unavailable"}
	}
	b := r.world.Busker
	s := &r.state.Busker
	if !s.Open || s.Closed || !r.buskerNear(b.Hero.LeaveCells) || (s.Phase != "play" && s.Phase != "rest") {
		return textError{Key: "error.encounter.unavailable"}
	}
	switch id := q.Destination; {
	case id == "tune":
		s.Reply, s.ReplyArg = b.Lines["tune_none"], ""
		if t := r.buskerTuneNow(); t != nil {
			s.Reply, s.ReplyArg = b.Lines["tune"], t.NameKey
		}
	case id == "bayan":
		s.Reply, s.ReplyArg = b.Lines["bayan"], ""
	case id == "why":
		s.Reply, s.ReplyArg = b.Lines["why"], ""
	case strings.HasPrefix(id, "tip."):
		i, err := strconv.Atoi(strings.TrimPrefix(id, "tip."))
		if err != nil || i < 0 || i >= len(b.Hero.TipsMinor) {
			return textError{Key: "error.encounter.unavailable"}
		}
		// the palm on the reader of the case: within reach of it (a pay cell or right beside the case)
		if !r.buskerNear(1) {
			return textError{Key: "error.encounter.unavailable"}
		}
		amount := b.Hero.TipsMinor[i]
		hero, ok := r.peddlerAccount(playerActorID)
		if !ok || !r.visitorMove(hero.ID, b.Account, amount) {
			s.Reply, s.ReplyArg = b.Lines["no_money"], ""
			return nil
		}
		s.Tips++
		s.Earned += amount
		s.Reply, s.ReplyArg = b.Lines["thanks"], ""
		if i == len(b.Hero.TipsMinor)-1 && len(b.Hero.TipsMinor) > 1 {
			s.Reply = b.Lines["thanks_big"]
		}
	case id == "listen" || id == "bye":
		s.Closed, s.Reply, s.ReplyArg = true, "", ""
	default:
		return textError{Key: "error.encounter.unavailable"}
	}
	return nil
}

// buskerActivity (presentation): his phase at the spot on his body — activity "busk", the phase, the stool as the spot
// (seated while he plays or rests, standing at it while he unpacks or packs), the tune and the tick it began (sim ns).
func (r *Runtime) buskerActivity(a *pb.PocAgentState, id string) bool {
	if !r.buskerOn() || id != r.world.Busker.Actor || !r.buskerSetUp() || !r.buskerAtSeat() {
		return false
	}
	b := r.world.Busker
	s := r.state.Busker
	sp := b.Spot
	pose, yaw := "sit", sp.YawDeg
	if s.Phase == "unpack" || s.Phase == "pack" {
		// standing at his stool, turned to the case beside it
		pose = "stand"
		yaw = math.Atan2(float64(sp.Case.X-sp.Seat.X), float64(sp.Case.Y-sp.Seat.Y)) * 180 / math.Pi
	}
	a.Activity = "busk"
	a.ActivityPhase = s.Phase
	a.ActivitySpot = &pb.PocActivitySpot{Id: "busker.seat", Pose: pose, CellX: int32(sp.Seat.X), CellY: int32(sp.Seat.Y), XMm: int32(sp.SeatMM.X), YMm: int32(sp.SeatMM.Y), ZMm: int32(sp.SeatMM.Z), YawDeg: yaw}
	a.ActivitySinceSeconds = s.Since
	a.ActivitySinceNs = r.lifeGameNS(s.Since)
	a.ActivityPhaseNs = a.ActivitySinceNs
	switch s.Phase {
	case "unpack":
		a.ActivityTransitionNs = r.lifeMotionDurationNS(b.Day.UnpackSeconds)
	case "pack":
		a.ActivityTransitionNs = r.lifeMotionDurationNS(b.Day.PackSeconds)
	case "play":
		// the tune and the server tick it began; between two tunes, none and the tick the next one begins
		a.ActivityPhaseNs = s.TuneTick * r.tickNS()
		if s.Tune > 0 {
			a.ActivityItem = b.Tunes[s.Tune-1].ID
		}
	}
	return true
}

// buskerBodies: the stool and the case stand on the floor while he is set up (solid for everybody).
func (r *Runtime) buskerBodies(add func(string, behavior.Cell)) {
	if !r.buskerSetUp() {
		return
	}
	add(r.world.Busker.Level, r.world.Busker.Spot.Case.cell())
}

// ---------------------------------------------------------------- the listeners (the hall's visitors)

// buskerHears: a cell within earshot while he plays.
func (r *Runtime) buskerHears(at behavior.Cell) bool {
	if !r.buskerPlaying() {
		return false
	}
	b := r.world.Busker
	return behavior.Distance(at, b.Spot.Seat.cell()) <= b.Listeners.HearCells
}

// buskerNotice: a walker who has just stepped within earshot while he plays — once a visit, by his draw — stops at a free
// listening place (what he was walking to stays first on his list). One who carries his meal to a table, goes to pay or
// already listens does not.
func (r *Runtime) buskerNotice(b *visitorBody) {
	if b.Heard || !r.buskerOn() || !r.buskerHears(b.At) {
		return
	}
	b.Heard = true
	if b.Table > 0 || b.Paying || b.Listen > 0 || (b.Phase != "walk" && b.Phase != "leave") {
		return
	}
	k := r.world.Busker
	if int64(r.visitorDraw(b.Serial, "listen.stop")%1000) >= k.Listeners.StopPermille {
		return
	}
	i, ok := r.buskerListenSpot(b.Serial)
	if !ok {
		return
	}
	path, ok := r.visitorPath(b.At, k.Spot.Listen[i].At.cell())
	if !ok {
		return
	}
	if b.Phase == "walk" && b.Target != "" {
		cat := r.world.Visitors.PeddlerCategory
		if t := r.visitorTargetOf(b.Target); t != nil {
			cat = t.Category
		}
		b.Stops = append([]visitorStop{{Category: cat, Units: b.Units}}, b.Stops...)
	}
	b.Phase, b.Target, b.Units, b.Path, b.Listen = "walk", "", 0, append([]behavior.Cell(nil), path...), i+1
	r.state.Busker.Stopped++
}

// visitorStepTicks: the ticks of the walker's next step — within earshot of the music some step slower (by his draw).
func (r *Runtime) visitorStepTicks(b visitorBody) int64 {
	n := r.world.Visitors.MoveTicks
	if r.buskerOn() && r.buskerHears(b.At) && int64(r.visitorDraw(b.Serial, "listen.slow")%1000) < r.world.Busker.Listeners.SlowPermille {
		return max(n, r.world.Busker.Listeners.SlowMoveTicks)
	}
	return n
}

// buskerListened: the listener's time is up (or the music stopped): by his draw he walks to a free pay cell by the case,
// else on to the rest of his list.
func (r *Runtime) buskerListened(b *visitorBody) {
	k := r.world.Busker
	b.Listen = 0
	if r.buskerSetUp() && int64(r.visitorDraw(b.Serial, "listen.pay")%1000) < k.Listeners.PayPermille {
		taken := r.visitorSpotsTaken()
		for _, c := range k.Spot.Pay {
			if taken[c.cell()] > 0 {
				continue
			}
			if path, ok := r.visitorPath(b.At, c.cell()); ok {
				b.Phase, b.Target, b.Units, b.Path, b.Paying = "walk", "", 0, append([]behavior.Cell(nil), path...), true
				return
			}
		}
	}
	r.visitorHead(b)
}

// buskerListenSpot: a free listening place (index), none while listeners.max stand or head there.
func (r *Runtime) buskerListenSpot(serial int64) (int, bool) {
	b := r.world.Busker
	held := map[int]bool{}
	n := 0
	for _, o := range r.state.Visitors.Bodies {
		if o.Listen > 0 {
			held[o.Listen-1] = true
			n++
		}
	}
	if n >= b.Listeners.Max {
		return 0, false
	}
	blocked := r.state.Life.BlockedCells(b.Level, "")
	taken := map[behavior.Cell]bool{}
	for _, o := range r.state.Visitors.Bodies {
		taken[o.At] = true
	}
	free := []int{}
	for i, l := range b.Spot.Listen {
		c := l.At.cell()
		if !held[i] && !blocked[c] && !taken[c] {
			free = append(free, i)
		}
	}
	if len(free) == 0 {
		return 0, false
	}
	return free[r.visitorDraw(serial, "listen.spot")%uint64(len(free))], true
}

// buskerPayAct: the walker's palm on the reader of the case while he pays (the ring flashes in the first ring_ticks).
func (r *Runtime) buskerPayAct(b visitorBody) *pb.PocMachineAct {
	k := r.world.Busker
	if b.Phase != "pay" || b.Going || len(b.Path) > 0 {
		return nil
	}
	n := k.Listeners.PayTicks + 1
	start := r.state.Tick - (k.Listeners.PayTicks - b.Wait)
	rd := k.Spot.ReaderMM
	return &pb.PocMachineAct{Name: "pay_reader", Tick: start, Ticks: int32(n), Touches: []*pb.PocMachineTouch{{
		X: float64(rd.X) / 1000, Y: float64(rd.Y) / 1000, Z: float64(rd.Z) / 1000, Hand: "right", Part: "palm",
		FromTick: int32(min(int64(6), n/4)), ToTick: int32(n - min(int64(6), n/4)),
	}}}
}

// buskerPaid: a listener's money onto his account (the purse of the walker's slot -> the musician's account).
func (r *Runtime) buskerPaid(slot string, serial int64) {
	k := r.world.Busker
	amount := buskerSpan(r.visitorDraw(serial, "listen.pay.minor"), k.Listeners.PayMinor)
	from := r.visitorAccount(slot)
	if a := r.state.Inventory.Accounts[from]; a.Balance < amount {
		amount = a.Balance
	}
	if amount > 0 && r.visitorMove(from, k.Account, amount) {
		r.state.Busker.Paid++
		r.state.Busker.Earned += amount
	}
}

// buskerMaxWait: the longest a walker waits in a phase of the musician's (a listener, a payer); 0 without him.
func (r *Runtime) buskerMaxWait() int64 {
	l := r.world.Busker.Listeners
	return max(l.ListenTicks.Max, l.PayTicks)
}

func (r *Runtime) validateBuskerSave(s state) error {
	b := r.world.Busker
	v := s.Busker
	if b.Actor == "" {
		if v != (buskerState{}) {
			return errors.New("a musician's state in a world without him")
		}
		return nil
	}
	switch v.Phase {
	case "", "unpack", "play", "rest", "pack":
	default:
		return errors.New("invalid saved musician phase")
	}
	if v.Tune < 0 || v.Tune > len(b.Tunes) || v.Last < 0 || v.Last > len(b.Tunes) || (v.Tune > 0 && v.Phase != "play") || v.Since < 0 || v.Since > s.Life.Seconds || v.TuneTick < 0 || v.Tunes < 0 ||
		v.Seat < -1 || v.Seat > 8 || v.Stopped < 0 || v.Paid < 0 || v.Earned < 0 || v.Tips < 0 {
		return errors.New("invalid saved musician state")
	}
	for _, o := range s.Visitors.Bodies {
		if o.Listen < 0 || o.Listen > len(b.Spot.Listen) || (o.Phase == "listen" && o.Listen == 0) || (o.Phase == "pay" && !o.Paying) {
			return errors.New("invalid saved listener")
		}
	}
	return nil
}
