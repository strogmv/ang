   foreach(var h in locationSDKHumanoids.Values){if(h.go==null||!h.go.activeSelf)continue;var rig=h.animator.GetComponent<PocCombatContactRig>();
    if(rig!=null&&rig.built)CombatBodyIK(h,rig,look);
