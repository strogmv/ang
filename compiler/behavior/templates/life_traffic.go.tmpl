   eligible:=(s.ControlledActorID!=""||autonomous)&&a.ID!=s.ControlledActorID&&a.ID!=who&&!a.Manual&&!a.Arrived&&a.Activity=="walking"&&a.Goal!=a.Position&&len(a.Path)==0&&tick>=a.YieldUntil&&tick>=a.YieldCooldownUntil&&!atWork&&s.courtesyNamedWilling(m,a,who)&&!s.courtesyFinishingAhead(m,who,a.ID,a.Level,a.Position,a.Goal)
   courteous:=s.courtesyNamed(m,a,who,tick)
   if (eligible||courteous)&&at==b.position{if index>best{resident=lifeYieldResident{index,true,!eligible&&courteous};best=index;found=true}}else{hard=true}
  }else{j:=index-len(s.Actors);a:=s.Population.Actors[j];if s.courtesyPopulation(m,a,who,tick)&&at==b.position{if index>best{resident=lifeYieldResident{j,false,false};best=index;found=true}}else{hard=true}}
 };return hard,resident,found
}

