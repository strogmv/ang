	claims, err := authClaimsFromCookieSession(r)
	if err != nil {
		return wsIdentity{}, err
	}
	ac := authContextFromClaims(claims)
	if ac.UserID == "" {
		return wsIdentity{}, fmt.Errorf("ws auth: session has no user")
	}
	return wsIdentity{UserID: ac.UserID, CompanyID: ac.CompanyID}, nil
