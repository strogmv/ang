   if(s.pool_m>0&&!b.pair){var at=point;at.y=victim.go.transform.position.y+.004f;at+=normal*.1f;var pool=CombatBloodPiece("floor pool",at,Quaternion.identity,new Vector3(.001f,.002f,.001f));bleed.pool=pool.transform;bleed.poolSize=s.pool_m;}
