# Initial defaults for local development.
# ang build regenerates a complete .env.example from generated config schema.
HTTP_PORT=8080
DATABASE_URL=postgres://app:app@localhost:5439/app?sslmode=disable
JWT_ALG=HS256
JWT_PRIVATE_KEY=secret-key-for-tests
JWT_PUBLIC_KEY=
EMAIL_PROVIDER=noop
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=app-local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM=dev@example.com
