	base, err := inv.Quote(d, 1)
	if err != nil || base < 1 {
		return 0
	}
	price := base * 1000
	if c, _, ok := r.world.Crafting.PartOf(i.Definition); ok {
		price = price * r.world.Crafting.ScarcityPermille(c.ID, stock[c.ID]) / 1000
	}
	legal := r.world.Peddlers.Legality[i.Definition]
	if legal == "" {
		legal = "legal"
	}
	if risk := r.world.Crafting.Economy.RiskPermille[legal]; risk > 0 {
		price = price * risk / 1000
	}
	a := r.world.Peddlers.Appraisal
	q, o := r.peddlerGrade(i)
	if q >= 1 && q <= len(a.QualityPermille) {
		price = price * a.QualityPermille[q-1] / 1000
	}
	if k := a.OriginPermille[o]; k > 0 {
		price = price * k / 1000
	}
	price = price * (300 + 700*i.Condition/1000000) / 1000
	return max(1, (price+999)/1000)
}

// peddlerBuyPrice: what the cart man pays for one unit of a carried thing (by weight on his steelyard, never under the
// floor share of the law's price), and whether he takes it at all (his classes and things; nothing forbidden in the dome).
func (r *Runtime) peddlerBuyPrice(p peddlerDef, i inv.Item, stock map[string]int64) (int64, bool) {
