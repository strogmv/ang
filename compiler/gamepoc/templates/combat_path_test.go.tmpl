// Code generated by ANG. The path on the floor (HUD v1.1): the walk the HUD shows before it is ordered is the move
// command's own. DO NOT EDIT.
package poc

import (
	"reflect"
	"testing"

	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

// combatPathAsk sends the HUD's question over the ordinary command wire and reads the one answer.
func combatPathAsk(t *testing.T, r *Runtime, c *connection, seq int32, at behavior.Cell) *pb.PocCombatPath {
	t.Helper()
	for len(c.out) > 0 {
		<-c.out
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_CombatPreview{CombatPreview: &pb.PocCombatPreview{Epoch: r.state.Epoch, ExpectedTurn: r.state.Combat.Turn, Seq: seq, X: int32(at.X), Y: int32(at.Y)}}}})
	var answer *pb.PocCombatPath
	sent := 0
	for len(c.out) > 0 {
		m := <-c.out
		sent++
		if p := m.GetCombatPath(); p != nil {
			answer = p
		}
	}
	if answer == nil || sent != 1 {
		t.Fatalf("a question about %v was answered with %d messages, an answer among them: %v", at, sent, answer != nil)
	}
	if answer.Seq != seq || answer.X != int32(at.X) || answer.Y != int32(at.Y) {
		t.Fatalf("the answer %+v is not about question %d of %v", answer, seq, at)
	}
	return answer
}

// combatPathWalk orders the same move on a copy of the runtime: the points charged, the cells walked, whether the hero
// arrived, or the refusal.
func combatPathWalk(r *Runtime, at behavior.Cell) (charged int, walked []behavior.Cell, arrived bool, err error) {
	trial := &Runtime{world: r.world, state: r.snapshotState(), npcAccountIDs: r.npcAccountIDs}
	before := trial.state.Combat.Actor(playerActorID).AP
	seq := trial.state.Combat.EventSeq
	action := behavior.CombatAction{Type: "move", To: at}
	if err = trial.performCombatAction(playerActorID, &action); err != nil {
		return 0, nil, false, err
	}
	for _, e := range trial.state.Combat.Events {
		if e.Sequence > seq && e.ActorID == playerActorID && e.Type == "move" {
			walked = append(walked, e.To)
		}
	}
	hero := trial.state.Combat.Actor(playerActorID)
	return before - hero.AP, walked, hero.Position == at, nil
}

// The shown walk is the ordered walk: for every cell of the reach border the previewed cost equals the points the move
// command charges and the previewed cells are the cells walked; a cell nobody can stand on, a fighter's own cell and a
// cell past the points left are refused by the preview with the reason and by the move command alike; a question
// changes nothing; outside the hero's turn or with a stale turn there is no path.
func TestCombatPathPreviewIsTheMoveCommandsOwn(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_knife", "ru")
	if p := combatPathAsk(t, r, c, 1, behavior.Cell{X: 1, Y: 1}); p.Ok || p.Code != "stale" || len(p.Path) != 0 || p.Reason != "" {
		t.Fatalf("a path out of a fight: %+v", p)
	}
	combatEpisodeEngage(t, r, c, d)
	if !combatEpisodeHeroTurn(r) {
		t.Fatal("the hero never got a turn")
	}
	view := combatEpisodeView(r, c)
	if view == nil || view.Combat == nil {
		t.Fatal("no view of the fight")
	}
	hero := *r.state.Combat.Actor(playerActorID)
	if hero.AP < 2 {
		t.Fatalf("the hero starts his turn with %d points", hero.AP)
	}
	reach := map[behavior.Cell]bool{}
	if len(view.Combat.ReachX) != len(view.Combat.ReachY) || len(view.Combat.ReachX) < 4 {
		t.Fatalf("the reach border has %d / %d cells", len(view.Combat.ReachX), len(view.Combat.ReachY))
	}
	for i := range view.Combat.ReachX {
		reach[behavior.Cell{X: int(view.Combat.ReachX[i]), Y: int(view.Combat.ReachY[i])}] = true
	}
	if !reach[hero.Position] {
		t.Fatal("the hero's own cell is not inside his reach border")
	}
	before := r.state.Combat.Clone()
	seq := int32(1)
	exact, costs := 0, map[int32]bool{}
	for at := range reach {
		if at == hero.Position {
			continue
		}
		seq++
		p := combatPathAsk(t, r, c, seq, at)
		if !p.Ok || p.Code != "" || p.Reason != "" || p.Ap < 1 || int(p.Ap) > hero.AP || len(p.Path) == 0 || int(p.Afford) != len(p.Path) {
			t.Fatalf("cell %v is inside the reach border, the preview says %+v (the hero has %d points)", at, p, hero.AP)
		}
		if last := p.Path[len(p.Path)-1]; int(last.X) != at.X || int(last.Y) != at.Y {
			t.Fatalf("the path to %v ends at %v", at, last)
		}
		charged, walked, arrived, err := combatPathWalk(r, at)
		if err != nil {
			t.Fatalf("the preview allows the walk to %v for %d points, the move command refuses it: %v", at, p.Ap, err)
		}
		if !arrived {
			// a reaction stopped the walk: the cells walked are still the previewed ones
			for i, w := range walked {
				if int(p.Path[i].X) != w.X || int(p.Path[i].Y) != w.Y {
					t.Fatalf("the interrupted walk to %v left the previewed path at step %d", at, i)
				}
			}
			continue
		}
		if charged != int(p.Ap) {
			t.Fatalf("the walk to %v was previewed at %d points and charged %d", at, p.Ap, charged)
		}
		if len(walked) != len(p.Path) {
			t.Fatalf("the walk to %v took %d steps, the preview showed %d", at, len(walked), len(p.Path))
		}
		for i, w := range walked {
			if int(p.Path[i].X) != w.X || int(p.Path[i].Y) != w.Y {
				t.Fatalf("the walk to %v left the previewed path at step %d: %v, shown %v", at, i, w, p.Path[i])
			}
		}
		exact++
		costs[p.Ap] = true
	}
	if exact < 4 || len(costs) < 2 {
		t.Fatalf("only %d walks of %d different costs were compared with the move command", exact, len(costs))
	}
	space := r.combatSpace(r.state.Combat)
	refused := func(at behavior.Cell, code string) *pb.PocCombatPath {
		t.Helper()
		seq++
		p := combatPathAsk(t, r, c, seq, at)
		if p.Ok || p.Code != code || p.Reason == "" {
			t.Fatalf("cell %v: the preview says %+v, expected the refusal %q with its words", at, p, code)
		}
		if _, _, _, err := combatPathWalk(r, at); err == nil {
			t.Fatalf("the preview refuses the walk to %v (%s), the move command makes it", at, code)
		}
		return p
	}
	// a cell nobody can stand on, the nearest to the hero
	blocked, found := behavior.Cell{}, false
	for radius := 1; radius < 40 && !found; radius++ {
		for dy := -radius; dy <= radius && !found; dy++ {
			for dx := -radius; dx <= radius && !found; dx++ {
				at := behavior.Cell{X: hero.Position.X + dx, Y: hero.Position.Y + dy}
				if at.X >= 0 && at.Y >= 0 && at.X < space.Space.Width && at.Y < space.Space.Height && (space.Space.Walkable == nil || !space.Space.Walkable(at) || space.Space.Blocked[at]) {
					blocked, found = at, true
				}
			}
		}
	}
	if !found {
		t.Fatal("the level has no cell that cannot be stood on")
	}
	if p := refused(blocked, "blocked"); len(p.Path) != 0 || p.Ap != 0 {
		t.Fatalf("a path into a cell nobody can stand on: %+v", p)
	}
	// the cell of a fighter the hero sees
	guard := r.state.Combat.Actor(d.Guard)
	if guard == nil || !space.ActorVisible(hero, *guard, r.world.CombatRuntime.Rules) {
		t.Fatal("the hero does not see the watchman")
	}
	if p := refused(guard.Position, "occupied"); len(p.Path) != 0 {
		t.Fatalf("a path into a fighter's cell: %+v", p)
	}
	// a cell past the points left: the route and its whole cost are shown, the affordable part marked
	far := 0
	for radius := 1; radius < 60 && far < 3; radius++ {
		for _, at := range []behavior.Cell{{X: hero.Position.X + radius, Y: hero.Position.Y}, {X: hero.Position.X - radius, Y: hero.Position.Y}, {X: hero.Position.X, Y: hero.Position.Y + radius}, {X: hero.Position.X, Y: hero.Position.Y - radius}} {
			if reach[at] || at.X < 0 || at.Y < 0 {
				continue
			}
			seq++
			p := combatPathAsk(t, r, c, seq, at)
			if p.Code != "too_far" {
				continue
			}
			far++
			if p.Ok || p.Reason == "" || int(p.Ap) <= hero.AP || len(p.Path) == 0 || p.Afford < 0 || int(p.Afford) >= len(p.Path) {
				t.Fatalf("the too-far cell %v: %+v (the hero has %d points)", at, p, hero.AP)
			}
			if _, _, _, err := combatPathWalk(r, at); err == nil {
				t.Fatalf("the preview says %v is too far, the move command walks there", at)
			}
			// the affordable part of the shown route ends on a cell the hero can pay for
			if p.Afford > 0 {
				end := p.Path[p.Afford-1]
				seq++
				if q := combatPathAsk(t, r, c, seq, behavior.Cell{X: int(end.X), Y: int(end.Y)}); int(q.Ap) > hero.AP {
					t.Fatalf("the affordable part of the route to %v ends at %v, which costs %d of %d points", at, end, q.Ap, hero.AP)
				}
			}
		}
	}
	if far == 0 {
		t.Fatal("no cell past the hero's points was found on the level")
	}
	if !reflect.DeepEqual(before, r.state.Combat) {
		t.Fatal("a question about a path changed the fight")
	}
	// a stale turn has no path
	for len(c.out) > 0 {
		<-c.out
	}
	some := behavior.Cell{}
	for at := range reach {
		if at != hero.Position {
			some = at
			break
		}
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_CombatPreview{CombatPreview: &pb.PocCombatPreview{Epoch: r.state.Epoch, ExpectedTurn: r.state.Combat.Turn + 1, Seq: 9000, X: int32(some.X), Y: int32(some.Y)}}}})
	if m := <-c.out; m.GetCombatPath() == nil || m.GetCombatPath().Ok || m.GetCombatPath().Code != "stale" || len(m.GetCombatPath().Path) != 0 {
		t.Fatalf("a question with a stale turn was answered %+v", m.GetCombatPath())
	}
	// another fighter's turn: the reach border is empty and a question gets the reason, no path
	r.state.Combat.CurrentIndex = (r.state.Combat.CurrentIndex + 1) % len(r.state.Combat.Actors)
	if cur := r.state.Combat.Current(); cur != nil && cur.ID != playerActorID {
		r.combatPanel = combatPanelCache{}
		if other := combatEpisodeView(r, c); other == nil || other.Combat == nil || len(other.Combat.ReachX) != 0 {
			t.Fatal("a reach border on another fighter's turn")
		}
		seq++
		if p := combatPathAsk(t, r, c, seq, some); p.Ok || p.Code != "not_turn" || p.Reason == "" || len(p.Path) != 0 {
			t.Fatalf("a path on another fighter's turn: %+v", p)
		}
	}
}
