func TestLive_InitPayP2P_card2card(t *testing.T) {
	if os.Getenv("{{ .MacanLiveEnvPrefix }}_LIVE") != "1" {
		t.Skip("skipped: set {{ .MacanLiveEnvPrefix }}_LIVE=1 {{ .MacanLiveEnvPrefix }}_TOKEN {{ .MacanLiveEnvPrefix }}_SIGKEY for live API")
	}
	token := os.Getenv("{{ .MacanLiveEnvPrefix }}_TOKEN")
	sigKey := os.Getenv("{{ .MacanLiveEnvPrefix }}_SIGKEY")
	if token == "" || sigKey == "" {
		t.Fatal("{{ .MacanLiveEnvPrefix }}_TOKEN and {{ .MacanLiveEnvPrefix }}_SIGKEY are required")
	}
	base := os.Getenv("{{ .MacanLiveEnvPrefix }}_API")
	if base == "" {
		base = "https://api.macanp2p.xyz"
	}

	txLog := &providers.MockTxPathLogger{}
	txLog.On("Log", mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return()
	pp := {{ .ConstructorName }}({{ .ConstructorTestArgs }})
	pp.txPathLogger = txLog
	mc := &model.MerchantCreds{
		ApiEndpoint: base,
		Secret:      token + "{{ .SecretSeparator }}" + sigKey,
	}
	tx := testMacanPayTx(types.CardP2PMethod.String(), 100000)
	tx.Id = fmt.Sprintf("live-go-test-%d", time.Now().UnixNano())
	tx.CallbackURL = "https://example.com/api/v1/callback"
	tx.Order.ResultUrl = "https://example.com/success"

	out, err := pp.InitPayP2P(mc, &model.PaymentSource{APM: &model.APM{}}, tx)
	require.NoError(t, err)
	require.NotNil(t, out)
	if out.ForeignId == "" {
		t.Skipf("live pay-in declined without id: status=%s msg=%q", out.Status, out.Message)
	}
	t.Logf("ForeignId=%s status=%s", out.ForeignId, out.Status)

	st, err := pp.CheckStatus(mc, &model.Transaction{
		Id: tx.Id, ForeignId: out.ForeignId, Type: model.TnxTypePay, Currency: "{{ .CurrencyCode }}",
		Order: tx.Order,
	})
	require.NoError(t, err)
	t.Logf("CheckStatus: %s %v", st.Status, st.Code)
}
