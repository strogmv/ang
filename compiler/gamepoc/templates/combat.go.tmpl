func (c combatCatalog) Validate() error {
	if c.DefaultProfile == "" && c.Rules.APPerTurn == 0 {
		return nil
	}
	if err := c.Rules.Validate(); err != nil {
		return err
	}
	if _, ok := c.Profiles[c.DefaultProfile]; !ok {
		return errors.New("combat default profile missing")
	}
	if c.MaxParticipants < 2 || c.MaxParticipants > 64 || c.JoinRangeMM < 1 {
		return errors.New("combat participant policy invalid")
	}
	for _, p := range c.Profiles {
		if p.Skill < 0 || p.Skill > 100 || p.Courage < 0 || p.Courage > 100 || p.Weapon.ID == "" || p.Weapon.Damage < 1 || p.Weapon.AttackAP < 1 || p.Weapon.RangeMM < 1 {
			return errors.New("invalid combat profile")
		}
	}
	for _, id := range c.Actors {
		if _, ok := c.Profiles[id]; !ok {
			return fmt.Errorf("unknown combat profile %s", id)
		}
	}

	return nil
}
