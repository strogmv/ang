  void CombatR3HideActors(){foreach(var h in locationSDKHumanoids.Values)if(h.go!=null)foreach(var r in h.go.GetComponentsInChildren<Renderer>(true))r.forceRenderingOff=true;foreach(var p in combatProps.Values)if(p.go!=null)foreach(var r in p.go.GetComponentsInChildren<Renderer>(true))r.forceRenderingOff=true;}
  void CombatR3RememberContact(string id){if(!combatAutoRecord)return;var h=CombatHumanoid(id);if(h==null||h.animator==null)return;var shot=new CombatR3ContactMesh{actor=id,t=CombatAutoTime,cameraPosition=locationSDKCamera.transform.position,cameraRotation=locationSDKCamera.transform.rotation};foreach(var skin in h.go.GetComponentsInChildren<SkinnedMeshRenderer>()){var mesh=new Mesh();skin.BakeMesh(mesh);var go=new GameObject("actual contact mesh / "+id){layer=LocationSDKLayer};go.transform.SetPositionAndRotation(skin.transform.position,skin.transform.rotation);go.transform.localScale=skin.transform.lossyScale;go.AddComponent<MeshFilter>().sharedMesh=mesh;go.AddComponent<MeshRenderer>().sharedMaterials=skin.sharedMaterials;go.SetActive(false);shot.meshes.Add(go);}combatR3ContactMeshes.Add(shot);}
  IEnumerator CombatR3ReviewContactsThenQuit(){
   var report=new CombatR3OcclusionReport();var env=locationSDKRoot.GetComponentsInChildren<Renderer>();var off=new Dictionary<Renderer,bool>();var mats=new Dictionary<Renderer,Material[]>();foreach(var r in env){off[r]=r.forceRenderingOff;mats[r]=r.sharedMaterials;}
   var white=new Material(Shader.Find("Universal Render Pipeline/Unlit"));white.SetColor("_BaseColor",Color.white);var black=new Material(white);black.SetColor("_BaseColor",Color.black);
   foreach(var shot in combatR3ContactMeshes.ToArray()){
    yield return null;combatR3CameraPosition=shot.cameraPosition;combatR3CameraRotation=shot.cameraRotation;locationSDKCamera.transform.SetPositionAndRotation(shot.cameraPosition,shot.cameraRotation);foreach(var r in env)r.forceRenderingOff=true;foreach(var go in shot.meshes){var r=go.GetComponent<MeshRenderer>();var replace=new Material[r.sharedMaterials.Length];for(int n=0;n<replace.Length;n++)replace[n]=white;r.sharedMaterials=replace;r.shadowCastingMode=UnityEngine.Rendering.ShadowCastingMode.Off;go.SetActive(true);}combatR3RenderPost=false;locationSDKCameraData.renderPostProcessing=false;
    yield return new WaitForEndOfFrame();var isolated=CombatR3Pixels();if(report.rows.Count==0)CombatR3Image(Path.Combine(combatAutoDir,"contact-isolated-r3.png"),isolated);
    yield return null;combatR3CameraPosition=shot.cameraPosition;combatR3CameraRotation=shot.cameraRotation;locationSDKCamera.transform.SetPositionAndRotation(shot.cameraPosition,shot.cameraRotation);foreach(var r in env){r.forceRenderingOff=off[r];var replace=new Material[r.sharedMaterials.Length];for(int n=0;n<replace.Length;n++)replace[n]=black;r.sharedMaterials=replace;}CombatR3HideActors();combatR3RenderPost=false;locationSDKCameraData.renderPostProcessing=false;
    yield return new WaitForEndOfFrame();var visible=CombatR3Pixels();if(report.rows.Count==0)CombatR3Image(Path.Combine(combatAutoDir,"contact-visible-r3.png"),visible);int full=0,seen=0;for(int n=0;n<visible.Length;n++){if(isolated[n].r>220&&isolated[n].g>220&&isolated[n].b>220)full++;if(visible[n].r>220&&visible[n].g>220&&visible[n].b>220)seen++;}report.rows.Add(new CombatR3Occlusion{actor=shot.actor,t=shot.t,isolated_pixels=full,visible_pixels=seen,geometry_occlusion_fraction=full>0?Mathf.Max(0,1-seen/(float)full):1});foreach(var go in shot.meshes)go.SetActive(false);
   }
   File.WriteAllText(Path.Combine(combatAutoDir,"occlusion-r3.json"),JsonUtility.ToJson(report,true));Application.Quit(0);
  }

 }
