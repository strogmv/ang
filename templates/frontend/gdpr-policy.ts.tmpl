// ── Consent tracking ─────────────────────────────────────────────────────────

export type ConsentScope =
  | 'analytics'
  | 'marketing'
  | 'personalization'
  | 'essential';

export type ConsentState = Record<ConsentScope, boolean>;

const CONSENT_KEY = 'ang_gdpr_consent';

/** Read persisted consent from localStorage. */
export const getConsent = (): Partial<ConsentState> => {
  if (typeof window === 'undefined') return {};
  try {
    return JSON.parse(localStorage.getItem(CONSENT_KEY) ?? '{}');
  } catch {
    return {};
  }
};

/** Persist consent decision to localStorage (and optionally sync to backend). */
export const setConsent = (state: Partial<ConsentState>): void => {
  if (typeof window === 'undefined') return;
  const merged = { ...getConsent(), ...state };
  localStorage.setItem(CONSENT_KEY, JSON.stringify(merged));
};

export const hasConsent = (scope: ConsentScope): boolean =>
  getConsent()[scope] ?? false;

