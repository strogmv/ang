// Offset at the saved instant, so winter and summer saves keep their local hour.
func screenSaveOffset(unixMS int64) int32 {
	_, offset := time.UnixMilli(unixMS).In(time.Local).Zone()
	return int32(offset)
}

// screenSlotWorld tells a save slot where and when in the world the save was made: the day (from 1) and the time of day
