/** Helper: trigger download of exported personal data as a JSON file. */
export const downloadPersonalData = (blob: unknown, filename = 'my-data.json'): void => {
  const url = URL.createObjectURL(
    new Blob([JSON.stringify(blob, null, 2)], { type: 'application/json' })
  );
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
};
