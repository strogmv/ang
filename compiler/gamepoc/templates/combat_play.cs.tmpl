    if((e.Type=="move"||e.Type=="move_stop")&&!string.IsNullOrEmpty(e.ActorId)&&CombatCellValid(to)){
     if(run!=null&&run.actor==e.ActorId&&combatQueue.Count>0&&combatQueue[combatQueue.Count-1]==run){if(run.path.Count==0||run.path[run.path.Count-1]!=to)run.path.Add(to);continue;}
