{{ if and .ErrorCodes .CallbackErrorCodeField -}}
{{ if .ErrorMappingMatrix -}}
func splitProviderErrorCode(raw string) (major, minor string) {
	parts := strings.FieldsFunc(raw, func(r rune) bool {
		switch r {
		case ':', '.', '|', '/', '-':
			return true
		default:
			return false
		}
	})
	if len(parts) == 0 {
		return "", ""
	}
	major = parts[0]
	if len(parts) > 1 {
		minor = parts[1]
	}
	return major, minor
}

func mapErrorCodeMatrix(major, minor string) (model.TnxStatus, model.TnxStatusCode, bool) {
	switch major {
	{{- range .ErrorMappingMatrix }}
	case "{{ printf "%v" .Major }}":
		{{- if eq (printf "%v" .Minor) "" }}
		return tnxStatus{{ .StatusTitle }}, model.{{ .StatusCode }}, true
		{{- else }}
		if minor == "{{ printf "%v" .Minor }}" {
			return tnxStatus{{ .StatusTitle }}, model.{{ .StatusCode }}, true
		}
		{{- end }}
	{{- end }}
	}
	return tnxStatusDeclined, model.SCodeDeclinedByBank, false
}
{{ end }}

func mapErrorCode(code string) (model.TnxStatus, model.TnxStatusCode) {
{{ if .ErrorMappingMatrix -}}
	major, minor := splitProviderErrorCode(code)
	if st, sc, ok := mapErrorCodeMatrix(major, minor); ok {
		return st, sc
	}
{{ end -}}
	switch code {
	{{- range .ErrorCodes }}
	case {{ .ConstName }}:
		return tnxStatus{{ .StatusTitle }}, model.{{ .StatusCode }}
	{{- end }}
	default:
		return tnxStatusDeclined, model.SCodeDeclinedByBank
	}
}
{{ end }}
