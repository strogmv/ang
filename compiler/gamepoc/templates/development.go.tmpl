// Code generated by ANG. Completed actions, not client-reported hits, develop skills.
package poc

import (
	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"errors"
	"fmt"
	"hash/fnv"
)

func (r *Runtime) practiceAvailable(st *behavior.LifePracticeStation, ruleID string) error {
	hero := r.state.Life.Actor(playerActorID)
	if st == nil || hero == nil || hero.Trip != nil || hero.Level != st.Level {
		return errors.New("Учебный стенд недоступен")
	}
	if r.state.Paused {
		return errors.New("Мир на паузе")
	}
	if r.state.Life.PracticePending != nil {
		return errors.New("Завершите текущее упражнение")
	}
	if len(hero.Path) > 0 || behavior.Distance(hero.Position, st.At) > 1 || !r.sightLine(location(hero.Position), location(st.At)) {
		return errors.New("Подойдите к стенду и остановитесь")
	}
	allowed := false
	for _, id := range st.Rules {
		allowed = allowed || id == ruleID
	}
	rule, ok := r.world.Life.PracticeRule(ruleID)
	if !allowed || !ok {
		return errors.New("Такого упражнения здесь нет")
	}
	actor, ok := r.state.Life.Development.Actors[playerActorID]
	if !ok {
		return errors.New("Профиль развития недоступен")
	}
	if _, ok := actor.Skills[rule.Skill]; !ok {
		return errors.New("Навык отсутствует")
	}
	if repeat, ok := actor.Repetitions[rule.ID]; ok && r.state.Tick < repeat.LastTick+rule.CooldownTicks {
		return errors.New("Подготовка к следующей попытке")
	}
	return nil
}
func (r *Runtime) startPractice(station, rule string) error {
	st := r.world.Life.PracticeStation(station)
	if err := r.practiceAvailable(st, rule); err != nil {
		return err
	}
	cfg, _ := r.world.Life.PracticeRule(rule)
	hero := r.state.Life.Actor(playerActorID)
	hero.Manual = true
	hero.OverrideLevel = ""
	hero.OverrideEdge = ""
	hero.Activity = "practice"
	hero.Label = cfg.Name
	r.state.Life.PracticePending = &behavior.LifePracticeAttempt{Station: station, Rule: rule, Level: hero.Level, At: hero.Position, StartedTick: r.state.Tick, CompleteTick: r.state.Tick + cfg.CooldownTicks}
	return nil
}
func (r *Runtime) practiceNote(line string) {
	s := &r.state.Life
	s.PracticeLog = append(s.PracticeLog, line)
	if len(s.PracticeLog) > 12 {
		s.PracticeLog = append([]string(nil), s.PracticeLog[len(s.PracticeLog)-12:]...)
	}
}
func (r *Runtime) advancePractice() {
	p := r.state.Life.PracticePending
	if p == nil || r.state.Paused {
		return
	}
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || hero.Trip != nil || hero.Level != p.Level || hero.Position != p.At || len(hero.Path) > 0 || hero.OverrideLevel != "" || !hero.Manual {
		r.state.Life.PracticePending = nil
		if hero != nil && hero.Activity == "practice" {
			hero.Activity = "rest"
			hero.Label = "Упражнение прервано"
		}
		r.practiceNote("Упражнение прервано — прироста нет")
		return
	}
	if r.state.Tick < p.CompleteTick {
		return
	}
	st := r.world.Life.PracticeStation(p.Station)
	rule, validRule := r.world.Life.PracticeRule(p.Rule)
	r.state.Life.PracticePending = nil
	if st == nil || !validRule {
		hero.Activity = "rest"
		hero.Label = "Упражнение недоступно"
		r.practiceNote("Упражнение не зачтено: неизвестный стенд или правило")
		return
	}
	actor := r.state.Life.Development.Actors[playerActorID]
	skill := r.state.Life.Development.Value(playerActorID, rule.Skill)
	chance := max(st.MinSuccessPermille, min(st.MaxSuccessPermille, st.SuccessBasePermille+(skill-rule.Difficulty)*st.SuccessPerSkillPermille))
	h := fnv.New64a()
	fmt.Fprintf(h, "%d/%s/%s/%d", r.state.Seed, playerActorID, rule.ID, actor.Sequence+1)
	outcome := "failure"
	if int(h.Sum64()%1000) < chance {
		outcome = "success"
	}
	result, err := r.state.Life.Development.Apply(r.world.Life.Development, behavior.PracticeEvent{Actor: playerActorID, Rule: rule.ID, Sequence: actor.Sequence + 1, Tick: r.state.Tick, Outcome: outcome, QualityPermille: 1000}, r.state.Tick)
	if err != nil {
		hero.Activity = "rest"
		hero.Label = "Упражнение не зачтено"
		r.practiceNote("Упражнение не зачтено: " + err.Error())
		return
	}
	label := "Попытка не удалась"
	if result.GainMilli > 0 {
		label += ", но опыт получен"
	}
	if outcome == "success" {
		label = "Упражнение выполнено"
	}
	r.practiceNote(fmt.Sprintf("%s · %s +%.3f", label, rule.Name, float64(result.GainMilli)/1000))
	hero.Activity = "rest"
	hero.Label = "Закончил упражнение"
	r.syncPracticeObserver(result)
}
func (r *Runtime) syncPracticeObserver(result behavior.PracticeResult) {
	// Synchronize only the skill that actually changed for the hero. Other
	// debug sensory overrides and NPC development must never overwrite it.
	if result.Actor != playerActorID || result.Replayed || result.GainMilli <= 0 {
		return
	}
	if result.Skill != "observation" && result.Skill != "maintenance" {
		return
	}
	if _, ok := r.state.Life.Observer.Attributes[result.Skill]; ok {
		r.state.Life.Observer.Attributes[result.Skill] = r.state.Life.Development.Value(playerActorID, result.Skill)
	}
}
func (r *Runtime) awardRepairPractice(previous []behavior.MaintenanceUnit) {
	for i, u := range r.state.Life.Maintenance.Units {
		if i >= len(previous) || u.Replacements <= previous[i].Replacements {
			continue
		}
		quality := 1000
		if r.state.Life.PracticeExcluded[u.ID] {
			quality = 0
		}
		delete(r.state.Life.PracticeExcluded, u.ID)
		for _, id := range previous[i].Crew {
			actor, ok := r.state.Life.Development.Actors[id]
			if !ok {
				continue
			}
			result, err := r.state.Life.Development.Apply(r.world.Life.Development, behavior.PracticeEvent{Actor: id, Rule: "real_repair", Sequence: actor.Sequence + 1, Tick: r.state.Tick, Outcome: "success", QualityPermille: quality}, r.state.Tick)
			if err != nil {
				r.practiceNote("Обучение ремонтника не начислено: " + err.Error())
			} else {
				r.syncPracticeObserver(result)
			}
		}
	}
}
func (r *Runtime) appendDevelopment(msg *pb.PocGameState) {
	s := &r.state.Life
	hero := s.Actor(playerActorID)
	actor, ok := s.Development.Actors[playerActorID]
	if !ok || hero == nil {
		return
	}
	view := &pb.PocDevelopmentView{Sequence: actor.Sequence, Events: append([]string(nil), s.PracticeLog...)}
	for _, skill := range r.world.Life.Development.Skills {
		value, ok := actor.Skills[skill.ID]
		if ok {
			view.Skills = append(view.Skills, &pb.PocDevelopedSkill{Id: skill.ID, Name: skill.Name, ValueMilli: value.ValueMilli, Cap: int32(value.Cap)})
		}
	}
	if p := s.PracticePending; p != nil {
		rule, _ := r.world.Life.PracticeRule(p.Rule)
		view.Pending = true
		view.Activity = rule.Name
		view.RemainingTicks = max(int64(0), p.CompleteTick-r.state.Tick)
	}
	if hero.Trip == nil {
		for _, st := range r.world.Life.PracticeStations {
			if st.Level != hero.Level || !viewSees(msg.PlayerView, int32(st.At.X), int32(st.At.Y)) {
				continue
			}
			msg.Life.Markers = append(msg.Life.Markers, &pb.PocLifeMarker{Name: st.Name, X: int32(st.At.X), Y: int32(st.At.Y)})
			for _, id := range st.Rules {
				rule, _ := r.world.Life.PracticeRule(id)
				err := r.practiceAvailable(&st, id)
				offer := &pb.PocPracticeOffer{StationId: st.ID, RuleId: id, Name: rule.Name, X: int32(st.At.X), Y: int32(st.At.Y), DurationTicks: rule.CooldownTicks, CanStart: err == nil}
				if err != nil {
					offer.Reason = err.Error()
				}
				view.Offers = append(view.Offers, offer)
			}
		}
	}
	msg.Life.Development = view
}
