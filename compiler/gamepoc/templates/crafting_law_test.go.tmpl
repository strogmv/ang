// craftingHack: the hero who knows the bypass hacks the found needle gun by hand (the seed gives success).
func craftingHack(t *testing.T, r *Runtime) string {
	t.Helper()
	a := r.state.Crafting.Actors[playerActorID]
	a.Known["bypass.needle_gun"], a.Points["electrics"] = true, 60000
	r.state.Crafting.Actors[playerActorID] = a
	craftingGive(t, r, "item.needle_gun", 1)
	craftingGive(t, r, "item.tool.programmer", 1)
	craftingGive(t, r, "item.tool.soldering_iron", 1)
	gun := craftingHeroItem(r, "item.needle_gun")
	if err := craftingDo(r, "start", "bypass.needle_gun", gun.ID, ""); err != nil {
		t.Fatal(err)
	}
	p := r.state.Crafting.Jobs[0].Plan
	craftingRun(t, r, p.Seconds+60)
	if p.Outcome != "success" {
		return ""
	}
	return p.Target
}
// craftingClearAround moves everybody out of the witness range of the hero (a hack nobody sees).
func craftingClearAround(r *Runtime) {
	h := r.state.Life.Actor(playerActorID)
	for _, id := range r.craftingWitnesses(h) {
		a := r.state.Life.Actor(id)
		a.Position, a.Path, a.Arrived = behavior.Cell{X: h.Position.X + 40, Y: h.Position.Y + 40}, nil, true
	}
}
func craftingHackedRuntime(t *testing.T) (*Runtime, string) {
	t.Helper()
	for seed := int64(1); seed < 60; seed++ {
		r := craftingFixture(t)
		r.state.Seed = seed
		craftingStandAway(r)
		craftingClearAround(r)
		if gun := craftingHack(t, r); gun != "" {
			return r, gun
		}
	}
	t.Fatal("no seed hacks the gun")
	return nil, ""
}

func TestCraftingTerminalRebindsOnlyAtTheSystemTrustAndRecordsEveryAttempt(t *testing.T) {
	r := craftingFixture(t)
	m := r.world.Crafting
	craftingAtTerminal(t, r)
	craftingSetMoney(r, 5000)
	craftingGive(t, r, "item.needle_gun", 1)
	gun := craftingHeroItem(r, "item.needle_gun")
	if gun.Grade.Bound == "" || gun.Grade.Bound == crafting.Chip(playerActorID) || r.craftingUsable(gun.ID, playerActorID) {
		t.Fatal("the found needle gun must be bound to another chip and useless to the hero")
	}
	money := craftingMoney(r)
	if err := craftingDo(r, "rebind", "", gun.ID, ""); err == nil {
		t.Fatal("the terminal rebound below the system trust")
	}
	law := r.state.Crafting.Law
	if len(law.Journal) != 1 || law.Journal[0].Kind != "rebind_refused" || len(law.Cases) != 0 || craftingMoney(r) != money || r.state.Inventory.Accounts[m.Hero.Account].Balance != 5000 {
		t.Fatalf("a refusal must leave a trace and no punishment: %+v", law)
	}
	r.state.Crafting.Law.Trust = m.Law.Trust.RebindMinPermille
	if err := craftingDo(r, "rebind", "", gun.ID, ""); err != nil {
		t.Fatal(err)
	}
	gun = r.state.Inventory.Items[gun.ID]
	if gun.Grade.Bound != crafting.Chip(playerActorID) || !r.craftingUsable(gun.ID, playerActorID) || r.state.Inventory.Accounts[m.Hero.Account].Balance != 5000-m.Law.Rebind.PriceMinor || craftingMoney(r) != money {
		t.Fatal("the lawful rebinding did not write the hero's chip for the price")
	}
	if j := r.state.Crafting.Law.Journal; len(j) != 2 || j[1].Kind != "rebind" {
		t.Fatal("the rebinding is not in the system journal")
	}
	// the trust grows by honest work: a legal job raises it
	t0 := r.state.Crafting.Law.Trust
	craftingGive(t, r, "item.tool.needle_kit", 1)
	craftingGive(t, r, "item.part.fabric", 1)
	craftingGive(t, r, "item.part.thread", 1)
	if err := craftingDo(r, "start", "craft.work_gloves", "", ""); err != nil {
		t.Fatal(err)
	}
	p := r.state.Crafting.Jobs[0].Plan
	craftingRun(t, r, 31*60)
	if p.Outcome == "success" && r.state.Crafting.Law.Trust != t0+m.Law.Trust.GainLegalJob {
		t.Fatal("a legal job did not raise the system trust")
	}
}

func TestCraftingBypassIsFoundAtTheRaidAndPunishedAtTheTopRung(t *testing.T) {
	r, gun := craftingHackedRuntime(t)
	m := r.world.Crafting
	if r.state.Inventory.Items[gun].Grade.Bound != crafting.Chip(playerActorID) || r.state.Crafting.Law.Hacked[gun].By == "" {
		t.Fatal("the bypass did not forge the binding")
	}
	if len(r.state.Crafting.Law.Cases) != 0 {
		t.Fatal("a case without a witness")
	}
	act, _ := m.Act("raid")
	if act.Crime != "crime.chip_bypass" || act.Rung != "rung.grievous" || act.Rank < 3 {
		t.Fatalf("the bypass is not on the top rung of the ladder: %+v", act)
	}
	money := craftingMoney(r)
	raid := m.Law.Rebind.Raid
	r.state.Life.Seconds = raid.EveryDays*86400 + raid.Hour*3600
	craftingRun(t, r, 60)
	law := r.state.Crafting.Law
	if len(law.Cases) != 1 || !law.Cases[0].Closed || !law.Frozen || !law.Expulsion || !law.Wanted {
		t.Fatalf("the raid did not find the forged chip or the sanctions of the rung were not applied: %+v", law)
	}
	for _, def := range []string{"item.needle_gun", "item.tool.programmer"} {
		if craftingHeroItem(r, def).ID != "" {
			t.Fatalf("%s was not confiscated", def)
		}
	}
	if craftingMoney(r) != money {
		t.Fatal("money appeared or vanished in the sanctions")
	}
	// a frozen account pays for nothing in crafting
	craftingOpen(t, r, craftingMatvey)
	craftingStand(t, r, craftingMatvey)
	if err := craftingDo(r, "order", "repair.grandfather_headset", craftingHeroItem(r, "item.heirloom_headset").ID, ""); err == nil {
		t.Fatal("a frozen account paid an order")
	}
}

func TestCraftingWitnessesReportTheBypassByTheLaw(t *testing.T) {
	// an obliged witness (the guard) reports at once; ordinary people by the crowd curve after the law's delay
	for _, guard := range []bool{true, false} {
		found := false
		for seed := int64(1); seed < 60 && !found; seed++ {
			r := craftingFixture(t)
			r.state.Seed = seed
			craftingStandAway(r)
			if guard {
				craftingBringNear(t, r, "char.poc_hub_guard")
			} else {
				for k := 1; k <= 6; k++ {
					craftingBringNear(t, r, "char.market_resident_0"+string(rune('0'+k)))
				}
			}
			gun := craftingHack(t, r)
			if gun == "" {
				continue
			}
			found = true
			law := r.state.Crafting.Law
			if len(law.Cases) != 1 {
				t.Fatalf("guard %v: the hack opened %d cases", guard, len(law.Cases))
			}
			c := law.Cases[0]
			if guard && (!c.Closed || len(c.Evidence) == 0) {
				t.Fatal("the guard's report did not make the case known at once")
			}
			if !guard {
				if c.Closed || len(c.Pending) == 0 {
					t.Fatalf("ordinary witnesses must report after the delay: %+v", c)
				}
				craftingRun(t, r, r.world.Crafting.Law.ReportDelaySeconds+120)
				if !r.state.Crafting.Law.Cases[0].Closed {
					t.Fatal("the delayed reports did not make the case known")
				}
			}
		}
		if !found {
			t.Fatal("no seed hacks the gun")
		}
	}
}

func TestCraftingHackedGunMisfiresOrWoundsBySeed(t *testing.T) {
	uses := func(seed int64) []string {
		r, gun := craftingHackedRuntime(t)
		r.state.Seed = seed
		out := []string{}
		for k := 0; k < 20; k++ {
			i := r.state.Inventory.Items[gun]
			if i.Condition < 10000 {
				break
			}
			if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Restore: []inv.Restore{{Item: gun, Condition: i.Condition - 10000}}}); err != nil {
				t.Fatal(err)
			}
			r.state.Crafting.Notice = crafting.Notice{}
			craftingRun(t, r, 60)
			out = append(out, r.state.Crafting.Notice.Key)
		}
		if h := r.state.Crafting.Law.Hacked[gun]; h.Jammed && (r.state.Inventory.Items[gun].Condition != 0 || r.craftingUsable(gun, playerActorID)) {
			t.Fatal("a jammed gun still works")
		}
		return out
	}
	a, b := uses(7), uses(7)
	if !reflect.DeepEqual(a, b) {
		t.Fatal("the danger of a hacked gun is not a function of the seed")
	}
	bad := false
	for seed := int64(1); seed < 30 && !bad; seed++ {
		for _, k := range uses(seed) {
			bad = bad || k == "crafting.notice.misfire" || k == "crafting.notice.injured"
		}
	}
	if !bad {
		t.Fatal("a hacked gun never misfires or wounds")
	}
}

func TestCraftingStageTwoSurvivesSaveLoadAndRepeatsBySeed(t *testing.T) {
	run := func() (*Runtime, state) {
		r := craftingFixture(t)
		r.state.Seed = 23
		craftingOpen(t, r, craftingTaya)
		craftingStand(t, r, craftingTaya)
		senya := r.state.Life.Actor(craftingSenya)
		level, at := senya.Level, senya.Position
		craftingBringNear(t, r, craftingSenya)
		_ = craftingDoOn(r, "ask", "craft.needle_clip", "", "")
		senya.Level, senya.Position = level, at
		craftingSetAccount(t, r, "char.market_resident_02", 10000)
		craftingRun(t, r, 20*60)
		craftingGive(t, r, "item.schematic.copy_lantern", 1)
		if err := craftingDo(r, "study", "", craftingHeroItem(r, "item.schematic.copy_lantern").ID, ""); err != nil {
			t.Fatal(err)
		}
		craftingRun(t, r, 10*60)
		return r, r.snapshotState()
	}
	r, saved := run()
	_, again := run()
	if craftingJSON(saved.Crafting) != craftingJSON(again.Crafting) || craftingJSON(saved.Inventory) != craftingJSON(again.Inventory) {
		t.Fatal("the same seed and the same commands gave a different world")
	}
	if err := r.writeSave(r.world.Config.SaveSlots[0], saved); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(r.world.Config.SaveSlots[0])
	if err != nil {
		t.Fatal(err)
	}
	if craftingJSON(loaded.Crafting) != craftingJSON(saved.Crafting) || !reflect.DeepEqual(loaded.Crafting.Law, saved.Crafting.Law) {
		t.Fatal("the stage-2 state changed through save and load")
	}
	broken := r.snapshotState()
	broken.Crafting.Law.Trust = 5000
	if r.validateCraftingSave(broken) == nil {
		t.Fatal("a save with an impossible trust was accepted")
	}
	r.state = loaded
	craftingRun(t, r, 3600)
	if j := r.state.Crafting.JobOf(playerActorID); j >= 0 {
		t.Fatal("the loaded study did not finish")
	}
}
