	before := s.Clone()
	if s.yieldPopulation(m, "hall", b.Position, 0) || !reflect.DeepEqual(before, s.Clone()) {
		t.Fatal("anonymous legacy call guessed a controlled actor identity")
	}
	b.Manual, b.Arrived, b.Goal, b.Activity = true, true, b.Position, "rest"
	before = s.Clone()
	if s.yieldPopulationFor(m, "hall", b.Position, 0, "worker_a", Cell{4, 2}, Cell{5, 2}) || !reflect.DeepEqual(before, s.Clone()) {
		t.Fatal("autonomous requester commandeered a manually controlled actor")
	}
	for tick := int64(1); tick <= 30; tick++ {
		autonomousTrafficAdvance(t, m, &s, tick)
		if b.Position != (Cell{4, 2}) || len(b.Path) != 0 || b.YieldUntil != 0 || !b.Manual || a.Position != (Cell{3, 2}) {
			t.Fatal("autonomous traffic forced a manual actor aside or crossed its body")
		}
	}
}

