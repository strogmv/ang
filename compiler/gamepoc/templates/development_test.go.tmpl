func developmentRuntimeFixture(t *testing.T) (*Runtime, *behavior.LifePracticeStation) {
	t.Helper()
	r := lifeRuntimeFixture(t)
	if len(r.world.Life.PracticeStations) == 0 {
		t.Fatal("missing generated practice station")
	}
	st := &r.world.Life.PracticeStations[0]
	hero := r.state.Life.Actor(playerActorID)
	var at behavior.Cell
	found := false
	for _, candidate := range []behavior.Cell{{X: st.At.X + 1, Y: st.At.Y}, {X: st.At.X, Y: st.At.Y + 1}, {X: st.At.X - 1, Y: st.At.Y}, {X: st.At.X, Y: st.At.Y - 1}, st.At} {
		if !r.world.Life.Walks(st.Level, candidate) {
			continue
		}
		busy := false
		for _, a := range r.state.Life.Actors {
			if a.ID != playerActorID && a.Level == st.Level && a.Position == candidate {
				busy = true
			}
		}
		if !busy {
			at, found = candidate, true
			break
		}
	}
	if !found {
		t.Fatal("no free practice approach")
	}
	hero.Level = st.Level
	hero.Position = at
	hero.Goal = at
	hero.Path = nil
	hero.Trip = nil
	hero.Manual = true
	hero.Arrived = true
	hero.OverrideLevel = ""
	hero.OverrideEdge = ""
	hero.Activity = "rest"
	hero.Visits[st.Level]++
	// Training tests isolate development from the separately tested automatic repair.
	for i := range r.state.Life.Maintenance.Units {
		r.state.Life.Maintenance.Units[i].Age = 0
	}
	r.syncLifeHero()
	r.updateLifeExploration()
	r.state.Seed = 777
	return r, st
}
func completeDevelopmentAttempt(t *testing.T, r *Runtime) {
	t.Helper()
	if r.state.Life.PracticePending == nil {
		t.Fatal("missing pending exercise")
	}
	until := r.state.Life.PracticePending.CompleteTick
	for r.state.Tick < until {
		r.step()
	}
	if r.state.Life.PracticePending != nil {
		t.Fatal("exercise did not complete")
	}
	if err := r.state.Life.Validate(r.world.Life, r.state.Tick); err != nil {
		t.Fatal(err)
	}
}
func waitDevelopmentCooldown(r *Runtime, ruleID string) {
	rule, _ := r.world.Life.PracticeRule(ruleID)
	if repeat, ok := r.state.Life.Development.Actors[playerActorID].Repetitions[ruleID]; ok {
		for r.state.Tick < repeat.LastTick+rule.CooldownTicks {
			r.step()
		}
	}
}
func TestDevelopmentStationNearFarPauseAndUnknownRules(t *testing.T) {
	r, st := developmentRuntimeFixture(t)
	if err := r.practiceAvailable(st, "rifle_drill"); err != nil {
		t.Fatal(err)
	}
	before := r.state.Life.Development.Clone()
	hero := r.state.Life.Actor(playerActorID)
	near := hero.Position
	hero.Position = behavior.Cell{X: 17, Y: 8}
	if err := r.startPractice(st.ID, "rifle_drill"); err == nil {
		t.Fatal("remote station accepted")
	}
	hero.Position = near
	r.state.Paused = true
	if err := r.startPractice(st.ID, "rifle_drill"); err == nil {
		t.Fatal("paused station accepted")
	}
	r.state.Paused = false
	for _, q := range [][2]string{{"missing", "rifle_drill"}, {st.ID, "missing"}, {st.ID, "real_repair"}} {
		if err := r.startPractice(q[0], q[1]); err == nil {
			t.Fatal("unknown/disallowed station rule accepted")
		}
	}
	if !reflect.DeepEqual(before, r.state.Life.Development) || r.state.Life.PracticePending != nil {
		t.Fatal("rejected offer changed development")
	}
	if err := r.startPractice(st.ID, "rifle_drill"); err != nil {
		t.Fatal(err)
	}
	if err := r.startPractice(st.ID, "melee_drill"); err == nil {
		t.Fatal("parallel practice accepted")
	}
}
func TestDevelopmentCompletesOnceCooldownAndTenAttemptsGrowSkill(t *testing.T) {
	r, st := developmentRuntimeFixture(t)
	before := r.state.Life.Development.Actors[playerActorID].Skills["ranged"].ValueMilli
	for attempt := int64(1); attempt <= 10; attempt++ {
		waitDevelopmentCooldown(r, "rifle_drill")
		if err := r.startPractice(st.ID, "rifle_drill"); err != nil {
			t.Fatal(err)
		}
		sequence := r.state.Life.Development.Actors[playerActorID].Sequence
		if sequence != attempt-1 {
			t.Fatal("beginning practice awarded progress")
		}
		completeDevelopmentAttempt(t, r)
		actor := r.state.Life.Development.Actors[playerActorID]
		if actor.Sequence != attempt || actor.LastResult.GainMilli <= 0 {
			t.Fatal("completed meaningful attempt did not teach")
		}
		state := r.state.Life.Development.Clone()
		r.advancePractice()
		if !reflect.DeepEqual(state, r.state.Life.Development) {
			t.Fatal("completed exercise was replayed twice")
		}
		if err := r.startPractice(st.ID, "rifle_drill"); err == nil {
			t.Fatal("post-completion cooldown bypassed")
		}
	}
	after := r.state.Life.Development.Actors[playerActorID].Skills["ranged"].ValueMilli
	if after <= before || len(r.state.Life.PracticeLog) > 12 {
		t.Fatal("ten attempts did not grow skill or log is unbounded")
	}
}
func TestDevelopmentInterruptionAndPauseDoNotAward(t *testing.T) {
	for _, kind := range []string{"move", "auto", "leave"} {
		t.Run(kind, func(t *testing.T) {
			r, st := developmentRuntimeFixture(t)
			before := r.state.Life.Development.Clone()
			if err := r.startPractice(st.ID, "diagnostics_drill"); err != nil {
				t.Fatal(err)
			}
			hero := r.state.Life.Actor(playerActorID)
			switch kind {
			case "move":
				hero.Position = behavior.Cell{X: 17, Y: 8}
			case "auto":
				hero.Manual = false
			case "leave":
				hero.Level = "level.c7_market"
			}
			r.advancePractice()
			if r.state.Life.PracticePending != nil || !reflect.DeepEqual(before, r.state.Life.Development) {
				t.Fatal("interrupted exercise awarded skill")
			}
			if hero.Activity == "practice" {
				t.Fatal("interruption left stale practice activity")
			}
		})
	}
	r, st := developmentRuntimeFixture(t)
	if err := r.startPractice(st.ID, "rifle_drill"); err != nil {
		t.Fatal(err)
	}
	before := r.state.Life.Development.Clone()
	r.state.Paused = true
	tick := r.state.Tick
	for i := 0; i < 30; i++ {
		r.step()
		r.advancePractice()
	}
	if r.state.Tick != tick || r.state.Life.PracticePending == nil || !reflect.DeepEqual(before, r.state.Life.Development) {
		t.Fatal("paused exercise advanced")
	}
	r.state.Paused = false
	completeDevelopmentAttempt(t, r)
}
func TestDevelopmentDeterministicPendingSaveAndReplay(t *testing.T) {
	first, st := developmentRuntimeFixture(t)
	second, _ := developmentRuntimeFixture(t)
	if err := first.startPractice(st.ID, "diagnostics_drill"); err != nil {
		t.Fatal(err)
	}
	first.step()
	first.step()
	slot := first.world.Config.SaveSlots[0]
	if err := first.writeSave(slot, first.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := first.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	second.state = loaded
	if !reflect.DeepEqual(first.state.Life.PracticePending, second.state.Life.PracticePending) {
		t.Fatal("pending exercise lost in save")
	}
	completeDevelopmentAttempt(t, first)
	completeDevelopmentAttempt(t, second)
	if !reflect.DeepEqual(first.state.Life.Development, second.state.Life.Development) || !reflect.DeepEqual(first.state.Life.PracticeLog, second.state.Life.PracticeLog) {
		t.Fatal("saved deterministic exercise changed result")
	}
	before := second.state.Life.Development.Clone()
	actor := second.state.Life.Development.Actors[playerActorID]
	replay, err := second.state.Life.Development.Apply(second.world.Life.Development, actor.LastEvent, second.state.Tick)
	if err != nil || !replay.Replayed || !reflect.DeepEqual(before, second.state.Life.Development) {
		t.Fatal("practice receipt replay awarded twice", err)
	}
}
func TestDevelopmentOnlyChangedHeroSkillSynchronizesInspection(t *testing.T) {
	r, st := developmentRuntimeFixture(t)
	r.state.Life.Observer.Attributes["observation"] = 97
	r.state.Life.Observer.Attributes["maintenance"] = 96
	r.state.Life.Observer.Attributes["smell_sensitivity"] = 95
	for i := 0; i < 4; i++ {
		r.step()
	}
	if r.state.Life.Observer.Attributes["observation"] != 97 || r.state.Life.Observer.Attributes["maintenance"] != 96 {
		t.Fatal("idle tick erased debug inspection capabilities")
	}
	if err := r.startPractice(st.ID, "rifle_drill"); err != nil {
		t.Fatal(err)
	}
	completeDevelopmentAttempt(t, r)
	if r.state.Life.Observer.Attributes["observation"] != 97 || r.state.Life.Observer.Attributes["maintenance"] != 96 {
		t.Fatal("unrelated ranged gain erased inspection overrides")
	}
	if err := r.startPractice(st.ID, "diagnostics_drill"); err != nil {
		t.Fatal(err)
	}
	completeDevelopmentAttempt(t, r)
	if r.state.Life.Observer.Attributes["maintenance"] != r.state.Life.Development.Value(playerActorID, "maintenance") || r.state.Life.Observer.Attributes["observation"] != 97 || r.state.Life.Observer.Attributes["smell_sensitivity"] != 95 {
		t.Fatal("skill synchronization changed unrelated senses")
	}
	r.state.Life.Observer.Attributes["maintenance"] = 99
	receipt := r.state.Life.Development.Actors[playerActorID].LastResult
	receipt.Replayed = true
	r.syncPracticeObserver(receipt)
	receipt.Replayed = false
	receipt.GainMilli = 0
	r.syncPracticeObserver(receipt)
	receipt.GainMilli = 1
	receipt.Actor = "char.roommate_senya"
	r.syncPracticeObserver(receipt)
	if r.state.Life.Observer.Attributes["maintenance"] != 99 {
		t.Fatal("replay/zero/NPC gain changed hero inspection")
	}
}
func TestDevelopmentRealNPCRepairTeachesAndDebugFaultDoesNot(t *testing.T) {
	for _, injected := range []bool{false, true} {
		t.Run(fmt.Sprintf("injected=%v", injected), func(t *testing.T) {
			r := lifeRuntimeFixture(t)
			r.state.Life.Observer.Attributes["maintenance"] = 96
			before := r.state.Life.Development.Clone()
			index := 0
			if injected {
				index = 1
				for i := range r.state.Life.Maintenance.Units {
					r.state.Life.Maintenance.Units[i].Age = 0
				}
				r.world.Config.DebugPerception = true
				if err := r.lifeCommand(&pb.PocLifeCommand{Action: "fault", Destination: r.state.Life.Maintenance.Units[index].ID}); err != nil {
					t.Fatal(err)
				}
			}
			var crew []string
			completed := false
			for step := 0; step < 1800; step++ {
				unit := r.state.Life.Maintenance.Units[index]
				if len(unit.Crew) > 0 {
					crew = append([]string(nil), unit.Crew...)
				}
				r.step()
				if r.state.Life.Maintenance.Units[index].Replacements > 0 {
					completed = true
					break
				}
			}
			if !completed || len(crew) == 0 {
				t.Fatal("repair never completed with actual crew")
			}
			for _, id := range crew {
				old, ok := before.Actors[id]
				if !ok {
					t.Fatalf("missing worker profile %s", id)
				}
				after := r.state.Life.Development.Actors[id]
				gain := after.Skills["maintenance"].ValueMilli - old.Skills["maintenance"].ValueMilli
				if injected && gain != 0 {
					t.Fatal("debug fault farmed development")
				}
				if !injected && gain <= 0 {
					t.Fatal("actual repair did not teach worker")
				}
			}
			if r.state.Life.Observer.Attributes["maintenance"] != 96 {
				t.Fatal("NPC repair rewrote hero inspection profile")
			}
			if injected && r.state.Life.PracticeExcluded[r.state.Life.Maintenance.Units[index].ID] {
				t.Fatal("completed exclusion marker leaked into next repair")
			}
		})
	}
}
