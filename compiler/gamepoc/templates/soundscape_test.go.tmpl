		if err := r.advanceLifeFrameBy(10); err != nil {
			t.Fatal(err)
		}
		r.state.Tick++
		for _, e := range r.sound.events {
			if e.Tick == r.state.Tick-1 && strings.HasPrefix(e.Clip, "roller") {
