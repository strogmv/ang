// Code generated by ANG. Server-authoritative vertical-lift gates (docs 83/85).
package behavior

import ("fmt";"sort")

// GateFull is full lift in parts per million. Progress 0 = lowered and closed.
const GateFull=int64(1000000)

// LifeGate is one compiled gate placement on a Life location. Durations are in
// the model's motion units (MotionTick: ticks, or game seconds with the brain
// clock), the clock people walk on: the leaves and the bodies under them can
// never drift apart at a faster calendar. The schedule is calendar seconds.
type LifeGate struct{
 ID string `json:"id"`
 Opening []Cell `json:"opening"`
 SightClearPPM int64 `json:"sight_clear_ppm"`
 WarningTicks int64 `json:"warning_ticks"`
 TravelTicks int64 `json:"travel_ticks"`
 RetryTicks int64 `json:"retry_ticks"`
 LockdownWarningTicks int64 `json:"lockdown_warning_ticks"`
 LockdownRetryTicks int64 `json:"lockdown_retry_ticks"`
 PowerWarningTicks int64 `json:"power_warning_ticks"`
 // Full-height free descent through the speed governor.
 GravityTicks int64 `json:"gravity_ticks"`
 // Drive acceleration/deceleration at both ends of a powered travel
 // (trapezoidal speed, kit timing_ms.ramp); 0 = constant speed.
 RampTicks int64 `json:"ramp_ticks,omitempty"`
 OpenSecond int64 `json:"open_second"`
 CloseSecond int64 `json:"close_second"`
 LockAtNight bool `json:"lock_at_night"`
}

// LifeGateState is saved with Life. A travel segment is absolute: position at
// motion time t is From→To over [Start,Start+Duration], so a save in the middle
// of a lift resumes from the same progress and a large frame never skips an
// event. Duration 0 means the leaves rest at From.
type LifeGateState struct{
 State string `json:"state"`
 // Why the current warning, descent or stop happens: schedule, lockdown, power.
 Cause string `json:"cause,omitempty"`
 // Intent of a warning or stop: +1 raise, -1 lower.
 Direction int `json:"direction,omitempty"`
 From int64 `json:"from"`
 To int64 `json:"to"`
 Start int64 `json:"start"`
 Duration int64 `json:"duration,omitempty"`
 // Governor descent at constant speed; powered travel ramps up and down over
 // Ramp at both ends (trapezoidal speed, the drive's soft start/stop).
 Linear bool `json:"linear,omitempty"`
 Ramp int64 `json:"ramp,omitempty"`
 // Stopped by an obstruction: first motion time the opening was seen clear (-1 occupied).
 ClearSince int64 `json:"clear_since"`
 Updated int64 `json:"updated"`
 // Latched inputs: alarm and loss of mains. Commands only set these.
 Lockdown bool `json:"lockdown,omitempty"`
 PowerLost bool `json:"power_lost,omitempty"`
 Stops int64 `json:"stops,omitempty"`
}

var gateStates=map[string]bool{"closed":true,"warning":true,"opening":true,"open":true,"closing":true,"stopped":true,"locked":true,"no_power":true,"lockdown":true}

// ScheduledOpen: the daily window [OpenSecond, CloseSecond) of the calendar.
func(d LifeGate)ScheduledOpen(seconds int64)bool{day:=((seconds%86400)+86400)%86400;if d.OpenSecond<d.CloseSecond{return day>=d.OpenSecond&&day<d.CloseSecond};return day>=d.OpenSecond||day<d.CloseSecond}

// Position is the lift in ppm at motion time now. Powered travel: constant
// acceleration over Ramp, cruise, constant deceleration over Ramp; the governor
// descent and a zero ramp are linear. Unity draws the same curve (ramp_ns).
func(g LifeGateState)Position(now int64)int64{
 if g.Duration<=0{return g.From};u:=now-g.Start;if u<=0{return g.From};if u>=g.Duration{return g.To}
 return g.From+(g.To-g.From)*gateEase(u,g.Duration,g.rampOf())/GateFull
}
func(g LifeGateState)rampOf()int64{if g.Linear{return 0};return g.Ramp}
// gateEase: travelled fraction (ppm) at u of d with ramps r (2r <= d).
func gateEase(u,d,r int64)int64{
 if r<=0||2*r>d{return u*GateFull/d}
 cruise:=d-r // = distance / peak speed, in motion units
 switch{
 case u<r:return u*GateFull/(2*r)*u/cruise
 case u>d-r:v:=d-u;return GateFull-v*GateFull/(2*r)*v/cruise
 }
 return (2*u-r)*GateFull/(2*cruise)
}
// Moving reports an active travel segment at now.
func(g LifeGateState)Moving(now int64)bool{return g.Duration>0&&now<g.Start+g.Duration}
// Passable: people may cross only under a fully raised gate that is not moving.
// A descent blocks the opening from its first instant (the warning is the window).
func(g LifeGateState)Passable()bool{return (g.State=="open"||g.State=="warning"||g.State=="stopped")&&g.Position(g.Updated)>=GateFull}
// SeeThrough: sight passes under the lower edge from the kit's sight height.
func(g LifeGateState)SeeThrough(d LifeGate)bool{return g.Position(g.Updated)>=d.SightClearPPM}
// Glyph of every opening cell: '.' walkable, '+' blocked but transparent, '#' wall.
func(g LifeGateState)Glyph(d LifeGate)byte{if g.Passable(){return '.'};if g.SeeThrough(d){return '+'};return '#'}

func(d LifeGate)warningTicks(cause string)int64{switch cause{case "lockdown":return d.LockdownWarningTicks;case "power":return d.PowerWarningTicks};return d.WarningTicks}
func gateSpan(full,from,to int64)int64{span:=to-from;if span<0{span=-span};n:=(full*span+GateFull-1)/GateFull;if n<1{n=1};return n}
func(g *LifeGateState)rest(state string,pos,t int64){g.State=state;g.Cause="";g.Direction=0;g.From=pos;g.To=pos;g.Start=t;g.Duration=0;g.Linear=false;g.Ramp=0;g.ClearSince=0}
func(g *LifeGateState)warn(dir int,cause string,pos,t int64){g.rest("warning",pos,t);g.Direction=dir;g.Cause=cause}
// travel starts an absolute segment; ramp < 0 is the governor (linear), else the
// drive ramp, shortened so both ends fit a partial stroke.
func(g *LifeGateState)travel(state,cause string,pos,target,t,duration,ramp int64){g.rest(state,pos,t);g.Cause=cause;g.Direction=-1;if target>pos{g.Direction=1};g.To=target;g.Duration=duration;g.Linear=ramp<0;if ramp>0{g.Ramp=min(ramp,duration/2)}}
func(g *LifeGateState)halt(pos,t int64){cause,dir:=g.Cause,g.Direction;g.rest("stopped",pos,t);g.Cause=cause;g.Direction=dir;if g.Cause==""{g.Cause="schedule"};if g.Direction==0{g.Direction=-1};g.ClearSince=-1;g.Stops++}
func(d LifeGate)closedState(night bool)string{if night&&d.LockAtNight{return "locked"};return "closed"}
// lowerCause: the strongest live reason to lower; "" when the gate may stay up.
func(g LifeGateState)lowerCause(night bool)string{if g.Lockdown{return "lockdown"};if g.PowerLost{return "power"};if night{return "schedule"};return ""}
// descend starts the descent belonging to cause: powered (ramped) on schedule,
// governor free fall on lockdown and power loss.
func(g *LifeGateState)descend(d LifeGate,cause string,pos,t int64){
 switch cause{
 case "lockdown":g.travel("lockdown",cause,pos,0,t,gateSpan(d.GravityTicks,pos,0),-1)
 case "power":g.travel("no_power",cause,pos,0,t,gateSpan(d.GravityTicks,pos,0),-1)
 default:g.travel("closing","schedule",pos,0,t,gateSpan(d.TravelTicks,pos,0),d.RampTicks)
 }
}

// advance replays every gate event in (Updated, now]. present is the opening
// occupancy observed before this frame's steps (positions and next steps of all
// bodies). A body found under a descending gate stops it at that moment; a
// lowering never starts over a body. Raising never needs an empty opening.
func(g *LifeGateState)advance(d LifeGate,now,seconds int64,present bool){
 t:=g.Updated;if t>now{t=now};night:=!d.ScheduledOpen(seconds)
 for i:=0;i<64;i++{
  pos:=g.Position(t);lower:=g.lowerCause(night)
  switch g.State{
  case "open":
   if lower!=""{g.warn(-1,lower,pos,t);continue}
  case "closed","locked":
   if g.Lockdown{g.rest("lockdown",pos,t);continue}
   if g.PowerLost{g.rest("no_power",pos,t);continue}
   if !night{g.warn(1,"schedule",pos,t);continue}
   if s:=d.closedState(night);s!=g.State{g.rest(s,pos,t);continue}
  case "warning":
   if g.Direction>0&&lower!=""{if pos<=0{g.rest(d.closedState(night),0,t)}else{g.warn(-1,lower,pos,t)};continue}
   if g.Direction<0&&lower==""{if pos>=GateFull{g.rest("open",pos,t)}else{g.warn(1,"schedule",pos,t)};continue}
   if g.Direction<0&&lower!=g.Cause&&(lower=="lockdown"||g.Cause=="schedule"){g.warn(-1,lower,pos,t);continue}
   end:=g.Start+d.warningTicks(g.Cause);if g.Direction>0{end=g.Start+d.WarningTicks}
   if end>now{break}
   t=end
   if g.Direction>0{g.travel("opening","schedule",pos,GateFull,t,gateSpan(d.TravelTicks,pos,GateFull),d.RampTicks);continue}
   if present{g.halt(pos,t);continue}
   g.descend(d,g.Cause,pos,t);continue
  case "opening":
   if lower!=""{g.warn(-1,lower,pos,t);continue}
   if end:=g.Start+g.Duration;end<=now{t=end;g.rest("open",GateFull,t);continue}
  case "closing","lockdown","no_power":
   if g.Duration>0{
    if present{g.halt(pos,t);continue}
    // An alarm or a power loss takes over a powered descent without a new
    // warning: the leaves are already moving and the signals already flash.
    if g.State=="closing"&&(g.Lockdown||g.PowerLost){g.descend(d,lower,pos,t);continue}
    if g.State!="closing"&&lower==""&&!night&&!g.Lockdown&&!g.PowerLost{g.warn(1,"schedule",pos,t);continue}
    if end:=g.Start+g.Duration;end<=now{t=end;if g.State=="closing"{g.rest(d.closedState(night),0,t)}else{g.rest(g.State,0,t)};continue}
    break
   }
   // At rest down: the latched state holds until its input clears.
   if g.State=="lockdown"&&!g.Lockdown||g.State=="no_power"&&!g.PowerLost||g.State=="closing"{g.rest(d.closedState(night),pos,t);continue}
   if g.State=="no_power"&&g.Lockdown{g.rest("lockdown",pos,t);continue}
  case "stopped":
   if present{g.ClearSince=-1;break}
   if g.ClearSince<0{g.ClearSince=t}
   if lower==""{if pos>=GateFull{g.rest("open",pos,t)}else{g.warn(1,"schedule",pos,t)};continue}
   if lower!=g.Cause&&(lower=="lockdown"||g.Cause=="schedule"){g.Cause=lower;g.Start=t}
   // Schedule: retry after the opening stayed clear; alarm/power: pause, then retry with a warning.
   due:=g.ClearSince+d.RetryTicks;if g.Cause!="schedule"{due=g.Start+d.LockdownRetryTicks}
   if due<t{due=t};if due>now{break}
   t=due;g.warn(-1,g.Cause,pos,t);continue
  }
  break
 }
 g.Updated=now
}

func(m LifeModel)gateLevels()[]string{ids:=[]string{};for id,l:=range m.Locations{if len(l.Gates)>0{ids=append(ids,id)}};sort.Strings(ids);return ids}
// startGates: a gate starts raised inside its daily window, otherwise down.
func(m LifeModel)startGates(seconds,now int64)map[string]LifeGateState{
 var out map[string]LifeGateState
 for _,level:=range m.gateLevels(){for _,d:=range m.Locations[level].Gates{if out==nil{out=map[string]LifeGateState{}};g:=LifeGateState{};if d.ScheduledOpen(seconds){g.rest("open",GateFull,now)}else{g.rest(d.closedState(true),0,now)};g.Updated=now;out[d.ID]=g}}
 return out
}
// gatePresence: bodies standing in or stepping into the opening, named or crowd.
func(s LifeState)gatePresence(level string,d LifeGate)bool{
 cells:=make(map[Cell]bool,len(d.Opening));for _,c:=range d.Opening{cells[c]=true}
 for _,a:=range s.Actors{if a.Level==level&&a.OnFloor()&&(cells[a.Position]||len(a.Path)>0&&cells[a.Path[0]]){return true};if a.Level==level&&a.OnFloor()&&a.Body!=nil{for _,c:=range a.Body.Cells{if cells[c]{return true}}}}
 for _,a:=range s.Population.Actors{if a.Materialized&&a.Trip==nil&&a.Level==level&&(cells[a.Position]||len(a.Path)>0&&cells[a.Path[0]]){return true}}
 return false
}
// advanceGates runs once per frame before any body moves, with the calendar
// already at the end of the frame. A gate that left full lift blocks its
// opening for every step of this same frame (GateModel).
func(s *LifeState)advanceGates(m LifeModel,now int64){
 for _,level:=range m.gateLevels(){for _,d:=range m.Locations[level].Gates{
  g,ok:=s.Gates[d.ID];if !ok{continue}
  before:=g.State;g.advance(d,now,s.Seconds,s.gatePresence(level,d));s.Gates[d.ID]=g
  if before!=g.State{s.note("Ворота "+d.ID+": "+g.State)}
 }}
}

// GateModel overlays the live gate glyphs on the opening cells. The result
// shares every untouched map/row with m; m itself is never mutated, so the
// canonical and SDK base worlds stay intact. Idempotent.
func(s LifeState)GateModel(m LifeModel)LifeModel{
 if len(s.Gates)==0{return m}
 var locations map[string]LifeLocation
 for _,level:=range m.gateLevels(){
  l:=m.Locations[level];rows:=l.Terrain;changed:=false
  for _,d:=range l.Gates{g,ok:=s.Gates[d.ID];if !ok{continue};glyph:=g.Glyph(d)
   for _,c:=range d.Opening{if c.Y<0||c.Y>=len(rows)||c.X<0||c.X>=len(rows[c.Y])||rows[c.Y][c.X]==glyph{continue};if !changed{rows=append([]string(nil),rows...);changed=true};b:=[]byte(rows[c.Y]);b[c.X]=glyph;rows[c.Y]=string(b)}
  }
  if !changed{continue}
  if locations==nil{locations=make(map[string]LifeLocation,len(m.Locations));for id,v:=range m.Locations{locations[id]=v}}
  l.Terrain=rows;locations[level]=l
 }
 if locations!=nil{m.Locations=locations}
 return m
}

// SetGateLockdown / SetGatePower latch an input; the next frame reacts at its
// start. Alarm and power loss lower the gate under its own weight after the
// warning; raising again needs both inputs clear (a hand winch is a later hook).
func(s *LifeState)SetGateLockdown(m LifeModel,id string,on bool)error{g,ok:=s.Gates[id];if !ok||m.Gate(id)==nil{return fmt.Errorf("unknown gate %s",id)};g.Lockdown=on;s.Gates[id]=g;return nil}
func(s *LifeState)SetGatePower(m LifeModel,id string,on bool)error{g,ok:=s.Gates[id];if !ok||m.Gate(id)==nil{return fmt.Errorf("unknown gate %s",id)};g.PowerLost=!on;s.Gates[id]=g;return nil}
// Gate returns the definition of a gate and its level.
func(m LifeModel)Gate(id string)*LifeGate{for _,level:=range m.gateLevels(){gates:=m.Locations[level].Gates;for i:=range gates{if gates[i].ID==id{return &gates[i]}}};return nil}
func(m LifeModel)GateLevel(id string)string{for _,level:=range m.gateLevels(){for _,d:=range m.Locations[level].Gates{if d.ID==id{return level}}};return ""}

func(m LifeModel)validateGates()error{
 ids:=map[string]bool{}
 if len(m.gateLevels())>0&&(!m.Walkable["."]||m.Walkable["+"]||m.Walkable["#"]){return fmt.Errorf("gate glyphs need walkable '.' and blocked '+'/'#'")}
 for _,level:=range m.gateLevels(){l:=m.Locations[level];cells:=map[Cell]bool{}
  for _,d:=range l.Gates{
   if d.ID==""||ids[d.ID]||len(d.Opening)==0||len(d.Opening)>256||d.SightClearPPM<1||d.SightClearPPM>GateFull||d.OpenSecond<0||d.OpenSecond>=86400||d.CloseSecond<0||d.CloseSecond>=86400||d.OpenSecond==d.CloseSecond{return fmt.Errorf("invalid gate %s",d.ID)}
   for _,n:=range []int64{d.WarningTicks,d.TravelTicks,d.RetryTicks,d.LockdownWarningTicks,d.LockdownRetryTicks,d.PowerWarningTicks,d.GravityTicks}{if n<1||n>1000000{return fmt.Errorf("invalid gate timing %s",d.ID)}}
   if d.RampTicks<0||2*d.RampTicks>d.TravelTicks{return fmt.Errorf("invalid gate ramp %s",d.ID)}
   ids[d.ID]=true
   for _,c:=range d.Opening{if cells[c]||c.Y<0||c.Y>=len(l.Terrain)||c.X<0||c.X>=len(l.Terrain[c.Y]){return fmt.Errorf("invalid gate opening %s",d.ID)};g:=l.Terrain[c.Y][c.X];if g!='.'&&g!='+'&&g!='#'{return fmt.Errorf("gate opening %s is not floor",d.ID)};cells[c]=true}
  }
  // A routine target under a gate would keep it raised forever.
  for _,p:=range m.Actors{for _,step:=range p.Steps{if step.Level==level&&cells[step.At]{return fmt.Errorf("life agenda %s targets a gate opening",p.ID)}}}
 }
 return nil
}
func(s LifeState)validateGates(m LifeModel,now int64)error{
 count:=0
 for _,level:=range m.gateLevels(){for _,d:=range m.Locations[level].Gates{count++
  g,ok:=s.Gates[d.ID];if !ok{return fmt.Errorf("missing gate state %s",d.ID)}
  if !gateStates[g.State]||g.From<0||g.From>GateFull||g.To<0||g.To>GateFull||g.Duration<0||g.Start>now||g.Updated>now||g.Direction< -1||g.Direction>1||g.Stops<0||g.Ramp<0||2*g.Ramp>g.Duration||g.Linear&&g.Ramp!=0||(g.Cause!=""&&g.Cause!="schedule"&&g.Cause!="lockdown"&&g.Cause!="power"){return fmt.Errorf("invalid gate state %s",d.ID)}
  if (g.State=="open")!=(g.Position(g.Updated)>=GateFull&&g.Duration==0)&&g.State!="warning"&&g.State!="stopped"{return fmt.Errorf("gate %s open state differs from its lift",d.ID)}
  if !g.Passable(){cells:=map[Cell]bool{};for _,c:=range d.Opening{cells[c]=true};for _,a:=range s.Actors{if a.Level==level&&a.OnFloor()&&cells[a.Position]{return fmt.Errorf("actor %s under lowered gate %s",a.ID,d.ID)}}}
 }}
 if len(s.Gates)!=count{return fmt.Errorf("gate states differ from the model")}
 return nil
}
func cloneGates(in map[string]LifeGateState)map[string]LifeGateState{if in==nil{return nil};out:=make(map[string]LifeGateState,len(in));for k,v:=range in{out[k]=v};return out}
