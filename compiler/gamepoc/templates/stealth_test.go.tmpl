	until := r.state.Life.Seconds + 160
	a := r.state.Life.Actor("search.guard")
	r.stealthSearch(combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}, estimate, until)
	first := a.Safety.Goal
	if first == estimate || first.X <= a.Position.X || first.X-a.Position.X > r.world.CombatLife.MaxSafetyCells-1 {
		t.Fatalf("fixture did not produce a bounded partial destination: %+v", first)
	}
	for frame := 0; frame < 20 && !(a.Position == first && a.Arrived); frame++ {
		stealthSearchStep(t, r, estimate, until)
	}
	if a.Position != first || !a.Arrived {
		t.Fatal("first partial destination was not physically reached")
	}
	encoded, err := json.Marshal(r.state)
	if err != nil {
		t.Fatal(err)
	}
	var restored state
	if err := json.Unmarshal(encoded, &restored); err != nil {
		t.Fatal(err)
	}
	loaded := &Runtime{world: r.world, state: restored}
	for frame := 0; frame < 150 && a.Position != estimate; frame++ {
		stealthSearchStep(t, r, estimate, until)
		stealthSearchStep(t, loaded, estimate, until)
		if !reflect.DeepEqual(r.state.Life.Actors, loaded.state.Life.Actors) || r.state.Life.Seconds != loaded.state.Life.Seconds {
			t.Fatal("saved partial search diverged from uninterrupted movement")
		}
	}
	if a.Position != estimate || !a.Arrived {
		t.Fatalf("same remembered estimate stranded the guard at a partial destination: %+v", a)
	}
}
