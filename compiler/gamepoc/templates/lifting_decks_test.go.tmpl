func TestLiftingDeckCyclePhysicalClockAndSkippedDispatches(t *testing.T){
 for _,rate:=range []int64{1,10,30}{t.Run(map[int64]string{1:"1",10:"10",30:"30"}[rate],func(t *testing.T){
  d:=liftingDeckFixture();g:=liftingDeckState{Phase:"rest",NextRunSecond:21600,LastGameSecond:21600,ClearSinceNS:-1};phases:=map[string]bool{};previous:=g.pose(0)
  for step:=int64(1);step<=1200;step++{
   now:=step*100000000;g.advance(d,now,21600+step*rate/10,false,false,false);p:=g.pose(now);phases[g.Phase]=true
   if p.Deck>0&&p.Leaves!=liftingDeckFull{t.Fatal("deck crossed closed leaves")}
   delta:=math.Abs(float64(p.Deck-previous.Deck))/float64(liftingDeckFull)*d.DepthM/.1
   if delta>d.ChamberSpeedMPS+.0001{t.Fatalf("calendar changed physical deck speed: %.6f",delta)}
   if p.Leaves>0&&p.Deck<liftingDeckFull&&g.walkable(){t.Fatal("open shaft became walkable")};previous=p
  }
  for _,phase:=range []string{"equalising","signal_up","barrier_up","unlocking","unseating","opening","rising","loading","signal_down","descending","closing","rest"}{if !phases[phase]{t.Fatalf("missing phase %s: %v",phase,phases)}}
  if rate==30&&g.Skipped==0{t.Fatal("departures queued rather than skipped")}
 })}
}
