		if a.Arrived && a.Level == target.Level && len(a.Path) == 0 && (l.Brain.Enabled||p.atAssignedWork(a)) {
			a.Activity = target.Activity
			if !a.Materialized {
				a.ColdReadyAt = seconds + p.ColdStepSeconds
			}
			continue
		}
		var edge *LifeEdge
		goal := a.Goal
		if a.Level != target.Level {
			edge = l.NextEdge(a.Level, target.Level)
			if edge == nil {
				a.Activity = "waiting_route"
				a.ColdReadyAt = seconds + p.ColdStepSeconds
				continue
			}
			var waiting bool
			goal,waiting=s.platformDestination(p,l,a,edge,occupied,claims,seconds,secondsPerTick)
			if waiting{a.Goal=goal;a.Activity="waiting_platform";continue}
		} else {
			var free bool
			if (l.Brain.Enabled||safety)&&brainTarget.Level!=""{goal=brainTarget.At;free=!a.Materialized||populationCellFree(l,a.Level,goal,occupied,a.ID)}else{goal, free = s.profileDestination(p,l,a,i,occupied)}
			if !free {
				// A preferred address may become closed after a local leg began.
				// Keep the identity, but never save a wall as the physical Goal.
				if !l.Walks(a.Level,a.Goal){a.Goal=a.Position;if len(a.Path)>0{a.Goal=a.Path[len(a.Path)-1]}}
				a.Activity = "waiting_space"
				if !a.Materialized{a.Activity="waiting_route";a.ColdReadyAt=seconds+p.ColdStepSeconds}
				continue
			}
		}
		if !a.Materialized {
			// Coarse simulation may skip individual footsteps, never topology.
			// The shared static component cache makes this O(1) per resident;
			// blocked itineraries retry on the existing cold cadence.
			if !s.routes.connected(a.Level,a.Position,goal){
				a.Goal=goal;a.Activity="waiting_route";a.ColdReadyAt=seconds+p.ColdStepSeconds;continue
			}
			// A coarse local leg consumes one configured interval. Arrival is not a
			// physical cell movement and never generates an offscreen walking path.
			if a.Position != goal {
				if a.Activity == "walking_coarse" && a.Goal == goal && seconds >= a.ColdReadyAt {
					a.Position = goal
				} else {
					a.Goal = goal
					a.ColdReadyAt = seconds + p.ColdStepSeconds
					a.Activity = "walking_coarse"
					continue
				}
			}
		}
		if a.Position == goal && len(a.Path) == 0 {
			if edge == nil {
				a.Arrived = true
				a.Activity = target.Activity
				a.ColdReadyAt = seconds + p.ColdStepSeconds
				continue
			}
			// Reaching a waiting pocket is never permission to board remotely.
			if a.Position!=edge.Exit{a.Activity="waiting_platform";continue}
			a.WaitingDeparture=edge.boardingDeparture(a.WaitingDeparture,seconds,previousSeconds)
			if seconds < a.WaitingDeparture-edge.BoardingWindowSeconds {
				a.Activity = "waiting_departure"
				continue
			}
			slot := departure{edge.ID, a.WaitingDeparture}
			if seats[slot] >= edge.Seats {
				a.Activity = "waiting_seat"
				if edge.PeriodSeconds > 0 {
					a.WaitingDeparture = edge.NextDeparture(a.WaitingDeparture + 1)
				}
				continue
			}
			seats[slot]++
			if a.Materialized {
				populationUnreserve(occupied, a.Level, a.Position, a.ID)
				populationUnreserve(claims, a.Level, a.Goal, a.ID)
				a.Materialized = false
				active--
			}
			a.Trip = &PopulationTrip{Edge: edge.ID, Departure: a.WaitingDeparture, Arrival: a.WaitingDeparture + edge.TravelSeconds}
			a.Path = nil
			a.Queued = false
			a.QueueReason = ""
			a.Activity = "transit"
			continue
		}
		if a.Materialized && (a.Goal != goal || len(a.Path) == 0) {
            if l.Brain.Enabled&&a.Goal==goal&&seconds<a.Brain.PathRetrySecond{continue};a.Brain.PathRetrySecond=seconds+10
			if len(a.Path) > 0 && tick < a.MoveStartTick+p.MoveTicks {
				a.Path = a.Path[:1]
				a.Activity = "walking"
				continue
			}
			if len(a.Path) > 0 {
				populationUnreserve(occupied, a.Level, a.Path[0], a.ID)
			}
			a.Goal = goal
			a.Path = nil
			if !s.routes.connected(a.Level, a.Position, goal) {
				a.Activity = "waiting_route"
				continue
			}
			avoid:=map[Cell]bool(nil);if environment.NewPathAvoid!=nil{avoid=environment.NewPathAvoid(*a)}
            space:=l.Space(a.Level,avoid);space.Occupied=func(at Cell)bool{id:=occupied[a.Level][at];return id!=""&&id!=a.ID}
            a.Path=space.Path(a.Position,goal,Cell{},0)
			a.MoveStartTick = tick
			if len(a.Path) > 0 {
				populationReserve(occupied, a.Level, a.Path[0], a.ID)
				a.Activity = "walking"
			} else {
				a.Activity = "waiting_path"
			}
		}
	}
	return nil
}

// Validate checks persisted identity, transitions and physical positions. Coarse
// anchors intentionally do not occupy scene cells. Admission queues never count
// as rendered/physical residents, and no queued actor may carry a walking path.
func (s PopulationState) Validate(p PopulationModel, l LifeModel, seconds, tick int64) error {
 if err:=s.Decisions.Validate(tick,seconds);err!=nil{return err};if len(s.Decisions.Last)>len(s.Actors){return fmt.Errorf("oversized population decision index")}
	if err := p.Validate(l); err != nil {
		return err
	}
	if seconds < 0 || tick < 0 || s.LastSeconds < 0 || s.LastSeconds > seconds || s.LastTick < 0 || s.LastTick > tick || s.Count < 0 || s.Count > p.MaxActors || len(s.Actors) != s.Count {
		return fmt.Errorf("invalid population clock/count")
	}
	if s.ActiveLevel != "" {
		if _, ok := l.Locations[s.ActiveLevel]; !ok {
			return fmt.Errorf("invalid population active level")
		}
	}
	// Saved phases belong to the identity. New residents may use a reordered or
	// extended authored pool without silently changing existing daily lives.
	if err:=p.validateAssignments(s.Actors);err!=nil{return err}
	positions := map[string]map[Cell]string{}
	reserved := map[string]map[Cell]string{}
	active := 0
	type departure struct {
		edge string
		at   int64
	}
	seats := map[departure]int{}
	for i, a := range s.Actors {
        if a.CombatHold&&(a.Trip!=nil||len(a.Path)>0||a.Safety!=nil){return fmt.Errorf("invalid held population actor")}
        if err:=a.Safety.validate(l,a.Level,seconds);err!=nil{return err}
        if err:=a.Brain.Validate(l.Brain,seconds);err!=nil{return err}
		if err:=p.validateProfile(a.Profile,l);err!=nil{return fmt.Errorf("population actor %s: %w",a.ID,err)}
		if len(p.ShiftOffsets) == 0 || a.ID != fmt.Sprintf("population.%04d", i+1) || a.Name == "" || a.Stage < 0 || a.Stage >= len(p.Stages) || !p.profileShiftAllowed(a.Profile,a.ShiftSeconds) || !l.Walks(a.Level, a.Position) || !l.Walks(a.Level, a.Goal) || a.YieldUntil < 0 || a.YieldUntil > l.MotionTick(tick,seconds)+8*p.MoveTicks || a.MoveStartTick < 0 || a.MoveStartTick > l.MotionTick(tick,seconds) || a.WaitingDeparture < 0 || a.ColdReadyAt < 0 || a.Activity == "" || a.Visits == nil {
			return fmt.Errorf("invalid population actor %s", a.ID)
		}
		if a.YieldRequester != "" && (a.YieldRequester == a.ID || l.Person(a.YieldRequester) == nil || !l.Walks(a.Level, a.YieldOrigin) || a.YieldHoldUntil < 0 || a.YieldHoldUntil > l.MotionTick(tick,seconds)+16*p.MoveTicks) {
			return fmt.Errorf("invalid population courtesy hold")
		}
		if a.YieldCooldownUntil < 0 || a.YieldCooldownUntil > l.MotionTick(tick,seconds)+10*p.MoveTicks { return fmt.Errorf("invalid population courtesy cooldown") }
		if l.Person(a.ID) != nil {
			return fmt.Errorf("population identity collides with named actor")
		}
		for level, visits := range a.Visits {
			if _, ok := l.Locations[level]; !ok || visits < 1 {
				return fmt.Errorf("invalid population visits")
			}
		}
		if a.Visits[a.Level] < 1 {
			return fmt.Errorf("missing population current visit")
		}
		if a.Queued && (a.Materialized || len(a.Path) > 0 || a.Activity != "waiting_entry" || (a.QueueReason != "active_limit" && a.QueueReason != "entry_occupied")) {
			return fmt.Errorf("invalid population admission queue")
		}
		if !a.Queued && a.QueueReason != "" {
			return fmt.Errorf("stale population queue reason")
		}
		if a.Trip != nil {
			edge := l.Edge(a.Trip.Edge)
			if edge == nil || a.Level != edge.From || a.Position != edge.Exit || a.Trip.Departure < 0 || !edge.validBoardedDeparture(a.Trip.Departure,s.LastSeconds) || a.Trip.Arrival != a.Trip.Departure+edge.TravelSeconds || len(a.Path) > 0 || a.Materialized {
				return fmt.Errorf("invalid population trip")
			}
			slot := departure{a.Trip.Edge, a.Trip.Departure}
			seats[slot]++
			if seats[slot] > edge.Seats {
				return fmt.Errorf("population overbooked departure")
			}
		}
		if a.Materialized {
			if a.Level != s.ActiveLevel || a.Trip != nil {
				return fmt.Errorf("materialized population outside active level")
			}
			active++
			if positions[a.Level] == nil {
				positions[a.Level] = map[Cell]string{}
			}
			if positions[a.Level][a.Position] != "" {
				return fmt.Errorf("population actors overlap")
			}
			positions[a.Level][a.Position] = a.ID
		} else if len(a.Path) > 0 {
			return fmt.Errorf("offscreen population has physical path")
		}
		terrain := l.Locations[a.Level].Terrain
		if len(a.Path) > len(terrain)*len(terrain[0]) {
			return fmt.Errorf("oversized population walking path")
		}
		previous := a.Position
		for _, at := range a.Path {
			if !l.Walks(a.Level, at) || !l.Adjacent(a.Level, previous, at) {
				return fmt.Errorf("invalid population walking path")
			}
			previous = at
		}
		if len(a.Path) > 0 {
			if reserved[a.Level] == nil {
				reserved[a.Level] = map[Cell]string{}
			}
			if reserved[a.Level][a.Path[0]] != "" {
				return fmt.Errorf("population steps share reservation")
			}
			reserved[a.Level][a.Path[0]] = a.ID
		}
	}
	if active > p.MaxActive {
		return fmt.Errorf("population active limit exceeded")
	}
	for level, cells := range reserved {
		for at, id := range cells {
			if other := positions[level][at]; other != "" && other != id {
				return fmt.Errorf("population reservation overlaps resident")
			}
		}
	}
	return nil
}
