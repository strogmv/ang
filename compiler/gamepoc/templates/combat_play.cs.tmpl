     beat.rear=e.Mode=="stun_blow"&&e.Type=="attack";if(beat.rear){string was;if(!combatLastHeld.TryGetValue(e.TargetId,out was)&&state!=null)foreach(var g in state.GroundWeapons)if(g.OwnerId==e.TargetId){was=g.Definition;break;}if(!string.IsNullOrEmpty(was))CombatBodyOf(e.TargetId).held=was;}beat.mode=CombatModeOf(e);{var tl=CombatLook();if(tl!=null&&tl.throat!=null&&e.Mode==tl.throat.mode&&e.Type=="attack"){beat.pair=true;beat.mode=e.Mode;beat.endCell=from;string lastHeld;if(!combatLastHeld.TryGetValue(e.TargetId,out lastHeld)&&state!=null)foreach(var g in state.GroundWeapons)if(g.OwnerId==e.TargetId){lastHeld=g.Definition;break;}if(!string.IsNullOrEmpty(lastHeld))CombatBodyOf(e.TargetId).held=lastHeld;}}
