// The talk's clock (owner 21.11): while the hero answers, the world waits; the custody waits its answer seconds of the open
// column, then times out; a column the hero closes lets the world go on and the talk comes back on «Talk».
func TestMemoryTalkHoldsTheWorldAndKeepsItsOwnTime(t *testing.T) {
	r := dialogueCustody(t, nil)
	e := r.world.CalendarEncounter
	d := custodyConv(r)
	if d.AnswerSeconds <= 0 {
		t.Skip("the custody waits for ever")
	}
	game := r.state.Life.Seconds
	hz := int64(r.world.Config.TickHz)
	before := r.snapshotState()
	for i := int64(1); i < d.AnswerSeconds*hz; i++ {
		r.step()
	}
	if r.state.Life.Seconds != game || r.state.CalendarEncounter.Outcome != "" {
		t.Fatalf("the world moved during the talk: %d → %d, outcome %q", game, r.state.Life.Seconds, r.state.CalendarEncounter.Outcome)
	}
	// the whole world step waited (the tick, reservations, zones, everything): only the talk's own clock moved
	after := r.snapshotState()
	after.Memory, before.Memory = memoryState{}, memoryState{}
	if stateDigest(t, after) != stateDigest(t, before) {
		var x, y map[string]json.RawMessage
		a, _ := json.Marshal(before)
		b, _ := json.Marshal(after)
		_ = json.Unmarshal(a, &x)
		_ = json.Unmarshal(b, &y)
		changed := []string{}
		for k := range y {
			if string(x[k]) != string(y[k]) {
				changed = append(changed, k)
			}
		}
		t.Fatalf("the world changed while the talk held it: %v", changed)
	}
	r.step()
	if s := r.state.CalendarEncounter; s.Choice != "timeout" || s.Outcome != "forced" {
		t.Fatalf("the answer time ran out without the timeout: %+v", s)
	}
	if _, ok := r.state.Memory.Facts["fact.prokhor.custody_late"]; !ok {
		t.Fatal("the timeout wrote no fact")
	}
	// the last words linger in real seconds while the world goes on
	until := custodyTalk(r).Until
	if until != r.state.Tick+d.LingerSeconds*hz && until != r.state.Tick-1+d.LingerSeconds*hz {
		t.Fatalf("linger until tick %d, now %d", until, r.state.Tick)
	}
	r.step()
	if r.state.Life.Seconds == game {
		t.Fatal("the world still waits after the talk closed")
	}
	// a paused game stops the talk's clock
	w := dialogueCustody(t, nil)
	w.state.Paused = true
	for i := int64(0); i < 2*d.AnswerSeconds*hz; i++ {
		w.step()
	}
	if w.state.CalendarEncounter.Outcome != "" || custodyTalk(w).Ticks != 0 {
		t.Fatal("the talk's clock ran while the game was paused")
	}
	// the hero closes the column: the client's own command over the wire; the custody steps aside, the world goes on,
	// «Talk» with Prokhor brings it back
	w.state.Paused = false
	leave(t, w)
	if !custodyTalk(w).Hidden || w.talkHolds() {
		t.Fatal("a closed custody column still holds the world")
	}
	msg := &pb.PocGameState{}
	w.appendConversation(msg, "ru")
	if msg.Conversation != nil {
		t.Fatal("a closed custody column is still shown")
	}
	if conv, ok := w.talkAvailable(e.Actor); !ok || conv != e.Talk.Custody {
		t.Fatal("the hero cannot come back to the custody")
	}
	if err := w.conversationCommand(&pb.PocLifeCommand{Action: "conversation_open", Destination: e.Actor}); err != nil {
		t.Fatal(err)
	}
	if custodyTalk(w).Hidden || !w.talkHolds() {
		t.Fatal("the custody did not come back")
	}
	// an ordinary talk ends when its column closes
	x := memoryDay(t, 1)
	atTheSack(t, x)
	x.calendarEncounterAfterFrame()
	if !x.talkHolds() {
		t.Fatal("the first meeting at the sack does not hold the world")
	}
	leave(t, x)
	if x.state.Memory.Open != "" || x.talkHolds() {
		t.Fatalf("leaving the sack talk left it open: %q", x.state.Memory.Open)
	}
	seconds := x.state.Life.Seconds
	x.step()
	if x.state.Life.Seconds == seconds {
		t.Fatal("the world stays frozen after the column closed")
	}
}

// leave: the life_command the conversation screen's close sends (Esc), through the server's command path.
func leave(t *testing.T, r *Runtime) {
	t.Helper()
	c := &connection{out: make(chan *pb.ServerMessage, 64), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_LifeCommand{LifeCommand: &pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: fmt.Sprintf("leave.%d", r.state.Tick), Action: "conversation_leave"}}}})
	for len(c.out) > 0 {
		if res := (<-c.out).GetActionResult(); res != nil && !res.Ok {
			t.Fatalf("the server refused the leave: %+v", res)
		}
	}
}

