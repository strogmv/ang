	// calendar rate as at ×1 (at ×30 a tick or two); the hero's doors keep their real seconds.
	if p.ActorID != playerActorID && r.state.Life.SecondsPerTick > 1 {
		duration /= float64(r.state.Life.SecondsPerTick)
	}
	start := r.simNS()
	// a timed step of a person of the Life that ended within this frame: the next one starts when it ended
	if p.ActorID != playerActorID && r.state.Life.SecondsPerTick > 1 && p.PhaseEndNS > p.PhaseStartNS && p.PhaseEndNS <= start {
		start = p.PhaseEndNS
	}
	p.Phase = phase
	p.PhaseStartNS = start
	p.PhaseEndNS = p.PhaseStartNS + int64(duration*1e9)
	p.LastSecond = r.state.Life.Seconds
	p.ExitBlocked = false
}

// Service ownership suspends movement decisions, not the authored duty break.
// Its saved timestamps and post remain in LifeBrain; release resumes that return.
func sanitaryRestoreDutyBreak(a *behavior.LifeActor, p sanitaryUser, returning bool) {
	if p.ReturnBySecond > 0 {
		a.Brain.BreakKind = "hygiene"
		a.Brain.Returning = returning
	}
}

func (r *Runtime) sanitaryHoldUsers() {
	for id, p := range r.state.Sanitary.Users {
		if a := r.state.Life.Actor(id); a != nil {
			sanitaryRestoreDutyBreak(a, p, false)
		}
		if p.Phase == "approach" || r.sanitaryWaitWalking(id, p) {
			continue
		}
		if a := r.state.Life.Actor(id); a != nil {
			a.Manual = true
			a.CombatHold = true
			a.Body = nil
			a.Path = nil
			a.PendingPath = nil
			a.Goal = a.Position
			a.OverrideLevel = ""
			a.OverrideEdge = ""
			a.Activity = "sanitary"
			a.Label = "sanitary.phase." + p.Phase
		}
	}
}
// A queued person with a wait cell is walking until standing on it.
func (r *Runtime) sanitaryWaitWalking(id string, p sanitaryUser) bool {
	a := r.state.Life.Actor(id)
	return p.Phase == "queued" && p.WaitAt != nil && a != nil && !a.CombatHold
