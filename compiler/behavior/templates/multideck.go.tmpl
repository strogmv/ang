// Code generated by ANG. Multi-deck locations: navigation plane and 3D sight (document 80).
package behavior

import (
	"errors"
	"math"
	"sync"
)

// DeckVolume is the server's copy of a compiled multi-deck layout. Every
// walkable surface is one band of the navigation plane; each stair is a
// block of nodes. Plan cells are 500 mm; heights are absolute millimetres.
// Only sight uses the vertical data: movement stays an ordinary grid walk
// over the plane plus explicit links (LifeLocation.Links).
type DeckVolume struct {
	Schema          string          `json:"schema"`
	PlanWidth       int             `json:"plan_width"`
	PlanDepth       int             `json:"plan_depth"`
	NavWidth        int             `json:"nav_width"`
	NavDepth        int             `json:"nav_depth"`
	EyeMM           int             `json:"eye_mm"`
	TargetMM        []int           `json:"target_mm"`
	SightRangeCells int             `json:"sight_range_cells"`
	Surfaces        []DeckSurface   `json:"surfaces"`
	Connectors      []DeckConnector `json:"connectors"`
	Links           []LifeLink      `json:"links"`
	Solids          []DeckSpan      `json:"solids"`
	Edges           []DeckEdge      `json:"edges"`

	navPlan   []int32 // navigation index -> plan index, -1 when not standable
	navHeight []int32
	navDeck   []int16 // navigation index -> surface index, or -1-connector for stair nodes
	spans     [][]deckInterval
	edges     map[deckEdgeKey][]deckInterval
	// Static geometry: the visible set of an observer cell never changes, so
	// it is computed once per (cell, range). Shared by value copies; bounded.
	sight *deckSightCache
	// Continuous hero body (life_body.go): stair nodes by plan cell, links.
	body *deckBodyIndex
}

type deckSightKey struct {
	from   Cell
	radius int
}
type deckSightCache struct {
	mu   sync.Mutex
	sets map[deckSightKey][]uint64
}

const deckSightCacheEntries = 512

type DeckRect struct{ X, Y, W, H int }
type DeckSurface struct {
	ID          string     `json:"id"`
	Index       int        `json:"index"`
	ElevationMM int        `json:"elevation_mm"`
	SlabMM      int        `json:"slab_mm"`
	Walkable    bool       `json:"walkable"`
	Grounded    bool       `json:"grounded"`
	NavRow      int        `json:"nav_row"`
	Slab        []DeckRect `json:"slab"`
}
type DeckNode struct {
	Nav      Cell `json:"nav"`
	Plan     Cell `json:"plan"`
	HeightMM int  `json:"height_mm"`
}
type DeckConnector struct {
	ID    string     `json:"id"`
	Nodes []DeckNode `json:"nodes"`
}
type DeckSpan struct {
	Rect     DeckRect `json:"rect"`
	BottomMM int      `json:"bottom_mm"`
	TopMM    int      `json:"top_mm"`
}
type DeckEdge struct {
	At       Cell   `json:"at"`
	Side     string `json:"side"`
	BottomMM int    `json:"bottom_mm"`
	TopMM    int    `json:"top_mm"`
}
type deckInterval struct{ bottom, top float64 }
type deckEdgeKey struct {
	at   int
	side byte
}

const deckCellMM = 500.0

// Prepare validates the volume once and builds its private indexes.
func (v *DeckVolume) Prepare() error {
	if v.Schema != "ang.multideck.v1" || v.PlanWidth < 1 || v.PlanDepth < 1 || v.NavWidth != v.PlanWidth || v.NavDepth < v.PlanDepth || v.NavWidth*v.NavDepth > 1<<20 || v.EyeMM < 500 || v.EyeMM > 2500 || len(v.TargetMM) == 0 || v.SightRangeCells < 1 || v.SightRangeCells > 256 || len(v.Surfaces) == 0 || len(v.Surfaces) > 32 {
		return errors.New("invalid multi-deck volume")
	}
	plan := v.PlanWidth * v.PlanDepth
	nav := v.NavWidth * v.NavDepth
	v.navPlan, v.navHeight, v.navDeck = make([]int32, nav), make([]int32, nav), make([]int16, nav)
	for i := range v.navPlan {
		v.navPlan[i] = -1
	}
	v.spans = make([][]deckInterval, plan)
	v.sight = &deckSightCache{sets: map[deckSightKey][]uint64{}}
	inPlan := func(r DeckRect) bool {
		return r.X >= 0 && r.Y >= 0 && r.W >= 1 && r.H >= 1 && r.X+r.W <= v.PlanWidth && r.Y+r.H <= v.PlanDepth
	}
	for si, s := range v.Surfaces {
		if s.Index != si {
			return errors.New("multi-deck surface order")
		}
		if s.Walkable && (s.NavRow < 0 || s.NavRow+v.PlanDepth > v.NavDepth) {
			return errors.New("multi-deck surface band")
		}
		bottom := float64(s.ElevationMM - s.SlabMM)
		if s.Grounded {
			bottom = -1e9
		}
		for _, r := range s.Slab {
			if !inPlan(r) {
				return errors.New("multi-deck slab outside plan")
			}
			for y := r.Y; y < r.Y+r.H; y++ {
				for x := r.X; x < r.X+r.W; x++ {
					n := y*v.PlanWidth + x
					v.spans[n] = append(v.spans[n], deckInterval{bottom, float64(s.ElevationMM)})
					if s.Walkable {
						k := (s.NavRow+y)*v.NavWidth + x
						v.navPlan[k], v.navHeight[k], v.navDeck[k] = int32(n), int32(s.ElevationMM), int16(si)
					}
				}
			}
		}
	}
	for ci, c := range v.Connectors {
		for _, node := range c.Nodes {
			if node.Nav.X < 0 || node.Nav.Y < v.PlanDepth || node.Nav.X >= v.NavWidth || node.Nav.Y >= v.NavDepth || node.Plan.X < 0 || node.Plan.Y < 0 || node.Plan.X >= v.PlanWidth || node.Plan.Y >= v.PlanDepth {
				return errors.New("multi-deck stair node outside plane")
			}
			k := node.Nav.Y*v.NavWidth + node.Nav.X
			if v.navPlan[k] >= 0 {
				return errors.New("multi-deck stair node overlaps a surface")
			}
			v.navPlan[k], v.navHeight[k], v.navDeck[k] = int32(node.Plan.Y*v.PlanWidth+node.Plan.X), int32(node.HeightMM), int16(-1-ci)
		}
	}
	for _, s := range v.Solids {
		if !inPlan(s.Rect) || s.TopMM <= s.BottomMM {
			return errors.New("multi-deck solid outside plan")
		}
		for y := s.Rect.Y; y < s.Rect.Y+s.Rect.H; y++ {
			for x := s.Rect.X; x < s.Rect.X+s.Rect.W; x++ {
				n := y*v.PlanWidth + x
				v.spans[n] = append(v.spans[n], deckInterval{float64(s.BottomMM), float64(s.TopMM)})
			}
		}
	}
	v.edges = map[deckEdgeKey][]deckInterval{}
	for _, e := range v.Edges {
		d, ok := deckSide(e.Side)
		if !ok || e.At.X < 0 || e.At.Y < 0 || e.At.X >= v.PlanWidth || e.At.Y >= v.PlanDepth || e.TopMM <= e.BottomMM {
			return errors.New("multi-deck sight edge")
		}
		iv := deckInterval{float64(e.BottomMM), float64(e.TopMM)}
		v.edges[deckEdgeKey{e.At.Y*v.PlanWidth + e.At.X, e.Side[0]}] = append(v.edges[deckEdgeKey{e.At.Y*v.PlanWidth + e.At.X, e.Side[0]}], iv)
		nx, ny := e.At.X+d.X, e.At.Y+d.Y
		if nx >= 0 && ny >= 0 && nx < v.PlanWidth && ny < v.PlanDepth {
			opposite := map[byte]byte{'n': 's', 's': 'n', 'e': 'w', 'w': 'e'}[e.Side[0]]
			key := deckEdgeKey{ny*v.PlanWidth + nx, opposite}
			v.edges[key] = append(v.edges[key], iv)
		}
	}
	for _, l := range v.Links {
		if v.navIndex(l.A) < 0 || v.navIndex(l.B) < 0 || v.navPlan[v.navIndex(l.A)] < 0 || v.navPlan[v.navIndex(l.B)] < 0 {
			return errors.New("multi-deck link outside standable cells")
		}
	}
	v.buildBodyIndex()
	return nil
}

func deckSide(side string) (Cell, bool) {
	switch side {
	case "north":
		return Cell{0, -1}, true
	case "east":
		return Cell{1, 0}, true
	case "south":
		return Cell{0, 1}, true
	case "west":
		return Cell{-1, 0}, true
	}
	return Cell{}, false
}

func (v *DeckVolume) navIndex(c Cell) int {
	if c.X < 0 || c.Y < 0 || c.X >= v.NavWidth || c.Y >= v.NavDepth {
		return -1
	}
	return c.Y*v.NavWidth + c.X
}

// Locate maps a navigation cell to its plan cell, standing height and surface
// index (negative: -1-connector for a stair node).
func (v *DeckVolume) Locate(nav Cell) (plan Cell, heightMM int, surface int, ok bool) {
	k := v.navIndex(nav)
	if k < 0 || v.navPlan[k] < 0 {
		return Cell{}, 0, 0, false
	}
	p := int(v.navPlan[k])
	return Cell{p % v.PlanWidth, p / v.PlanWidth}, int(v.navHeight[k]), int(v.navDeck[k]), true
}

// SurfaceIndex is the API deck index of a navigation cell: surfaces 0..N-1,
// then stairs N..N+M-1 (document 80). ok=false for a cell nobody stands on.
func (v *DeckVolume) SurfaceIndex(nav Cell) (int, bool) {
	_, _, s, ok := v.Locate(nav)
	if !ok {
		return 0, false
	}
	if s < 0 {
		return len(v.Surfaces) + (-1 - s), true
	}
	return s, true
}

// Within is the sight range test in plan cells (Manhattan), independent of bands.
func (v *DeckVolume) Within(from, to Cell, radius int) bool {
	a, _, _, ok := v.Locate(from)
	b, _, _, ok2 := v.Locate(to)
	if !ok || !ok2 {
		return false
	}
	return Distance(a, b) <= radius
}

// VisibleWithin is Within && Sees through the per-observer cache: one full
// scan of the plane per observer cell and range, then a bit lookup.
func (v *DeckVolume) VisibleWithin(from, to Cell, radius int) bool {
	k := v.navIndex(to)
	if k < 0 || v.sight == nil {
		return v.Within(from, to, radius) && v.Sees(from, to)
	}
	key := deckSightKey{from, radius}
	v.sight.mu.Lock()
	bits, ok := v.sight.sets[key]
	v.sight.mu.Unlock()
	if !ok {
		bits = make([]uint64, (v.NavWidth*v.NavDepth+63)/64)
		for n := range v.navPlan {
			c := Cell{n % v.NavWidth, n / v.NavWidth}
			if v.navPlan[n] >= 0 && v.Within(from, c, radius) && v.Sees(from, c) {
				bits[n/64] |= 1 << uint(n%64)
			}
		}
		v.sight.mu.Lock()
		if len(v.sight.sets) >= deckSightCacheEntries {
			v.sight.sets = map[deckSightKey][]uint64{}
		}
		v.sight.sets[key] = bits
		v.sight.mu.Unlock()
	}
	return bits[k/64]>>uint(k%64)&1 == 1
}

// Sees: a cell is visible when a target point 1.0 m or 1.7 m above its floor is
// in line of sight from the observer's eye (1.6 m). Slabs, walls, columns,
// beams, stair bodies and sheet balustrades are opaque intervals; glazing,
// open rails and voids are transparent. Two touching corners never form a
// peephole (the planar rule).
func (v *DeckVolume) Sees(from, to Cell) bool {
	pf, hf, _, ok := v.Locate(from)
	pt, ht, _, ok2 := v.Locate(to)
	if !ok || !ok2 {
		return false
	}
	if from == to {
		return true
	}
	eye := float64(hf + v.EyeMM)
	for _, t := range v.TargetMM {
		if v.clear(pf, eye, pt, float64(ht+t)) {
			return true
		}
	}
	return false
}

func (v *DeckVolume) blocked(n int, z0, z1 float64) bool {
	lo, hi := math.Min(z0, z1), math.Max(z0, z1)
	for _, iv := range v.spans[n] {
		if iv.bottom < hi && iv.top > lo {
			return true
		}
	}
	return false
}

// blockedFinal checks the target cell: a solid that contains the target point
// is the thing being looked at (its near face), as in the planar rule.
func (v *DeckVolume) blockedFinal(n int, z0, z1 float64) bool {
	lo, hi := math.Min(z0, z1), math.Max(z0, z1)
	for _, iv := range v.spans[n] {
		if iv.bottom < hi && iv.top > lo && !(iv.bottom <= z1 && z1 <= iv.top) {
			return true
		}
	}
	return false
}

func (v *DeckVolume) edgeBlocked(n int, side byte, z float64) bool {
	for _, iv := range v.edges[deckEdgeKey{n, side}] {
		if iv.bottom < z && iv.top > z {
			return true
		}
	}
	return false
}

func (v *DeckVolume) clear(a Cell, za float64, b Cell, zb float64) bool {
	w := v.PlanWidth
	if a == b {
		return !v.blockedFinal(a.Y*w+a.X, za, zb)
	}
	dx, dy := float64(b.X-a.X), float64(b.Y-a.Y)
	z := func(t float64) float64 { return za + (zb-za)*t }
	cx, cy := a.X, a.Y
	stepX, stepY := 0, 0
	tMaxX, tMaxY, tDeltaX, tDeltaY := math.Inf(1), math.Inf(1), math.Inf(1), math.Inf(1)
	var sideX, sideY, backX, backY byte = 'e', 's', 'w', 'n'
	if dx > 0 {
		stepX, tDeltaX = 1, 1/dx
	} else if dx < 0 {
		stepX, tDeltaX, sideX, backX = -1, -1/dx, 'w', 'e'
	}
	if dy > 0 {
		stepY, tDeltaY = 1, 1/dy
	} else if dy < 0 {
		stepY, tDeltaY, sideY, backY = -1, -1/dy, 'n', 's'
	}
	if stepX != 0 {
		tMaxX = .5 * tDeltaX
	}
	if stepY != 0 {
		tMaxY = .5 * tDeltaY
	}
	t := 0.0
	const eps = 1e-9
	for {
		n := cy*w + cx
		next := math.Min(math.Min(tMaxX, tMaxY), 1)
		if cx == b.X && cy == b.Y {
			return !v.blockedFinal(n, z(t), zb)
		}
		if v.blocked(n, z(t), z(next)) {
			return false
		}
		if next >= 1-eps || cx == b.X && cy == b.Y {
			return true
		}
		zc := z(next)
		switch {
		case tMaxX < tMaxY-eps:
			if v.edgeBlocked(n, sideX, zc) || v.edgeBlocked(cy*w+cx+stepX, backX, zc) {
				return false
			}
			cx += stepX
			t, tMaxX = tMaxX, tMaxX+tDeltaX
		case tMaxY < tMaxX-eps:
			if v.edgeBlocked(n, sideY, zc) || v.edgeBlocked((cy+stepY)*w+cx, backY, zc) {
				return false
			}
			cy += stepY
			t, tMaxY = tMaxY, tMaxY+tDeltaY
		default:
			// Exact corner: pass if at least one of the two side cells is clear.
			viaX := !v.edgeBlocked(n, sideX, zc) && !v.blocked(cy*w+cx+stepX, zc, zc) && !v.edgeBlocked(cy*w+cx+stepX, sideY, zc)
			viaY := !v.edgeBlocked(n, sideY, zc) && !v.blocked((cy+stepY)*w+cx, zc, zc) && !v.edgeBlocked((cy+stepY)*w+cx, sideX, zc)
			if !viaX && !viaY {
				return false
			}
			cx, cy = cx+stepX, cy+stepY
			t, tMaxX, tMaxY = tMaxX, tMaxX+tDeltaX, tMaxY+tDeltaY
		}
		if cx < 0 || cy < 0 || cx >= w || cy >= v.PlanDepth {
			return false
		}
	}
}
