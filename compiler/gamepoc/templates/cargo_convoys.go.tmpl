type cargoConvoyCatalog struct {
 Convoys []cargoConvoyDefinition `json:"convoys"`
 DeliveryTrolley struct {Resource string `json:"resource"`; CouplingForwardM float64 `json:"coupling_forward_m"`} `json:"delivery_trolley"`
}
type cargoConvoyDefinition struct {
 ID string `json:"id"`; DeckID string `json:"deck_id"`
 Tug struct {Resource string `json:"resource"`; HitchBackM float64 `json:"hitch_back_m"`; NoseM float64 `json:"nose_m"`; HalfWidthM float64 `json:"half_width_m"`; SeatM []float64 `json:"seat_m"`} `json:"tug"`
 Trailer struct {Resource string `json:"resource"`; EyeM float64 `json:"eye_m"`; TailM float64 `json:"tail_m"`; HalfWidthM float64 `json:"half_width_m"`} `json:"trailer"`
 SpeedMMPerSecond int64 `json:"speed_mm_per_second"`; TurnRadiusM float64 `json:"turn_radius_m"`
 Driver string `json:"driver"`; Loaders []string `json:"loaders"`
 LoadSecond int64 `json:"load_second"`; BoardSecond int64 `json:"board_second"`; UnloadSeconds int64 `json:"unload_seconds"`
 Labels struct {Rest string `json:"rest"`; Loading string `json:"loading"`; Driving string `json:"driving"`; Riding string `json:"riding"`; Unloading string `json:"unloading"`; Waiting string `json:"waiting"`} `json:"labels"`
 Lower struct {LevelID string `json:"level_id"`; Board [][2]float64 `json:"board"`; Leave [][2]float64 `json:"leave"`; Rest []behavior.Cell `json:"rest"`; Loading []behavior.Cell `json:"loading"`; Deck []behavior.Cell `json:"deck"`} `json:"lower"`
 Upper struct {LevelID string `json:"level_id"`; Leave [][2]float64 `json:"leave"`; Turn [][2]float64 `json:"turn"`; Board [][2]float64 `json:"board"`; Unloading []behavior.Cell `json:"unloading"`; Staging []behavior.Cell `json:"staging"`; Deck []behavior.Cell `json:"deck"`} `json:"upper"`
}
// Phase names the leg; S is the distance along that leg's track in millimetres.
// Day is the shift already started (day index + 1); Run is the deck run it rode up with.
type cargoConvoyState struct {
 Phase string `json:"phase"`; S int64 `json:"s_mm"`; Day int64 `json:"day"`; Run int64 `json:"run"`
 UnloadStart int64 `json:"unload_start"`; Unloaded bool `json:"unloaded,omitempty"`; UpdatedNS int64 `json:"updated_ns"`
}
type cargoPose struct {X,Y,Z,Yaw float64}

func cloneCargoConvoys(in map[string]cargoConvoyState)map[string]cargoConvoyState{if in==nil{return nil};out:=make(map[string]cargoConvoyState,len(in));for k,v:=range in{out[k]=v};return out}
func(r *Runtime)initCargoConvoys(){r.state.CargoConvoys=nil;if r.world.CargoConvoys==nil{return};r.state.CargoConvoys=map[string]cargoConvoyState{};for _,v:=range r.world.CargoConvoys.Convoys{r.state.CargoConvoys[v.ID]=cargoConvoyState{Phase:"parked"}}}
func(v cargoConvoyDefinition)track(phase string)[][2]float64{
 switch phase{
 case "parked","loading","lower_boarding","lower_on_deck":return v.Lower.Board
 case "riding_down","lower_leaving":return v.Lower.Leave
 case "upper_leaving","unloading":return v.Upper.Leave
 case "upper_turning","upper_staged":return v.Upper.Turn
 case "upper_boarding","upper_on_deck":return v.Upper.Board
 }
 return nil
}
func cargoTrackLength(track [][2]float64)float64{n:=0.0;for i:=1;i<len(track);i++{n+=math.Hypot(track[i][0]-track[i-1][0],track[i][1]-track[i-1][1])};return n}
// A point at distance s along a track; before the start and past the end the track continues straight.
func cargoTrackAt(track [][2]float64,s float64)(float64,float64){
 if s<=0{dx,dy:=track[1][0]-track[0][0],track[1][1]-track[0][1];l:=math.Hypot(dx,dy);return track[0][0]+dx/l*s,track[0][1]+dy/l*s}
 for i:=1;i<len(track);i++{dx,dy:=track[i][0]-track[i-1][0],track[i][1]-track[i-1][1];l:=math.Hypot(dx,dy);if s<=l||i==len(track)-1{return track[i-1][0]+dx/l*s,track[i-1][1]+dy/l*s};s-=l}
 return track[len(track)-1][0],track[len(track)-1][1]
}
// The tug's rear axle is on the track; the trailer's rear axle follows the same track one drawbar behind,
// and each body looks along its own chord. The result is a pure function of the distance.
func(v cargoConvoyDefinition)poses(track [][2]float64,s,height float64)(cargoPose,cargoPose){
 ax,az:=cargoTrackAt(track,s);fx,fz:=cargoTrackAt(track,s+0.4);bx,bz:=cargoTrackAt(track,s-0.4)
 yaw:=math.Atan2(fz-bz,fx-bx);hx,hz:=ax-math.Cos(yaw)*v.Tug.HitchBackM,az-math.Sin(yaw)*v.Tug.HitchBackM
 tx,tz:=cargoTrackAt(track,s-v.Tug.HitchBackM-v.Trailer.EyeM)
 return cargoPose{ax,height,az,yaw*180/math.Pi},cargoPose{tx,height,tz,math.Atan2(hz-tz,hx-tx)*180/math.Pi}
}
func(r *Runtime)cargoConvoyDeck(v cargoConvoyDefinition)*liftingDeckDefinition{if r.world.LiftingDecks==nil{return nil};for i:=range r.world.LiftingDecks.Decks{if r.world.LiftingDecks.Decks[i].ID==v.DeckID{return &r.world.LiftingDecks.Decks[i]}};return nil}
// Where the convoy is for somebody on the given level: on its track there, or riding the deck at that landing.
func(r *Runtime)cargoConvoyPose(v cargoConvoyDefinition,c cargoConvoyState,level string)(cargoPose,cargoPose,bool){
 d:=r.cargoConvoyDeck(v);if d==nil||d.Lower==nil{return cargoPose{},cargoPose{},false};g:=r.state.LiftingDecks[d.ID];p:=g.pose(g.UpdatedNS)
 lowerDeck,_,_:=g.lowerPose(*d);upperY:=-d.DepthM*(1-float64(p.Deck)/float64(liftingDeckFull));lowerY:=d.Lower.ClearHeightM*float64(lowerDeck)/float64(liftingDeckFull)
 upperShown:=p.Leaves>0||p.Deck>0;lowerShown:=lowerDeck<liftingDeckFull
 // Heights are plan heights of each landing's floor; a track on the floor has offset 0.
 floor:=d.Lower.Plan[1];if level==v.Upper.LevelID{floor=d.Plan[1]}
 at:=func(track [][2]float64,s,y float64)(cargoPose,cargoPose,bool){a,b:=v.poses(track,s,floor+y);return a,b,true}
 end:=func(track [][2]float64)float64{return cargoTrackLength(track)}
 // A leg that follows another one keeps the trailer where the earlier leg left it:
 // the pose looks back along the joined track.
 join:=func(a,b [][2]float64)[][2]float64{return append(append([][2]float64{},a...),b[1:]...)}
 lowerIn,upperTurn,upperIn:=join(v.Lower.Leave,v.Lower.Board),join(v.Upper.Leave,v.Upper.Turn),join(v.Upper.Turn,v.Upper.Board)
 switch c.Phase{
 case "parked","loading":if level==v.Lower.LevelID{return at(lowerIn,end(v.Lower.Leave),0)}
 case "lower_boarding":if level==v.Lower.LevelID{return at(lowerIn,end(v.Lower.Leave)+float64(c.S)/1000,0)}
 case "lower_on_deck":if level==v.Lower.LevelID&&lowerShown{return at(lowerIn,end(lowerIn),lowerY)}
 case "riding_up":
  if level==v.Lower.LevelID&&lowerShown{return at(lowerIn,end(lowerIn),lowerY)}
  if level==v.Upper.LevelID&&upperShown{return at(v.Upper.Leave,0,upperY)}
 case "upper_leaving":if level==v.Upper.LevelID{return at(v.Upper.Leave,float64(c.S)/1000,0)}
 case "unloading":if level==v.Upper.LevelID{return at(v.Upper.Leave,end(v.Upper.Leave),0)}
 case "upper_turning":if level==v.Upper.LevelID{return at(upperTurn,end(v.Upper.Leave)+float64(c.S)/1000,0)}
 case "upper_staged":if level==v.Upper.LevelID{return at(upperTurn,end(upperTurn),0)}
 case "upper_boarding":if level==v.Upper.LevelID{return at(upperIn,end(v.Upper.Turn)+float64(c.S)/1000,0)}
 case "upper_on_deck":if level==v.Upper.LevelID{return at(upperIn,end(upperIn),upperY)}
 case "riding_down":
  if level==v.Upper.LevelID&&upperShown{return at(upperIn,end(upperIn),upperY)}
  if level==v.Lower.LevelID&&lowerShown&&!g.LowerAway{return at(v.Lower.Leave,0,lowerY)}
 case "lower_leaving":if level==v.Lower.LevelID{return at(v.Lower.Leave,float64(c.S)/1000,0)}
 }
 return cargoPose{},cargoPose{},false
}
func cargoConvoyDriving(phase string)bool{return phase=="lower_boarding"||phase=="upper_leaving"||phase=="upper_turning"||phase=="upper_boarding"||phase=="lower_leaving"}
func(v cargoConvoyDefinition)level(phase string)string{switch phase{case "parked","loading","lower_boarding","lower_on_deck","riding_down","lower_leaving":return v.Lower.LevelID};return v.Upper.LevelID}
// A leg starts only with its driver standing by the tug on that level.
func(r *Runtime)cargoConvoyDriverReady(v cargoConvoyDefinition,level string,track [][2]float64)bool{
 a:=r.state.Life.Actor(v.Driver);if a==nil||a.Level!=level||!a.OnFloor(){return false}
 cell:=float64(r.world.Life.Locations[level].CellMM)/1000;if cell<=0{return false}
 return max(absInt(a.Position.X-int(math.Floor(track[0][0]/cell))),absInt(a.Position.Y-int(math.Floor(track[0][1]/cell))))<=12
}
func absInt(v int)int{if v<0{return -v};return v}
func(r *Runtime)cargoConvoyCarries(v cargoConvoyDefinition,c cargoConvoyState)bool{
 d:=r.cargoConvoyDeck(v);if d==nil||d.Freight==nil{return false};g:=r.state.LiftingDecks[d.ID]
 return c.Run>0&&c.Run==g.FreightRun&&(c.Phase=="riding_up"||c.Phase=="upper_leaving"||c.Phase=="unloading")&&!c.Unloaded
}
// The crew puts the consignments on the receiving marks: the same owned stock moves from the deck stores.
func(r *Runtime)cargoConvoyUnload(v cargoConvoyDefinition,c *cargoConvoyState)error{
 d:=r.cargoConvoyDeck(v);if d==nil||d.Freight==nil||!r.cargoConvoyCarries(v,*c){c.Unloaded=true;return nil}
 g:=r.state.LiftingDecks[d.ID];model:=r.inventoryModelFor(true);work:=r.state.Inventory.Clone();landed:=false
 for _,route:=range d.Freight.Routes{var delivery *inv.Delivery;for i:=range model.Deliveries{if model.Deliveries[i].ID==route.DeliveryID{delivery=&model.Deliveries[i];break}};if delivery==nil{return fmt.Errorf("unknown incoming delivery %s",route.DeliveryID)}
  cargo,err:=work.MoveMachineConsignment(model,delivery.Carrier,route.DeckStore,route.ReceivingStore,delivery.Definition,route.Quantity,fmt.Sprintf("%s/unload/%d",v.ID,c.Run));if err!=nil{return err};landed=landed||len(cargo)>0
 }
 if landed{r.state.Inventory=work;g.FreightLandedSecond=r.state.Life.Seconds;g.FreightLandedNS=g.UpdatedNS;r.state.LiftingDecks[d.ID]=g}
 c.Unloaded=true;return nil
}
func(r *Runtime)advanceCargoConvoys(seconds,delta int64)error{
 if r.world.CargoConvoys==nil||!r.state.Life.Enabled{return nil};now:=r.state.Tick*r.tickNS()
 for _,v:=range r.world.CargoConvoys.Convoys{
  c,ok:=r.state.CargoConvoys[v.ID];d:=r.cargoConvoyDeck(v);if !ok||d==nil||d.Lower==nil||d.Freight==nil{continue}
  g:=r.state.LiftingDecks[d.ID];p:=g.pose(g.UpdatedNS);_,_,lowerOpen:=g.lowerPose(*d)
  upperOpen:=g.Phase=="loading"&&p.Deck==liftingDeckFull&&p.Barrier==0;upLeg:=g.LowerAway&&g.LowerArriveSecond==0
  day,sod:=seconds/86400,seconds%86400
  drive:=func()bool{track:=v.track(c.Phase);length:=int64(math.Round(cargoTrackLength(track)*1000));c.S+=v.SpeedMMPerSecond*delta;if c.S>=length{c.S=length;return true};return false}
  start:=func(phase string)bool{if !r.cargoConvoyDriverReady(v,v.level(phase),v.track(phase)){return false};c.Phase=phase;c.S=0;return true}
  switch c.Phase{
  case "parked":if c.Day!=day+1&&sod>=v.LoadSecond&&sod<d.Freight.FirstSecond&&!g.LowerAway{c.Phase="loading";c.Day=day+1;c.Unloaded=false;c.Run=0}
  case "loading":if (sod>=v.BoardSecond||c.Day!=day+1)&&lowerOpen&&g.Phase=="rest"{start("lower_boarding")}
  case "lower_boarding":
   // The deck never leaves with half a convoy: the leaves cannot start while a body is on the barrier line,
   // and a convoy that did not make it simply stays for the next run.
   if g.LowerAway{c.Phase="loading";c.S=0}else if drive(){c.Phase="lower_on_deck"}
  case "lower_on_deck":if upLeg{c.Phase="riding_up";c.Run=g.Runs}
  case "riding_up":if upperOpen{start("upper_leaving")}else if !upLeg{c.Phase="lower_on_deck"}
  case "upper_leaving":if drive(){c.Phase="unloading";c.UnloadStart=seconds}
  case "unloading":
   if seconds-c.UnloadStart>=v.UnloadSeconds{if !c.Unloaded{if err:=r.cargoConvoyUnload(v,&c);err!=nil{return err}}else{start("upper_turning")}}
  case "upper_turning":if drive(){c.Phase="upper_staged"}
  case "upper_staged":if upperOpen{start("upper_boarding")}
  case "upper_boarding":if drive(){c.Phase="upper_on_deck"}
  case "upper_on_deck":if g.LowerAway&&g.LowerArriveSecond>0{c.Phase="riding_down"}
  case "riding_down":if !g.LowerAway&&lowerOpen{start("lower_leaving")}
  case "lower_leaving":if drive(){c.Phase="parked";c.S=0}
  default:return fmt.Errorf("invalid cargo convoy phase %q",c.Phase)
  }
  if !cargoConvoyDriving(c.Phase){c.S=0}
  c.UpdatedNS=now;r.state.CargoConvoys[v.ID]=c
 }
 return nil
}
// Where each crew member should be follows from the convoy's phase and the level the person is on.
// A person left behind at the far landing waits there and rides the next deck.
func(r *Runtime)cargoCrewDetour(a *behavior.LifeActor,wanted behavior.LifeStep)(behavior.LifeStep,bool){
 if r.world.CargoConvoys==nil{return wanted,false}
 for _,v:=range r.world.CargoConvoys.Convoys{
  i:=-1;if a.ID==v.Driver{i=0};for k,id:=range v.Loaders{if id==a.ID{i=k+1}};if i<0{continue}
  c,ok:=r.state.CargoConvoys[v.ID];if !ok{return wanted,false}
  step:=func(at behavior.Cell,label string)(behavior.LifeStep,bool){return behavior.LifeStep{Level:a.Level,At:at,Activity:"work",Label:label,Obligation:true},true}
  drives:=func(label string)string{if i==0&&cargoConvoyDriving(c.Phase){return v.Labels.Driving};return label}
  switch a.Level{
  case v.Lower.LevelID:
   switch c.Phase{
   case "loading":return step(v.Lower.Loading[i],v.Labels.Loading)
   case "lower_boarding","lower_on_deck":return step(v.Lower.Deck[i],drives(v.Labels.Riding))
   case "lower_leaving":if i==0{return step(v.Lower.Loading[0],v.Labels.Driving)}
   }
  case v.Upper.LevelID:
   switch c.Phase{
   case "riding_up","upper_leaving","unloading":return step(v.Upper.Unloading[i],drives(v.Labels.Unloading))
   case "upper_turning","upper_staged":return step(v.Upper.Staging[i],drives(v.Labels.Waiting))
   case "upper_boarding","upper_on_deck":return step(v.Upper.Deck[i],drives(v.Labels.Riding))
   }
   d:=r.cargoConvoyDeck(v);if d!=nil{g:=r.state.LiftingDecks[d.ID];p:=g.pose(g.UpdatedNS);if g.Phase=="loading"&&p.Deck==liftingDeckFull&&p.Barrier==0{return step(v.Upper.Deck[i],v.Labels.Riding)}}
   return step(v.Upper.Staging[i],v.Labels.Waiting)
  }
  return wanted,false
 }
 return wanted,false
}
func(r *Runtime)appendCargoConvoys(view *pb.PocLifeView,hero *behavior.LifeActor){
 if r.world.CargoConvoys==nil||hero==nil||view==nil{return}
 for _,v:=range r.world.CargoConvoys.Convoys{
  c,ok:=r.state.CargoConvoys[v.ID];if !ok{continue};tug,trailer,shown:=r.cargoConvoyPose(v,c,hero.Level);if !shown{continue}
  driver:=r.state.Life.Actor(v.Driver);aboard:=driver!=nil&&driver.OnFloor()&&driver.Level==hero.Level&&(cargoConvoyDriving(c.Phase)||c.Phase=="lower_on_deck"||c.Phase=="upper_on_deck"||c.Phase=="upper_staged")
  units:=int64(0);if d:=r.cargoConvoyDeck(v);d!=nil&&d.Freight!=nil&&!c.Unloaded{for _,route:=range d.Freight.Routes{for _,item:=range r.state.Inventory.Items{if item.Quantity>0&&item.Location==(inv.Location{Kind:"store",Store:route.DeckStore}){units+=item.Quantity}}}}
  length:=int64(math.Round(cargoTrackLength(v.track(c.Phase))*1000))
  view.CargoConvoys=append(view.CargoConvoys,&pb.PocCargoConvoy{Id:v.ID,Phase:c.Phase,TugResource:v.Tug.Resource,TrailerResource:v.Trailer.Resource,
   Tug:&pb.PocCargoPose{X:tug.X,Y:tug.Y,Z:tug.Z,YawDegrees:tug.Yaw},Trailer:&pb.PocCargoPose{X:trailer.X,Y:trailer.Y,Z:trailer.Z,YawDegrees:trailer.Yaw},
   ShutterOpen:c.Phase=="loading"||c.Phase=="unloading",DriverId:v.Driver,DriverAboard:aboard,SeatM:v.Tug.SeatM,SampleNs:c.UpdatedNS,Moving:cargoConvoyDriving(c.Phase)&&c.S<length,CargoUnits:units})
 }
 // A merchant moves the morning consignment on a hand trolley; the trolley exists only for that walk.
 for _,d:=range r.world.Inventory.Deliveries{
  progress:=r.state.Inventory.Deliveries[d.ID];if progress.Phase!="carrying"{continue};a:=r.state.Life.Actor(d.Carrier);if a==nil||a.Level!=hero.Level||!a.OnFloor(){continue}
  units:=int64(0);for _,cargo:=range progress.Cargo{units+=cargo.Quantity}
  view.HandCarts=append(view.HandCarts,&pb.PocHandCart{Id:d.ID,ActorId:d.Carrier,Resource:r.world.CargoConvoys.DeliveryTrolley.Resource,CouplingForwardM:r.world.CargoConvoys.DeliveryTrolley.CouplingForwardM,CargoUnits:units})
 }
}
func(r *Runtime)validateCargoConvoys(s state)error{
 count:=0;if r.world.CargoConvoys!=nil{for _,v:=range r.world.CargoConvoys.Convoys{count++;c,ok:=s.CargoConvoys[v.ID];if !ok{return fmt.Errorf("missing cargo convoy %s",v.ID)}
  track:=v.track(c.Phase);if track==nil&&c.Phase!="riding_up"{return fmt.Errorf("invalid cargo convoy phase %s",v.ID)}
  if c.S<0||c.Day<0||c.Run<0||c.UnloadStart<0||c.UnloadStart>s.Life.Seconds||c.UpdatedNS<0||(track!=nil&&c.S>int64(math.Round(cargoTrackLength(track)*1000)))||(!cargoConvoyDriving(c.Phase)&&c.S!=0){return fmt.Errorf("invalid cargo convoy state %s",v.ID)}
 }};if len(s.CargoConvoys)!=count{return fmt.Errorf("cargo convoy catalog/state mismatch")};return nil
}
