	held := known && !spec.Strike
	if held {
		hit.Technique = mode
		hit.HoldS = 1
	}
	for _, id := range combatItemKeys(r.state.Inventory) {
		i := r.state.Inventory.Items[id]
		if i.Location.Store == inv.ActorStore(target) && i.Location.Slot != "" && r.combatCarried(r.state.Inventory, target, i) {
