func(r *Runtime) isOperator(a *demoAgent)bool{return a.ID!=""&&a.ID==r.world.Config.CaptureDemo.Monitoring.Operator}
// networkKnown: the actor knows the network is engaged — it was asked by the dispatcher, heard the
// post's siren, or is the operator who issued the call. Nothing is broadcast globally.
func(r *Runtime) networkKnown(a *demoAgent)bool{
 if r.requestedActor(a.ID)||r.selectedActor(a.ID){return true}
 if r.isOperator(a)&&r.state.Demo.Issued{return true}
