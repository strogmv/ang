// Code generated by ANG. Riders: people who travel on a vehicle of the host (cargo to the market v1,
// design/cargo-market/v1/DESIGN.md §9 and PART-B §2.2). One rule for any vehicle: a tug with its trailers today;
// a lifting deck, a lift or a train can bind their people the same way.
package behavior

import "fmt"

// LifeMount binds a person to a vehicle of the host.
//   - Seated (Afoot false): the host places him with the vehicle — on the vehicle's level at the cell under his seat,
//     or in transit with it (a Trip on the edge the vehicle travels); he holds no floor cell, the vehicle's body does.
//   - Afoot: he stands on a free floor cell beside the stopped vehicle and works there (the host names the cell); he is
//     an ordinary body on the floor that others walk round, but Life does not walk him away.
// While bound his routine, needs and courtesy wait (the Life frame skips him) until the host lets him go (Dismount).
// Boarding and stepping down happen only while the vehicle stands still; the host checks that.
type LifeMount struct {
 Vehicle string `json:"vehicle"`
 Seat string `json:"seat"`
 Afoot bool `json:"afoot,omitempty"`
}

func(a LifeActor)validateMount()error{
 m:=a.Mount;if m==nil{return nil}
 if m.Vehicle==""||m.Seat==""||a.ResidenceID!=""||a.ServiceAttachment!=""||a.BoardedEdge!=""||a.Body!=nil||len(a.Path)>0||len(a.PendingPath)>0||a.CombatHold{return fmt.Errorf("invalid rider %s",a.ID)}
 if m.Afoot&&a.Trip!=nil{return fmt.Errorf("rider %s is afoot in transit",a.ID)}
 return nil
}

// Riding: the person is bound to this vehicle (seated or afoot).
func(a LifeActor)Riding(vehicle string)bool{return a.Mount!=nil&&a.Mount.Vehicle==vehicle}

// Board: a person standing on the floor takes a seat of the vehicle (or an afoot rider sits down again).
func(s *LifeState)Board(id,vehicle,seat string)error{
 a:=s.Actor(id);if a==nil||a.Trip!=nil||a.ResidenceID!=""||a.ServiceAttachment!=""||a.BoardedEdge!=""||a.Body!=nil||a.CombatHold||(a.Mount!=nil&&a.Mount.Vehicle!=vehicle){return fmt.Errorf("%s cannot board %s",id,vehicle)}
 a.Mount=&LifeMount{Vehicle:vehicle,Seat:seat};a.Path=nil;a.PendingPath=nil;a.Goal=a.Position;a.Arrived=true;a.YieldRequester="";a.YieldOrigin=Cell{};a.YieldUntil=0;a.YieldHoldUntil=0;a.OverrideLevel="";a.OverrideAt=Cell{};a.OverrideEdge=""
 return nil
}

// StepDown: a seated rider stands on a free floor cell beside the stopped vehicle and stays bound to it.
func(s *LifeState)StepDown(m LifeModel,id,level string,at Cell)error{
 a:=s.Actor(id);if a==nil||a.Mount==nil||a.Trip!=nil{return fmt.Errorf("%s is no seated rider",id)}
 if !m.Walks(level,at)||s.occupied(level,at,id){return fmt.Errorf("%s cannot step down at %v",id,at)}
 a.Mount.Afoot=true;a.Level=level;a.Position=at;a.Goal=at;a.Arrived=true;a.Visits[level]++
 return nil
}

// Stand: an afoot rider moves to another free floor cell of his vehicle's stop (the host's work post).
func(s *LifeState)Stand(m LifeModel,id string,at Cell)error{
 a:=s.Actor(id);if a==nil||a.Mount==nil||!a.Mount.Afoot{return fmt.Errorf("%s is no afoot rider",id)}
 if a.Position==at{return nil}
 if !m.Walks(a.Level,at)||s.occupied(a.Level,at,id){return fmt.Errorf("%s cannot stand at %v",id,at)}
 a.Position=at;a.Goal=at;return nil
}

// Dismount: the rider is released to his own life on a free floor cell (a seated one steps off, an afoot one stays).
func(s *LifeState)Dismount(m LifeModel,id,level string,at Cell)error{
 a:=s.Actor(id);if a==nil||a.Mount==nil||a.Trip!=nil{return fmt.Errorf("%s rides nothing here",id)}
 if (!a.Mount.Afoot||a.Position!=at||a.Level!=level)&&(!m.Walks(level,at)||s.occupied(level,at,id)){return fmt.Errorf("%s cannot get off at %v",id,at)}
 if a.Level!=level{a.Visits[level]++}
 a.Mount=nil;a.Level=level;a.Position=at;a.Goal=at;a.Path=nil;a.PendingPath=nil;a.Arrived=false;a.StartedAt=s.Seconds
 return nil
}

// Carry: a seated rider is with his vehicle on a level, at the floor cell under his seat. Not a step of his own: the
// vehicle's body is the occupancy there.
func(s *LifeState)Carry(m LifeModel,id,level string,at Cell)error{
 a:=s.Actor(id);if a==nil||a.Mount==nil||a.Mount.Afoot{return fmt.Errorf("%s is no seated rider",id)}
 if !m.Walks(level,at){return fmt.Errorf("rider %s carried off the floor at %v",id,at)}
 if a.Trip!=nil{a.Trip=nil}
 if a.Level!=level{a.Visits[level]++}
 a.Level=level;a.Position=at;a.Goal=at;return nil
}

// Depart: a seated rider leaves the level with his vehicle on its edge (the same Trip a person on a deck gets). The
// Life frame never ends this trip: the host carries him off at the other end (Carry) when the vehicle arrives.
func(s *LifeState)Depart(m LifeModel,id,edgeID string,departure int64)error{
 a:=s.Actor(id);e:=m.Edge(edgeID);if a==nil||a.Mount==nil||a.Mount.Afoot||e==nil||departure>s.Seconds{return fmt.Errorf("%s cannot depart on %s",id,edgeID)}
 a.Level=e.From;a.Position=e.Exit;a.Goal=e.Exit;a.Trip=&LifeTrip{Edge:e.ID,Departure:departure,Arrival:departure+e.TravelSeconds}
 return nil
}
