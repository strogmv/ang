// craftingResidentThings: the residents' worn things (by the catalog rows), id -> owner.
func (r *Runtime) craftingResidentThings() []inv.Item {
	m := r.world.Crafting
	out := []inv.Item{}
	for _, i := range r.state.Inventory.Items {
		for _, t := range m.Market.Residents {
			if i.Owner == t.Actor && i.Definition == t.Item && i.Location.Kind == "store" && i.Location.Store == inv.ActorStore(t.Actor) {
				out = append(out, i)
			}
		}
	}
	sort.Slice(out, func(a, b int) bool { return out[a].ID < out[b].ID })
	return out
}

// craftingResidentWear: a day of use wears each thing by its definition's wear per use (items.cue) × the uses a day.
func (r *Runtime) craftingResidentWear(days int64) {
	t := inv.Transform{}
	for _, i := range r.craftingResidentThings() {
		for _, rt := range r.world.Crafting.Market.Residents {
			if rt.Actor == i.Owner && rt.Item == i.Definition {
				wear := r.world.Inventory.Definitions[i.Definition].WearPerUse * rt.UsesPerDay * days
				if wear > 0 && i.Condition > 0 {
					t.Restore = append(t.Restore, inv.Restore{Item: i.ID, Condition: max(0, i.Condition-wear)})
				}
			}
		}
	}
	if len(t.Restore) > 0 {
		_, _ = r.state.Inventory.Transform(r.inventoryModelFor(true), t)
	}
}

// craftingResidentOrders: in the market hours a resident with a thing worn below the mark orders its repair (or upkeep)
// from a master who offers it at an open stall, once a day, if the money allows — the same order as the hero's.
func (r *Runtime) craftingResidentOrders(day int64) {
	m := r.world.Crafting
	mk := &r.state.Crafting.Market
	for _, i := range r.craftingResidentThings() {
		if mk.Ordered[i.Owner] == day+1 || i.Condition >= m.Market.ResidentRule.OrderBelowPPM {
			continue
		}
		for _, ms := range m.Masters {
			if !r.storefrontOpen(ms.Shop) {
				continue
			}
			placed := false
			for _, o := range ms.Offers {
				rec, _ := m.Recipe(o)
				if rec.Target != i.Definition || (rec.Kind != "repair" && rec.Kind != "maintain") {
					continue
				}
				job := r.craftingJobID()
				target := r.craftingStack(i)
				p, price, sw, err := r.craftingOrderFor(ms, i.Owner, o, i.ID, &target, job)
				if err != nil || r.craftingPlaceOrder(ms, i.Owner, p, price, sw, job) != nil {
					continue
				}
				if mk.Ordered == nil {
					mk.Ordered = map[string]int64{}
				}
				mk.Ordered[i.Owner] = day + 1
				placed = true
				break
			}
			if placed {
				break
			}
		}
	}
}

// craftingContractDefinitions: every definition a crafting job of the catalog may spend or make (inputs, targets, products,
// salvage yields) — the authored consumption contract of the NPC world report (doc 93: the same law for NPCs).
func (r *Runtime) craftingContractDefinitions() map[string]bool {
	m := r.world.Crafting
	out := map[string]bool{}
	for _, rec := range m.Recipes {
		if rec.Target != "" && rec.Kind == "disassemble" {
			out[rec.Target] = true
		}
		if rec.Output != nil {
			out[rec.Output.Item] = true
		}
		for _, in := range rec.Inputs {
			if in.Item != "" {
				out[in.Item] = true
			}
			if p, ok := m.Part(in.Class); ok {
				for _, i := range p.Items {
					out[i.Item] = true
				}
			}
		}
		for _, y := range rec.Yields {
			if p, ok := m.Part(y.Class); ok {
				out[p.Items[0].Item] = true
			}
		}
	}
	return out
}
