func (pp *PPTest) ParseCallback(r *http.Request) (*model.CallbackData, error) {
	body, err := io.ReadAll(io.LimitReader(r.Body, maxCallbackBodyBytes+1))
	if err != nil {
		return nil, fmt.Errorf(errReadCallbackBodyFmt, err)
	}
	if len(body) > maxCallbackBodyBytes {
		return nil, fmt.Errorf(errCallbackTooLargeFmt, maxCallbackBodyBytes)
	}

	var cb cbData
	if err := json.Unmarshal(body, &cb); err != nil {
		return nil, fmt.Errorf(errUnmarshalCallbackFmt, err)
	}
	cb.raw = body
	txID := cb.PayInID
	if txID == "" {
		txID = cb.PayOutID
	}

	cd := &model.CallbackData{
		TnxId:    txID,
		Data:     &cb,
		HttpCode: http.StatusOK,
	}
	return cd, nil
}

func (pp *PPTest) ValidateCallback(mc *model.MerchantCreds, tx *model.Transaction, cd *model.CallbackData) error {
	d := cd.Data.(*cbData)

	secrets, err := parseSecrets(mc.Secret)
	if err != nil {
		return fmt.Errorf("parsing secrets for %s callback validation: %w", ppSID, err)
	}

	if !verifySignature(secrets.signingKey, d.raw, "" /* TODO: extract signature from callback */) {
		return providers.ErrInvalidSignature
	}
	return nil
}

func (pp *PPTest) FinishCallback(mc *model.MerchantCreds, tx *model.Transaction, cd *model.CallbackData) (*model.StatusResponse, error) {
	d := cd.Data.(*cbData)

	pp.txPathLogger.Log(tx, model.LogActionTypeCallback, providers.LogActionTypeReceived, string(d.raw))

	var status model.TnxStatus
	var code model.TnxStatusCode
	var msg string

	if tx.Type == model.TnxTypePay {
		status, code, msg = mapPayinStatus(providerStatus(d.))
	} else {
		status, code, msg = mapPayoutStatus(providerStatus(d.))
	}

	return &model.StatusResponse{
		Status:  status,
		Code:    code,
		Message: msg,
	}, nil
}







var _ model.PaymentProvider = (*PPTest)(nil)
