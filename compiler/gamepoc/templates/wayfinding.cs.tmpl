   var u=new Vector2((float)guide.AxisU.X,(float)guide.AxisU.Y);var v=new Vector2((float)guide.AxisV.X,(float)guide.AxisV.Y);float det=u.x*v.y-u.y*v.x;
   if(Math.Abs(det)<.25f)return new Vector2(-tangent.y,tangent.x).normalized*half;
   float x=(tangent.x*v.y-tangent.y*v.x)/det,y=(u.x*tangent.y-u.y*tangent.x)/det;
   return Math.Abs(x)>Math.Abs(y)?v*(x>=0?half:-half):u*(y>=0?-half:half);
  }
  static Vector2 WayfindingPaintSide(IList<Vector2> points,int index,float half,PocWayfindingGuide guide=null){
   var before=(points[index==0?1:index]-points[index==0?0:index-1]).normalized;
   var after=(points[index==points.Count-1?index:index+1]-points[index]).normalized;if(index==points.Count-1)after=before;
   if(guide!=null&&guide.AxisU!=null&&guide.AxisV!=null){var a=WayfindingPaintNormal(before,guide,half);var b=WayfindingPaintNormal(after,guide,half);var joined=(a-b).sqrMagnitude<.000001f?a:a+b;float length=(float)Math.Sqrt(joined.sqrMagnitude);return length>.09f?joined*(.09f/length):joined;}
   var normal=new Vector2(-(before.y+after.y),before.x+after.x).normalized;float dot=normal.x*(-after.y)+normal.y*after.x;
   return normal*(Math.Min(.09f,half/Math.Max(.25f,dot)));
  }
  void WayfindingRenderAuthored(PocWayfindingGuide guide,HashSet<long> floor){
   var points=new List<Vector2>();foreach(var point in guide.Shape)points.Add(new Vector2((float)point.X,(float)point.Y));
   // A .07 square buffer fits within the authoritative .10 circular buffer.
   if(points.Count<2||!WayfindingPointsSupported(points,floor,.07f))return;
   wayfindingAuthoredGuides++;var color=WayfindingColor(guide.Color,false);const float half=.055f;
   for(int i=1;i<points.Count;i++){var a=points[i-1];var b=points[i];string key=guide.Color.ToUpperInvariant()+":"+Math.Round(a.x,4)+","+Math.Round(a.y,4)+":"+Math.Round(b.x,4)+","+Math.Round(b.y,4);if(!wayfindingPaintEdges.Add(key))continue;
    int count=wayfindingStrokes.Count;WayfindingEmitStroke(a,b,color,half);if(wayfindingStrokes.Count==count)continue;
    var stroke=wayfindingStrokes[wayfindingStrokes.Count-1];stroke.joinedSides=true;stroke.startSide=WayfindingPaintSide(points,i-1,half,guide);stroke.endSide=WayfindingPaintSide(points,i,half,guide);wayfindingGuideSegments++;
   }
  }
  void PrepareWayfinding(){
   var view=WayfindingView();if(view==null){wayfindingStrokes.Clear();wayfindingHash=0;return;}
   string plan=view.LevelId+"\0"+wayfindingEpoch;if(plan!=wayfindingPlanLevel){wayfindingPlanLevel=plan;wayfindingGuideOrder.Clear();wayfindingBackboneMemory.Clear();wayfindingHash=0;}
   ulong hash=WayfindingSignature(view);if(hash==wayfindingHash)return;wayfindingHash=hash;wayfindingStrokes.Clear();wayfindingPaintEdges.Clear();wayfindingAuthoredGuides=0;wayfindingBackbones.Clear();wayfindingNumbers.Clear();wayfindingGuideSegments=wayfindingSelectedSegments=0;
   var support=new HashSet<long>();foreach(var guide in view.Guides)foreach(var p in guide.Path)WayfindingSupportCell(support,p);
   var selectedSupport=new HashSet<long>(support);foreach(var p in view.Path)WayfindingSupportCell(selectedSupport,p);
   // Initial longest route wins, then stable ID. Later discoveries append to
   // the established ordering, independently of server/list presentation order.
   var guides=new List<PocWayfindingGuide>();var authoredFloor=new HashSet<long>();var remembered=ObserverView();if(remembered!=null)for(int y=0;y<remembered.Terrain.Count;y++)for(int x=0;x<remembered.Terrain[y].Length;x++)if(WayfindingKnownFloor(x,y))authoredFloor.Add(WayfindingCell(x,y));
   foreach(var guide in view.Guides)foreach(var p in guide.Underlays)if(WayfindingKnown(p.X,p.Y))authoredFloor.Add(WayfindingCell(p.X,p.Y));
   foreach(var guide in view.Guides){if(guide.Shape.Count>1)WayfindingRenderAuthored(guide,authoredFloor);else if(!guide.Authored)guides.Add(guide);}
   guides.Sort((a,b)=>{int length=b.Path.Count.CompareTo(a.Path.Count);return length!=0?length:string.CompareOrdinal(a.Id,b.Id);});var ids=new HashSet<string>(StringComparer.Ordinal);var byID=new Dictionary<string,PocWayfindingGuide>(StringComparer.Ordinal);var hues=new List<string>();
   foreach(var guide in guides){ids.Add(guide.Id);byID[guide.Id]=guide;if(!wayfindingGuideOrder.Contains(guide.Id))wayfindingGuideOrder.Add(guide.Id);string hue=guide.Color.ToUpperInvariant();if(!hues.Contains(hue))hues.Add(hue);}wayfindingGuideOrder.RemoveAll(id=>!ids.Contains(id));hues.Sort(StringComparer.Ordinal);
   float radius=(hues.Count-1)*WayfindingLaneSpacing(hues.Count)*.5f+WayfindingGuideHalfWidth(hues.Count)+.002f;var edges=new Dictionary<string,WayfindingBinding>(StringComparer.Ordinal);var anchors=new Dictionary<long,WayfindingAnchor>();var used=new HashSet<string>(StringComparer.Ordinal);var ends=new Dictionary<string,WayfindingAnchor>(StringComparer.Ordinal);
   foreach(var id in wayfindingGuideOrder){var guide=byID[id];string hue=guide.Color.ToUpperInvariant();var path=new List<PocPoint>();int chunk=0;
    for(int i=0;i<=guide.Path.Count;i++){var p=i<guide.Path.Count?guide.Path[i]:null;bool known=p!=null&&WayfindingKnown(p.X,p.Y);bool adjacent=path.Count==0||p!=null&&Math.Abs(path[path.Count-1].X-p.X)+Math.Abs(path[path.Count-1].Y-p.Y)==1;
     if(!known||!adjacent){if(path.Count>1)WayfindingGuideChunk(id+"#"+chunk++,path,hue,edges,anchors,support,radius,used);path.Clear();}if(known)path.Add(p);
    }
   }
   foreach(var backbone in wayfindingBackbones)foreach(var hue in hues){List<WayfindingSpan> spans;if(!backbone.colors.TryGetValue(hue,out spans))continue;spans.Sort((a,b)=>a.from.CompareTo(b.from));float from=-1,to=-1;foreach(var span in spans){if(from<0){from=span.from;to=span.to;}else if(span.from<=to+.00001f)to=Math.Max(to,span.to);else{WayfindingRenderSpan(backbone,hue,from,to,hues.IndexOf(hue),hues.Count,support);from=span.from;to=span.to;}}if(from>=0)WayfindingRenderSpan(backbone,hue,from,to,hues.IndexOf(hue),hues.Count,support);}
   foreach(var guide in guides)if(guide.Path.Count>0){string hue=guide.Color.ToUpperInvariant();foreach(int at in new[]{0,guide.Path.Count-1}){var p=guide.Path[at];WayfindingAnchor anchor;if(!WayfindingKnown(p.X,p.Y)||!anchors.TryGetValue(WayfindingCell(p.X,p.Y),out anchor))continue;string key=WayfindingCell(p.X,p.Y)+"/"+hue;if(ends.ContainsKey(key))continue;ends[key]=anchor;var target=new Vector2(p.X,p.Y);if((target-anchor.point).sqrMagnitude<.000001f)continue;var branch=new WayfindingBackbone{points=new List<Vector2>{anchor.point,target},start=anchor};WayfindingRenderSpan(branch,hue,0,1,hues.IndexOf(hue),hues.Count,support);}}
   var unused=new List<string>();foreach(var key in wayfindingBackboneMemory.Keys)if(!used.Contains(key))unused.Add(key);foreach(var key in unused)wayfindingBackboneMemory.Remove(key);
   var destinations=new List<PocWayfindingDestination>(view.Destinations);destinations.Sort((a,b)=>string.CompareOrdinal(a.Id,b.Id));foreach(var d in destinations)wayfindingNumbers[d.Id]=d.Number;var marked=new HashSet<string>(StringComparer.Ordinal);
   foreach(var d in destinations){if(!WayfindingKnown(d.X,d.Y)||!marked.Add(d.X+","+d.Y))continue;var display=d;foreach(var candidate in destinations)if(candidate.X==d.X&&candidate.Y==d.Y){if(candidate.Id==view.SelectedDestinationId){display=candidate;break;}if(display.Number==0&&candidate.Number>0)display=candidate;}WayfindingEndpoint(display,display.Number,display.Id==view.SelectedDestinationId);}
   if(!wayfindingProofHideSelected){var path=new List<PocPoint>();foreach(var p in view.Path){if(!WayfindingKnown(p.X,p.Y)||path.Count>0&&Math.Abs(path[path.Count-1].X-p.X)+Math.Abs(path[path.Count-1].Y-p.Y)!=1){if(path.Count>1)WayfindingDrawPolyline(path,selectedSupport,WayfindingColor(view.SelectedColor,true),0,1,true);path.Clear();}if(WayfindingKnown(p.X,p.Y))path.Add(p);}if(path.Count>1)WayfindingDrawPolyline(path,selectedSupport,WayfindingColor(view.SelectedColor,true),0,1,true);}
  }
  void WayfindingEndpoint(PocWayfindingDestination d,int number,bool selected){
   // A small painted stop bar marks the real approach. The stable number is
   // retained in selection data; large seven-segment boxes are not floor signs.
   Color color=WayfindingColor(d.Color,selected);var center=new Vector2(d.X,d.Y);Vector2 tangent=new Vector2(1,0);PocWayfindingGuide physical=null;
   foreach(var guide in WayfindingView().Guides)if(guide.Id==d.Id&&guide.Shape.Count>1){physical=guide;var last=guide.Shape[guide.Shape.Count-1];var previous=guide.Shape[guide.Shape.Count-2];center=new Vector2((float)last.X,(float)last.Y);tangent=new Vector2((float)(last.X-previous.X),(float)(last.Y-previous.Y)).normalized;break;}
   var side=WayfindingPaintNormal(tangent,physical,selected?.22f:.14f);
   WayfindingStrokeAdd(center-side,center+side,color,selected?.055f:.040f,d.X,d.Y,d.X,d.Y);
  }

  Mesh WayfindingMesh(Func<Vector2,Vector3> project,Mesh reuse=null){
   var vertices=wayfindingVertices;var colors=wayfindingColors;var triangles=wayfindingTriangles;vertices.Clear();colors.Clear();triangles.Clear();
   for(int pass=0;pass<3;pass++)foreach(var line in wayfindingStrokes){if((line.selected?(line.under?1:2):0)!=pass||!WayfindingKnown(line.ax,line.ay)||!WayfindingKnown(line.bx,line.by))continue;Vector2 direction=(line.b-line.a).normalized,side=new Vector2(-direction.y,direction.x)*line.half;int at=vertices.Count;
    var startSide=line.joinedSides?line.startSide:side;var endSide=line.joinedSides?line.endSide:side;
    vertices.Add(project(line.a-startSide));vertices.Add(project(line.b-endSide));vertices.Add(project(line.b+endSide));vertices.Add(project(line.a+startSide));for(int i=0;i<4;i++)colors.Add(line.color);triangles.Add(at);triangles.Add(at+1);triangles.Add(at+2);triangles.Add(at);triangles.Add(at+2);triangles.Add(at+3);
   }
   var mesh=reuse;if(mesh==null)mesh=new Mesh{indexFormat=UnityEngine.Rendering.IndexFormat.UInt32};else mesh.Clear();mesh.SetVertices(vertices);mesh.SetColors(colors);mesh.SetTriangles(triangles,0);mesh.RecalculateBounds();return mesh;
  }
  void DrawPaintedWayfinding(PocPaintedScene scene,Rect fit,Rect viewport){
   PrepareWayfinding();if(wayfindingProofHideAll||wayfindingStrokes.Count==0)return;
   bool resized=wayfindingCanvasScene!=scene.level_id||wayfindingCanvas!=null&&(wayfindingCanvas.width!=scene.width||wayfindingCanvas.height!=scene.height);
   if(resized){ReleaseWayfindingCanvas();wayfindingCanvasScene=scene.level_id;wayfindingCanvasHash=0;wayfindingRenderFailure=null;}
   if(wayfindingCanvasHash!=wayfindingHash){
    wayfindingCanvasHash=wayfindingHash;
    try{if(wayfindingCanvasMaterial==null){var shader=Shader.Find("ANG/WayfindingFloor");if(shader==null)throw new InvalidOperationException("Missing floor guidance shader");wayfindingCanvasMaterial=new Material(shader);}if(wayfindingCanvas==null){wayfindingCanvas=new RenderTexture(scene.width,scene.height,0,RenderTextureFormat.ARGB32){antiAliasing=4,filterMode=FilterMode.Bilinear};wayfindingCanvas.Create();}wayfindingCanvasMesh=WayfindingMesh(p=>{var at=PaintedPoint(scene,p);return new Vector3(at.x,at.y,0);},wayfindingCanvasMesh);var before=RenderTexture.active;bool srgb=GL.sRGBWrite;GL.PushMatrix();try{RenderTexture.active=wayfindingCanvas;GL.sRGBWrite=QualitySettings.activeColorSpace==ColorSpace.Linear;GL.Clear(true,true,Color.clear);GL.LoadPixelMatrix(0,scene.width,scene.height,0);if(!wayfindingCanvasMaterial.SetPass(0))throw new InvalidOperationException("Floor guidance shader pass failed");Graphics.DrawMeshNow(wayfindingCanvasMesh,Matrix4x4.identity);wayfindingRenderFailure=null;}finally{GL.PopMatrix();RenderTexture.active=before;GL.sRGBWrite=srgb;}}
    catch(Exception error){wayfindingRenderFailure=error.Message;Debug.LogError("ANG floor guidance: "+error.Message);}
   }
   if(wayfindingCanvas!=null){Color before=GUI.color;GUI.color=Color.white;var target=fit;target.position-=viewport.position;GUI.DrawTexture(target,wayfindingCanvas,ScaleMode.StretchToFill,true);GUI.color=before;}
  }
  void UpdateSDKWayfinding(){
   PrepareWayfinding();if(locationSDKRoot==null){ReleaseSDKWayfinding();return;}var presentation=LocationSDKPresentation();float light=presentation==null?1:Mathf.Clamp(presentation.brightness,.05f,1);
   if(wayfindingSDKRoot!=null&&wayfindingSDKHash==wayfindingHash&&wayfindingSDKLevel==locationSDKLevel.id){wayfindingSDKMaterial.color=new Color(light,light,light,1);return;}
   ReleaseSDKWayfinding();wayfindingSDKHash=wayfindingHash;wayfindingSDKLevel=locationSDKLevel.id;if(wayfindingStrokes.Count==0)return;
   float meters=locationSDKLevel.cell_meters,bottom=locationSDKLevel.elevation*meters;var shader=Shader.Find("ANG/WayfindingFloor");if(shader==null){wayfindingRenderFailure="Missing SDK floor guidance shader";return;}wayfindingSDKMesh=WayfindingMesh(p=>new Vector3(LocationSDKCellCenter(p.x,meters),bottom+.007f,LocationSDKCellCenter(p.y,meters)));wayfindingSDKMaterial=new Material(shader){color=new Color(light,light,light,1)};wayfindingSDKMaterial.SetInt("_SrcBlend",(int)UnityEngine.Rendering.BlendMode.SrcAlpha);wayfindingSDKMaterial.SetInt("_DstBlend",(int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);wayfindingSDKMaterial.SetInt("_ZTest",(int)UnityEngine.Rendering.CompareFunction.LessEqual);
   wayfindingSDKRoot=new GameObject("wayfinding.floor"){layer=LocationSDKLayer};wayfindingSDKRoot.transform.SetParent(locationSDKRoot.transform,false);wayfindingSDKRoot.AddComponent<MeshFilter>().sharedMesh=wayfindingSDKMesh;wayfindingSDKRoot.AddComponent<MeshRenderer>().sharedMaterial=wayfindingSDKMaterial;
  }
  bool WayfindingMarkerScreen(PocWayfindingDestination d,out Vector2 screen){
   screen=Vector2.zero;if(!WayfindingKnown(d.X,d.Y))return false;var sdk=CurrentLocationSDK();if(sdk!=null)return LocationSDKCellScreen(d.X,d.Y,out screen);
   var scene=CurrentPaintedScene();if(scene!=null){var viewport=PaintedViewport();var fit=PaintedCameraFit(scene,viewport,PaintedPoint(scene,shownPosition));var point=new Vector2(d.X,d.Y);foreach(var guide in WayfindingView().Guides)if(guide.Id==d.Id&&guide.Shape.Count>1){var last=guide.Shape[guide.Shape.Count-1];point=new Vector2((float)last.X,(float)last.Y);break;}var at=PaintedPoint(scene,point);screen=fit.position+at*(fit.width/scene.width);return viewport.Contains(screen);}
   Vector2 origin;float tw,th;GetSpatialProjection(out origin,out tw,out th);screen=CellScreen(origin,tw,th,d.X,d.Y);return SpatialViewport().Contains(screen);
  }
  bool SendWayfindingPointer(Vector2 mouse){
   var view=WayfindingView();if(view==null||HudBlocksWorldInput(mouse)||!CanSend())return false;PocWayfindingDestination nearest=null;float score=12*12;
   foreach(var d in view.Destinations){Vector2 screen;if(!WayfindingMarkerScreen(d,out screen))continue;float distance=(screen-mouse).sqrMagnitude;if(distance<score){nearest=d;score=distance;}}
   if(nearest==null){bool dismissed=wayfindingChoices.Count>0;wayfindingChoices.Clear();return dismissed;}return WayfindingSelectCell(nearest.X,nearest.Y,mouse);
  }
  bool WayfindingSelectCell(int x,int y,Vector2 mouse){var view=WayfindingView();if(view==null||!CanSend())return false;wayfindingChoices.Clear();foreach(var d in view.Destinations)if(d.X==x&&d.Y==y)wayfindingChoices.Add(d.Id);if(wayfindingChoices.Count==0)return false;if(wayfindingChoices.Count==1)return WayfindingSelect(wayfindingChoices[0]);wayfindingChoices.Sort(StringComparer.Ordinal);wayfindingChoiceLevel=view.LevelId;wayfindingChoiceAt=mouse;wayfindingChoiceScroll=Vector2.zero;return true;}
  bool WayfindingChoose(string id){if(!wayfindingChoices.Contains(id))return false;var view=WayfindingView();if(view==null)return false;foreach(var d in view.Destinations)if(d.Id==id)return WayfindingSelect(id);return false;}
