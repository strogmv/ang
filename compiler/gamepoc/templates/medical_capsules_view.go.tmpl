// Code generated by ANG. Medical projection and strict saved attachment ownership.
package poc

import (
	behavior "angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	wounds "angelsdemons/server/internal/wounds"
	"encoding/json"
	"fmt"
	"math"
	"strings"
)

type medicalUnitView struct {
	QueueCount     int         `json:"queue_count"`
	PrefabResource string      `json:"prefab_resource"`
	DoorStartNS    int64       `json:"door_start_ns"`
	DoorEndNS      int64       `json:"door_end_ns"`
	DoorFrom       float64     `json:"door_from"`
	DoorTo         float64     `json:"door_to"`
	VisualIndex    int         `json:"visual_index"`
	DoorProgress   float64     `json:"door_progress"`
	ExitBlocked    bool        `json:"exit_blocked"`
	ID             string      `json:"id"`
	Name           string      `json:"name"`
	InstanceID     string      `json:"instance_id"`
	LevelID        string      `json:"level_id"`
	Phase          string      `json:"phase"`
	PhaseText      string      `json:"phase_text"`
	PatientID      string      `json:"patient_id"`
	Attachment     string      `json:"attachment"`
	PhaseStartNS   int64       `json:"phase_start_ns"`
	PhaseEndNS     int64       `json:"phase_end_ns"`
	ScanProgress   float64     `json:"scan_progress"`
	DoorOpen       bool        `json:"door_open"`
	EntryAllowed   bool        `json:"entry_allowed"`
	ScanPose       medicalPose `json:"scan_pose"`
	InsidePose     medicalPose `json:"inside_pose"`
	PatientPose    medicalPose `json:"patient_pose"`
	RequestEnabled bool        `json:"request_enabled"`
}
type medicalHeroView struct {
	UnitID               string       `json:"unit_id"`
	Phase                string       `json:"phase"`
	OfferID              string       `json:"offer_id"`
	Quote                wounds.Quote `json:"quote"`
	ReasonText           string       `json:"reason_text"`
	ReceiptID            string       `json:"receipt_id"`
	CareRemainingSeconds int64        `json:"care_remaining_seconds"`
	AcceptEnabled        bool         `json:"accept_enabled"`
	CancelEnabled        bool         `json:"cancel_enabled"`
}

func medicalProgress(p medicalPatient, now int64) float64 {
	if p.PhaseEndNS <= p.PhaseStartNS {
		return 0
	}
	return math.Max(0, math.Min(1, float64(now-p.PhaseStartNS)/float64(p.PhaseEndNS-p.PhaseStartNS)))
}
func medicalLerp(a, b medicalPose, t float64) medicalPose {
	return medicalPose{X: a.X + (b.X-a.X)*t, Y: a.Y + (b.Y-a.Y)*t, Z: a.Z + (b.Z-a.Z)*t, YawDegrees: a.YawDegrees}
}
// The saved opening stroke owns the exit hold. The exit deadline is unchanged.
// A retry whose door is already open keeps the full newly authored exit phase.
func medicalExitProgress(p medicalPatient, door medicalDoor, now int64) float64 {
	if p.ExitBlocked {
		return 0
	}
	if door.To == 1 && door.From < 1 && door.EndNS > door.StartNS {
		p.PhaseStartNS = max(p.PhaseStartNS, door.EndNS)
	}
	return medicalProgress(p, now)
}
func (r *Runtime) medicalPatientPose(p medicalPatient, u medicalUnit) medicalPose {
	t := medicalProgress(p, r.simNS())
	switch p.Phase {
	case "entry":
		v := medicalLerp(u.ScanPose, u.InsidePose, math.Min(1, t/.75))
		if t > .75 {
			v.YawDegrees = u.ScanPose.YawDegrees + (u.InsidePose.YawDegrees-u.ScanPose.YawDegrees)*(t-.75)/.25
		}
		return v
	case "treatment":
		return u.InsidePose
	case "exit":
		if p.ExitBlocked {
			return u.InsidePose
		}
		v := medicalLerp(u.InsidePose, u.ScanPose, medicalExitProgress(p, r.state.Medical.Doors[p.UnitID], r.simNS()))
		v.YawDegrees = u.InsidePose.YawDegrees
		return v
	}
	return u.ScanPose
}
func (r *Runtime) appendMedicalCapsules(msg *pb.PocGameState, hero *behavior.LifeActor, locale string) {
	out := struct {
		Epoch       string            `json:"epoch"`
		SampleSimNS int64             `json:"sample_sim_ns"`
		Units       []medicalUnitView `json:"units"`
		Hero        medicalHeroView   `json:"hero"`
	}{Epoch: r.state.Epoch, SampleSimNS: r.simNS(), Units: []medicalUnitView{}}
	cfg := r.world.MedicalCapsules
	if cfg != nil {
		for _, u := range cfg.Units {
			if hero.Level != u.LevelID || hero.Trip != nil {
				continue
			}
			own, hasOwn := r.state.Medical.Patients[playerActorID]
			if !viewSees(msg.PlayerView, int32(u.ScanCell.X), int32(u.ScanCell.Y)) && !(hasOwn && own.UnitID == u.ID) {
				continue
			}
			door := r.state.Medical.Doors[u.ID]
			v := medicalUnitView{PrefabResource: cfg.PrefabResource, DoorStartNS: door.StartNS, DoorEndNS: door.EndNS, DoorFrom: door.From, DoorTo: door.To, VisualIndex: u.VisualIndex, DoorProgress: medicalDoorValue(r.state.Medical.Doors[u.ID], r.simNS()), ID: u.ID, Name: r.localText(locale, u.NameKey, u.NameKey), InstanceID: u.InstanceID, LevelID: u.LevelID, Phase: "idle", ScanPose: u.ScanPose, InsidePose: u.InsidePose, RequestEnabled: !r.state.Paused && !hasOwn && hero.OnFloor() && !r.heroInCombat()}
			for _, p := range r.state.Medical.Patients {
				if p.UnitID == u.ID && p.Phase == "queued" {
					v.QueueCount++
				}
			}
			for id, p := range r.state.Medical.Patients {
				if p.UnitID != u.ID || p.Phase == "queued" {
					continue
				}
				v.Phase = p.Phase
				v.ExitBlocked = p.ExitBlocked
				v.PatientID = id
				v.PhaseStartNS = p.PhaseStartNS
				v.PhaseEndNS = p.PhaseEndNS
				v.ScanProgress = 0
				if p.Phase == "scan" {
					v.ScanProgress = medicalProgress(p, r.simNS())
				}
				v.DoorOpen = p.Phase == "entry" || p.Phase == "exit"
				v.EntryAllowed = p.Phase == "entry" && p.Accepted
				v.PatientPose = r.medicalPatientPose(p, u)
				if r.medicalAttached(id) {
					v.Attachment = u.ID
				}
				break
			}
			v.PhaseText = r.localText(locale, "medical.phase."+v.Phase, "medical.phase."+v.Phase)
			out.Units = append(out.Units, v)
		}
		if p, ok := r.state.Medical.Patients[playerActorID]; ok {
			out.Hero = medicalHeroView{UnitID: p.UnitID, Phase: p.Phase, OfferID: p.OfferID, Quote: p.Quote, ReceiptID: p.ReceiptID, AcceptEnabled: p.Phase == "offer" && p.Quote.Mode != "refused" && !r.state.Paused, CancelEnabled: p.Phase == "queued" || p.Phase == "approach" || p.Phase == "scan" || p.Phase == "offer"}
			key := p.Reason
			if key == "" {
				key = p.Quote.Reason
			}
			if key != "" {
				out.Hero.ReasonText = strings.NewReplacer("{price}", fmt.Sprintf("%.2f", float64(p.Quote.PriceMinor)/100), "{hours}", fmt.Sprintf("%.2f", float64(p.Quote.Seconds)/3600)).Replace(r.localText(locale, key, key))
			}
			if c, ok := r.state.CombatRoster[playerActorID]; ok {
				b := combatBody(c)
				if b.Care != nil {
					out.Hero.CareRemainingSeconds = max(0, b.Care.End-b.Clock)
				}
			}
		}
		// Reuse the existing visible actor IDs. Their presence is a machine attachment,
		// not an additional avatar or the retained navigation return-anchor position.
		for _, a := range msg.SceneAgents {
			if r.medicalAttached(a.Id) {
				a.ServiceAttachment = r.state.Life.Actor(a.Id).ServiceAttachment
			}
		}
	}
	raw, err := json.Marshal(out)
	if err != nil {
		panic(err)
	}
	msg.Life.MedicalCapsulesJson = string(raw)
}
func (r *Runtime) validateMedical(s state) error {
	cfg := r.world.MedicalCapsules
	now := s.Tick*(1000000000/int64(r.world.Config.TickHz)) + min(s.PhaseNS, 1000000000/int64(r.world.Config.TickHz))
	if len(s.Medical.Patients) > 16 || len(s.Medical.Receipts) > 4096 {
		return fmt.Errorf("medical state exceeds bound")
	}
	for id, d := range s.Medical.Doors {
		if cfg.unit(id) == nil || d.StartNS < 0 || d.StartNS > now || d.EndNS < d.StartNS || d.EndNS-d.StartNS != int64(cfg.DoorSeconds*1e9) || math.IsNaN(d.From) || math.IsInf(d.From, 0) || d.From < 0 || d.From > 1 || d.To != 0 && d.To != 1 {
			return fmt.Errorf("invalid saved capsule door")
		}
	}
	for id, key := range s.Medical.NPCAttempts {
		if id == playerActorID || s.Life.Actor(id) == nil || key == "" || len(key) > 65536 {
			return fmt.Errorf("invalid NPC medical attempt")
		}
	}
	units := map[string]bool{}
	serials := map[uint64]bool{}
	queued := map[string]int{}
	for id, p := range s.Medical.Patients {
		u := cfg.unit(p.UnitID)
		a := s.Life.Actor(id)
		if u == nil || a == nil || id != p.ActorID || p.Serial == 0 || p.Serial > s.Medical.Serial || serials[p.Serial] || a.Level != u.LevelID || p.PhaseStartNS < 0 || p.PhaseStartNS > now || p.PhaseEndNS < p.PhaseStartNS || p.LeaseUntilNS < 0 {
			return fmt.Errorf("invalid medical patient")
		}
		serials[p.Serial] = true
		queued[p.UnitID]++
		if queued[p.UnitID] > cfg.QueueLimit {
			return fmt.Errorf("medical queue exceeds bound")
		}
		if p.PhaseEndNS-p.PhaseStartNS > int64(10e9) {
			return fmt.Errorf("invalid medical physical duration")
		}
		if p.OfferID != "" && (p.OfferRevision == 0 || p.OfferID != fmt.Sprintf("medical:%s:%d:%d", id, p.Serial, p.OfferRevision) || p.Quote.Provider != u.Provider || p.Quote.PriceMinor < 0 || p.Quote.Seconds < 0) {
			return fmt.Errorf("invalid saved offer")
		}
		switch p.Phase {
		case "queued", "approach", "scan", "offer", "entry", "treatment", "exit":
		default:
			return fmt.Errorf("unknown medical phase")
		}
		if p.Phase != "queued" {
			if units[u.ID] {
				return fmt.Errorf("multiple patients in capsule")
			}
			units[u.ID] = true
		}
		attached := p.Phase == "entry" || p.Phase == "treatment" || p.Phase == "exit"
		if (!attached && a.ServiceAttachment != "") || attached != (a.ServiceAttachment == u.ID) || attached && (a.Trip != nil || a.ResidenceID != "" || a.Body != nil || len(a.Path) > 0 || !a.CombatHold) {
			return fmt.Errorf("invalid medical attachment")
		}
		if p.Phase != "queued" && p.Phase != "approach" && (a.Position != u.ScanCell || !a.CombatHold) {
			return fmt.Errorf("medical anchor/hold mismatch")
		}
		if p.Accepted && (p.OfferID == "" || p.Quote.Mode != "full" && p.Quote.Mode != "stabilize") {
			return fmt.Errorf("invalid accepted quote")
		}
		if p.Phase == "entry" && !p.Accepted {
			return fmt.Errorf("entry without accepted scan")
		}
		if p.Phase == "exit" {
			if c, ok := s.CombatRoster[id]; ok && combatBody(c).Care != nil {
				return fmt.Errorf("exit before clinical care completed")
			}
		}
		if p.Phase == "treatment" {
			receipt, ok := s.Medical.Receipts[p.ReceiptID]
			c, bodyOK := s.CombatRoster[id]
			if !ok || !bodyOK || receipt.ActorID != id || receipt.UnitID != u.ID {
				return fmt.Errorf("care without receipt")
			}
			b := combatBody(c)
			if b.Care == nil || b.Care.Provider != u.Provider || b.Care.PriceMinor != receipt.PriceMinor || b.Care.Start != receipt.BodyStart || b.Care.End != receipt.BodyStart+receipt.Seconds {
				return fmt.Errorf("care/receipt mismatch")
			}
		}
	}
	// Generic attachment ownership is validated after both service states.
	for id, v := range s.Medical.Receipts {
		if id != v.ID || id == "" || cfg.unit(v.UnitID) == nil || s.Life.Actor(v.ActorID) == nil || v.PriceMinor < 0 || v.Seconds < 1 || v.BodyStart < 0 || v.Mode != "full" && v.Mode != "stabilize" || v.InventorySequence > s.Inventory.Cursors[v.ActorID].Sequence {
			return fmt.Errorf("invalid medical receipt")
		}
	}
	return nil
}
