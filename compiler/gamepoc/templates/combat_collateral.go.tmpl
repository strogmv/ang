// Code generated by ANG. Level-local geometry and physical ambient casualties.
package poc

import (
 "errors"
 "math"
 "strconv"
 "angelsdemons/server/internal/behavior"
)

func(r *Runtime)combatSight(level string,a,b behavior.Cell)bool{
 if v:=r.world.Decks[level];v!=nil{return v.Sees(a,b)&&!r.combatGateBlocks(level,a,b)}
 terrain:=r.state.Life.GateModel(r.world.Life).Locations[level].Terrain
 inside:=func(p behavior.Cell)bool{return p.Y>=0&&p.Y<len(terrain)&&p.X>=0&&p.X<len(terrain[p.Y])}
 opaque:=func(p behavior.Cell)bool{return !inside(p)||r.world.Opaque[string(terrain[p.Y][p.X])]}
 if !inside(a)||!inside(b){return false}
 x,y:=a.X,a.Y;dx,dy:=b.X-a.X,b.Y-a.Y;sx,sy:=1,1;if dx<0{dx=-dx;sx=-1};if dy<0{dy=-dy;sy=-1};err:=dx-dy
 for{x2,y2:=x,y;if x==b.X&&y==b.Y{return true};twice:=2*err;if twice> -dy{err-=dy;x2+=sx};if twice<dx{err+=dx;y2+=sy};if x2!=x&&y2!=y&&opaque(behavior.Cell{X:x2,Y:y})&&opaque(behavior.Cell{X:x,Y:y2}){return false};x,y=x2,y2;if (x!=b.X||y!=b.Y)&&opaque(behavior.Cell{X:x,Y:y}){return false}}
}
// The existing gate contract exposes a server sight-clear threshold. Use it
// consistently until the leaves' full dynamic collision volume is authored.
func(r *Runtime)combatGateBlocks(level string,from,to behavior.Cell)bool{
 l:=r.world.Life.Locations[level];v:=r.world.Decks[level];a,b:=from,to;ha,hb:=0,0
 if v!=nil{var ok bool;a,ha,_,ok=v.Locate(from);if !ok{return true};b,hb,_,ok=v.Locate(to);if !ok{return true}}
 for _,d:=range l.Gates{
  g,ok:=r.state.Life.Gates[d.ID];if !ok||g.SeeThrough(d){continue}
  for _,nav:=range d.Opening{
   p,h:=nav,0;if v!=nil{var stand bool;p,h,_,stand=v.Locate(nav);if !stand{continue}}
   dx,dy:=float64(b.X-a.X),float64(b.Y-a.Y);length:=dx*dx+dy*dy;t:=0.0
   if length>0{t=float64((p.X-a.X)*(b.X-a.X)+(p.Y-a.Y)*(b.Y-a.Y))/length};if t<0||t>1{continue}
   if math.Hypot(float64(a.X)+t*dx-float64(p.X),float64(a.Y)+t*dy-float64(p.Y))>.71{continue}
   z:=float64(ha)+t*float64(hb-ha);if z>=float64(h-500)&&z<=float64(h+1800){return true}
  }
 }
 return false
}

func(r *Runtime)knownCombatLifeActor(id string)(level string,position behavior.Cell,present bool){
 if a:=r.state.Life.Actor(id);a!=nil{return a.Level,a.Position,a.OnFloor()}
 for _,a:=range r.state.Life.Population.Actors{if a.ID==id{return a.Level,a.Position,a.Trip==nil}}
 return "",behavior.Cell{},false
}
func(r *Runtime)combatLifeHeld(id string)bool{
 if a:=r.state.Life.Actor(id);a!=nil{return a.CombatHold}
 for _,a:=range r.state.Life.Population.Actors{if a.ID==id{return a.CombatHold}}
 return false
}
func(r *Runtime)storeAmbientCombatCasualty(c behavior.Combatant){
 if r.state.CombatRoster==nil{r.state.CombatRoster=map[string]behavior.Combatant{}}
 r.state.CombatRoster[c.ID]=cloneCombatant(c)
 if c.HP>0{return}
 if a:=r.state.Life.Actor(c.ID);a!=nil{a.CombatHold=true;a.Safety=nil;a.Path=nil;a.PendingPath=nil;a.Activity="down";a.Label="ui.combat.down";return}
 for i:=range r.state.Life.Population.Actors{a:=&r.state.Life.Population.Actors[i];if a.ID==c.ID{a.CombatHold=true;a.Safety=nil;a.Path=nil;a.Activity="down";a.Label="ui.combat.down";return}}
}

func(r *Runtime)applyAmbientCombatBlasts(previous behavior.CombatState)error{
 s:=&r.state.Combat
 // Snapshot the accepted explosions before adding collateral outcome events.
 explosions:=append([]behavior.CombatEvent(nil),s.Events...)
 participants:=map[string]bool{};for _,a:=range s.Actors{participants[a.ID]=true}
 type target struct{id,level string;at behavior.Cell}
 var targets []target
 for _,a:=range r.state.Life.Actors{if a.OnFloor()&&a.Level==s.LevelID&&!participants[a.ID]{targets=append(targets,target{a.ID,a.Level,a.Position})}}
 for _,a:=range r.state.Life.Population.Actors{if (a.Materialized||a.CombatHold)&&a.Trip==nil&&a.Level==s.LevelID&&!participants[a.ID]{targets=append(targets,target{a.ID,a.Level,a.Position})}}
 for _,event:=range explosions{
  if event.Sequence<=previous.EventSeq||event.Type!="explosion"{continue}
  x,ok:=r.world.CombatRuntime.Explosives[event.ItemID];if !ok{return errors.New("explosive physical contract missing")}
  source:=s.Actor(event.ActorID);if source==nil{return errors.New("explosion source missing")}
  for _,t:=range targets{
   c:=r.combatant(t.id,"bystander");c.Position=t.at;if c.HP<=0{continue}
   scale:=behavior.CombatBlastScale(r.combatSpace(*s),x,event.To,t.at);if scale<=0{continue}
   stream:="combat.v2/"+s.ID+"/"+strconv.FormatUint(s.ActionSeq,10)+"/blast/"+c.ID
   rules:=r.world.CombatRuntime.Rules
   spread:=rules.DamageMin+(rules.DamageMax-rules.DamageMin)*float64(behavior.CounterRandom(s.Seed,event.ActorID,s.Turn,stream)>>11)*(1.0/(1<<53))
   raw:=int(math.Round(float64(x.Damage)*scale*spread));blocked:=behavior.CombatArmorBlocked(c,raw,"torso")
   temporary:=behavior.CombatState{Actors:[]behavior.Combatant{cloneCombatant(*source),c}}
   damage:=temporary.ApplyDamage(r.combatSpace(*s),rules,event.ActorID,c.ID,raw,int(math.Ceil(float64(x.Bleed)*scale)),int(math.Ceil(float64(x.Suppression)*scale)),"torso")
   c=temporary.Actors[1];r.storeAmbientCombatCasualty(c)
   s.EventSeq++;s.Events=append(s.Events,behavior.CombatEvent{Type:"blast_hit",ActorID:event.ActorID,TargetID:c.ID,ItemID:x.ID,From:event.To,To:t.at,Amount:damage,ArmorBlocked:blocked,Hit:damage>0,Turn:s.Turn,Sequence:s.EventSeq})
  }
 }
 return nil
}
