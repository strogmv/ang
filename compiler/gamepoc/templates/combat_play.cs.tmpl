   else if(!b.hit&&b.parried){back=c.parried_back_m;settle=.35f;}
   else if(!b.hit){back=c.dodge_back_m;side=c.dodge_side_m;drop=c.dodge_drop_m;settle=c.dodge_settle_s;body.leanDeg=c.dodge_lean_deg;}
