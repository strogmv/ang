     if(PaintedAt(paintedProofScene.proof_waypoints[0])){FinishProof(false,"first waypoint must require actual movement from arrival");return;}
     if(!(verifyB7Floor?B7SendObserved(paintedProofScene.proof_waypoints[0]):PaintedSend(paintedProofScene.proof_waypoints[0])))return;proofPhase=112;break;
    case 112:
     if(B7ContinueObserved(paintedProofScene.proof_waypoints[0]))break;
     if(ackMS>=0&&!moveAccepted){FinishProof(false,"first ordinary move rejected: "+moveStatus);return;}
     if(ackMS>=0&&moveAccepted&&PaintedAt(paintedProofScene.proof_waypoints[0])){paintedMoves++;paintedBlockedTick=state.Tick;if(!PaintedSend(paintedProofScene.proof_blocked))return;proofPhase=113;}break;
    case 113:
     if(ackMS<0)break;if(moveAccepted){FinishProof(false,"Go accepted authored blocked target");return;}
     if(state.Tick<=paintedBlockedTick)break;
     if(!PaintedAt(paintedProofScene.proof_waypoints[0])){FinishProof(false,"blocked click changed hero position/path");return;}
     paintedBlockedRejected=true;Options(true,1);proofPhase=114;break;
    case 114:if(state.Paused){savedTick=state.Tick;savedEpoch=state.Epoch;paintedSavedInventory=PaintedInventoryFingerprint();if(paintedSavedInventory==null){FinishProof(false,"painted save has no inventory");return;}saveConfirmed=false;SaveOrLoad("slot3",true);proofPhase=115;}break;
    case 115:if(saveConfirmed){PaintedBeginCapture("painted-saved.png");proofPhase=116;}break;
    case 116:if(paintedProofCaptureDone){Options(false,1);proofPhase=117;}break;
    case 117:if(!state.Paused){if(!(verifyB7Floor?B7SendObserved(paintedProofScene.proof_waypoints[paintedWaypointIndex]):PaintedSend(paintedProofScene.proof_waypoints[paintedWaypointIndex])))return;proofPhase=118;}break;
    case 118:
     if(B7ContinueObserved(paintedProofScene.proof_waypoints[paintedWaypointIndex]))break;
     if(ackMS>=0&&!moveAccepted){FinishProof(false,"second ordinary move rejected: "+moveStatus);return;}
     if(ackMS>=0&&moveAccepted&&PaintedAt(paintedProofScene.proof_waypoints[paintedWaypointIndex])){paintedMoves++;Options(true,1);proofPhase=119;}break;
    case 119:if(state.Paused){PaintedBeginCapture(paintedWaypointIndex==1?"painted-moved.png":"painted-waypoint-"+paintedWaypointIndex+".png");proofPhase=120;}break;
    case 120:if(paintedProofCaptureDone){if(paintedWaypointIndex+1<paintedProofScene.proof_waypoints.Length){paintedWaypointIndex++;Options(false,1);proofPhase=117;break;}SaveOrLoad("slot3",false);proofAt=now;proofPhase=121;}break;
    case 121:
     if(state.Epoch==savedEpoch||!state.Paused||state.Tick!=savedTick||!PaintedAt(paintedProofScene.proof_waypoints[0])){if(now-proofAt<10)break;FinishProof(false,"painted save/load did not restore new epoch/tick/pose/pause");return;}
     if(PaintedInventoryFingerprint()!=paintedSavedInventory){FinishProof(false,"painted save/load changed visible item identity/storage/money");return;}
     paintedInventoryRestored=true;paintedSaveRestored=true;PaintedBeginCapture("painted-restored.png");proofPhase=122;break;
    case 122:if(paintedProofCaptureDone){
     if(paintedMoves!=paintedProofScene.proof_waypoints.Length||!paintedBlockedRejected||!paintedSaveRestored||!paintedInventoryRestored||paintedAuditFrames==0||paintedVisibleNPCSamples==0||paintedCaptures.Count!=paintedProofScene.proof_waypoints.Length+1){FinishProof(false,"painted coverage incomplete");return;}
     if(paintedProofScene.view_width>0&&(paintedProofScene.width>paintedProofScene.view_width||(float)paintedProofScene.height*PaintedViewport().width/paintedProofScene.view_width>PaintedViewport().height)&&!paintedCameraPanned){FinishProof(false,"painted follow camera was not exercised by authored waypoints");return;}
     if(verifyB7Floor){
      bool behindDuct=false,clearOfDuct=false;
      foreach(var capture in paintedCaptures){bool duct=false;if(capture.hero_occluding_surfaces!=null)foreach(string surface in capture.hero_occluding_surfaces)if(surface.StartsWith("duct_",StringComparison.Ordinal))duct=true;if(duct)behindDuct=true;else clearOfDuct=true;}
      if(!behindDuct||!clearOfDuct){FinishProof(false,"B7 images did not exercise both behind-duct clipping and unobscured floor");return;}
     }
     if(!state.Active){FinishProof(false,"painted pause menu requires an active saved game");return;}
     page="menu";PaintedBeginCapture("painted-menu.png");proofPhase=123;
    }break;
    case 123:if(paintedProofCaptureDone){
     if(paintedCaptures.Count!=paintedProofScene.proof_waypoints.Length+2||paintedCaptures[paintedCaptures.Count-1].file!="painted-menu.png"||paintedCaptures[paintedCaptures.Count-1].page!="menu"){FinishProof(false,"painted menu coverage incomplete");return;}
     FinishProof(true,"painted real Life: shared affine pointer; all authored Go waypoints; blocked rejection; FOV queue audited against real actors; save/move/load; active pause menu; post-splash Player images for all waypoints; static poses, animation not verified");return;
    }break;
   }
