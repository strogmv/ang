 r,space,s:=combatV4Fixture(t);a:=s.Actor("a");a.Weapon.Kind="firearm";a.Weapon.Magazine=3;a.Ammo=3;a.Weapon.RangeMM=5000;a.Trained=false;s.Actor("b").Position=Cell{3,2}
