	if (b.Blocked-visitorWaitTicks)%visitorRetryTicks == 0 && w.detours < visitorDetoursPerTick {
		w.detours++
		if path := r.visitorGoRound(w, b); len(path) > 0 {
			b.Path = path
			r.state.Visitors.Ledger.Detours++
			if r.walkerOpen(w, path[0], b.Serial) {
				w.take(path[0], b.Serial)
				b.Going, b.Wait, b.Blocked = true, r.world.Visitors.MoveTicks-1, 0
			}
			return true
		}
	}
	// a person of the hall who wants his cell: the visitor gives way
	if blocker == 0 && b.Blocked >= 2*visitorWaitTicks && b.Blocked%visitorRetryTicks == 0 && r.walkerWanted(w, b.At, next) {
		if r.visitorGiveWay(b, w, nil, next) {
			return true
		}
	}
	if b.Phase != "leave" && b.Blocked > visitorGiveUpTicks {
		r.state.Visitors.Ledger.GaveUp++
		r.visitorHead(b)
		return true
	}
	return b.Phase != "leave"
}

// visitorFreeSpot: a free standing cell of the place he walks to (a terminal's panel row, or a cell along the counter).
func (r *Runtime) visitorFreeSpot(b *visitorBody, w *walkersPass) (behavior.Cell, bool) {
	t := r.visitorTargetOf(b.Target)
	if t == nil {
		return behavior.Cell{}, false
	}
	var cells []behavior.Cell
	if len(t.Spots) > 0 {
		for _, c := range t.Spots {
			cells = append(cells, behavior.Cell{X: c.X, Y: c.Y})
		}
	} else {
		at := behavior.Cell{X: t.At.X, Y: t.At.Y}
		cells = append(cells, at)
		for _, dx := range []int{1, -1, 2, -2} {
			spot, near := behavior.Cell{X: at.X + dx, Y: at.Y}, behavior.Cell{X: at.X + dx/absInt(dx), Y: at.Y}
			if r.world.Life.WalksFor(w.level, spot, "") && r.world.Life.WalksFor(w.level, near, "") {
				cells = append(cells, spot)
			}
		}
	}
	for _, c := range cells {
		if r.walkerOpen(w, c, b.Serial) {
			return c, true
		}
	}
	return behavior.Cell{}, false
}

// visitorGoRound: round the body ahead — a short way to a free cell of his own way a few cells past it (then on along his
// way), else a whole way to where he heads, both over the floor as it is now.
func (r *Runtime) visitorGoRound(w *walkersPass, b *visitorBody) []behavior.Cell {
	last := len(b.Path) - 1
	tries := 0
	for k := 1; k <= last && k <= 8 && tries < 3; k++ {
		if k < last && !r.walkerOpen(w, b.Path[k], b.Serial) {
			continue
		}
		tries++
		if seg := r.visitorDetour(w, b.At, b.Path[k], b.Serial, visitorRoundCells); len(seg) > 0 {
			return append(seg, b.Path[k+1:]...)
		}
	}
	// the whole way round only after waiting a while: it is the dearest search
	if b.Blocked < 3*visitorRetryTicks {
		return nil
	}
	return r.visitorDetour(w, b.At, b.Path[last], b.Serial, visitorDetourCells)
}

// visitorDetour: a way from `from` to `to` round the bodies as they stand now (a bounded breadth-first search over the
// floor in a fixed order of neighbours); nil when there is none within the bound.
func (r *Runtime) visitorDetour(w *walkersPass, from, to behavior.Cell, serial int64, limit int) []behavior.Cell {
	if from == to {
		return nil
	}
	terrain := r.world.Life.Locations[w.level].Terrain
	if len(terrain) == 0 {
		return nil
	}
	width, height := len(terrain[0]), len(terrain)
	c := &r.visitors
	if len(c.searchSeen) != width*height {
		c.searchSeen, c.searchPrev, c.searchStamp = make([]uint32, width*height), make([]int32, width*height), 0
	}
	c.searchStamp++
	if c.searchStamp == 0 {
		clear(c.searchSeen)
		c.searchStamp = 1
	}
	stamp := c.searchStamp
	index := func(p behavior.Cell) int { return p.Y*width + p.X }
	inside := func(p behavior.Cell) bool { return p.X >= 0 && p.Y >= 0 && p.X < width && p.Y < height }
	queue := c.searchQueue[:0]
	queue = append(queue, from)
	c.searchSeen[index(from)] = stamp
	links := r.world.Life.LinkIndex(w.level)
	steps := []behavior.Cell{{X: 1, Y: 0}, {X: 0, Y: 1}, {X: -1, Y: 0}, {X: 0, Y: -1}}
	found := false
	for head := 0; head < len(queue) && head < limit && !found; head++ {
		at := queue[head]
		near := make([]behavior.Cell, 0, 4+len(links[at]))
		for _, d := range steps {
			near = append(near, behavior.Cell{X: at.X + d.X, Y: at.Y + d.Y})
		}
		near = append(near, links[at]...)
		for _, n := range near {
			if !inside(n) || c.searchSeen[index(n)] == stamp {
				continue
			}
			if n != to && !r.walkerOpen(w, n, serial) || n == to && !r.world.Life.WalksFor(w.level, n, "") {
				continue
			}
			c.searchSeen[index(n)] = stamp
			c.searchPrev[index(n)] = int32(index(at))
			if n == to {
				found = true
				break
			}
			queue = append(queue, n)
		}
	}
	c.searchQueue = queue
	if !found {
		return nil
	}
	var path []behavior.Cell
	for at := to; at != from; {
		path = append(path, at)
		p := int(c.searchPrev[index(at)])
		at = behavior.Cell{X: p % width, Y: p / width}
	}
	for i, j := 0, len(path)-1; i < j; i, j = i+1, j-1 {
		path[i], path[j] = path[j], path[i]
	}
	return path
}

func absInt64(v int64) int64 {
	if v < 0 {
		return -v
	}
	return v
}

// walkerWanted: a person of the hall standing at `from` steps (or wants to step) into `at`.
func (r *Runtime) walkerWanted(w *walkersPass, at, from behavior.Cell) bool {
	for _, a := range r.state.Life.Actors {
		if a.Level == w.level && a.OnFloor() && a.Position == from {
			for _, c := range append(append([]behavior.Cell(nil), a.Path...), a.PendingPath...) {
				if c == at {
					return true
				}
			}
			return a.Goal == at || (!a.Arrived && a.Activity == "walking" && len(a.Path) == 0)
		}
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.Level == w.level && a.Materialized && a.Trip == nil && a.Position == from {
			return (len(a.Path) > 0 && a.Path[0] == at) || (!a.Arrived && len(a.Path) == 0)
		}
	}
	return false
}
