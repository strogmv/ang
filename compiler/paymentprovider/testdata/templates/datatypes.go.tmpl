func mapH2HResponseCode(code int) (model.TnxStatus, model.TnxStatusCode, string) {
	switch code {
	case 0:
		return tnxStatusPending, model.SCodeOk, model.SCodeOk.Description()
	case 30040:
		return tnxStatusDeclined, model.SCodeInsufficientFunds, model.SCodeInsufficientFunds.Description()
	case 30003, 30005, 30010, 30011, 30012, 30020, 30022, 30401, 30404, 30600:
		return tnxStatusDeclined, model.SCodeDeclinedByBank, model.SCodeDeclinedByBank.Description()
	case 30500, 30030, 30031, 30700:
		return tnxStatusPending, model.SCodeOk, providers.ProviderInternalErrNotFinal
	default:
		return tnxStatusError, model.SCodeInternalError, fmt.Sprintf("code: %d", code)
	}
}

func buildApmDetails(ownerInfo map[string]string) (map[string]string, map[string]string) {
	details := make(map[string]string, len(ownerInfo))
	extra := make(map[string]string, len(ownerInfo))
	for k, v := range ownerInfo {
		extra[k] = v
		switch k {
		case providers.ExternalCustomerIDKey, providers.IPKey:
			continue
		default:
			details[k] = v
		}
	}
	return details, extra
}

const (
	h2hStatusSuccess = "success"
	h2hStatusPending = "pending"
	h2hStatusInitial = "initial"
	h2hStatusError   = "error"
	h2hStatusBlocked = "blocked"
)

func mapH2HTxnStatus(status string, statusCode int) (model.TnxStatus, model.TnxStatusCode, string) {
	switch status {
	case h2hStatusSuccess:
		return tnxStatusSuccess, model.SCodeOk, model.SCodeOk.Description()
	case h2hStatusPending, h2hStatusInitial:
		return tnxStatusPending, model.SCodeOk, model.SCodeOk.Description()
	case h2hStatusError:
		if statusCode != 0 {
			if sc, ok := model.TnxStatusCodeByValue(statusCode); ok {
				return tnxStatusError, sc, sc.Description()
			}
		}
		return tnxStatusError, model.SCodeInternalError, model.SCodeInternalError.Description()
	case h2hStatusBlocked:
		if statusCode != 0 {
			if sc, ok := model.TnxStatusCodeByValue(statusCode); ok {
				return tnxStatusBlocked, sc, sc.Description()
			}
		}
		return tnxStatusBlocked, model.SCodeBlocked, model.SCodeBlocked.Description()
	default:
		if statusCode != 0 {
			if sc, ok := model.TnxStatusCodeByValue(statusCode); ok {
				return tnxStatusDeclined, sc, sc.Description()
			}
		}
		return tnxStatusDeclined, model.SCodeDeclinedByBank, model.SCodeDeclinedByBank.Description()
	}
}
