   for(int y=14;y<localCanvas.height;y+=26)for(int x=14;x<localCanvas.width;x+=26){var ink=new Color(.21f,.22f,.20f);Fill(new Rect(x-2,y,5,1),ink);Fill(new Rect(x,y-2,1,5),ink);}
   RegionDrawLinks(map,bounds,localCanvas);RegionDrawNodes(nodes,bounds,localCanvas);GUI.EndGroup();
   GUI.Label(new Rect(324,628,650,20),L("ui.region.legend"),hudSmall);
   if(HudButton(new Rect(324,654,36,30),"−"))RegionZoomAt(hudRegionCanvas.center,hudRegionCanvas,1/1.2f,ref hudRegionZoom,ref hudRegionPan);
   if(HudButton(new Rect(365,654,36,30),"+"))RegionZoomAt(hudRegionCanvas.center,hudRegionCanvas,1.2f,ref hudRegionZoom,ref hudRegionPan);
   if(HudButton(new Rect(409,654,112,30),L("ui.region.fit_all")))RegionResetView();
   if(HudButton(new Rect(529,654,106,30),L("ui.region.focus_hero"))){var current=RegionFindNode(map,map.CurrentNode);if(current!=null){for(int i=0;i<decks.Count;i++)if(decks[i].Id==current.DeckId){RegionSelectDeck(decks,i,map);break;}hudRegionNodeID=current.Id;RegionFocusNode(map,current);}}
   GUI.Label(new Rect(649,660,325,20),L("ui.region.controls_hint"),hudSmall);RegionDrawDetail(map);
  }


