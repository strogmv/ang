// Explicit initial chip/hack state, not an injected combat outcome. The source
// gun and rounds are relocated from finite authored stock, equipped and loaded
// by the same inventory adapters as normal commands.
func combatNeedleFixture(t *testing.T, hacked bool) (*Runtime, *connection, string, string) {
	t.Helper()
	r, c, target := combatLifeFixture(t, true)
	r.state.Life.Seconds = 12 * 3600
	craftingGive(t, r, "item.needle_gun", 1)
	craftingGive(t, r, "item.part.needle", 10)
	gun := craftingHeroItem(r, "item.needle_gun")
	if hacked {
		r.craftingHacked(gun.ID)
	}
	if err := r.equipPhysicalCombat(&r.state.Inventory, playerActorID, gun.ID); err != nil {
		t.Fatal(err)
	}
	if err := r.reloadPhysicalCombat(&r.state.Inventory, playerActorID, 10); err != nil {
		t.Fatal(err)
	}
	r.world.CombatLife.Responders = map[string]combatResponder{}
	return r, c, target, gun.ID
}

func combatNeedleSeed(r *Runtime, gun, outcome string) int64 {
	p := r.world.Crafting.Law.Rebind
	for seed := int64(1); seed < 100000; seed++ {
		n := int64(craftingRoll(seed, gun+":use:1") % 1000)
		if outcome == "injured" && n >= p.MisfirePermille && n < p.MisfirePermille+p.InjurePermille || outcome == "misfire" && n < p.MisfirePermille || outcome == "normal" && n >= p.MisfirePermille+p.InjurePermille {
			return seed
		}
	}
	panic("no crafting risk seed")
}

func TestCombatNeedleForeignBindingRefusesAtomicTrigger(t *testing.T) {
	r, c, target, gun := combatNeedleFixture(t, false)
	combatStart(t, r, c, target)
	before := r.snapshotState()
	result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "needle.foreign", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if result.Ok || !reflect.DeepEqual(before.Combat, r.state.Combat) || !reflect.DeepEqual(before.Inventory, r.state.Inventory) || !reflect.DeepEqual(before.Crafting, r.state.Crafting) {
		t.Fatal("foreign binding fired or spent AP/ammo/RNG/law state")
	}
	if r.craftingUsable(gun, playerActorID) {
		t.Fatal("foreign gun became usable")
	}
	// Lawful rebinding unlocks the same physical gun without granting ammunition.
	i := r.state.Inventory.Items[gun]
	g := i.Grade
	g.Bound = crafting.Chip(playerActorID)
	if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Regrade: []inv.Regrade{{Item: gun, Grade: g}}}); err != nil {
		t.Fatal(err)
	}
	result, _ = combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "needle.own", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok || combatPhysicalQuantity(r.state.Inventory, "item.part.needle", inv.ItemStore(gun)) != 9 {
		t.Fatal("own chip failed to fire one finite needle")
	}
}

func TestCombatNeedleHackedShotWoundsOncePersistsAndReplayIsFree(t *testing.T) {
	r, c, target, gun := combatNeedleFixture(t, true)
	r.state.Seed = combatNeedleSeed(r, gun, "injured")
	combatStart(t, r, c, target)
	beforeWounds:=len(combatBody(*r.state.Combat.Actor(playerActorID)).Wounds)
	q := &pb.PocCombatCommand{RequestId: "needle.injure", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}
	result, _ := combatWire(t, r, c, q)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	a := r.state.Combat.Actor(playerActorID)
	if len(combatBody(*a).Wounds)!=beforeWounds+1 || combatBody(*a).Wounds[beforeWounds].Zone!="arm" || !reflect.DeepEqual(combatBody(r.state.CombatRoster[playerActorID]),combatBody(*a)) || r.state.Crafting.Law.Hacked[gun].Uses != 1 {
		t.Fatalf("notice was not a real once-only persistent arm wound: %+v", a)
	}
	count := 0
	for _, e := range r.state.Combat.Events {
		if e.Type == "weapon_injury" {
			count++
		}
	}
	if count != 1 {
		t.Fatal("missing or repeated injury outcome")
	}
	before := r.snapshotState()
	result, _ = combatWire(t, r, c, q)
	if !result.Ok || !reflect.DeepEqual(before.Combat, r.state.Combat) || !reflect.DeepEqual(before.Inventory, r.state.Inventory) || !reflect.DeepEqual(before.Crafting, r.state.Crafting) {
		t.Fatal("replay repeated a physical shot or wound")
	}
	r.advanceCraftingLaw()
	if r.state.Combat.Actor(playerActorID).HP != a.HP || r.state.Crafting.Law.Hacked[gun].Uses != 1 {
		t.Fatal("Life repeated the shot risk")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	saved, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(saved.Combat.Actor(playerActorID), r.state.Combat.Actor(playerActorID)) || len(combatBody(saved.CombatRoster[playerActorID]).Wounds)!=beforeWounds+1 || saved.Crafting.Law.Hacked[gun].Uses != 1 {
		t.Fatal("save lost wound or use watermark")
	}
}

func TestCombatNeedleJamBlocksNextShotAndNormalShotDoesNotInjure(t *testing.T) {
	for _, outcome := range []string{"misfire", "normal"} {
		t.Run(outcome, func(t *testing.T) {
			r, c, target, gun := combatNeedleFixture(t, true)
			r.state.Seed = combatNeedleSeed(r, gun, outcome)
			combatStart(t, r, c, target)
			beforeWounds:=len(combatBody(*r.state.Combat.Actor(playerActorID)).Wounds)
			combatPhysicalWire(t, r, c, "needle.first", "attack", target)
			if len(combatBody(*r.state.Combat.Actor(playerActorID)).Wounds)!=beforeWounds {
				t.Fatal("non-injury outcome wounded the holder")
			}
			h := r.state.Crafting.Law.Hacked[gun]
			if h.Uses != 1 || h.Jammed != (outcome == "misfire") {
				t.Fatal("craft risk did not match existing deterministic outcome")
			}
			if outcome == "misfire" {
				if r.state.Inventory.Items[gun].Condition != 0 || r.craftingUsable(gun, playerActorID) {
					t.Fatal("jam did not disable the physical gun")
				}
				// The host may project unarmed after a broken gun; a ranged attack cannot
				// use its remaining nine physical rounds through that fallback.
				if combatPhysicalQuantity(r.state.Inventory, "item.part.needle", inv.ItemStore(gun)) != 9 {
					t.Fatal("jam discarded or created ammunition")
				}
			}
		})
	}
}

func TestCombatNeedleGuardSeesAcceptedShotAndHiddenGuardGetsNoIdentity(t *testing.T) {
	r, c, target, gun := combatNeedleFixture(t, true)
	r.state.Seed = combatNeedleSeed(r, gun, "normal")
	// An already present opponent is explicitly declared a guard for this test.
	r.world.Crafting.Law.Rebind.Guards = []string{target}
	r.world.Crafting.Law.Obliged = append(r.world.Crafting.Law.Obliged, target)
	combatStart(t, r, c, target)
	combatPhysicalWire(t, r, c, "needle.witness", "attack", target)
	found := false
	for _, v := range r.state.Crafting.Law.Cases {
		if v.Act == "shot" && v.Item == gun && v.Suspect == playerActorID && len(v.Evidence) > 0 {
			found = true
		}
	}
	if !found {
		t.Fatal("a real witnessed shot did not enter the existing crafting law")
	}
	before := r.state.Combat.Clone()
	event := behavior.CombatEvent{ActorID: playerActorID, From: before.Actor(playerActorID).Position, To: before.Actor(target).Position, TargetID: target}
	before.Actor(target).StunTurns = 1
	if len(r.combatShotGuards(before, event)) != 0 {
		t.Fatal("unconscious guard identified the shooter")
	}
	before.Actor(target).StunTurns = 0
	// Hearing beyond the visual recognition range does not identify the owner.
	r.world.CombatRuntime.Rules.SightRangeMM = 1
	if len(r.combatShotGuards(before, event)) != 0 {
		t.Fatal("guard outside visual range learned the shooter's identity")
	}

}

func TestCombatNeedleFirstReactionJamStopsLaterShotsInSameMovement(t *testing.T) {
	r, _, target, gun := combatNeedleFixture(t, true)
	r.state.Seed = combatNeedleSeed(r, gun, "misfire")
	r.world.CombatRuntime.Rules.APPerTurn = 12
	p := r.world.CombatRuntime.Profiles["hero"]
	p.Trained = true
	r.world.CombatRuntime.Profiles["hero"] = p
	if err := r.beginCombat(playerActorID, target, "player", "opposition"); err != nil {
		t.Fatal(err)
	}
	watch := behavior.CombatAction{Type: "overwatch"}
	if err := r.performCombatAction(playerActorID, &watch); err != nil {
		t.Fatal(err)
	}
	if r.state.Combat.Current() == nil || r.state.Combat.Current().ID != target {
		t.Fatal("overwatch did not yield the turn")
	}
	from := r.state.Combat.Actor(target).Position
	var action *behavior.CombatAction
	// Find a genuine reachable route that normally allows two reactions. This
	// preview has no host mutation or malfunction callback, exactly as the scorer.
	for dy := -4; dy <= 4 && action == nil; dy++ {
		for dx := -4; dx <= 4; dx++ {
			q := behavior.CombatAction{Type: "move", To: behavior.Cell{X: from.X + dx, Y: from.Y + dy}}
			preview := r.state.Combat.Clone()
			seq := preview.EventSeq
			if err := preview.Execute(r.combatSpace(preview), r.world.CombatRuntime.Rules, target, q); err != nil {
				continue
			}
			count := 0
			for _, e := range preview.Events {
				if e.Sequence > seq && e.ActorID == playerActorID && e.AmmoSpent > 0 {
					count++
				}
			}
			if count >= 2 {
				action = &q
				break
			}
		}
	}
	if action == nil {
		t.Fatal("no real floor route permits two ordinary reactions")
	}
	seq := r.state.Combat.EventSeq
	if err := r.performCombatAction(target, action); err != nil {
		t.Fatal(err)
	}
	count := 0
	for _, e := range r.state.Combat.Events {
		if e.Sequence > seq && e.ActorID == playerActorID && e.AmmoSpent > 0 {
			count++
		}
	}
	if count != 1 || r.state.Crafting.Law.Hacked[gun].Uses != 1 || !r.state.Crafting.Law.Hacked[gun].Jammed || combatPhysicalQuantity(r.state.Inventory, "item.part.needle", inv.ItemStore(gun)) != 9 {
		t.Fatalf("first-shot jam permitted further shots: %d", count)
	}
}

func TestCombatNeedleFatalHolderWoundPrecedesResponseAndResolvesFinalShot(t *testing.T) {
	for _, mutual := range []bool{false, true} {
		t.Run(map[bool]string{false: "holder_down", true: "both_down"}[mutual], func(t *testing.T) {
			r, _, target, gun := combatNeedleFixture(t, true)
			r.state.Seed = combatNeedleSeed(r, gun, "injured")

			r.world.CombatRuntime.Rules.MinHit = 1
			r.world.CombatRuntime.Rules.MaxHit = 1
			r.world.CombatRuntime.Rules.DamageMin = 1
			r.world.CombatRuntime.Rules.DamageMax = 1
			if err := r.beginCombat(playerActorID, target, "player", "opposition"); err != nil {
				t.Fatal(err)
			}
			end := behavior.CombatAction{Type: "end"}
			if err := r.performCombatAction(playerActorID, &end); err != nil {
				t.Fatal(err)
			}
			guard := behavior.CombatAction{Type: "guard"}
			if err := r.performCombatAction(target, &guard); err != nil {
				t.Fatal(err)
			}
 // A prior injury left the bodies just below the blood-loss blackout threshold.
 // The new real projectile, not an HP decrement, must push them over it before a response.
 for _,id:=range []string{playerActorID,target}{if id==target&&!mutual{continue};a:=r.state.Combat.Actor(id);b:=combatBody(*a);b.LostUL=b.VolumeUL*combatWounds.States.DownPermille/1000-1;projectWoundBody(a,b)}
 r.syncCombatLife()
 seq := r.state.Combat.EventSeq
 fire := behavior.CombatAction{Type: "attack", TargetID: target}
			if err := r.performCombatAction(playerActorID, &fire); err != nil {
				t.Fatal(err)
			}
			for _, e := range r.state.Combat.Events {
				if e.Sequence > seq && e.Type == "reaction" {
					t.Fatal("defender reacted to an already down shooter")
				}
			}
			if r.state.Combat.Active || r.state.CombatRoster[playerActorID].HP != 0 || !r.state.Life.Actor(playerActorID).CombatHold {
				t.Fatal("fatal holder wound did not end combat and hold the actual body")
			}
			if mutual && (r.state.Combat.Winner != "draw" || r.state.CombatRoster[target].HP != 0) {
				t.Fatal("final projectile lost mutual casualties")
			}
		})
	}
}

func TestCombatNeedleFailedPhysicalShotRollsBackCraftingConsequences(t *testing.T) {
	r, c, target, gun := combatNeedleFixture(t, true)
	r.state.Seed = combatNeedleSeed(r, gun, "injured")
	combatStart(t, r, c, target)
	store := r.state.Inventory.Stores[inv.ItemStore(gun)]
	store.Locked = true
	r.state.Inventory.Stores[store.ID] = store
	before := r.snapshotState()
	result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "needle.rollback", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if result.Ok || !reflect.DeepEqual(before.Combat, r.state.Combat) || !reflect.DeepEqual(before.Inventory, r.state.Inventory) || !reflect.DeepEqual(before.Crafting, r.state.Crafting) {
		t.Fatal("failed physical debit leaked a projectile, risk roll, wound or report")
	}
}
