// Code generated by ANG. One persistent cart, ordinary owner locomotion, no cargo duplication.
package poc

import (
	behavior "angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"encoding/json"
	"fmt"
	"math"
)

type cartPose struct {
	X          float64 `json:"x"`
	Y          float64 `json:"y"`
	Z          float64 `json:"z"`
	YawDegrees float64 `json:"yaw_degrees"`
}
type cartMotion struct {
	Arc        bool     `json:"arc"`
	PivotX     float64  `json:"pivot_x"`
	PivotZ     float64  `json:"pivot_z"`
	ArcDegrees float64  `json:"arc_degrees"`
	From       cartPose `json:"from"`
	To         cartPose `json:"to"`
	StartNS    int64    `json:"start_ns"`
	EndNS      int64    `json:"end_ns"`
}
type cartBay struct {
	ID         string        `json:"id"`
	InstanceID string        `json:"instance_id"`
	PlaceID    string        `json:"place_id"`
	Handle     behavior.Cell `json:"handle"`
	PreHandle  behavior.Cell `json:"pre_handle"`
	Pose       cartPose      `json:"pose"`
}
type cartParkingCatalog struct {
	CartID                 string    `json:"cart_id"`
	OwnerActorID           string    `json:"owner_actor_id"`
	StoreID                string    `json:"store_id"`
	LevelID                string    `json:"level_id"`
	PrefabResource         string    `json:"prefab_resource"`
	CouplingForwardM       float64   `json:"coupling_forward_m"`
	CouplingRightM         float64   `json:"coupling_right_m"`
	GripYM                 float64   `json:"grip_y_m"`
	ReleaseSeconds         float64   `json:"release_seconds"`
	PickupSeconds          float64   `json:"pickup_seconds"`
	TurnSeconds            float64   `json:"turn_seconds"`
	HalfWidthM             float64   `json:"half_width_m"`
	FrontM                 float64   `json:"front_m"`
	BackM                  float64   `json:"back_m"`
	ApproachTimeoutSeconds int64     `json:"approach_timeout_seconds"`
	RetrySeconds           int64     `json:"retry_seconds"`
	Bays                   []cartBay `json:"bays"`
}

func (c *cartParkingCatalog) bay(id string) (cartBay, bool) {
	if c != nil {
		for _, b := range c.Bays {
			if b.ID == id {
				return b, true
			}
		}
	}
	return cartBay{}, false
}

// Cart identity/store live in CUE. State persists its independent pose and motion,
// not a second inventory. An approach has one finite lease; retrieval never lets
// the owner leave the cart behind merely because a cell is temporarily busy.
type cartParkingState struct {
	Phase       string        `json:"phase"`
	BayID       string        `json:"bay_id,omitempty"`
	PlaceID     string        `json:"place_id,omitempty"`
	LevelID     string        `json:"level_id"`
	Pose        cartPose      `json:"pose"`
	Motion      cartMotion    `json:"motion"`
	LastCell    behavior.Cell `json:"last_cell"`
	StartedNS   int64         `json:"started_ns"`
	DeadlineNS  int64         `json:"deadline_ns"`
	RetryAfter  int64         `json:"retry_after"`
	HandleLeg   bool          `json:"handle_leg"`
	ExitCell    behavior.Cell `json:"exit_cell"`
	ParkCount   int64         `json:"park_count"`
	PickupCount int64         `json:"pickup_count"`
}

func (r *Runtime) initCartParking() {
	c := r.world.CartParking
	if c == nil {
		return
	}
	a := r.state.Life.Actor(c.OwnerActorID)
	if a == nil {
		return
	}
	s := cartParkingState{Phase: "attached", LevelID: a.Level, LastCell: a.Position}
	s.Pose = r.cartAttachedPose(a, 0)
	r.state.Peddlers.Carts = map[string]cartParkingState{c.CartID: s}
}
func (r *Runtime) cartAttachedPose(a *behavior.LifeActor, yaw float64) cartPose {
	c := r.world.CartParking
	if a == nil || c == nil {
		return cartPose{}
	}
	if len(a.Path) > 0 {
		d := a.Path[0]
		if d != a.Position {
			yaw = math.Mod(math.Atan2(float64(d.X-a.Position.X), float64(d.Y-a.Position.Y))*180/math.Pi+360, 360)
		}
	}
	rad := yaw * math.Pi / 180
	cell := float64(r.world.Life.Locations[a.Level].CellMM) / 1000
	return cartPose{X: (float64(a.Position.X)+.5)*cell + math.Sin(rad)*c.CouplingForwardM + math.Cos(rad)*c.CouplingRightM, Z: (float64(a.Position.Y)+.5)*cell + math.Cos(rad)*c.CouplingForwardM - math.Sin(rad)*c.CouplingRightM, YawDegrees: yaw}
}
func (r *Runtime) cartTradeReady(id string) bool {
	c := r.world.CartParking
	if c == nil || id != c.OwnerActorID {
		return true
	}
	s, ok := r.state.Peddlers.Carts[c.CartID]
	return ok && s.Phase == "attached"
}
func (r *Runtime) cartServiceReady(id string) bool {
	c := r.world.CartParking
	if c == nil || id != c.OwnerActorID {
		return true
	}
	s, ok := r.state.Peddlers.Carts[c.CartID]
	return ok && s.Phase == "parked"
}
func (r *Runtime) cartStep(a *behavior.LifeActor, at behavior.Cell, pickup bool) behavior.LifeStep {
	key := "life.cart.parking"
	if pickup {
		key = "life.cart.pickup"
	}
	return behavior.LifeStep{Level: a.Level, At: at, Activity: "rest", Label: key}
}
func (r *Runtime) cartReserveReturn(a *behavior.LifeActor, b cartBay, wanted behavior.LifeStep) bool {
	if a.Brain.BreakKind == "" {
		return true
	}
	c := r.world.CartParking
	post := a.Brain.BreakPost
	if post.Level != a.Level || wanted.Level != a.Level {
		return false
	}
	travel := func(from, to behavior.Cell) int64 {
		return r.state.Life.StaticTravelSeconds(r.world.Life, a.Level, from, to)
	}
	direct := travel(wanted.At, post.At)
	toApproach := travel(wanted.At, b.PreHandle)
	toHandle := travel(b.PreHandle, b.Handle)
	home := travel(b.Handle, post.At)
	if direct < 0 || toApproach < 0 || toHandle < 0 || home < 0 {
		return false
	}
	// Only the additional return detour, plus physical pickup and frame boundaries.
	// Original budget, need relief and work obligation remain unchanged.
	reserve := max(int64(0), toApproach+toHandle+home-direct) + (int64(math.Ceil((c.PickupSeconds+c.TurnSeconds)*float64(r.world.Config.TickHz)))+2)*r.state.Life.SecondsPerTick
	if a.Brain.BreakReturnAt-reserve <= r.state.Life.Seconds {
		return false
	}
	a.Brain.BreakReturnAt -= reserve
	return true
}
func (r *Runtime) cartAbandonPlace(a *behavior.LifeActor) {
	// Release only the failed service intention; accumulated needs, wages, routine
	// override and inventory remain untouched. The next utility decision is delayed
	// for the authored finite retry interval, instead of a busy loop at the bay.
	b := &a.Brain
	b.Seat = ""
	b.SeatQueue = false
	b.SeatedAt = 0
	b.SitUntil = 0
	b.RiseAt = 0
	b.QueueSince = 0
	b.Place = behavior.LifeAffordance{}
	b.MealElapsed = 0
	b.Returning = b.BreakKind != ""
	b.Goal.HoldUntil = b.Goal.ChosenTick
	b.NextDecision = r.state.Life.Seconds + r.world.CartParking.RetrySeconds
	p := r.world.Life.Person(a.ID)
	if p != nil {
		b.Target = p.Steps[a.Step]
		if a.RoutineOverride != nil {
			b.Target = *a.RoutineOverride
		}
	}
}
func cartArcPose(m cartMotion, now int64) cartPose {
	t := 0.0
	if m.EndNS > m.StartNS {
		t = math.Max(0, math.Min(1, float64(now-m.StartNS)/float64(m.EndNS-m.StartNS)))
	}
	if !m.Arc {
		return m.From
	}
	yaw := m.From.YawDegrees + m.ArcDegrees*t
	radius := math.Hypot(m.From.X-m.PivotX, m.From.Z-m.PivotZ)
	angle := yaw * math.Pi / 180
	return cartPose{X: m.PivotX + math.Sin(angle)*radius, Y: m.From.Y, Z: m.PivotZ + math.Cos(angle)*radius, YawDegrees: math.Mod(yaw+720, 360)}
}
func (r *Runtime) cartArcCells(a *behavior.LifeActor, m cartMotion) []behavior.Cell {
	c := r.world.CartParking
	seen := map[behavior.Cell]bool{}
	cells := []behavior.Cell{}
	cell := float64(r.world.Life.Locations[a.Level].CellMM) / 1000
	for i := 0; i <= 72; i++ {
		p := cartArcPose(m, m.StartNS+(m.EndNS-m.StartNS)*int64(i)/72)
		angle := p.YawDegrees * math.Pi / 180
		// Conservative swept rectangle includes the handle, not just the cassette.
		minX, minZ, maxX, maxZ := math.Inf(1), math.Inf(1), math.Inf(-1), math.Inf(-1)
		for _, side := range []float64{-c.HalfWidthM, c.HalfWidthM} {
			for _, fore := range []float64{-c.BackM, c.FrontM} {
				x := p.X + math.Cos(angle)*side + math.Sin(angle)*fore
				z := p.Z - math.Sin(angle)*side + math.Cos(angle)*fore
				minX = math.Min(minX, x)
				maxX = math.Max(maxX, x)
				minZ = math.Min(minZ, z)
				maxZ = math.Max(maxZ, z)
			}
		}
		for y := int(math.Floor(minZ / cell)); y <= int(math.Floor(maxZ/cell)); y++ {
			for x := int(math.Floor(minX / cell)); x <= int(math.Floor(maxX/cell)); x++ {
				at := behavior.Cell{X: x, Y: y}
				if !seen[at] {
					seen[at] = true
					cells = append(cells, at)
				}
			}
		}
	}
	return cells
}
func (r *Runtime) cartArcClear(a *behavior.LifeActor, b cartBay, m cartMotion) bool {
	blocked := r.state.Life.BlockedCells(a.Level, a.ID)
	for _, at := range r.cartArcCells(a, m) {
		own := at.X >= b.Handle.X-2 && at.X < b.Handle.X && at.Y >= b.Handle.Y-1 && at.Y <= b.Handle.Y+1
		if !own && !r.world.Life.Walks(a.Level, at) || blocked[at] {
			return false
		}
	}
	return true
}
func (r *Runtime) cartBeginTurn(a *behavior.LifeActor, b cartBay, wanted behavior.LifeStep, s *cartParkingState) bool {
	goal := wanted.At
	if wanted.Level != a.Level {
		edge := r.world.Life.NextEdge(a.Level, wanted.Level)
		if edge == nil {
			return false
		}
		goal = edge.Exit
	}
	blocked := r.state.Life.BlockedCells(a.Level, a.ID)
	space := r.world.Life.Space(a.Level, blocked)
	best := int(^uint(0) >> 1)
	var chosen cartMotion
	var exit behavior.Cell
	for _, d := range []behavior.Cell{{X: 1}, {Y: 1}, {X: -1}, {Y: -1}} {
		next := behavior.Cell{X: a.Position.X + d.X, Y: a.Position.Y + d.Y}
		if !r.world.Life.Walks(a.Level, next) || blocked[next] {
			continue
		}
		path := space.Path(next, goal, behavior.Cell{}, 0)
		if next != goal && len(path) == 0 {
			continue
		}
		yaw := math.Mod(math.Atan2(float64(d.X), float64(d.Y))*180/math.Pi+360, 360)
		delta := math.Mod(yaw-s.Pose.YawDegrees+360, 360)
		if delta > 180 {
			delta -= 360
		}
		arcs := []float64{delta}
		if delta > 0 {
			arcs = append(arcs, delta-360)
		} else if delta < 0 {
			arcs = append(arcs, delta+360)
		}
		for _, arc := range arcs {
			m := cartMotion{Arc: true, PivotX: (float64(a.Position.X) + .5) * .5, PivotZ: (float64(a.Position.Y) + .5) * .5, ArcDegrees: arc, From: s.Pose, StartNS: r.simNS(), EndNS: r.simNS() + int64(r.world.CartParking.TurnSeconds*1e9)}
			m.To = cartArcPose(m, m.EndNS)
			cost := len(path)*1000 + int(math.Abs(arc))
			if cost >= best || !r.cartArcClear(a, b, m) {
				continue
			}
			best = cost
			chosen = m
			exit = next
		}
	}
	if best == int(^uint(0)>>1) {
		return false
	}
	s.Phase = "turning"
	s.Motion = chosen
	s.ExitCell = exit
	s.StartedNS = r.simNS()
	a.RouteFootprint = r.cartArcCells(a, chosen)
	return true
}

func (r *Runtime) cartRouteDetour(a *behavior.LifeActor, wanted behavior.LifeStep) (behavior.LifeStep, bool) {
	c := r.world.CartParking
	if c == nil || a.ID != c.OwnerActorID || !a.OnFloor() || a.Level != c.LevelID {
		return wanted, false
	}
	s, ok := r.state.Peddlers.Carts[c.CartID]
	if !ok {
		r.initCartParking()
		s = r.state.Peddlers.Carts[c.CartID]
	}
	now := r.simNS()
	defer func() { r.state.Peddlers.Carts[c.CartID] = s }()
	if s.Phase == "attached" || s.Phase == "approach" || s.Phase == "handoff" {
		if a.Position != s.LastCell {
			dx, dz := a.Position.X-s.LastCell.X, a.Position.Y-s.LastCell.Y
			s.Pose.YawDegrees = math.Mod(math.Atan2(float64(dx), float64(dz))*180/math.Pi+360, 360)
		}
		s.LastCell = a.Position
		s.Pose = r.cartAttachedPose(a, s.Pose.YawDegrees)
		s.LevelID = a.Level
	}
	if s.Phase == "handoff" {
		if a.Position != s.ExitCell || len(a.Path) > 0 {
			return r.cartStep(a, s.ExitCell, true), true
		}
		a.RouteFootprint = nil
		s.Phase = "attached"
		s.BayID = ""
		s.PlaceID = ""
		return wanted, true
	}
	desired := ""
	if !a.Brain.Returning {
		for _, b := range c.Bays {
			if b.PlaceID == a.Brain.Place.ID {
				desired = b.ID
				break
			}
		}
	}
	if s.Phase == "attached" {
		if desired == "" {
			return wanted, false
		}
		if r.state.Life.Seconds < s.RetryAfter {
			r.cartAbandonPlace(a)
			return a.Brain.Target, true
		}
		b, _ := c.bay(desired)
		if !r.cartReserveReturn(a, b, wanted) {
			r.cartAbandonPlace(a)
			s.RetryAfter = r.state.Life.Seconds + c.RetrySeconds
			return a.Brain.Target, true
		}
		s.Phase = "approach"
		s.BayID = b.ID
		s.PlaceID = b.PlaceID
		s.HandleLeg = false
		s.StartedNS = now
		s.DeadlineNS = now + c.ApproachTimeoutSeconds*1e9
	}
	b, exists := c.bay(s.BayID)
	if !exists {
		return wanted, false
	}
	if s.Phase == "approach" {
		if desired != s.BayID || now >= s.DeadlineNS {
			if desired == s.BayID {
				r.cartAbandonPlace(a)
				wanted = a.Brain.Target
				s.RetryAfter = r.state.Life.Seconds + c.RetrySeconds
			}
			s.Phase = "attached"
			s.BayID = ""
			s.PlaceID = ""
			s.HandleLeg = false
			s.DeadlineNS = 0
			return wanted, true
		}
		if !s.HandleLeg {
			if a.Position != b.PreHandle || len(a.Path) > 0 {
				return r.cartStep(a, b.PreHandle, false), true
			}
			s.HandleLeg = true
		}
		if a.Position != b.Handle || len(a.Path) > 0 {
			return r.cartStep(a, b.Handle, false), true
		}
		attachedFrom := r.cartAttachedPose(a, s.Pose.YawDegrees)
		s.Phase = "parking"
		s.Pose = b.Pose
		s.Motion = cartMotion{From: b.Pose, To: b.Pose, StartNS: now, EndNS: now + int64(c.ReleaseSeconds*1e9)}
		// An aligned cart has no displacement or modelled latch operation.
		// Keep authored timing for every nonzero motion.
		if attachedFrom == b.Pose {
			s.Motion.EndNS = now
		}
		s.StartedNS = now
		s.DeadlineNS = 0
	}
	if s.Phase == "parking" {
		if now < s.Motion.EndNS {
			return r.cartStep(a, b.Handle, false), true
		}
		s.Phase = "parked"
		s.ParkCount++
		s.HandleLeg = false
		return wanted, false
	}
	if s.Phase == "parked" {
		if r.serviceReserved(a.ID) || desired == s.BayID {
			return wanted, false
		}
		s.Phase = "returning"
		s.HandleLeg = false
		s.StartedNS = now
	}
	if s.Phase == "returning" {
		if !s.HandleLeg {
			if a.Position != b.PreHandle || len(a.Path) > 0 {
				return r.cartStep(a, b.PreHandle, true), true
			}
			s.HandleLeg = true
		}
		if a.Position != b.Handle || len(a.Path) > 0 {
			return r.cartStep(a, b.Handle, true), true
		}
		s.Phase = "pickup"
		s.StartedNS = now
		s.Motion = cartMotion{From: b.Pose, To: b.Pose, StartNS: now, EndNS: now + int64(c.PickupSeconds*1e9)}
	}
	if s.Phase == "pickup" {
		if now < s.Motion.EndNS {
			return r.cartStep(a, b.Handle, true), true
		}
		if !r.cartBeginTurn(a, b, wanted, &s) {
			return r.cartStep(a, b.Handle, true), true
		}
	}
	if s.Phase == "turning" {
		s.Pose = cartArcPose(s.Motion, now)
		if now < s.Motion.EndNS {
			return r.cartStep(a, b.Handle, true), true
		}
		if r.state.Life.BlockedCells(a.Level, a.ID)[s.ExitCell] {
			return r.cartStep(a, b.Handle, true), true
		}
		s.Phase = "handoff"
		s.PickupCount++
		s.HandleLeg = false
		s.LastCell = a.Position
		a.Path = []behavior.Cell{s.ExitCell}
		a.PendingPath = nil
		a.MoveStartTick = r.lifeMotionTick()
		a.Arrived = false
		a.Goal = s.ExitCell
		return r.cartStep(a, s.ExitCell, true), true
	}
	return wanted, false
}
func (r *Runtime) cartParkingJSON(hero *behavior.LifeActor, view *pb.PocObserverView) string {
	type item struct {
		CartID           string     `json:"cart_id"`
		OwnerActorID     string     `json:"owner_actor_id"`
		PrefabResource   string     `json:"prefab_resource"`
		LevelID          string     `json:"level_id"`
		Mode             string     `json:"mode"`
		OwnerVisible     bool       `json:"owner_visible"`
		HandContact      bool       `json:"hand_contact"`
		CouplingForwardM float64    `json:"coupling_forward_m"`
		CouplingRightM   float64    `json:"coupling_right_m"`
		GripYM           float64    `json:"grip_y_m"`
		OwnerYawDegrees  float64    `json:"owner_yaw_degrees"`
		Pose             cartPose   `json:"pose"`
		Motion           cartMotion `json:"motion"`
	}
	out := struct {
		Epoch       string `json:"epoch"`
		SampleSimNS int64  `json:"sample_sim_ns"`
		Carts       []item `json:"carts"`
	}{r.state.Epoch, r.simNS(), []item{}}
	if c := r.world.CartParking; c != nil && hero != nil && hero.OnFloor() {
		if s, ok := r.state.Peddlers.Carts[c.CartID]; ok {
			a := r.state.Life.Actor(c.OwnerActorID)
			mode := s.Phase
			pose := s.Pose
			level := s.LevelID
			if mode == "approach" || mode == "handoff" {
				mode = "attached"
			}
			if mode == "returning" {
				mode = "parked"
			}
			if mode == "turning" {
				mode = "pickup"
				pose = cartArcPose(s.Motion, r.simNS())
			}
			if mode == "attached" && a != nil && a.OnFloor() {
				pose = r.cartAttachedPose(a, s.Pose.YawDegrees)
				level = a.Level
			}
			cell := float64(r.world.Life.Locations[level].CellMM) / 1000
			visible := cell > 0 && hero.Level == level && viewSees(view, int32(math.Floor(pose.X/cell)), int32(math.Floor(pose.Z/cell)))
			ownerVisible := a != nil && a.OnFloor() && a.Level == hero.Level && viewSees(view, int32(a.Position.X), int32(a.Position.Y))
			if visible {
				motion := s.Motion
				if mode == "attached" || mode == "parked" {
					motion = cartMotion{From: pose, To: pose, StartNS: r.simNS(), EndNS: r.simNS()}
				}
				out.Carts = append(out.Carts, item{c.CartID, c.OwnerActorID, c.PrefabResource, level, mode, ownerVisible, ownerVisible && (mode == "attached" || mode == "pickup") && a.Brain.SeatedAt == 0, c.CouplingForwardM, c.CouplingRightM, c.GripYM, pose.YawDegrees, pose, motion})
			}
		}
	}
	raw, _ := json.Marshal(out)
	return string(raw)
}
func (r *Runtime) validateCartParkingSave(s state) error {
	for _, a := range s.Life.Actors {
		if len(a.RouteFootprint) > 0 && (r.world.CartParking == nil || a.ID != r.world.CartParking.OwnerActorID || len(s.Peddlers.Carts) == 0) {
			return fmt.Errorf("unowned route footprint")
		}
	}
	c := r.world.CartParking
	if c == nil {
		if len(s.Peddlers.Carts) != 0 {
			return fmt.Errorf("unexpected carts")
		}
		return nil
	}
	if len(s.Peddlers.Carts) == 0 {
		return nil
	} // legacy save, lazily initialized at the owner's next ordinary frame
	if len(s.Peddlers.Carts) != 1 {
		return fmt.Errorf("cart duplicated")
	}
	v, ok := s.Peddlers.Carts[c.CartID]
	if !ok {
		return fmt.Errorf("unknown cart identity")
	}
	if s.Life.Actor(c.OwnerActorID) == nil {
		return fmt.Errorf("missing cart owner")
	}
	if _, ok := s.Inventory.Stores[c.StoreID]; !ok {
		return fmt.Errorf("missing cart inventory")
	}
	switch v.Phase {
	case "attached", "approach", "parking", "parked", "returning", "pickup", "turning", "handoff":
	default:
		return fmt.Errorf("invalid cart phase")
	}
	finite := func(p cartPose) bool {
		for _, f := range []float64{p.X, p.Y, p.Z, p.YawDegrees} {
			if math.IsNaN(f) || math.IsInf(f, 0) || math.Abs(f) > 1e5 {
				return false
			}
		}
		return p.Y >= 0 && p.YawDegrees >= 0 && p.YawDegrees < 360
	}
	now := s.Tick*r.tickNS() + min(max(s.PhaseNS, int64(0)), r.tickNS()-1)
	if v.StartedNS > now || v.Motion.StartNS > now || v.Motion.EndNS-v.Motion.StartNS > int64(max(c.ReleaseSeconds, c.PickupSeconds, c.TurnSeconds)*1e9) {
		return fmt.Errorf("invalid cart physical timestamp")
	}
	if !finite(v.Pose) || !finite(v.Motion.From) || !finite(v.Motion.To) || v.StartedNS < 0 || v.DeadlineNS < 0 || v.RetryAfter < 0 || v.Motion.StartNS < 0 || v.Motion.EndNS < v.Motion.StartNS || v.ParkCount < 0 || v.PickupCount < 0 || v.PickupCount > v.ParkCount || v.ParkCount-v.PickupCount > 1 {
		return fmt.Errorf("invalid cart pose/clock/count")
	}
	if v.Phase != "attached" {
		b, ok := c.bay(v.BayID)
		if !ok || v.PlaceID != b.PlaceID || v.LevelID != c.LevelID {
			return fmt.Errorf("invalid cart bay")
		}
		if v.Phase != "approach" && v.Phase != "turning" && v.Phase != "handoff" && v.Pose != b.Pose {
			return fmt.Errorf("parked cart moved away from bay")
		}
	}
	if v.Phase == "approach" && (v.DeadlineNS <= v.StartedNS || v.DeadlineNS-v.StartedNS > c.ApproachTimeoutSeconds*1e9) {
		return fmt.Errorf("invalid cart approach lease")
	}
	detached := v.Phase == "parked" || v.Phase == "returning" || v.Phase == "pickup" || v.Phase == "turning"
	if detached != (v.ParkCount-v.PickupCount == 1) {
		return fmt.Errorf("cart ownership/phase mismatch")
	}
	if v.Phase == "attached" && (v.BayID != "" || v.PlaceID != "") {
		return fmt.Errorf("attached cart retains detached bay ownership")
	}
	a := s.Life.Actor(c.OwnerActorID)
	if v.Phase == "turning" || v.Phase == "handoff" {
		m := v.Motion
		b, _ := c.bay(v.BayID)
		for _, f := range []float64{m.PivotX, m.PivotZ, m.ArcDegrees} {
			if math.IsNaN(f) || math.IsInf(f, 0) {
				return fmt.Errorf("nonfinite cart arc")
			}
		}
		if !m.Arc || math.Abs(m.ArcDegrees) > 360 || m.EndNS <= m.StartNS || math.Abs(math.Hypot(m.From.X-m.PivotX, m.From.Z-m.PivotZ)-c.CouplingForwardM) > 1e-8 || m.PivotX != (float64(b.Handle.X)+.5)*.5 || m.PivotZ != (float64(b.Handle.Y)+.5)*.5 || m.To != cartArcPose(m, m.EndNS) {
			return fmt.Errorf("invalid cart arc")
		}
		if a.Level != c.LevelID || v.Phase == "turning" && a.Position != b.Handle || v.Phase == "handoff" && a.Position != b.Handle && a.Position != v.ExitCell || !r.world.Life.Walks(a.Level, v.ExitCell) {
			return fmt.Errorf("cart turn owner left the physical pivot")
		}
		expected := r.cartArcCells(a, m)
		if len(expected) != len(a.RouteFootprint) {
			return fmt.Errorf("missing cart turn reservation")
		}
		for i, at := range expected {
			if a.RouteFootprint[i] != at {
				return fmt.Errorf("changed cart turn reservation")
			}
		}
	} else if len(a.RouteFootprint) > 0 {
		return fmt.Errorf("completed cart left a route reservation")
	}
	return nil
}
