}

func TestIlluminationStrictSolidsCornersAndBoundarySkims(t *testing.T) {
	v := illuminationVolume(t)
	v.Solids = []DeckSpan{{Rect: DeckRect{X: 1, Y: 0, W: 1, H: 1}, BottomMM: 500, TopMM: 1500}}
	illuminationPrepare(t, v)
	// Touching the corner (500,500) is blocked even if the other side cell is
	// empty; the sight kernel intentionally has a different corner policy.
	illuminationRay(t, v, DeckPointMM{250, 250, 1000}, DeckPointMM{1250, 1250, 1000}, nil, false)
	illuminationRay(t, v, DeckPointMM{250, 251, 1000}, DeckPointMM{1250, 1251, 1000}, nil, true)
	illuminationRay(t, v, DeckPointMM{250, 500, 1000}, DeckPointMM{1250, 500, 1000}, nil, false)
	illuminationRay(t, v, DeckPointMM{750, 250, 1000}, DeckPointMM{1250, 1250, 1000}, nil, false)
	illuminationRay(t, v, DeckPointMM{750, 250, 1000}, DeckPointMM{750, 250, 1000}, nil, false)
	illuminationRay(t, v, DeckPointMM{250, 250, 1000}, DeckPointMM{250, 250, 1000}, nil, true)
	v.Solids = []DeckSpan{{Rect: DeckRect{X: 0, Y: 1, W: 1, H: 1}, BottomMM: 500, TopMM: 1500}}
	illuminationPrepare(t, v)
	illuminationRay(t, v, DeckPointMM{500, 250, 1000}, DeckPointMM{500, 1750, 1000}, nil, false)
	illuminationRay(t, v, DeckPointMM{501, 250, 1000}, DeckPointMM{501, 1750, 1000}, nil, true)
}

func TestIlluminationMovingLeafBoxesAreFreshAndStrict(t *testing.T) {
	v := illuminationVolume(t)
	a, torso, head := DeckPointMM{250, 750, 1000}, DeckPointMM{1750, 750, 1000}, DeckPointMM{1750, 750, 1600}
	boxes := []DeckRayBox{{Min: DeckPointMM{1095, 500, 0}, Max: DeckPointMM{1105, 1000, 2000}}}
	before, err := json.Marshal(v)
	if err != nil {
		t.Fatal(err)
	}
	illuminationRay(t, v, a, torso, boxes, false)
	boxes[0].Min.Z, boxes[0].Max.Z = 1250, 3250
	illuminationRay(t, v, a, torso, boxes, true)
	illuminationRay(t, v, DeckPointMM{250, 750, 1600}, head, boxes, false)
	boxes[0].Min.Z, boxes[0].Max.Z = 3000, 5000
	illuminationRay(t, v, a, torso, boxes, true)
	// A thin movable sheet can be represented without inflating it to a tile.
	boxes[0] = DeckRayBox{Min: DeckPointMM{1100, 500, 0}, Max: DeckPointMM{1100, 1000, 2000}}
	illuminationRay(t, v, a, torso, boxes, false)
	illuminationRay(t, v, DeckPointMM{1100, 750, 1000}, torso, boxes, false)
	after, err := json.Marshal(v)
	if err != nil || !reflect.DeepEqual(before, after) || boxes[0].Min.X != 1100 {
		t.Fatal("read-only rays mutated the volume or gate snapshot")
	}
}

func TestIlluminationBodySamplesRespectStanceDeckAndOcclusion(t *testing.T) {
	v := illuminationVolume(t)
	v.Solids = []DeckSpan{{Rect: DeckRect{X: 2, Y: 1, W: 1, H: 1}, BottomMM: 0, TopMM: 900}}
	illuminationPrepare(t, v)
	at := Cell{3, 1}
	standing := v.BodyLightPoints(at, Combatant{})
	if standing != [3]DeckPointMM{{1750, 750, 450}, {1750, 750, 1100}, {1750, 750, 1650}} {
		t.Fatalf("standing body uses wrong physical centre/heights: %+v", standing)
	}
	prone := v.BodyLightPoints(at, Combatant{Prone: true})
	crouch := v.BodyLightPoints(at, Combatant{Crouched: true})
	if prone[0].Z != 150 || prone[1].Z != 280 || prone[2].Z != 400 || crouch[0].Z != 250 || crouch[1].Z != 700 || crouch[2].Z != 1050 {
		t.Fatal("lighting invented stance heights different from tactical bodies")
	}
	light := DeckPointMM{250, 750, 2000}
	for i, p := range standing {
		illuminationRay(t, v, light, p, nil, i != 0)
	}
	for _, p := range prone {
		illuminationRay(t, v, light, p, nil, false)
	}
	upper := v.BodyLightPoints(Cell{3, 5}, Combatant{})
	if upper[0].X != standing[0].X || upper[0].Y != standing[0].Y || upper[0].Z != standing[0].Z+3000 {
		t.Fatalf("nav-band row leaked into physical position: %+v", upper)
	}
	illuminationRay(t, v, light, upper[1], nil, false)
}

func TestIlluminationInvalidGeometryFailsClosed(t *testing.T) {
	v := illuminationVolume(t)
	good := DeckPointMM{250, 750, 1000}
	for _, bad := range []DeckPointMM{{math.NaN(), 750, 1000}, {250, math.Inf(1), 1000}, {250, 750, math.Inf(-1)}, {-1, 750, 1000}, {3000, 750, 1000}} {
		if v.RayClearMM(good, bad, nil) || v.RayClearMM(bad, good, nil) {
			t.Fatalf("invalid/outside endpoint passed: %+v", bad)
		}
	}
	for _, box := range []DeckRayBox{{Min: DeckPointMM{1000, 1000, 0}, Max: DeckPointMM{500, 1500, 2000}}, {Min: DeckPointMM{math.NaN(), 0, 0}, Max: DeckPointMM{500, 500, 2000}}} {
		if v.RayClearMM(good, DeckPointMM{750, 750, 1000}, []DeckRayBox{box}) {
			t.Fatal("invalid dynamic geometry was silently ignored")
		}
	}
	var absent *DeckVolume
	if absent.RayClearMM(good, good, nil) || (&DeckVolume{PlanWidth: 6, PlanDepth: 4}).RayClearMM(good, good, nil) {
		t.Fatal("unprepared geometry passed")
	}
	for _, points := range [][3]DeckPointMM{v.BodyLightPoints(Cell{-1, 0}, Combatant{}), absent.BodyLightPoints(Cell{}, Combatant{}), (&DeckVolume{PlanWidth: 6, NavWidth: 6, NavDepth: 8}).BodyLightPoints(Cell{}, Combatant{})} {
		for _, p := range points {
			if v.RayClearMM(good, p, nil) || DirectIlluminance(LightEmitter{Distribution: "iso", At: good, Lumens: 1000}, p) != 0 {
				t.Fatal("unmapped body sample illuminated map origin")
			}
		}
	}
}

func illuminationNear(t *testing.T, got, want float64) {
	t.Helper()
	if math.Abs(got-want) > 1e-8*math.Max(1, math.Abs(want)) {
		t.Fatalf("illuminance %g, want %g", got, want)
	}
}
func TestDirectIlluminanceInverseSquareAndSourceDistributions(t *testing.T) {
	e := LightEmitter{Distribution: "iso", Lumens: 400 * math.Pi}
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{0, 0, -1000}), 100)
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{0, 0, -2000}), 25)
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{0, 1000, 0}), 100)
	e.Distribution, e.Lumens = "lambert_down", 100*math.Pi
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{0, 0, -1000}), 100)
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{0, 0, 1000}), 0)
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{1000, 0, 0}), 0)
	e.Distribution, e.Aim = "wall_down", DeckPointMM{1000, 0, -1000}
	d := 1000 / math.Sqrt2
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{d, 0, -d}), 100)
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{-d, 0, d}), 0)
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{0, 0, -2000}), 25/math.Sqrt2)
	// Translation and converting mm to metres must not change the result.
	e.At, e.Aim = DeckPointMM{12000, 7000, 4000}, DeckPointMM{13000, 7000, 3000}
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{12000 + d, 7000, 4000 - d}), 100)
}

func TestDirectIlluminanceSpotFWHMFiniteConeAndGlass(t *testing.T) {
	e := LightEmitter{Distribution: "spot", At: DeckPointMM{0, 0, 2000}, Aim: DeckPointMM{0, 0, 0}, Lumens: 1000, BeamDegrees: 80}
	axis := DirectIlluminance(e, DeckPointMM{0, 0, 1000})
	angle := 40 * math.Pi / 180
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{1000 * math.Sin(angle), 0, 2000 - 1000*math.Cos(angle)}), axis*.5)
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{0, 0, 0}), axis*.25)
	angle = 55 * math.Pi / 180
	illuminationNear(t, DirectIlluminance(e, DeckPointMM{1000 * math.Sin(angle), 0, 2000 - 1000*math.Cos(angle)}), 0)
	// The optical cone reaches above a flat glass plane, but the glass blocks
	// this direction. Tilting the glass changes that actual clipping plane.
	e.At = DeckPointMM{}
	e.Aim = DeckPointMM{1000 * math.Sin(math.Pi/3), 0, -1000 * math.Cos(math.Pi/3)}
	angle = 100 * math.Pi / 180
	p := DeckPointMM{1000 * math.Sin(angle), 0, -1000 * math.Cos(angle)}
	if DirectIlluminance(e, p) <= 0 {
		t.Fatal("fixture does not exercise a ray within the optical cone")
	}
	e.Distribution = "asym"
	illuminationNear(t, DirectIlluminance(e, p), 0)
	e.GlassTiltDegrees = 20
	if DirectIlluminance(e, p) <= 0 {
		t.Fatal("glass clipping ignored its authored tilt")
	}
}

func TestDirectIlluminanceInvalidInputsAndPointSourceSingularityStayFinite(t *testing.T) {
	base := LightEmitter{Distribution: "spot", At: DeckPointMM{0, 0, 2000}, Aim: DeckPointMM{}, Lumens: 1000, BeamDegrees: 80}
	p := DeckPointMM{0, 0, 1000}
	cases := []LightEmitter{base, base, base, base, base, base, base, base, base, base}
	cases[0].Lumens = -1
	cases[1].Lumens = math.NaN()
	cases[2].At.Z = math.Inf(1)
	cases[3].BeamDegrees = math.Inf(1)
	cases[4].BeamDegrees = .1
	cases[5].BeamDegrees = 180
	cases[6].Aim = cases[6].At
	cases[7].Distribution = "not-a-light"
	cases[8].Distribution, cases[8].GlassTiltDegrees = "asym", math.NaN()
	cases[9].Aim.X = math.NaN()
	for i, e := range cases {
		if got := DirectIlluminance(e, p); got != 0 {
			t.Fatalf("invalid light %d produced %g", i, got)
		}
	}
	for _, dist := range []string{"iso", "lambert_down", "wall_down", "spot", "asym"} {
		e := base
		e.Distribution = dist
		for _, point := range []DeckPointMM{e.At, {0, 0, 1999.999999}, {0, 0, math.MaxFloat64}, {math.NaN(), 0, 1000}} {
			if got := DirectIlluminance(e, point); !illuminationFinite(got) || got < 0 {
				t.Fatalf("%s light produced non-finite/negative illuminance %g", dist, got)
			}
		}
		e.Lumens = math.MaxFloat64
		if got := DirectIlluminance(e, DeckPointMM{0, 0, 1999}); !illuminationFinite(got) || got < 0 {
			t.Fatal("large finite source overflowed")
		}
	}
	base.Distribution = "iso"
	illuminationNear(t, DirectIlluminance(base, DeckPointMM{0, 0, 1999}), DirectIlluminance(base, DeckPointMM{0, 0, 1900}))
}
