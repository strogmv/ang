{{- if .HasPayin }}

func (pp *{{ .StructName }}) doPayin(tx *model.Transaction, mc *model.MerchantCreds, req httpcli.APIRequest) (*model.PaymentResponse, error) {
{{- if or .HTTPAuth .UseBasicAuth .UseMacanP2P }}
	secrets, err := pp.parseProviderSecrets(mc, opPayin)
	if err != nil {
		return nil, err
	}
	headers := pp.authHeaders(secrets)
{{- else }}
	headers := httpcli.NewHeaders().Add("Content-Type", "application/json")
{{- end }}
	respBody, err := pp.httpClient.Post(tx, mc.ApiEndpoint+{{ .PayinEndpointConst }}, req, headers)
	if err != nil {
		if httpcli.IsBadRequestError(err) {
{{- template "declineBadRequestPayment" . }}
		}
		return nil, fmt.Errorf("calling %s payin: %w", ppSID, err)
	}

	var resp {{ .PayinResponseType }}
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}

	return &model.PaymentResponse{
		Timestamp: time.Now(),
		Status:    tnxStatusPending,
		Code:      model.SCodeOk,
		ForeignId: resp.{{ .PayinForeignIDField }},
	}, nil
}
{{- end }}

func (pp *{{ .StructName }}) InitPayout(mc *model.MerchantCreds, ps *model.PaymentSource, tx *model.Transaction) (*model.PaymentResponse, error) {
{{- if .HasPayout }}
{{- if eq .PaymentSource "card" }}
	if ps.Card == nil {
		return nil, providers.ErrCardSupportOnly
	}
	card := ps.Card
{{- else if eq .PaymentSource "apm" }}
	if ps.APM == nil {
		return nil, providers.ErrAPMSupportOnly
	}
{{- else }}
	if ps.Card == nil && ps.APM == nil {
		return nil, providers.ErrUnsupportedPaymentSource
	}
{{- end }}
	secrets, err := pp.parseProviderSecrets(mc, opPayout)
	if err != nil {
		return nil, err
	}
{{- if and .UseMacanP2P .HasMultiCurrency }}
	if !isSupportedCurrency(tx.Currency) {
		return nil, fmt.Errorf("%w: %s", providers.ErrUnsupportedCurrency, tx.Currency)
	}
{{- end }}
{{- if eq .PaymentSource "apm" }}
	info := ps.APM.OwnerInfo
{{- end }}

{{- if .HasPayoutDualEndpoint }}
	path := p2pPayoutEndpoint(tx.Order.PaymentMethodBrand)
{{- else }}
	path := {{ .PayoutEndpointConst }}
{{- end }}
{{- if .UseOperationRuntime }}
	path = pp.operationEndpointPath("init_payout", path)
{{- end }}

{{- if .UseTransfertyH2H }}
	customerID := helpers.MapGet(info, providers.ExternalCustomerIDKey, tx.Id)
	var req httpcli.APIRequest
	if path == {{ .PayoutCardEndpointConst }} {
		req = &h2hCardPayoutRequest{
			OrderID:          tx.Id,
			OrderDescription: tx.Order.Description,
			Amount:           tx.Amount,
			Currency:         tx.Currency,
			CustomerID:       customerID,
			CustomerIP:       tx.Order.IP,
			CallbackURL:      tx.CallbackURL,
			CcNumber:         ps.APM.ID,
		}
	} else {
		details, _ := buildApmDetails(info)
		req = &h2hApmPayoutRequest{
			OrderID:          tx.Id,
			OrderDescription: tx.Order.Description,
			Amount:           tx.Amount,
			Currency:         tx.Currency,
			CustomerID:       customerID,
			CustomerIP:       tx.Order.IP,
			CallbackURL:      tx.CallbackURL,
			PaymentAccount: h2hPaymentAccount{
				Method:     tx.Order.PaymentMethodBrand,
				Identifier: ps.APM.ID,
			},
			Details: details,
		}
	}
	headers := pp.authHeaders(secrets)
{{- else if .UseMacanP2P }}
	methodName, err := macanPaymentMethodName(tx.Order.PaymentMethodBrand, tx.Currency)
	if err != nil {
		return nil, err
	}
	bankCode := macanBankCode(info)
	if bankCode == "" {
		return nil, fmt.Errorf("%s: bank code is required for payout", ppSID)
	}
	customerID := helpers.MapGet(info, providers.ExternalCustomerIDKey, tx.Id)
	req := &macanPayOutRequest{
		Amount: helpers.FloatAmount(tx.Amount, tx.Currency),
		Currency: macanCurrency{Name: tx.Currency},
		PaymentMethod: macanPaymentMethod{Name: methodName},
		Bank: macanBank{Code: bankCode},
		Customer: macanPayOutCustomer{
			ID: customerID,
			Requisite: macanPayoutRequisite(tx.Order.PaymentMethodBrand, ps, info),
		},
		ExternalID:  tx.Id,
		CallbackURL: tx.CallbackURL,
	}
	headers := pp.authHeaders(secrets)
{{- else }}
{{ if and (eq .PaymentSource "card") .PayoutRequest -}}
	firstName, lastName := helpers.SplitCardHolder(card.OwnerInfo)
{{ end -}}
{{ if .PayoutRequest -}}
	req := &{{ .PayoutRequest.Name }}{
	{{- range .PayoutRequest.Fields }}
		{{ .GoName }}: {{ .GoExpr }},
	{{- end }}
	}
{{ else -}}
	req := &{{ .PayoutRequestType }}{
		// TODO: fill payout fields
	}
{{ end -}}
	_ = secrets
{{ if and (eq .PaymentSource "card") .PayoutRequest -}}
	_, _ = firstName, lastName
{{ end -}}
{{ if eq .PaymentSource "apm" -}}
	_ = info
{{ end -}}
	headers := httpcli.NewHeaders().Add("Content-Type", "application/json")
{{- end }}

	respBody, err := pp.httpClient.Post(tx, mc.ApiEndpoint+path, req, headers)
	if err != nil {
		if httpcli.IsBadRequestError(err) {
{{- template "declineBadRequestPayment" . }}
		}
		if httpcli.IsUnexpectedError(err) {
			return &model.PaymentResponse{
				Timestamp: time.Now(),
				Status:    tnxStatusPending,
				Code:      model.SCodeOk,
				Message:   providers.ProviderInternalErrNotFinal,
			}, nil
		}
		return nil, fmt.Errorf("calling %s payout: %w", ppSID, err)
	}

{{- if .UseTransfertyH2H }}
	var resp h2hPaymentResponse
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}
	out := &model.PaymentResponse{Timestamp: time.Now()}
	if resp.Code != 0 {
		out.Status, out.Code, out.Message = mapH2HResponseCode(resp.Code)
		if resp.Transaction.ID != "" {
			out.ForeignId = resp.Transaction.ID
		}
		return out, nil
	}
	out.ForeignId = resp.Transaction.ID
	out.Status, out.Code, out.Message = mapH2HTxnStatus(resp.Transaction.Status, resp.Transaction.StatusCode)
	return out, nil
{{- else if .UseMacanP2P }}
	var resp macanPayOutResponse
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}
	out := &model.PaymentResponse{Timestamp: time.Now(), ForeignId: resp.PayOut.ID}
	if resp.PayOut.ID == "" {
		out.Status = tnxStatusError
		out.Code = model.SCodeInternalError
		out.Message = model.SCodeInternalError.Description()
		return out, nil
	}
	out.Status, out.Code, out.Message = macanPayOutStatus(providerStatus(resp.PayOut.Status), resp.PayOut.StatusDetails)
	syncExchangedAmount(tx, resp.PayOut.Amount)
	return out, nil
{{- else }}
	var resp {{ .PayoutResponseType }}
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}

	return &model.PaymentResponse{
		Timestamp: time.Now(),
		Status:    tnxStatusPending,
		Code:      model.SCodeOk,
		ForeignId: resp.{{ .PayoutForeignIDField }},
	}, nil
{{- end }}
{{- else }}
	return nil, providers.ErrNotImplemented
{{- end }}
}

func (pp *{{ .StructName }}) CheckStatus(mc *model.MerchantCreds, tx *model.Transaction) (*model.StatusResponse, error) {
{{- if not .HasStatusEndpoints }}
	return nil, providers.ErrNotImplemented
{{- else if .UseMacanP2P }}
	if tx.ForeignId == "" {
		return nil, errors.New(providers.MessageMissingForeignID)
	}
	secrets, err := pp.parseProviderSecrets(mc, opStatus)
	if err != nil {
		return nil, err
	}
	base := {{ .PayinStatusEndpointConst }}
	if tx.Type != model.TnxTypePay {
		base = {{ .PayoutStatusEndpointConst }}
	}
	endpoint := mc.ApiEndpoint + base + "/" + url.PathEscape(tx.ForeignId)
	var status model.TnxStatus
	var code model.TnxStatusCode
	var msg string
	if tx.Type == model.TnxTypePay {
		var resp macanPayInResponse
		rawResp, respHeaders, respStatus, err := pp.httpClient.GetWithResponse(tx, endpoint, pp.authHeaders(secrets), &resp)
		if err != nil {
			if rawResp != nil {
				pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus,
					pp.httpClient.LogRawResponseDetails(rawResp, respHeaders))
			}
			return nil, fmt.Errorf("calling %s status: %w", ppSID, err)
		}
		status, code, msg = macanPayInStatus(providerStatus(resp.PayIn.Status), resp.PayIn.StatusDetails)
		syncExchangedAmount(tx, resp.PayIn.Amount)
	} else {
		var resp macanPayOutResponse
		rawResp, respHeaders, respStatus, err := pp.httpClient.GetWithResponse(tx, endpoint, pp.authHeaders(secrets), &resp)
		if err != nil {
			if rawResp != nil {
				pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus,
					pp.httpClient.LogRawResponseDetails(rawResp, respHeaders))
			}
			return nil, fmt.Errorf("calling %s status: %w", ppSID, err)
		}
		status, code, msg = macanPayOutStatus(providerStatus(resp.PayOut.Status), resp.PayOut.StatusDetails)
		syncExchangedAmount(tx, resp.PayOut.Amount)
	}
	return &model.StatusResponse{Status: status, Code: code, Message: msg}, nil
{{- else }}
{{- if and .CheckStatusThrottleConfig .CheckStatusThrottleConfig.Enabled }}
	if pp.isCheckStatusThrottled(tx.Id) {
		return &model.StatusResponse{Status: tnxStatusPending, Code: model.SCodeOk, Message: model.SCodeOk.Description()}, nil
	}
	pp.markCheckStatusCall(tx.Id)
{{- end }}
	if tx.ForeignId == "" {
		return nil, errors.New(providers.MessageMissingForeignID)
	}

	secrets, err := pp.parseProviderSecrets(mc, opStatus)
	if err != nil {
		return nil, err
	}
	_ = secrets

	var endpoint string
	if tx.Type == model.TnxTypePay {
		endpoint = mc.ApiEndpoint + {{ .PayinStatusEndpointConst }}
	} else {
		endpoint = mc.ApiEndpoint + {{ .PayoutStatusEndpointConst }}
	}

{{- if .UseBasicAuth }}
	respBody, err := pp.httpClient.Get(tx, endpoint, pp.authHeaders(secrets))
{{- else }}
	respBody, err := pp.httpClient.Get(tx, endpoint,
		httpcli.NewHeaders().Add("Content-Type", "application/json"))
{{- end }}
	if err != nil {
		return nil, fmt.Errorf("calling %s status: %w", ppSID, err)
	}
	_ = respBody

	// TODO: parse status response and call mapPayinStatus / mapPayoutStatus
	return nil, fmt.Errorf("%s: CheckStatus not fully implemented", ppSID)
{{- end }}
}

