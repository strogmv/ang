	v := r.world.Visitors
	visitorsRun(t, r, (v.OpenSecond-r.state.Life.Seconds%86400+86400)%86400, nil)
	r.state.Life.SecondsPerTick = 1
	last := map[int64]behavior.Cell{}
	seen, phases := 0, map[string]int{}
	visitorsRun(t, r, 1200, func() {
		if len(r.state.Visitors.Bodies) > v.MaxBodies {
			t.Fatalf("%d bodies, limit %d", len(r.state.Visitors.Bodies), v.MaxBodies)
		}
		now := map[int64]behavior.Cell{}
		for _, b := range r.state.Visitors.Bodies {
			// a step lands on a cell that is floor at that moment (a gate leaf may shut behind or under a walker later)
			if old, ok := last[b.Serial]; !ok || old != b.At {
				if !r.world.Life.Walks(v.Level, b.At) {
					t.Fatalf("visitor %d stepped off the floor to %v", b.Serial, b.At)
				}
				if ok && manhattan(location(old), location(b.At)) > 1 && !r.visitorLinked(old, b.At) {
					t.Fatalf("visitor %d jumped %v -> %v", b.Serial, old, b.At)
				}
			}
			now[b.Serial] = b.At
			phases[b.Phase]++
			seen++
		}
		last = now
	})
	if seen == 0 || phases["walk"] == 0 || phases["stand"] == 0 || phases["leave"] == 0 {
		t.Fatalf("twenty minutes after the opening: samples %d, phases %v", seen, phases)
	}
}

