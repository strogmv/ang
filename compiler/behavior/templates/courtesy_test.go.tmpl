func TestLifeCourtesyHostilityAndUnauthorizedRequesterRefuseStationaryPassage(t *testing.T) {
	for _, kind := range []string{"negative", "negative_with_positive_reverse", "wrong_control", "missing_control"} {
		t.Run(kind, func(t *testing.T) {
			m, s := courtesyFixture()
			switch kind {
			case "negative", "negative_with_positive_reverse":
				m.Actors[1].Relations[0].Strength = -.8
			case "wrong_control":
				s.ControlledActorID = "friend"
			case "missing_control":
				s.ControlledActorID = ""
			}
			if kind == "negative_with_positive_reverse" {
				m.Actors[0].Relations = []LifeRelation{{To: "friend", Strength: 1}}
			}
			before := s.Clone()
			authorized := kind != "wrong_control" && kind != "missing_control"
			if path, ok := s.MoveRoute(m, "hero", "hall", Cell{1, 2}, Cell{5, 2}, 0); ok != authorized || (authorized && len(path) != 4) {
				t.Fatalf("intent used a private relation or an unauthorized route: %v", path)
			}
			if s.yieldPopulationFor(m, "hall", Cell{3, 2}, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) {
				t.Fatal("hostile actor or unauthorized requester enlisted")
			}
			if !reflect.DeepEqual(before, s.Clone()) {
				t.Fatal("rejected courtesy changed state")
			}
		})
	}
}

func TestLifeCourtesyProtectsBusyNamedActors(t *testing.T) {
	for _, kind := range []string{"manual", "segment", "work", "service", "post", "maintenance", "workplace", "already_yielding", "aggressive", "hostile", "combat", "attacking"} {
		t.Run(kind, func(t *testing.T) {
			m, s := courtesyFixture()
			friend := s.Actor("friend")
			switch kind {
			case "manual":
				friend.Manual = true
			case "segment":
				friend.Path = []Cell{{3, 1}}
			case "workplace":
				m.Maintenance.Assets = []MaintenanceAsset{{Level: "hall", Workplaces: []Cell{friend.Position}}}
				s.Maintenance.Units = []MaintenanceUnit{{Crew: []string{"friend"}}}
			case "already_yielding":
				friend.YieldUntil = 3
			default:
				friend.Activity = kind
			}
			before := s.Clone()
			if _, ok := s.MoveRoute(m, "hero", "hall", Cell{1, 2}, Cell{5, 2}, 0); !ok {
