	r.DamageMax = 1
	a, b := combatClub("a", "blue", Cell{2, 2}), combatClub("b", "red", Cell{3, 2})
	a.Initiative = 30
	b.Initiative = 20
	a.Weapon.Kind = "blade"
	a.Weapon.Bleed = 4
	b.Medkits = 1
	s := combatNewAdvanced(t, r, space, a, b)
	combatDo(t, &s, space, r, "a", CombatAction{Type: "attack", TargetID: "b", BodyPart: "legs"})
