 for _,at:=range edge.WaitingCells{if at==a.Goal&&free(at){pocket,found=at,true;break}}
 if !found{
  // Stable ID hashing avoids making every arriving resident try pocket zero.
  start:=0;for _,r:=range a.ID{start=(start*31+int(r))%len(edge.WaitingCells)}
  for n:=range len(edge.WaitingCells){at:=edge.WaitingCells[(start+n)%len(edge.WaitingCells)];if free(at){pocket,found=at,true;break}}
 }
 if !found{populationUnreserve(claims,a.Level,a.Goal,a.ID);return a.Position,true}
 populationUnreserve(claims,a.Level,a.Goal,a.ID);populationReserve(claims,a.Level,pocket,a.ID)
