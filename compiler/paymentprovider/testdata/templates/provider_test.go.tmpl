func TestVerifyCallbackSignature(t *testing.T) {
	cb := &cbData{
		ID:            "23a76e55-7a84-4b22-a703-65c5e0fe5833",
		ExternalID:    "tnx-test-001",
		Status:        "customer_confirm",
		StatusDetails: "",
		Amount:        1000,
	}
{{- if .CallbackSignature }}
	sig := computeCallbackSignature(testMacanSigKey, cb)
	cb.{{ .CallbackSignature.SignatureField }} = sig
	assert.True(t, verifyCallbackSignature(testMacanSigKey, sig, cb))
	assert.False(t, verifyCallbackSignature(testMacanSigKey, "bad", cb))
{{- else }}
	sig := computeMacanCallbackSignature(testMacanSigKey, cb.Amount, cb.ID, cb.Status, cb.StatusDetails, cb.ExternalID)
	cb.Signature = sig
	assert.True(t, verifyMacanCallbackSignature(testMacanSigKey, sig, cb))
	assert.False(t, verifyMacanCallbackSignature(testMacanSigKey, "bad", cb))
{{- end }}
}

