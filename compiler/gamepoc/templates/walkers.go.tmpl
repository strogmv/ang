	dirs := []behavior.Cell{{X: 0, Y: -1}, {X: 1, Y: 0}, {X: 0, Y: 1}, {X: -1, Y: 0}}
	turn := int(b.Serial % 4)
	on := func(c behavior.Cell) bool {
		for _, a := range avoid {
			if a == c {
				return true
			}
		}
		return false
	}
	var first, then []behavior.Cell
	for i := range dirs {
		d := dirs[(i+turn)%4]
		c := behavior.Cell{X: b.At.X + d.X, Y: b.At.Y + d.Y}
		if on(c) {
			then = append(then, c)
		} else {
			first = append(first, c)
		}
	}
	return append(first, then...)
