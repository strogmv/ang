func stealthWire(t *testing.T, r *Runtime, c *connection, id, mode string) (*pb.PocActionResult, *pb.PocGameState) {
	t.Helper()
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_LifeCommand{LifeCommand: &pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: id, Action: "stealth", Destination: mode}}}})
	var result *pb.PocActionResult
	var state *pb.PocGameState
	for len(c.out) > 0 {
		m := <-c.out
		if a := m.GetActionResult(); a != nil && a.RequestId == id {
			result = a
		}
		if s := m.GetGameState(); s != nil {
			state = s
		}
	}
	if result == nil {
		t.Fatal("wire did not answer stealth intent")
	}
	return result, state
}

// Initial poses are arranged on actual, unoccupied hub floor. No successful
// detection, sound, injury, search route or NPC decision is injected.
func stealthFixture(t *testing.T) (*Runtime, *connection, string) {
	t.Helper()
	r, c, target := combatLifeFixture(t, true)
	h := r.state.Life.Actor(playerActorID)
	model := r.state.Life.GateModel(r.world.Life)
	blocked := r.state.Life.BlockedCells(h.Level, h.ID)
	found := false
	for y, row := range model.Locations[h.Level].Terrain {
		for x := range row {
			if found {
				break
			}
			at := behavior.Cell{X: x, Y: y}
			free := true
			for dy := -3; dy <= 3 && free; dy++ {
				for dx := -3; dx <= 3; dx++ {
					p := behavior.Cell{X: x + dx, Y: y + dy}
					if !model.Walks(h.Level, p) || blocked[p] {
						free = false
						break
					}
				}
			}
			if free {
				h.Position = at
				h.Goal = at
				found = true
			}
		}
		if found {
			break
		}
	}
	if !found {
		t.Fatal("no real open hub floor for movement fixture")
	}
	h.Body = nil
	h.Path = nil
	h.PendingPath = nil
	h.Manual = true
	h.Arrived = true
	r.state.Life.EnsureHeroBody(model)
	r.syncLifeHero()
	combatWorldPlace(t, r, target, playerActorID, 2500, 3500, true)
	r.world.Stealth.Watchers = map[string]stealthWatcher{}
	r.state.Stealth = stealthState{}
	// Step-1 tests isolate heading, geometry and noise under calibrated full light.
	// Step-2 tests below use the real lamp catalog and physical shadow rays.
	light := r.world.Illumination.Levels[h.Level]
	light.Emitters = nil
	light.AmbientLux = illuminationModes{Day: 100, Dusk: 100, Night: 100}
	r.world.Illumination.Levels[h.Level] = light
	return r, c, target
}
func stealthWatch(r *Runtime, id string, front, investigate bool) {
	h := r.state.Life.Actor(playerActorID)
	a := r.state.Life.Actor(id)
	x, y := r.stealthPlan(a.Level, a.Position)
	tx, ty := r.stealthPlan(h.Level, h.Position)
	dx, dy := tx-x, ty-y
	n := math.Hypot(dx, dy)
	if !front {
		n = -n
	}
	r.world.Stealth.Watchers[id] = stealthWatcher{FaceX: dx / n, FaceY: dy / n, InvestigateSteps: investigate}
}
func TestStealthQuietCommandChangesRealPaceAndCannotRunOrReplay(t *testing.T) {
	r, c, _ := stealthFixture(t)
	h := r.state.Life.Actor(playerActorID)
	r.state.Life.SecondsPerTick = 10
	initial := r.snapshotState()
	x0 := h.Body.X
	heroBodySteer(t, r, c, "steer", 1, 0)
	r.state.Life.HeroBodyAdvance(r.state.Life.GateModel(r.world.Life), h.Body.Clock+3000)
	normal := h.Body.X - x0
	r.state = initial
	h = r.state.Life.Actor(playerActorID)
	x0 = h.Body.X
	result, snapshot := stealthWire(t, r, c, "stealth.on", "on")
	if r.state.Life.SecondsPerTick != r.world.Stealth.FrameSeconds {
		t.Fatal("quiet mode kept coarse fast-forward sensing")
	}
	if !result.Ok || !h.Sneaking || snapshot.Life == nil || !snapshot.Life.Sneaking || snapshot.HeroBody == nil || !snapshot.HeroBody.Sneaking {
		t.Fatal("wire did not publish own quiet movement", result)
	}
	q := &pb.PocHeroSteer{Epoch: r.state.Epoch, InputSeq: 20000, Mode: "steer", X: 1, Run: true}
	r.heroSteer(c, q)
	answer := (<-c.out).GetMoveResult()
	if answer == nil || !answer.Ok || answer.HeroBody.Run {
		t.Fatal("quiet movement accepted a running body")
	}
	r.state.Life.HeroBodyAdvance(r.state.Life.GateModel(r.world.Life), h.Body.Clock+3000)
	quiet := h.Body.X - x0
	if math.Abs(quiet-normal*r.world.Stealth.SneakSpeed) > 1 || math.Abs(answer.HeroBody.WalkMmPerS/snapshot.HeroBody.WalkMmPerS-1) > .001 {
		t.Fatalf("physical/predicted pace mismatch normal=%f quiet=%f", normal, quiet)
	}
	before := r.snapshotState()
	result, _ = stealthWire(t, r, c, "stealth.on", "on")
	if !result.Ok || r.state.Life.Seconds != before.Life.Seconds || !reflect.DeepEqual(r.state.Stealth, before.Stealth) {
		t.Fatal("replayed mode changed simulation")
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_LifeCommand{LifeCommand: &pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: "stealth.fast", Action: "rate", SecondsPerTick: 30}}}})
	rejected := false
	for len(c.out) > 0 {
		if result := (<-c.out).GetActionResult(); result != nil && result.RequestId == "stealth.fast" {
			rejected = !result.Ok
		}
	}
	if !rejected || r.state.Life.SecondsPerTick != r.world.Stealth.FrameSeconds {
		t.Fatal("quiet movement bypassed normal sensing cadence")
	}
	r.state.Paused = true
	before = r.snapshotState()
	result, _ = stealthWire(t, r, c, "stealth.paused", "off")
	if result.Ok || !r.state.Life.Actor(playerActorID).Sneaking || !reflect.DeepEqual(before.Stealth, r.state.Stealth) {
		t.Fatal("pause rejection changed quiet movement")
	}
}

func TestStealthLegacyCellPaceMatchesItsWireDuration(t *testing.T) {
	r, c, _ := stealthFixture(t)
	h := r.state.Life.Actor(playerActorID)
	// Explicit legacy movement fixture: retain the actual floor and planner,
	// disable only the optional continuous body.
	r.world.Life.HeroBody.RadiusMM = 0
	h.Body = nil
	result, snapshot := stealthWire(t, r, c, "stealth.cells", "on")
	if !result.Ok {
		t.Fatal(result.Message)
	}
	pace := int64(math.Ceil(float64(r.world.Life.MoveTicks) / r.world.Stealth.SneakSpeed))
	if snapshot.MovementStepNs != r.lifeMotionDurationNS(pace) {
		t.Fatal("legacy interpolation disagrees with real quiet cadence")
	}
	start := h.Position
	target := behavior.Cell{X: start.X + 1, Y: start.Y}
	deck := int32(0)
	if v := r.deckVolume(); v != nil {
		if d, ok := v.SurfaceIndex(target); ok {
			deck = int32(d)
		}
	}
	r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 19000, X: int32(target.X), Y: int32(target.Y), Deck: deck})
	for len(c.out) > 0 {
		<-c.out
	}
	if len(h.Path) == 0 {
		t.Fatal("real cell route rejected")
	}
	for i := int64(0); i < pace; i++ {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
		if i < pace-1 && h.Position != start {
			t.Fatal("quiet grid hero moved before its paid cadence")
		}
	}
	if h.Position != target {
		t.Fatal("quiet grid movement did not execute at the configured pace")
	}
}
