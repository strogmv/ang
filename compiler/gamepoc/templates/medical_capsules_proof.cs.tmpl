   if(medicalReviewSamplesAtFrame<0||Time.frameCount-medicalReviewSamplesAtFrame>=3){medicalReviewSamplesAtFrame=Time.frameCount;medicalReviewSamples.Add(new MedicalReviewSample{frame=Time.frameCount,tick=state.Tick,epoch=state.Epoch,sampled_ns=sampled,paused=state.Paused,actors=actors.ToArray(),units=units.ToArray()});}
