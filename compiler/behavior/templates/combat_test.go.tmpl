	beforePlan := s.Decide(space, r)
	if beforePlan.Chosen.Action.Type != "attack" {
		t.Fatalf("fixture did not choose shot: %+v", beforePlan.Chosen)
	}
	space.ExecutionShotBlocked = func(Cell, Cell) bool { return true }
	afterPlan := s.Decide(space, r)
