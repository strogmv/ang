func TestLifeStructuralRouteCacheRejectsDisconnectedWithoutDrift(t *testing.T){
 m,s:=disconnectedLifeFixture();start:=s.Actors[0].Position
 s.Advance(m,1);cache:=s.routes
 if cache==nil||cache.connected("a",start,Cell{4,1}){t.Fatal("wall did not divide components")}
 for tick:=int64(2);tick<=60;tick++{s.Advance(m,tick);if err:=s.Validate(m,tick);err!=nil{t.Fatal(err)}}
 a:=s.Actor("one");if a.Position!=start||len(a.Path)!=0||a.Arrived||s.routes!=cache{t.Fatal("disconnected route drifted or rebuilt unchanged cache")}
 raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};if strings.Contains(string(raw),"components")||strings.Contains(string(raw),"routes"){t.Fatal("transient topology leaked into save")}
