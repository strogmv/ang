func illuminationFixture(t *testing.T) (*Runtime, *connection, illuminationLevel) {
	t.Helper()
	r, c, _ := combatLifeFixture(t, true)
	if !r.world.Illumination.Enabled {
		t.Skip("world has no authored physical illumination")
	}
	h := r.state.Life.Actor(playerActorID)
	l, ok := r.world.Illumination.Levels[h.Level]
	if !ok {
		t.Fatal("ordinary market lacks its authored illumination export")
	}
	return r, c, l
}
func illuminationFind(t *testing.T, c illuminationLevel, id string) illuminationEmitter {
	t.Helper()
	for _, e := range c.Emitters {
		if e.ID == id {
			return e
		}
	}
	t.Fatal("missing actual emitter", id)
	return illuminationEmitter{}
}
func illuminationClose(a, b float64) bool   { return math.Abs(a-b) < 1e-8 }
func illuminationMean(v [3]float64) float64 { return (v[0] + v[1] + v[2]) / 3 }

func TestIlluminationCalendarMatchesInstalledV13OpticalTransitions(t *testing.T) {
	_, _, c := illuminationFixture(t)
	if c.Calendar.DawnStart != 21600 || c.Calendar.DayStart != 25200 || c.Calendar.DayEnd != 75600 || c.Calendar.NightStart != 79200 || c.Calendar.FadeSeconds != 300 || c.Calendar.GuideExponent != 2.7 {
		t.Fatal("actual CUE calendar diverged from installed v13 optics")
	}
	// Reference values of DemoHubV13Bake.At at boundaries and the middle of the
	// twilight hour. This deliberately catches the old SDK's centred smoothstep,
	// which gives a different result from the installed hall bake.
	for _, q := range []struct {
		second int64
		want   illuminationWeights
	}{
		{0, illuminationWeights{Night: 1}},
		{21600, illuminationWeights{Dusk: .5, Night: .5}},
		{23400, illuminationWeights{Guide: .1538930516681145, Dusk: 1}},
		{25200, illuminationWeights{Guide: 1, Day: .5, Dusk: .5}},
		{43200, illuminationWeights{Guide: 1, Day: 1}},
		{75600, illuminationWeights{Guide: 1, Day: .5, Dusk: .5}},
		{77400, illuminationWeights{Guide: .1538930516681145, Dusk: 1}},
		{79200, illuminationWeights{Dusk: .5, Night: .5}},
		{84600, illuminationWeights{Night: 1}},
	} {
		got := c.Calendar.weights(q.second)
		if !illuminationClose(got.Guide, q.want.Guide) || !illuminationClose(got.Day, q.want.Day) || !illuminationClose(got.Dusk, q.want.Dusk) || !illuminationClose(got.Night, q.want.Night) || !illuminationClose(got.Day+got.Dusk+got.Night, 1) {
			t.Fatalf("time %d: got %+v want %+v", q.second, got, q.want)
		}
		if c.Calendar.weights(q.second+86400) != got {
			t.Fatal("optical calendar changed on next day")
		}
	}
}
func TestIlluminationActualCatalogKeepsEngineeringAndCommerceIdentities(t *testing.T) {
	r, _, c := illuminationFixture(t)
	expectedLeaves:=6;if r.world.CalendarEncounter!=nil{expectedLeaves++}
 if len(c.Emitters) != 209 || len(c.StaticOccluders) == 0 || len(c.GateLeaves) != expectedLeaves || len(c.PowerLinks) == 0 || len(c.PowerRefs) == 0 {
		t.Fatalf("physical market export missing: emitters=%d static=%d leaves=%d links=%d", len(c.Emitters), len(c.StaticOccluders), len(c.GateLeaves), len(c.PowerLinks))
	}
	seen := map[string]bool{}
	guides, vendingFaces, vendingScreens, backup, closed := 0, 0, 0, 0, 0
	noon := c.Calendar.weights(43200)
	for _, e := range c.Emitters {
		if seen[e.ID] || e.ID == "" || e.Lumens <= 0 {
			t.Fatal("duplicate, unnamed or empty physical emitter", e.ID)
		}
		seen[e.ID] = true
		if e.Daylight {
			guides++
			if e.PowerRef != "" || e.Kind != "light_guide" {
				t.Fatal("passive lightguide acquired electrical dependence")
			}
			if r.illuminationSourceFactor("level.c7_market", c, e, noon) != 1 {
				t.Fatal("dirty-adjusted guide lumens were multiplied by dirt again")
			}
		}
		if e.VendingID != "" {
			if strings.HasSuffix(e.ID, ".face") {
				vendingFaces++
				if e.Mode != (illuminationModes{Day: 1, Dusk: 1, Night: 1}) {
					t.Fatal("vending face would apply night dimming twice")
				}
			} else if strings.HasSuffix(e.ID, ".screen") {
				vendingScreens++
			}
		}
		if e.GateBackupPower {
			backup++
			if e.GateID == "" {
				t.Fatal("backup signal lacks an actual gate")
			}
		}
		if !e.InitialOn {
			closed++
			if len(e.StorefrontIDs) != 0 {
				t.Fatal("vacant lamp received a trading identity")
			}
		}
	}
	if guides != 31 || vendingFaces != 6 || vendingScreens != 6 || backup != 3 || closed != 7 {
		t.Fatalf("actual-source groups changed: guides%d vending%d/%d UPS%d vacant%d", guides, vendingFaces, vendingScreens, backup, closed)
	}
	g := illuminationFind(t, c, "src.lgc.r0.c0")
	if g.At != (behavior.DeckPointMM{X: 7250, Y: 10250, Z: 15950}) || g.Lumens != 5062 || g.GuideClean != .45 {
		t.Fatal("export changed original guide position/dirty flux", g)
	}

	// Diagnostic audit, not an assertion that conservative 500mm solids capture
	// every fixture aperture. Buried source mounts must be reported as authored
	// geometry limits; neither the original source nor the ray is adjusted here.
	v := c.rays
	if v == nil {
		t.Fatal("physical lighting ray volume not prepared")
	}
	boxes := r.illuminationBoxes(c)
	initialOn, clear := 0, 0
	var deckBlocked, additionalBlocked []string
	for _, e := range c.Emitters {
		if !e.InitialOn {
			continue
		}
		initialOn++
		if v.RayClearMM(e.At, e.At, boxes) {
			clear++
			continue
		}
		detail := fmt.Sprintf("%s kind=%s at=(%.0f,%.0f,%.0f)", e.ID, e.Kind, e.At.X, e.At.Y, e.At.Z)
		if !v.RayClearMM(e.At, e.At, nil) {
			deckBlocked = append(deckBlocked, detail)
		} else {
			additionalBlocked = append(additionalBlocked, detail)
		}
	}
	t.Logf("source mounting audit: initial_on=%d clear=%d blocked=%d deck_blocked=%d additional_blocked=%d", initialOn, clear, initialOn-clear, len(deckBlocked), len(additionalBlocked))
	for _, id := range deckBlocked {
		t.Log("source inside conservative deck solid:", id)
	}
	for _, id := range additionalBlocked {
		t.Log("source inside authored static/gate box:", id)
	}
	for id, shop := range map[string]string{"src.lum.pl.C1-n2-3": "tenant11", "src.lum.pl.G1": "tenant33"} {
		e := illuminationFind(t, c, id)
		if !reflect.DeepEqual(e.StorefrontIDs, []string{shop}) {
			t.Fatal("place ID was not joined to the existing shop", id, e.StorefrontIDs)
		}
	}
}

// Keep one existing guide and every real geometric occluder. Only the initial
// source-isolation fixture changes; no lux/visibility or ray result is assigned.
func illuminationGuideFloor(t *testing.T, r *Runtime, c illuminationLevel) illuminationEmitter {
	t.Helper()
	h := r.state.Life.Actor(playerActorID)
	model := r.state.Life.GateModel(r.world.Life)
	v := r.world.Decks[h.Level]
	block := r.state.Life.BlockedCells(h.Level, h.ID)
	c.AmbientLux = illuminationModes{}
	r.state.Life.Seconds = 43200
	for _, e := range c.Emitters {
		if !e.Daylight || e.Distribution != "lambert_down" {
			continue
		}
		candidate := c
		candidate.Emitters = []illuminationEmitter{e}
		r.world.Illumination.Levels[h.Level] = candidate
		for y, row := range model.Locations[h.Level].Terrain {
			for x := range row {
				at := behavior.Cell{X: x, Y: y}
				if !model.Walks(h.Level, at) || block[at] {
					continue
				}
				p, _, surface, ok := v.Locate(at)
				if !ok || surface < 0 || surface >= len(v.Surfaces) || v.Surfaces[surface].ID != "hub.floor" || math.Hypot((float64(p.X)+.5)*500-e.At.X, (float64(p.Y)+.5)*500-e.At.Y) > 5000 {
					continue
				}
				h.Position = at
				h.Goal = at
				h.Body = nil
				h.Path = nil
				h.PendingPath = nil
				h.Trip = nil
				h.ResidenceID = ""
				h.Manual = true
				h.Arrived = true
				r.state.Life.EnsureHeroBody(model)
				r.syncLifeHero()
				s := r.illuminationBody(h)
				if s.Known && illuminationMean(s.Lux) > 1 {
					return e
				}
			}
		}
	}
	t.Fatal("every actual ceiling guide is buried/blocked at real accessible floor; do not weaken the physical ray")
	return illuminationEmitter{}
}
func TestIlluminationActualGuideReachesFloorAndCastsPhysicalShadow(t *testing.T) {
	r, _, c := illuminationFixture(t)
	e := illuminationGuideFloor(t, r, c)
	h := r.state.Life.Actor(playerActorID)
	c = r.world.Illumination.Levels[h.Level]
	lit := r.illuminationBody(h)
	r.state.Life.Seconds = 84600
	night := r.illuminationBody(h)
	if !lit.Known || !night.Known || illuminationMean(lit.Lux) <= illuminationMean(night.Lux)+1 || illuminationMean(lit.Factor) <= illuminationMean(night.Factor) {
		t.Fatal("real guide did not change physical exposure with game time", lit, night)
	}
	r.state.Life.Seconds = 43200
	points := r.world.Decks[h.Level].BodyLightPoints(h.Position, behavior.Combatant{})
	for i := range points {
		points[i].X = h.Body.X
		points[i].Y = h.Body.Y
	}
	midpoint := behavior.DeckPointMM{X: (e.At.X + points[1].X) / 2, Y: (e.At.Y + points[1].Y) / 2}
	// Explicit initial geometry variant: a closed opaque shield intersects the
	// actual three light segments halfway. Source and body stay at the same poses.
	shadow := behavior.DeckRayBox{Min: behavior.DeckPointMM{X: midpoint.X - 100, Y: midpoint.Y - 100, Z: (e.At.Z+points[0].Z)/2 - 100}, Max: behavior.DeckPointMM{X: midpoint.X + 100, Y: midpoint.Y + 100, Z: (e.At.Z+points[2].Z)/2 + 100}}
	c.StaticOccluders = append(append([]behavior.DeckRayBox(nil), c.StaticOccluders...), shadow)
	r.world.Illumination.Levels[h.Level] = c
	blocked := r.illuminationBody(h)
	if !blocked.Known || illuminationMean(blocked.Lux) > 1e-8 || illuminationMean(blocked.Lux) >= illuminationMean(lit.Lux) || illuminationMean(blocked.Factor) < c.MinVisibility {
		t.Fatal("opaque physical shield failed or created unconditional invisibility", lit, blocked)
	}
}
func TestIlluminationAncestorPowerCutPersistsWithoutAffectingOtherFeeds(t *testing.T) {
	r, _, c := illuminationFixture(t)
	r.world.Config.DebugPerception = true
	h := r.state.Life.Actor(playerActorID)
	w := c.Calendar.weights(r.state.Life.Seconds)
	accent := illuminationFind(t, c, "src.accent.pk_w1")
	if r.illuminationSourceFactor(h.Level, c, accent, w) <= 0 {
		t.Fatal("existing 24-hour accent starts unpowered")
	}
	guide := illuminationFind(t, c, "src.lgc.r0.c0")
	day := c.Calendar.weights(43200)
	if err := r.illuminationCommand("illumination_power_off", "board.shr_z"); err != nil {
		t.Fatal(err)
	}
	if accent.PowerRef == "board.shr_z" || r.illuminationSourceFactor(h.Level, c, accent, w) != 0 {
		t.Fatal("cutting ancestor failed to reach dependent lamp", accent.PowerRef)
	}
	if r.illuminationSourceFactor(h.Level, c, guide, day) != 1 {
		t.Fatal("electrical failure extinguished passive guide")
	}
	gallery := illuminationFind(t, c, "src.lum.gal.stack.w.up1.0")
	if r.illuminationSourceFactor(h.Level, c, gallery, c.Calendar.weights(77400)) <= 0 {
		t.Fatal("one failed board disabled a separately-fed gallery")
	}
	before := r.snapshotState()
	cloned := before.Illumination.Clone()
	delete(cloned.Off[h.Level], "board.shr_z")
	if !r.state.Illumination.Off[h.Level]["board.shr_z"] {
		t.Fatal("snapshot clone shares mutable failed feeds")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, before); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(before.Illumination, loaded.Illumination) {
		t.Fatal("save lost real electrical failure")
	}
	r.state = loaded
	if r.illuminationSourceFactor(h.Level, c, accent, w) != 0 {
		t.Fatal("loading re-energized failed ancestor")
	}
	if err := r.illuminationCommand("illumination_power_on", "board.shr_z"); err != nil {
		t.Fatal(err)
	}
	if r.illuminationSourceFactor(h.Level, c, accent, w) <= 0 {
		t.Fatal("restored actual feed did not restore its lamp")
	}
	stable := r.snapshotState()
	if r.illuminationCommand("illumination_power_off", "made.up.feed") == nil || !reflect.DeepEqual(stable.Illumination, r.state.Illumination) {
		t.Fatal("unknown-feed command changed electrical state")
	}
	bad := r.snapshotState()
	bad.Illumination = bad.Illumination.Clone()
	if bad.Illumination.Off[h.Level] == nil {
		bad.Illumination.Off[h.Level] = map[string]bool{}
	}
	bad.Illumination.Off[h.Level]["made.up.feed"] = true
	if r.validateIllumination(bad) == nil {
		t.Fatal("forged failed-feed save accepted")
	}
}
func TestIlluminationStorefrontUsesActualMerchantServiceAndSafety(t *testing.T) {
	r, _, c := illuminationFixture(t)
	h := r.state.Life.Actor(playerActorID)
	e := illuminationFind(t, c, "src.lum.pl.G1")
	shopID := e.StorefrontIDs[0]
	var owner *behavior.LifeActor
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.ID != shopID {
			continue
		}
		owner = r.state.Life.Actor(sh.Owner)
		if owner == nil {
			t.Fatal("authored shop lacks existing proprietor")
		}
		owner.Level = sh.Service.Level
		owner.Position = behavior.Cell{X: sh.Service.At.X, Y: sh.Service.At.Y}
		owner.Goal = owner.Position
		owner.Trip = nil
		owner.ResidenceID = ""
		owner.Path = nil
		owner.PendingPath = nil
		owner.Manual = false
		owner.Arrived = true
		owner.CombatHold = false
		owner.Safety = nil
		owner.Brain.BreakKind = ""
		r.state.Life.Seconds = (sh.OpenSecond + sh.CloseSecond) / 2
		break
	}
	if owner == nil {
		t.Fatal("actual shop binding absent")
	}
	if err := r.advanceMarketSupply(); err != nil {
		t.Fatal(err)
	}
	w := c.Calendar.weights(r.state.Life.Seconds)
	if !r.storefrontOpen(shopID) || r.illuminationSourceFactor(h.Level, c, e, w) <= 0 {
		t.Fatal("present working proprietor did not open its real lamp")
	}
	model := r.state.Life.GateModel(r.world.Life)
	blocked := r.state.Life.BlockedCells(owner.Level, owner.ID)
	goal := owner.Position
	for _, at := range model.StepNeighbours(owner.Level, owner.Position) {
		if model.Walks(owner.Level, at) && !blocked[at] {
			goal = at
			break
		}
	}
	if goal == owner.Position {
		t.Fatal("actual proprietor has no physical exit route")
	}
	at := owner.Position
	if err := r.state.Life.ApplySafety(model, owner.ID, behavior.LifeSafetyOverride{Level: owner.Level, Goal: goal, ThreatAt: h.Position, Until: r.state.Life.Seconds + 45, LabelKey: "life.combat.seek_safety", Activity: "shelter", Reason: "explicit local-danger test input"}); err != nil {
		t.Fatal(err)
	}
	if err := r.advanceMarketSupply(); err != nil {
		t.Fatal(err)
	}
	if owner.Position != at || r.storefrontOpen(shopID) || r.illuminationSourceFactor(h.Level, c, e, w) != 0 {
		t.Fatal("interrupted merchant lamp followed market hours or teleported owner")
	}
}
func TestIlluminationVendingUsesRealPresencePPMExactlyOnce(t *testing.T) {
	r, connection, c := illuminationFixture(t)
	h := r.state.Life.Actor(playerActorID)
	r.state.Life.Seconds = 84600
	w := c.Calendar.weights(r.state.Life.Seconds)
	var face, screen illuminationEmitter
	unitIndex := -1
	for i, u := range r.world.Vending.Units {
		occupied := false
		for _, p := range u.Approach {
			at := behavior.Cell{X: p.X, Y: p.Y}
			for _, a := range r.state.Life.Actors {
				if a.Level == r.world.Vending.Level && a.OnFloor() && a.Position == at {
					occupied = true
				}
			}
			for _, a := range r.state.Life.Population.Actors {
				if a.Level == r.world.Vending.Level && a.Trip == nil && a.Position == at {
					occupied = true
				}
			}
		}
		if occupied || len(u.Approach) == 0 {
			continue
		}
		unitIndex = i
		face = illuminationFind(t, c, "src.vm."+u.ID+".face")
		screen = illuminationFind(t, c, "src.vm."+u.ID+".screen")
		break
	}
	if unitIndex < 0 {
		t.Fatal("initial real terminal fixture has no unoccupied panel")
	}
	u := r.world.Vending.Units[unitIndex]
	low := r.illuminationSourceFactor(h.Level, c, face, w)
	if !illuminationClose(low, float64(r.world.Vending.Light.NightPPM)/1e6) || r.illuminationSourceFactor(h.Level, c, screen, w) != 1 {
		t.Fatal("unoccupied night panel double-dimmed or dimmed its independent screen", low)
	}
	// Existing hero is initially posed at the actual unoccupied approach. The
	// normal occupancy sensor, not a fabricated Occupied/LampPpm, determines light.
	h.Level = r.world.Vending.Level
	h.Position = behavior.Cell{X: u.Approach[0].X, Y: u.Approach[0].Y}
	h.Goal = h.Position
	h.Path = nil
	h.PendingPath = nil
	h.Body = nil
	h.Trip = nil
	h.ResidenceID = ""
	h.Manual = true
	h.Arrived = true
	r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
	r.syncLifeHero()
	r.updateLifeExploration()
	full := r.illuminationSourceFactor(h.Level, c, face, w)
	if !illuminationClose(full, float64(r.world.Vending.Light.SensorPPM)/1e6) || full <= low || r.illuminationSourceFactor(h.Level, c, screen, w) != 1 {
		t.Fatal("actual approach failed to activate physical sensor once", low, full)
	}
	r.sendState(connection)
	var snapshot *pb.PocGameState
	for len(connection.out) > 0 {
		if game := (<-connection.out).GetGameState(); game != nil {
			snapshot = game
		}
	}
	if snapshot == nil || snapshot.Life == nil {
		t.Fatal("actual presence lacks ordinary snapshot")
	}
	for _, vm := range snapshot.Life.Vending {
		if vm.Id == u.ID {
			if !vm.Occupied || !illuminationClose(float64(vm.LampPpm)/1e6, full) {
				t.Fatal("physical lamp factor differs from authoritative public terminal sensor")
			}
			return
		}
	}
	t.Fatal("ordinary snapshot omitted actual terminal")
}
