// craftingBench: the nearest workplace within reach of the hero; usable while its owner stands at the own counter.
func (r *Runtime) craftingBench(hero *behavior.LifeActor) crafting.Bench {
	best, bestD := crafting.Bench{}, 1<<30
	if hero == nil {
		return best
	}
	for _, s := range r.world.Crafting.Stations {
		if s.Level != hero.Level || !craftingNear(hero.Position, s.At, s.Reach) {
			continue
		}
		d := (hero.Position.X-s.At.X)*(hero.Position.X-s.At.X) + (hero.Position.Y-s.At.Y)*(hero.Position.Y-s.At.Y)
		if d < bestD {
			best, bestD = crafting.Bench{Station: s.ID, Present: s.Owner == "" || r.storefrontOpen(s.Shop)}, d
		}
	}
	return best
}

// craftingCounter: the master at whose counter the hero stands.
func (r *Runtime) craftingCounter(hero *behavior.LifeActor) (crafting.Master, bool) {
	if hero == nil {
		return crafting.Master{}, false
	}
	for _, ms := range r.world.Crafting.Masters {
		if ms.Level == hero.Level && craftingNear(hero.Position, ms.Approach, ms.Reach) {
			return ms, true
		}
	}
	return crafting.Master{}, false
}
