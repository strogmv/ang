func TestLifeInterruptedDetourKeepsItsRouteAcrossShortWaitAndSave(t *testing.T) {
	m, _ := courtesyFixture()
	m.Locations["hall"] = LifeLocation{Name: "Hall", Terrain: []string{".........", ".........", ".........", ".........", "........."}}
	m.Actors[1].Steps[0].At = Cell{2, 0}
	s := m.Start()
	s.ControlledActorID = "hero"
	hero, other := s.Actor("hero"), s.Actor("friend")
	hero.Manual, hero.Arrived, hero.Goal = true, false, Cell{7, 2}
	hero.Path = []Cell{{2, 2}, {2, 1}, {3, 1}, {4, 1}, {5, 1}, {6, 1}, {7, 1}, {7, 2}}
	other.Position, other.Goal, other.Arrived, other.Activity = Cell{2, 1}, Cell{2, 0}, false, "walking"
	other.Path = []Cell{{2, 0}}
	// The hero's accepted segment is already one tick ahead of the crossing
	// segment. At tick3 the body still blocks; it physically clears at tick4.
	s.Tick, s.Seconds, other.MoveStartTick = 1, 1, 1
	for tick := int64(2); tick <= 3; tick++ {
		courtesyAdvance(t, m, &s, tick)
	}
	want := []Cell{{2, 1}, {3, 1}, {4, 1}, {5, 1}, {6, 1}, {7, 1}, {7, 2}}
	if !reflect.DeepEqual(s.Actor("hero").PendingPath, want) || len(s.Actor("hero").Path) != 0 {
		t.Fatal("short crossing discarded or reserved the blocked detour")
	}
	clone := s.Clone()
	clone.Actor("hero").PendingPath[0] = Cell{8, 4}
	if s.Actor("hero").PendingPath[0] != want[0] || clone.Validate(m, 3) == nil {
		t.Fatal("pending route clone aliases state or accepts a non-neighbour jump")
	}
	raw, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var restored LifeState
	if err = json.Unmarshal(raw, &restored); err != nil {
		t.Fatal(err)
	}
	if err = restored.Validate(m, 3); err != nil {
		t.Fatal(err)
	}
	for tick := int64(4); tick <= 48; tick++ {
		courtesyAdvance(t, m, &s, tick)
		courtesyAdvance(t, m, &restored, tick)
		if tick == 4 && !reflect.DeepEqual(s.Actor("hero").Path, want) {
			t.Fatal("resume forgot the selected detour and restarted the global route")
		}
	}
	if !reflect.DeepEqual(s.Clone(), restored.Clone()) || s.Actor("hero").Position != (Cell{7, 2}) || len(s.Actor("hero").PendingPath) != 0 {
		t.Fatal("saved wait did not complete the same accepted goal")
	}
}

func navigationKnowledgeFixture() (LifeModel, LifeState) {
	m, _ := courtesyFixture()
	m.Locations["hall"] = LifeLocation{Name: "Hall", InitialLayoutKnown: true, Terrain: []string{
		"#########", "######.##", "#.......#", "#########", "#########",
	}}
	m.Actors[1].ID, m.Actors[1].Name = "hidden", "Hidden NPC"
	m.Actors[1].Steps[0].At = Cell{6, 2}
	m.Actors[1].Relations = []LifeRelation{{To: "hero", Strength: -.5}}
	s := m.Start()
	s.ControlledActorID = "hero"
	return m, s
}

func navigationKnowledgeIntent(t *testing.T, m LifeModel, s *LifeState, from, target Cell) ([]Cell, bool) {
	t.Helper()
	before := s.Clone()
	path, allowed := s.MoveRoute(m, "hero", "hall", from, target, s.Tick)
	if !reflect.DeepEqual(before, s.Clone()) {
		t.Fatal("admission mutated hidden actors, relations or existing motion")
	}
	previous := from
	for _, at := range path {
		if Distance(previous, at) != 1 || !m.Walks("hall", at) {
			t.Fatalf("intent crossed solid geometry or skipped a step: %v", path)
		}
		previous = at
	}
	return path, allowed
}

func navigationKnowledgeAccept(t *testing.T, m LifeModel, s *LifeState, target Cell) {
	t.Helper()
	hero := s.Actor("hero")
	path, allowed := navigationKnowledgeIntent(t, m, s, hero.Position, target)
	if !allowed {
		t.Fatal("known connected geometry rejected the movement intent")
	}
	hero.Manual, hero.Arrived, hero.Goal, hero.Path = true, false, target, path
	hero.Activity, hero.MoveStartTick = "walking", s.Tick
}

func TestLifeKnownRouteDoesNotRevealDistantNamedBodiesOrAttitudes(t *testing.T) {
	want := []Cell{{2, 2}, {3, 2}, {4, 2}, {5, 2}, {6, 2}, {7, 2}}
	for _, kind := range []string{"off_route", "neutral", "hostile", "friendly", "busy_work", "sleeping", "passing", "hostile_override", "friendly_override", "occupied_target"} {
		t.Run(kind, func(t *testing.T) {
			m, s := navigationKnowledgeFixture()
			a := s.Actor("hidden")
			switch kind {
			case "off_route":
				a.Position, a.Goal = Cell{6, 1}, Cell{6, 1}
			case "neutral":
				m.Actors[1].Relations = nil
			case "friendly":
				m.Actors[1].Relations[0].Strength = .8
			case "busy_work":
				a.Activity = "work"
			case "sleeping":
				a.Activity = "sleep"
			case "passing":
				a.Arrived, a.Activity, a.Goal, a.Path = false, "walking", Cell{6, 1}, []Cell{{6, 1}}
			case "hostile_override":
				if err := s.SetRelation("hidden", "hero", -1); err != nil {
					t.Fatal(err)
				}
			case "friendly_override":
				if err := s.SetRelation("hidden", "hero", 1); err != nil {
					t.Fatal(err)
				}
			case "occupied_target":
				a.Position, a.Goal = Cell{7, 2}, Cell{7, 2}
			}
			if s.courtesyAware(m, "hero", "hall", a.Position) {
				t.Fatal("test actor is locally visible rather than distant")
			}
			path, allowed := navigationKnowledgeIntent(t, m, &s, Cell{1, 2}, Cell{7, 2})
			if !allowed || !reflect.DeepEqual(path, want) {
				t.Fatalf("hidden %s leaked into intent acceptance/future path: allowed=%v path=%v want=%v", kind, allowed, path, want)
			}
		})
	}
}

func TestLifeKnownRouteDoesNotRevealDistantPopulationOrRelations(t *testing.T) {
	for _, kind := range []string{"neutral", "hostile", "friendly", "busy_work", "sleeping", "passing"} {
		t.Run(kind, func(t *testing.T) {
			m, _ := navigationKnowledgeFixture()
			m.Actors = m.Actors[:1]
			m.Population = PopulationModel{
				MaxActors: 1, MaxActive: 1, MoveTicks: 3, ColdStepSeconds: 10,
				ShiftOffsets: []int64{0}, Stages: []PopulationStage{{ID: "market", Level: "hall", Activity: "market", AtSecond: 0}},
				Anchors: map[string][]Cell{"hall": {{6, 2}, {6, 1}}},
			}
			s, err := m.StartWithPopulation(1, "hero")
			if err != nil {
				t.Fatal(err)
			}
			a := &s.Population.Actors[0]
			if !a.Materialized {
				t.Fatal("test crowd actor must have a real physical body")
			}
			a.Position, a.Goal, a.Path, a.Arrived, a.Activity = Cell{6, 2}, Cell{6, 2}, nil, true, "market"
			switch kind {
			case "hostile", "friendly":
				value := -.8
				if kind == "friendly" {
					value = .8
				}
				if err := s.SetRelation(a.ID, "hero", value); err != nil {
					t.Fatal(err)
				}
			case "busy_work":
				a.Activity = "work"
			case "sleeping":
				a.Activity = "sleep"
			case "passing":
				a.Arrived, a.Activity, a.Goal, a.Path = false, "walking", Cell{6, 1}, []Cell{{6, 1}}
			}
			path, allowed := navigationKnowledgeIntent(t, m, &s, Cell{1, 2}, Cell{7, 2})
			want := []Cell{{2, 2}, {3, 2}, {4, 2}, {5, 2}, {6, 2}, {7, 2}}
			if !allowed || !reflect.DeepEqual(path, want) {
				t.Fatalf("hidden population %s leaked into the known route: %v %v", kind, allowed, path)
			}
		})
	}
}

func TestLifeOccupiedImmediateStepAcceptsWaitIntentWithoutMovingBody(t *testing.T) {
	for _, strength := range []float64{-1, 0, 1} {
		m, s := navigationKnowledgeFixture()
		a := s.Actor("hidden")
		a.Position, a.Goal, a.Activity = Cell{2, 2}, Cell{2, 2}, "work"
		m.Actors[1].Relations[0].Strength = strength
		path, allowed := navigationKnowledgeIntent(t, m, &s, Cell{1, 2}, Cell{7, 2})
		if !allowed || len(path) != 0 || a.Position != (Cell{2, 2}) || len(a.Path) != 0 {
			t.Fatalf("occupied first step must accept a stationary wait intent: strength=%v allowed=%v path=%v", strength, allowed, path)
		}
	}
}

func TestLifeHiddenHostileStopsAtContactAndLocalFriendshipResumesSameGoal(t *testing.T) {
	m, s := navigationKnowledgeFixture()
	goal := Cell{7, 2}
	navigationKnowledgeAccept(t, m, &s, goal)
	for tick := int64(1); tick <= 30; tick++ {
		courtesyAdvance(t, m, &s, tick)
		hero, blocker := s.Actor("hero"), s.Actor("hidden")
		if !hero.Manual || hero.Goal != goal || blocker.Position != (Cell{6, 2}) || blocker.YieldUntil != 0 {
			t.Fatal("contact cancelled the command or displaced an unwilling blocker")
		}
	}
	hero := s.Actor("hero")
	if hero.Position != (Cell{5, 2}) || hero.Arrived || Distance(hero.Position, s.Actor("hidden").Position) != 1 {
		t.Fatalf("hero did not stop at actual hostile contact: %+v", hero)
	}
	if err := s.SetRelation("hidden", "hero", .7); err != nil {
		t.Fatal(err)
	}
	// No second command, no new route from the caller, no body/goal edits.
	for tick := int64(31); tick <= 90; tick++ {
		courtesyAdvance(t, m, &s, tick)
		if s.Actor("hero").Goal != goal || !s.Actor("hero").Manual {
			t.Fatal("local relation change replaced the accepted command")
		}
	}
	if hero.Position != goal || !hero.Arrived || len(hero.Path) != 0 || s.Actor("hidden").YieldUntil == 0 {
		t.Fatalf("same accepted goal did not resume after local friendship: hero=%+v hidden=%+v", hero, s.Actor("hidden"))
	}
}

func TestLifeDepartingHiddenBodyDoesNotRequireAnotherClick(t *testing.T) {
	for _, departureTick := range []int64{6, 30} {
		m, s := navigationKnowledgeFixture()
		m.Locations["off"] = LifeLocation{Name: "Elsewhere", Terrain: []string{"###", "#.#", "###"}}
		m.Edges = []LifeEdge{{ID: "depart", From: "hall", To: "off", Exit: Cell{6, 2}, Entry: Cell{1, 1}, Mode: "walk", TravelSeconds: 200, Seats: 1}}
		goal := Cell{7, 2}
		navigationKnowledgeAccept(t, m, &s, goal)
		for tick := int64(1); tick <= departureTick; tick++ {
			courtesyAdvance(t, m, &s, tick)
		}
		if departureTick == 6 && s.courtesyAware(m, "hero", "hall", Cell{6, 2}) {
			t.Fatal("early removal must happen while the actor is still distant")
		}
		blocker := s.Actor("hidden")
		// A real departure removes this body from local occupancy without deleting
		// its identity or moving its position through the hero. Arrival stays later.
		blocker.Trip = &LifeTrip{Edge: "depart", Departure: s.Seconds, Arrival: s.Seconds + 200}
		blocker.Activity = "transit"
		for tick := departureTick + 1; tick <= 80; tick++ {
			courtesyAdvance(t, m, &s, tick)
			if s.Actor("hero").Goal != goal || !s.Actor("hero").Manual {
				t.Fatal("departing blocker discarded the durable goal")
			}
		}
		if s.Actor("hero").Position != goal || !s.Actor("hero").Arrived || blocker.Trip == nil {
			t.Fatalf("departure at tick %d did not release original command: hero=%+v", departureTick, s.Actor("hero"))
		}
	}
}

func TestLifeVisibleProtectedBlockerAllowsPhysicalLocalDetour(t *testing.T) {
	m, _ := navigationKnowledgeFixture()
	m.Locations["hall"] = LifeLocation{Name: "Hall", InitialLayoutKnown: true, Terrain: []string{
		"#########", "#########", "#.......#", "###...###", "#########",
	}}
	m.Actors[1].Steps[0].At, m.Actors[1].Steps[0].Activity = Cell{4, 2}, "work"
	s := m.Start()
	s.ControlledActorID = "hero"
	goal := Cell{7, 2}
	navigationKnowledgeAccept(t, m, &s, goal)
	detoured := false
	for tick := int64(1); tick <= 90; tick++ {
		courtesyAdvance(t, m, &s, tick)
		hero, blocker := s.Actor("hero"), s.Actor("hidden")
		detoured = detoured || hero.Position.Y == 3
		if hero.Goal != goal || !hero.Manual || blocker.Position != (Cell{4, 2}) || blocker.Activity != "work" || blocker.YieldUntil != 0 {
			t.Fatal("detour displaced a working actor or replaced the hero's command")
		}
	}
	if !detoured || s.Actor("hero").Position != goal || !s.Actor("hero").Arrived {
		t.Fatalf("visible busy body prevented a free local detour: detoured=%v hero=%+v", detoured, s.Actor("hero"))
	}
}

func TestLifeRedirectFromCommittedCellDoesNotRevealHiddenCornerBody(t *testing.T) {
	want := []Cell{{2, 1}, {3, 1}, {4, 1}, {5, 1}}
	for _, strength := range []float64{-1, 0, 1} {
		m, _ := navigationKnowledgeFixture()
		m.Locations["hall"] = LifeLocation{Name: "Hall", InitialLayoutKnown: true, Terrain: []string{
			"#######", "##....#", "##.####", "##.####", "#######",
		}}
		m.Actors[0].Steps[0].At, m.Actors[1].Steps[0].At = Cell{2, 3}, Cell{3, 1}
		m.Actors[1].Relations[0].Strength = strength
		s := m.Start()
		s.ControlledActorID = "hero"
		hero := s.Actor("hero")
		hero.Manual, hero.Arrived, hero.Goal, hero.Path, hero.Activity = true, false, Cell{2, 1}, []Cell{{2, 2}}, "walking"
		if s.courtesyAware(m, "hero", "hall", Cell{3, 1}) {
			t.Fatal("body around the closed corner is not known from the real position")
		}
		path, allowed := navigationKnowledgeIntent(t, m, &s, hero.Path[0], Cell{5, 1})
		if !allowed || !reflect.DeepEqual(path, want) || len(hero.Path) != 1 || hero.Path[0] != (Cell{2, 2}) {
			t.Fatalf("redirect leaked the hidden corner body or changed commitment: relation=%v path=%v", strength, path)
		}
		// The ordinary host keeps the already accepted neighboring segment before
		// the newly admitted intent. Its physical cadence must remain intact.
		hero.Path, hero.Goal = append([]Cell{{2, 2}}, path...), Cell{5, 1}
		for tick := int64(1); tick < m.MoveTicks; tick++ {
			courtesyAdvance(t, m, &s, tick)
			if hero.Position != (Cell{2, 3}) || len(hero.Path) == 0 || hero.Path[0] != (Cell{2, 2}) {
				t.Fatal("redirect interrupted or accelerated the committed segment")
			}
		}
		courtesyAdvance(t, m, &s, m.MoveTicks)
		if hero.Position != (Cell{2, 2}) || hero.Goal != (Cell{5, 1}) {
			t.Fatal("redirect did not finish its original committed step")
		}
	}
}

func TestLifeKnownIntentStillRejectsWallsAndDisconnectedGeometry(t *testing.T) {
	for _, strength := range []float64{-1, 0, 1} {
		m, s := navigationKnowledgeFixture()
		m.Actors[1].Relations[0].Strength = strength
		location := m.Locations["hall"]
		location.Terrain[0] = "#.#######" // Known floor, isolated by solid cells.
		m.Locations["hall"] = location
		for _, target := range []Cell{{0, 2}, {8, 2}, {-1, 2}, {9, 2}, {1, 0}} {
			if path, allowed := navigationKnowledgeIntent(t, m, &s, Cell{1, 2}, target); allowed || len(path) != 0 {
				t.Fatalf("known wall/disconnected target admitted: target=%v attitude=%v path=%v", target, strength, path)
			}
		}
	}
}
