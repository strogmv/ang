    run=null;var beat=new CombatBeat{kind=e.Type,actor=e.ActorId,target=e.TargetId,from=from,to=to,hit=e.Hit,amount=e.Amount,part=e.BodyPart,item=e.ItemId,valid=!string.IsNullOrEmpty(e.ActorId)};
