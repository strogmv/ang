			return err
		}
		if err := r.validateBarksSave(s); err != nil {
			return err
		}
		if err := r.validateCommerceSave(s); err != nil {
			return err
		}
		if err := r.validatePeddlerSave(s); err != nil {
			return err
		}
		if err := r.validateVisitorSave(s); err != nil {
			return err
		}
		if err := r.validateBuskerSave(s); err != nil {
			return err
		}
	}
	if s.Inventory.Clock > s.Tick {
		return errors.New("inventory clock exceeds world clock")
	}
	if err := s.Inventory.Validate(r.inventoryModelFor(s.Life.Enabled)); err != nil {
		return errors.New("invalid saved inventory: " + err.Error())
	}
	return nil
