		r.lastAdvance = now
		r.sampleAt = now
		return
	}
	elapsed := now.Sub(r.lastAdvance)
	if elapsed < 0 {
		return
	}
	r.lastAdvance = now
	// A host stall over 2 s (the process stopped, starved on a loaded machine
	// or busy in one long command) is not world time: it is dropped, never
	// caught up in a burst of steps. The world keeps running and keeps taking
	// orders. It used to pause here instead: an order that arrived with the
	// stall (a client's first walk while it still loads its scene) was refused
	// and only a client could resume (design/proof-reliability/v1).
	if elapsed > 2*time.Second {
		elapsed = 0
	}
	step := time.Second / time.Duration(r.world.Config.TickHz)
	if r.state.Active && !r.state.Paused {
		r.saves.playedNS += int64(elapsed)
		r.state.PhaseNS += int64(elapsed) * int64(r.state.Speed)
		for i := 0; r.state.PhaseNS >= int64(step) && i < r.world.Config.MaxCatchupSteps; i++ {
			r.state.PhaseNS -= int64(step)
			before := time.Now()
			r.step()
			r.stepUS = float64(time.Since(before).Nanoseconds()) / 1000
			r.sampleTicks++
			// A world sample is valid at this tick boundary. Keep the saved
			// fractional clock for commands and continuous train snapshots.
			// At speed 1 every step is published; a faster calendar keeps the
			// wall-clock publication rate at TickHz (Speed ticks per frame).
			since := r.state.Tick - r.publishedTick
			if r.client != nil && (since < 0 || since >= int64(max(1, r.state.Speed))) {
				phase := r.state.PhaseNS
				r.state.PhaseNS = 0
				r.publishingTick = true
				r.sendState(r.client)
				r.publishingTick = false
				r.state.PhaseNS = phase
				r.publishedTick = r.state.Tick
			}
		}
	}
	// A fractional tick is normal progress, not scheduler lag.
	overdue := r.state.PhaseNS - int64(step)
	if overdue < 0 {
		overdue = 0
	}
	r.lagMS = float64(overdue) / 1e6 / float64(r.state.Speed)
	if now.Sub(r.sampleAt) >= time.Second {
		r.tickHz = float64(r.sampleTicks) / now.Sub(r.sampleAt).Seconds()
		r.sampleTicks = 0
		r.sampleAt = now
	}
	r.autosaveWhenDue()
}
func (r *Runtime) simNS() int64 {
	step := int64(time.Second) / int64(r.world.Config.TickHz)
	phase := r.state.PhaseNS
