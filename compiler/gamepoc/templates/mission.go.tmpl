// Code generated by ANG. World operations adapt the generic CUE planner to this POC.
package poc

import (
 "angelsdemons/server/internal/behavior"
 "fmt"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

func(r *Runtime) missionFacts()map[string]bool{
 d:=&r.state.Demo;ready:=0
 for _,c:=range d.Candidates{if c.Selected{a:=d.Agents[r.demoAgentIndex(c.AgentID)];if manhattan(a.Position,r.state.Player)<=r.world.Config.CaptureDemo.CaptureDistance&&len(a.Path)==0{ready++}}}
 facts:=map[string]bool{}
 for k,v:=range r.world.Config.CaptureDemo.KnownFacts{facts[k]=v}
 for k,v:=range map[string]bool{
  "target.alive":d.TargetAlive,"target.dead":!d.TargetAlive,
  "group.formed":d.TeamReady,
  "group.in_position":ready>=r.world.Config.CaptureDemo.RequiredResponders,
  "custody.captured":d.Captured,"custody.held":d.Held,
  "custody.at_medblock":d.AtMedblock,"custody.handed_over":d.Delivered,
 }{facts[k]=v}
 return facts
}
func(r *Runtime) missionStep(){

 d:=&r.state.Demo;if d.Plan.Root==""{d.Plan.Reset(r.world.Config.CaptureDemo.MissionRoot)}
 previousAction,previousStatus:=d.Plan.Current,d.Plan.Status
 d.Plan.Advance(r.world.AI,r.missionFacts(),r.state.Tick,r.executeMissionAction)
 if d.Plan.Current!=previousAction&&d.Plan.Current!=""{r.demoEvent("План: "+d.Plan.Current)}
 if d.Plan.Status=="blocked"&&previousStatus!="blocked"{r.demoEvent("План заблокирован: "+d.Plan.Reason)}
}
func(r *Runtime) executeMissionAction(a behavior.Action)(string,string){
 d:=&r.state.Demo
 switch a.Operator{
 case "form_group":return "running","ожидаем ответы и сбор участников"
 case "approach_target":
  return "running","ожидание общей готовности и согласованного подхода"
 case "capture_target":
  d.Captured=true;d.Squad.Phase="in_position";d.CapturedTick=r.state.Tick;r.state.Path=nil
  for _,c:=range d.Candidates{if c.Selected{agent:=&d.Agents[r.demoAgentIndex(c.AgentID)];agent.Task="capturing";agent.Path=nil}}
  r.demoEvent("Герой захвачен: все участники группы заняли подходы");return "done",""
 case "hold_target":d.Held=true;r.demoEvent("Цель удерживается, готовим доставку в медблок");return "done",""
 case "escort_target","carry_body":
  if a.Operator=="carry_body"&&!d.Captured&&!r.missionFacts()["group.in_position"]{r.planDemoTeam();return "running","подход переносчиков к телу"}
  if a.Operator=="carry_body"&&!d.Captured{d.Captured=true;d.CapturedTick=r.state.Tick;d.Held=true;r.demoEvent("Тело принято на переноску")}
  return r.transportMissionTarget()
 case "handoff_medblock":
  if !d.AtMedblock{return "blocked","медблок ещё не достигнут"}
  d.Delivered=true;d.DeliveredTick=r.state.Tick
  for _,c:=range d.Candidates{if c.Selected{agent:=&d.Agents[r.demoAgentIndex(c.AgentID)];agent.Task="delivered";agent.Path=nil}}
  r.demoEvent("Медблок принял цель; дальнейшее правосудие выполняет система");return "done",""
 default:
  return "blocked",fmt.Sprintf("оператор %s пока не подключён к миру POC",a.Operator)
 }
}
func(r *Runtime) transportMissionTarget()(string,string){
 d:=&r.state.Demo;med:=r.world.Config.CaptureDemo.Medblock
 if !r.walkable(med){return "blocked","недоступное место приёма медблока"}
 if d.CarrierID==""{
  for _,c:=range d.Candidates{if c.Selected{d.CarrierID=c.AgentID;break}}
  if d.CarrierID==""{return "blocked","нет участника для сопровождения"}
  carrier:=&d.Agents[r.demoAgentIndex(d.CarrierID)];r.state.Player=carrier.Position;r.state.Path=nil
  r.demoEvent(fmt.Sprintf("Группа доставляет цель в медблок (%d,%d)",med.X,med.Y))
 }
 i:=r.demoAgentIndex(d.CarrierID);carrier:=&d.Agents[i];carrier.Task="transporting"
 if len(carrier.Path)==0&&carrier.Position!=med{
  carrier.Path=r.pathAvoid(carrier.Position,med,r.demoBlocked(i));carrier.MoveStartNS=r.state.Tick*r.tickNS();carrier.Goal=med
  if len(carrier.Path)==0{return "blocked","маршрут доставки временно заблокирован"}
 }
 r.state.Player=carrier.Position
 if r.state.Tick%r.world.Config.CaptureDemo.ReplanEveryTicks==0{r.planTeamAround(carrier.Position,d.CarrierID)}
 nearby:=true
 for _,c:=range d.Candidates{if c.Selected&&c.AgentID!=d.CarrierID{a:=d.Agents[r.demoAgentIndex(c.AgentID)];if manhattan(a.Position,carrier.Position)>r.world.AI.Policy.Group.CohesionDistance{nearby=false}}}
 if carrier.Position==med&&nearby{d.AtMedblock=true;return "done",""}
 return "running","доставка цели"
}
func(r *Runtime) appendMissionMotion(msg *pb.PocGameState){
 d:=r.state.Demo;if d.CarrierID==""||d.Delivered{return};i:=r.demoAgentIndex(d.CarrierID);if i<0{return};a:=d.Agents[i]
 msg.PlayerX=int32(a.Position.X);msg.PlayerY=int32(a.Position.Y);msg.Path=nil
 for _,p:=range a.Path{msg.Path=append(msg.Path,&pb.PocPoint{X:int32(p.X),Y:int32(p.Y)})}
 msg.MotionStartNs=a.MoveStartNS;msg.MovementStepNs=r.agentDurationNS()
}
