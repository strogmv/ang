func TestCombatGridMarketAndMultideckDerivedFromWorld(t *testing.T){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)}
 for _,level:=range []string{"level.c7_market","level.c7_transport_hub"}{
 space:=r.combatSpace(behavior.CombatState{LevelID:level});g:=space.Grid
 if g==nil||g.CellMM!=1000||len(g.Members)<20{t.Fatalf("%s: no derived metre grid",level)}
 members:=0;layers:=map[int]bool{}
 for key,cells:=range g.Members{for _,at:=range cells{members++;if !space.Space.Walkable(at)||g.Tile[at]!=key{t.Fatalf("%s invalid member %v",level,at)};if v:=r.world.Decks[level];v!=nil{_,_,layer,ok:=v.Locate(at);if !ok{t.Fatal("unlocated member")};layers[layer]=true}}}
 counts:=map[int]int{};for at:=range g.Tile{if space.CoverSides!=nil{for _,class:=range space.CoverSides(at){counts[class]++}}}
 if counts[2]==0{t.Fatalf("%s has no full cover from world walls/columns: %v",level,counts)}
 t.Logf("%s: %d fine cells, %d combat areas, %d surfaces/connectors, sides %v",level,members,len(g.Members),len(layers),counts)
 }
}
func TestCombatGridPreviewSnapsAndDoesNotChangeWorld(t *testing.T){
 r,c,d:=combatEpisodeFixture(t,"combat_knife","ru");combatEpisodeEngage(t,r,c,d)
 if !combatEpisodeHeroTurn(r){t.Fatal("no hero turn")}
 s:=r.state.Combat;space:=r.combatSpace(s);a:=s.Actor(playerActorID);before,_:=json.Marshal(r.snapshotState())
 costs:=s.MoveReachCosts(space,r.world.CombatRuntime.Rules,playerActorID)
 checked:=0
 for _,at:=range s.MoveReach(space,r.world.CombatRuntime.Rules,playerActorID){
 if at==a.Position{continue};p:=s.MovePreview(space,r.world.CombatRuntime.Rules,playerActorID,at);if p.Reason!=""{t.Fatalf("reach refused: %v %+v",at,p)};if p.AP!=costs[at]{t.Fatalf("zone cost %d differs from preview %d at %v",costs[at],p.AP,at)}
 clone:=s.Clone();ap:=clone.Actor(playerActorID).AP;if err:=clone.Execute(space,r.world.CombatRuntime.Rules,playerActorID,behavior.CombatAction{Type:"move",To:at});err!=nil{t.Fatalf("reachable move refused: %v",err)}
 charged:=0;for _,e:=range clone.Events{if e.Sequence>s.EventSeq&&e.ActorID==playerActorID&&e.Type=="move"{charged+=e.AP}}
 if clone.Actor(playerActorID).Position==at&&charged!=p.AP{t.Fatalf("preview %d, move %d, AP before %d",p.AP,charged,ap)};checked++;if checked==12{break}
 }
 after,_:=json.Marshal(r.snapshotState());if checked==0||!bytes.Equal(before,after){t.Fatal("preview changed world or no routes checked")}
}

func TestCombatCoverKnownMarketCountersUseTheirExistingBounds(t *testing.T){
 r,err:=New(t.TempDir(),"token");if err!=nil{t.Fatal(err)};v:=r.world.Decks["level.c7_market"];if v==nil{t.Fatal("market has no physical volume")}
 counters,half:=0,0
 for _,o:=range v.Obstacles{if !strings.Contains(o.ID,"counter")||!o.BlocksMovement||o.TopMM-o.BottomMM>1200{continue};counters++
  found:=false
  for y:=0;y<v.NavDepth&&!found;y++{for x:=0;x<v.NavWidth&&!found;x++{at:=behavior.Cell{X:x,Y:y};plan,h,_,ok:=v.Locate(at);if !ok||h<o.BottomMM||h>o.TopMM{continue};if plan.X<o.Rect.X-2||plan.X>o.Rect.X+o.Rect.W+2||plan.Y<o.Rect.Y-2||plan.Y>o.Rect.Y+o.Rect.H+2{continue};for _,class:=range v.CombatCoverSides(at,r.world.CombatRuntime.Rules.CoverRules){if class==1{found=true;break}}}}
  if found{half++;t.Logf("low counter %s (%d..%d mm) gives half cover",o.ID,o.BottomMM,o.TopMM)}
 }
 if counters==0||half==0{t.Fatalf("existing counters %d, half cover %d",counters,half)}
}
