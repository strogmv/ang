   string zone=!string.IsNullOrEmpty(b.zone)?b.zone:b.part;PocCombatStrike st=null;foreach(var x in w.strikes)if(x.zones!=null&&Array.IndexOf(x.zones,zone)>=0){st=x;break;}if(st==null)st=w.strikes[0];
