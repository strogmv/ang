func dressWire(t *testing.T, r *Runtime, c *connection, action string, i inv.Item) *pb.PocInventoryResult {
	t.Helper()
	q := &pb.PocInventoryCommand{Epoch: r.state.Epoch, Sequence: r.state.Inventory.Cursors[playerActorID].Sequence + 1,
		Action: action, ItemId: i.ID, ExpectedRevision: i.Revision, Quantity: i.Quantity, ExpectedTurn: r.state.Combat.Turn}
	r.inventoryCommand(c, q)
	var result *pb.PocInventoryResult
	for len(c.out) > 0 {
		if receipt := (<-c.out).GetInventoryResult(); receipt != nil {
			result = receipt
		}
	}
	if result == nil {
		t.Fatalf("%s returned no receipt", action)
	}
	return result
}

