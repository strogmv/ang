				r.craftingDetect("raid", id)
			}
			for _, c := range m.Law.Rebind.Contraband {
				if i.Definition == c {
					take = append(take, inv.Relocate{Item: id, Quantity: i.Quantity, To: inv.Location{Kind: "store", Store: m.Law.Rebind.ConfiscateStore}, Owner: owner})
				}
			}
		}
		notice := crafting.Notice{Key: "crafting.notice.raid", Second: now}
		if len(take) > 0 {
			if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Relocate: take}); err == nil {
				for _, mv := range take {
					law.Journal = append(law.Journal, crafting.Record{Second: now, Kind: "confiscated", Item: mv.Item})
				}
				notice = crafting.Notice{Key: "crafting.notice.confiscated", Detail: r.state.Inventory.Items[take[0].Item].Definition, Second: now}
			}
		}
		r.state.Crafting.Notice = notice
	}
	// the scanner of an equipment terminal and a guard who sees the hacked gun in hand
	if _, atTerminal := r.craftingTerminal(hero); len(hacked) > 0 && hero != nil {
		guardNear := false
		for _, w := range r.craftingWitnesses(hero) {
			for _, o := range m.Law.Obliged {
				guardNear = guardNear || w == o
			}
		}
		for _, id := range hacked {
			i, ok := r.craftingHeroCarried(id)
			if !ok {
				continue
			}
			if atTerminal {
				r.craftingDetect("scan", id)
			}
			if guardNear && i.Location.Slot != "" {
				r.craftingDetect("carry", id)
			}
		}
	}
	// Legacy physical uses share the shot resolver and its persisted watermark.
	// The actual carrier receives the wound, even when legal ownership differs.
	for _, id := range hacked {
		if holder:=r.combatItemHolder(id);holder!=""{_ = r.combatCraftingUse(id,holder,false)}
	}
	// reports arrive; a case that reaches «known» gets the sanctions of its rung
	for k := range law.Cases {
		c := &law.Cases[k]
		if c.Closed {
			continue
		}
		kept := c.Pending[:0]
		for _, e := range c.Pending {
			if e.Second <= now {
				c.Evidence = append(c.Evidence, e)
			} else {
				kept = append(kept, e)
			}
		}
		c.Pending = kept
		if m.Status(*c, now) != "known" {
			continue
		}
		c.Closed = true
 if c.Suspect!=m.Hero.Actor{continue} // NPC cases retain attribution; the hero cannot pay their sanctions.
		act, _ := m.Act(c.Act)
		fine := m.Sanction(law, act)
		t := inv.Transform{}
		if fine = min(fine, r.state.Inventory.Accounts[m.Hero.Account].Balance); fine > 0 && m.Law.Ledger.Account != "" {
			t.Payments = append(t.Payments, r.craftingPayment(m.Hero.Account, m.Law.Ledger.Account, fine))
		}
		if i, ok := r.state.Inventory.Items[c.Item]; ok && i.Owner == playerActorID {
			t.Relocate = append(t.Relocate, inv.Relocate{Item: c.Item, Quantity: i.Quantity, To: inv.Location{Kind: "store", Store: m.Law.Rebind.ConfiscateStore}, Owner: r.world.Inventory.Stores[m.Law.Rebind.ConfiscateStore].Owner})
		}
		if len(t.Payments)+len(t.Relocate) > 0 {
			_, _ = r.state.Inventory.Transform(r.inventoryModelFor(true), t)
		}
		r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.sanction", Detail: act.Name, Second: now}
	}
	// a clean day of the world raises the system trust
	if day > law.Day {
		clean := true
		for _, c := range law.Cases {
			clean = clean && c.Opened < law.Day*86400
		}
		if law.Day > 0 && clean {
			law.Trust = min(1000, law.Trust+m.Law.Trust.GainCleanDay*(day-law.Day))
		}
		law.Day = day
	}
}

// ---------------------------------------------------------------- snapshot: binding, rebinding, inspection, the law
func (r *Runtime) craftingBoundLine(locale string, i inv.Item) string {
	switch {
	case r.state.Crafting.Law.Hacked[i.ID].By != "":
		return r.craftingText(locale, "crafting.bound.hacked")
	case i.Grade.Bound == crafting.Chip(r.world.Crafting.Hero.Actor):
		return r.craftingText(locale, "crafting.bound.own")
	}
	return r.craftingText(locale, "crafting.bound.foreign")
}
func (r *Runtime) craftingSwapLine(locale string, sw crafting.Swap) string {
	part := sw.Class
	if p, ok := r.world.Crafting.Part(sw.Class); ok {
		part = r.craftingText(locale, p.Name)
	}
	return r.craftingText(locale, "crafting.swap.mark", "master", r.craftingActorName(locale, sw.Master), "part", part, "from", r.craftingText(locale, "crafting.origin."+sw.From))
}

// craftingLawOptions: the rebinding of carried bound gear at the terminal (refused below the trust, logged either way)
// and the inspection of carried things a master worked on.
func (r *Runtime) craftingLawOptions(locale string, hero *behavior.LifeActor) []*pb.PocCraftingOption {
	m := r.world.Crafting
	out := []*pb.PocCraftingOption{}
	if !r.craftingLawOn() || hero == nil {
		return out
	}
	_, atTerminal := r.craftingTerminal(hero)
	law := r.state.Crafting.Law
	for _, id := range sortedCraftingItems(r.state.Inventory) {
		i, ok := r.craftingHeroCarried(id)
		if !ok {
			continue
		}
		if i.Grade.Bound != "" && (i.Grade.Bound != crafting.Chip(m.Hero.Actor) || law.Hacked[id].By != "") {
			reason := ""
			switch {
			case !atTerminal:
				reason = r.craftingText(locale, "crafting.error.no_terminal")
			case law.Frozen:
				reason = r.craftingText(locale, "crafting.error.frozen")
			}
			o := r.craftingOption(locale, "rebind", r.craftingText(locale, "crafting.option.rebind", "name", r.craftingItemName(locale, i.Definition)), reason == "", reason)
			o.ItemId, o.Sub = id, r.craftingMoney(m.Law.Rebind.PriceMinor)+" · "+r.craftingBoundLine(locale, i)
			o.Warning = r.craftingText(locale, "crafting.warning.rebind", "need", craftingPermille(m.Law.Trust.RebindMinPermille), "have", craftingPermille(law.Trust))
			out = append(out, o)
		}
		worked := false
		for _, rec := range m.Recipes {
			worked = worked || rec.Target == i.Definition || rec.Output != nil && rec.Output.Item == i.Definition
		}
		if worked {
			o := r.craftingOption(locale, "inspect", r.craftingText(locale, "crafting.option.inspect", "name", r.craftingItemName(locale, i.Definition)), true, "")
			o.ItemId = id
			if sw, ok := r.state.Crafting.Market.Swaps[id]; ok && sw.Seen {
				o.Lines = []string{r.craftingSwapLine(locale, sw)}
			}
			out = append(out, o)
		}
	}
	return out
}

// craftingLawView: the line of the system trust and the status lines of the cases and sanctions.
func (r *Runtime) craftingLawView(locale string) (string, []string) {
	m := r.world.Crafting
	if !r.craftingLawOn() {
		return "", nil
	}
	law := r.state.Crafting.Law
	trust := r.craftingText(locale, "crafting.trust", "have", craftingPermille(law.Trust), "need", craftingPermille(m.Law.Trust.RebindMinPermille))
	lines := []string{}
	if law.Frozen {
		lines = append(lines, r.craftingText(locale, "crafting.law.frozen"))
	}
	if law.Expulsion {
		lines = append(lines, r.craftingText(locale, "crafting.law.expulsion"))
	}
	if law.Wanted {
		lines = append(lines, r.craftingText(locale, "crafting.law.wanted"))
	}
	for _, c := range law.Cases {
		act, _ := m.Act(c.Act)
		lines = append(lines, r.craftingText(locale, "crafting.law.case", "crime", r.craftingText(locale, act.Name), "status", r.craftingText(locale, "crafting.law.status."+m.Status(c, r.state.Life.Seconds))))
	}
	return trust, lines
}
