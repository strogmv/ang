// Code generated by ANG. Access zones, step 2: who passes, who must leave, who is shot. DO NOT EDIT.
package poc

import (
	"math"
	"reflect"
	"sort"
	"testing"

	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

// accessZoneFixture: the turrets' fixture (the hero alone on the level of the posts, far away) with the first zone that
// fires after its scan and countdown, its posts and its floor: inside cells every post can aim at and see (nearest to the
// guarded object first) and open floor in the turrets' range outside the polygon.
func accessZoneFixture(t *testing.T) (*Runtime, accessZone, []turretWatchPost, []behavior.Cell, []behavior.Cell) {
	t.Helper()
	r := lifeRuntimeFixture(t)
	if r.world.TurretWatch == nil || len(r.world.TurretWatch.Posts) == 0 {
		t.Skip("content has no turret posts")
	}
	// As the turrets' fixture: everyone else of the posts' level taken off it, so a test places exactly whom it needs;
	// accessZoneRestore puts back whoever the test did not place before a save (the Life checks his cell).
	level := r.world.TurretWatch.Posts[0].LevelID
	away := ""
	for id := range r.world.Life.Locations {
		if id != level && (away == "" || id < away) {
			away = id
		}
	}
	accessZoneAway = map[string]accessZoneOrigin{}
	for i := range r.state.Life.Actors {
		if a := &r.state.Life.Actors[i]; a.ID != playerActorID && a.Level == level {
			accessZoneAway[a.ID] = accessZoneOrigin{level: a.Level, path: a.Path, pending: a.PendingPath}
			a.Level, a.Path, a.PendingPath = away, nil, nil
		}
	}
	for i := range r.state.Life.Population.Actors {
		if a := &r.state.Life.Population.Actors[i]; a.Level == level {
			accessZoneAway[a.ID] = accessZoneOrigin{level: a.Level, path: a.Path, population: true}
			a.Level, a.Path = away, nil
		}
	}
	r.state.Visitors.Bodies = nil
	turretWatchPlace(t, r, playerActorID, turretWatchFar(t, r, r.world.TurretWatch.Posts))
	r.state.Turrets = nil
	var zone *accessZone
	for i := range r.world.AccessZones {
		if r.world.AccessZones[i].Fire == "after_scan_and_countdown" {
			zone = &r.world.AccessZones[i]
			break
		}
	}
	if zone == nil {
		t.Skip("content has no access zone that fires")
	}
	posts := r.accessZonePosts(*zone)
	if len(posts) == 0 || r.world.TurretWatch.Rule.Fire == nil {
		t.Fatal("a zone that fires needs its turret posts and their fire rule")
	}
	rule := r.world.TurretWatch.Rule
	height := int64(math.Round(rule.AimHeightM * 1000))
	terrain := r.world.Life.Locations[zone.LevelID].Terrain
	var inside, outside []behavior.Cell
	for y := range terrain {
		for x := range len(terrain[y]) {
			at := behavior.Cell{X: x, Y: y}
			if terrain[y][x] != '.' {
				continue
			}
			px, py := turretWatchCentre(r, posts[0], at)
			if math.Hypot(float64(px)/1000-posts[0].Object.XM, float64(py)/1000-posts[0].Object.YM) > rule.RangeM-.3 {
				continue
			}
			ok := true
			for _, p := range posts {
				_, _, aim := p.aim(rule, px, py, height)
				ok = ok && aim && r.turretWatchSees(p, turretWatchPivotCell(r, p), turretWatchPerson{ID: "probe", XMM: px, YMM: py, Cell: at}, height)
			}
			if !ok {
				continue
			}
			if accessZoneInside(*zone, px, py) {
				inside = append(inside, at)
			} else {
				outside = append(outside, at)
			}
		}
	}
	near := func(cells []behavior.Cell) {
		sort.SliceStable(cells, func(i, j int) bool {
			return turretWatchDistance(r, posts[0], cells[i]) < turretWatchDistance(r, posts[0], cells[j])
		})
	}
	near(inside)
	near(outside)
	if len(inside) < 3 || len(outside) < 1 {
		t.Fatalf("the zone %s has %d open floor cells inside and %d outside in the turrets' range", zone.ID, len(inside), len(outside))
	}
	return r, *zone, posts, inside, outside
}

type accessZoneOrigin struct {
	level         string
	path, pending []behavior.Cell
	population    bool
}

// accessZoneAway: the people the fixture took off the level, with where they were going.
var accessZoneAway map[string]accessZoneOrigin

// accessZoneRestore: before a save, everyone the test did not place goes back to his own level and way (the Life checks
// that a person stands on a floor of his level); the hero's mirror is synced as a frame would.
func accessZoneRestore(r *Runtime, level string) {
	for i := range r.state.Life.Actors {
		if a := &r.state.Life.Actors[i]; a.Level != level {
			if o, moved := accessZoneAway[a.ID]; moved && !o.population {
				a.Level, a.Path, a.PendingPath = o.level, o.path, o.pending
			}
		}
	}
	for i := range r.state.Life.Population.Actors {
		if a := &r.state.Life.Population.Actors[i]; a.Level != level {
			if o, moved := accessZoneAway[a.ID]; moved && o.population {
				a.Level, a.Path = o.level, o.path
			}
		}
	}
	r.syncLifeHero()
}

// accessZoneTick: one server tick of everything the zone touches, in the frame's order: the wounds bleed on the Life
// clock, the zone's phases, the barks, the turrets, their fire.
func accessZoneTick(t *testing.T, r *Runtime, n int) {
	t.Helper()
	for range n {
		r.state.Tick++
		r.state.Life.Tick = r.state.Tick
		r.state.Life.Seconds += r.state.Life.SecondsPerTick
		r.applyWoundLifeLimits()
		if err := r.advanceWoundCare(); err != nil {
			t.Fatal(err)
		}
		r.advanceAccessZones()
		r.advanceBarks()
		r.advanceTurretWatch()
		if err := r.accessZoneFire(); err != nil {
			t.Fatal(err)
		}
	}
}

func accessZoneTicks(r *Runtime, seconds float64) int {
	return int(math.Ceil(seconds * 1e9 / float64(r.tickNS())))
}

func accessZoneShots(r *Runtime) []accessZoneShot {
	if r.state.AccessZones == nil {
		return nil
	}
	return r.state.AccessZones.Shots
}

func accessZoneWounded(r *Runtime, id string) bool {
	c, ok := r.state.CombatRoster[id]
	return ok && len(c.Body) > 0 && len(combatBody(c).Wounds) > 0
}

// accessZonePerson: a Life person of the given caste (or of any other caste when not) who guards none of the posts.
func accessZonePerson(t *testing.T, r *Runtime, z accessZone, caste string, want bool) string {
	t.Helper()
	ids := []string{}
	for _, a := range r.state.Life.Actors {
		if a.ID != playerActorID && !r.accessZoneGuard(z, a.ID) && !r.sanitaryPrivateActor(a.ID) && (r.accessZoneCaste(a.ID) == caste) == want {
			ids = append(ids, a.ID)
		}
	}
	sort.Strings(ids)
	if len(ids) == 0 {
		t.Skipf("no Life person %s caste %s to bring onto the level", map[bool]string{true: "of", false: "outside"}[want], caste)
	}
	return ids[0]
}

func TestAccessZoneSilverPasses(t *testing.T) {
	r, z, _, inside, _ := accessZoneFixture(t)
	if len(z.Access.Castes) == 0 {
		t.Skip("the zone admits no caste")
	}
	silver := accessZonePerson(t, r, z, z.Access.Castes[0], true)
	turretWatchPlace(t, r, silver, inside[0])
	accessZoneTick(t, r, 1)
	if rec, ok := r.accessZoneRecordOf(silver); !ok || rec.Phase != "scan" {
		t.Fatalf("a %s person crossing the edge is not scanned: %+v", z.Access.Castes[0], rec)
	}
	accessZoneTick(t, r, accessZoneTicks(r, z.ScanSeconds))
	if rec, _ := r.accessZoneRecordOf(silver); rec.Phase != "granted" || rec.By != "caste" {
		t.Fatalf("the scan did not let a %s person in: %+v", z.Access.Castes[0], rec)
	}
	accessZoneTick(t, r, accessZoneTicks(r, z.CountdownSeconds)+30)
	if rec, _ := r.accessZoneRecordOf(silver); rec.Phase != "granted" || len(accessZoneShots(r)) != 0 || accessZoneWounded(r, silver) {
		t.Fatalf("a granted person was counted down or shot: %+v shots %+v", rec, accessZoneShots(r))
	}
}

func TestAccessZonePassHolderPasses(t *testing.T) {
	r, z, _, inside, _ := accessZoneFixture(t)
	// The world has no pass to this zone yet: the rule is checked on a real item of the inventory made the zone's pass.
	var item inv.Item
	for _, id := range combatItemKeys(r.state.Inventory) {
		if i := r.state.Inventory.Items[id]; i.Condition > 0 && !r.state.Inventory.Reserved(r.inventoryModelFor(true), id) {
			item = i
			break
		}
	}
	if item.ID == "" {
		t.Skip("the inventory has no item to make a pass of")
	}
	zones := append([]accessZone(nil), r.world.AccessZones...)
	for i := range zones {
		if zones[i].ID == z.ID {
			zones[i].Access.PassItems = []string{item.Definition}
			z = zones[i]
		}
	}
	r.world.AccessZones = zones
	// Without the pass the hero is an intruder (bronze, nobody leads him).
	turretWatchPlace(t, r, playerActorID, inside[0])
	accessZoneTick(t, r, 1+accessZoneTicks(r, z.ScanSeconds))
	if rec, _ := r.accessZoneRecordOf(playerActorID); rec.Phase != "countdown" {
		t.Fatalf("the hero without the pass is not counted down: %+v", rec)
	}
	turretWatchPlace(t, r, playerActorID, turretWatchFar(t, r, r.accessZonePosts(z)))
	accessZoneTick(t, r, 1)
	item.Location = inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}
	r.state.Inventory.Items[item.ID] = item
	if !r.combatCarried(r.state.Inventory, playerActorID, item) {
		t.Fatal("the test pass is not carried by the hero")
	}
	turretWatchPlace(t, r, playerActorID, inside[0])
	accessZoneTick(t, r, 1+accessZoneTicks(r, z.ScanSeconds))
	if rec, _ := r.accessZoneRecordOf(playerActorID); rec.Phase != "granted" || rec.By != "pass" {
		t.Fatalf("the pass holder was not let in: %+v", rec)
	}
	accessZoneTick(t, r, accessZoneTicks(r, z.CountdownSeconds)+30)
	if len(accessZoneShots(r)) != 0 || accessZoneWounded(r, playerActorID) {
		t.Fatal("the pass holder was shot")
	}
}

func TestAccessZoneEscortedPasses(t *testing.T) {
	r, z, _, inside, _ := accessZoneFixture(t)
	e := r.world.CalendarEncounter
	if e == nil || !z.Access.EscortByGuards || !r.accessZoneGuard(z, e.Guard) || r.state.Life.Actor(e.Actor) == nil {
		t.Skip("no guard of the post leads anyone in this content")
	}
	// The guard leads the person (the calendar encounter's escort: the one field «whom the guard leads»), a step behind him.
	beside := -1
	for j := 1; j < len(inside); j++ {
		if d := behavior.Distance(inside[0], inside[j]); d > 0 && d <= e.EscortHold && (beside < 0 || d < behavior.Distance(inside[0], inside[beside])) {
			beside = j
		}
	}
	if beside < 0 {
		t.Skip("no open cell of the zone within the escort hold")
	}
	turretWatchPlace(t, r, e.Guard, inside[beside])
	turretWatchPlace(t, r, e.Actor, inside[0])
	r.state.CalendarEncounter.Phase, r.state.CalendarEncounter.Outcome = "escort", "forced"
	if r.guardEscortTarget(e.Guard) != e.Actor {
		t.Fatal("the escort of the guard is not seen")
	}
	accessZoneTick(t, r, 1+accessZoneTicks(r, z.ScanSeconds))
	if rec, _ := r.accessZoneRecordOf(e.Actor); rec.Phase != "granted" || rec.By != "escort" {
		t.Fatalf("the escorted person was not let in: %+v", rec)
	}
	accessZoneTick(t, r, accessZoneTicks(r, z.CountdownSeconds)+30)
	if len(accessZoneShots(r)) != 0 || accessZoneWounded(r, e.Actor) {
		t.Fatal("the escorted person was shot")
	}
	// The same person alone (the escort over) is an intruder after a new scan.
	r.state.CalendarEncounter.Phase, r.state.CalendarEncounter.Outcome = "", ""
	turretWatchPlace(t, r, e.Actor, turretWatchFar(t, r, r.accessZonePosts(z)))
	accessZoneTick(t, r, 1)
	turretWatchPlace(t, r, e.Actor, inside[0])
	accessZoneTick(t, r, 1+accessZoneTicks(r, z.ScanSeconds))
	if rec, _ := r.accessZoneRecordOf(e.Actor); rec.Phase != "countdown" {
		t.Fatalf("without the escort the person is not counted down: %+v", rec)
	}
}

// The hero walks in: scanned, then the countdown; the guard turns to him and warns at once; the turrets aim at him before
// a granted person nearer to the lift. He leaves before the end: alive, unhurt, and a new crossing starts a new scan.
func TestAccessZoneIntruderWhoLeavesLives(t *testing.T) {
	r, z, posts, inside, _ := accessZoneFixture(t)
	guard := posts[0].Guards[0]
	turretWatchPlace(t, r, guard, inside[len(inside)-1])
	var silver string
	if len(z.Access.Castes) > 0 {
		silver = accessZonePerson(t, r, z, z.Access.Castes[0], true)
		turretWatchPlace(t, r, silver, inside[0])
	}
	turretWatchPlace(t, r, playerActorID, inside[2])
	accessZoneTick(t, r, 1)
	rec, ok := r.accessZoneRecordOf(playerActorID)
	if !ok || rec.Phase != "scan" {
		t.Fatalf("the hero crossing the edge is not scanned: %+v", rec)
	}
	scanTicks := accessZoneTicks(r, z.ScanSeconds)
	accessZoneTick(t, r, scanTicks)
	if rec, _ = r.accessZoneRecordOf(playerActorID); rec.Phase != "countdown" || rec.By != "" {
		t.Fatalf("the scan of an intruder did not end in the countdown: %+v", rec)
	}
	// The guard's warning: at once, in the frame the countdown began (a line reacting at_once to zone.access_denied).
	warns := []string{}
	for _, pack := range barkCatalog.Packs {
		for _, l := range pack.Lines {
			for _, react := range l.React {
				if react.AtOnce && react.Event == "zone.access_denied" && r.accessZoneGuard(z, l.Speaker) {
					warns = append(warns, l.ID)
				}
			}
		}
	}
	if len(warns) > 0 {
		t.Logf("at-once warnings of the guard: %v", warns)
		said := false
		for _, a := range r.state.Barks.Active {
			for _, id := range warns {
				said = said || (a.Line == id && r.accessZoneGuard(z, a.Speaker))
			}
		}
		if !said {
			t.Fatalf("the guard did not warn at once: %+v", r.state.Barks.Active)
		}
	} else {
		t.Log("content has no at-once warning of a guard for zone.access_denied")
	}
	// The guard turns to him.
	face := &pb.PocAgentState{Id: guard, X: int32(inside[len(inside)-1].X), Y: int32(inside[len(inside)-1].Y)}
	r.accessZoneFaceAgent(face)
	if face.FaceX != float64(inside[2].X-inside[len(inside)-1].X) || face.FaceY != float64(inside[2].Y-inside[len(inside)-1].Y) {
		t.Fatalf("the guard does not face the intruder: %+v", face)
	}
	// The turrets watch him, not the granted person nearer to the lift.
	accessZoneTick(t, r, 2)
	for _, p := range posts {
		if s := turretWatchStateOf(t, r, p.ID); s.Target != playerActorID {
			t.Fatalf("%s watches %q, not the intruder in the countdown", p.ID, s.Target)
		}
	}
	countdown := accessZoneTicks(r, z.CountdownSeconds)
	accessZoneTick(t, r, countdown-5)
	if rec, _ = r.accessZoneRecordOf(playerActorID); rec.Phase != "countdown" {
		t.Fatalf("the countdown ended early: %+v", rec)
	}
	turretWatchPlace(t, r, playerActorID, turretWatchFar(t, r, posts))
	accessZoneTick(t, r, 20)
	if _, ok = r.accessZoneRecordOf(playerActorID); ok {
		t.Fatal("leaving the zone did not erase the hero's record")
	}
	if len(accessZoneShots(r)) != 0 || accessZoneWounded(r, playerActorID) || r.woundBodyDead(playerActorID) {
		t.Fatal("the hero who left in time was shot")
	}
	// Back in: a new scan from the start, then the whole countdown again.
	turretWatchPlace(t, r, playerActorID, inside[2])
	accessZoneTick(t, r, 1)
	if rec, _ = r.accessZoneRecordOf(playerActorID); rec.Phase != "scan" || rec.SinceNS != r.state.Tick*r.tickNS() {
		t.Fatalf("crossing again did not start a new scan: %+v", rec)
	}
	accessZoneTick(t, r, scanTicks+countdown-3)
	if rec, _ = r.accessZoneRecordOf(playerActorID); rec.Phase != "countdown" || len(accessZoneShots(r)) != 0 {
		t.Fatalf("the countdown was not reset by leaving: %+v", rec)
	}
}

// The hero stays: the turrets fire only from the fire phase, through the wound model; he dies the ordinary way of the
// wounds (the ledger names the turret, no killing case against it), the body is held down, the turrets stop.
func TestAccessZoneIntruderWhoStaysDiesThroughWounds(t *testing.T) {
	r, z, posts, inside, _ := accessZoneFixture(t)
	guard := posts[0].Guards[0]
	turretWatchPlace(t, r, guard, inside[len(inside)-1])
	turretWatchPlace(t, r, playerActorID, inside[1])
	before := len(r.state.Crafting.Law.Cases)
	limit := 1 + accessZoneTicks(r, z.ScanSeconds) + accessZoneTicks(r, z.CountdownSeconds)
	for tick := 0; tick < limit; tick++ {
		accessZoneTick(t, r, 1)
		rec, _ := r.accessZoneRecordOf(playerActorID)
		if rec.Phase != "fire" && (len(accessZoneShots(r)) != 0 || accessZoneWounded(r, playerActorID)) {
			t.Fatalf("tick %d: a shot before the fire phase (%s)", tick, rec.Phase)
		}
	}
	if rec, _ := r.accessZoneRecordOf(playerActorID); rec.Phase != "fire" {
		t.Fatalf("the countdown ran out and the hero is not under fire: %+v", rec)
	}
	died := false
	shots := uint64(0)
	for tick := 0; tick < 20000 && !died; tick++ {
		accessZoneTick(t, r, 1)
		died = r.woundBodyDead(playerActorID)
		if r.state.AccessZones != nil {
			shots = r.state.AccessZones.Serial
		}
	}
	if !died {
		t.Fatalf("the hero who stayed is not dead after %d shots", shots)
	}
	body := combatBody(r.state.CombatRoster[playerActorID])
	t.Logf("dead after %d shots: %d wounds, %d s on the body's clock, culprit %s", shots, len(body.Wounds), body.Clock, body.Culprit)
	byTurret := false
	for _, w := range body.Wounds {
		for _, p := range posts {
			byTurret = byTurret || w.Author == p.ID
		}
	}
	if !byTurret || !body.Dead {
		t.Fatalf("the death is not the wound model's from the turrets: %+v", body)
	}
	killed := false
	for _, p := range posts {
		for _, id := range r.state.Wounds.Ledger.Kills[p.ID] {
			killed = killed || id == playerActorID
		}
	}
	if !killed || body.Culprit == "" || r.accessZoneGuard(z, body.Culprit) {
		t.Fatalf("the ledger does not name a turret post as the culprit: %+v / %+v", r.state.Wounds.Ledger.Kills, body.Culprit)
	}
	if len(r.state.Crafting.Law.Cases) != before {
		t.Fatal("a killing case was opened against a turret firing under its zone's law")
	}
	for _, a := range r.state.Barks.Active {
		if a.Speaker == guard && a.Kind == "combat" {
			t.Fatalf("the guard calls the intruder his turret felled a fallen ally: %+v", a)
		}
	}
	hero := r.state.Life.Actor(playerActorID)
	if !hero.CombatHold || hero.Activity != "down" {
		t.Fatalf("the dead hero is not held down: hold %v activity %q", hero.CombatHold, hero.Activity)
	}
	// Dead: no record, the turrets stop firing.
	accessZoneTick(t, r, 1)
	last := uint64(0)
	if r.state.AccessZones != nil {
		last = r.state.AccessZones.Serial
	}
	accessZoneTick(t, r, 100)
	if _, ok := r.accessZoneRecordOf(playerActorID); ok {
		t.Fatal("a dead body is still checked")
	}
	if r.state.AccessZones != nil && r.state.AccessZones.Serial != last {
		t.Fatal("the turrets fire at a dead body")
	}
	// The death is saved: a save and a load keep the dead body and the ledger.
	accessZoneRestore(r, z.LevelID)
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !combatBody(loaded.CombatRoster[playerActorID]).Dead || !reflect.DeepEqual(loaded.Wounds.Ledger.Kills, r.state.Wounds.Ledger.Kills) {
		t.Fatal("the save lost the death")
	}
}

// The guards of the post are their own: never scanned, never a target, never shot — even beside an intruder under fire.
func TestAccessZoneGuardsAreNeverTargets(t *testing.T) {
	r, z, posts, inside, _ := accessZoneFixture(t)
	for i, g := range posts[0].Guards {
		turretWatchPlace(t, r, g, inside[i%len(inside)])
	}
	turretWatchPlace(t, r, playerActorID, inside[len(inside)-1])
	ticks := 1 + accessZoneTicks(r, z.ScanSeconds) + accessZoneTicks(r, z.CountdownSeconds) + 60
	for tick := 0; tick < ticks; tick++ {
		accessZoneTick(t, r, 1)
		for _, g := range posts[0].Guards {
			if _, ok := r.accessZoneRecordOf(g); ok {
				t.Fatalf("tick %d: guard %s is checked", tick, g)
			}
			for _, p := range posts {
				if s := turretWatchStateOf(t, r, p.ID); s.Target == g {
					t.Fatalf("tick %d: %s aims at its guard %s", tick, p.ID, g)
				}
			}
			for _, shot := range accessZoneShots(r) {
				if shot.Target == g {
					t.Fatalf("tick %d: a shot at guard %s", tick, g)
				}
			}
			if accessZoneWounded(r, g) {
				t.Fatalf("tick %d: guard %s is wounded", tick, g)
			}
		}
	}
	if len(accessZoneShots(r)) == 0 {
		t.Fatal("the intruder beside the guards was never fired at")
	}
	bad := r.snapshotState()
	bad.AccessZones = bad.AccessZones.clone()
	bad.AccessZones.Records = append(bad.AccessZones.Records, accessZoneRecord{Zone: z.ID, Person: posts[0].Guards[0], Phase: "countdown"})
	if r.validateAccessZones(bad) == nil {
		t.Fatal("a save that counts down a guard was accepted")
	}
}

// Save and load mid-countdown keep it: the loaded game reaches the fire phase on the same tick as the one never saved.
func TestAccessZoneSaveLoadMidCountdownKeepsIt(t *testing.T) {
	run := func(save bool) (int64, accessZoneRecord) {
		r, z, _, inside, _ := accessZoneFixture(t)
		turretWatchPlace(t, r, playerActorID, inside[1])
		accessZoneTick(t, r, 1+accessZoneTicks(r, z.ScanSeconds)+accessZoneTicks(r, z.CountdownSeconds/2))
		mid, _ := r.accessZoneRecordOf(playerActorID)
		if mid.Phase != "countdown" {
			t.Fatalf("not in the countdown before the save: %+v", mid)
		}
		if save {
			accessZoneRestore(r, z.LevelID)
			slot := r.world.Config.SaveSlots[0]
			if err := r.writeSave(slot, r.snapshotState()); err != nil {
				t.Fatal(err)
			}
			loaded, _, err := r.readSave(slot)
			if err != nil {
				t.Fatal(err)
			}
			if !reflect.DeepEqual(loaded.AccessZones, r.state.AccessZones) {
				t.Fatalf("the save changed the countdown: %+v / %+v", loaded.AccessZones, r.state.AccessZones)
			}
			r.state = loaded
		}
		for tick := 0; tick < 2*accessZoneTicks(r, z.CountdownSeconds); tick++ {
			accessZoneTick(t, r, 1)
			if rec, _ := r.accessZoneRecordOf(playerActorID); rec.Phase == "fire" {
				return r.state.Tick, mid
			}
		}
		t.Fatal("the countdown never ran out")
		return 0, mid
	}
	plain, a := run(false)
	saved, b := run(true)
	if plain != saved || a != b {
		t.Fatalf("a save in the countdown moved the fire: tick %d / %d", plain, saved)
	}
}

// Never on approach: a person in the turrets' range outside the zone is watched and never shot; inside, nothing before the
// fire phase; a zone that never fires counts down and nothing more. The view sends the hero's own record and the shots.
func TestAccessZoneNeverFiresOnApproach(t *testing.T) {
	r, z, posts, inside, outside := accessZoneFixture(t)
	turretWatchPlace(t, r, playerActorID, outside[0])
	accessZoneTick(t, r, 1+accessZoneTicks(r, z.ScanSeconds)+accessZoneTicks(r, z.CountdownSeconds)+100)
	if _, ok := r.accessZoneRecordOf(playerActorID); ok || len(accessZoneShots(r)) != 0 || accessZoneWounded(r, playerActorID) {
		t.Fatal("the hero beside the zone was checked or shot")
	}
	if s := turretWatchStateOf(t, r, posts[0].ID); s.Target != playerActorID {
		t.Fatalf("the turret does not watch the hero in its range: %+v", s)
	}
	zones := append([]accessZone(nil), r.world.AccessZones...)
	for i := range zones {
		if zones[i].ID == z.ID {
			zones[i].Fire = "never"
		}
	}
	r.world.AccessZones = zones
	turretWatchPlace(t, r, playerActorID, inside[1])
	accessZoneTick(t, r, 1+accessZoneTicks(r, z.ScanSeconds)+2*accessZoneTicks(r, z.CountdownSeconds))
	if rec, _ := r.accessZoneRecordOf(playerActorID); rec.Phase != "countdown" || len(accessZoneShots(r)) != 0 || accessZoneWounded(r, playerActorID) {
		t.Fatalf("a zone that never fires did more than count down: %+v", rec)
	}
	if err := r.validateAccessZones(r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	// Published: the hero's own record every frame.
	r.syncLifeHero()
	r.syncRegionKnowledge()
	r.updateLifeExploration()
	c := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{}), delivery: pb.NewViewProjector(&pb.ViewSubscription{StaticOnChange: true})}
	r.sendState(c)
	life := (<-c.out).GetGameState().GetLife()
	found := false
	for _, s := range life.GetAccessZone() {
		found = found || (s.GetPersonId() == playerActorID && s.GetPhase() == "countdown" && s.GetZoneId() == z.ID && s.GetTotalMs() == accessZoneMS(z.CountdownSeconds))
	}
	if !found {
		t.Fatalf("the hero's countdown is not in the view: %+v", life.GetAccessZone())
	}
}
