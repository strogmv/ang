func TestIlluminationRealNightChangesRecognitionWithoutUpdatingHiddenPosition(t *testing.T) {
	r, _, c := illuminationFixture(t)
	illuminationGuideFloor(t, r, c)
	h := r.state.Life.Actor(playerActorID)
	id := combatWorldObserverID(t, r)
	combatWorldPlace(t, r, id, playerActorID, 2500, 3500, true)
	r.world.Stealth.Watchers = map[string]stealthWatcher{}
	stealthWatch(r, id, true, false)
	r.state.Stealth = stealthState{}
	// Normal movement also needs evidence in dim light: quiet isn't a magic toggle.
	for n := 0; n < 100; n++ {
		r.state.Life.Seconds++
		if err := r.advanceStealth(); err != nil {
			t.Fatal(err)
		}
		if r.state.Stealth.Observers[id].Contact.Visible {
			break
		}
	}
	before := r.state.Stealth.Observers[id].Contact
	if !before.Visible || before.LastSeen != h.Position {
		t.Fatal("actual day guide never supplied enough sight evidence", r.illuminationBody(h), before)
	}
	// Fixture jumps to the real night phase; no artificial Lux/Score is assigned.
	r.state.Life.Seconds = 84600
	if err := r.advanceStealth(); err != nil {
		t.Fatal(err)
	}
	after := r.state.Stealth.Observers[id].Contact
	if after.Visible || after.LastSeen != before.LastSeen || after.SeenAt != before.SeenAt {
		t.Fatal("darkness tracked a hidden person", before, after)
	}
	observer := combatLifeObserver{ID: id, Level: h.Level, At: r.state.Life.Actor(id).Position}
	if r.combatWorldIdentifies(observer, playerActorID) {
		t.Fatal("old geometric LoS bypassed illumination gate")
	}
	r.world.Illumination.Enabled = false
	e := r.stealthEvidence(h, observer, r.state.Stealth.Observers[id], false, r.illuminationBody(h))
	if e.LightKnown || r.world.Stealth.VisualRate(e) <= 0 {
		t.Fatal("unconfigured lighting silently made a legacy room dark", e)
	}
}
func TestIlluminationMovingActualGateRevealsOnlyBodyBelowItsLeaves(t *testing.T) {
	r, _, c := illuminationFixture(t)
	h := r.state.Life.Actor(playerActorID)
	v := r.world.Decks[h.Level]
	var leaf illuminationGateLeaf
	for _, l := range c.GateLeaves {
		if l.GateID == "gate.entry" && l.Node == "leaf.lower" {
			leaf = l
		}
	}
	if leaf.GateID == "" {
		t.Fatal("missing actual lower leaf")
	}
	x := (leaf.Closed.Min.X + leaf.Closed.Max.X) / 2
	from := behavior.DeckPointMM{X: x, Y: leaf.Closed.Min.Y - 450, Z: 1100}
	to := behavior.DeckPointMM{X: x, Y: leaf.Closed.Max.Y + 450, Z: 1100}
	state := r.state.Life.Gates[leaf.GateID]
	state.Duration = 0
	state.From = 0
	r.state.Life.Gates[leaf.GateID] = state
	if v.RayClearMM(from, to, r.illuminationBoxes(c)) {
		t.Fatal("closed engineered leaf leaked light")
	}
	state.From = 250000
	r.state.Life.Gates[leaf.GateID] = state
	if !v.RayClearMM(from, to, r.illuminationBoxes(c)) {
		t.Fatal("quarter-lifted actual gate failed to reveal torso-height ray")
	}
	from.Z, to.Z = 1650, 1650
	if v.RayClearMM(from, to, r.illuminationBoxes(c)) {
		t.Fatal("same partially lifted gate leaked a head-height ray")
	}
	state.From = 1000000
	r.state.Life.Gates[leaf.GateID] = state
	if !v.RayClearMM(from, to, r.illuminationBoxes(c)) {
		t.Fatal("fully open actual gate still shadowed its clear opening")
	}
	// Existing emergency power is an authored flag, not an invented endless battery simulation.
	for _, e := range c.Emitters {
		if e.GateID != leaf.GateID || !e.GateBackupPower {
			continue
		}
		state.PowerLost = true
		r.state.Life.Gates[leaf.GateID] = state
		r.state.Illumination.Off = map[string]map[string]bool{h.Level: {e.PowerRef: true}}
		if r.illuminationSourceFactor(h.Level, c, e, c.Calendar.weights(84600)) <= 0 {
			t.Fatal("gate UPS signal went dark with drive mains")
		}
		state.State = "no_power"
		r.state.Life.Gates[leaf.GateID] = state
		if r.illuminationSourceFactor(h.Level, c, e, c.Calendar.weights(84600)) != 0 {
			t.Fatal("stationary powerless gate emitted phantom UPS light")
		}
		state.Duration = 100
		state.Start = state.Updated - 1
		state.To = 0
		r.state.Life.Gates[leaf.GateID] = state
		if r.illuminationSourceFactor(h.Level, c, e, c.Calendar.weights(84600)) <= 0 {
			t.Fatal("battery descent lost its actual active warning signal")
		}
		return
	}
	t.Fatal("actual gate lacks backed-up signal")
}
func TestIlluminationOwnMeterWireAndPowerCommandRemainAtomic(t *testing.T) {
	r, c, _ := illuminationFixture(t)
	h := r.state.Life.Actor(playerActorID)
	r.sendLifeState(c)
	var answer *pb.PocGameState
	for len(c.out) > 0 {
		if s := (<-c.out).GetGameState(); s != nil {
			answer = s
		}
	}
	if answer == nil || answer.Life == nil || answer.Life.Illumination == nil || !answer.Life.Illumination.Known {
		t.Fatal("ordinary wire lacks own physical light meter")
	}
	m := answer.Life.Illumination
	if math.IsNaN(m.Lux) || m.Lux < 0 || m.VisibilityFactor < .05 || m.VisibilityFactor > 1 || m.State == "" {
		t.Fatal("invalid public body illumination", m)
	}
	// Debug circuits never become ordinary player powers, and refused commands cannot mutate a save.
	before := r.snapshotState()
	r.world.Config.DebugPerception = false
	if r.illuminationCommand("illumination_power_off", "board.shr_z") == nil || !reflect.DeepEqual(before.Illumination, r.state.Illumination) {
		t.Fatal("ordinary player changed circuit power")
	}
	r.world.Config.DebugPerception = true
	r.state.Paused = true
	if r.illuminationCommand("illumination_power_off", "board.shr_z") == nil || !reflect.DeepEqual(before.Illumination, r.state.Illumination) {
		t.Fatal("paused failure mutated circuits")
	}
	r.state.Paused = false
	delete(r.world.Illumination.Levels, h.Level)
	r.sendLifeState(c)
	for len(c.out) > 0 {
		if s := (<-c.out).GetGameState(); s != nil && s.Life.Illumination.Known {
			t.Fatal("legacy level published fabricated illumination")
		}
	}
}

func TestIlluminationRejectsMissingLeafAndUsesContinuousDistance(t *testing.T) {
	r, _, c := illuminationFixture(t)
	h := r.state.Life.Actor(playerActorID)
	c.GateLeaves = c.GateLeaves[:len(c.GateLeaves)-1]
	r.world.Illumination.Levels[h.Level] = c
	if r.prepareIllumination() == nil {
		t.Fatal("missing physical leaf silently made a closed gate transparent")
	}
	r, _, id := stealthFixture(t)
	h = r.state.Life.Actor(playerActorID)
	stealthWatch(r, id, true, false)
	o := combatLifeObserver{ID: id, Level: h.Level, At: r.state.Life.Actor(id).Position}
	face := stealthObserver{FaceX: r.world.Stealth.Watchers[id].FaceX, FaceY: r.world.Stealth.Watchers[id].FaceY}
	ox, oy := r.stealthPlan(o.Level, o.At)
	dx, dy := h.Body.X-ox, h.Body.Y-oy
	n := math.Hypot(dx, dy)
	h.Body.X += 250 * dx / n
	h.Body.Y += 250 * dy / n
	e := r.stealthEvidence(h, o, face, false, r.illuminationBody(h))
	if e.DistanceMM != int(math.Ceil(math.Hypot(h.Body.X-ox, h.Body.Y-oy))) || float64(e.DistanceMM) < n+249 {
		t.Fatal("lighting kept a cell-centre near-contact distance", e.DistanceMM, n)
	}
}
