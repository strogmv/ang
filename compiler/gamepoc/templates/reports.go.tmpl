// Code generated by ANG. Reports carry an observer's data through an audible or staffed network channel.
package poc
import("strings";"angelsdemons/server/internal/behavior")
func(r *Runtime) reportPayload(a *demoAgent,record *alarmRecord){
 if f,k:=a.Memory.Lookup(r.missionSubject(),"incident");k==behavior.KnowledgeTrue&&f.ExpiresTick>r.state.Tick{record.HasTarget=true;record.KnownTarget=location(f.Position);record.ObservedTick=f.ObservedTick}
}
func(r *Runtime) hearReport(listener *demoAgent,sound behavior.Sound){
 if sound.Kind!="alarm"&&sound.Kind!="shout"{return}
 for i:=len(r.state.Demo.AlarmLog)-1;i>=0;i--{report:=r.state.Demo.AlarmLog[i];if report.ActorID!=sound.SourceID||report.Tick!=sound.Tick||!report.HasTarget{continue}
  listener.Memory.Record(behavior.Fact{Subject:r.missionSubject(),Kind:"incident",Source:"message",Cause:"report:"+report.ActorID,Value:true,Position:cell(report.KnownTarget),ObservedTick:report.ObservedTick},r.world.AI.Policy.Memory);return
 }
}
func(r *Runtime) reportSighting(a *demoAgent){
 d:=&r.state.Demo;p:=r.world.AI.Policy.Perception.Reports
 if !d.Issued||d.Captured||r.selectedActor(a.ID)||!r.networkKnown(a)||!includesString(p.Intents,r.actorIntent(*a)){return}
 f,k:=a.Memory.Lookup(r.missionSubject(),"incident");if k!=behavior.KnowledgeTrue||f.Source!="sight"||f.ObservedTick<=a.LastReportTick||r.state.Tick-a.LastReportTick<p.CooldownTicks||(a.LastReportTick>0&&behavior.Distance(f.Position,cell(a.LastReportAt))<p.MinChangeCells&&r.state.Tick-a.LastReportTick<p.RefreshTicks){return}
 _,signals:=r.sceneFacts(a,true);if _,vetoed:=behavior.Veto(behavior.UtilityGoal{Action:"report"},r.world.Psyche.Actors[a.ID],r.world.AI.Policy.Utility,signals);vetoed{return}
 a.LastReportTick=f.ObservedTick;a.LastReportAt=location(f.Position)
 report:=alarmRecord{Tick:r.state.Tick,ActorID:a.ID,Cause:"sighting",Kind:"shout",At:a.Position};r.reportPayload(a,&report);d.AlarmLog=append(d.AlarmLog,report);if len(d.AlarmLog)>32{d.AlarmLog=d.AlarmLog[len(d.AlarmLog)-32:]};r.emitSound("shout",a.Position,a.ID,"sighting");r.demoEvent(a.Name+": сообщает, где видел цель")
}
func(r *Runtime) relayOperatorReport(){
 d:=&r.state.Demo;if !d.Issued||d.Captured{return};operator:=r.sceneActor(r.world.Config.CaptureDemo.Monitoring.Operator);if operator==nil||operator.ID==r.missionActor(){return}
 f,k:=operator.Memory.Lookup(r.missionSubject(),"incident");if k!=behavior.KnowledgeTrue||f.ExpiresTick<=r.state.Tick{return}
 if f.ObservedTick>d.RelayedTick{d.RelayedTick=f.ObservedTick}
 for _,m:=range r.squadMembers(){a:=r.sceneActor(m.ID);known,k:=a.Memory.Lookup(r.missionSubject(),"incident");if k!=behavior.KnowledgeUnknown&&known.ObservedTick>=f.ObservedTick{continue}
  a.Memory.Record(behavior.Fact{Subject:r.missionSubject(),Kind:"incident",Source:"message",Cause:"operator:"+operator.ID+"|"+f.Cause,Value:true,Position:f.Position,ObservedTick:f.ObservedTick,ExpiresTick:f.ExpiresTick},r.world.AI.Policy.Memory)
  a.Reaction.Awareness.Observe(m.Position,behavior.Observation{SubjectID:r.missionSubject(),Kind:"detention_incident",Source:"message",Position:f.Position,Tick:f.ObservedTick,Active:true},r.world.AI.Policy.Social,false)
 }
}
func(r *Runtime) refreshGroupLead(members []behavior.Member){
 d:=&r.state.Demo;track:=&d.Squad.Track
 if !track.Known{track.Observe(cell(d.Call),"call",d.CallObservedTick)}
 for _,m:=range members{a:=r.sceneActor(m.ID);f,k:=a.Memory.Lookup(r.missionSubject(),"incident");if k!=behavior.KnowledgeTrue||f.ExpiresTick<=r.state.Tick||f.Radius!=0{continue};switch f.Source{case "sight","camera","message":source:=f.Source;if source=="message"&&strings.Contains(f.Cause,"camera:"){source="camera"};track.Observe(f.Position,source,f.ObservedTick)}}
}

// Temporary public authority permits a call, but only an actual sound can
// deliver its payload. The message carries the speaker's observation, not live truth.
func(r *Runtime)groupCallStep(){
 d:=&r.state.Demo;if !d.Issued||d.Captured||d.Plan.Status=="failed"{return}
 switch d.Squad.Phase{case "approaching","searching":default:return}
 members:=r.squadMembers();if len(members)<2{return};sender:=r.sceneActor(d.Coordination.LeaderID);if sender==nil{sender=r.sceneActor(members[0].ID)};if sender==nil{return}
 p:=r.world.AI.Policy.Coordination.PublicCall;if p.CooldownTicks<1||p.Line==""||sender.LastGroupCallTick>0&&r.state.Tick-sender.LastGroupCallTick<p.CooldownTicks{return}
 outOfSight:=false;for _,m:=range members{if m.ID!=sender.ID&&(behavior.Distance(cell(sender.Position),m.Position)>r.world.AI.Policy.Social.SightRange||!r.sceneVisible(cell(sender.Position),m.Position)){outOfSight=true;break}};if !outOfSight{return}
 line:=p.Line;if c,ok:=d.Squad.Approaches[sender.ID];ok&&c.Call!=""{line=c.Call}
 sender.LastGroupCallTick=r.state.Tick;sender.Speech=line;sender.SpeechUntil=r.state.Tick+p.DisplayTicks
 report:=alarmRecord{Tick:r.state.Tick,ActorID:sender.ID,Cause:"group_coordination",Kind:"shout",At:sender.Position};r.reportPayload(sender,&report);d.AlarmLog=append(d.AlarmLog,report);if len(d.AlarmLog)>32{d.AlarmLog=d.AlarmLog[len(d.AlarmLog)-32:]}
 r.emitSound("shout",sender.Position,sender.ID,"group_coordination");r.demoEvent(sender.Name+": «"+line+"»")
}
