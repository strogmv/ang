func TestWoundsCombatHitAndPreviewIsolation(t *testing.T) {
	r, _, target := combatLifeFixture(t, true)
	if err := r.startCombat(target); err != nil {
		t.Fatal(err)
	}
	r.world.CombatRuntime.Rules.MinHit = 1
	r.world.CombatRuntime.Rules.MaxHit = 1
	before := r.snapshotState()
	action := behavior.CombatAction{Type: "attack", TargetID: target, BodyPart: "torso"}
	if _, err := r.combatTry(action); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(before, r.snapshotState()) {
		t.Fatal("preview changed real body, time or inventory")
	}
	if err := r.performCombatAction(playerActorID, &action); err != nil {
		t.Fatal(err)
	}
	b := combatBody(*r.state.Combat.Actor(target))
	if len(b.Wounds) == 0 || b.Wounds[0].Author != playerActorID {
		t.Fatalf("accepted hit did not create attributed wound: %+v", b)
	}
	found := false
	for _, e := range r.state.Combat.Events {
		found = found || e.Type == "wound"
	}
	if !found {
		t.Fatal("missing wound event")
	}
}
func woundArtery(t *testing.T, r *Runtime, id string) behavior.Combatant {
	t.Helper()
	c := r.combatant(id, "opposition")
	b := combatBody(c)
	_, err := combatWounds.ApplyHit(&b, wounds.Hit{Author: playerActorID, Weapon: "item.knife_simple", Zone: "thigh", Depth: "deep", Structures: []string{"femoral_artery"}, Seed: 42})
	if err != nil {
		t.Fatal(err)
	}
	projectWoundBody(&c, b)
	if a := r.state.Life.Actor(id); a != nil {
		c.Position = a.Position
	}
	return c
}
func TestWoundsDeathAfterCombatLedger(t *testing.T) {
	r, _, target := combatLifeFixture(t, true)
	c := woundArtery(t, r, target)
	r.state.CombatRoster = map[string]behavior.Combatant{target: c}
	r.storeWoundBody(c)
	r.combatCareTrack()
	for i := 0; i < 6; i++ {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(100); err != nil {
			t.Fatal(err)
		}
	}
	b := combatBody(r.state.CombatRoster[target])
	if !b.Dead || r.state.Wounds.Ledger.Count(playerActorID) != 1 {
		t.Fatalf("delayed death lost author: %+v ledger=%+v", b, r.state.Wounds.Ledger)
	}
 msg:=&pb.PocGameState{SceneAgents:[]*pb.PocAgentState{{Id:target}}};r.appendWoundViews(msg,"ru")
 if msg.SceneAgents[0].Activity!="down"{t.Fatal("post-combat corpse was published as an upright Life body")}
	if len(r.state.WoundCrimes) != 1 || r.state.WoundCrimes[0].Culprit != playerActorID || r.state.WoundCrimes[0].Crime != "crime.killing" {
		t.Fatal("missing attributed killing")
	}
	if err := r.advanceLifeFrameBy(60); err != nil {
		t.Fatal(err)
	}
	if r.state.Wounds.Ledger.Count(playerActorID) != 1 || len(r.state.WoundCrimes) != 1 {
		t.Fatal("duplicate death")
	}
}
func TestWoundsTourniquetSpendsPhysicalItem(t *testing.T) {
	r, _, _ := combatEpisodeFixture(t, "combat_knife", "ru")
	c := woundArtery(t, r, playerActorID)
	r.state.CombatRoster = map[string]behavior.Combatant{playerActorID: c}
	r.storeWoundBody(c)
	count := r.combatCount(r.state.Inventory, playerActorID, "item.med_tourniquet", nil)
	if count < 1 {
		t.Fatal("CUE episode did not issue tourniquet")
	}
	b := combatBody(c)
	if err := r.performWoundAid(playerActorID, behavior.CombatAction{Type: "aid", Mode: "tourniquet", ItemID: "item.med_tourniquet", TargetID: b.Wounds[0].ID}, false); err != nil {
		t.Fatal(err)
	}
	if got := r.combatCount(r.state.Inventory, playerActorID, "item.med_tourniquet", nil); got != count-1 {
		t.Fatalf("item was not consumed %d -> %d", count, got)
	}
	b = combatBody(r.state.CombatRoster[playerActorID])
	if len(b.Wounds[0].Controls) == 0 {
		t.Fatal("tourniquet missing on actual wound")
	}
}
func TestWoundsHostSaveBleedingReplay(t *testing.T) {
	r, _, target := combatLifeFixture(t, true)
	c := woundArtery(t, r, target)
	r.state.CombatRoster = map[string]behavior.Combatant{target: c}
	r.storeWoundBody(c)
	r.combatCareTrack()
	if err := r.advanceLifeFrameBy(90); err != nil {
		t.Fatal(err)
	}
	before := r.snapshotState()
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, before); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(before.Wounds, loaded.Wounds) {
		t.Fatal("body changed during save/load")
	}
	a := combatBody(before.CombatRoster[target])
	b := combatBody(loaded.CombatRoster[target])
	combatWounds.Tick(&a, 600)
	combatWounds.Tick(&b, 600)
	if !reflect.DeepEqual(a, b) {
		t.Fatal("bleeding diverged after reload")
	}
}

func TestWoundsAidProgressPersistsAndOnlyWorksAfterCompletion(t *testing.T) {
	r, c, d := combatEpisodeFixture(t, "combat_knife", "ru")
	combatEpisodeEngage(t, r, c, d)
	hero := r.state.Combat.Actor(playerActorID)
	injured := woundArtery(t, r, playerActorID)
	projectWoundBody(hero, combatBody(injured))
	r.syncCombatLife()
	wound := combatBody(*hero).Wounds[0].ID
	stock := r.combatCount(r.state.Inventory, playerActorID, "item.med_tourniquet", nil)
	if err := r.performCombatAction(playerActorID, &behavior.CombatAction{Type: "aid", Mode: "tourniquet", ItemID: "item.med_tourniquet", TargetID: wound}); err != nil {
		t.Fatal(err)
	}
	hero = r.state.Combat.Actor(playerActorID)
	if hero.Aid == nil || hero.Aid.RemainingS <= 0 || len(combatBody(*hero).Wounds[0].Controls) > 0 || r.combatCount(r.state.Inventory, playerActorID, "item.med_tourniquet", nil) != stock-1 {
		t.Fatal("aid must first spend the physical item and save unfinished work")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	saved, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(hero.Aid, saved.Combat.Actor(playerActorID).Aid) {
		t.Fatal("load lost aid progress")
	}
	r.state = saved
	for n := 0; n < 20 && r.state.Combat.Actor(playerActorID).Aid != nil; n++ {
		a := r.state.Combat.Current()
		if a == nil {
			t.Fatal("helper lost initiative")
		}
		action := behavior.CombatAction{Type: "end"}
		if a.ID == playerActorID {
			action.Type = "aid_continue"
		}
		if err := r.performCombatAction(a.ID, &action); err != nil {
			t.Fatal(err)
		}
	}
	hero = r.state.Combat.Actor(playerActorID)
	b := combatBody(*hero)
	if hero.Aid != nil || len(b.Wounds[0].Controls) == 0 || b.Clock < 20 || r.combatCount(r.state.Inventory, playerActorID, "item.med_tourniquet", nil) != stock-1 {
		t.Fatal("continued aid must finish only after its work and never spend the item twice")
	}
}
func TestWoundsLegacyMigrationAndStrictNestedLoad(t *testing.T) {
	r, _, _ := combatLifeFixture(t, true)
	actor := r.combatant(playerActorID, "player")
	actor.HP = 0
	actor.MaxHP = 100
	actor.Bleeding = 2
	actor.ArmWound = 5
	actor.StunTurns = 2
	actor.Position = r.state.Life.Actor(playerActorID).Position
	actor.Body = nil
	r.state.CombatRoster = map[string]behavior.Combatant{playerActorID: actor}
	r.state.Life.Actor(playerActorID).CombatHold = true
	r.state.Life.Actor(playerActorID).Activity = "down"
	r.combatCareTrack()
	s := r.snapshotState()
	if err := r.migrateWoundState(&s); err != nil {
		t.Fatal(err)
	}
	body := combatBody(s.CombatRoster[playerActorID])
	if body.LostPermille() != 400 || !body.Down || body.Dead || body.StunUntil != 12 || len(body.Wounds) < 2 {
		t.Fatalf("legacy conversion changed the agreed meaning: %+v", body)
	}
	r.state = s
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	saved, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	bad := saved
	bad.CombatRoster = map[string]behavior.Combatant{}
	for id, c := range saved.CombatRoster {
		bad.CombatRoster[id] = cloneCombatant(c)
	}
	c := bad.CombatRoster[playerActorID]
	raw := string(c.Body)
	c.Body = []byte(raw[:len(raw)-1] + `,"unknown_anatomy":true}`)
	bad.CombatRoster[playerActorID] = c
	if r.validateWounds(bad) == nil {
		t.Fatal("unknown field inside an opaque combat body was accepted")
	}
	malformed := cloneWoundSave(saved.Wounds)
	malformed.Bodies[0].Wounds[0].Structures = []string{"no_such_structure"}
	data, _ := combatWounds.Marshal(malformed)
	if data != nil {
		t.Fatal("unknown anatomical structure was accepted")
	}
}

func TestWoundsHeroBreakDistanceAndLeave(t *testing.T){
 r,c,scene:=combatEpisodeFixture(t,"combat_knife","ru");combatEpisodeEngage(t,r,c,scene)
 hero,target:=r.state.Combat.Actor(playerActorID),r.state.Combat.Actor(scene.Guard)
 if r.state.Combat.Current().ID!=playerActorID{t.Fatal("fixture must expose the hero's own turn")}
 at,ok:=r.combatStep(hero,target,true);if !ok{t.Fatal("no real retreat destination")}
 if err:=r.performCombatAction(playerActorID,&behavior.CombatAction{Type:"move",To:at});err!=nil{t.Fatal(err)}
 if r.state.Combat.Current().ID!=playerActorID||r.state.Combat.Actor(playerActorID).AP<1{t.Fatal("retreat consumed the command window for leaving")}
 if err:=r.performCombatAction(playerActorID,&behavior.CombatAction{Type:"disengage"});err!=nil{t.Fatal(err)}
 if r.state.CombatWorld.Cooldowns[scene.Guard+"\x00"+playerActorID]<=r.state.Life.Seconds{t.Fatal("escape immediately reopens automatic aggression")}
 if r.state.Combat.Active||!r.state.Combat.Actor(playerActorID).Withdrawn||r.state.Wounds.Ledger.Count(playerActorID)!=0{t.Fatal("real non-killing exit did not resolve the encounter")}
}
