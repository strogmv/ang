// A whole market day at x1, x10 and x30 (the game: the named people, the hero, the visitors and the night cabinet; no
// anonymous crowd): no body ever stands on a fixture cell or in another's work cells, no two bodies share a cell at the end
// of any tick, every visitor who walked in walked out within the limit, none was let out where he stood, and the day's
// purchases hold. WALKERS_RATE picks one rate.
// walkersVisitLimit (baseline fixes, 21.11, plan 11): a visit came to have two phases after the limit was written — a hot
// meal at a standing table (food court v1.1, game ba732d0b: tables.eat_ticks) and a stop with the musician (listen_ticks or
// paying him); the limit is the 15 minutes plus the longest of each, from the data.
func walkersVisitLimit(r *Runtime) int64 {
	limit := walkersVisitLimitTicks + r.buskerMaxWait()
	if v := r.world.Visitors; v.Tables != nil {
		limit += v.Tables.EatTicks.Max
	}
	return limit
}

func TestWalkersSolidBodiesThroughAMarketDay(t *testing.T) {
	if testing.Short() {
		t.Skip("a whole market day at three rates")
	}
	for _, rate := range walkersRates(t) {
		t.Run(fmt.Sprint(rate), func(t *testing.T) {
			r := visitorsRuntime(t, 30)
			v := r.world.Visitors
			// from midnight: the night round of the cabinet, the opening, the day, the closing
			visitorsRun(t, r, 86400-r.state.Life.Seconds%86400, nil)
			r.state.Life.SecondsPerTick = rate
			before := r.state.Visitors.clone().Ledger
			cabinet := false
			ticks := 0
			visitorsRun(t, r, 86400, func() {
				ticks++
				if err := walkersCheck(r, v.Level); err != nil {
					t.Fatalf("x%d, second %d of the day: %v", rate, r.state.Life.Seconds%86400, err)
				}
				cabinet = cabinet || len(r.vendingRobotCells()) > 0
			})
			l := r.state.Visitors.Ledger
			bought := l.Purchases - before.Purchases
			t.Logf("x%d: %d ticks; walked %d, out %d, longest visit %d ticks, stuck %d, gave up %d stalls, side steps %d, ways round %d; purchases %d; cabinet waits %d",
				rate, ticks, l.Walked-before.Walked, l.Out-before.Out, l.Longest, l.Stuck-before.Stuck, l.GaveUp-before.GaveUp, l.Asides-before.Asides, l.Detours-before.Detours, bought, r.state.Vending.Robot.Waits)
			if !cabinet && len(r.world.Vending.Units) > 0 {
				t.Fatal("the cabinet did not drive its night round")
			}
			if l.Stuck != before.Stuck {
				t.Fatalf("%d visitors found no free way out and were let out where they stood", l.Stuck-before.Stuck)
			}
			if limit := walkersVisitLimit(r); l.Longest > limit {
				t.Fatalf("the longest visit took %d ticks, limit %d", l.Longest, limit)
			}
			if l.Out == before.Out {
				t.Fatal("no walker walked out")
			}
			if bought < walkersDayPurchasesLow || bought > walkersDayPurchasesHigh {
				t.Fatalf("visitor purchases of the day %d, the range is %d..%d", bought, walkersDayPurchasesLow, walkersDayPurchasesHigh)
			}
			if r.state.Vending.Robot.Phase != "done" && r.state.Vending.Robot.Phase != "" {
				t.Fatalf("the cabinet is still on its round (%s) at the end of the day", r.state.Vending.Robot.Phase)
			}
		})
	}
}

