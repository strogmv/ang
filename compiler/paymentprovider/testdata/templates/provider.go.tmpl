		return nil, fmt.Errorf("%s: parent transaction has no ForeignId", ppSID)
	}
	secrets, err := pp.parseProviderSecrets(mc, opPayin)
	if err != nil {
		return nil, err
	}
	_ = secrets

	path := {{ .RefundEndpointConst }}
{{- if .UseOperationRuntime }}
	path = pp.operationEndpointPath("init_refund", path)
{{- end }}

{{- if .RefundRequest }}
	req := &{{ .RefundRequest.Name }}{
	{{- range .RefundRequest.Fields }}
		{{ .GoName }}: {{ .GoExpr }},
	{{- end }}
	}
{{- else }}
	req := &{{ .RefundRequestType }}{
		// TODO: fill refund fields
	}
{{- end }}
	headers := httpcli.NewHeaders().Add("Content-Type", "application/json")
	respBody, err := pp.httpClient.Post(tx, mc.ApiEndpoint+path, req, headers)
	if err != nil {
		if httpcli.IsBadRequestError(err) {
{{- template "declineBadRequestPayment" . }}
		}
		if httpcli.IsUnexpectedError(err) {
			return &model.PaymentResponse{
				Timestamp: time.Now(),
				Status:    tnxStatusPending,
				Code:      model.SCodeOk,
				Message:   providers.ProviderInternalErrNotFinal,
			}, nil
		}
		return nil, fmt.Errorf("calling %s refund: %w", ppSID, err)
	}
	var resp {{ .RefundResponseType }}
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}
	return &model.PaymentResponse{
		Timestamp: time.Now(),
		Status:    tnxStatusPending,
		Code:      model.SCodeOk,
		ForeignId: resp.{{ .RefundForeignIDField }},
	}, nil
{{- else }}
	return nil, providers.ErrNotImplemented
{{- end }}
}

{{ if .HasP2P -}}
func (pp *{{ .StructName }}) InitPayP2P(mc *model.MerchantCreds, ps *model.PaymentSource, tx *model.Transaction) (*model.P2PInitResponse, error) {
	if ps.APM == nil {
		return nil, providers.ErrAPMSupportOnly
	}
{{- if .SupportedMethods }}
	if !isSupportedP2PMethod(tx.Order.PaymentMethodBrand) {
		return nil, providers.ErrUnsupportedPaymentMethod
	}
{{- else if .P2PMethodCheck }}
	if !types.{{ .P2PMethodCheck }}.Equal(tx.Order.PaymentMethodBrand) {
		return nil, providers.ErrUnsupportedPaymentMethod
	}
{{- end }}
{{- if .HasMultiCurrency }}
	if !isSupportedCurrency(tx.Currency) {
		return nil, fmt.Errorf("%w: %s", providers.ErrUnsupportedCurrency, tx.Currency)
	}
{{- else }}
	if tx.Currency != currency.{{ .CurrencyCode }}Currency {
		return nil, fmt.Errorf("%w: %s", providers.ErrUnsupportedCurrency, tx.Currency)
	}
{{- end }}

	info := ps.APM.OwnerInfo

	secrets, err := pp.parseProviderSecrets(mc, opP2P)
	if err != nil {
		return nil, err
	}

{{- if .HasP2PDualEndpoint }}
	path := p2pInitEndpoint(tx.Order.PaymentMethodBrand)
{{- else }}
	path := {{ .PayinEndpointConst }}
{{- end }}
{{- if .UseOperationRuntime }}
	path = pp.operationEndpointPath("init_pay_p2p", path)
{{- end }}

{{- if .UseTransfertyH2H }}
	customerID := helpers.MapGet(info, providers.ExternalCustomerIDKey, tx.Id)
	req := &p2pInitRequest{
		OrderID:          tx.Id,
		OrderDescription: tx.Order.Description,
		Amount:           tx.Amount,
		Currency:         tx.Currency,
		CustomerID:       customerID,
		CustomerIP:       tx.Order.IP,
		CallbackURL:      tx.CallbackURL,
		ResultURL:        tx.Order.ResultUrl,
	}
	if path == {{ .P2PAPMEndpointConst }} {
		req.Method = tx.Order.PaymentMethodBrand
	}

	headers := pp.authHeaders(secrets)
{{- else if .UseMacanP2P }}
	methodName, err := macanPaymentMethodName(tx.Order.PaymentMethodBrand, tx.Currency)
	if err != nil {
		return nil, err
	}
	customerID := helpers.MapGet(info, providers.ExternalCustomerIDKey, tx.Id)
	req := &macanPayInRequest{
		Amount:        helpers.FloatAmount(tx.Amount, tx.Currency),
		PaymentMethod: macanPaymentMethod{Name: methodName},
		Customer:      macanCustomer{ID: customerID},
		ExternalID:    tx.Id,
		CallbackURL:   tx.CallbackURL,
		SuccessURL:    tx.Order.ResultUrl,
		IsRedirect:    !secrets.returnRecipientDetails,
	}
	if bankCode := macanBankCode(info); bankCode != "" {
		req.Bank = &macanBank{Code: bankCode}
	}
	headers := pp.authHeaders(secrets)
{{- else }}
{{ if .P2PRequest -}}
	req := &{{ .P2PRequest.Name }}{
	{{- range .P2PRequest.Fields }}
		{{ .GoName }}: {{ .GoExpr }},
	{{- end }}
	}
{{ else -}}
	req := &{{ .PayinRequestType }}{
		// TODO: fill P2P fields
	}
{{ end -}}
	_ = info
	headers := httpcli.NewHeaders().Add("Content-Type", "application/json")
{{- end }}

{{- if .UseMacanP2P }}
	var resp macanPayInResponse
	respBody, respHeaders, respStatus, err := pp.httpClient.PostWithResponse(tx, mc.ApiEndpoint+path, req, headers, &resp)
{{- else }}
	respBody, err := pp.httpClient.Post(tx, mc.ApiEndpoint+path, req, headers)
{{- end }}
	if err != nil {
{{- if .UseMacanP2P }}
		if respBody != nil {
			pp.txPathLogger.Log(tx, model.LogActionTypeResponse, respStatus,
				pp.httpClient.LogRawResponseDetails(respBody, respHeaders))
		}
{{- end }}
		if httpcli.IsUnexpectedError(err) {
			return &model.P2PInitResponse{
				Timestamp: time.Now(),
				Status:    tnxStatusError,
				Code:      model.SCodeInternalError,
				Message:   model.SCodeInternalError.Description(),
			}, nil
		}
		if httpcli.IsBadRequestError(err) {
{{- if .UseMacanP2P }}
			if st, code, msg, ok := macanPaymentDecline(respBody); ok {
				return &model.P2PInitResponse{Timestamp: time.Now(), Status: st, Code: code, Message: msg}, nil
			}
{{- end }}
			return &model.P2PInitResponse{
				Timestamp: time.Now(),
				Status:    tnxStatusDeclined,
				Code:      model.SCodeDeclinedByBank,
				Message:   model.SCodeDeclinedByBank.Description(),
			}, nil
		}
		return nil, fmt.Errorf("calling %s p2p: %w", ppSID, err)
	}

{{- if .UseTransfertyH2H }}
	var resp h2hPaymentResponse
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}

	out := &model.P2PInitResponse{Timestamp: time.Now()}
	if resp.Code != 0 {
		out.Status, out.Code, out.Message = mapH2HResponseCode(resp.Code)
		if resp.Transaction.ID != "" {
			out.ForeignId = resp.Transaction.ID
		}
		return out, nil
	}
	out.ForeignId = resp.Transaction.ID
	out.Status, out.Code, out.Message = mapH2HTxnStatus(resp.Transaction.Status, resp.Transaction.StatusCode)

	if resp.RedirectURL != "" {
		link, err := pp.tdsRedirector.GetTDSLink(&model.TDSLinkContent{
			TransactionID: tx.Id,
			Code:          http.StatusMovedPermanently,
			Headers:       map[string]string{"Location": resp.RedirectURL},
		})
		if err != nil {
			return nil, fmt.Errorf(providers.ErrCantGet3DSLinkFmt, err)
		}
		out.RedirectUrl = link
	}
	return out, nil
{{- else if .UseMacanP2P }}
	out := &model.P2PInitResponse{Timestamp: time.Now(), ForeignId: resp.PayIn.ID}
	out.Status, out.Code, out.Message = macanPayInStatus(providerStatus(resp.PayIn.Status), resp.PayIn.StatusDetails)
	if resp.PayIn.ID == "" {
		if out.Status == tnxStatusPending {
			out.Status = tnxStatusDeclined
			out.Code = model.SCodeDeclinedByBank
		}
		if out.Message == "" || out.Message == model.SCodeOk.Description() {
			if resp.PayIn.StatusDetails != "" {
				out.Message = resp.PayIn.StatusDetails
			} else {
				out.Message = "pay-in response without provider id"
			}
		}
		return out, nil
	}
	syncExchangedAmount(tx, resp.PayIn.Amount)
	if !secrets.returnRecipientDetails && resp.PayIn.RedirectURL != "" {
		link, err := pp.tdsRedirector.GetTDSLink(&model.TDSLinkContent{
			TransactionID: tx.Id,
			Code:          http.StatusMovedPermanently,
			Headers:       map[string]string{"Location": resp.PayIn.RedirectURL},
		})
		if err != nil {
			return nil, fmt.Errorf(providers.ErrCantGet3DSLinkFmt, err)
		}
		out.RedirectUrl = link
	}
	if secrets.returnRecipientDetails {
		if rd := macanRecipientDetails(resp.PayIn.Requisites); rd != nil {
			out.RecipientDetails = rd
		}
	}
	return out, nil
{{- else }}
	var resp {{ .PayinResponseType }}
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalRespFmt, err)
	}

	return &model.P2PInitResponse{
		Timestamp: time.Now(),
		Status:    tnxStatusPending,
		Code:      model.SCodeOk,
		ForeignId: resp.{{ .PayinForeignIDField }},
	}, nil
{{- end }}
}
{{ else -}}
