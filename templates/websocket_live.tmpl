// liveRoomToken reports whether a room id can be a subject token.
func liveRoomToken(room string) bool {
	if room == "" || len(room) > 128 {
		return false
	}
	for _, r := range room {
		if !(r == '-' || r == '_' || (r >= '0' && r <= '9') || (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z')) {
			return false
		}
	}
	return true
}

func liveHash(s string) uint64 {
	h := fnv.New64a()
	_, _ = h.Write([]byte(s))
	return h.Sum64()
}

// StartLiveRooms connects the live endpoints to JetStream. It returns at once;
// until the stream is ready (NATS without JetStream, broker down) it retries
// every 15 s and sockets get the plain event relay meanwhile.
func StartLiveRooms(ctx context.Context, nc *nats.Conn, log *slog.Logger) {
	if nc == nil || strings.EqualFold(strings.TrimSpace(os.Getenv("LIVE_ROOMS")), "off") {
		return
	}
	liveEndpointsMu.Lock()
	eps := make([]*liveEndpoint, 0, len(liveEndpoints))
	for _, ep := range liveEndpoints {
		eps = append(eps, ep)
	}
	liveEndpointsMu.Unlock()
	if len(eps) == 0 {
		return
	}
	go func() {
		for {
			rt, err := liveSetup(ctx, nc, log, eps)
			if err == nil {
				liveActiveRT.Store(rt)
				log.Info("live rooms ready", "stream", liveStreamName, "endpoints", len(eps))
				go liveSweep(ctx, eps)
				return
			}
			log.Warn("live rooms unavailable; sockets get the event relay", "error", err, "retry_in", "15s")
			select {
			case <-ctx.Done():
				return
			case <-time.After(15 * time.Second):
			}
		}
	}()
}

func liveSetup(ctx context.Context, nc *nats.Conn, log *slog.Logger, eps []*liveEndpoint) (*liveRuntime, error) {
	js, err := jetstream.New(nc)
	if err != nil {
		return nil, err
	}
	storage := jetstream.FileStorage
	if strings.EqualFold(strings.TrimSpace(os.Getenv("LIVE_ROOMS_STORAGE")), "memory") {
		storage = jetstream.MemoryStorage
	}
	cfg := jetstream.StreamConfig{
		Name:              liveStreamName,
		Description:       "Live WebSocket room states (generated by ANG)",
		Subjects:          []string{liveSubjectPrefix + ">"},
		Storage:           storage,
		Replicas:          liveEnvInt("LIVE_ROOMS_REPLICAS", 1),
		MaxAge:            liveEnvDuration("LIVE_ROOMS_MAX_AGE", 24*time.Hour),
		MaxMsgsPerSubject: int64(liveEnvInt("LIVE_ROOMS_MAX_PER_ROOM", 200)),
		Discard:           jetstream.DiscardOld,
		AllowDirect:       true,
	}
	setupCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()
	stream, err := js.CreateOrUpdateStream(setupCtx, cfg)
	if err != nil {
		// A stream made with other settings (storage cannot change in place)
		// still works; keep it and say so.
		existing, getErr := js.Stream(setupCtx, liveStreamName)
		if getErr != nil {
			return nil, fmt.Errorf("stream %s: %w", liveStreamName, err)
		}
		log.Warn("live rooms: stream settings not updated", "stream", liveStreamName, "error", err)
		stream = existing
	}
	rt := &liveRuntime{js: js, stream: stream, nc: nc, log: log, replayMax: liveEnvInt("LIVE_ROOMS_REPLAY_MAX", 50)}
	for _, ep := range eps {
		ep := ep
		cons, err := stream.OrderedConsumer(setupCtx, jetstream.OrderedConsumerConfig{
			FilterSubjects: []string{liveSubjectPrefix + ep.name + ".>"},
			DeliverPolicy:  jetstream.DeliverNewPolicy,
		})
		if err != nil {
			return nil, fmt.Errorf("consumer for %s: %w", ep.name, err)
		}
		if _, err := cons.Consume(func(msg jetstream.Msg) {
			defer func() {
				if r := recover(); r != nil {
					log.Error("live room consumer panic recovered", "endpoint", ep.name, "panic", r)
				}
			}()
			meta, err := msg.Metadata()
			if err != nil {
				return
			}
			room := strings.TrimPrefix(msg.Subject(), liveSubjectPrefix+ep.name+".")
			prev, _ := strconv.ParseUint(msg.Headers().Get(livePrevSeqHeader), 10, 64)
			data := string(msg.Data())
			ep.onStored(rt, room, &liveState{seq: meta.Sequence.Stream, prev: prev, data: data, hash: liveHash(data)}, true)
		}); err != nil {
			return nil, fmt.Errorf("consume %s: %w", ep.name, err)
