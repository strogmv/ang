# Generated by ANG. Shared native visual guards for review and ordinary proof.
extends RefCounted

static func _visible_rect(control: Control) -> Rect2:
	var bounds := control.get_global_rect()
	var node := control.get_parent()
	while node is Control:
		if node.clip_contents:
			bounds = bounds.intersection(node.get_global_rect())
		node = node.get_parent()
	return bounds

static func inspect(screen: Control) -> Array[String]:
	var failures: Array[String] = []
	if screen.spec.layout == "hud":
		var viewport := Rect2(Vector2.ZERO, screen.get_viewport_rect().size)
		var data: Array = screen.spec.get("clear_rect", [])
		var clear := Rect2()
		if data.size() == 4:
			clear = Rect2(data[0], data[1], data[2], data[3])
		for panel in screen.content.find_children("*", "PanelContainer", true, false):
			if not panel.has_meta("hud_panel") or not panel.is_visible_in_tree():
				continue
			var bounds: Rect2 = panel.get_global_rect()
			if not viewport.encloses(bounds):
				failures.append("HUD panel crosses viewport: " + str(panel.get_meta("hud_panel")))
			if clear.has_area() and bounds.intersects(clear):
				failures.append("HUD panel overlaps clear_rect: " + str(panel.get_meta("hud_panel")))
	var geometry: Dictionary = screen.chrome.guard_geometry()
	var raw_id := RegEx.new()
	raw_id.compile("(?i)\\b(slot[0-9]+|actor\\.char[^\\s]*|item\\.[^\\s]*|ui\\.[^\\s]*)")
	for control in screen.find_children("*", "Control", true, false):
		if not control.is_visible_in_tree():
			continue
		for copy in control.get_meta("visible_texts", []):
			if raw_id.search(str(copy)) != null:
				failures.append("raw id rendered by widget: " + str(copy))
		if control is Label or control is Button or control.get_meta("guard_control", false):
			var copy: String = control.text if control is Label or control is Button else control.name
			if raw_id.search(copy) != null:
				failures.append("raw id rendered: " + copy)
			var visible_rect := _visible_rect(control)
			if not geometry.is_empty() and screen.content.is_ancestor_of(control):
				if visible_rect.has_area() and not geometry.inner.encloses(visible_rect):
					failures.append("control crosses inner border: " + copy)
				for corner in geometry.corners:
					if visible_rect.intersects(corner):
						failures.append("control overlaps corner ornament: " + copy)
		if control.has_meta("expected_ordinal"):
			var expected: int = control.get_meta("expected_ordinal")
			if control.index != expected or control.ordinal.text != str(TranslationServer.translate(
				"ui.format.ordinal")) % expected:
				failures.append("row ordinal does not match list position: " + str(expected))
	return failures

