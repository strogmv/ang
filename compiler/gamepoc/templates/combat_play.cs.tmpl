  void CombatResetPresentation(bool skip){combatQueue.Clear();combatFx.Clear();combatWoundNotes.Clear();CombatBloodClear();combatSkip=skip;combatEncounter="";combatSeq=0;combatBeatAt=-1;foreach(var b in combatBodies.Values)if(b.ring!=null)Destroy(b.ring.gameObject);combatBodies.Clear();}

  // Duration of the played part of a clip (the take's length from the cast's controller x (until - from) / speed); a
  // missing clip uses the fallback.
  float CombatClipSeconds(Animator an,PocCombatClip clip,float fallback){
   var controllerAsset=CombatControllerAsset(an);if(clip==null||an==null||controllerAsset==null)return fallback;
   Dictionary<string,float> lengths;if(!combatClipLengths.TryGetValue(controllerAsset,out lengths)){lengths=new Dictionary<string,float>(StringComparer.Ordinal);foreach(var c in controllerAsset.animationClips)if(c!=null)lengths[c.name]=c.length;combatClipLengths[controllerAsset]=lengths;}
   float len;return lengths.TryGetValue(clip.state,out len)&&len>0?len*Mathf.Clamp(CombatPart(clip),.02f,1f)/Mathf.Max(.25f,clip.speed):fallback;
  }
  static float CombatPart(PocCombatClip c){float u=c.until<=0?1:c.until;return Mathf.Max(.02f,u-Mathf.Clamp(c.from,0,.98f));}
  // Normalized time in the take for a share p (0..1) of the played part.
  static float CombatClipPhase(PocCombatClip c,float p){if(c.hold_at>=0)p=c.hold_at;p=Mathf.Clamp01(p);if(c.reverse)p=1-p;return Mathf.Clamp(c.from+p*CombatPart(c),0,.999f);}
  LocationSDKHumanoid CombatHumanoid(string id){LocationSDKHumanoid h;return locationSDKHumanoids.TryGetValue(id,out h)?h:null;}
  void CombatBeginBeat(CombatBeat b){
   var look=CombatLook();combatBeatAt=CombatNow;var h=CombatHumanoid(b.actor);var an=h==null?null:h.animator;
   switch(b.kind){
    case "move":{float d=0;var at=b.from;CombatBody body;if(combatBodies.TryGetValue(b.actor,out body)&&body.placed)at=body.cell;var prev=at;foreach(var c in b.path){d+=Vector2.Distance(prev,c);prev=c;}b.seconds=Mathf.Max(.15f,d*locationSDKLevel.cell_meters/Mathf.Max(.3f,look==null?1.4f:look.move_mps));break;}
    case "attack":{if(b.pair&&look!=null&&look.throat!=null){CombatPairBegin(b,look);break;}CombatBody shownBody;string shownWeapon=combatBodies.TryGetValue(b.actor,out shownBody)&&!string.IsNullOrEmpty(shownBody.held)?shownBody.held:CombatHeld(b.actor);var w=CombatWeapon(shownWeapon);b.clip=CombatStrikeClip(w,b);{var bl=look==null?null:look.baton;if(bl!=null&&w!=null&&(w.prop=="baton"||w.prop=="pipe")&&CombatClipSet(bl.strike_near)&&(b.rear||b.part=="head"||b.zone=="head"||b.zone=="neck")){b.batonStrike=true;var ah=h;var vh=CombatHumanoid(b.target);float gap=ah==null||vh==null?1f:Vector3.Distance(ah.go.transform.position,vh.go.transform.position);bool low=ah!=null&&(ah.state==locationSDKHumanoidCast.crouch_idle_state||ah.state==locationSDKHumanoidCast.crouch_walk_state);b.clip=gap>=bl.long_from_m?(low?bl.strike_crouch:bl.strike_long):bl.strike_near;}}b.bodyStrike=b.clip!=null&&b.clip.layer=="body"&&w!=null&&(w.prop=="knife"||b.batonStrike);if(b.bodyStrike){CombatBody vb;b.victimStance=CombatWeapon(combatBodies.TryGetValue(b.target,out vb)&&!string.IsNullOrEmpty(vb.held)?vb.held:CombatHeld(b.target));}b.seconds=CombatClipSeconds(an,b.clip,1f);b.impact=b.clip==null?.5f:Mathf.Clamp(b.clip.impact,.05f,.95f);
     if(look!=null){b.reaction=b.targetDown?CombatFallClip(b.target):b.targetStunned?look.stun:b.parried?look.parry:!b.hit?look.dodge:w!=null&&w.prop=="needle_gun"?look.hit_shot:b.part=="head"?look.hit_head:look.hit;if(b.batonStrike&&b.hit&&!b.targetDown&&!b.targetStunned&&look.baton!=null)b.reaction=b.rear?look.baton.stood_rear:look.baton.stood_front;if(!b.batonStrike&&b.bodyStrike&&b.hit&&!string.IsNullOrEmpty(b.zone)&&look.zone_reactions!=null){b.zr=Array.Find(look.zone_reactions,z=>z.zone==b.zone);if(b.zr!=null&&!b.targetDown&&!b.targetStunned&&CombatClipSet(b.zr.clip))b.reaction=b.zr.clip;}if(b.bodyStrike&&!b.hit&&!b.parried&&!b.targetDown&&CombatClipSet(look.blade_miss))b.reaction=look.blade_miss;}
