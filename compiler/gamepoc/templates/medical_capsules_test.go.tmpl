func medicalInjure(t *testing.T, r *Runtime, id string, rich bool) {
	t.Helper()
	c := r.combatant(id, "player")
	b := combatBody(c)
	if _, err := combatWounds.ApplyCondition(&b, "burn.contact", "", r.state.Seed); err != nil {
		t.Fatal(err)
	}
	projectWoundBody(&c, b)
	if r.state.CombatRoster == nil {
		r.state.CombatRoster = map[string]behavior.Combatant{}
	}
	r.state.CombatRoster[id] = c
	r.storeWoundBody(c)
	r.combatCareTrack()
	a, ok := r.medicalAccount(id)
	if !ok {
		t.Fatalf("no account %s", id)
	}
	a.Balance = 0
	if rich {
		a.Balance = 100000
	}
	r.state.Inventory.Accounts[a.ID] = a
}
func medicalAdvance(t *testing.T, r *Runtime, seconds float64) {
	t.Helper()
	n := int(seconds * float64(r.world.Config.TickHz))
	for i := 0; i < n; i++ {
		r.state.Tick++
		r.state.Life.Tick = r.state.Tick
		if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
			t.Fatal(err)
		}
		if err := r.advanceMedicalCapsules(); err != nil {
			t.Fatal(err)
		}
	}
}
func medicalEnter(t *testing.T, r *Runtime) medicalPatient {
	t.Helper()
	u := r.world.MedicalCapsules.Units[0]
	if err := r.medicalRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	if err := r.advanceMedicalCapsules(); err != nil {
		t.Fatal(err)
	}
	medicalAdvance(t, r, r.world.MedicalCapsules.ScanSeconds)
	p := r.state.Medical.Patients[playerActorID]
	if p.Phase != "offer" {
		t.Fatalf("no offer %+v", p)
	}
	if err := r.medicalAccept(playerActorID, u.ID, p.OfferID); err != nil {
		t.Fatal(err)
	}
	return r.state.Medical.Patients[playerActorID]
}
func TestMedicalRealDebitHealSaveNoFloor(t *testing.T) {
	r := medicalFixture(t)
	medicalInjure(t, r, playerActorID, true)
	before, _ := r.medicalAccount(playerActorID)
	receiver := r.state.Inventory.Accounts[r.world.MedicalCapsules.ReceiverAccount]
	p := medicalEnter(t, r)
	hero := r.state.Life.Actor(playerActorID)
	if hero.OnFloor() {
		t.Fatal("patient still on floor")
	}
	r.state.Life.EnsureHeroBody(r.world.Life)
	if hero.Body != nil {
		t.Fatal("duplicate floor body")
	}
	medicalAdvance(t, r, r.world.MedicalCapsules.EntrySeconds)
	p = r.state.Medical.Patients[playerActorID]
	if p.Phase != "treatment" {
		t.Fatalf("care not started %+v", p)
	}
	after, _ := r.medicalAccount(playerActorID)
	if before.Balance-after.Balance != p.Quote.PriceMinor || p.Quote.PriceMinor <= 0 {
		t.Fatal("missing real debit")
	}
	if r.state.Inventory.Accounts[receiver.ID].Balance-receiver.Balance != p.Quote.PriceMinor {
		t.Fatal("money not conserved")
	}
	snapshot := r.snapshotState()
	if err := r.medicalAccept(playerActorID, p.UnitID, p.OfferID); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(snapshot.Inventory, r.state.Inventory) {
		t.Fatal("accept replay charged twice")
	}
	if err := r.validateMedical(snapshot); err != nil {
		t.Fatal(err)
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, snapshot); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(loaded.Medical.clone(), snapshot.Medical.clone()) {
		t.Fatal("lost service save")
	}
	r.state = loaded
	old := combatBody(r.state.CombatRoster[playerActorID])
	r.state.Life.Seconds += p.Quote.Seconds
	if err := r.advanceWoundCare(); err != nil {
		t.Fatal(err)
	}
	b := combatBody(r.state.CombatRoster[playerActorID])
	if b.Clock-old.Clock != p.Quote.Seconds || b.Care != nil || len(b.Conditions) != 0 {
		t.Fatalf("not healed exactly once: %+v", b)
	}
	if err := r.advanceWoundCare(); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(b, combatBody(r.state.CombatRoster[playerActorID])) {
		t.Fatal("double wound tick")
	}
	if err := r.advanceMedicalCapsules(); err != nil {
		t.Fatal(err)
	}
	medicalAdvance(t, r, r.world.MedicalCapsules.ExitSeconds)
	if _, ok := r.state.Medical.Patients[playerActorID]; ok {
		t.Fatal("not released")
	}
	if !r.state.Life.Actor(playerActorID).OnFloor() {
		t.Fatal("no floor on release")
	}
}
func TestMedicalFreeStabilizationAndPause(t *testing.T) {
	r := medicalFixture(t)
	medicalInjure(t, r, playerActorID, false)
	p := medicalEnter(t, r)
	if p.Quote.Mode != "stabilize" || p.Quote.PriceMinor != 0 {
		t.Fatalf("wrong core fallback %+v", p.Quote)
	}
	r.state.Paused = true
	s := r.snapshotState()
	r.step()
	if !reflect.DeepEqual(s.Medical, r.snapshotState().Medical) || s.Tick != r.state.Tick || !reflect.DeepEqual(s.Wounds, r.snapshotState().Wounds) {
		t.Fatal("pause advanced patient")
	}
	r.state.Paused = false
	cursor := r.state.Inventory.Cursors[playerActorID]
	medicalAdvance(t, r, r.world.MedicalCapsules.EntrySeconds)
	if r.state.Medical.Patients[playerActorID].Phase != "treatment" {
		t.Fatal("stabilization not started")
	}
	if !reflect.DeepEqual(r.state.Inventory.Cursors[playerActorID], cursor) {
		t.Fatal("free stabilization debited")
	}
}
func TestMedicalDeadNoChipStaleQuoteAndLease(t *testing.T) {
	r := medicalFixture(t)
	medicalInjure(t, r, playerActorID, true)
	u := r.world.MedicalCapsules.Units[0]
	c := r.state.CombatRoster[playerActorID]
	b := combatBody(c)
	b.Dead = true
	projectWoundBody(&c, b)
	r.state.CombatRoster[playerActorID] = c
	r.storeWoundBody(c)
	if err := r.medicalRequest(playerActorID, u.ID); err == nil {
		t.Fatal("dead entered")
	}
	b.Dead = false
	b.Chip = "none"
	projectWoundBody(&c, b)
	r.state.CombatRoster[playerActorID] = c
	r.storeWoundBody(c)
	q, err := r.medicalQuote(playerActorID, u)
	if err != nil || q.Reason != "wounds.care.no_chip" {
		t.Fatalf("no-chip core refusal %+v %v", q, err)
	}
	r = medicalFixture(t)
	medicalInjure(t, r, playerActorID, true)
	if err := r.medicalRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	r.advanceMedicalCapsules()
	medicalAdvance(t, r, r.world.MedicalCapsules.ScanSeconds)
	p := r.state.Medical.Patients[playerActorID]
	a, _ := r.medicalAccount(playerActorID)
	a.Balance = 0
	r.state.Inventory.Accounts[a.ID] = a
	if err := r.medicalAccept(playerActorID, u.ID, p.OfferID); err == nil {
		t.Fatal("stale quote entered")
	}
	if r.medicalAttached(playerActorID) {
		t.Fatal("stale attachment")
	}
	medicalAdvance(t, r, float64(r.world.MedicalCapsules.LeaseSeconds))
	if r.medicalReserved(playerActorID) {
		t.Fatal("expired lease retained")
	}
}

