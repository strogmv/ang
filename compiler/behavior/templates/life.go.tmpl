}
func(s *LifeState)Actor(id string)*LifeActor{for i:=range s.Actors{if s.Actors[i].ID==id{return &s.Actors[i]}};return nil}
func(s *LifeState)note(text string){s.Events=append(s.Events,fmt.Sprintf("%02d:%02d · %s",s.Seconds%86400/3600,s.Seconds%3600/60,text));if len(s.Events)>64{s.Events=append([]string(nil),s.Events[len(s.Events)-64:]...)}}
func(s LifeState)occupied(level string,at Cell,except string)bool{for _,a:=range s.Population.Actors{if a.Materialized&&a.Trip==nil&&a.Level==level&&(a.Position==at||(len(a.Path)>0&&a.Path[0]==at)){return true}};for _,a:=range s.Actors{if a.ID!=except&&a.Trip==nil&&a.Level==level&&(a.Position==at||(len(a.Path)>0&&a.Path[0]==at)){return true}};return false}
