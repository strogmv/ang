apiVersion: v1
kind: Service
metadata:
  name: {{ .Name | ToLower }}
spec:
  selector:
    app: {{ .Name | ToLower }}
  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: 8080
    {{- if MetricsPort }}
    - name: metrics
      protocol: TCP
      port: {{ MetricsPort }}
      targetPort: {{ MetricsPort }}
    {{- end }}
