    prop=combatProps[h.id];var victim=CombatHumanoid(beat.target);if(victim==null||victim.animator==null||prop.go==null)continue;
    var hand=h.animator.GetBoneTransform(HumanBodyBones.RightHand);if(hand==null)continue;
    Transform tip=null;foreach(var child in prop.go.GetComponentsInChildren<Transform>())if(child.name=="contact_tip"){tip=child;break;}if(tip==null)continue;
