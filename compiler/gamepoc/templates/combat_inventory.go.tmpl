// Code generated by ANG. Tactical counters are projections of physical custody.
package poc

import (
	"errors"
	"fmt"
	"sort"
	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
)

func combatItemKeys(s inv.State) []string {
	keys:=make([]string,0,len(s.Items));for id:=range s.Items{keys=append(keys,id)};sort.Strings(keys);return keys
}

// A usable carried item must be owned, unreserved and reachable through every
// container. A locked backpack is not a magical ammunition/first-aid pocket.
func (r *Runtime) combatCarried(s inv.State,actor string,item inv.Item) bool {
	m:=r.inventoryModelFor(true)
	if item.Condition<=0||s.Reserved(m,item.ID){return false}
	l:=item.Location
	for depth:=0;depth<=m.MaxDepth;depth++ {
		if l.Kind!="store"{return false}
		st,ok:=s.Stores[l.Store];if !ok||st.Locked{return false}
		if st.Anchor.Kind=="actor"{return st.Anchor.Actor==actor}
		if st.Anchor.Kind!="item"{return false}
		parent,ok:=s.Items[st.Anchor.Item];if !ok{return false};l=parent.Location
	}
	return false
}

func (r *Runtime) equippedCombatItem(s inv.State,actor string) (inv.Item,behavior.CombatWeapon,bool) {
	for _,slot:=range []string{"hand.main","hand.off"}{
	for _,id:=range combatItemKeys(s) {
		i:=s.Items[id];w,known:=r.world.CombatRuntime.Weapons[i.Definition];d:=r.world.Inventory.Definitions[i.Definition]
		if !known||i.Location.Store!=inv.ActorStore(actor)||i.Location.Slot!=slot||i.Condition<d.WearPerUse||d.WearPerUse<1||!r.combatCarried(s,actor,i){continue}
		return i,w,true
	}
	}
	return inv.Item{},behavior.CombatWeapon{},false
}

func(r *Runtime)combatEquipmentOptions(actor string)[]behavior.CombatEquipmentOption{
 s:=r.state.Inventory;current,_,_:=r.equippedCombatItem(s,actor);var result []behavior.CombatEquipmentOption
 for _,id:=range combatItemKeys(s){
  item:=s.Items[id];weapon,known:=r.world.CombatRuntime.Weapons[item.Definition];definition:=r.world.Inventory.Definitions[item.Definition]
  if !known||id==current.ID||definition.WearPerUse<1||item.Condition<definition.WearPerUse||!r.combatCarried(s,actor,item){continue}
  if weapon.Magazine>0&&!r.craftingUsable(item.ID,actor){continue}
  if definition.EquipSlot!="hand.main"&&definition.EquipSlot!="hand.off"{continue}
  if definition.EquipSlot=="hand.off"&&current.Location.Slot=="hand.main"{continue}
  option:=behavior.CombatEquipmentOption{ID:id,Weapon:weapon,Risk:r.world.CombatRuntime.WeaponRisk[weapon.ID],UsesRemaining:int(item.Condition/definition.WearPerUse)}
  if weapon.Magazine>0{option.Ammo=r.combatCount(s,actor,weapon.AmmoDefinition,func(i inv.Item)bool{return i.Location.Store==inv.ItemStore(id)});option.ReserveAmmo=r.combatReserveAmmo(s,actor,weapon.AmmoDefinition)}
  result=append(result,option)
 }
 return result
}
func(r *Runtime)equipPhysicalCombat(s *inv.State,actor,id string)error{
 item,ok:=s.Items[id];definition:=r.world.Inventory.Definitions[item.Definition]
 if !ok||!r.combatCarried(*s,actor,item)||definition.WearPerUse<1||item.Condition<definition.WearPerUse{return errors.New("physical combat equipment unavailable")}
 if _,ok:=r.world.CombatRuntime.Weapons[item.Definition];!ok{return errors.New("not a tactical weapon")}
 if definition.EquipSlot!="hand.main"&&definition.EquipSlot!="hand.off"{return errors.New("weapon has no hand slot")}
 var moves []inv.Move
 for _,key:=range combatItemKeys(*s){old:=s.Items[key];if old.Location.Store==inv.ActorStore(actor)&&old.Location.Slot==definition.EquipSlot{moves=append(moves,inv.Move{Item:key,Quantity:old.Quantity,ExpectedRevision:old.Revision,To:inv.Location{Kind:"store",Store:inv.ActorStore(actor)}})}}
 moves=append(moves,inv.Move{Item:id,Quantity:item.Quantity,ExpectedRevision:item.Revision,To:inv.Location{Kind:"store",Store:inv.ActorStore(actor),Slot:definition.EquipSlot}})
 _,err:=s.Apply(r.inventoryModelFor(true),inv.Transaction{Actor:actor,Sequence:s.Cursors[actor].Sequence+1,RequestTag:fmt.Sprintf("combat/equip/%s/%d",id,s.Revision),Moves:moves})
 return err
}

func (r *Runtime) combatLoadedContainer(s inv.State,item inv.Item) bool {
	l:=item.Location
	for depth:=0;depth<=r.world.Inventory.MaxDepth&&l.Kind=="store";depth++ {
		st,ok:=s.Stores[l.Store];if !ok||st.Anchor.Kind!="item"{return false}
		parent,ok:=s.Items[st.Anchor.Item];if !ok{return false}
		if w,ok:=r.world.CombatRuntime.Weapons[parent.Definition];ok&&w.Magazine>0{return true}
		l=parent.Location
	}
	return false
}

func (r *Runtime) combatCount(s inv.State,actor,definition string,filter func(inv.Item)bool) int {
	n:=int64(0)
	for _,id:=range combatItemKeys(s) {
		i:=s.Items[id]
		if i.Owner==actor&&i.Definition==definition&&r.combatCarried(s,actor,i)&&(filter==nil||filter(i)){n+=i.Quantity;if n>1000000{return 1000000}}
	}
	return int(n)
}

func (r *Runtime) refreshCombatEquipment(s inv.State,a *behavior.Combatant) {
	profile:=r.world.CombatRuntime.Profiles[r.world.CombatRuntime.DefaultProfile]
	if name:=r.world.CombatRuntime.Actors[a.ID];name!=""{profile=r.world.CombatRuntime.Profiles[name]}
	a.Weapon=profile.Weapon;a.WeaponUsesLimited=false;a.WeaponUsesRemaining=0
	a.BodyArmor=behavior.CombatArmor{}
	a.Ammo=0;a.ReserveAmmo=0;a.Medkits=0;a.Explosives=nil
	if item,w,ok:=r.equippedCombatItem(s,a.ID);ok {
		a.Weapon=w;a.WeaponUsesLimited=true
		a.WeaponUsesRemaining=int(item.Condition/r.world.Inventory.Definitions[item.Definition].WearPerUse)
		if w.Magazine>0&&w.AmmoDefinition!=""{
			a.Ammo=r.combatCount(s,a.ID,w.AmmoDefinition,func(i inv.Item)bool{return i.Location.Kind=="store"&&i.Location.Store==inv.ItemStore(item.ID)})
			a.ReserveAmmo=r.combatReserveAmmo(s,a.ID,w.AmmoDefinition)
		}
	}
	for _,definition:=range r.woundAidItems() {a.Medkits+=r.combatCount(s,a.ID,definition,nil)}
	if a.Medkits>10000{a.Medkits=10000}
 a.BodyArmor=r.combatArmorFromInventory(s,a.ID)

	riskID:=a.Weapon.ID;if a.Weapon.WoundProfile!=""{riskID=a.Weapon.WoundProfile};a.BodyRisk=r.world.CombatRuntime.WeaponRisk[riskID];if a.BodyRisk<1{a.BodyRisk=r.world.CombatRuntime.WeaponRisk["unarmed"]}
 if len(a.Body)>0&&!a.BodyCanHold{a.WeaponUsesLimited=true;a.WeaponUsesRemaining=0}
 ids:=make([]string,0,len(r.world.CombatRuntime.Explosives));for id:=range r.world.CombatRuntime.Explosives{ids=append(ids,id)};sort.Strings(ids)
	for _,id:=range ids{n:=r.combatCount(s,a.ID,id,nil);if n>1000{n=1000};if n>0{a.Explosives=append(a.Explosives,behavior.CombatExplosiveStock{Explosive:r.world.CombatRuntime.Explosives[id],Count:n})}}
}

func (r *Runtime) consumeCombatStock(s *inv.State,actor,definition string,quantity int,filter func(inv.Item)bool) error {
	if quantity<0{return errors.New("negative combat consumption")};left:=int64(quantity)
	for _,id:=range combatItemKeys(*s) {
		if left==0{break};i:=s.Items[id]
		if i.Owner!=actor||i.Definition!=definition||!r.combatCarried(*s,actor,i)||(filter!=nil&&!filter(i)){continue}
		n:=min(i.Quantity,left)
		if err:=s.Consume(r.inventoryModelFor(true),actor,id,n);err!=nil{return err};left-=n
	}
	if left!=0{return errors.New("physical combat stock no longer available")};return nil
}

func (r *Runtime) reloadPhysicalCombat(s *inv.State,actor string,amount int) error {
	item,w,ok:=r.equippedCombatItem(*s,actor)
	if !ok||w.Magazine<1||w.AmmoDefinition==""||amount<1{return errors.New("physical magazine missing")}
	if store,ok:=s.Stores[inv.ItemStore(item.ID)];!ok||store.Locked{return errors.New("weapon has no accessible physical magazine storage")}
	loaded:=r.combatCount(*s,actor,w.AmmoDefinition,func(i inv.Item)bool{return i.Location.Store==inv.ItemStore(item.ID)})
	if loaded+amount>w.Magazine{return errors.New("magazine capacity exceeded")}
	if r.combatReserveAmmo(*s,actor,w.AmmoDefinition)<amount{return errors.New("compatible reserve exhausted")}
	draft:=s.Clone()
	left:=int64(amount);var moves []inv.Move
	for _,id:=range combatItemKeys(draft) {
		if left==0{break};i:=draft.Items[id]
		if i.Owner!=actor||i.Definition!=w.AmmoDefinition||!r.combatCarried(draft,actor,i)||r.combatLoadedContainer(draft,i){continue}
		n:=min(left,i.Quantity);moves=append(moves,inv.Move{Item:id,Quantity:n,ExpectedRevision:i.Revision,To:inv.Location{Kind:"store",Store:inv.ItemStore(item.ID)}});left-=n
	}
	if len(moves)>0{if _,err:=draft.Apply(r.inventoryModelFor(true),inv.Transaction{Actor:actor,Sequence:draft.Cursors[actor].Sequence+1,RequestTag:fmt.Sprintf("combat/reload/%d",draft.Revision),Moves:moves});err!=nil{return err}}
	for _,id:=range combatItemKeys(draft){
		for left>0{
			i,exists:=draft.Items[id];p,packed:=r.world.CombatRuntime.AmmoPacks[i.Definition]
			if !exists||!packed||p.AmmoDefinition!=w.AmmoDefinition||i.Owner!=actor||!r.combatCarried(draft,actor,i)||r.combatLoadedContainer(draft,i){break}
			n:=min(int(left),p.Rounds);if err:=r.unpackCombatAmmo(&draft,actor,id,item.ID,n);err!=nil{return err};left-=int64(n)
		}
		if left==0{break}
	}
	if left>0{return errors.New("compatible reserve exhausted")}
	*s=draft
	return nil
}

func (r *Runtime) applyCombatResources(s *inv.State,old behavior.CombatState,event behavior.CombatEvent) error {
	actor:=old.Actor(event.ActorID)
	if actor==nil{return errors.New("combat resource actor missing")}
	if event.Type=="equip"{if err:=r.equipPhysicalCombat(s,actor.ID,event.ItemID);err!=nil{return err}}
	if event.Type=="reload"&&event.Amount>0 {if err:=r.reloadPhysicalCombat(s,actor.ID,event.Amount);err!=nil{return err}}
	if event.AmmoSpent>0 {
		item,w,ok:=r.equippedCombatItem(*s,actor.ID)
		if !ok||w.ID!=actor.Weapon.ID||w.Magazine==0||w.AmmoDefinition==""{return errors.New("equipped firearm changed")}
  if !r.craftingUsable(item.ID,actor.ID){return errors.New("firearm binding or malfunction prevents firing")}
		if err:=r.consumeCombatStock(s,actor.ID,w.AmmoDefinition,event.AmmoSpent,func(i inv.Item)bool{return i.Location.Store==inv.ItemStore(item.ID)});err!=nil{return err}
	}
	if event.MedkitsSpent>0 {
		left:=event.MedkitsSpent
		for _,id:=range r.woundAidItems() {
			n:=min(left,r.combatCount(*s,actor.ID,id,nil));if n<1{continue}
			if err:=r.consumeCombatStock(s,actor.ID,id,n,nil);err!=nil{return err};left-=n
		}
		if left>0{return errors.New("medical materials exhausted")}
	}
	if event.ItemsSpent>0 {
		if _,ok:=r.world.CombatRuntime.Explosives[event.ItemID];!ok{return errors.New("unknown physical explosive")}
		if err:=r.consumeCombatStock(s,actor.ID,event.ItemID,event.ItemsSpent,nil);err!=nil{return err}
	}
	if event.WeaponUses>0&&actor.Weapon.ID!="unarmed" {
		item,w,ok:=r.equippedCombatItem(*s,actor.ID)
		if !ok||w.ID!=actor.Weapon.ID{return errors.New("equipped combat weapon changed")}
		wear:=r.world.Inventory.Definitions[item.Definition].WearPerUse*int64(event.WeaponUses)
		if wear<1||wear>item.Condition{return errors.New("weapon condition exhausted")}
		_,err:=s.Apply(r.inventoryModelFor(true),inv.Transaction{Actor:actor.ID,Sequence:s.Cursors[actor.ID].Sequence+1,RequestTag:fmt.Sprintf("combat/%s/%d",old.ID,event.Sequence),Wear:[]inv.Wear{{Item:item.ID,ExpectedRevision:item.Revision,Amount:wear}}})
		if err!=nil{return err}
	}
	if event.ArmorBlocked>0&&event.TargetID!=""{if err:=r.wearCombatArmor(s,event);err!=nil{return err}}
	return nil
}

func(r *Runtime)wearCombatArmor(s *inv.State,event behavior.CombatEvent)error{
 for _,id:=range combatItemKeys(*s){
  item:=s.Items[id];armor,ok:=r.world.CombatRuntime.Armor[item.Definition]
  if !ok||item.Location.Store!=inv.ActorStore(event.TargetID)||item.Location.Slot==""||!r.combatCarried(*s,event.TargetID,item){continue}
  protects:=armor.Torso;switch event.BodyPart{case "head":protects=armor.Head;case "arms":protects=armor.Arms;case "legs":protects=armor.Legs}
  if protects<=0{continue};wear:=r.world.Inventory.Definitions[item.Definition].WearPerUse*int64(event.ArmorBlocked);if wear<=0{return errors.New("protective equipment has no wear contract")};wear=min(wear,item.Condition)
  _,err:=s.Apply(r.inventoryModelFor(true),inv.Transaction{Actor:event.TargetID,Sequence:s.Cursors[event.TargetID].Sequence+1,RequestTag:fmt.Sprintf("combat/armor/%d/%s",event.Sequence,id),Wear:[]inv.Wear{{Item:item.ID,ExpectedRevision:item.Revision,Amount:wear}}});if err!=nil{return err}
 }
 return nil
}

func(c combatCatalog)ValidateInventory(m inv.Model)error{
 if c.DefaultProfile==""{return nil}
 if err:=c.validateAmmoPacks(m);err!=nil{return err}
 for _,p:=range c.Profiles{if p.Weapon.ID!="unarmed"||p.Ammo!=0||p.ReserveAmmo!=0||p.Medkits!=0{return errors.New("combat profile cannot grant physical equipment")}}
 for id,w:=range c.Weapons{
  d,ok:=m.Definitions[id];if !ok||d.Carrier!="physical"||d.EquipSlot==""||d.WearPerUse<1{return fmt.Errorf("combat weapon %s requires equipped physical use",id)}
  if w.Magazine>0{ammo,ok:=m.Definitions[w.AmmoDefinition];if !ok||ammo.Carrier!="physical"||ammo.ContainerVolume>0||ammo.Currency!=""||ammo.Volume<1||d.ContainerVolume<int64(w.Magazine)*ammo.Volume{return errors.New("firearm requires compatible physical magazine and ammunition")}}
 }
 seen:=map[string]bool{}
 for _,id:=range (&Runtime{}).woundAidItems(){d,ok:=m.Definitions[id];if !ok||seen[id]||d.Carrier!="physical"||d.ContainerVolume>0||d.Currency!=""{return errors.New("invalid medical consumption contract")};seen[id]=true}
 for id,x:=range c.Explosives{d,ok:=m.Definitions[id];if !ok||id!=x.ID||d.Carrier!="physical"||d.ContainerVolume>0||d.Currency!=""{return errors.New("invalid physical explosive contract")}}
 for id:=range c.Armor{d,ok:=m.Definitions[id];if !ok||d.Carrier!="physical"||d.EquipSlot==""||d.WearPerUse<1{return errors.New("armor requires equipped physical protection")}}
 return nil
}

func(r *Runtime)combatArmorFromInventory(s inv.State,actor string)behavior.CombatArmor{
 armorResult:=behavior.CombatArmor{}
	for _,id:=range combatItemKeys(s){
		i:=s.Items[id];armor,ok:=r.world.CombatRuntime.Armor[i.Definition]
		if !ok||i.Location.Kind!="store"||i.Location.Store!=inv.ActorStore(actor)||i.Location.Slot==""||!r.combatCarried(s,actor,i){continue}
		armorResult.Head+=int(int64(armor.Head)*i.Condition/1000000)
		armorResult.Torso+=int(int64(armor.Torso)*i.Condition/1000000)
		armorResult.Arms+=int(int64(armor.Arms)*i.Condition/1000000)
		armorResult.Legs+=int(int64(armor.Legs)*i.Condition/1000000)
	}
 return armorResult
}
func(r *Runtime)combatArmorAfterDamage()func(behavior.Combatant,int,string)behavior.CombatArmor{
 var virtual *inv.State
 return func(target behavior.Combatant,blocked int,part string)behavior.CombatArmor{
  if blocked<1{return target.BodyArmor}
  if virtual==nil{copy:=r.state.Inventory.Clone();virtual=&copy}
  event:=behavior.CombatEvent{TargetID:target.ID,BodyPart:part,ArmorBlocked:blocked,Sequence:virtual.Revision+1}
  if err:=r.wearCombatArmor(virtual,event);err!=nil{return target.BodyArmor}
  return r.combatArmorFromInventory(*virtual,target.ID)
 }
}
