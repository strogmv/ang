// wsReadAuthToken reads the first client message after upgrade and expects an auth frame:
//
//	{ "type": "auth", "token": "<jwt>" }
//
// Returns the userID and companyID extracted from the validated JWT.
// Closes the connection and returns an error if the frame is missing or the token is invalid.
// This keeps JWT tokens out of the URL (access logs, browser history, Referer headers).
func wsReadAuthToken(conn *websocket.Conn) (userID string, companyID string, err error) {
	conn.SetReadDeadline(time.Now().Add(5 * time.Second))
	_, msg, err := conn.ReadMessage()
	if err != nil {
		conn.WriteMessage(websocket.CloseMessage, websocket.FormatCloseMessage(4001, "auth frame required"))
		conn.Close()
		return "", "", fmt.Errorf("ws auth: read: %w", err)
	}
	conn.SetReadDeadline(time.Time{}) // reset deadline after successful read

	var frame struct {
		Type  string `json:"type"`
		Token string `json:"token"`
	}
	if json.Unmarshal(msg, &frame) != nil || frame.Type != "auth" || frame.Token == "" {
		conn.WriteMessage(websocket.CloseMessage, websocket.FormatCloseMessage(4001, "auth frame required"))
		conn.Close()
		return "", "", fmt.Errorf("ws auth: invalid auth frame")
	}

	claims, err := parseAndVerifyJWT(frame.Token)
	if err != nil {
		conn.WriteMessage(websocket.CloseMessage, websocket.FormatCloseMessage(4001, "invalid token"))
		conn.Close()
		return "", "", fmt.Errorf("ws auth: %w", err)
	}

	return getStringClaim(claims, authUserClaim), getStringClaim(claims, authCompanyClaim), nil
}

