// An enter intent waits on the real deck until descent after its full departure signal. The timed
// Life edge then owns the riders, so no body is drawn floating over a descending deck.
func(r *Runtime)requestLiftingDeckRide(actorID,edgeID string)error{
 d:=r.liftingDeckForEdge(edgeID);if d==nil{return fmt.Errorf("unknown lifting deck edge")};if err:=r.liftingDeckAccessError(edgeID);err!=nil{return err};a:=r.state.Life.Actor(actorID);edge:=r.world.Life.Edge(edgeID);if a==nil||edge==nil||a.Level!=edge.From||!a.OnFloor(){return fmt.Errorf("lifting deck rider is unavailable")}
 if actorID==playerActorID{r.resetInstantTravel()}
 r.cancelQueuedLiftingDeckRide(actorID)
 g:=r.state.LiftingDecks[d.ID];found:=false;for _,id:=range g.PendingRiders{if id==actorID{found=true}};if !found{g.PendingRiders=append(g.PendingRiders,actorID)};r.state.LiftingDecks[d.ID]=g
 target:=edge.Exit;if a.Level==d.LevelID&&g.Phase!="loading"{target=behavior.Cell{X:d.Approach.X,Y:d.Approach.Y}}
 if l:=d.Lower;l!=nil&&a.Level==l.LevelID{if _,_,open:=g.lowerPose(*d);!open{target=behavior.Cell{X:l.Approach.X,Y:l.Approach.Y}}}
 r.routeLiftingDeckRider(a,target)

 return nil
}
func(r *Runtime)liftingDeckShaftSeconds(d liftingDeckDefinition)int64{return int64(d.ShaftDepthM/d.ShaftSpeedMPS)}
func(r *Runtime)liftingDeckLowerEdgeBusy(d liftingDeckDefinition)bool{
 l:=d.Lower;if l==nil{return false}
 for _,a:=range r.state.Life.Actors{if a.Level!=l.LevelID||!a.OnFloor(){continue};if l.onBarrier(a.Position){return true};if a.Body!=nil{for _,at:=range a.Body.Cells{if l.onBarrier(at){return true}}}}
 for _,a:=range r.state.Life.Population.Actors{if a.Level==l.LevelID&&a.Materialized&&a.Trip==nil&&l.onBarrier(a.Position){return true}}
 return false
}
// Everybody standing on the deck leaves with it; a queued rider must already stand at the edge exit.
// A one-landing deck keeps its old rule: riders queued at the far end of its edge leave at the same moment.
func(r *Runtime)liftingDeckDepartSide(d liftingDeckDefinition,seconds int64,level,edgeID string,on func(behavior.Cell)bool,other bool){
 g:=r.state.LiftingDecks[d.ID];for _,a:=range r.state.Life.Actors{if a.Level==level&&a.OnFloor()&&on(a.Position){found:=false;for _,id:=range g.PendingRiders{if id==a.ID{found=true}};if !found{g.PendingRiders=append(g.PendingRiders,a.ID)}}};pending:=g.PendingRiders[:0]
 for _,id:=range g.PendingRiders{a:=r.state.Life.Actor(id);if a==nil||!a.OnFloor(){continue};use:=edgeID;if a.Level!=level{if !other{pending=append(pending,id);continue};use=d.ReturnEdge};edge:=r.world.Life.Edge(use);if edge==nil||a.Level!=edge.From||(a.Position!=edge.Exit&&!(a.Level==level&&on(a.Position))){pending=append(pending,id);continue}
  a.Body=nil;a.Path=nil;a.PendingPath=nil;a.Position=edge.Exit;a.Goal=edge.Exit;a.Trip=&behavior.LifeTrip{Edge:edge.ID,Departure:seconds,Arrival:seconds+edge.TravelSeconds};a.Activity="transit";a.Arrived=false
  // Only a commanded body carries a travel order; a routine NPC keeps its own routine target.
  if a.Manual||a.ID==playerActorID{a.OverrideLevel=edge.To;a.OverrideAt=edge.Entry;a.OverrideEdge=edge.ID}
 }
 g.PendingRiders=pending;r.state.LiftingDecks[d.ID]=g
}
func(r *Runtime)liftingDeckDepartRiders(d liftingDeckDefinition,seconds int64){r.liftingDeckDepartSide(d,seconds,d.LevelID,d.TravelEdge,d.contains,d.Lower==nil)}
func(r *Runtime)liftingDeckDepartLower(d liftingDeckDefinition,seconds int64){if d.Lower!=nil{r.liftingDeckDepartSide(d,seconds,d.Lower.LevelID,d.ReturnEdge,d.Lower.contains,false)}}
// A rider of a pass-through deck steps off only when the deck stands open at the other landing.
func(r *Runtime)liftingDeckArrivalHeld(actorID string,edge behavior.LifeEdge)bool{
 d:=r.liftingDeckForEdge(edge.ID);if d==nil||d.Lower==nil{return false};g:=r.state.LiftingDecks[d.ID]
 if edge.ID==d.TravelEdge{_,_,open:=g.lowerPose(*d);return !open}
 if !g.LowerAway||g.LowerArriveSecond>0{return false}
 p:=g.pose(g.UpdatedNS);return !((g.Phase=="loading"||g.Phase=="signal_down")&&p.Deck==liftingDeckFull&&p.Barrier==0)
}
func(r *Runtime)liftingDeckTravelAllowed(actorID string,edge behavior.LifeEdge)bool{d:=r.liftingDeckForEdge(edge.ID);if d==nil{return true};return r.liftingDeckAccessError(edge.ID)==nil}
func(r *Runtime)appendLiftingDecks(msg *pb.PocGameState,hero *behavior.LifeActor,locale string){
 if r.world.LiftingDecks==nil||hero==nil||msg.Life==nil{return};view:=msg.Life
 for _,d:=range r.world.LiftingDecks.Decks{if l:=d.Lower;l!=nil&&l.LevelID==hero.Level{r.appendLowerLiftingDeck(msg,d,locale)};if d.LevelID!=hero.Level{continue};g:=r.state.LiftingDecks[d.ID];p:=g.pose(g.UpdatedNS)
  access:=r.screenAccess(msg,behavior.Cell{X:d.Approach.X,Y:d.Approach.Y},[]behavior.Cell{{X:d.Approach.X,Y:d.Approach.Y}});access.UseWorld=true;access.WorldX=d.ControlPlan[0];access.WorldY=d.ControlPlan[1];access.WorldZ=d.ControlPlan[2]
  st:=&pb.PocLiftingDeckState{Id:d.ID,InstanceId:d.InstanceID,Name:r.localText(locale,d.NameKey,d.ID),Phase:g.Phase,Cause:g.Cause,LeavesPpm:p.Leaves,DeckPpm:p.Deck,BarrierPpm:p.Barrier,UnlockPpm:p.Unlock,DamperPpm:p.Damper,ReleasePpm:p.Release,SampleNs:g.UpdatedNS,Run:g.Runs,Skipped:g.Skipped,Stops:g.Stops,Passable:d.ClosedWalkable&&g.walkable(),PhaseText:r.localText(locale,"ui.deck.phase."+g.Phase,g.Phase),SignalRed:g.Phase!="rest"&&g.Phase!="loading",SignalGreen:g.Phase=="loading"&&p.Barrier==0,Beacon:g.Phase!="rest"&&g.Phase!="loading"&&(g.UpdatedNS/max(int64(1),d.Timing.BeaconPeriod*500000))%2==0,Horn:g.Phase=="equalising"||g.Phase=="signal_up"||g.Phase=="signal_down"||g.Phase=="departure_barrier"||g.Phase=="lockdown_warning",RideAvailable:d.TravelEdge!="",TravelEdge:d.TravelEdge,NextRunSecond:g.NextRunSecond,Access:access}
  st.WeightText=r.localText(locale,"ui.deck.weight.unknown","—")
  if d.Freight!=nil{st.Cargo=r.liftingDeckCargo(d,g);weight:=int64(0);known:=true;for _,cargo:=range st.Cargo{if cargo.Stage!="deck"{continue};if cargo.MassG<0{known=false}else{weight+=cargo.MassG}};if known{st.WeightText=strings.ReplaceAll(strconv.FormatFloat(float64(weight)/1000,'f',2,64),".",r.localText(locale,"ui.format.decimal_separator","."))}
   // Inside a trailer nothing stands loose on the deck: the scale still weighs it, the trailer shows it.
   if r.liftingDeckFreightWithConvoy(d){kept:=st.Cargo[:0];for _,cargo:=range st.Cargo{if cargo.Stage!="deck"{kept=append(kept,cargo)}};st.Cargo=kept}}
  depth:=strconv.FormatFloat(-d.DepthM*(1-float64(p.Deck)/float64(liftingDeckFull)),'f',2,64);st.DepthText=strings.ReplaceAll(depth,".",r.localText(locale,"ui.format.decimal_separator","."))
  if err:=r.liftingDeckAccessError(d.TravelEdge);err!=nil{if e,ok:=err.(textError);ok{st.Refusal=r.localText(locale,e.Key,e.Key)}}
  view.LiftingDecks=append(view.LiftingDecks,st)
  spec:=&pb.PocLiftingDeckSpec{Id:d.ID,InstanceId:d.InstanceID};if d.Freight!=nil{spec.CargoResource=d.Freight.Resource;spec.CargoYawDegrees=d.Freight.YawDegrees}
  for _,sound:=range d.Sounds{spec.Sounds=append(spec.Sounds,&pb.PocLiftingDeckSound{Node:sound.Node,Channel:sound.Channel,Resource:sound.Resource,OffsetM:sound.Offset,VolumeDb:sound.VolumeDB,Loop:sound.Loop})}
  for _,n:=range d.Nodes{spec.Nodes=append(spec.Nodes,&pb.PocLiftingDeckNode{Name:n.Name,Channel:n.Channel,Axis:n.Axis,Minimum:n.Min,Maximum:n.Max,Rotation:n.Rotation})};for _,slot:=range d.TextSlots{spec.TextSlots=append(spec.TextSlots,&pb.PocLiftingDeckTextSlot{Node:slot.Node,Field:slot.Field,Key:slot.Key,WidthMm:int32(slot.WidthMM),HeightMm:int32(slot.HeightMM),RotationDegrees:slot.RotationDegrees})};view.LiftingDeckSpecs=append(view.LiftingDeckSpecs,spec)
 }
 raw,_:=json.Marshal(view.LiftingDeckSpecs);h:=fnv.New64a();h.Write(raw);view.LiftingDeckSpecsRevision=h.Sum64()
}
