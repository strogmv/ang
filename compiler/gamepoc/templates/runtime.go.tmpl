	r.lastAdvance = last
	r.sampleAt = last
	for {
		select {
		case <-ctx.Done():
			return
		case in := <-r.input:
			r.advance(time.Now())
			if in.join {
				r.client = in.client
				r.sendState(in.client)
				r.queueDisk(diskJob{client: in.client, action: "list"})
				continue
			}
			if in.leave {
				r.close(in.client)
				if r.client == in.client {
					r.client = nil
				}
				continue
			}
			if in.client != r.client {
				continue
			}
			r.command(in)
		case result := <-r.done:
			r.advance(time.Now())
			r.diskComplete(result)
		case <-wake.C:
			r.advance(time.Now())
		}
