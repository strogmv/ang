// Service ownership suspends movement decisions, not the authored duty break.
// Its saved timestamps and post remain in LifeBrain; release resumes that return.
func sanitaryRestoreDutyBreak(a *behavior.LifeActor, p sanitaryUser, returning bool) {
	if p.ReturnBySecond > 0 {
		a.Brain.BreakKind = "hygiene"
		a.Brain.Returning = returning
	}
}

func (r *Runtime) sanitaryHoldUsers() {
	for id, p := range r.state.Sanitary.Users {
		if a := r.state.Life.Actor(id); a != nil {
			sanitaryRestoreDutyBreak(a, p, false)
		}
		if p.Phase == "approach" {
			continue
		}
		if a := r.state.Life.Actor(id); a != nil {
			a.Manual = true
			a.CombatHold = true
			a.Body = nil
			a.Path = nil
			a.PendingPath = nil
			a.Goal = a.Position
			a.OverrideLevel = ""
			a.OverrideEdge = ""
			a.Activity = "sanitary"
			a.Label = "sanitary.phase." + p.Phase
		}
	}
}
