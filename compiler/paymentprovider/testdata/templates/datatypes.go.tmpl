type macanPayMethodRule struct {
	match         string // cardp2p | sbp | click | qrcode | trans_card2card | trans_sbp | literal
	literalBrand  string
	defaultAPI    string
	kgsAPI        string
	requisiteKind string // card | phone | "" (empty = account)
}

var macanPaymentMethodRules = []macanPayMethodRule{
	{{- range .PaymentMethodMap }}
	{{- if eq .MatchKey "cardp2p" }}
	{match: matchCardP2P, literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}, requisiteKind: requisiteCard},
	{{- else if eq .MatchKey "sbp" }}
	{match: matchSBP, literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}, requisiteKind: requisitePhone},
	{{- else if eq .MatchKey "trans_card2card" }}
	{match: matchTransCard2Card, literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}, requisiteKind: requisiteCard},
	{{- else if eq .MatchKey "trans_sbp" }}
	{match: matchTransSBP, literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}, requisiteKind: requisitePhone},
	{{- else if eq .MatchKey "literal" }}
	{match: matchLiteral, literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}{{- if or (eq .Brand "trans_card2card") (eq .Brand "trans_card") }}, requisiteKind: requisiteCard{{- else if or (eq .Brand "trans_sbp") (eq .Brand "trans_phone") }}, requisiteKind: requisitePhone{{- end }}},
	{{- else if eq .MatchKey "click" }}
	{match: matchClick, literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}{{- if .KGSAPIConst }}, kgsAPI: {{ .KGSAPIConst }}{{- end }}},
	{{- else if eq .MatchKey "qrcode" }}
	{match: matchQRCode, literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}{{- if .KGSAPIConst }}, kgsAPI: {{ .KGSAPIConst }}{{- end }}},
	{{- else }}
	{match: "{{ .MatchKey }}", literalBrand: "{{ .Brand }}", defaultAPI: {{ .APINameConst }}{{- if .KGSAPIConst }}, kgsAPI: {{ .KGSAPIConst }}{{- end }}},
	{{- end }}
	{{- end }}
}

func macanBrandMatches(rule macanPayMethodRule, brand string) bool {
	switch rule.match {
	{{- range .MacanBrandMatchCases }}
	case {{ .MatchConst }}:
		return {{ .EqualExpr }}
	{{- end }}
	case matchLiteral:
		return brand == rule.literalBrand
	default:
		return false
	}
}

func macanIsRedirect(brand string) bool {
	return types.ClickMethod.Equal(brand) || types.QRCodeMethod.Equal(brand)
}

func macanPaymentMethodName(brand, cur string) (string, error) {
	for _, rule := range macanPaymentMethodRules {
		if !macanBrandMatches(rule, brand) {
			continue
		}
		if rule.kgsAPI != "" && cur == currency.KGSCurrency {
			return rule.kgsAPI, nil
		}
		return rule.defaultAPI, nil
	}
	return "", fmt.Errorf("%s: unsupported payment method brand %q", ppSID, brand)
}

func macanPaymentDecline(body []byte) (st model.TnxStatus, code model.TnxStatusCode, msg string, ok bool) {
	if len(body) == 0 {
		return
	}
	var errResp macanAPIErrorResponse
	if err := json.Unmarshal(body, &errResp); err != nil || len(errResp.Errors) == 0 {
		return
	}
	msg = macanAPIErrorsMessage(errResp.Errors)
	for _, e := range errResp.Errors {
		if e.Type == "" {
			continue
		}
{{- if .ErrorCodes }}
		if st, code, ok = mapMacanAPIErrorType(e.Type); ok {
			return st, code, msg, true
		}
{{- end }}
	}
	return tnxStatusDeclined, model.SCodeDeclinedByBank, msg, true
}

func macanBankCode(ownerInfo map[string]string) string {
	if code := helpers.MapGet(ownerInfo, providers.BankCodeKey, ""); code != "" {
		return code
	}
	return helpers.MapGet(ownerInfo, providers.BankNameKey, "")
}

// syncExchangedAmount writes the provider-reported amount into tx.ExchangedAmount
// when present, so p2p amount adjustments are reflected back.
func syncExchangedAmount(tx *model.Transaction, amountStr string) {
	if amount, err := strconv.ParseFloat(amountStr, 64); err == nil && amount > 0 {
		tx.ExchangedAmount = helpers.FloatAmountToCoins(amount, tx.Currency)
	}
}

