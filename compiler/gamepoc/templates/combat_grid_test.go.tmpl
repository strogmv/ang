func TestCombatGridDeferredImmobileMigrationLoadSaveLoad(t *testing.T){
 r,_,foe:=knifeMarketFixture(t);if err:=r.openCombat(playerActorID,foe,"player","opposition");err!=nil{t.Fatal(err)}
 // A valid pre-grid pose: distinct physical centres share the future metre tile.
 at:=combatGridSharedCorner(t,r,foe);r.state.Combat.Actor(playerActorID).Position=at
 for i:=range r.state.Combat.Actors{a:=&r.state.Combat.Actors[i];combatGridBrokenFemur(t,a);a.Facing=behavior.Cell{}}
 r.state.Combat.GridReady=false;r.syncCombatLife();slot:=r.world.Config.SaveSlots[0]
 if err:=r.writeSave(slot,r.snapshotState());err!=nil{t.Fatal(err)}
 loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal("strict legacy immobile read",err)};r.state=loaded;before:=r.state.Combat.Clone();r.migrateLoadedCombatGrid()
 if r.state.Combat.GridReady{t.Fatal("two immobile bodies must defer clearance")}
 if r.state.Combat.EventSeq!=before.EventSeq{t.Fatal("deferred migration invented a move")}
 for _,a:=range r.state.Combat.Actors{if a.Facing==(behavior.Cell{})||a.Position!=before.Actor(a.ID).Position{t.Fatal("heading migration lost pose or left zero heading")}}
 if err=r.writeSave(slot,r.snapshotState());err!=nil{t.Fatal(err)}
 loaded,_,err=r.readSave(slot);if err!=nil{t.Fatal("load -> save -> load after deferred clearance",err)}
 r.state=loaded;r.migrateLoadedCombatGrid();if err=r.validateCombatSave(r.snapshotState());err!=nil{t.Fatal("repeated deferred migration",err)}
}

func TestCombatGridOrdinaryBodyHeadingAndHeroLastMoveEnterCombat(t *testing.T){
 r,_,foe:=knifeMarketFixture(t);if _,ok:=r.world.Stealth.Watchers[foe];ok{t.Fatal("fixture must be an ordinary non-stealth NPC")}
 target:=r.state.Life.Actor(foe);r.world.Life.FaceStep(target,behavior.Cell{X:target.Position.X-1,Y:target.Position.Y},target.Position)
 npc:=r.combatant(foe,"red");if npc.Facing.X<=0||npc.Facing.Y!=0{t.Fatalf("ordinary NPC lost its body heading: %+v",npc.Facing)}
 hero:=r.state.Life.Actor(playerActorID);if hero.Body==nil{t.Fatal("hero has no continuous body")};hero.Body.FX,hero.Body.FY=0,-1
 if r.state.Stealth.Observers==nil{r.state.Stealth.Observers=map[string]stealthObserver{}};stale:=r.state.Stealth.Observers[playerActorID];stale.Level=hero.Level;stale.At=hero.Position;stale.FaceX,stale.FaceY=1,0;r.state.Stealth.Observers[playerActorID]=stale
 fighter:=r.combatant(playerActorID,"blue");if fighter.Facing.Y>=0||fighter.Facing.X!=0{t.Fatalf("hero's last physical move was lost: %+v",fighter.Facing)}
 npc.Position=target.Position;fighter.Position=behavior.Cell{X:target.Position.X-1,Y:target.Position.Y+1}
 fighter.Weapon=behavior.CombatWeapon{ID:"knife",Kind:"blade",Damage:12,RangeMM:900,AttackAP:2}
 fighter.AP=r.world.CombatRuntime.Rules.APPerTurn;npc.AP=fighter.AP
 s:=behavior.CombatState{ID:"heading",LevelID:target.Level,Turn:1,Active:true,Actors:[]behavior.Combatant{fighter,npc}}
 r.state.Combat=s;space:=r.combatSpace(s)
 if side:=s.AttackReason(space,r.world.CombatRuntime.Rules,playerActorID,foe,fighter.Position);side!="rear"{t.Fatalf("ordinary NPC cannot receive a back bonus: %s",side)}
 attack:=behavior.CombatAction{Type:"attack",TargetID:foe,BodyPart:"chest"};rearChance,_:=s.AttackChance(space,r.world.CombatRuntime.Rules,playerActorID,attack,fighter.Position);s.Actor(foe).Facing=behavior.Cell{X:-1000};frontChance,_:=s.AttackChance(space,r.world.CombatRuntime.Rules,playerActorID,attack,fighter.Position);s.Actor(foe).Facing=npc.Facing
 if rearChance<=frontChance{t.Fatalf("ordinary NPC rear bonus absent: front %g rear %g",frontChance,rearChance)}
 view:=r.combatOptions("ru");rear:=false;for _,o:=range view{if o.TargetId==foe&&strings.Contains(o.TacticalReason,"Со спины"){rear=true;break}};if !rear{t.Fatal("back bonus did not reach the localized option")}
