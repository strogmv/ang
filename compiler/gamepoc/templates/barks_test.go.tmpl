	r.state.Life.Seconds = 86400 + 10*3600
	barkPut(t, r, "char.market_yatai_cook", level, barkSpot(t, r, barkYatai, "yatai.F5/serve"))
	barkPut(t, r, "char.market_yatai_helper", level, barkSpot(t, r, barkYatai, "yatai.F5/tea"))
