Shader "ANG/Storefront" {
 SubShader {Tags {"Queue"="Transparent" "RenderPipeline"="UniversalPipeline"} Pass {
  Cull Off ZWrite Off ZTest Always Blend One Zero
  HLSLPROGRAM
  #pragma vertex vert
  #pragma fragment frag
  #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
  struct appdata {float4 vertex:POSITION;float2 uv:TEXCOORD0;};
  struct v2f {float4 vertex:SV_POSITION;float2 uv:TEXCOORD0;float2 canvas:TEXCOORD1;};
  TEXTURE2D(_RecessTex); SAMPLER(sampler_RecessTex);
  TEXTURE2D(_GoodsTex); SAMPLER(sampler_GoodsTex);
  TEXTURE2D(_ShutterTex); SAMPLER(sampler_ShutterTex);
  TEXTURE2D(_FestivalTex); SAMPLER(sampler_FestivalTex);
  TEXTURE2D(_FogTex); SAMPLER(sampler_FogTex);
  CBUFFER_START(UnityPerMaterial)
  float4 _RecessUV,_GoodsUV,_ShutterUV,_FestivalUV,_RecessRect,_GoodsRect,_ShutterRect,_FestivalRect,_State,_CanvasSize;
  CBUFFER_END
  v2f vert(appdata v){v2f o;o.vertex=TransformObjectToHClip(v.vertex.xyz);o.uv=v.uv;o.canvas=v.vertex.xy;return o;}
  half4 sampleLayer(TEXTURE2D_PARAM(image,imageSampler),float4 source,float4 area,float2 local,float opaque){
   if(area.z<=0||area.w<=0)return half4(0,0,0,0);
   // `point` is an HLSL geometry primitive keyword, including on Metal.
   float2 layerUV=(local-area.xy)/area.zw;float valid=step(0,layerUV.x)*step(0,layerUV.y)*step(layerUV.x,1)*step(layerUV.y,1);
   // Generated artwork can carry alpha 250..254 even inside metal panels.
   // Architectural inserts must occlude the old baked goods completely.
   half4 color=SAMPLE_TEXTURE2D(image,imageSampler,source.xy+float2(layerUV.x,1-layerUV.y)*source.zw);color.a=lerp(color.a,1,opaque)*valid;return color;
  }
  half4 over(half4 background,half4 front){float alpha=front.a+background.a*(1-front.a);return half4((front.rgb*front.a+background.rgb*background.a*(1-front.a))/max(.0001,alpha),alpha);}
  half4 frag(v2f i):SV_Target{
   half4 color=sampleLayer(TEXTURE2D_ARGS(_RecessTex,sampler_RecessTex),_RecessUV,_RecessRect,i.uv,1);
   half4 goods=sampleLayer(TEXTURE2D_ARGS(_GoodsTex,sampler_GoodsTex),_GoodsUV,_GoodsRect,i.uv-float2(0,_State.z),0);goods.a*=_State.y;color=over(color,goods);
   half4 shutter=sampleLayer(TEXTURE2D_ARGS(_ShutterTex,sampler_ShutterTex),_ShutterUV,_ShutterRect,i.uv+float2(0,1-_State.x),1);shutter.a*=step(.000001,_State.x);color=over(color,shutter);
   half4 festival=sampleLayer(TEXTURE2D_ARGS(_FestivalTex,sampler_FestivalTex),_FestivalUV,_FestivalRect,i.uv,0);festival.a*=_State.w;color=over(color,festival);
   half4 fog=SAMPLE_TEXTURE2D(_FogTex,sampler_FogTex,float2(i.canvas.x/_CanvasSize.x,1-i.canvas.y/_CanvasSize.y));color.rgb=lerp(color.rgb,fog.rgb,fog.a);
   return color;
  }
  ENDHLSL
 } }
}
