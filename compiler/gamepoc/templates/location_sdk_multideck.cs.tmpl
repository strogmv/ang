   float meters=locationSDKLevel.cell_meters,heroMM=feet.y*1000;int px=(int)Math.Floor(feet.x/meters),py=(int)Math.Floor(feet.z/meters);
   locationSDKCutawayHidden.Clear();locationSDKCutawayFaded.Clear();
