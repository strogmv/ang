}
func (p PopulationModel) anchor(index int, level string) Cell {
	anchors := p.Anchors[level]
	if len(anchors) == 0 {
		return Cell{}
	}
	return anchors[((index/len(p.ShiftOffsets))*populationAnchorStride(len(anchors)))%len(anchors)]
}
func (p PopulationModel) Start(l LifeModel, count int, seconds, tick int64) (PopulationState, error) {
	if err := p.Validate(l); err != nil {
		return PopulationState{}, err
	}
	if count < 0 || count > p.MaxActors || seconds < 0 || tick < 0 {
		return PopulationState{}, fmt.Errorf("invalid population start")
	}
	s := PopulationState{Count: count, LastSeconds: seconds, LastTick: tick}
	for i := 0; i < count; i++ {
		shift := p.assignedShift(i)
		stage := p.stage(seconds, shift)
		profile:=p.makeProfile(i)
		cfg := p.profileStage(profile,stage)
		at := p.profileAnchor(profile,stage,i,cfg.Level)
		s.Actors = append(s.Actors, PopulationActor{Profile:profile,ID: fmt.Sprintf("population.%04d", i+1), Name: fmt.Sprintf("Житель %03d", i+1), Level: cfg.Level, Position: at, Goal: at, MoveStartTick: tick, Stage: stage, ShiftSeconds: shift, Arrived: true, Activity: cfg.Activity, ColdReadyAt: seconds, Visits: map[string]int{cfg.Level: 1}})
