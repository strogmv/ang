 for id,v:=range k.KnownLinks{e,ok:=links[id];if !ok||!v||!k.KnownNodes[e.FromNode]||!k.KnownNodes[e.ToNode]{return fmt.Errorf("invalid known region link")}}
 for id,at:=range k.Visited{if !k.KnownNodes[id]||at<0||at>s.Life.Seconds{return fmt.Errorf("invalid region visit")}}
