// The fighting layer's entry point (owner 02.11): a shout by caste and declared intent; a lie only for a leader and seen
// only when the hero's skill reaches a tell; beasts make a sound and a sign, never words; without cues the fight is silent.
func TestBarksCombatEntryPoint(t *testing.T) {
	if len(barkCatalog.Combat.Lines) == 0 {
		t.Skip("world has no combat barks")
	}
	r := barksFixture(t)
	const level = "level.c7_market"
	hero := barkNear(t, r, level, behavior.Cell{X: 60, Y: 40})
	barkPut(t, r, playerActorID, level, hero)
	at := barks.Cell{X: hero.X + 4, Y: hero.Y}
	out := r.BarkCue(barks.Cue{Speaker: "char.poc_hub_guard", Declared: "spotted", Level: level, At: at})
	if out.Said == nil || !strings.HasPrefix(out.Said.Line, "bark.guard.") {
		t.Fatalf("the guard did not shout: %+v", out)
	}
	// a rank-and-file outlaw cannot lie
	out = r.BarkCue(barks.Cue{Speaker: "outlaw.1", Archetype: "arch.freeman_outlaw", Declared: "wounded_retreat", Truth: "lure", Level: level, At: at})
	if out.Deceived {
		t.Fatalf("a rank-and-file outlaw lied: %+v", out)
	}
	// the leader lies; an untrained hero does not see it, a medic does (as his own thought)
	dev := r.state.Life.Development.Actors[playerActorID]
	for _, s := range []string{"medicine", "observation", "hunting"} {
		if sk, ok := dev.Skills[s]; ok {
			sk.ValueMilli = 0
			dev.Skills[s] = sk
		}
	}
	out = r.BarkCue(barks.Cue{Speaker: "outlaw.2", Archetype: "arch.freeman_outlaw", Role: "leader", Declared: "wounded_retreat", Truth: "lure", Level: level, At: at})
	if !out.Deceived || out.Said == nil || out.Thought != nil {
		t.Fatalf("the leader's lie or the blind hero: %+v", out)
	}
	if sk, ok := dev.Skills["medicine"]; ok {
		sk.ValueMilli = 90000
		dev.Skills["medicine"] = sk
	}
	out = r.BarkCue(barks.Cue{Speaker: "outlaw.3", Archetype: "arch.freeman_outlaw", Role: "leader", Declared: "wounded_retreat", Truth: "lure", Level: level, At: at})
	if out.Thought == nil || out.Thought.Kind != "thought" || out.Thought.Speaker != playerActorID {
		t.Fatalf("a skilled hero did not see through the lie: %+v", out)
	}
	// the pack: a sound and a mark, no words
	out = r.BarkCue(barks.Cue{Speaker: "wolf.1", Archetype: "arch.psi_wolf", Declared: "surround", Level: level, At: at})
	if out.Said == nil || out.Said.Kind != "sign" || out.Said.Key != "" || out.Said.Sign == "" {
		t.Fatalf("a beast spoke or made no sign: %+v", out)
	}
	c := &connection{locale: "en", out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{})}
	r.sendLifeState(c)
	kinds := map[string]int{}
	for _, b := range (<-c.out).GetGameState().GetLife().GetBarks() {
		kinds[b.Kind]++
		if b.Kind == "sign" && b.Text != "" {
			t.Fatal("a beast's sign carries text")
		}
		if b.Kind == "thought" && b.Text == "" {
			t.Fatal("the hero's thought has no text")
		}
	}
	if kinds["combat"] == 0 || kinds["thought"] == 0 || kinds["sign"] == 0 {
		t.Fatalf("the fight did not reach the client: %v", kinds)
	}
	// unknown voice: silent
	if out = r.BarkEvent("char.market_granny", "spotted", "", ""); out.Said != nil {
		t.Fatalf("a person without a combat voice shouted: %+v", out)
	}
}

// Exchanges (demo-hub v26-alive) on the real world: Galina and Kostya at their posts talk when the hero stands by; the answer comes after the line is over; when one of them is
// away nobody talks; every exchange of the catalog has its people in the world; none of the texts is empty; the same seed the same talk.
func talkOnly(all []barks.Speech) []barks.Speech {
	var out []barks.Speech
	for _, sp := range all {
		if sp.Kind == "talk" {
			out = append(out, sp)
		}
	}
	return out
}
