func TestLifeDepartureDayNightWindows(t *testing.T){
 e:=scheduledLifeEdge()
 for _,c:=range [][2]int64{{0,0},{1,3600},{21599,21600},{21600,21600},{21601,21900},{79199,79200},{79200,79200},{79201,82800},{86399,86400},{86400,86400},{86401,90000},{107999,108000},{108001,108300}}{if got:=e.NextDeparture(c[0]);got!=c[1]{t.Fatalf("next(%d)=%d want%d",c[0],got,c[1])}}
 e.DayStartSecond=25000;e.DayEndSecond=79000;e.NightPeriodSeconds=5000;e.OffsetSeconds=100
 if got:=e.NextDeparture(86399);got!=89100{t.Fatalf("night cadence restarted at midnight: %d",got)}
 if got:=e.NextDeparture(25000);got!=25100{t.Fatalf("offset missing at day boundary: %d",got)}
 if got:=e.NextDeparture(78999);got!=79100{t.Fatalf("old window produced an invalid departure: %d",got)}
