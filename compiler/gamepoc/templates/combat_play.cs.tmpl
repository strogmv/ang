  }
  // Sound: the three cues by outcome, the keys and files are data.
  readonly List<AudioSource> combatAudio=new List<AudioSource>();readonly Dictionary<string,AudioClip> combatAudioClips=new Dictionary<string,AudioClip>(StringComparer.Ordinal);
