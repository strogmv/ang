// Code generated by ANG. Private authored texts, per-session locale, keyed errors.
package poc

import "errors"

type localizationMessage struct {
 Key string `json:"key"`
 Context string `json:"context"`
 Texts map[string]string `json:"texts"`
}
type localizationCatalog struct {
 DefaultLocale string `json:"default_locale"`
 FallbackLocale string `json:"fallback_locale"`
 Locales []string `json:"locales"`
 Messages []localizationMessage `json:"messages"`
}

type textError struct{Key string}
func(e textError)Error()string{return e.Key}

func(r *Runtime)validLocale(locale string)string{
 c:=r.world.Localization
 for _,candidate:=range c.Locales{if candidate==locale{return locale}}
 for _,candidate:=range c.Locales{if candidate==c.DefaultLocale{return c.DefaultLocale}}
 // Compatibility for older fixtures with no authored localization module.
 if len(c.Locales)==0&&(locale=="ru"||locale=="en"){return locale}
 return "ru"
}

func(r *Runtime)localText(locale,key,fallback string)string{
 c:=r.world.Localization;locale=r.validLocale(locale)
 for _,message:=range c.Messages{if message.Key!=key{continue}
  for _,candidate:=range []string{locale,c.FallbackLocale,c.DefaultLocale}{if text:=message.Texts[candidate];text!=""{return text}}
  break
 }
 if fallback!=""{return fallback};return key
}

func(r *Runtime)localError(locale string,err error)string{
 if err==nil{return ""}
 var value textError
 if errors.As(err,&value){return r.localText(locale,value.Key,value.Key)}
 var pointer *textError
 if errors.As(err,&pointer)&&pointer!=nil{return r.localText(locale,pointer.Key,pointer.Key)}
 // Old modules still return prose errors; translating that legacy content is
 // separate work. New localized modules return stable textError keys instead.
 return err.Error()
}
