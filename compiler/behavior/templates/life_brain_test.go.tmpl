  raw,err:=json.Marshal(b);if err!=nil{t.Fatal(err)}
  var loaded LifeBrain;if err=json.Unmarshal(raw,&loaded);err!=nil{t.Fatal(err)}
  if err=loaded.Validate(m,seconds);err!=nil{t.Fatalf("day %d valid window rejected: %v",day,err)}
  loaded.SeatWindow=seatMarker((day+1)*86400,0)
  if loaded.Validate(m,seconds)==nil{t.Fatal("future-day window accepted")}
 }
}
