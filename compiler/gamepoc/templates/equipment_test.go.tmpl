func TestGroupReservesWalksEquipsAndUsesRealStock(t *testing.T){
 r:=equipmentFixture(t);reserved,equipped,used:=false,false,false
 for r.state.Tick<1200&&!r.state.Demo.Delivered&&r.state.Demo.Plan.Status!="failed"{
  r.step();assertDemoNoOverlap(t,r);assertNPCProjectionIsPureAndExclusive(t,r);d:=&r.state.Demo
  if d.Supply.Status=="reserved"||d.Supply.Status=="travelling"{reserved=true;for actor,id:=range d.Supply.Assignments{item:=r.state.Inventory.Items[id];if item.Location.Store!=inv.ActorStore(actor)&&r.state.Inventory.Reservations[id].Actor!=actor{t.Fatal("assignment has no real reservation")}}}
  if d.Supply.Status=="equipped"{equipped=true;for _,m:=range r.squadMembers(){item,ok:=r.equippedItem(m.ID);if !ok{t.Fatal("equipped plan without equipped item")};if item.Owner==m.ID{t.Fatal("issue silently granted legal ownership")};if item.Condition<1000000{used=true}}}
 }
 if !r.state.Demo.Delivered||!reserved||!equipped||!used{for _,a:=range r.state.Demo.Agents{t.Logf("%s pos=%v goal=%v task=%s path=%v progress=%s yield=%d",a.ID,a.Position,a.Goal,a.Task,a.Path,a.Progress.Reason,a.YieldUntil)};t.Logf("squad=%+v events=%v",r.state.Demo.Squad,r.state.Demo.Events);t.Fatalf("physical equipment chain failed tick=%d phase=%s supply=%+v plan=%s",r.state.Tick,r.state.Demo.Squad.Phase,r.state.Demo.Supply,r.state.Demo.Plan.Diagnostic())}
 if len(r.state.Inventory.Reservations)!=0{t.Fatal("consumed equipment left leases")}
