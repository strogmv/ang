func TestTransitFareSelectionQueueAndBoardingSaveAreSeparate(t *testing.T){
 r,e,payer:=paidTransitFixture(t);before:=r.state.Inventory.Clone();destination:="";for _,d:=range r.wayfindingLocal("en"){if d.EdgeID==e.ID{destination=d.ID;break}};if destination==""{t.Fatal("paid exit missing from known wayfinding")}
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_preview",Destination:destination});err!=nil{t.Fatal(err)};r.appendWayfinding(&pb.PocLifeView{},"en");if !reflect.DeepEqual(before,r.state.Inventory){t.Fatal("selection charged a fare")}
 if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"enter",Destination:e.ID});err!=nil{t.Fatal(err)};if !reflect.DeepEqual(before,r.state.Inventory){t.Fatal("enter intent charged before boarding")};r.step();hero:=r.state.Life.Actor(playerActorID)
 if hero.Trip==nil||hero.Trip.Edge!=e.ID{t.Fatal("actual boarding missing")};if before.Accounts[payer].Balance-r.state.Inventory.Accounts[payer].Balance!=e.Fare.AmountMinor||r.state.Inventory.Accounts[e.Fare.ReceiverAccount].Balance-before.Accounts[e.Fare.ReceiverAccount].Balance!=e.Fare.AmountMinor{t.Fatal("fare was not conserved exactly once")}
 if r.state.Inventory.Cursors[playerActorID].Sequence!=before.Cursors[playerActorID].Sequence+1{t.Fatal("payment bypassed inventory transaction cursor")}
 snapshot:=r.snapshotState();slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,snapshot);err!=nil{t.Fatal(err)};loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};r.state=loaded;paid:=r.state.Inventory.Clone();for i:=0;i<4;i++{r.step()};if !reflect.DeepEqual(paid.Accounts,r.state.Inventory.Accounts)||!reflect.DeepEqual(paid.Cursors,r.state.Inventory.Cursors)||paid.Revision!=r.state.Inventory.Revision{t.Fatal("loaded in-progress trip charged a second fare")}
}
func TestTransitFareInsufficientFundsLatchesUntilExplicitRetry(t *testing.T){
 r,e,payer:=paidTransitFixture(t);account:=r.state.Inventory.Accounts[payer];account.Balance=0;r.state.Inventory.Accounts[payer]=account;before:=r.state.Inventory.Clone();if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"enter",Destination:e.ID});err!=nil{t.Fatal(err)}
 for i:=0;i<12;i++{r.step()};hero:=r.state.Life.Actor(playerActorID);if hero.Trip!=nil||hero.AdmissionDeniedEdge!=e.ID||hero.Label!="transit.fare_denied"||!reflect.DeepEqual(before.Accounts,r.state.Inventory.Accounts)||!reflect.DeepEqual(before.Cursors,r.state.Inventory.Cursors)||before.Revision!=r.state.Inventory.Revision{t.Fatal("denial moved actor, retried payment or changed inventory")}
 destination:="";for _,d:=range r.wayfindingLocal("en"){if d.EdgeID==e.ID{destination=d.ID;break}};if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_preview",Destination:destination});err!=nil{t.Fatal(err)};view:=&pb.PocLifeView{};r.appendWayfinding(view,"en");if view.Wayfinding.Status!="ready"||!view.Wayfinding.Reachable{t.Fatal("denied platform cannot offer explicit retry")};if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"route_go",Destination:destination});err!=nil||hero.AdmissionDeniedEdge!=""{t.Fatal("explicit route retry did not release admission latch",err)}
 if !r.lifeWalkTo(hero.Position)||hero.AdmissionDeniedEdge!=""{t.Fatal("accepted explicit movement did not release admission latch")}
}
