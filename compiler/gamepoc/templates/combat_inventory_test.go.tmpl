// Code generated by ANG. Real inventory transactions behind the ordinary combat wire.
package poc

import (
	"encoding/json"
	"reflect"
	"sort"
	"strconv"
	"testing"

	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

const combatFixtureGun = "fixture.combat.firearm"
const combatFixtureRound = "fixture.combat.round"
const combatFixtureOtherRound = "fixture.combat.incompatible_round"
const combatFixtureBlade = "fixture.combat.blade"
const combatFixtureHelmet = "fixture.combat.helmet"
const combatFixtureFrag = "fixture.combat.grenade"
const combatFixtureBag = "fixture.combat.locked_bag"

// These are explicit test sources and balance, not proposed dome content. The
// state is created by inventory.New; effects below always use State.Apply,
// Consume and actual accepted combat commands. No tactical resource counter,
// successful hit, casualty or AI decision is substituted for an outcome.
func combatPhysicalFixture(t *testing.T, r *Runtime, target string, borrowGun bool, fragileArmor ...bool) map[string]string {
	t.Helper()
	data, err := json.Marshal(r.inventoryModelFor(true))
	if err != nil {
		t.Fatal(err)
	}
	var m inv.Model
	if err = json.Unmarshal(data, &m); err != nil {
		t.Fatal(err)
	}
	if _, ok := m.Definitions["item.med_patch"]; !ok {
		t.Fatal("authored medical patch definition missing")
	}
	m.MaxItems += 50
	m.Actors[target] = true
	m.Owners[target] = true
	if _, ok := m.Stores[inv.ActorStore(target)]; !ok {
		m.Stores[inv.ActorStore(target)] = inv.Store{ID: inv.ActorStore(target), Kind: "actor", Anchor: inv.Anchor{Kind: "actor", Actor: target}, Owner: target, Capacity: inv.Capacity{Mass: 1000000, Volume: 1000000, Stacks: 1000}}
	}
	definitions := []inv.Definition{
		{ID: combatFixtureGun, Name: "combat fixture firearm", Carrier: "physical", Mass: 400, Volume: 600, StackLimit: 1, ContainerVolume: 64, EquipSlot: "hand.main", Weapon: true, WearPerUse: 1000},
		{ID: combatFixtureRound, Name: "combat fixture ammunition", Carrier: "physical", Mass: 1, Volume: 1, StackLimit: 100},
		{ID: combatFixtureOtherRound, Name: "incompatible fixture ammunition", Carrier: "physical", Mass: 1, Volume: 1, StackLimit: 100},
		{ID: combatFixtureBlade, Name: "combat fixture blade", Carrier: "physical", Mass: 100, Volume: 50, StackLimit: 1, EquipSlot: "hand.main", Weapon: true, WearPerUse: 1000},
		{ID: combatFixtureHelmet, Name: "combat fixture helmet", Carrier: "physical", Mass: 200, Volume: 300, StackLimit: 1, EquipSlot: "head", WearPerUse: 1000},
		{ID: combatFixtureFrag, Name: "combat fixture explosive", Carrier: "physical", Mass: 100, Volume: 60, StackLimit: 2},
		{ID: combatFixtureBag, Name: "combat fixture locked bag", Carrier: "physical", Mass: 100, Volume: 100, StackLimit: 1, ContainerVolume: 1000},
	}
	for _, d := range definitions {
		m.Definitions[d.ID] = d
	}
	// The real earlier hand occupants remain in custody; only the initial fixture
	// hand/head arrangement changes, so there is no duplicate equipped slot.
	for i := range m.Sources {
		src := &m.Sources[i]
		if src.Location.Kind == "store" && (src.Location.Store == inv.ActorStore(playerActorID) && src.Location.Slot == "hand.main" || src.Location.Store == inv.ActorStore(target) && (src.Location.Slot == "hand.main" || src.Location.Slot == "head")) {
			src.Location.Slot = ""
		}
	}
	ids := map[string]string{}
	for _, name := range []string{"gun", "othergun", "loaded", "reserve", "otherloaded", "foreign", "incompatible", "bag", "locked", "blade", "helmet", "medical", "grenade", "vest"} {
		ids[name] = inv.InstanceID("combat.test."+name, 0, 0)
	}
	owner := playerActorID
	if borrowGun {
		owner = target
	}
	source := func(name, definition string, quantity, condition int64, owner string, where inv.Location) {
		m.Sources = append(m.Sources, inv.Source{ID: "combat.test." + name, Definition: definition, Quantity: quantity, Condition: condition, Owner: owner, Location: where})
	}
	heroStore := inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}
	source("gun", combatFixtureGun, 1, 1000000, owner, inv.Location{Kind: "store", Store: heroStore.Store, Slot: "hand.main"})
	source("othergun", combatFixtureGun, 1, 1000000, playerActorID, heroStore)
	source("loaded", combatFixtureRound, 3, 1000000, playerActorID, inv.Location{Kind: "store", Store: inv.ItemStore(ids["gun"])})
	source("reserve", combatFixtureRound, 5, 1000000, playerActorID, heroStore)
	source("otherloaded", combatFixtureRound, 4, 1000000, playerActorID, inv.Location{Kind: "store", Store: inv.ItemStore(ids["othergun"])})
	source("foreign", combatFixtureRound, 6, 1000000, target, heroStore)
	source("incompatible", combatFixtureOtherRound, 5, 1000000, playerActorID, heroStore)
	source("bag", combatFixtureBag, 1, 1000000, playerActorID, heroStore)
	source("locked", combatFixtureRound, 7, 1000000, playerActorID, inv.Location{Kind: "store", Store: inv.ItemStore(ids["bag"])})
	source("blade", combatFixtureBlade, 1, 1000000, target, inv.Location{Kind: "store", Store: inv.ActorStore(target), Slot: "hand.main"})
	source("helmet", combatFixtureHelmet, 1, 500000, target, inv.Location{Kind: "store", Store: inv.ActorStore(target), Slot: "head"})
	source("medical", "item.med_patch", 3, 1000000, playerActorID, heroStore)
	source("grenade", combatFixtureFrag, 2, 1000000, playerActorID, heroStore)
	if len(fragileArmor) > 0 && fragileArmor[0] {
		m.Definitions["fixture.combat.vest"] = inv.Definition{ID: "fixture.combat.vest", Name: "combat fixture fragile vest", Carrier: "physical", Mass: 100, Volume: 100, StackLimit: 1, EquipSlot: "body.torso", WearPerUse: 10000}
		source("vest", "fixture.combat.vest", 1, 250000, target, inv.Location{Kind: "store", Store: inv.ActorStore(target), Slot: "body.torso"})
		r.world.CombatRuntime.Armor["fixture.combat.vest"] = behavior.CombatArmor{Torso: 4}
	}
	r.world.Inventory = m
	r.lifeInventory = lifeInventoryCache{}
	r.state.Inventory, err = inv.New(r.inventoryModelFor(true), r.state.Seed)
	if err != nil {
		t.Fatal(err)
	}
	locked := r.state.Inventory.Stores[inv.ItemStore(ids["bag"])]
	locked.Locked = true
	r.state.Inventory.Stores[locked.ID] = locked
	r.world.CombatRuntime.Weapons[combatFixtureGun] = behavior.CombatWeapon{ID: combatFixtureGun, Kind: "firearm", Damage: 2, RangeMM: 12000, AttackAP: 3, Magazine: 6, AmmoDefinition: combatFixtureRound, BurstAP: 1, BurstSize: 3, BurstPenalty: 4, AimAP: 1, AimBonus: 10}
	r.world.CombatRuntime.Weapons[combatFixtureBlade] = behavior.CombatWeapon{ID: combatFixtureBlade, Kind: "blade", Damage: 40, RangeMM: 1000, AttackAP: 3, Bleed: 4}
	r.world.CombatRuntime.Armor[combatFixtureHelmet] = behavior.CombatArmor{Head: 40}
	r.world.CombatRuntime.Explosives[combatFixtureFrag] = behavior.CombatExplosive{ID: combatFixtureFrag, Damage: 500, RadiusMM: 1000, RangeMM: 5000, AP: 3, Suppression: 20, Bleed: 3}
	r.world.CombatRuntime.Rules.APPerTurn = 12
	r.world.CombatRuntime.Rules.MinHit = 1
	r.world.CombatRuntime.Rules.MaxHit = 1
	r.world.CombatRuntime.Rules.DamageMin = 1
	r.world.CombatRuntime.Rules.DamageMax = 1
	profile := r.world.CombatRuntime.Profiles["hero"]
	profile.Initiative = 100
	profile.MaxHP = 400
	r.world.CombatRuntime.Profiles["hero"] = profile
	if err = r.world.CombatRuntime.ValidateInventory(r.inventoryModelFor(true)); err != nil {
		t.Fatal(err)
	}
	if err = r.state.Inventory.Validate(r.inventoryModelFor(true)); err != nil {
		t.Fatal(err)
	}
	return ids
}
func combatPhysicalQuantity(s inv.State, definition, store string) int64 {
	var n int64
	for _, i := range s.Items {
		if i.Definition == definition && (store == "" || i.Location.Store == store) {
			n += i.Quantity
		}
	}
	return n
}
func combatPhysicalWire(t *testing.T, r *Runtime, c *connection, id, action, target string) *pb.PocGameState {
	t.Helper()
	result, snapshot := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: id, Action: action, TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok {
		t.Fatalf("%s: %s", action, result.Message)
	}
	return snapshot
}

func TestCombatInventoryPhysicalMagazineReloadBurstWearAndWireReplay(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	ids := combatPhysicalFixture(t, r, target, false)
	combatStart(t, r, c, target)
	a := r.state.Combat.Actor(playerActorID)
	if a.Ammo != 3 || a.ReserveAmmo != 5 {
		t.Fatalf("physical loaded/reserve projection wrong: %+v", *a)
	}
	beforeTotal := combatPhysicalQuantity(r.state.Inventory, combatFixtureRound, "")
	combatPhysicalWire(t, r, c, "inventory.reload", "reload", "")
	if combatPhysicalQuantity(r.state.Inventory, combatFixtureRound, inv.ItemStore(ids["gun"])) != 6 || r.state.Inventory.Items[ids["reserve"]].Quantity != 2 || combatPhysicalQuantity(r.state.Inventory, combatFixtureRound, "") != beforeTotal {
		t.Fatal("reload invented rounds or did not move actual reserve into gun storage")
	}
	weapon := r.state.Inventory.Items[ids["gun"]]
	q := &pb.PocCombatCommand{RequestId: "inventory.burst", Action: "attack", Mode: "burst", TargetId: target, ExpectedTurn: r.state.Combat.Turn}
	result, _ := combatWire(t, r, c, q)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	if combatPhysicalQuantity(r.state.Inventory, combatFixtureRound, inv.ItemStore(ids["gun"])) != 3 || combatPhysicalQuantity(r.state.Inventory, combatFixtureRound, "") != beforeTotal-3 || r.state.Inventory.Items[ids["gun"]].Condition != weapon.Condition-3000 {
		t.Fatal("three actual projectiles did not consume nested ammunition and three physical wear uses")
	}
	beforeItems, beforeCombat := r.state.Inventory.Clone(), r.state.Combat.Clone()
	result, _ = combatWire(t, r, c, q)
	if !result.Ok || !reflect.DeepEqual(beforeItems, r.state.Inventory) || !reflect.DeepEqual(beforeCombat, r.state.Combat) {
		t.Fatal("replayed burst consumed ammunition, wear or RNG twice")
	}
}
func TestCombatInventoryBorrowedGunDoesNotUnlockForeignLockedOrOtherMagazineAmmo(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	ids := combatPhysicalFixture(t, r, target, true)
	combatStart(t, r, c, target)
	a := r.state.Combat.Actor(playerActorID)
	if a.Weapon.ID != combatFixtureGun || a.Ammo != 3 || a.ReserveAmmo != 5 {
		t.Fatalf("custody weapon or owned accessible ammunition projection wrong: %+v", *a)
	}
	protected := map[string]inv.Item{}
	for _, name := range []string{"foreign", "locked", "otherloaded", "incompatible"} {
		protected[name] = r.state.Inventory.Items[ids[name]]
	}
	combatPhysicalWire(t, r, c, "inventory.borrowed.reload", "reload", "")
	for name, item := range protected {
		if r.state.Inventory.Items[item.ID] != item {
			t.Fatalf("reload consumed inaccessible/incompatible/foreign stock %s", name)
		}
	}
	if r.state.Inventory.Items[ids["gun"]].Owner != target || r.state.Inventory.Items[ids["reserve"]].Quantity != 2 {
		t.Fatal("using custody silently transferred ownership or failed to use owned compatible reserve")
	}
}
func TestCombatInventoryRealBladeWoundsConsumeMedicalPatchAndSave(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	combatPhysicalFixture(t, r, target, false)
	combatStart(t, r, c, target)
	combatPhysicalWire(t, r, c, "inventory.let.opponent.act", "end", "")
	hero := r.state.Combat.Actor(playerActorID)
	if !r.state.Combat.Active || r.state.Combat.Current().ID != playerActorID || hero.Bleeding <= 0 || hero.HP >= hero.MaxHP {
		t.Fatal("actual enemy blade turn did not produce a treatable persistent wound")
	}
	hp, meds := hero.HP, combatPhysicalQuantity(r.state.Inventory, "item.med_patch", "")
	used := int64(0)
	for r.state.Combat.Actor(playerActorID).Bleeding > 0 {
		before := r.state.Combat.Actor(playerActorID).Bleeding
		if used >= int64(r.world.CombatRuntime.Rules.APPerTurn/r.world.CombatRuntime.Rules.BandageAP) {
			t.Fatal("fixture bleeding cannot be treated within the current action budget")
		}
		combatPhysicalWire(t, r, c, "inventory.bandage."+strconv.FormatInt(used, 10), "bandage", "")
		used++
		if r.state.Combat.Actor(playerActorID).HP != hp || r.state.Combat.Actor(playerActorID).Bleeding != max(0, before-r.world.CombatRuntime.Rules.BandageAmount) || combatPhysicalQuantity(r.state.Inventory, "item.med_patch", "") != meds-used {
			t.Fatal("bandage healed freely or failed to consume exactly one patch for the authored bleeding reduction")
		}
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if loaded.Combat.Actor(playerActorID).HP != hp || loaded.Combat.Actor(playerActorID).Bleeding != 0 || !reflect.DeepEqual(loaded.Inventory, r.state.Inventory) {
		t.Fatal("save/load reset wound consequences or physical treatment stock")
	}
}
func TestCombatInventoryEquipAuthoredKnifeFromBagMovesRealItemsAndCostsAP(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	ids := combatPhysicalFixture(t, r, target, false)
	knife := ""
	keys := make([]string, 0, len(r.state.Inventory.Items))
	for id := range r.state.Inventory.Items {
		keys = append(keys, id)
	}
	sort.Strings(keys)
	for _, id := range keys {
		i := r.state.Inventory.Items[id]
		if i.Owner == playerActorID && i.Definition == "item.knife_simple" && i.Location.Store != inv.ActorStore(playerActorID) {
			root, err := r.state.Inventory.Root(r.inventoryModelFor(true), i.Location)
			if err == nil && root.Kind == "actor" && root.Actor == playerActorID {
				knife = id
				break
			}
		}
	}
	if knife == "" {
		t.Fatal("authored hero knife is not physically inside an owned bag")
	}
	old := r.state.Inventory.Items[knife]
	combatStart(t, r, c, target)
	ap := r.state.Combat.Actor(playerActorID).AP
	q := &pb.PocCombatCommand{RequestId: "inventory.equip.knife", Action: "equip", ItemId: knife, ExpectedTurn: r.state.Combat.Turn}
	result, _ := combatWire(t, r, c, q)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	now := r.state.Inventory.Items[knife]
	gun := r.state.Inventory.Items[ids["gun"]]
	if now.Location.Store != inv.ActorStore(playerActorID) || now.Location.Slot != "hand.main" || now.Condition != old.Condition || gun.Location.Store != inv.ActorStore(playerActorID) || gun.Location.Slot != "" || r.state.Combat.Actor(playerActorID).Weapon.ID != "item.knife_simple" || r.state.Combat.Actor(playerActorID).AP != ap-r.world.CombatRuntime.Rules.EquipAP {
		t.Fatal("equip changed a tactical label without physical bag/hand movement and AP cost")
	}
	before := r.state.Inventory.Clone()
	result, _ = combatWire(t, r, c, q)
	if !result.Ok || !reflect.DeepEqual(before, r.state.Inventory) {
		t.Fatal("equipment replay performed another physical transfer")
	}
}
func TestCombatInventoryRegionalArmorUsesPhysicalConditionAndOnlyHitRegion(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	ids := combatPhysicalFixture(t, r, target, false)
	// Use the real unarmed action for small, isolated body-region impacts.
	gun := r.state.Inventory.Items[ids["gun"]]
	_, err := r.state.Inventory.Apply(r.inventoryModelFor(true), inv.Transaction{Actor: playerActorID, Sequence: r.state.Inventory.Cursors[playerActorID].Sequence + 1, Moves: []inv.Move{{Item: gun.ID, Quantity: 1, ExpectedRevision: gun.Revision, To: inv.Location{Kind: "store", Store: inv.ActorStore(playerActorID)}}}})
	if err != nil {
		t.Fatal(err)
	}
	combatStart(t, r, c, target)
	if r.state.Combat.Actor(target).BodyArmor.Head != 20 || r.state.Combat.Actor(target).BodyArmor.Torso != 0 {
		t.Fatal("half-condition physical helmet did not project just head protection")
	}
	before := r.state.Inventory.Items[ids["helmet"]]
	hp := r.state.Combat.Actor(target).HP
	result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "inventory.head", Action: "attack", BodyPart: "head", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok {
		t.Fatal(result.Message)
	}
	after := r.state.Inventory.Items[ids["helmet"]]
	if r.state.Combat.Actor(target).HP != hp || after.Condition >= before.Condition || r.state.Combat.Actor(target).BodyArmor.Head >= 20 {
		t.Fatal("absorbed head impact did not wear and reduce physical helmet protection")
	}
	result, _ = combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "inventory.torso", Action: "attack", BodyPart: "torso", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok {
		t.Fatal(result.Message)
	}
	if r.state.Combat.Actor(target).HP >= hp || r.state.Inventory.Items[ids["helmet"]].Condition != after.Condition {
		t.Fatal("helmet protected/wore for a different body region")
	}
}

func combatAmbientBlastSpots(t *testing.T, r *Runtime, target string) (behavior.Cell, behavior.Cell, behavior.Cell) {
	t.Helper()
	hero := r.state.Life.Actor(playerActorID)
	level := hero.Level
	model := r.state.Life.GateModel(r.world.Life)
	space := model.Space(level, nil)
	occupied := r.state.Life.BlockedCells(level, "")
	free := func(at behavior.Cell) bool {
		return at.X >= 0 && at.Y >= 0 && at.X < space.Width && at.Y < space.Height && space.Walkable(at) && !space.Blocked[at] && !occupied[at]
	}
	for y := max(0, hero.Position.Y-10); y < min(space.Height, hero.Position.Y+11); y++ {
		for x := max(0, hero.Position.X-10); x < min(space.Width, hero.Position.X+11); x++ {
			centre := behavior.Cell{X: x, Y: y}
			distance := r.combatWorldDistance(level, hero.Position, centre)
			if !free(centre) || distance < 2500 || distance > 4000 || r.combatWorldDistance(level, r.state.Life.Actor(target).Position, centre) < 1800 || !r.combatSight(level, hero.Position, centre) {
				continue
			}
			if v := r.world.Decks[level]; v != nil {
				a, _ := v.SurfaceIndex(hero.Position)
				b, ok := v.SurfaceIndex(centre)
				if !ok || a != b || !v.CombatThrowClear(hero.Position, centre) {
					continue
				}
			}
			spots := []behavior.Cell{}
			for _, d := range []behavior.Cell{{X: 1}, {X: -1}, {Y: 1}, {Y: -1}, {X: 2}, {X: -2}, {Y: 2}, {Y: -2}} {
				at := behavior.Cell{X: centre.X + d.X, Y: centre.Y + d.Y}
				if !free(at) || r.combatWorldDistance(level, centre, at) > 1000 {
					continue
				}
				if v := r.world.Decks[level]; v != nil && v.CombatBlastProtection(centre, at) >= 1 {
					continue
				}
				spots = append(spots, at)
			}
			if len(spots) >= 2 {
				return centre, spots[0], spots[1]
			}
		}
	}
	t.Fatal("ordinary authored floor has no clear initial arrangement for an ambient blast fixture")
	return behavior.Cell{}, behavior.Cell{}, behavior.Cell{}
}
func TestCombatInventoryBlindBlastHurtsNamedAndPopulationBodiesWithoutOutcomeLeak(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	ids := combatPhysicalFixture(t, r, target, false)
	if len(r.state.Life.Population.Actors) == 0 {
		population, err := r.world.Life.Population.Start(r.world.Life, 1, r.state.Life.Seconds, r.state.Tick)
		if err != nil {
			t.Fatal(err)
		}
		r.state.Life.Population = population
	}
	centre, namedAt, popAt := combatAmbientBlastSpots(t, r, target)
	named := ""
	for i := range r.state.Life.Actors {
		a := &r.state.Life.Actors[i]
		if a.ID == playerActorID || a.ID == target {
			continue
		}
		if _, responder := r.world.CombatLife.Responders[a.ID]; responder {
			continue
		}
		named = a.ID
		a.Level = r.currentLevel()
		a.Position = namedAt
		a.Goal = namedAt
		a.Path = nil
		a.PendingPath = nil
		a.Body = nil
		a.Arrived = true
		a.Manual = true
		a.CombatHold = false
		a.Trip = nil
		break
	}
	if named == "" || len(r.state.Life.Population.Actors) == 0 {
		t.Fatal("ordinary world lacks existing named/population actors")
	}
	population := &r.state.Life.Population.Actors[0]
	population.Level = r.currentLevel()
	population.Position = popAt
	population.Goal = popAt
	population.Path = nil
	population.Trip = nil
	population.Materialized = true
	population.CombatHold = false
	populationID := population.ID
	location := r.world.Life.Locations[r.currentLevel()]
	location.PlayerRangeCells = 3
	r.world.Life.Locations[r.currentLevel()] = location
	r.updateLifeExploration()
	combatStart(t, r, c, target)
	if r.state.Combat.Actor(named) != nil || r.state.Combat.Actor(populationID) != nil {
		t.Fatal("ambient fixture body joined the turn queue before the blast")
	}
	before := r.state.Inventory.Items[ids["grenade"]].Quantity
	result, snapshot := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "inventory.ambient.blast", Action: "throw", ItemId: combatFixtureFrag, X: int32(centre.X), Y: int32(centre.Y), ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok {
		t.Fatal(result.Message)
	}
	for _, id := range []string{named, populationID} {
		a, ok := r.state.CombatRoster[id]
		if !ok || a.HP != 0 || !r.combatLifeHeld(id) {
			t.Fatalf("physical ambient blast did not leave a persistent held body: %s %+v", id, a)
		}
	}
	if r.state.Life.Actor(named).Position != namedAt || r.state.Life.Population.Actors[0].Position != popAt || r.state.Inventory.Items[ids["grenade"]].Quantity != before-1 {
		t.Fatal("blast teleported a body or failed to consume its physical explosive")
	}
	if snapshot == nil || snapshot.Combat == nil {
		t.Fatal("accepted blast lacks a public snapshot")
	}
	for _, a := range snapshot.SceneAgents {
		if a.Id == named || a.Id == populationID {
			t.Fatal("hidden ambient casualty leaked through ordinary scene projection")
		}
	}
	for _, a := range snapshot.Combat.Actors {
		if a.Id == named || a.Id == populationID {
			t.Fatal("hidden ambient casualty appeared as a known combat actor")
		}
	}
	previous := uint64(0)
	for _, e := range snapshot.Combat.Events {
		if e.ActorId == named || e.ActorId == populationID || e.TargetId == named || e.TargetId == populationID {
			t.Fatal("hidden blast outcome disclosed a victim")
		}
		if previous != 0 && e.Sequence != previous+1 {
			t.Fatal("private collateral produced a gap in public event numbers")
		}
		previous = e.Sequence
	}
	if err := r.state.Inventory.Validate(r.inventoryModelFor(true)); err != nil {
		t.Fatal(err)
	}
	t.Logf("physical hidden blast: named=%s population=%s centre=%v, public events=%d", named, populationID, centre, len(snapshot.Combat.Events))
}

func TestCombatInventoryBurstRecomputesPhysicalArmourAfterEachProjectile(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	ids := combatPhysicalFixture(t, r, target, false, true)
	combatStart(t, r, c, target)
	if r.state.Combat.Actor(target).BodyArmor.Torso != 1 {
		t.Fatal("fragile initial physical vest did not project one point")
	}
	hp := r.state.Combat.Actor(target).HP
	result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "inventory.fragile.vest.burst", Action: "attack", Mode: "burst", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok {
		t.Fatal(result.Message)
	}
	if r.state.Combat.Actor(target).HP != hp-5 || r.state.Inventory.Items[ids["vest"]].Condition != 240000 || r.state.Combat.Actor(target).BodyArmor.Torso != 0 {
		t.Fatal("burst reused pre-command protection or physical armour wear did not match each projectile")
	}
}
