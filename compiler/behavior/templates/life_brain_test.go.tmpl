 bad:=*m.Places[0].Seating;bad.Queue=[]LifeSpot{{ID:"q1",At:Cell{1,5},Pose:"stand"}};if bad.validate(l,m.Places[0])==nil{t.Fatal("a queue place on a seat cell was accepted")}
