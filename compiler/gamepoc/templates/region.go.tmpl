 locale:="";if len(locales)>0{locale=locales[0]};result:=&pb.PocRegionMap{Id:r.world.Region.ID,Name:r.localText(locale,"region.map."+r.world.Region.ID+".name",r.world.Region.Name)};visibleDecks:=map[string]bool{}
