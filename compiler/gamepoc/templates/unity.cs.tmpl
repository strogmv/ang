        enum SceneDrawKind { Block, Entity, Agent, Hero }
        struct SceneDrawItem
        {
            public SceneDrawKind Kind;
            public Vector2 Position;
            public string ID;
            public Texture2D Texture;
            public Entity Entity;
            public PocAgentState Agent;
            // Blocks end at their front footprint corner; actors stand at cell centres.
            // The shared +1 centre offset is omitted from both coordinate systems.
            public float Depth { get { return Position.x + Position.y + (Kind == SceneDrawKind.Block ? 1f : 0f); } }
        }
        readonly List<SceneDrawItem> sceneDrawItems = new List<SceneDrawItem>(512);
        static readonly Comparison<SceneDrawItem> sceneDrawComparison = CompareSceneDrawItems;
        static int CompareSceneDrawItems(SceneDrawItem a, SceneDrawItem b)
        {
            int order = a.Depth.CompareTo(b.Depth); if (order != 0) return order;
            // At a shared footprint edge the actor is in front of the block.
            int aLayer = a.Kind == SceneDrawKind.Block ? 0 : 1, bLayer = b.Kind == SceneDrawKind.Block ? 0 : 1;
            order = aLayer.CompareTo(bLayer); if (order != 0) return order;
            order = a.Position.x.CompareTo(b.Position.x); if (order != 0) return order;
            order = string.CompareOrdinal(a.ID, b.ID); if (order != 0) return order;
            return ((int)a.Kind).CompareTo((int)b.Kind);
        }
        void DrawSceneItems(Vector2 origin, float tw, float th)
        {
            sceneDrawItems.Sort(sceneDrawComparison);
            foreach (SceneDrawItem item in sceneDrawItems)
            {
                Vector2 position = item.Position;
                switch (item.Kind)
                {
                    case SceneDrawKind.Block:
                        DrawSprite(item.Texture, origin + new Vector2((position.x-position.y)*tw/2, (position.x+position.y)*th/2), tw, th);
                        break;
                    case SceneDrawKind.Entity:
                        DrawActor(origin, tw, th, position, item.Entity.Name, new Color(.61f,.68f,.57f));
                        break;
                    case SceneDrawKind.Agent:
                        DrawDemoAgent(origin, tw, th, item.Agent, position);
                        break;
                    case SceneDrawKind.Hero:
                        DrawCharacter(origin,tw,th,position,"char.hero",state.PlayerName,amber,new Vector2(state.PlayerX,state.PlayerY),state.Path,state.MotionStartNs,state.MovementStepNs,state.CaptureOrder!=null&&state.CaptureOrder.Captured,Vector2.zero);
                        break;
                }
            }
            // Release snapshot references while retaining the command buffer capacity.
            sceneDrawItems.Clear();
        }
        void DrawGame()
        {
            if (state == null || !state.Active) { page = "menu"; return; }
            if (DrawLocationSDKGame()) return;
            if (DrawPaintedGame()) return;
            UpdateMotion();
            Vector2 origin;float tw,th;GetSpatialProjection(out origin,out tw,out th);
            if(!HudBlocksWorldInput(Event.current.mousePosition))HandleSpatialInput(ref origin,ref tw,ref th);
            int minX,maxX,minY,maxY;SpatialCellBounds(origin,tw,th,out minX,out maxX,out minY,out maxY);
            Rect viewport=SpatialViewport();var drawOrigin=origin-viewport.position;
            GUI.BeginGroup(viewport);spatialClipped=true;
            PocObserverView view=ObserverView();
            sceneDrawItems.Clear();
            // Floors first; queue only authoritative observed blocks for the shared depth pass.
            // One bounded cell traversal, with no actor search inside the terrain loop.
            for(int sum=minX+minY;sum<=maxX+maxY;sum++)for(int y=minY;y<=maxY;y++)
            {
                int x=sum-y;if(x<minX||x>maxX)continue;
                char visibility=ViewCell(view,x,y);if(visibility=='0'||view==null||y>=view.Terrain.Count||x>=view.Terrain[y].Length)continue;
                char cell=view.Terrain[y][x];Vector2 at=drawOrigin+new Vector2((x-y)*tw/2,(x+y)*th/2);
                if(!SpatialDrawVisible(new Rect(at.x,at.y-180*SpatialSpriteScale(tw),tw,th+180*SpatialSpriteScale(tw))))continue;
                PocSprite sprite;glyphSprites.TryGetValue(cell,out sprite);
                bool block=sprite!=null&&sprite.shape=="block";
                Texture2D texture=SpriteTexture(sprite,x,y);if(block)texture=SpatialPropTexture(x,y,cell,texture);
                {
                    Texture2D floor=block?SpriteTexture(floorSprite,x,y):texture;
                    // Zone palette/asset substitution applies to real floor, never to an opaque wall.
                    bool ordinaryFloor=cell!='#'&&(block||sprite==null||sprite.style=="floor");
                    if(ordinaryFloor)floor=SpatialFloorTexture(x,y,floor);
                    if(visibility=='1')floor=RememberedTexture(floor);
                    if(floor!=null)DrawSprite(floor,at,tw,th,SpatialFloorColor(x,y,visibility=='1'));
                    else {Color before=GUI.color;GUI.color=visibility=='1'?new Color(.15f,.15f,.15f):new Color(.22f,.28f,.25f);GUI.DrawTexture(new Rect(at.x,at.y,tw,th),diamond);GUI.color=before;}
                    if(ordinaryFloor)DrawSpatialFloorLight(x,y,at,tw,th,visibility=='1');
                    if(!block&&cell!='#')DrawSpatialFloorMarks(x,y,at,tw,th,visibility=='1');
                }
                if(block&&texture!=null)
                {
                    if(visibility=='1')texture=RememberedTexture(texture);
                    sceneDrawItems.Add(new SceneDrawItem { Kind=SceneDrawKind.Block, Position=new Vector2(x,y), Texture=texture });
                }
            }
            if(hudDebugOpen)DrawPerceptionOverlay(drawOrigin,tw,th);
            foreach(Entity e in state.Entities)if(ViewSees(e.X,e.Y))
                sceneDrawItems.Add(new SceneDrawItem { Kind=SceneDrawKind.Entity, Position=new Vector2(e.X,e.Y), ID=e.Id, Entity=e });
            QueueDemoAgents();
            if(ViewSees(state.PlayerX,state.PlayerY))
                sceneDrawItems.Add(new SceneDrawItem { Kind=SceneDrawKind.Hero, Position=shownPosition+(state.CaptureOrder!=null&&!state.CaptureOrder.Delivered&&!string.IsNullOrEmpty(state.CaptureOrder.CarrierId)?new Vector2(0,.35f):Vector2.zero), ID="char.hero" });
            DrawSceneItems(drawOrigin,tw,th);
            if(clock.Elapsed.TotalSeconds<markerUntil)
            {
                Vector2 at=CellScreen(drawOrigin,tw,th,clickedTile.x,clickedTile.y);Color before=GUI.color;
                GUI.color=ackMS<0?amber:moveAccepted?new Color(.35f,.85f,.5f):new Color(.95f,.35f,.3f);
                GUI.DrawTexture(new Rect(at.x-5,at.y-5,10,10),disc);GUI.color=before;
            }
            DrawCaptureMarkers(drawOrigin,tw,th);
            spatialClipped=false;GUI.EndGroup();
            if(hudDebugOpen&&LifeSpatialCamera())GUI.Label(new Rect(68,592,520,24),"Колесо: масштаб "+Mathf.RoundToInt(spatialZoom*100)+"% · клетка 1 м · камера следует за героем",smallStyle);

            if (state.Life != null && state.Life.Enabled) DrawLifeOverlay(origin,tw,th); else if(hudDebugOpen)DrawCaptureEvents();
            if(hudDebugOpen)DrawPerceptionControls();
            if(state.Life!=null&&state.Life.Enabled&&(inspectionProofPointer.HasValue||(SpatialViewport().Contains(Event.current.mousePosition)&&!HudBlocksWorldInput(Event.current.mousePosition))))DrawLifeInspection(origin,tw,th);
            // This timestamp is taken on a real repaint, after drawing the hero,
            // at >= one screen pixel of displacement, not when a packet arrives.
            if (Event.current.type == EventType.Repaint && beginPending && moveAccepted && state.LastMoveSeq == pendingMove)
            {
                Vector2 delta = shownPosition - clickStartPosition;
                float pixels = new Vector2((delta.x - delta.y) * tw / 2, (delta.x + delta.y) * th / 2).magnitude * Mathf.Min(Screen.width / 1280f, Screen.height / 800f);
                if (pixels >= 1)
                {
                    beginMS = (clock.Elapsed.TotalSeconds - clickAt) * 1000; beginPending = false; latencyResultReady = true;
                }
            }
        }
        void LoadSprites()
        {
            if (resource.art == null || resource.art.sprites == null) return;
            var byName = new Dictionary<string, PocSprite>();
            foreach (PocSprite sprite in resource.art.sprites)
            {
                byName[sprite.name] = sprite;
                var textures = new Texture2D[Math.Max(1, sprite.variants)];
                for (int v = 0; v < textures.Length; v++)
                {
                    string file = textures.Length == 1 ? sprite.name : sprite.name + "_" + v;
                    Texture2D texture = Resources.Load<Texture2D>("Sprites/" + file) ?? Resources.Load<Texture2D>("Sprites/generated/" + file);
                    if (texture != null) { texture.filterMode = FilterMode.Point; texture.wrapMode = TextureWrapMode.Clamp; }
                    textures[v] = texture; if (texture != null) RememberedTexture(texture);
                }
                spriteTextures[sprite.name] = textures;
                if (floorSprite == null && sprite.style == "floor") floorSprite = sprite;
            }
            foreach (PocTile tile in resource.art.tiles) if (!string.IsNullOrEmpty(tile.glyph) && byName.ContainsKey(tile.sprite)) glyphSprites[tile.glyph[0]] = byName[tile.sprite];
        }

        void LoadCharacters()
        {
            PocCharacterArt characters = resource.art == null ? null : resource.art.characters;
            if (characters == null || characters.sheets == null || characters.actors == null) return;
            foreach (PocCharacterSheet sheet in characters.sheets)
            {
                characterSheets[sheet.id] = sheet;
                Texture2D texture = Resources.Load<Texture2D>(sheet.image);
                if (texture != null) { texture.filterMode = sheet.smooth_filter?FilterMode.Bilinear:FilterMode.Point; texture.wrapMode = TextureWrapMode.Clamp; }
                characterTextures[sheet.id] = texture;
                if(sheet.frames!=null&&sheet.frames.Length>0){
                    var lookup=new Dictionary<long,PocCharacterFrame>();
                    foreach(var crop in sheet.frames)lookup[((long)crop.row<<32)|(uint)crop.column]=crop;
                    characterFrames[sheet.id]=lookup;
                }
                if(!string.IsNullOrEmpty(sheet.idle_image)){
                    Texture2D idle=Resources.Load<Texture2D>(sheet.idle_image);
                    if(idle!=null){idle.filterMode=FilterMode.Point;idle.wrapMode=TextureWrapMode.Clamp;}
                    characterIdleTextures[sheet.id]=idle;
                }
            }
            foreach (PocCharacterBinding binding in characters.actors) characterBindings[binding.id] = binding.sheet;
        }

        // Variant choice is visual only and deterministic from seed and cell, so every launch draws the same floor.
        Texture2D SpriteTexture(PocSprite sprite, int x, int y)
        {
            Texture2D[] textures;
            if (sprite == null || !spriteTextures.TryGetValue(sprite.name, out textures)) return null;
            uint h = (uint)x * 0x9e3779b1u ^ (uint)y * 0x85ebca6bu ^ (uint)resource.config.seed * 0xc2b2ae35u;
            h ^= h >> 15; h *= 0x2c1b3c6du; h ^= h >> 12; h *= 0x297a2d39u; h ^= h >> 15;
            int total = 0; foreach (int w in sprite.weights) total += Math.Max(1, w);
            int pick = (int)(h % (uint)Math.Max(1, total)), index = 0;
            for (int i = 0; i < sprite.weights.Length; i++) { int w = Math.Max(1, sprite.weights[i]); if (pick < w) { index = i; break; } pick -= w; }
            return textures[Math.Min(index, textures.Length - 1)];
        }

