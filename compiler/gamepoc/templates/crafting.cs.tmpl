  // keyboard / controller once per frame (OnGUI runs several times a frame)
  void CraftingInput(bool open) {
   if (craftingFrame == Time.frameCount || loadingActive || verify) return;
   craftingFrame = Time.frameCount;
   var v = CraftingView(); if (v == null) return;
   if (!open) {
    if (Input.GetKeyDown(KeyCode.K) || Input.GetKeyDown(KeyCode.JoystickButton3)) CraftingOpen(v.Counter != null ? "order" : CraftingRebindHere(v) != null ? "learn" : craftingTab);
    return;
   }
   if (Input.GetKeyDown(KeyCode.K) || Input.GetKeyDown(KeyCode.JoystickButton1)) { page = "game"; return; }
   int dir = 0;
   if (Input.GetKeyDown(KeyCode.Q) || Input.GetKeyDown(KeyCode.JoystickButton4)) dir = -1;
   if (Input.GetKeyDown(KeyCode.E) || Input.GetKeyDown(KeyCode.JoystickButton5)) dir = 1;
   if (dir != 0) { var tabs = CraftingAvailableTabs(v); int i = Math.Max(0, tabs.IndexOf(craftingTab)); craftingTab = tabs[(i + dir + tabs.Count) % tabs.Count]; craftingSelected = 0; craftingListScroll = Vector2.zero; }
   float axis = Input.GetAxisRaw("Vertical");
   int step = axis > .5f ? -1 : axis < -.5f ? 1 : 0;
   if (step != 0 && step != craftingAxis) craftingSelected += step;
   craftingAxis = step;
   if (Input.GetKeyDown(KeyCode.Return) || Input.GetKeyDown(KeyCode.Space) || Input.GetKeyDown(KeyCode.JoystickButton0)) {
    var rows = CraftingRows(v); if (rows.Count == 0) return;
    craftingSelected = Mathf.Clamp(craftingSelected, 0, rows.Count - 1);
    CraftingPrimary(rows[craftingSelected]);
   }
  }
