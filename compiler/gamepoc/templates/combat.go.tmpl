 act:=behavior.CombatAction{Type:q.Action,Mode:q.Mode,ItemID:q.ItemId,TargetID:q.TargetId};if q.Action=="bandage"||q.Action=="heal"{act.TargetID="";act.Mode="dressing";if q.Action=="heal"{act.Mode="medkit";act.ItemID="item.medkit_guard"}}
