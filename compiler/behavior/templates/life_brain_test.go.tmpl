 for i:=0;i<3;i++{b:=&LifeBrain{Initialized:true,RationOrder:"order.fixture",LastSecond:noon,Needs:[5]int64{150000,100000,0,0,0},WorkDays:map[int64]int64{}};id:=fmt.Sprintf("p%d",i)
