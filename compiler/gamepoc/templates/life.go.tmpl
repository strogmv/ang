	return r.lifeWalkToPoint(target, 0, 0, false, false, 0)
}
func (r *Runtime) lifeWalkToPoint(target behavior.Cell, x, y float64, point, run bool, seq uint64) bool {
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || hero.Trip != nil || r.state.Paused || hero.CombatHold {
		return false
	}
	// Movement v2 (document 87): in a modular location the hero is a continuous body.
	if model := r.state.Life.GateModel(r.world.Life); model.BodyCapable(hero.Level) {
		r.heroBodyNow()
		manual, level, edge, at, denied := hero.Manual, hero.OverrideLevel, hero.OverrideEdge, hero.OverrideAt, hero.AdmissionDeniedEdge
		hero.Manual = true
		hero.OverrideLevel = ""
		hero.OverrideEdge = ""
		hero.AdmissionDeniedEdge = ""
		r.state.Life.EnsureHeroBody(model)
		if !r.state.Life.RouteHeroBody(model, target, x, y, point, run, seq) {
			hero.Manual, hero.OverrideLevel, hero.OverrideEdge, hero.OverrideAt, hero.AdmissionDeniedEdge = manual, level, edge, at, denied
			r.state.Life.EnsureHeroBody(model)
			r.syncLifeHero()
			return false
		}
		r.resetInstantTravel()
		r.syncLifeHero()
		r.state.Life.ObserveDecisions()
		return true
	}
	from := hero.Position
	moving := len(hero.Path) > 0
	if moving {
		from = hero.Path[0]
	}
	route, allowed := r.state.Life.MoveRoute(r.world.Life, hero.ID, hero.Level, from, target, r.lifeMotionTick())
	if !allowed {
		return false
	}
	if moving {
		route = append([]behavior.Cell{from}, route...)
	} else {
		hero.MoveStartTick = r.lifeMotionTick()
	}
	r.resetInstantTravel()
	hero.AdmissionDeniedEdge = ""
	hero.Path = route
	hero.PendingPath = nil
	hero.Goal = target
	hero.Manual = true
	hero.OverrideLevel = ""
	hero.OverrideEdge = ""
	hero.Arrived = false
	hero.Activity = "walking"
	hero.Label = "Свободное движение"
	r.syncLifeHero()
	r.state.Life.ObserveDecisions()
	return true
}
func (r *Runtime) validateLifeSave(s state) error {
	if !s.Active || s.Tick < 0 || s.Speed != 1 || s.PhaseNS < 0 || s.PhaseNS >= r.tickNS() {
		return errors.New("invalid life clock")
	}
	if err := s.Life.Validate(r.world.Life, s.Tick); err != nil {
		return err
	}
	if err := r.validateRegionKnowledge(s); err != nil {
		return err
	}
	hero := s.Life.Actor(playerActorID)
	if hero == nil || s.Player != location(hero.Position) {
		return errors.New("invalid life hero")
	}
	if s.Life.Population.Count > 0 {
		active := ""
		if hero.Trip == nil {
			active = hero.Level
		}
		if s.Life.Population.ActiveLevel != active {
			return errors.New("population active level differs from hero")
		}
	}
	if len(s.Path) != len(hero.Path) || s.MoveStartNS != r.lifeMotionStartNS(hero.MoveStartTick, s.Life, s.Tick) {
		return errors.New("invalid mirrored life motion")
	}
	for i, at := range s.Path {
		if at != location(hero.Path[i]) {
			return errors.New("invalid mirrored life path")
		}
	}
	if err := r.validateInventory(s); err != nil {
		return err
	}
	for i, u := range s.Life.Maintenance.Units {
		if !u.PartsInstalled {
			continue
		}
		cfg := r.world.Life.Maintenance.Assets[i]
		present := false
		for _, item := range s.Inventory.Items {
			if item.Location.Kind == "store" && item.Location.Store == cfg.Store("installed") && item.Definition == cfg.PartDefinition && item.Condition == 1000000 {
				present = true
			}
		}
		if !present {
			return errors.New("repair save missing installed part")
		}
	}
	for level, cells := range s.LifeExploration {
		l, ok := r.world.Life.Locations[level]
		if !ok {
			return errors.New("unknown remembered life level")
		}
		size := len(l.Terrain) * len(l.Terrain[0])
		for i, c := range cells {
			if i < 0 || i >= size || len(c.Glyph) != 1 || c.Tick < 0 || c.Tick > s.Tick {
				return fmt.Errorf("invalid life memory")
			}
		}
	}
	return nil
}

func (r *Runtime) lifeExitKnown(edge behavior.LifeEdge) bool {
	hero := r.state.Life.Actor(playerActorID)
	if e:=r.world.CalendarEncounter;e!=nil&&(edge.ID==e.MedicalEdge||edge.ID==e.GateEdge){return false}
 if hero == nil || hero.Trip != nil || hero.Level != edge.From {
		return false
	}
	width := len(r.currentTerrain()[0])
	if _, ok := r.state.LifeExploration[hero.Level][edge.Exit.Y*width+edge.Exit.X]; ok {
		return true
	}
	return behavior.Distance(hero.Position, edge.Exit) <= r.world.Visibility.PlayerRange && r.sightLine(location(hero.Position), location(edge.Exit))
}

func (r *Runtime) installLifePart(cfg behavior.MaintenanceAsset, leader string) error {
	actor := r.state.Life.Actor(leader)
	if actor == nil || actor.Trip != nil || actor.Level != cfg.Level || behavior.Distance(actor.Position, cfg.At) != 1 {
		return errors.New("repair worker out of reach")
	}
	ids := make([]string, 0, len(r.state.Inventory.Items))
	for id := range r.state.Inventory.Items {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	var spare string
	var moves []inv.Move
	for _, id := range ids {
		item := r.state.Inventory.Items[id]
		if item.Location.Kind != "store" {
			continue
		}
		if item.Location.Store == cfg.Store("spares") && item.Definition == cfg.PartDefinition && item.Condition == 1000000 && spare == "" {
			spare = id
		}
		if item.Location.Store == cfg.Store("installed") {
			moves = append(moves, inv.Move{Item: id, Quantity: item.Quantity, ExpectedRevision: item.Revision, To: inv.Location{Kind: "store", Store: cfg.Store("retired")}})
		}
	}
	if spare == "" {
		return errors.New("no replacement part")
	}
	item := r.state.Inventory.Items[spare]
	moves = append(moves, inv.Move{Item: spare, Quantity: 1, ExpectedRevision: item.Revision, To: inv.Location{Kind: "store", Store: cfg.Store("installed")}})
	_, err := r.state.Inventory.Apply(r.inventoryModelFor(r.state.Life.Enabled), inv.Transaction{Actor: leader, Sequence: r.state.Inventory.Cursors[leader].Sequence + 1, Moves: moves})
	return err
}
func (r *Runtime) checkLifeEquipment() {
	for i, cfg := range r.world.Life.Maintenance.Assets {
		found := false
		for _, item := range r.state.Inventory.Items {
			if item.Location.Kind == "store" && item.Location.Store == cfg.Store("installed") && item.Definition == cfg.PartDefinition && item.Condition > 0 {
				found = true
				break
			}
		}
		if found {
			continue
		}
		u := &r.state.Life.Maintenance.Units[i]
		if u.Phase == "normal" {
			_ = r.state.Life.MaintenanceFault(cfg.ID)
		}
		u.Fault = true
		if u.PartsInstalled {
			u.PartsInstalled = false
			u.Elapsed = 0
			u.Phase = "waiting_crew"
			if len(u.Crew) > 0 {
				u.Phase = "waiting_parts"
			}
			u.RetryAt = r.state.Life.Seconds
		}
	}
}
func (r *Runtime) appendLifeMaintenance(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView) {
	view.MaintenanceDebug = r.world.Config.DebugPerception
	for i, cfg := range r.world.Life.Maintenance.Assets {
		if !r.world.Config.DebugPerception && (hero.Trip != nil || hero.Level != cfg.Level || !viewSees(perception, int32(cfg.At.X), int32(cfg.At.Y))) {
			continue
		}
		u := r.state.Life.Maintenance.Units[i]
		spares := int64(0)
		for _, item := range r.state.Inventory.Items {
			if item.Location.Kind == "store" && item.Location.Store == cfg.Store("spares") && item.Definition == cfg.PartDefinition && item.Condition == 1000000 {
				spares += item.Quantity
			}
		}
		view.Equipment = append(view.Equipment, &pb.PocMaintenanceUnit{Id: cfg.ID, Name: cfg.Name, LevelId: cfg.Level, X: int32(cfg.At.X), Y: int32(cfg.At.Y), Phase: u.Phase, Status: u.Label(), Operational: u.Operational(), AgeSeconds: u.Age, ServiceLifeSeconds: cfg.ServiceLife, ElapsedSeconds: u.Elapsed, RepairSeconds: cfg.RepairSeconds, TestSeconds: cfg.TestSeconds, Crew: append([]string(nil), u.Crew...), Replacements: int32(u.Replacements), Spares: int32(spares), Reason: u.Reason})
	}
}

// LifeDecisionLog returns chronological copies for headless diagnostics.
func (r *Runtime) LifeDecisionLog() (named, population []behavior.LifeDecision) {
	return r.state.Life.Decisions.Ordered(), r.state.Life.Population.Decisions.Ordered()
}

func (r *Runtime) lifeMotionTick() int64 {
	return r.world.Life.MotionTick(r.state.Tick, r.state.Life.Seconds)
}
func (r *Runtime) lifeMotionDurationNS(seconds int64) int64 {
	n := seconds * r.tickNS()
	if r.world.Life.Brain.Enabled {
		n /= r.state.Life.SecondsPerTick
	}
	return n
}
func (r *Runtime) lifeMotionStartNS(start int64, s behavior.LifeState, tick int64) int64 {
	if !r.world.Life.Brain.Enabled {
		return start * r.tickNS()
	}
	return tick*r.tickNS() - (r.world.Life.MotionTick(tick, s.Seconds)-start)*r.tickNS()/s.SecondsPerTick
}

// demo-hub v5-yatai: the observable activity of a body at a seated place (seat, queue, staff post) for the presentation:
// the CUE activity ID, the phase, when it began (game second as a stable identity, sim ns for timing), the transition
// length at the current calendar and the anchor spot. Only bodies the player sees reach the client (visibility filter).
type lifeActivityBody struct {
	id, level string
	at        behavior.Cell
	arrived   bool
	brain     behavior.LifeBrain
	since     int64 // demo-hub v11-text: when a named actor arrived on its cell (a regular's seat)
}

func (r *Runtime) lifeActivityBodies(level string) map[string]lifeActivityBody {
	out := map[string]lifeActivityBody{}
	seated := false
	for _, p := range r.world.Life.Brain.Places {
		if p.Seating != nil && p.Level == level {
			seated = true
			break
		}
	}
	if !seated {
		return out
	}
	for _, a := range r.state.Life.Actors {
		if a.Level == level && a.OnFloor() {
			out[a.ID] = lifeActivityBody{a.ID, a.Level, a.Position, a.Arrived && len(a.Path) == 0, a.Brain, a.StartedAt}
		}
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.Level == level && a.Materialized && a.Trip == nil {
			out[a.ID] = lifeActivityBody{a.ID, a.Level, a.Position, a.Arrived && len(a.Path) == 0, a.Brain, 0}
		}
	}
	return out
}
func (r *Runtime) lifeGameNS(seconds int64) int64 {
	return r.lifeMotionStartNS(seconds-r.world.Life.StartSeconds, r.state.Life, r.state.Tick)
}
func lifeSpotPB(x behavior.LifeSpot) *pb.PocActivitySpot {
	return &pb.PocActivitySpot{Id: x.ID, Pose: x.Pose, CellX: int32(x.At.X), CellY: int32(x.At.Y), XMm: int32(x.XMM), YMm: int32(x.YMM), ZMm: int32(x.ZMM), YawDeg: x.Yaw, TableXMm: int32(x.TableXMM), TableYMm: int32(x.TableYMM), TableZMm: int32(x.TableZMM)}
}
// sellerPostWork (demo-hub v26-alive): a seller at his post packs up in the last minutes of his hours and stays at it until he leaves, lays out in the first minutes. By his own hours, on the Go clock.
func (r *Runtime) sellerPostWork(id string) string {
	day := ((r.state.Life.Seconds % 86400) + 86400) % 86400
	c := r.world.HallClosing
	if c.PhaseSeconds <= 0 {
		return ""
	}
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.Owner != id || sh.Mobile() || sh.CloseSecond-sh.OpenSecond >= 86400 {
			continue
		}
		if day >= sh.CloseSecond-c.PhaseSeconds && day < sh.CloseSecond+c.LingerSeconds {
			return "closing"
		}
		if day >= sh.OpenSecond && day < sh.OpenSecond+c.PhaseSeconds {
			return "opening"
		}
	}
	return ""
}
func (r *Runtime) setLifeActivity(a *pb.PocAgentState, b lifeActivityBody) {
	m := r.world.Life.Brain
	if x, phase, since, ok := b.brain.SeatPresentation(m, b.level, b.at); ok {
		q, _ := m.SeatedPlace(b.brain.Place.ID)
		s := q.Seating
		a.Activity = s.Activity
		a.ActivityPhase = phase
		a.ActivitySpot = lifeSpotPB(x)
		a.ActivitySinceSeconds = since
		a.ActivitySinceNs = r.lifeGameNS(since)
		a.ActivityPhaseNs = a.ActivitySinceNs
		if phase == "rise" {
			a.ActivitySinceSeconds = b.brain.SeatedAt
			a.ActivitySinceNs = r.lifeGameNS(b.brain.SeatedAt)
			a.ActivityTransitionNs = r.lifeMotionDurationNS(s.Rise)
		} else if phase == "sit" {
			a.ActivityTransitionNs = r.lifeMotionDurationNS(s.SitDown)
		}
		return
	}
	if !b.arrived {
		return
	}
	for _, p := range m.Places {
		if p.Seating == nil || p.Level != b.level || !p.Seating.IsStaff(b.id) {
			continue
		}
		if x, ok := p.Seating.SpotAt(b.at); ok && x.Pose == "post" {
			a.Activity = "staff_post"
			a.ActivityPhase = "post"
			a.ActivitySpot = lifeSpotPB(x)
			return
		}
	}
	// demo-hub v14-traders: a seller who arrived on the own counter post stands facing the counter.
	if x, ok := m.CounterPost(b.id, b.level, b.at); ok {
		a.ActivityPhase = "post"
		a.ActivitySpot = lifeSpotPB(x)
		a.PostWork = r.sellerPostWork(b.id)
		return
	}
	// demo-hub v11-text: a regular holding a seat as a routine post sits on it from the moment it arrived on the cell.
	for _, p := range m.Places {
		s := p.Seating
		if s == nil || p.Level != b.level || !s.IsRegular(b.id) {
			continue
		}
		if x, ok := s.SpotAt(b.at); ok && x.Pose == "sit" {
			a.Activity = s.Activity
			a.ActivityPhase = "sit"
			a.ActivitySpot = lifeSpotPB(x)
			a.ActivitySinceSeconds = b.since
			a.ActivitySinceNs = r.lifeGameNS(b.since)
			a.ActivityPhaseNs = a.ActivitySinceNs
			a.ActivityTransitionNs = r.lifeMotionDurationNS(s.SitDown)
			return
		}
	}
}

// Movement v2 (documents 86/87): the continuous body of the controlled hero.
// Input is applied from its arrival time; the body is integrated to "now" (a
// sub-tick motion time) before every input and every publication.
func (r *Runtime) lifeBodyNowMilli() int64 {
	step := r.tickNS()
	phase := r.state.PhaseNS
	if phase > step {
		phase = step
	}
	if phase < 0 {
		phase = 0
	}
	per := int64(1)
	if r.world.Life.Brain.Enabled {
		per = r.state.Life.SecondsPerTick
	}
	return r.lifeMotionTick()*1000 + phase*per*1000/step
}
func (r *Runtime) heroBodyNow() {
	if !r.state.Life.Enabled || !r.state.Active || r.state.Paused {
		return
	}
	h := r.state.Life.Actor(playerActorID)
	if h == nil || h.Body == nil || h.CombatHold {
		return
	}
	r.state.Life.HeroBodyAdvance(r.state.Life.GateModel(r.world.Life), r.lifeBodyNowMilli())
	r.syncLifeHero()
}
func (r *Runtime) heroBodyPB(h *behavior.LifeActor) *pb.PocHeroBody {
	if h == nil || h.Body == nil {
		return nil
	}
	b := h.Body
	m := r.world.Life
	cell := m.Locations[h.Level].CellMM
	per := int64(1)
	if m.Brain.Enabled {
		per = r.state.Life.SecondsPerTick
	}
	walk := float64(cell) * float64(per) * 1e9 / float64(m.MoveTicks*r.tickNS());if h.Sneaking{factor:=m.HeroBody.SneakFactor;if factor==0{factor=.55};walk*=factor}
	out := &pb.PocHeroBody{XMm: b.X, YMm: b.Y, Layer: int32(b.Layer), SampleNs: r.simNS(), Mode: b.Mode, SteerX: b.DX, SteerY: b.DY, TargetXMm: b.TX, TargetYMm: b.TY, Run: b.Run, WalkMmPerS: walk, RunFactor: m.HeroBody.RunFactor, RadiusMm: m.HeroBody.RadiusMM, FollowStopMm: m.HeroBody.FollowStopMM, InputSeq: b.Seq, Moving: b.Moving, CellMm: int32(cell), FaceX: b.FX, FaceY: b.FY, Sneaking:h.Sneaking, WalkableGlyphs: r.walkableGlyphs()}
	for _, w := range b.Route {
		out.Route = append(out.Route, &pb.PocBodyPoint{XMm: w.X, YMm: w.Y, Layer: int32(w.Layer)})
	}
	return out
}

// heroSteer: WASD / stick direction, a held cursor point, or stop. Answered
// with the body only (no full state): the client already predicts the walk.
func (r *Runtime) heroSteer(c *connection, m *pb.PocHeroSteer) {
	result := &pb.PocMoveResult{Epoch: r.state.Epoch, InputSeq: m.InputSeq}
	hero := r.state.Life.Actor(playerActorID)
	switch {
	case r.heroInCombat() || hero != nil && hero.CombatHold:
		result.Reason = "combat_active"
	case !r.state.Life.Enabled || !r.state.Active || hero == nil:
		result.Reason = "Сначала начните игру"
	case r.state.Life.PopulationFailure != "":
		result.Reason = "Симуляция остановлена; загрузите сохранение"
	case m.Epoch != r.state.Epoch:
		result.Reason = "Локация изменилась"
	case m.InputSeq == 0 || m.InputSeq <= c.lastMoveSeq:
		result.Reason = "Устаревшая команда"
	case r.state.Paused:
		result.Reason = "Мир на паузе"
	case hero.Trip != nil:
		result.Reason = "Дождитесь прибытия"
	case !r.state.Life.GateModel(r.world.Life).BodyCapable(hero.Level):
		result.Reason = "Здесь ходьба по клеткам"
	default:
		c.lastMoveSeq = m.InputSeq
		model := r.state.Life.GateModel(r.world.Life)
		r.heroBodyNow()
		hero.Manual = true
		hero.OverrideLevel = ""
		hero.OverrideEdge = ""
		hero.AdmissionDeniedEdge = ""
		r.resetInstantTravel()
		r.state.Life.EnsureHeroBody(model)
		if err := r.state.Life.SteerHeroBody(model, m.Mode, m.X, m.Y, m.Run&&!hero.Sneaking, m.InputSeq); err != nil {
			result.Reason = err.Error()
		} else {
			result.Ok = true
			r.state.LastMoveSeq = m.InputSeq
			r.syncLifeHero()
			r.state.Life.ObserveDecisions()
		}
	}
	if hero != nil && hero.Trip == nil {
		result.HeroBody = r.heroBodyPB(hero)
	}
	r.send(c, &pb.ServerMessage{Msg: &pb.ServerMessage_MoveResult{MoveResult: result}})
}
func (r *Runtime) walkableGlyphs() string {
	keys := make([]string, 0, len(r.world.Life.Walkable))
	for k, ok := range r.world.Life.Walkable {
		if ok {
			keys = append(keys, k)
		}
	}
	sort.Strings(keys)
	out := ""
	for _, k := range keys {
		out += k
	}
	return out
}
