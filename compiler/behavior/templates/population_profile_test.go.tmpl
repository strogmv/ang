func populationProfileReload(t *testing.T,s PopulationState) PopulationState {
 t.Helper();raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var result PopulationState;if err=json.Unmarshal(raw,&result);err!=nil{t.Fatal(err)};return result
}
func TestPopulationProfilePlacesDriveTwoDaysAndReplay(t *testing.T){
 p,l:=populationProfileFixture();s,err:=p.Start(l,4,0,0);if err!=nil{t.Fatal(err)}
 initial:=s.Clone();seen:=map[int]map[string]map[string]bool{};walking:=false;var saved *PopulationState
 for tick:=int64(1);tick<=2880;tick++{
  seconds:=tick*60;env:=PopulationEnvironment{SecondsPerTick:60}
  populationAdvance(t,&s,p,l,seconds,tick,"a",env)
  if saved!=nil{populationAdvance(t,saved,p,l,seconds,tick,"a",env);if !reflect.DeepEqual(s.Clone(),saved.Clone()){t.Fatalf("profile replay diverged at %d",tick)}}
  for i,a:=range s.Actors{
   if !reflect.DeepEqual(a.Profile,initial.Actors[i].Profile){t.Fatal("schedule/LOD rewrote preferred places")}
   if a.Materialized&&len(a.Path)>0{walking=true}
   place:=p.profilePlace(a.Profile,a.Stage)
   if a.Arrived&&place!=nil&&a.Level==place.Level&&a.Position==place.At{
    day:=int(seconds/86400);if seen[day]==nil{seen[day]=map[string]map[string]bool{}};if seen[day][a.ID]==nil{seen[day][a.ID]=map[string]bool{}};seen[day][a.ID][place.StageID]=true
   }
  }
  if tick==600{copy:=populationProfileReload(t,s);saved=&copy}
 }
 for day:=0;day<2;day++{for _,a:=range s.Actors{for _,stage:=range []string{"home","work","market"}{if !seen[day][a.ID][stage]{t.Fatalf("resident %s did not actually reach saved %s during day %d",a.ID,stage,day)}}}}
 if !walking||saved==nil{t.Fatal("no physical homecoming or replay exercised")}
 copy:=s.Clone();copy.Actors[0].Profile.Home.At=Cell{9,9};if copy.Actors[0].Profile.Home.At==s.Actors[0].Profile.Home.At{t.Fatal("clone aliases permanent profile")}
 // Candidate authoring order is not an identity and may change independently.
 for level,cells:=range p.Anchors{for i,j:=0,len(cells)-1;i<j;i,j=i+1,j-1{cells[i],cells[j]=cells[j],cells[i]};p.Anchors[level]=cells}
 if err=s.Validate(p,l,s.LastSeconds,s.LastTick);err!=nil{t.Fatal(err)}
 for i,a:=range s.Actors{if !reflect.DeepEqual(a.Profile,initial.Actors[i].Profile){t.Fatal("anchor reorder lost persistent address")}}
}
func TestPopulationProfileOccupiedPreferenceReturnsWithoutIdentityChange(t *testing.T){
 p,l:=populationProfileFixture();s,err:=p.Start(l,1,0,0);if err!=nil{t.Fatal(err)}
 a:=&s.Actors[0];preferred:=a.Profile.Home.At;identity:=a.Profile.clone();a.Position=Cell{3,0};a.Goal=a.Position;a.Arrived=false;a.Materialized=true;s.ActiveLevel="a"
 env:=PopulationEnvironment{Occupied:map[string]map[Cell]bool{"a":{preferred:true}}};var saved *PopulationState;released:=int64(0);arrived:=false
 for tick:=int64(1);tick<200;tick++{
  old:=a.Position;populationAdvance(t,&s,p,l,tick,tick,"a",env)
  if Distance(old,a.Position)>1{t.Fatal("preference resolution teleported a physical resident")}
  if saved!=nil{populationAdvance(t,saved,p,l,tick,tick,"a",env);if !reflect.DeepEqual(s.Clone(),saved.Clone()){t.Fatal("occupied-preference replay diverged")}}
  if !reflect.DeepEqual(a.Profile,identity){t.Fatal("temporary occupancy reassigned the home")}
  if released==0&&a.Arrived{if a.Position==preferred{t.Fatal("resident occupied an externally blocked preference")};released=tick;copy:=populationProfileReload(t,s);saved=&copy;env=PopulationEnvironment{}}
  if released>0&&tick>released&&a.Arrived&&a.Position==preferred{arrived=true;break}
 }
 if released==0||!arrived{t.Fatalf("fallback did not return after occupancy cleared: %+v",*a)}
}
