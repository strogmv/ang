    case "stunned":b.seconds=.9f;CombatFloat(b.actor,L("ui.combat.stunned"),new Color(1f,.85f,.35f));break;
    case "flee":case "disengage":b.seconds=.5f;CombatFloat(b.actor,L("ui.combat.retreat"),new Color(.9f,.9f,.9f));break;
    case "roll":b.clip=look==null?null:look.roll;b.seconds=CombatClipSeconds(an,b.clip,1.5f);break;
    case "stand":b.clip=look==null?null:(b.mode=="get_up"?(CombatFallOf(b.actor)==null?look.get_up:CombatFallOf(b.actor).get_up):look.bandage_rise);b.seconds=CombatClipSeconds(an,b.clip,2);break;
