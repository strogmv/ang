{{ define "main_server_graceful_shutdown" }}
	srv := &http.Server{
		Addr:    ":" + cfg.HTTPPort,
		Handler: r,
		// Only header reads and idle keep-alives are bounded: read and write
		// timeouts would also cut SSE streams and hijacked WebSockets.
		ReadHeaderTimeout: 10 * time.Second,
		IdleTimeout:       120 * time.Second,
	}
	if d, err := time.ParseDuration(cfg.HTTPReadHeaderTimeout); err == nil && d > 0 {
		srv.ReadHeaderTimeout = d
	}
	if d, err := time.ParseDuration(cfg.HTTPIdleTimeout); err == nil && d > 0 {
		srv.IdleTimeout = d
	}

	go func() {
		log.Info("Starting HTTP server", "addr", srv.Addr)
		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Error("HTTP listen failed", "error", err)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit
	log.Info("Shutting down server...")

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := srv.Shutdown(shutdownCtx); err != nil {
		log.Error("Server shutdown failed", "error", err)
	}

	{{- range $name, $enabled := .WebSocketServices }}
	{{- if $enabled }}
	transport.Stop{{ $name }}Hub()
	{{- end }}
	{{- end }}
{{ end }}
