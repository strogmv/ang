	s.remember(&a, old)
	checked := old
	checked.Checked, checked.CheckedTurn, checked.CheckedAction, checked.ReceivedTurn, checked.ReporterID = true, 3, 8, 3, "second"
	if !combatContactNewer(checked, combatContact(&a, "enemy")) {
