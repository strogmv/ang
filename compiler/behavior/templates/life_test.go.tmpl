func occupiedLifeLanding() (LifeModel, LifeState) {
	m := lifeFixture()
	m.Actors[1].Steps = []LifeStep{{AtMinute: 0, Level: "b", At: m.Edges[0].Entry, Activity: "rest"}}
	s := m.Start()
	a := s.Actor("one")
	a.Step, a.Arrived = 1, false
	a.Position, a.Goal = m.Edges[0].Exit, m.Edges[0].Exit
	a.Trip = &LifeTrip{Edge: "ab", Departure: 0, Arrival: 20}
	a.Activity = "transit"
	return m, s
}

func TestLifeOccupiedDoorResolvesManualArrival(t *testing.T) {
	for _, mode := range []string{"enter", "goto"} {
		t.Run(mode, func(t *testing.T) {
			m, s := occupiedLifeLanding()
			a := s.Actor("one")
			a.Manual, a.OverrideLevel, a.OverrideAt = true, "b", m.Edges[0].Entry
			if mode == "enter" { a.OverrideEdge = "ab" }
			for tick := int64(1); tick <= 20; tick++ {
				s.Advance(m, tick)
				if err := s.Validate(m, tick); err != nil { t.Fatalf("tick %d: %v", tick, err) }
			}
			a = s.Actor("one")
			landing := a.Position
			if a.Trip != nil || a.Level != "b" || landing == m.Edges[0].Entry || Distance(landing, m.Edges[0].Entry) != 1 { t.Fatalf("wrong occupied-door landing: %+v", a) }
			// Save exactly between landing and completing the manual destination.
			raw, err := json.Marshal(s)
			if err != nil { t.Fatal(err) }
			var restored LifeState
			if err := json.Unmarshal(raw, &restored); err != nil { t.Fatal(err) }
			for tick := int64(21); tick <= 40; tick++ {
				s.Advance(m, tick)
				restored.Advance(m, tick)
				if err := s.Validate(m, tick); err != nil { t.Fatal(err) }
			}
			a = s.Actor("one")
			if !a.Arrived || a.Position != landing || len(a.Path) != 0 || a.OverrideLevel != "" || a.OverrideEdge != "" || a.Activity != "rest" { t.Fatalf("manual arrival kept seeking occupied entry: %+v", a) }
			if !reflect.DeepEqual(s, restored) { t.Fatal("landing save/load changed completion") }
		})
	}
}

func TestLifeOccupiedDoorPreservesActualDestination(t *testing.T) {
	for _, mode := range []string{"routine", "goto_inside"} {
		t.Run(mode, func(t *testing.T) {
			m, s := occupiedLifeLanding()
			goal := m.Actors[0].Steps[1].At
			if mode == "goto_inside" {
				goal = Cell{3, 2}
				a := s.Actor("one")
				a.Manual, a.OverrideLevel, a.OverrideAt = true, "b", goal
			}
			for tick := int64(1); tick <= 50; tick++ {
				s.Advance(m, tick)
				if err := s.Validate(m, tick); err != nil { t.Fatalf("tick %d: %v", tick, err) }
			}
			a := s.Actor("one")
			if !a.Arrived || a.Position != goal { t.Fatalf("landing replaced actual destination: %+v", a) }
			if mode == "routine" && (a.Activity != "work" || a.WorkedSeconds == 0) { t.Fatal("routine was replaced by manual rest") }
		})
	}
}

