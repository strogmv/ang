  bool LocationSDKPickMultideck(Vector2 mouse,Rect viewport,out int x,out int y,out int deck){
   x=y=-1;deck=0;if(locationSDKCamera==null||locationSDKNav==null||!viewport.Contains(mouse))return false;float meters=locationSDKLevel.cell_meters;
   var ray=locationSDKCamera.ViewportPointToRay(new Vector3((mouse.x-viewport.x)/viewport.width,1-(mouse.y-viewport.y)/viewport.height,0));float best=float.MaxValue;
