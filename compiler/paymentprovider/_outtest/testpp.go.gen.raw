type PPTest struct {
	txPathLogger model.TxPathLogger
	httpClient httpcli.HTTPTnxClient
	log        *logrus.Entry
}

func New(txPathLogger model.TxPathLogger) *PPTest {
	return &PPTest{
		txPathLogger: txPathLogger,
		httpClient: httpcli.NewHTTPTnxClient(ppSID, txPathLogger),
		log:        logrus.WithFields(logrus.Fields{"source": "PPTestPP"}),
	}
}

func (pp *PPTest) GetProviderInfo() model.ProviderInfo {
	return model.ProviderInfo{
		SID:         ppSID,
		Label:       ppLabel,
		MIDPrefix:   ppMIDPrefix,
		SecretParts: []string{"Key", "Sign"},
	}
}

func (pp *PPTest) InitPay(mc *model.MerchantCreds, ps *model.PaymentSource, tx *model.Transaction) (*model.PaymentResponse, error) {
if ps.APM == nil {
		return nil, providers.ErrAPMSupportOnly
	}

	info := ps.APM.OwnerInfo

	secrets, err := parseSecrets(mc.Secret)
	if err != nil {
		return nil, fmt.Errorf("parsing secrets for %s: %w", ppSID, err)
	}
req := &payinRequest{
		OrderID: tx.Id,
		Amount: helpers.CoinsToFormattedAmount(tx.Amount, tx.Currency),
		Currency: 840,
		ApiKey: secrets.apiKey,
		Salt: generateSalt(),
	}
_ = secrets

	return pp.doPayin(tx, mc, req)

}

func (pp *PPTest) doPayin(tx *model.Transaction, mc *model.MerchantCreds, req httpcli.APIRequest) (*model.PaymentResponse, error) {
	respBody, err := pp.httpClient.Post(tx, mc.ApiEndpoint+endpointPayin, req,
		httpcli.NewHeaders().Add("Content-Type", "application/json"))
	if err != nil {
		if httpcli.IsBadRequestError(err) {
			return &model.PaymentResponse{
				Timestamp: time.Now(),
				Status:    tnxStatusDeclined,
				Code:      model.SCodeDeclinedByBank,
				Message:   model.SCodeDeclinedByBank.Description(),
			}, nil
		}
		return nil, fmt.Errorf("calling %s payin: %w", ppSID, err)
	}

	var resp payinResponse
	if err := json.Unmarshal(respBody, &resp); err != nil {
		return nil, fmt.Errorf(errUnmarshalRespFmt, err)
	}

	return &model.PaymentResponse{
		Timestamp: time.Now(),
		Status:    tnxStatusPending,
		Code:      model.SCodeOk,
		ForeignId: resp.PaymentID,
	}, nil
}

