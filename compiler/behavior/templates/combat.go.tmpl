func (a CombatArmor) At(part string) int {
	switch part {
	case "head":
		return a.Head
	case "arms":
		return a.Arms
	case "legs":
		return a.Legs
	}
	return a.Torso
}
func combatPartDamage(rawDamage int, bodyPart string) int {
	percent := 100
	switch bodyPart {
	case "head":
		percent = 165
	case "arms":
		percent = 75
	case "legs":
		percent = 85
	}
	return int(int64(max(0, rawDamage)) * int64(percent) / 100)
}

// CombatArmorBlocked excludes overkill/HP clamping: only actual protection
// reduces this amount, allowing physical armour wear to use the same result.
func CombatArmorBlocked(a Combatant, rawDamage int, bodyPart string) int {
	return min(combatPartDamage(rawDamage, bodyPart), a.Armor+a.BodyArmor.At(bodyPart))
}

