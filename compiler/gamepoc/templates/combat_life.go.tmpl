// Code generated by ANG. Local witnesses, authored hostile intentions and civilian safety.
package poc

import (
	"fmt"
	"math"
	"sort"
	"strings"

	"angelsdemons/server/internal/behavior"
)

type combatResponder struct {
	Protect              []string `json:"protect"`
	ProtectNoncombatants bool     `json:"protect_noncombatants"`
	Report               bool     `json:"report"`
	Levels               []string `json:"levels"`
}
type combatLifeCatalog struct {
 SurrenderDropsWeapon bool `json:"surrender_drops_weapon"`

	FinishConsumesIntent           bool `json:"finish_consumes_intent"`
 Enabled                        bool                       `json:"enabled"`
	DisengageWhenContactsExhausted bool                       `json:"disengage_when_contacts_exhausted"`
	SightRangeMM                   int                        `json:"sight_range_mm"`
	HearingRangeMM                 int                        `json:"hearing_range_mm"`
	ThreatMemorySeconds            int64                      `json:"threat_memory_seconds"`
	SafetySeconds                  int64                      `json:"safety_seconds"`
	MaxWitnesses                   int                        `json:"max_witnesses"`
	MaxSafetyCells                 int                        `json:"max_safety_cells"`
	HostileAtOrBelow               float64                    `json:"hostile_at_or_below"`
	MeleeLoudness                  float64                    `json:"melee_loudness"`
	ShotLoudness                   float64                    `json:"shot_loudness"`
	Aggressors                     map[string][]string        `json:"aggressors"`
	Takedowns                      map[string]combatTakedownIntent `json:"takedowns"`
	TakedownOfferMM                int                        `json:"takedown_offer_mm"`
	RiseSeconds                    int                        `json:"rise_seconds"`
	Responders                     map[string]combatResponder `json:"responders"`
}

func (c combatLifeCatalog) Validate(l behavior.LifeModel, combat combatCatalog) error {
	if !c.Enabled {
		return nil
	}
	if c.SightRangeMM < 1 || c.SightRangeMM > 100000 || c.HearingRangeMM < 1 || c.HearingRangeMM > 100000 || c.ThreatMemorySeconds < 1 || c.ThreatMemorySeconds > 86400 || c.SafetySeconds < 1 || c.SafetySeconds > 3600 || c.MaxWitnesses < 1 || c.MaxWitnesses > 512 || c.MaxSafetyCells < 1 || c.MaxSafetyCells > 4096 || !(c.HostileAtOrBelow >= -1 && c.HostileAtOrBelow < 0) || !(c.MeleeLoudness > 0 && c.MeleeLoudness <= c.ShotLoudness && c.ShotLoudness <= 1) {
		return fmt.Errorf("invalid combat life policy")
	}
	for id, targets := range c.Aggressors {
		if l.Person(id) == nil || len(targets) == 0 {
			return fmt.Errorf("invalid combat aggression intent")
		}
		binding := combat.Actors[id]
		if binding == "" {
			binding = combat.DefaultProfile
		}
		if combat.Profiles[binding].Noncombatant {
			return fmt.Errorf("noncombatant has aggression intent")
		}
		seen := map[string]bool{}
		for _, target := range targets {
			if target == id || seen[target] || l.Person(target) == nil {
				return fmt.Errorf("invalid combat aggression target")
			}
			seen[target] = true
		}
	}
	for id, role := range c.Responders {
		if l.Person(id) == nil || !role.ProtectNoncombatants && len(role.Protect) == 0 || len(role.Levels) == 0 {
			return fmt.Errorf("invalid combat responder")
		}
		binding := combat.Actors[id]
		if binding == "" {
			binding = combat.DefaultProfile
		}
		if combat.Profiles[binding].Noncombatant {
			return fmt.Errorf("noncombatant responder")
		}
		for _, target := range role.Protect {
			if target == id || l.Person(target) == nil {
				return fmt.Errorf("invalid responder protection")
			}
		}
		seen := map[string]bool{}
		for _, level := range role.Levels {
			if _, ok := l.Locations[level]; !ok || seen[level] {
				return fmt.Errorf("invalid responder jurisdiction")
			}
			seen[level] = true
		}
	}
	return nil
}

// Memory belongs to the observer. The original source/time of a report is not
// replaced by receiving or forwarding it. Safety routes live on the actors.
type combatWorldState struct {
	EncounterID       string
	InitiatorID       string
	VictimID          string
	LevelID           string
	ProcessedSequence uint64
	MemoryLevels      map[string]string
	Memories          map[string]behavior.Memory
	Cooldowns         map[string]int64
}

func (s combatWorldState) Clone() combatWorldState {
	out := s
	out.MemoryLevels = nil
	if s.MemoryLevels != nil {
		out.MemoryLevels = map[string]string{}
		for id, level := range s.MemoryLevels {
			out.MemoryLevels[id] = level
		}
	}
	out.Memories = nil
	if s.Memories != nil {
		out.Memories = map[string]behavior.Memory{}
		for id, m := range s.Memories {
			out.Memories[id] = m.Clone()
		}
	}
	out.Cooldowns = nil
	if s.Cooldowns != nil {
		out.Cooldowns = map[string]int64{}
		for id, n := range s.Cooldowns {
			out.Cooldowns[id] = n
		}
	}
	return out
}

type combatLifeObserver struct {
	ID, Level string
	At        behavior.Cell
}

func (r *Runtime) combatWorldActor(id string) (combatLifeObserver, bool) {
	if a := r.state.Life.Actor(id); a != nil {
		return combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}, a.OnFloor()
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.ID == id {
			return combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}, a.Materialized && a.Trip == nil
		}
	}
	return combatLifeObserver{}, false
}
func (r *Runtime) combatWorldDistance(level string, a, b behavior.Cell) int {
	if v := r.world.Decks[level]; v != nil {
		return v.CombatRangeMM(a, b)
	}
	unit := r.world.Life.Locations[level].CellMM
	if unit < 1 {
		unit = 1000
	}
	return int(math.Ceil(math.Hypot(float64(a.X-b.X), float64(a.Y-b.Y)) * float64(unit)))
}
func (r *Runtime) combatWorldVisible(observer combatLifeObserver, at behavior.Cell) bool {
	if r.combatWorldDistance(observer.Level, observer.At, at) > r.world.CombatLife.SightRangeMM {
		return false
	}
	return r.combatObserverSees(observer.Level, observer.ID, observer.At, at)
}
func (r *Runtime) combatWorldConscious(id string) bool {
	if actor := r.state.Combat.Actor(id); r.state.Combat.Active && actor != nil {
		return actor.HP > 0 && actor.StunTurns == 0
	}
	if actor, known := r.state.CombatRoster[id]; known {
		return actor.HP > 0 && actor.StunTurns == 0
	}
	return true
}
func (r *Runtime) combatWorldObservers(level string, at behavior.Cell) []combatLifeObserver {
	observers := []combatLifeObserver{}
	for _, a := range r.state.Life.Actors {
		if a.ID != playerActorID && a.Level == level && a.OnFloor() && r.combatWorldConscious(a.ID) {
			observers = append(observers, combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position})
		}
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.Materialized && a.Trip == nil && a.Level == level && r.combatWorldConscious(a.ID) {
			observers = append(observers, combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position})
		}
	}
	sort.Slice(observers, func(i, j int) bool {
		a, b := r.combatWorldDistance(level, observers[i].At, at), r.combatWorldDistance(level, observers[j].At, at)
		if a != b {
			return a < b
		}
		return observers[i].ID < observers[j].ID
	})
	if len(observers) > r.world.CombatLife.MaxWitnesses {
		observers = observers[:r.world.CombatLife.MaxWitnesses]
	}
	return observers
}
func (r *Runtime) combatWorldMemoryPolicy() behavior.MemoryPolicy {
	p := r.world.AI.Policy.Memory
	p.DefaultTTLTicks = r.world.CombatLife.ThreatMemorySeconds
	if p.Capacity < 1 {
		p.Capacity = 1
	}
	return p
}
func (r *Runtime) combatWorldRemember(observer string, f behavior.Fact) {
	s := &r.state.CombatWorld
	if s.Memories == nil {
		s.Memories = map[string]behavior.Memory{}
	}
	if _, ok := s.Memories[observer]; !ok && len(s.Memories) >= r.world.CombatLife.MaxWitnesses {
		victim := ""
		oldest := int64(1 << 62)
		for id, m := range s.Memories {
			last := int64(0)
			for _, v := range m.Facts {
				if v.ObservedTick > last {
					last = v.ObservedTick
				}
			}
			if last < oldest || last == oldest && (victim == "" || id < victim) {
				oldest, victim = last, id
			}
		}
		delete(s.Memories, victim)
		delete(s.MemoryLevels, victim)
	}
	pose, present := r.combatWorldActor(observer)
	if !present {
		return
	}
	if s.MemoryLevels == nil {
		s.MemoryLevels = map[string]string{}
	}
	m := s.Memories[observer]
	if s.MemoryLevels[observer] != pose.Level {
		m = behavior.Memory{}
	}
	s.MemoryLevels[observer] = pose.Level
	m.Record(f, r.combatWorldMemoryPolicy())
	s.Memories[observer] = m
}

// The uncertain plan estimate is assigned to the observer's likely floor. The
// true sound source's floor is deliberately not used to resolve that ambiguity.
func (r *Runtime) combatWorldSoundEstimate(level string, observer, plan behavior.Cell) behavior.Cell {
	v := r.world.Decks[level]
	if v == nil {
		l := r.world.Life.Locations[level]
		y := max(0, min(len(l.Terrain)-1, plan.Y))
		x := 0
		if len(l.Terrain) > 0 {
			x = max(0, min(len(l.Terrain[0])-1, plan.X))
		}
		return behavior.Cell{X: x, Y: y}
	}
	_, height, _, ok := v.Locate(observer)
	if !ok {
		return observer
	}
	best := observer
	distance := int(1 << 30)
	for _, surface := range v.Surfaces {
		if !surface.Walkable {
			continue
		}
		for dy := -2; dy <= 2; dy++ {
			for dx := -2; dx <= 2; dx++ {
				at := behavior.Cell{X: plan.X + dx, Y: surface.NavRow + plan.Y + dy}
				_, h, _, stand := v.Locate(at)
				if !stand {
					continue
				}
				score := (dx*dx+dy*dy)*500 + combatWorldAbs(h-height)
				if score < distance {
					best, distance = at, score
				}
			}
		}
	}
	return best
}
// combatWorldHearingPolicy, combatWorldSoundWalls and combatWorldPlaceNoise are what the hearing rule reads; the noise waves read the same three.
func (r *Runtime) combatWorldHearingPolicy(level string) behavior.HearingPolicy {
	unit := r.world.Life.Locations[level].CellMM
	if unit < 1 {
		unit = 1000
	}
	p := r.world.AI.Policy.Perception.Hearing
	p.RangeCells = max(1, r.world.CombatLife.HearingRangeMM/unit)
	return p
}
func (r *Runtime) combatWorldSoundWalls(level string, from, at behavior.Cell) int {
	if v := r.world.Decks[level]; v != nil {
		return v.CombatSoundBlockers(from, at)
	}
	return r.state.Life.GateModel(r.world.Life).Space(level, nil).Blockers(from, at)
}
func (r *Runtime) combatWorldPlaceNoise(level string, at behavior.Cell) int {
	ambient := r.world.Scene.AmbientNoise
	l := r.world.Life.Locations[level]
	if at.Y >= 0 && at.Y < len(l.Terrain) && at.X >= 0 && at.X < len(l.Terrain[at.Y]) {
		if n := r.world.Scene.TileNoise[string(l.Terrain[at.Y][at.X])]; n > ambient {
			ambient = n
		}
	}
	return ambient
}
func (r *Runtime) combatWorldHeard(observer combatLifeObserver, from behavior.Cell, loudness float64) (behavior.Heard, bool) {
	c := r.world.CombatLife
	if r.combatWorldDistance(observer.Level, observer.At, from) > c.HearingRangeMM {
		return behavior.Heard{}, false
	}
	p := r.combatWorldHearingPolicy(observer.Level)
	a, b := from, observer.At
	if v := r.world.Decks[observer.Level]; v != nil {
		a, _, _, _ = v.Locate(from)
		b, _, _, _ = v.Locate(observer.At)
	}
	walls := r.combatWorldSoundWalls(observer.Level, from, observer.At)
	ambient := r.combatWorldPlaceNoise(observer.Level, observer.At)
	heard, ok := p.Hear(behavior.Sound{Origin: a, Loudness: loudness}, b, 1, walls, ambient)
	if ok {
		heard.Estimate = r.combatWorldSoundEstimate(observer.Level, observer.At, heard.Estimate)
	}
	return heard, ok
}
func combatWorldAbs(n int) int {
	if n < 0 {
		return -n
	}
	return n
}
func (r *Runtime) combatLifeStarted(initiatorID, targetID string) {
	if !r.world.CombatLife.Enabled {
		return
	}
	s := &r.state.CombatWorld
	s.EncounterID = r.state.Combat.ID
	s.InitiatorID = initiatorID
	s.VictimID = targetID
	s.LevelID = r.state.Combat.LevelID
	s.ProcessedSequence = 0
	if s.Cooldowns == nil {
		s.Cooldowns = map[string]int64{}
	}
	s.Cooldowns[initiatorID+"\x00"+targetID] = r.state.Life.Seconds + r.world.CombatLife.ThreatMemorySeconds
	for _, actor := range r.state.Combat.Actors {
		if a := r.state.Life.Actor(actor.ID); a != nil {
			a.Safety = nil
		}
	}
}
func (r *Runtime) combatLifeBeforeFrame() {
	if !r.world.CombatLife.Enabled {
		return
	}
	now := r.state.Life.Seconds
	for id, m := range r.state.CombatWorld.Memories {
		m.Expire(now)
		if len(m.Facts) == 0 {
			delete(r.state.CombatWorld.Memories, id)
			delete(r.state.CombatWorld.MemoryLevels, id)
		} else {
			r.state.CombatWorld.Memories[id] = m
		}
	}
	for id, until := range r.state.CombatWorld.Cooldowns {
		if until <= now {
			delete(r.state.CombatWorld.Cooldowns, id)
		}
	}
}
func (r *Runtime) combatLifeAfterFrame() error {
	if !r.world.CombatLife.Enabled || !r.state.Life.Enabled || r.state.Paused {
		return nil
	}
	// Reevaluate already-known assaults from the observer's current senses. The
	// report never follows the unseen assailant; an approach uses its old cell.
	ids := make([]string, 0, len(r.state.CombatWorld.Memories))
	for id := range r.state.CombatWorld.Memories {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		observer, ok := r.combatWorldActor(id)
		if !ok || !r.combatWorldConscious(id) || r.state.CombatWorld.MemoryLevels[id] != observer.Level {
			continue
		}
		m := r.state.CombatWorld.Memories[id]
		f, known := m.Best("combat.assault")
		if !known || f.ExpiresTick <= r.state.Life.Seconds {
			continue
		}
		if role, responds := r.world.CombatLife.Responders[id]; responds && r.combatResponderProtects(role, f.Cause, observer.Level) {
			if err := r.combatWorldRespond(observer, f); err != nil {
				return err
			}
		} else if r.state.Combat.Active && r.state.Combat.Actor(f.Subject) != nil {
			source, exists := r.combatWorldActor(f.Subject)
			if exists && r.combatWorldVisible(observer, source.At) {
				r.combatWorldSafety(observer, source.At, "shelter")
			}
		}
	}
	if r.state.Combat.Active {
		return nil
	}
	// Explicit intention + current hostility + personal sight are all required.
	aggressors := make([]string, 0, len(r.world.CombatLife.Aggressors))
	for id := range r.world.CombatLife.Aggressors {
		aggressors = append(aggressors, id)
	}
	sort.Strings(aggressors)
	for _, id := range aggressors {
		actor := r.state.Life.Actor(id)
		if actor == nil || id == playerActorID || !actor.OnFloor() || actor.CombatHold || actor.Safety != nil {
			continue
		}
		observer := combatLifeObserver{ID: id, Level: actor.Level, At: actor.Position}
		for _, targetID := range r.world.CombatLife.Aggressors[id] {
   // A concluded fight consumed this persistent authored intention. Expiring
   // sight/cooldown is no new assault; explicit new attacks still use beginCombat.
   last:=r.state.CombatWorld
   if r.world.CombatLife.FinishConsumesIntent&&!r.state.Combat.Active&&last.EncounterID==r.state.Combat.ID&&last.EncounterID!=""&&((last.InitiatorID==id&&last.VictimID==targetID)||(last.InitiatorID==targetID&&last.VictimID==id)){continue}

			target := r.state.Life.Actor(targetID)
			if target == nil || !target.OnFloor() || target.CombatHold || target.Level != actor.Level || r.state.CombatWorld.Cooldowns[id+"\x00"+targetID] > r.state.Life.Seconds || r.state.Life.RelationTo(r.world.Life, id, targetID) > r.world.CombatLife.HostileAtOrBelow || !r.combatWorldIdentifies(observer,targetID) {
				continue
			}
			if err := r.beginCombat(id, targetID, "aggressor", "defender"); err != nil {
				return err
			}
			return nil
		}
	}
	return r.combatLifeTakedowns()
}
// combatEventNoise: the sound of one combat event as the world hears it; kind names it for the picture, "" for an event that makes none.
func (r *Runtime) combatEventNoise(event behavior.CombatEvent) (string, behavior.Cell, float64) {
	if event.Type != "attack" && event.Type != "throw" && event.Type != "explosion" {
		return "", event.From, 0
	}
	kind := "strike"
	noiseOrigin := event.From
	loudness := r.world.CombatLife.MeleeLoudness
	if event.Type == "throw" {
		kind = ""
		loudness = 0
	}
	if event.Type == "explosion" {
		kind = "explosion"
		noiseOrigin = event.To
		loudness = r.world.CombatLife.ShotLoudness
	}
	attacker := r.state.Combat.Actor(event.ActorID)
	if event.Type == "attack" && attacker != nil && attacker.Weapon.Magazine > 0 {
		kind = "shot"
		loudness = r.world.CombatLife.ShotLoudness
	}
	if t, held := r.world.CombatRuntime.Rules.Techniques[event.Mode]; held && event.Type == "attack" {
		kind = "takedown"
		if !t.Strike {
			loudness = t.Loudness
		}
	}
	return kind, noiseOrigin, loudness
}
func (r *Runtime) combatLifeAfterAction(previous behavior.CombatState) error {
	if !r.world.CombatLife.Enabled || r.state.Combat.ID == "" {
		return nil
	}
	s := &r.state.CombatWorld
	if s.EncounterID != r.state.Combat.ID {
		return fmt.Errorf("combat world origin not initialized")
	}
	processed := s.ProcessedSequence
	for _, event := range r.state.Combat.Events {
		if event.Sequence <= processed {
			continue
		}
		if event.Sequence > s.ProcessedSequence {
			s.ProcessedSequence = event.Sequence
		}
		if event.Type != "attack" && event.Type != "throw" && event.Type != "explosion" {
			continue
		}
		attacker := r.state.Combat.Actor(event.ActorID)
		_, noiseOrigin, loudness := r.combatEventNoise(event)
		// An original defender's proportionate response is still frightening, but
		// is not fabricated into a new aggression report against the victim.
		origin := r.state.Combat.Actor(s.InitiatorID)
		assault := (event.Type == "attack" || event.Type == "throw") && (event.ActorID == s.InitiatorID || origin != nil && attacker != nil && origin.Team == attacker.Team)
		observers := r.combatWorldObservers(r.state.Combat.LevelID, noiseOrigin)
		witnesses := []combatLifeObserver{}
		for _, observer := range observers {
			if observer.ID == event.ActorID {
				continue
			}
			seenFrom, seenTo := r.combatWorldVisible(observer, event.From), r.combatWorldVisible(observer, event.To)
			if event.Type == "explosion" {
				seenFrom = seenTo
			}
			heard, audible := r.combatWorldHeard(observer, noiseOrigin, loudness)
			if !seenFrom && !seenTo && !audible {
				continue
			}
			dangerAt := noiseOrigin
			if !seenFrom && !seenTo && audible {
				dangerAt = heard.Estimate
			} else if !seenFrom {
				dangerAt = event.To
			}
			if assault && seenFrom && seenTo && event.TargetID != "" {
				fact := behavior.Fact{Subject: event.ActorID, Kind: "combat.assault", Cause: event.TargetID, Source: observer.ID, Value: true, Position: event.From, ObservedTick: r.state.Life.Seconds, ExpiresTick: r.state.Life.Seconds + r.world.CombatLife.ThreatMemorySeconds, Strength: 1, Priority: 100}
				r.combatWorldRemember(observer.ID, fact)
				_ = r.state.Life.SetRelation(observer.ID, event.ActorID, -1)
				witnesses = append(witnesses, observer)
			} else if event.Type == "throw" && seenFrom {
				r.combatWorldRemember(observer.ID, behavior.Fact{Subject: event.ActorID, Kind: "combat.throw", Source: observer.ID, Value: true, Position: event.From, ObservedTick: r.state.Life.Seconds, ExpiresTick: r.state.Life.Seconds + r.world.CombatLife.ThreatMemorySeconds, Strength: 1, Priority: 100})
			} else if audible && (event.Type == "explosion" || !seenFrom) {
				r.combatWorldRemember(observer.ID, behavior.Fact{Subject: fmt.Sprintf("noise.%s.%d.%s", r.state.Combat.ID, event.Sequence, event.Type), Kind: "combat.noise", Source: "sound", Value: true, Position: heard.Estimate, Radius: heard.Radius, Strength: heard.Intensity, ObservedTick: r.state.Life.Seconds, ExpiresTick: r.state.Life.Seconds + r.world.CombatLife.ThreatMemorySeconds, Priority: 50})
			}
			if role, ok := r.world.CombatLife.Responders[observer.ID]; ok && r.combatResponderInLevel(role, observer.Level) {
				if assault && seenFrom && seenTo && event.TargetID != "" && r.combatResponderProtects(role, event.TargetID, observer.Level) {
					m := s.Memories[observer.ID]
					fact, _ := m.Lookup(event.ActorID, "combat.assault")
					if err := r.combatWorldRespond(observer, fact); err != nil {
						return err
					}
				} else {
					r.combatWorldSafety(observer, dangerAt, "investigate")
				}
			} else {
				r.combatWorldSafety(observer, dangerAt, "shelter")
			}
		}
		// A witness can call an existing local responder through actual hearing.
		// No shared faction map, remote ID revelation or renewed report timestamp.
		for _, witness := range witnesses {
			m := s.Memories[witness.ID]
			fact, ok := m.Lookup(event.ActorID, "combat.assault")
			if ok != behavior.KnowledgeTrue {
				continue
			}
			guardIDs := make([]string, 0, len(r.world.CombatLife.Responders))
			for id := range r.world.CombatLife.Responders {
				guardIDs = append(guardIDs, id)
			}
			sort.Strings(guardIDs)
			for _, id := range guardIDs {
				role := r.world.CombatLife.Responders[id]
				guard, present := r.combatWorldActor(id)
				if !present || !r.combatWorldConscious(id) || guard.Level != witness.Level || !role.Report || !r.combatResponderProtects(role, fact.Cause, guard.Level) {
					continue
				}
				if id != witness.ID {
					r.noiseShout(witness.Level, witness.ID, witness.At, r.world.AI.Policy.Perception.Hearing.Loudness("shout", false, 1))
					if _, heard := r.combatWorldHeard(guard, witness.At, r.world.AI.Policy.Perception.Hearing.Loudness("shout", false, 1)); !heard {
						continue
					}
					r.combatWorldRemember(id, fact)
				}
				if err := r.combatWorldRespond(guard, fact); err != nil {
					return err
				}
			}
		}
	}
	return nil
}
func (r *Runtime) combatResponderInLevel(role combatResponder, level string) bool {
	jurisdiction := false
	for _, id := range role.Levels {
		if id == level {
			jurisdiction = true
			break
		}
	}
	return jurisdiction
}
func (r *Runtime) combatResponderProtects(role combatResponder, victim, level string) bool {
	if !r.combatResponderInLevel(role, level) {
		return false
	}
	for _, id := range role.Protect {
		if id == victim {
			return true
		}
	}
	if role.ProtectNoncombatants {
		profile := r.world.CombatRuntime.Actors[victim]
		if profile == "" {
			profile = r.world.CombatRuntime.DefaultProfile
		}
		return r.world.CombatRuntime.Profiles[profile].Noncombatant
	}
	return false
}
func (r *Runtime) combatWorldRespond(observer combatLifeObserver, f behavior.Fact) error {
	if r.state.Combat.Actor(observer.ID) != nil {
		return nil
	}
	source, present := r.combatWorldActor(f.Subject)
	if r.state.Combat.Active && r.state.Combat.Actor(f.Subject) != nil && present && source.Level == observer.Level && r.combatWorldVisible(observer, source.At) {
		victim := r.state.Combat.Actor(f.Cause)
		if victim == nil {
			return nil
		}
		return r.joinCombat(observer.ID, victim.Team)
	}
	r.combatWorldSafety(observer, f.Position, "investigate")
	return nil
}
func (r *Runtime) combatWorldSafety(observer combatLifeObserver, threat behavior.Cell, kind string) {
	if observer.ID == playerActorID || r.state.Combat.Active && r.state.Combat.Actor(observer.ID) != nil {
		return
	}
	if a := r.state.Life.Actor(observer.ID); a != nil {
		if a.CombatHold || a.Manual {
			return
		}
		if a.Safety != nil && a.Safety.Until > r.state.Life.Seconds && a.Safety.Activity == kind && a.Safety.ThreatAt == threat {
			a.Safety.Until = r.state.Life.Seconds + r.world.CombatLife.SafetySeconds
			return
		}
	}
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if a.ID == observer.ID {
			if a.CombatHold {
				return
			}
			if a.Safety != nil && a.Safety.Until > r.state.Life.Seconds && a.Safety.Activity == kind && a.Safety.ThreatAt == threat {
				a.Safety.Until = r.state.Life.Seconds + r.world.CombatLife.SafetySeconds
				return
			}
			break
		}
	}
	model := r.state.Life.GateModel(r.world.Life)
	space := model.Space(observer.Level, nil)
	blockers := map[behavior.Cell]bool{}
	for _, other := range r.combatWorldObservers(observer.Level, observer.At) {
		if other.ID != observer.ID && r.combatWorldVisible(observer, other.At) {
			blockers[other.At] = true
		}
	}
	if hero := r.state.Life.Actor(playerActorID); hero != nil && hero.Level == observer.Level && hero.OnFloor() && r.combatWorldVisible(observer, hero.Position) {
		blockers[hero.Position] = true
	}
	queue := []behavior.Cell{observer.At}
	seen := map[behavior.Cell]bool{observer.At: true}
	cost := map[behavior.Cell]int{observer.At: 0}
	best := observer.At
	bestScore := math.Inf(-1)
	for head := 0; head < len(queue) && head < r.world.CombatLife.MaxSafetyCells; head++ {
		at := queue[head]
		distance := r.combatWorldDistance(observer.Level, at, threat)
		score := float64(distance) - float64(cost[at])*100
		if kind == "investigate" {
			score = -float64(distance) - float64(cost[at])*100
		} else if !r.combatSight(observer.Level, threat, at) {
			score += float64(r.world.CombatLife.SightRangeMM) * 2
		}
		if score > bestScore {
			best, bestScore = at, score
		}
		for _, next := range model.StepNeighbours(observer.Level, at) {
			if seen[next] || !space.Walkable(next) || blockers[next] {
				continue
			}
			seen[next] = true
			cost[next] = cost[at] + 1
			queue = append(queue, next)
			if len(queue) >= r.world.CombatLife.MaxSafetyCells {
				break
			}
		}
	}
	label := "life.combat.seek_safety"
	if kind == "investigate" {
		label = "life.combat.investigate"
	}
	_ = r.state.Life.ApplySafety(model, observer.ID, behavior.LifeSafetyOverride{Level: observer.Level, Goal: best, ThreatAt: threat, Until: r.state.Life.Seconds + r.world.CombatLife.SafetySeconds, LabelKey: label, Activity: kind, Reason: "locally perceived violence", EncounterID: r.state.Combat.ID})
}
func (r *Runtime) combatMerchantSafe(id string) bool {
	if a := r.state.Life.Actor(id); a != nil {
		return !a.CombatHold && (a.Safety == nil || a.Safety.Until <= r.state.Life.Seconds)
	}
	return true
}
func (r *Runtime) validateCombatWorld(s state) error {
	w := s.CombatWorld
	c := r.world.CombatLife
	if len(w.Memories) > c.MaxWitnesses && c.Enabled || len(w.Cooldowns) > len(r.world.Life.Actors)*len(r.world.Life.Actors) {
		return fmt.Errorf("oversized combat world memory")
	}
	known := func(id string) bool {
		if s.Life.Actor(id) != nil {
			return true
		}
		for _, a := range s.Life.Population.Actors {
			if a.ID == id {
				return true
			}
		}
		return false
	}
	if w.EncounterID == "" && (w.InitiatorID != "" || w.VictimID != "" || w.LevelID != "" || w.ProcessedSequence != 0) {
		return fmt.Errorf("orphaned combat world origin")
	}
	if w.EncounterID != "" {
		if w.EncounterID != s.Combat.ID || !known(w.InitiatorID) || !known(w.VictimID) || w.InitiatorID == w.VictimID || w.LevelID != s.Combat.LevelID || w.ProcessedSequence > s.Combat.EventSeq {
			return fmt.Errorf("invalid combat world origin")
		}
	}
	for id, m := range w.Memories {
		if _, ok := r.world.Life.Locations[w.MemoryLevels[id]]; !ok {
			return fmt.Errorf("invalid combat memory level")
		}
		if id == playerActorID || !known(id) {
			return fmt.Errorf("unknown combat world observer")
		}
		if err := m.Validate(r.combatWorldMemoryPolicy(), s.Life.Seconds); err != nil {
			return err
		}

		level := r.world.Life.Locations[w.MemoryLevels[id]]
		for _, f := range m.Facts {
			if !f.Value || !(f.Strength >= 0 && f.Strength <= 1) || f.Radius < 0 || f.Radius > 65536 || f.Position.Y < 0 || f.Position.Y >= len(level.Terrain) || f.Position.X < 0 || f.Position.X >= len(level.Terrain[f.Position.Y]) || f.Kind == "combat.noise" && !strings.HasPrefix(f.Subject, "noise.") || f.Kind != "combat.assault" && f.Kind != "combat.noise" && f.Kind != "combat.throw" || f.ObservedTick > s.Life.Seconds || f.ExpiresTick > f.ObservedTick+c.ThreatMemorySeconds || f.Kind == "combat.assault" && (!known(f.Subject) || !known(f.Cause) || !known(f.Source)) || f.Kind == "combat.noise" && (f.Cause != "" || f.Source != "sound") || f.Kind == "combat.throw" && (f.Cause != "" || !known(f.Subject) || !known(f.Source)) {
				return fmt.Errorf("invalid combat world observation")
			}
		}
	}
	if len(w.MemoryLevels) != len(w.Memories) {
		return fmt.Errorf("orphaned combat memory level")
	}
	for key, until := range w.Cooldowns {
		ids := strings.Split(key, "\x00")
		if len(ids) != 2 || ids[0] == ids[1] || !known(ids[0]) || !known(ids[1]) || until < 1 || until > s.Life.Seconds+c.ThreatMemorySeconds {
			return fmt.Errorf("invalid combat world cooldown")
		}
	}
	return nil
}

// End the tactical clock only after every able observer has exhausted its own
// current search information. Hidden physical positions never enter this test.
func (r *Runtime) combatLifeTryDisengage() bool {
	if !r.world.CombatLife.Enabled || !r.world.CombatLife.DisengageWhenContactsExhausted || !r.state.Combat.Active {
		return false
	}
	observed := r.state.Combat.Clone()
	rules := r.world.CombatRuntime.Rules
	observed.Observe(r.combatSpace(observed), rules)
	for _, actor := range observed.Actors {
		if !actor.Able() {
			continue
		}
		for _, contact := range actor.Contacts {
			if contact.Team == actor.Team || contact.Checked {
				continue
			}
			if contact.Visible && contact.Source == "sight" && contact.SourceID == actor.ID && contact.ObservedTurn == observed.Turn && contact.ObservedAction == observed.ActionSeq {
				return false
			}
			if observed.Turn-contact.ObservedTurn <= rules.MemoryTurns {
				return false
			}
		}
	}
	r.state.Combat = observed
	s := &r.state.Combat
	participated := s.Actor(playerActorID) != nil
	actorID := ""
	at := behavior.Cell{}
	if actor := s.Current(); actor != nil {
		at = actor.Position
	}
	if hero := s.Actor(playerActorID); hero != nil {
		actorID = hero.ID
		at = hero.Position
	}
	s.Active = false
	s.Winner = ""
	for i := range s.Actors {
		s.Actors[i].Overwatch = false
		s.Actors[i].Guarding = false
		s.Actors[i].ReservedAP = 0
	}
	s.EventSeq++
	s.Events = append(s.Events, behavior.CombatEvent{Type: "disengage", ActorID: actorID, From: at, To: at, Turn: s.Turn, Sequence: s.EventSeq, Reason: "all personal search information exhausted"})
	if len(s.Events) > 512 {
		s.Events = append([]behavior.CombatEvent(nil), s.Events[len(s.Events)-512:]...)
	}
	r.state.CombatWorld.ProcessedSequence = s.EventSeq
	if participated {
		r.state.Epoch = newEpoch()
	}
	r.syncCombatLife()
	return true
}
