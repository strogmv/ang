}
func (r *Runtime) sanitaryRelease(id string) {
	p, ok := r.state.Sanitary.Users[id]
	if !ok {
		return
	}
	a := r.state.Life.Actor(id)
	if a == nil {
		return
	}
	a.ServiceAttachment = ""
	a.CombatHold = false
	a.Manual = p.PriorManual
	a.OverrideLevel = ""
	a.OverrideEdge = ""
	a.Path = nil
	a.PendingPath = nil
	a.Body = nil
	a.Goal = a.Position
	a.Arrived = id == playerActorID
	a.Activity = "rest"
	a.Label = "sanitary.phase.idle"
	a.Brain.InterruptService()
	sanitaryRestoreDutyBreak(a, p, true)
	a.Brain.NextDecision = 0
	delete(r.state.Sanitary.Users, id)
	if c, ok := r.state.CombatRoster[id]; ok {
		r.combatCareHold(c)
	}
}
func (r *Runtime) sanitaryExitReady(p *sanitaryUser, u sanitaryUnit) bool {
	a := r.state.Life.Actor(p.ActorID)
	if a == nil {
		return false
	}
	c := r.combatant(a.ID, "player")
	p.ExitBlocked = r.state.Life.BlockedCells(u.LevelID, a.ID)[u.EntryCell] || !combatWounds.Status(combatBody(c)).CanWalk
