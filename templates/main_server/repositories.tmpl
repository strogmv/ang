{{ define "main_server_repositories" }}
	{{- $needsPG := or .HasSQL (gt (len (AllUsedRepoEntitiesIR .ServicesIR .EntitiesIR)) 0) }}
	{{- $needsS3 := or .HasS3 (AnyServiceHasStorageIR .ServicesIR) }}
	runtimeContainer, err := bootstrap.NewRuntimeContainer(
		ctx,
		cfg,
		{{- if $needsPG }}
		pgPool,
		{{- end }}
		{{- if .HasMongo }}
		mongoClient,
		{{- end }}
		{{- if or .HasCache (or (eq .AuthRefreshStore "redis") (eq .AuthRefreshStore "hybrid")) }}
		redisClient,
		{{- end }}
		publisher,
		{{- if $needsS3 }}
		s3Client,
		{{- end }}
		{{- if or .HasNotificationsService .HasNotificationDispatch }}
		notificationDispatcher,
		{{- end }}
	)
	if err != nil {
		log.Error("Failed to build runtime container", "error", err)
		os.Exit(1)
	}

	{{- if and .AuthService (HasEntityByNameIR .EntitiesIR "User") }}
	transport.SetVerifiedUserChecker(func(ctx context.Context, userID string) (bool, error) {
		if strings.TrimSpace(userID) == "" {
			return false, nil
		}
		u, err := runtimeContainer.RepoUser.FindByID(ctx, userID)
		if err != nil {
			return false, err
		}
		if u == nil {
			return false, nil
		}
		switch strings.ToLower(strings.TrimSpace(u.Status)) {
		case "active":
			return true, nil
		case "", "unverified":
			return false, nil
		case "suspended", "blocked":
			return false, transport.ErrAccountSuspended
		default:
			return false, transport.ErrAccountClosed
		}
	})
	{{- end }}

	{{- /* A project can gate whole parts of itself per company: when a service
	       exposes CheckCompanyModuleAccess, the HTTP layer asks it before every
	       authenticated handler runs. */}}
	{{- $moduleGateSvc := "" }}
	{{- range .ServicesIR }}
		{{- $svc := . }}
		{{- range .Methods }}
			{{- if eq .Name "CheckCompanyModuleAccess" }}{{ $moduleGateSvc = $svc.Name }}{{ end }}
		{{- end }}
	{{- end }}
	{{- if ne $moduleGateSvc "" }}
	transport.SetModuleAccessChecker(func(ctx context.Context, companyID, path string) (bool, string, error) {
		out, err := runtimeContainer.Svc{{ $moduleGateSvc }}.CheckCompanyModuleAccess(ctx, port.CheckCompanyModuleAccessRequest{CompanyID: companyID, Path: path})
		if err != nil {
			return false, "", err
		}
		return out.Allowed, out.Module, nil
	})
	{{- end }}

	{{- /* A project can stop requests before any route runs (a maintenance
	       window) and watch chosen routes: when a service exposes
	       CheckRequestGate (and RecordRequestOutcome), every request asks it. */}}
	{{- $requestGateSvc := "" }}
	{{- $requestOutcomeSvc := "" }}
	{{- range .ServicesIR }}
		{{- $svc := . }}
		{{- range .Methods }}
			{{- if eq .Name "CheckRequestGate" }}{{ $requestGateSvc = $svc.Name }}{{ end }}
			{{- if eq .Name "RecordRequestOutcome" }}{{ $requestOutcomeSvc = $svc.Name }}{{ end }}
		{{- end }}
	{{- end }}
	{{- if ne $requestGateSvc "" }}
	transport.SetRequestGate(func(ctx context.Context, method, path string) (transport.RequestGateRule, error) {
		out, err := runtimeContainer.Svc{{ $requestGateSvc }}.CheckRequestGate(ctx, port.CheckRequestGateRequest{Method: method, Path: path})
		if err != nil {
			return transport.RequestGateRule{}, err
		}
		return transport.RequestGateRule{Blocked: out.Blocked, Status: out.Status, Code: out.Code, Message: out.Message, RetryAfter: out.RetryAfter, BypassRoles: out.BypassRoles, Observe: out.Observe}, nil
	})
	{{- end }}
	{{- if ne $requestOutcomeSvc "" }}
	transport.SetRequestOutcomeRecorder(func(ctx context.Context, o transport.RequestOutcome) {
		_, _ = runtimeContainer.Svc{{ $requestOutcomeSvc }}.RecordRequestOutcome(ctx, port.RecordRequestOutcomeRequest{Method: o.Method, Path: o.Path, Status: o.Status, Fault: o.Fault, Authenticated: o.Authenticated, UserID: o.UserID, CompanyID: o.CompanyID, IP: o.IP})
	})
	{{- end }}

	{{- /* Same idea one level along: a privileged role can carry a condition
	       beyond holding it. When a service exposes CheckRoleAccess, the HTTP
	       layer asks it before letting a role-gated handler run. */}}
	{{- $roleGateSvc := "" }}
	{{- range .ServicesIR }}
		{{- $svc := . }}
		{{- range .Methods }}
			{{- if eq .Name "CheckRoleAccess" }}{{ $roleGateSvc = $svc.Name }}{{ end }}
		{{- end }}
	{{- end }}
	{{- if ne $roleGateSvc "" }}
	transport.SetRoleAccessChecker(func(ctx context.Context, userID, role string) (bool, string, error) {
		out, err := runtimeContainer.Svc{{ $roleGateSvc }}.CheckRoleAccess(ctx, port.CheckRoleAccessRequest{UserID: userID, Role: role})
		if err != nil {
			return false, "", err
		}
		return out.Allowed, out.Reason, nil
	})
	{{- end }}

	{{- if and .NotificationMuting (or .HasNotificationsService .HasNotificationDispatch) (HasEntityByNameIR .EntitiesIR "User") }}
	notificationDispatcher.UserMuteChecker = func(ctx context.Context, userID string, msg port.NotificationMessage) (bool, error) {
		user, err := runtimeContainer.RepoUser.FindByID(ctx, userID)
		if err != nil {
			return false, err
		}
		if user == nil {
			return false, nil
		}
		muteType := strings.TrimSpace(msg.MuteKey)
		if muteType == "" {
			muteType = strings.TrimSpace(msg.Type)
		}
		return adapter.IsNotificationMuted(user, muteType), nil
	}
	{{- end }}
{{ end }}
