// craftingRebind: the lawful rebinding at the terminal — only at the system trust of the threshold (owner 02.11); a
// refusal is recorded in the system journal (a trace, no punishment); a forged binding is read by the scanner.
func (r *Runtime) craftingRebind(hero *behavior.LifeActor, itemID string) error {
	m := r.world.Crafting
	law := &r.state.Crafting.Law
	i, ok := r.craftingHeroCarried(itemID)
	if !ok {
		return crafting.Refusal{Key: "crafting.error.no_target"}
	}
	t, ok := r.craftingTerminal(hero)
	if !ok {
		return textError{Key: "crafting.error.no_terminal"}
	}
	if i.Grade.Bound == "" || i.Grade.Bound == crafting.Chip(m.Hero.Actor) && law.Hacked[itemID].By == "" {
		return textError{Key: "crafting.error.not_bound"}
	}
	now := r.state.Life.Seconds
	if _, hacked := law.Hacked[itemID]; hacked {
		r.craftingDetect("scan", itemID)
	}
	if law.Frozen {
		return textError{Key: "crafting.error.frozen"}
	}
	if law.Trust < m.Law.Trust.RebindMinPermille {
		law.Journal = append(law.Journal, crafting.Record{Second: now, Kind: "rebind_refused", Item: itemID, Unit: t.Unit})
		return textError{Key: "crafting.error.trust"}
	}
	price := m.Law.Rebind.PriceMinor
	if r.state.Inventory.Accounts[m.Hero.Account].Balance < price {
		return textError{Key: "crafting.error.no_money"}
	}
	g := i.Grade
	g.Bound = crafting.Chip(m.Hero.Actor)
	if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Payments: []inv.Payment{r.craftingPayment(m.Hero.Account, m.Law.Rebind.Account, price)}, Regrade: []inv.Regrade{{Item: itemID, Grade: g}}}); err != nil {
		return textError{Key: "crafting.error.inventory"}
	}
	delete(law.Hacked, itemID)
	law.Journal = append(law.Journal, crafting.Record{Second: now, Kind: "rebind", Item: itemID, Unit: t.Unit})
	r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice.rebound", Second: now}
	return nil
}

// craftingHacked: a finished bypass writes the hero's chip into the thing; the witnesses of the moment may report.
func (r *Runtime) craftingHacked(item string) {
	m := r.world.Crafting
	i, ok := r.state.Inventory.Items[item]
	if !ok {
		return
	}
	g := i.Grade
	g.Bound = crafting.Chip(m.Hero.Actor)
	if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Regrade: []inv.Regrade{{Item: item, Grade: g}}}); err != nil {
		return
	}
	law := &r.state.Crafting.Law
	if law.Hacked == nil {
		law.Hacked = map[string]crafting.Hack{}
	}
	law.Hacked[item] = crafting.Hack{By: m.Hero.Actor, Second: r.state.Life.Seconds, Condition: i.Condition}
	r.craftingOffence("hack", item, r.craftingWitnesses(r.craftingHero()), false)
}

// craftingShotHook: the combat layer calls it when the hero fires a hacked weapon within sight of a guard (the shot is
// heard and seen). Rejected triggers do not call this hook.
func (r *Runtime) craftingShotHook(item string, guards []string) {
	if _, hacked := r.state.Crafting.Law.Hacked[item]; hacked && len(guards) > 0 {
		r.craftingOffence("shot", item, guards, false)
	}
}

// craftingUsable: chip-bound gear works only for the chip it is bound to (a hook for the combat layer).
func (r *Runtime) craftingUsable(item, actor string) bool {
	i, ok := r.state.Inventory.Items[item]
	return ok && (i.Grade.Bound == "" || i.Grade.Bound == crafting.Chip(actor)) && !r.state.Crafting.Law.Hacked[item].Jammed
}

