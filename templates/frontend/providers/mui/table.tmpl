  if (typeof window === 'undefined') return {{ .Name }}_DEFAULT_COLUMN_VISIBILITY;
  try {
    const raw = window.localStorage.getItem({{ .Name }}_COLUMNS_STORAGE_KEY);
    const parsed: unknown = raw ? JSON.parse(raw) : null;
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
      return parsed as GridColumnVisibilityModel;
    }
  } catch {
    // Storage unavailable (private mode, quota, disabled): fall back to defaults.
  }
  return {{ .Name }}_DEFAULT_COLUMN_VISIBILITY;
}

