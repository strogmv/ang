// biomonitorFixture: the real world with its first biomonitor wearer standing on a floor (where the turrets' fixture
// stands people when his schedule has him elsewhere) and a blow of the turret posts' fire profile from a test source
// beside him — the general rule «a hit from a world source» (applyWorldHit), not the turrets: they never fire at a guard.
// The Life clock runs in 5 s steps, so no tier is stepped over.
func biomonitorFixture(t *testing.T) (*Runtime, string, worldHit) {
	t.Helper()
	r, h := worldHitFixture(t)
	m := r.world.Biomonitor
	if m == nil || len(m.Wearers) == 0 {
		t.Skip("content has no biomonitor wearer")
	}
	id := m.Wearers[0]
	a := r.state.Life.Actor(id)
	if a == nil {
		t.Fatalf("biomonitor wearer %s is no Life person", id)
	}
	if !a.OnFloor() {
		turretWatchPlace(t, r, id, turretWatchOpen(t, r, r.world.TurretWatch.Posts)[0])
	}
	r.state.Life.SecondsPerTick = 5
	h.Source = "world.test_biomonitor"
	h.From = behavior.Cell{X: a.Position.X + 4, Y: a.Position.Y}
	return r, id, h
}

type biomonitorStep struct {
	Second   int64
	Tier     string
	Segments int32
	State    string
}

func biomonitorRead(r *Runtime, id string) biomonitorStep {
	tier, n := r.biomonitorOf(id)
	state := "ok"
	if body, known := r.biomonitorBody(id); known {
		state = combatWounds.Status(body).State
	}
	return biomonitorStep{Second: r.state.Life.Seconds, Tier: tier, Segments: n, State: state}
}

// biomonitorCourse: the wearer is hit until a wound opens, then only the ordinary after-care runs (advanceWoundCare
// bleeds the body on the Life clock); whenever the body is settled again (no bleeding) and alive, one more blow. The
// reading after every blow and every clock step, until the body is dead.
func biomonitorCourse(t *testing.T, r *Runtime, id string, h worldHit) []biomonitorStep {
	t.Helper()
	steps := []biomonitorStep{biomonitorRead(r, id)}
	for round := 0; round < 400 && !r.woundBodyDead(id); round++ {
		if biomonitorSettled(r, id) {
			h.Seed++
			if _, err := r.applyWorldHit(id, h); err != nil {
				t.Fatal(err)
			}
			steps = append(steps, biomonitorRead(r, id))
		}
		for s := int64(0); s < 60 && !r.woundBodyDead(id); s += r.state.Life.SecondsPerTick {
			worldHitBleed(t, r, id, r.state.Life.SecondsPerTick)
			steps = append(steps, biomonitorRead(r, id))
		}
	}
	if !r.woundBodyDead(id) {
		t.Fatal("400 rounds of blows and bleeding did not kill the wearer")
	}
	return steps
}

// biomonitorSettled: the body bleeds no more (or the wounds never touched it): time for another blow.
func biomonitorSettled(r *Runtime, id string) bool {
	body, known := r.biomonitorBody(id)
	if !known {
		return true
	}
	st := combatWounds.Status(body)
	return st.ExternalULS == 0 && st.InternalULS == 0
}

func biomonitorTierOf(t *testing.T, m *biomonitorCatalog, id string) biomonitorTier {
	t.Helper()
	for _, tier := range m.Tiers {
		if tier.ID == id {
			return tier
		}
	}
	t.Fatalf("the table has no tier %q", id)
	return biomonitorTier{}
}

// The owner's rule (13.11) on the real wound model: whole — every segment, cold; wounded — fewer, amber; critical — one,
// red, blinking; dead — dark. One course of real blows and bleeding goes through the tiers in this order and never back
// (a death is final); every reading is the table's for the body's wound state.
func TestBiomonitorReadsTheWoundModelWholeWoundedCriticalDead(t *testing.T) {
	r, id, h := biomonitorFixture(t)
	m := r.world.Biomonitor
	whole, wounded, critical, dead := biomonitorTierOf(t, m, "whole"), biomonitorTierOf(t, m, "wounded"), biomonitorTierOf(t, m, "critical"), biomonitorTierOf(t, m, "dead")
	if whole.Segments == nil || *whole.Segments != m.Segments || critical.Segments == nil || *critical.Segments != 1 || critical.BlinkHz <= 0 ||
		dead.Segments == nil || *dead.Segments != 0 || dead.Energy != 0 || wounded.Colour == whole.Colour || wounded.Colour == critical.Colour {
		t.Fatalf("the table is not the owner's rule: whole %+v wounded %+v critical %+v dead %+v", whole, wounded, critical, dead)
	}
	steps := biomonitorCourse(t, r, id, h)
	if steps[0].Tier != "whole" || steps[0].Segments != m.Segments {
		t.Fatalf("an unhurt wearer reads %+v, not every segment", steps[0])
	}
	order := map[string]int{"whole": 0, "wounded": 1, "critical": 2, "dead": 3}
	first := map[string]int{}
	rank := 0
	for i, s := range steps {
		k, ok := order[s.Tier]
		if !ok {
			t.Fatalf("step %d: unknown tier %+v", i, s)
		}
		if k < rank && s.Tier != "wounded" {
			t.Fatalf("step %d: the reading went back from rank %d to %+v", i, rank, s)
		}
		rank = max(rank, k)
		if _, seen := first[s.Tier]; !seen {
			first[s.Tier] = i
		}
		switch s.Tier {
		case "whole":
			if s.Segments != m.Segments || s.State != "ok" {
				t.Fatalf("step %d: whole %+v", i, s)
			}
		case "wounded":
			if s.Segments >= m.Segments || s.Segments <= 1 || (s.State != "ok" && s.State != "weak") {
				t.Fatalf("step %d: wounded must burn fewer than all and more than the critical one: %+v", i, s)
			}
		case "critical":
			if s.Segments != 1 || (s.State != "confused" && s.State != "down") {
				t.Fatalf("step %d: critical %+v", i, s)
			}
		case "dead":
			if s.Segments != 0 || s.State != "dead" {
				t.Fatalf("step %d: dead %+v", i, s)
			}
		}
	}
	for _, tier := range []string{"whole", "wounded", "critical", "dead"} {
		if _, ok := first[tier]; !ok {
			t.Fatalf("the course never read %s: %v", tier, first)
		}
	}
	if !(first["whole"] < first["wounded"] && first["wounded"] < first["critical"] && first["critical"] < first["dead"]) {
		t.Fatalf("the tiers came out of order: %v", first)
	}
	for _, s := range steps[first["dead"]:] {
		if s.Tier != "dead" {
			t.Fatalf("after the death the monitor read %+v", s)
		}
	}
	t.Logf("%d readings: whole at %d, wounded at %d (s %d), critical at %d (s %d), dead at %d (s %d)", len(steps), first["whole"],
		first["wounded"], steps[first["wounded"]].Second, first["critical"], steps[first["critical"]].Second, first["dead"], steps[first["dead"]].Second)
}

// The same world and the same blows give the same readings, step by step; a reading is a pure function of the body (twice
// the same), and the save keeps it (it is read from the saved body, nothing of its own is saved).
func TestBiomonitorIsDeterministic(t *testing.T) {
	r, id, h := biomonitorFixture(t)
	twin, _, _ := biomonitorFixture(t)
	a, b := biomonitorCourse(t, r, id, h), biomonitorCourse(t, twin, id, h)
	if !reflect.DeepEqual(a, b) {
		t.Fatal("the same blows on the same world read differently")
	}
	again, _, _ := biomonitorFixture(t)
	hits := 0
	for round := 0; round < 400 && hits < 3; round++ {
		h.Seed++
		if _, err := again.applyWorldHit(id, h); err != nil {
			t.Fatal(err)
		}
		if body, ok := again.biomonitorBody(id); ok && len(body.Wounds) > 0 {
			hits++
		}
	}
	worldHitBleed(t, again, id, 30)
	before := biomonitorRead(again, id)
	if before != biomonitorRead(again, id) {
		t.Fatal("one body read twice reads differently")
	}
	slot := again.world.Config.SaveSlots[0]
	if err := again.writeSave(slot, again.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := again.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	again.state = loaded
	if after := biomonitorRead(again, id); after != before {
		t.Fatalf("the save changed the reading: %+v -> %+v", before, after)
	}
}

// Published only for a wearer the hero sees (a scene agent after the perception filter), with exactly his reading;
// nobody else, and nothing when the wearer is elsewhere.
func TestBiomonitorPublishedForSeenWearersOnly(t *testing.T) {
	r, id, h := biomonitorFixture(t)
	r.world.Config.DebugPerception = false
	// The wearer and the hero a few steps apart on the open floor of the posts' level.
	wearer := r.state.Life.Actor(id)
	cells := turretWatchOpen(t, r, r.world.TurretWatch.Posts)
	turretWatchPlace(t, r, id, cells[0])
	beside := cells[1]
	for _, c := range cells[1:] {
		if biomonitorAbs(c.X-cells[0].X)+biomonitorAbs(c.Y-cells[0].Y) <= 3 {
			beside = c
			break
		}
	}
	turretWatchPlace(t, r, playerActorID, beside)
	h.From = behavior.Cell{X: cells[0].X + 4, Y: cells[0].Y}
	for h.Seed = 41; h.Seed < 400; h.Seed++ {
		if _, err := r.applyWorldHit(id, h); err != nil {
			t.Fatal(err)
		}
		if body, ok := r.biomonitorBody(id); ok && len(body.Wounds) > 0 {
			break
		}
	}
	send := func() *pb.PocGameState {
		c := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{})}
		r.sendState(c)
		return (<-c.out).GetGameState()
	}
	msg := send()
	seen := false
	for _, a := range msg.SceneAgents {
		seen = seen || a.Id == id
	}
	if !seen {
		t.Fatalf("the fixture's hero at %v does not see the wearer at %v", beside, wearer.Position)
	}
	tier, n := r.biomonitorOf(id)
	want := []*pb.PocBiomonitorState{{PersonId: id, Tier: tier, Segments: n}}
	if msg.Life == nil || len(msg.Life.Biomonitors) != 1 || msg.Life.Biomonitors[0].PersonId != id || msg.Life.Biomonitors[0].Tier != tier ||
		msg.Life.Biomonitors[0].Segments != n || tier == "whole" {
		t.Fatalf("published %v, want %v (a wounded wearer the hero sees)", msg.Life.GetBiomonitors(), want)
	}
	// Elsewhere: on another level the hero does not see him, nothing is sent.
	for level := range r.world.Life.Locations {
		if level != wearer.Level {
			wearer.Level = level
			break
		}
	}
	if msg = send(); msg.Life != nil && len(msg.Life.Biomonitors) != 0 {
		t.Fatalf("a wearer the hero does not see was published: %v", msg.Life.Biomonitors)
	}
}

func biomonitorAbs(v int) int {
	if v < 0 {
		return -v
	}
	return v
}

// The native proof's test wound (opt-in): from a real save of the proof at the hub (base/<slot>.json, written by
// client-godot/tools/mark_proof.gd), the wearer is hit by a test source through the general world-hit rule and bleeds
// through the ordinary after-care until his monitor reads 3, then 1; each state is saved as health-<n>/<slot>.json for the
// proof to load. A fixture of the proof, never the real world: the shipped content has no such blow.
var biomonitorProof = flag.String("biomonitor-proof", "", "directory with base/<slot>.json of the native proof; writes health-3 and health-1 saves")

func TestBiomonitorPrepareProofSaves(t *testing.T) {
	if *biomonitorProof == "" {
		t.Skip("opt-in native proof preparation")
	}
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	slot := ""
	for _, s := range r.world.Config.SaveSlots {
		if _, err := os.Stat(filepath.Join(*biomonitorProof, "base", s+".json")); err == nil {
			slot = s
			break
		}
	}
	if slot == "" {
		t.Fatalf("no base save in %s/base", *biomonitorProof)
	}
	r.data = filepath.Join(*biomonitorProof, "base")
	s, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	r.state = s
	m := r.world.Biomonitor
	if m == nil || len(m.Wearers) == 0 || r.world.TurretWatch == nil || r.world.TurretWatch.Rule.Fire == nil {
		t.Fatal("the content has no biomonitor wearer or no world source to wound him")
	}
	id := m.Wearers[0]
	a := r.state.Life.Actor(id)
	if a == nil || !a.OnFloor() {
		t.Fatalf("the wearer %s is not on a floor in the base save", id)
	}
	fire := r.world.TurretWatch.Rule.Fire
	h := worldHit{Source: "world.test_biomonitor", Fire: fire.WorldSource, Target: fire.Target, From: behavior.Cell{X: a.Position.X + 4, Y: a.Position.Y}, Seed: 41}
	start := r.state.Life.Seconds
	base := r.snapshotState()
	write := func(n int32, tier string) {
		out := filepath.Join(*biomonitorProof, "health-"+string(rune('0'+n)))
		if err := os.MkdirAll(out, 0o755); err != nil {
			t.Fatal(err)
		}
		r.data = out
		if err := r.writeSave(slot, r.snapshotState()); err != nil {
			t.Fatal(err)
		}
		body, _ := r.biomonitorBody(id)
		meta, _ := json.MarshalIndent(map[string]any{"slot": slot, "wearer": id, "tier": tier, "segments": n, "seed": h.Seed,
			"state": combatWounds.Status(body).State, "lost_permille": body.LostPermille(), "wounds": len(body.Wounds),
			"bled_seconds": r.state.Life.Seconds - start, "content_hash": r.world.ContentHash,
			"setup": "Real save of the native proof at the hub; the wearer is hit by the test source world.test_biomonitor with the turret posts' fire profile through applyWorldHit and bleeds through advanceWoundCare. Proof fixture only."}, "", " ")
		if err := os.WriteFile(filepath.Join(out, "setup.json"), meta, 0o644); err != nil {
			t.Fatal(err)
		}
		t.Logf("health-%d: %s", n, meta)
	}
	// The first course of blows (seeds from 42 on) that reads 3 on the way and then 1, each saved as it is reached; a
	// course that jumps over a wanted reading starts again from the base save with the next seeds (and overwrites).
	rank := map[string]int{"whole": 0, "wounded": 1, "critical": 2, "dead": 3}
	type want struct {
		n    int32
		tier string
	}
	for attempt := 0; attempt < 40; attempt++ {
		r.state = base
		r.state = r.snapshotState()
		wants := []want{{3, "wounded"}, {1, "critical"}}
		for round := 0; round < 4000 && len(wants) > 0 && !r.woundBodyDead(id); round++ {
			tier, n := r.biomonitorOf(id)
			if tier == wants[0].tier && n == wants[0].n {
				write(n, tier)
				wants = wants[1:]
				continue
			}
			if rank[tier] > rank[wants[0].tier] || (tier == wants[0].tier && n < wants[0].n) {
				break // jumped over it: another course
			}
			if biomonitorSettled(r, id) {
				h.Seed++
				if _, err := r.applyWorldHit(id, h); err != nil {
					t.Fatal(err)
				}
				continue
			}
			worldHitBleed(t, r, id, r.state.Life.SecondsPerTick)
		}
		if len(wants) == 0 {
			return
		}
	}
	t.Fatal("no course of 40 read 3 and then 1")
}
