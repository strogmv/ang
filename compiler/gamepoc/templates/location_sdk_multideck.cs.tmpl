     // non-solid parts (world text, signals, glass, screens: no shadows) are hidden meanwhile
     bool solid=renderer.shadowCastingMode!=UnityEngine.Rendering.ShadowCastingMode.Off||locationSDKFadeOriginal.ContainsKey(renderer);
     if(!solid||(renderer.sharedMaterial!=null&&renderer.sharedMaterial.shader!=null&&renderer.sharedMaterial.shader.name=="ANG/WorldText")){if(faded&&renderer.enabled){renderer.enabled=false;locationSDKInstanceHiddenText.Add(renderer);}continue;}
