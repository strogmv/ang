func(r *Runtime)regionNodeForLevel(level string)*regionNode{for i:=range r.world.Region.Nodes{if r.world.Region.Nodes[i].LevelID==level{return &r.world.Region.Nodes[i]}};return nil}
func(r *Runtime)regionLevelName(locale,level string)string{
 fallback:=r.world.Life.Locations[level].Name;if node:=r.regionNodeForLevel(level);node!=nil{return r.localText(locale,"region.node."+node.ID+".name",fallback)};return fallback
}
func(r *Runtime)regionPlaceKnown(level string)bool{
