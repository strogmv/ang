func cargoHM(s int64)string{if s==0{return "--"};return fmt.Sprintf("%02d:%02d",s%86400/3600,s%3600/60)}
func cargoLotStock(r *Runtime)map[string]int64{out:=map[string]int64{};for _,lot:=range r.world.CargoConvoys.Lots{for _,s:=range append([]string{lot.CopperStore,lot.LockerStore},func()[]string{x:=[]string{};for _,v:=range lot.TrailerStores{x=append(x,v)};return x}()...){out[s]=r.cargoStock(s,"","")}};return out}
func(r *Runtime)cargoTrailerAt(stand,bay string)string{for id,t:=range r.state.CargoConvoys.Trailers{if t.Stand==stand&&t.Bay==bay{return id}};return ""}
func(r *Runtime)cargoAnyHook()bool{for _,k:=range r.state.CargoConvoys.Cranes{if k.Hook!=""{return true}};return false}
