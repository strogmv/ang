// Code generated by ANG. Emergency destinations reuse ordinary physical movement.
package behavior

import "fmt"

// Situation names refer to existing host intents, never identity or speed.
type LifeGaitPolicy struct {
 RunFactor float64 `json:"run_factor"`
 Situations map[string]bool `json:"situations"`
 Actors map[string]map[string]bool `json:"actors,omitempty"`
 OpeningWindows map[string]LifeGaitOpening `json:"opening_windows,omitempty"`
}
type LifeGaitOpening struct {OpenSecond int64 `json:"open_second"`; WindowSeconds int64 `json:"window_seconds"`}
func (p LifeGaitPolicy) delayedOpening(id string, now, until int64) bool {
 window,ok:=p.OpeningWindows[id];if !ok{return false}
 open:=now/86400*86400+window.OpenSecond
 if now<open && open-now>86400-window.WindowSeconds {open-=86400}
 return until>=open && now<=open+window.WindowSeconds
}
func (p LifeGaitPolicy) running(id string, safety *LifeSafetyOverride, delayedWork bool, target string) bool {
 if p.RunFactor <= 1 { return false }
 situation:=""
 if safety != nil { situation=safety.Activity } else if delayedWork && target=="work" {situation="late_opening"}
 if actors,restricted:=p.Actors[situation];restricted&&!actors[id]{return false}
 return p.Situations[situation]
}
func (m LifeModel) NamedRunning(a *LifeActor) bool {
 return a != nil && a.ID != "" && !a.Sneaking && a.WoundPaceMMS == 0 && !a.Arrived && m.Gait.running(a.ID,a.Safety,a.IncidentDelayedWork,a.Brain.Target.Activity)
}
func (m LifeModel) PopulationRunning(a PopulationActor) bool {
 return a.WoundPaceMMS == 0 && !a.Arrived && m.Gait.running(a.ID,a.Safety,false,"")
}
func (m LifeModel) GaitPace(pace int64, running bool) int64 {
 if running { return max(int64(1),int64(float64(pace)/m.Gait.RunFactor+0.999999)) }
 return pace
}
func (m LifeModel) NamedMoveTicks(a *LifeActor) int64 {
 pace:=m.GaitPace(m.MoveTicks,m.NamedRunning(a))
 if a!=nil && a.WoundPaceMMS>0 { pace=max(pace,(int64(m.Locations[a.Level].CellMM)+a.WoundPaceMMS-1)/a.WoundPaceMMS) }
 if a!=nil && a.Sneaking { pace=int64(float64(pace)/m.HeroBody.sneakFactor()+0.999999) }
 return pace
}

// A locally perceived danger may interrupt an agenda, never move a body itself.
// The host owns the observation and expiry. The kernel owns path/collision/time.
type LifeSafetyOverride struct {
	Level       string `json:"level"`
	Goal        Cell   `json:"goal"`
	ThreatAt    Cell   `json:"threat_at"`
	Until       int64  `json:"until"`
	LabelKey    string `json:"label_key"`
	Activity    string `json:"activity"`
	Reason      string `json:"reason"`
	EncounterID string `json:"encounter_id"`
}

func (s *LifeSafetyOverride) clone() *LifeSafetyOverride {
	if s == nil {
		return nil
	}
	v := *s
	return &v
}
func (s *LifeSafetyOverride) validate(m LifeModel, level string, seconds int64) error {
	if s == nil {
		return nil
	}
	if s.Level != level || !m.Walks(level, s.Goal) || s.Until < 1 || s.Until > seconds+86400 || (s.Activity != "shelter" && s.Activity != "investigate") || s.LabelKey == "" || len(s.LabelKey) > 128 || s.Reason == "" || len(s.Reason) > 256 || len(s.EncounterID) > 256 {
		return fmt.Errorf("invalid life safety override")
	}
	return nil
}
func (s *LifeSafetyOverride) target() LifeStep {
	return LifeStep{Level: s.Level, At: s.Goal, Activity: s.Activity, Label: s.LabelKey}
}

// InterruptService stops a physical service when the host incapacitates its actor.
// Needs, money, consumed resources and earned work remain intact.
func (b *LifeBrain) InterruptService() { b.interruptService() }

func (b *LifeBrain) interruptService() {
	b.clearSeat()
	b.Place = LifeAffordance{}
	b.Target = LifeStep{}
	b.Goal = GoalState{}
	b.BreakKind = ""
	b.Returning = false
	b.NextDecision = 0
	b.PathRetrySecond = 0
	b.MealElapsed = 0
}

// ApplySafety accepts only an existing non-controlled physical actor and an
// attainable destination on its present floor. No trip/teleport or new ID.
func (s *LifeState) ApplySafety(m LifeModel, id string, response LifeSafetyOverride) error {
	if id == s.ControlledActorID {
		return fmt.Errorf("controlled actor safety is player-owned")
	}
	if err := response.validate(m, response.Level, s.Seconds); err != nil {
		return err
	}
	if response.Until <= s.Seconds {
		return fmt.Errorf("expired safety override")
	}
	if a := s.Actor(id); a != nil {
		if !a.OnFloor() || a.CombatHold || a.Level != response.Level || a.Manual {
			return fmt.Errorf("actor cannot accept safety override")
		}
		if a.Position != response.Goal && len(m.Space(a.Level, nil).Path(a.Position, response.Goal, Cell{}, 0)) == 0 {
			return fmt.Errorf("unreachable safety destination")
		}
		a.Safety = response.clone()
		if a.Brain.Target.Activity == "work" && m.Gait.delayedOpening(id,s.Seconds,response.Until) { a.IncidentDelayedWork = true }
		a.Brain.interruptService()
		a.Path = nil
		a.PendingPath = nil
		a.Goal = response.Goal
		a.Arrived = a.Position == response.Goal
		a.OverrideLevel = ""
		a.OverrideEdge = ""
		a.WaitingDeparture = 0
		a.YieldUntil = 0
		a.YieldRequester = ""
		a.YieldHoldUntil = 0
		if a.Arrived {
			a.Activity = response.Activity
		} else {
			a.Activity = "walking"
		}
		a.Label = response.LabelKey
		return nil
	}
	for i := range s.Population.Actors {
		a := &s.Population.Actors[i]
		if a.ID != id {
			continue
		}
		if a.CombatHold || a.Trip != nil || !a.Materialized || a.Level != response.Level {
			return fmt.Errorf("population actor cannot accept safety override")
		}
		if a.Position != response.Goal && len(m.Space(a.Level, nil).Path(a.Position, response.Goal, Cell{}, 0)) == 0 {
			return fmt.Errorf("unreachable safety destination")
		}
		a.Safety = response.clone()
		a.Brain.interruptService()
		a.Path = nil
		a.Goal = response.Goal
		a.Arrived = a.Position == response.Goal
		a.WaitingDeparture = 0
		a.YieldUntil = 0
		a.YieldRequester = ""
		a.YieldHoldUntil = 0
		a.Queued = false
		a.QueueReason = ""
		if a.Arrived {
			a.Activity = response.Activity
		} else {
			a.Activity = "walking"
		}
		return nil
	}
	return fmt.Errorf("unknown safety actor")
}
func (s *LifeState) ClearSafety(id string) {
	if a := s.Actor(id); a != nil {
		if a.Safety != nil {
			a.Safety = nil
			a.Arrived = false
			a.Path = nil
			a.PendingPath = nil
			a.Brain.NextDecision = 0
			a.Brain.PathRetrySecond = 0
		}
		return
	}
	for i := range s.Population.Actors {
		a := &s.Population.Actors[i]
		if a.ID == id && a.Safety != nil {
			a.Safety = nil
			a.Arrived = false
			a.Path = nil
			a.Brain.NextDecision = 0
		}
	}
}
