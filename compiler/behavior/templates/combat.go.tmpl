func combatReadyPotential(a Combatant, r CombatRules) float64 {
	ap := r.APPerTurn
	ammo := a.Ammo
	if a.Weapon.Magazine > 0 && ammo == 0 && a.ReserveAmmo > 0 {
		ap -= r.ReloadAP
		ammo = min(a.Weapon.Magazine, a.ReserveAmmo)
	}
	n := max(0, ap/max(1, a.Weapon.AttackAP))
	if a.Weapon.Magazine > 0 {
		n = min(n, ammo)
	}
	if a.WeaponUsesLimited {
		n = min(n, a.WeaponUsesRemaining)
	}
	chance := float64(a.Skill) / float64(a.Skill+r.EstimatedDefense+1)
	return float64(a.WeaponRisk()*n) * chance * (r.DamageMin + r.DamageMax) / 2 * r.AttackWeight
}
