func TestLifeCourtesyDistantFriendWaitsForLocalApproach(t *testing.T) {
	for _, radius := range []int{0, 1, 2} {
		m, s := courtesyFixture()
		m.Courtesy.NoticeCells = radius
		m.Locations["hall"] = LifeLocation{Name: "Hall", Terrain: []string{"#######", "####.##", "#.....#", "#######", "#######"}}
		m.Actors[1].Steps[0].At = Cell{4, 2}
		s = m.Start()
		s.ControlledActorID = "hero"
		before := s.Clone()
		if s.yieldPopulationFor(m, "hall", Cell{4, 2}, 0, "hero", Cell{2, 2}, Cell{3, 2}, Cell{4, 2}, Cell{5, 2}) || !reflect.DeepEqual(before, s.Clone()) {
			t.Fatalf("radius %d: distant friend reacted before approach", radius)
		}
		courtesyAccept(t, m, &s, Cell{5, 2})
		yielded := false
		for tick := int64(1); tick <= 60; tick++ {
			courtesyAdvance(t, m, &s, tick)
			if s.Actor("friend").YieldUntil > 0 && !yielded {
				notice := radius
				if notice == 0 {
					notice = 2
				}
				if Distance(s.Actor("hero").Position, Cell{4, 2}) > notice {
					t.Fatalf("radius %d: friend yielded outside local range", radius)
				}
				yielded = true
			}
		}
		if !yielded || s.Actor("hero").Position != (Cell{5, 2}) {
			t.Fatalf("radius %d: approaching hero never received passage", radius)
		}
	}
}

