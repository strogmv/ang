func peddlerCarried(r *Runtime, definition string) inv.Item {
	for _, id := range sortedCraftingItems(r.state.Inventory) {
		if i := r.state.Inventory.Items[id]; i.Definition == definition && r.carried(i) {
			return i
		}
	}
