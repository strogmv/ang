		claims, clErr := parseAndVerifyJWT(raw)
		if clErr != nil {
			conn.WriteMessage(websocket.CloseMessage, websocket.FormatCloseMessage(4001, "invalid token"))
			conn.Close()
			return "", "", fmt.Errorf("ws auth: %w", clErr)
		}
		return getStringClaim(claims, authUserClaim), getStringClaim(claims, authCompanyClaim), nil
	}
	if claims, cookieErr := authClaimsFromCookieSession(r); cookieErr == nil {
		ac := authContextFromClaims(claims)
		if ac.UserID != "" {
			return ac.UserID, ac.CompanyID, nil
		}
	}
	return wsReadAuthToken(conn)
