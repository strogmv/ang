// Code generated by ANG. DO NOT EDIT.
// The noise waves on the real world (combat-play/noise-waves): the ring ends exactly where the rule stops hearing; what the hero does not hear never reaches the client; a source he does not see
// stands at the rule's estimate, not at its true place; nothing of this changes the state.
package poc

import (
	"encoding/json"
	"math"
	"testing"

	behavior "angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

func noiseView(r *Runtime) []*pb.PocNoiseWave {
	v := &pb.PocLifeView{}
	r.appendNoiseWaves(v, r.state.Life.Actor(playerActorID))
	return v.NoiseWaves
}

// noiseFieldCell: I at the centre of a plan cell by the numbers of the wave and its layer, as the shader counts it; false when the layer has no floor there.
func noiseFieldCell(w *pb.PocNoiseWave, l *pb.PocNoiseLayer, x, y, unit int) (float64, bool) {
	cx, cy := x-int(l.X0), y-int(l.Y0)
	if cx < 0 || cy < 0 || cx >= int(l.Width) || cy >= int(l.Depth) {
		return 0, false
	}
	v := l.Cells[cy*int(l.Width)+cx]
	if v == noiseCellAbsent {
		return 0, false
	}
	walls, place := int(v&15), int(v>>4)
	dm := math.Abs((float64(x)+.5)*float64(unit)-float64(w.XMm)) + math.Abs((float64(y)+.5)*float64(unit)-float64(w.YMm))
	return float64(w.Loudness)*(1-dm/float64(w.ReachMm))*math.Pow(float64(w.WallAttenuation), float64(walls)) - float64(place)*float64(w.AmbientMask), true
}
func noiseBaseline(t *testing.T, r *Runtime) {
	t.Helper()
	noiseView(r)
	r.noise.pending = nil
}

func TestNoiseRadiusIsTheRule(t *testing.T) {
	r, _, d := combatEpisodeFixture(t, "combat_throat", "ru")
	noiseBaseline(t, r)
	hero := r.state.Life.Actor(playerActorID)
	for _, q := range []struct {
		Ambient  int
		Loudness float64
		Want     float64
	}{{0, 0.12, .72}, {0, 0.3, 3.96}, {0, 0.9, 14.76}, {5, 0.12, 0}, {5, 0.3, 3.06}, {5, 0.45, 5.76}, {5, 0.54, 7.38}, {5, 1, 15.66}} {
		r.world.Scene.AmbientNoise = q.Ambient
		r.noise.waves = nil
		r.noiseOwn("test", d.Level, hero.Position, q.Loudness, 0)
		waves := noiseView(r)
		if q.Want == 0 {
			if len(waves) != 0 {
				t.Fatalf("L=%v place %d: nobody can hear it, but a wave was published: %+v", q.Loudness, q.Ambient, waves[0])
			}
			continue
		}
		if len(waves) != 1 || math.Abs(float64(waves[0].RadiusMm)/1000-q.Want) > .001 {
			t.Fatalf("L=%v place %d: radius want %.3f m got %+v", q.Loudness, q.Ambient, q.Want, waves)
		}
	}
}

// Every standing cell: the field the client draws by says heard exactly where the rule says heard.
func noiseAgrees(t *testing.T, r *Runtime, level string, from behavior.Cell, loudness float64) int {
	t.Helper()
	unit := r.world.Life.Locations[level].CellMM
	v := r.world.Decks[level]
	r.noise.waves = nil
	r.noiseOwn("test", level, from, loudness, 0)
	waves := noiseView(r)
	if len(waves) != 1 {
		t.Fatalf("no wave at %v L=%v", from, loudness)
	}
	w := waves[0]
	terrain := r.world.Life.Locations[level].Terrain
	checked := 0
	for y := range terrain {
		for x := range terrain[y] {
			at := behavior.Cell{X: x, Y: y}
			if !r.world.Life.Walks(level, at) {
				continue
			}
			plan, height := at, 0
			var surface = -1
			if v != nil {
				p, h, s, ok := v.Locate(at)
				if !ok {
					continue
				}
				plan, height, surface = p, h, s
			}
			_, heard := r.combatWorldHeard(combatLifeObserver{ID: "listener", Level: level, At: at}, from, loudness)
			found, audible := false, false
			for _, l := range w.Layers {
				if len(l.HeightsMm) == 0 && int(l.HeightMm) != height || len(l.HeightsMm) > 0 && surface >= 0 {
					continue
				}
				if i, ok := noiseFieldCell(w, l, plan.X, plan.Y, unit); ok {
					if len(l.HeightsMm) > 0 && int(l.HeightsMm[(plan.Y-int(l.Y0))*int(l.Width)+plan.X-int(l.X0)]) != height {
						continue
					}
					found = true
					audible = i >= float64(w.MinAudible)
					break
				}
			}
			if heard && (!found || !audible) || !heard && found && audible {
				t.Fatalf("cell %v plan %v height %d: rule heard=%v, field found=%v audible=%v", at, plan, height, heard, found, audible)
			}
			checked++
		}
	}
	return checked
}
func TestNoiseFieldAgreesWithHearOnEveryCell(t *testing.T) {
	r, _, d := combatEpisodeFixture(t, "combat_throat", "ru")
	noiseBaseline(t, r)
	for _, l := range []float64{.3, .45, .9, 1} {
		for _, at := range []behavior.Cell{{X: 5, Y: 17}, {X: 27, Y: 10}, {X: 21, Y: 15}} {
			if noiseAgrees(t, r, d.Level, at, l) < 100 {
				t.Fatal("too few cells checked")
			}
		}
	}
	m := lifeRuntimeFixture(t)
	noiseBaseline(t, m)
	level := m.state.Life.Actor(playerActorID).Level
	v := m.world.Decks[level]
	if v == nil {
		t.Skip("market without decks")
	}
	// a floor cell, a gallery cell, a stair cell, and the loud sound down from the gallery
	for _, s := range v.Surfaces {
		if !s.Walkable || s.NavRow < 0 || len(s.Slab) == 0 {
			continue
		}
		rect := s.Slab[0]
		at := behavior.Cell{X: rect.X + rect.W/2, Y: s.NavRow + rect.Y + rect.H/2}
		if !m.world.Life.Walks(level, at) {
			continue
		}
		noiseAgrees(t, m, level, at, .9)
		noiseAgrees(t, m, level, at, .3)
	}
	if len(v.Connectors) > 0 {
		noiseAgrees(t, m, level, v.Connectors[0].Nodes[len(v.Connectors[0].Nodes)/2].Nav, .9)
	}
}

// A wave lies on floors the rule reads, at their heights; a floor that does not exist under it has no cell, so nothing hangs in the air.
func TestNoiseLayersFollowTheDecks(t *testing.T) {
	m := lifeRuntimeFixture(t)
	noiseBaseline(t, m)
	level := m.state.Life.Actor(playerActorID).Level
	v := m.world.Decks[level]
	if v == nil {
		t.Skip("market without decks")
	}
	var gallery *behavior.DeckSurface
	for i := range v.Surfaces {
		if v.Surfaces[i].ElevationMM == 3100 && v.Surfaces[i].Walkable {
			gallery = &v.Surfaces[i]
		}
	}
	if gallery == nil {
		t.Fatal("the market has no walkable gallery at +3.1 m")
	}
	rect := gallery.Slab[0]
	at := behavior.Cell{X: rect.X + rect.W/2, Y: gallery.NavRow + rect.Y + rect.H/2}
	m.noiseOwn("test", level, at, .9, 0)
	waves := noiseView(m)
	if len(waves) != 1 || waves[0].HeightMm != 3100 {
		t.Fatalf("a sound on the gallery must stand at +3.1 m: %+v", waves)
	}
	heights := map[int32]int{}
	absent := 0
	for _, l := range waves[0].Layers {
		if len(l.HeightsMm) > 0 {
			heights[-1]++
			continue
		}
		heights[l.HeightMm]++
		if l.HeightMm == 3100 {
			for i, c := range l.Cells {
				x, y := int(l.X0)+i%int(l.Width), int(l.Y0)+i/int(l.Width)
				inside := false
				for _, q := range gallery.Slab {
					inside = inside || x >= q.X && x < q.X+q.W && y >= q.Y && y < q.Y+q.H
				}
				if c != noiseCellAbsent && !inside {
					t.Fatalf("gallery layer has a cell outside its slab at %d,%d", x, y)
				}
				if c == noiseCellAbsent {
					absent++
				}
			}
		}
	}
	if heights[3100] != 1 || heights[0] != 1 {
		t.Fatalf("want the gallery and the floor under it: %v", heights)
	}
	if absent == 0 {
		t.Fatal("the gallery layer must leave holes where the gallery is not")
	}
}

// A fight behind the wall: heard, weaker by the walls, at the estimate; a sound he cannot hear does not exist for the client.
func TestNoiseOfAnNPCIsNoRadar(t *testing.T) {
	r, _, d := combatEpisodeFixture(t, "combat_noise_wall", "ru")
	noiseBaseline(t, r)
	hero := r.state.Life.Actor(playerActorID)
	seen, differs := 0, 0
	for frame := 0; frame < 2400 && seen < 12; frame++ {
		r.step()
		before := len(r.noise.waves)
		events := append([]behavior.CombatEvent(nil), r.state.Combat.Events...)
		for _, w := range noiseView(r)[min(before, len(r.noise.waves)):] {
			if w.Own {
				t.Fatalf("the hero did nothing: %+v", w)
			}
			seen++
			if w.Strength >= 1 || math.Abs(float64(w.Strength)-math.Pow(.7, math.Round(math.Log(float64(w.Strength))/math.Log(.7)))) > 1e-4 {
				t.Fatalf("through the wall the wave is weaker by 0.7 per wall: %v", w.Strength)
			}
			for _, e := range events {
				if uint64(w.CombatSequence) != e.Sequence {
					continue
				}
				heard, ok := r.combatWorldHeard(combatLifeObserver{ID: hero.ID, Level: hero.Level, At: hero.Position}, e.From, r.world.CombatLife.MeleeLoudness)
				if !ok {
					t.Fatalf("a wave for a sound the hero does not hear: %+v", e)
				}
				unit := float32(r.world.Life.Locations[d.Level].CellMM)
				wantX, wantY := (float32(heard.Estimate.X)+.5)*unit, (float32(heard.Estimate.Y)+.5)*unit
				if w.XMm != wantX || w.YMm != wantY || w.CrestXMm != wantX || w.CrestYMm != wantY {
					t.Fatalf("wave at %v,%v, the rule's estimate at %v,%v", w.XMm, w.YMm, wantX, wantY)
				}
				if trueX, trueY := (float32(e.From.X)+.5)*unit, (float32(e.From.Y)+.5)*unit; w.XMm != trueX || w.YMm != trueY {
					differs++
				}
			}
		}
	}
	if seen == 0 {
		t.Fatal("the fight behind the wall never reached the hero")
	}
	if differs == 0 {
		t.Fatal("every wave stands at the true place of the source")
	}
	// the same source out of hearing: nothing at all
	far := behavior.Cell{X: 32, Y: 2}
	if _, ok := r.combatWorldHeard(combatLifeObserver{ID: hero.ID, Level: hero.Level, At: hero.Position}, far, .45); ok {
		t.Fatal("fixture: the far cell must be out of hearing")
	}
	r.noise.waves = nil
	r.noiseSource("strike", d.Level, d.Guard, far, .45, 0)
	if waves := noiseView(r); len(waves) != 0 {
		t.Fatalf("a sound the hero does not hear reached the snapshot: %+v", waves)
	}
}

func TestNoiseOfTheHeroHimself(t *testing.T) {
	r, c, _ := throatFixture(t)
	noiseBaseline(t, r)
	r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: uint64(r.state.Tick) + 1, X: 24, Y: 10})
	playableDrain(c)
	walked := []*pb.PocNoiseWave{}
	for frame := 0; frame < 200 && len(walked) < 2 && !r.heroInCombat(); frame++ {
		r.step()
		before := len(r.noise.waves)
		for _, w := range noiseView(r)[min(before, len(r.noise.waves)):] {
			walked = append(walked, w)
		}
	}
	if len(walked) == 0 {
		t.Fatal("ordinary steps gave no wave")
	}
	h := r.state.Life.Actor(playerActorID)
	for _, w := range walked {
		if !w.Own || w.Kind != "step" || math.Abs(float64(w.Loudness)-.3) > 1e-6 || math.Abs(float64(w.RadiusMm)-3060) > 1 || w.Strength != 1 {
			t.Fatalf("an ordinary step: %+v", w)
		}
		if h.Body != nil && math.Hypot(float64(w.CrestXMm)-h.Body.X, float64(w.CrestYMm)-h.Body.Y) > 2500 {
			t.Fatalf("the crest is not at the feet: %+v body %v,%v", w, h.Body.X, h.Body.Y)
		}
	}
	// a quiet step on dry floor: I(0) = 0.12 - 0.05 < 0.08, nobody can hear it, so there is no wave; the rule's own test says the same
	q, qc, _ := throatFixture(t)
	noiseBaseline(t, q)
	if err := q.stealthCommand("on"); err != nil {
		t.Fatal(err)
	}
	q.move(qc, &pb.MoveTo{Epoch: q.state.Epoch, InputSeq: uint64(q.state.Tick) + 1, X: 24, Y: 10})
	playableDrain(qc)
	for frame := 0; frame < 200; frame++ {
		q.step()
		if waves := noiseView(q); len(waves) != 0 {
			t.Fatalf("a quiet step nobody can hear: %+v", waves)
		}
	}
	if q.state.Stealth.NoiseSequence == 0 {
		t.Fatal("the quiet walk made no steps")
	}
	// the same step with no noise of the place: the macket's 0.72 m
	q.world.Scene.AmbientNoise = 0
	q.move(qc, &pb.MoveTo{Epoch: q.state.Epoch, InputSeq: uint64(q.state.Tick) + 1, X: 27, Y: 10})
	playableDrain(qc)
	got := false
	for frame := 0; frame < 200 && !got; frame++ {
		q.step()
		for _, w := range noiseView(q) {
			got = got || w.Kind == "quiet_step" && math.Abs(float64(w.RadiusMm)-720) < 1
		}
	}
	if !got {
		t.Fatal("no quiet wave at the place noise of zero")
	}
}

// The real command of the stand: the baton is a blow, the rule's 0.45; the throat is 0.12, not heard.
func TestNoiseOfTheTakedowns(t *testing.T) {
	r, rc, d := stunFixture(t, 3)
	noiseBaseline(t, r)
	throatWalk(t, r, rc, throatStandoff, "on")
	noiseBaseline(t, r)
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: d.Guard, Mode: stunMode}); err != nil {
		t.Fatal(err)
	}
	found := false
	for _, w := range noiseView(r) {
		if w.Own && w.Kind == "takedown" && w.CombatSequence > 0 && math.Abs(float64(w.RadiusMm)-5760) < 1 {
			found = true
		}
	}
	if !found {
		t.Fatalf("no wave of the baton blow at 5.76 m: %+v", r.noise.waves)
	}
	th, c, td := throatFixture(t)
	noiseBaseline(t, th)
	throatWalk(t, th, c, throatStandoff, "on")
	noiseBaseline(t, th)
	if err := th.combatCommand(&pb.PocCombatCommand{Action: "takedown", TargetId: td.Guard, Mode: throatMode}); err != nil {
		t.Fatal(err)
	}
	for _, w := range noiseView(th) {
		if w.Kind == "takedown" {
			t.Fatalf("0.12 under the place noise of 5 is not audible: %+v", w)
		}
	}
}

// Two runs of the same seed, one served with waves every frame: the states match to the byte.
func TestNoiseWavesChangeNoState(t *testing.T) {
	run := func(serve bool) []byte {
		r, c, _ := throatFixture(t)
		r.state.Seed = 11
		r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1000, X: int32(throatStandoff.X), Y: int32(throatStandoff.Y)})
		playableDrain(c)
		for frame := 0; frame < 900; frame++ {
			r.step()
			if serve {
				noiseView(r)
			}
		}
		s := r.snapshotState()
		s.Epoch = ""
		raw, err := json.Marshal(s)
		if err != nil {
			t.Fatal(err)
		}
		return raw
	}
	a, b := run(false), run(true)
	if string(a) != string(b) {
		t.Fatalf("the waves changed the state: %d vs %d bytes", len(a), len(b))
	}
}

func TestNoiseWavesOffInData(t *testing.T) {
	r, _, d := combatEpisodeFixture(t, "combat_throat", "ru")
	noiseBaseline(t, r)
	r.world.NoiseWaves.Enabled = false
	r.noiseOwn("test", d.Level, r.state.Life.Actor(playerActorID).Position, .9, 0)
