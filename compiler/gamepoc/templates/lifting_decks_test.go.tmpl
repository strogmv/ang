func TestLiftingDeckObstructionStopsHoldsRetriesAndSaves(t *testing.T){
 d:=liftingDeckFixture();p:=liftingDeckPose{Leaves:liftingDeckFull,Barrier:liftingDeckFull,Unlock:liftingDeckFull,Release:liftingDeckFull}
 g:=liftingDeckState{Phase:"lockdown_closing",Cause:"lockdown",From:p,To:liftingDeckPose{Barrier:liftingDeckFull},DurationNS:3600000000,NextRunSecond:22200,ClearSinceNS:-1}
 g.advance(d,100000000,21600,true,true,false)
 held:=g.pose(g.UpdatedNS);if g.Phase!="stopped"||held.Leaves!=liftingDeckFull||g.Stops!=1{t.Fatalf("leaf failed to stop before obstruction: %+v",g)}
 raw,err:=json.Marshal(g);if err!=nil{t.Fatal(err)};var restored liftingDeckState;if err=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)}
 for step:=int64(2);step<=400;step++{now:=step*100000000;present:=step<100;g.advance(d,now,21600+step/10,present,true,false);restored.advance(d,now,21600+step/10,present,true,false);if !reflect.DeepEqual(g,restored){t.Fatal("saved obstruction retry diverged")};if present&&g.pose(now).Leaves!=held.Leaves{t.Fatal("forced closure over occupied leaf")}}
 if g.Phase!="sealed"{t.Fatalf("clear retry did not seal: %s",g.Phase)}
}
// Test an entrant at each fractional part of the barrier travel, including
// the completion tick. A saved reversal must follow the exact same safe path.
func TestLiftingDeckBarrierEntrantReturnsDownAndReopensExit(t *testing.T){
 d:=liftingDeckFixture();d.BarrierRect.W=3;d.BarrierRect.H=1;d.BarrierFloor=[]string{".+."}
 for _,fraction:=range []int64{1,100,250,500,750,990,1000}{
  p:=liftingDeckPose{Damper:liftingDeckFull};q:=p;q.Barrier=liftingDeckFull
  g:=liftingDeckState{Phase:"barrier_up",From:p,To:q,DurationNS:d.Timing.Barrier*1000000,NextRunSecond:22200,ClearSinceNS:-1}
  at:=d.Timing.Barrier*1000000*fraction/1000;g.advance(d,at,21600,false,false,false)
  before:=g.pose(at);g.advance(d,at+1,21600,true,false,false)
  if g.pose(at+1).Barrier>before.Barrier{t.Fatal("barrier advanced into a new entrant")}
  raw,_:=json.Marshal(g);var restored liftingDeckState;if err:=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)}
  previous:=g.pose(at+1).Barrier
  for step:=int64(1);step<=120;step++{
   now:=at+1+step*100000000;g.advance(d,now,21600+step/10,true,false,false);restored.advance(d,now,21600+step/10,true,false,false)
   if !reflect.DeepEqual(g,restored){t.Fatal("saved barrier reversal diverged")}
   p=g.pose(now);if p.Leaves!=0||p.Deck!=0||p.Barrier>previous{t.Fatal("entrant was enclosed or floor opened",fraction,g.Phase,p)};previous=p.Barrier
  }
  if g.Phase!="signal_up"||g.pose(g.UpdatedNS).Barrier!=0{t.Fatalf("entrant has no clear exit: %s %+v",g.Phase,g.pose(g.UpdatedNS))}
  if g.barrierGlyph(d,0,0)!='.'||g.barrierGlyph(d,1,0)!='+'||g.barrierGlyph(d,2,0)!='.'{t.Fatal("lowered barrier did not restore exact base floor")}
  for step:=int64(121);step<=600;step++{now:=at+1+step*100000000;g.advance(d,now,21600+step/10,false,false,false)}
  if g.pose(g.UpdatedNS).Leaves==0{t.Fatal("clear entrant retry never resumed")}
 }
}

func liftingDeckActualCycleSamples(d liftingDeckDefinition)map[string]liftingDeckState{
 samples:=map[string]liftingDeckState{"rest/start":{Phase:"rest",NextRunSecond:21600,ClearSinceNS:-1}}
 g:=samples["rest/start"];lastPhase:="rest";last:=g
 for step:=int64(1);step<=24000;step++{
  now:=step*5000000;g.advance(d,now,21600+step/200,false,false,false)
  if g.Phase!=lastPhase{samples[lastPhase+"/end"]=last;lastPhase=g.Phase}
  if _,ok:=samples[g.Phase+"/start"];!ok{samples[g.Phase+"/start"]=g}
  if g.DurationNS>0&&g.UpdatedNS-g.StartNS>=g.DurationNS/2{if _,ok:=samples[g.Phase+"/middle"];!ok{samples[g.Phase+"/middle"]=g}}
  last=g
  if g.Phase=="rest"&&g.Runs>0{break}
 }
 return samples
}

func TestLiftingDeckClosedLeafAlarmNeverRaisesAroundPerson(t *testing.T){
 d:=liftingDeckFixture();samples:=liftingDeckActualCycleSamples(d);checked:=0
 for name,original:=range samples{
  start:=original.pose(original.UpdatedNS)
  if start.Leaves!=0||start.Deck!=0{continue}
  for _,power:=range []bool{false,true}{
   g:=original;previous:=start.Barrier
   for step:=int64(1);step<=3000;step++{
    now:=original.UpdatedNS+step*5000000;g.advance(d,now,21700,true,!power,power);p:=g.pose(now)
    if p.Leaves!=0||p.Deck!=0||p.Barrier>previous{t.Fatalf("%s power=%v alarm enclosed a standing person: %+v",name,power,p)}
    previous=p.Barrier
   }
   if g.Phase!="sealed"||g.pose(g.UpdatedNS).Barrier!=0{t.Fatalf("%s power=%v did not leave an open floor exit: %s",name,power,g.Phase)}
   checked++
  }
 }
 if checked<20{t.Fatal("actual closed cycle phases missing",checked)}
}

func TestLiftingDeckEveryActualPhaseLocksAndSaves(t *testing.T){
 d:=liftingDeckFixture();samples:=liftingDeckActualCycleSamples(d)
 if len(samples)<40{t.Fatal("actual cycle sampling missed states",len(samples))}
 for name,original:=range samples{for _,power:=range []bool{false,true}{
  g:=original;raw,_:=json.Marshal(g);var restored liftingDeckState;if err:=json.Unmarshal(raw,&restored);err!=nil{t.Fatal(err)}
  for step:=int64(1);step<=1000;step++{
   now:=original.UpdatedNS+step*50000000;g.advance(d,now,21700,false,!power,power);restored.advance(d,now,21700,false,!power,power)
   if !reflect.DeepEqual(g,restored){t.Fatalf("%s saved alarm diverged",name)}
   p:=g.pose(now);if p.Deck>0&&p.Leaves!=liftingDeckFull{t.Fatalf("%s deck crossed leaves during alarm",name)}
   if p.Leaves>0&&p.Deck<liftingDeckFull&&p.Barrier!=liftingDeckFull{t.Fatalf("%s unprotected open shaft",name)}
  }
  if g.Phase!="sealed"||g.pose(g.UpdatedNS)!=(liftingDeckPose{}){t.Fatalf("%s power=%v not sealed: %+v",name,power,g)}
 }}
}

