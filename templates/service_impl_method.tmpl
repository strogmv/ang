{{- if .ProvenanceHeader }}{{ .ProvenanceHeader }}{{- end }}
package service

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

{{- if and .Method (not (mapHas .Overrides .Method.Name)) }}
{{- if .Method.Source }}
// Generated from: {{ .Method.Source }}
{{- end }}
{{ ServiceImplMethodSignature .Service.Name .Method }} {
	{{- if and .Method.Impl .Method.Impl.Code }}
{{ Indent (CleanImplCode .Method.Impl.Code .Method.Output.Name) 1 }}
	{{- else if .Method.ImplSteps }}
{{ Indent (RenderImplSteps .Service .Method.ImplSteps .Service.Name .Method.Name) 1 }}
	{{- else if .Method.Flow }}
		{{- if FlowRenderable .Method.Flow }}
{{ Indent (RenderFlow .Service.Name .Method.Name .Method.IsStreaming .Method.Flow) 1 }}
{{- if .Method.IsStreaming }}
return nil
{{- else }}
return resp, nil
{{- end }}
		{{- else }}
	// FLOW_NOT_IMPLEMENTED: unsupported flow actions in this method, fallback stub.
	if os.Getenv("APP_ENV") != "production" {
		panic("{{ .Service.Name }}.{{ .Method.Name }}: flow not implemented; set flowFirstBypass or implement flow")
	}
	{{- if .Method.IsStreaming }}
	return errors.New(http.StatusInternalServerError, "Not Implemented", "{{ .Service.Name }}.{{ .Method.Name }} not implemented")
	{{- else }}
	return resp, errors.New(http.StatusInternalServerError, "Not Implemented", "{{ .Service.Name }}.{{ .Method.Name }} not implemented")
	{{- end }}
		{{- end }}
	{{- else }}
	if os.Getenv("APP_ENV") != "production" {
		panic("{{ .Service.Name }}.{{ .Method.Name }}: no flow or impl; set flowFirstBypass or implement")
	}
	{{- if .Method.IsStreaming }}
	return errors.New(http.StatusInternalServerError, "Not Implemented", "{{ .Service.Name }}.{{ .Method.Name }} not implemented")
	{{- else }}
	return resp, errors.New(http.StatusInternalServerError, "Not Implemented", "{{ .Service.Name }}.{{ .Method.Name }} not implemented")
	{{- end }}
	{{- end }}
}
{{- end }}
