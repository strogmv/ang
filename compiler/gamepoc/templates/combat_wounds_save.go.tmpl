func cloneWoundSave(s wounds.Save) wounds.Save {
	s.Bodies = append([]wounds.Body(nil), s.Bodies...)
	for i := range s.Bodies {
		s.Bodies[i] = s.Bodies[i].Clone()
	}
	if s.Ledger.Kills != nil {
		m := map[string][]string{}
		for id, k := range s.Ledger.Kills {
			m[id] = append([]string(nil), k...)
		}
		s.Ledger.Kills = m
	}
	return s
}
func (r *Runtime) validateWounds(s state) error {
	data, err := json.Marshal(s.Wounds)
	if err != nil {
		return err
	}
	validated, err := combatWounds.Load(data)
	if err != nil {
		return err
	}
	bodies := map[string]wounds.Body{}
	for _, b := range validated.Bodies {
		bodies[b.ID] = b
	}
	check := func(c behavior.Combatant) error {
		var b wounds.Body
		if err := strictWoundJSON(c.Body, &b); err != nil {
			return err
		}
		if b.ID != c.ID {
			return fmt.Errorf("wound body identity mismatch")
		}
		if err := combatWounds.ValidateBody(b); err != nil {
			return err
		}
		canonical, ok := bodies[c.ID]
		if !ok || !reflect.DeepEqual(canonical, b) {
			return fmt.Errorf("wound/roster mismatch for %s", c.ID)
		}
		projected := cloneCombatant(c)
		projectWoundBody(&projected, b)
		if c.HP != projected.HP || c.MaxHP != projected.MaxHP || c.BodyState != projected.BodyState || c.BodyAPPenalty != projected.BodyAPPenalty || c.BodyMoveScale!=projected.BodyMoveScale || c.HeadWound!=projected.HeadWound || c.ArmWound!=projected.ArmWound || c.LegWound!=projected.LegWound || c.BodyCanWalk != projected.BodyCanWalk || c.BodyCanStand != projected.BodyCanStand || c.BodyCanHold != projected.BodyCanHold || c.Bleeding != projected.Bleeding || c.StunTurns != projected.StunTurns || c.SeriousWound != projected.SeriousWound {
			return fmt.Errorf("forged wound status for %s", c.ID)
		}
		if c.Aid != nil {
			w := c.Aid
			if w.By != c.ID || w.RemainingS < 1 || w.RemainingS > w.TotalS || w.TotalS < 1 || w.TotalS > 600 {
				return fmt.Errorf("invalid field aid progress")
			}
			kind, ok := combatWounds.Aid.Kinds[w.Kind]
			if !ok || int(kind.Seconds) != w.TotalS {
				return fmt.Errorf("invalid field aid kind")
			}
			found := false
			for _, x := range b.Wounds {
				found = found || x.ID == w.Wound
			}
			if !found {
				return fmt.Errorf("aid targets unknown wound")
			}
		}
		return nil
	}
	for id, c := range s.CombatRoster {
		if id != c.ID {
			return fmt.Errorf("wound roster identity mismatch")
		}
		if err := check(c); err != nil {
			return err
		}
	}
	if len(bodies) != len(s.CombatRoster) {
		return fmt.Errorf("orphan wound body")
	}
	if s.Combat.Active {
		for _, c := range s.Combat.Actors {
			if err := check(c); err != nil {
				return err
			}
		}
	}
	for author, kills := range s.Wounds.Ledger.Kills {
		seen := map[string]bool{}
		for _, id := range kills {
			b, ok := bodies[id]
			if !ok || !b.Dead || b.Culprit != author || author == id || seen[id] {
				return fmt.Errorf("forged kill ledger")
			}
			seen[id] = true
		}
	}
	return nil
}
func (r *Runtime) migrateWoundState(s *state) error {
	s.Wounds = wounds.Save{Version: 1}
	ids := make([]string, 0, len(s.CombatRoster))
	for id := range s.CombatRoster {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		c := s.CombatRoster[id]
		if c.MaxHP < 1 || c.HP < 0 || c.HP > c.MaxHP {
			return fmt.Errorf("invalid legacy HP")
		}
		c.BodyRisk = r.world.CombatRuntime.WeaponRisk[c.Weapon.ID]
		if c.BodyRisk < 1 {
			c.BodyRisk = r.world.CombatRuntime.WeaponRisk["unarmed"]
		}
		b := combatWounds.NewBody(id, r.bodyChip(id))
		b.LostUL = b.VolumeUL * int64(c.MaxHP-c.HP) * 400 / int64(c.MaxHP) / 1000
		b.Down = c.HP == 0
		part := "torso"
		if c.LegWound > 0 {
			part = "legs"
		} else if c.ArmWound > 0 {
			part = "arms"
		} else if c.HeadWound > 0 {
			part = "head"
		}
		// Old saves recorded a body part, not a channel. Pick its first compatible
		// venous zone deterministically; never roll a new artery, organ or author.
		if c.Bleeding > 0 {
			zone, sid := "neck", "jugular"
			for _, z := range combatWounds.Zones {
				if z.Part == part {
					for _, st := range z.Structures {
						if st.Kind == "vein" || st.Kind == "deep_vein" {
							zone, sid = z.ID, st.ID
							break
						}
					}
				}
			}
			b.Seq++
			b.Wounds = append(b.Wounds, wounds.Wound{ID: fmt.Sprintf("w%d", b.Seq), Zone: zone, Depth: "shallow", Mechanism: "cut", Structures: []string{sid}, HealAt: 604800, Bleeds: []wounds.Bleed{{Structure: sid, Kind: "vein", RateUL: max(1, b.VolumeUL*400*int64(c.Bleeding)/int64(c.MaxHP)/1000/6)}}})
		}
		for _, p := range []struct {
			zone, structure string
			amount          int
		}{{"head", "scalp", c.HeadWound}, {"arm", "arm_muscle", c.ArmWound}, {"thigh", "thigh_muscle", c.LegWound}} {
			if p.amount > 0 {
				b.Seq++
				b.Wounds = append(b.Wounds, wounds.Wound{ID: fmt.Sprintf("w%d", b.Seq), Zone: p.zone, Depth: "shallow", Mechanism: "blunt", Structures: []string{p.structure}, HealAt: 86400})
			}
		}
		b.StunUntil = int64(c.StunTurns) * 6
		projectWoundBody(&c, b)
		s.CombatRoster[id] = c
		s.Wounds.Bodies = append(s.Wounds.Bodies, b.Clone())
	}
	for i, c := range s.Combat.Actors {
		if v, ok := s.CombatRoster[c.ID]; ok {
			projectWoundBody(&c, combatBody(v))
			s.Combat.Actors[i] = c
		} else {
			return fmt.Errorf("legacy encounter body absent from roster")
		}
	}
	return nil
}
