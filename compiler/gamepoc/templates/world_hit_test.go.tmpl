// worldHitFixture: the real world, the fire of the first turret post as the source (its fire profile and aim).
func worldHitFixture(t *testing.T) (*Runtime, worldHit) {
	t.Helper()
	r := lifeRuntimeFixture(t)
	if r.world.TurretWatch == nil || len(r.world.TurretWatch.Posts) == 0 || r.world.TurretWatch.Rule.Fire == nil {
		t.Skip("content has no world source with a fire profile")
	}
	fire := r.world.TurretWatch.Rule.Fire
	hero := r.state.Life.Actor(playerActorID)
	return r, worldHit{Source: r.world.TurretWatch.Posts[0].ID, Fire: fire.WorldSource, Target: fire.Target, From: behavior.Cell{X: hero.Position.X + 6, Y: hero.Position.Y}, Seed: 41}
}

// worldHitBleed: the Life clock runs on (the ordinary after-care of a body, advanceWoundCare) until the body is dead.
func worldHitBleed(t *testing.T, r *Runtime, id string, seconds int64) {
	t.Helper()
	for step := int64(0); step < seconds && !r.woundBodyDead(id); step += r.state.Life.SecondsPerTick {
		r.state.Tick++
		r.state.Life.Tick = r.state.Tick
		r.state.Life.Seconds += r.state.Life.SecondsPerTick
		if err := r.advanceWoundCare(); err != nil {
			t.Fatal(err)
		}
	}
}

// One blow outside a fight: a wound of the source's profile in the wound model, on the body the roster keeps (stored
// for the save, its care clock from now); the same blow on a twin world gives the same body; inside an encounter refused.
func TestWorldHitOutsideCombatGoesThroughTheWoundRules(t *testing.T) {
	r, h := worldHitFixture(t)
	if r.state.Combat.Active {
		t.Fatal("the fixture runs a fight")
	}
	result, err := r.applyWorldHit(playerActorID, h)
	if err != nil {
		t.Fatal(err)
	}
	c, ok := r.state.CombatRoster[playerActorID]
	if !ok || len(c.Body) == 0 {
		t.Fatal("the hit body is not in the roster")
	}
	body := combatBody(c)
	source := r.world.CombatRuntime.WorldSources[h.Fire]
	if result.Wound == nil && !result.Blocked {
		t.Fatalf("a hit without a wound or armour: %+v", result)
	}
	if result.Wound != nil {
		w := body.Wounds[len(body.Wounds)-1]
		if w.Author != h.Source || w.Weapon != source.Weapon {
			t.Fatalf("the wound is not the source's: %+v", w)
		}
	}
	if _, clock := r.state.CombatCare.Clocks[playerActorID]; !clock {
		t.Fatal("the hit body has no care clock: it would never bleed")
	}
	stored := false
	for _, b := range r.state.Wounds.Bodies {
		stored = stored || (b.ID == playerActorID && reflect.DeepEqual(b, body))
	}
	if !stored {
		t.Fatal("the hit body is not stored for the save")
	}
	if err := r.validateWounds(r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	twin, _ := worldHitFixture(t)
	if _, err := twin.applyWorldHit(playerActorID, h); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(combatBody(twin.state.CombatRoster[playerActorID]), body) {
		t.Fatal("the same blow on the same world gave another wound")
	}
	// Inside an encounter the fight owns the body: no world hit.
	fight := r.snapshotState()
	r.state.Combat.Active = true
	r.state.Combat.Actors = append(r.state.Combat.Actors, behavior.Combatant{ID: playerActorID})
	if _, err := r.applyWorldHit(playerActorID, h); err == nil {
		t.Fatal("a world hit went through on a body inside an encounter")
	}
	r.state = fight
}

// Blows until the body dies the ordinary way of the wounds: the death is the wound model's (dead, a culprit, the ledger),
// the dead hero lies held down and gives no more orders, a dead body takes no more blows. A lawful source (a turret post
// of a zone that fires) opens no killing case; any other source's killing opens one, as after a fight.
func TestWorldHitKillsTheOrdinaryWay(t *testing.T) {
	for _, lawful := range []bool{true, false} {
		r, h := worldHitFixture(t)
		if !lawful {
			h.Source = "world.test_falling_load"
		}
		if r.lawfulWorldSource(h.Source) != lawful {
			t.Fatalf("source %s lawful %v", h.Source, !lawful)
		}
		cases := len(r.state.Crafting.Law.Cases)
		for shot := 0; shot < 60 && !r.woundBodyDead(playerActorID); shot++ {
			h.Seed++
			if _, err := r.applyWorldHit(playerActorID, h); err != nil {
				t.Fatal(err)
			}
			worldHitBleed(t, r, playerActorID, 60)
		}
		worldHitBleed(t, r, playerActorID, 7*86400)
		body := combatBody(r.state.CombatRoster[playerActorID])
		if !body.Dead || body.Culprit != h.Source {
			t.Fatalf("lawful %v: the hero did not die by the wounds of the source: dead %v culprit %q", lawful, body.Dead, body.Culprit)
		}
		killed := false
		for _, id := range r.state.Wounds.Ledger.Kills[h.Source] {
			killed = killed || id == playerActorID
		}
		if !killed {
			t.Fatalf("lawful %v: the ledger has no kill of the source", lawful)
		}
		_, act := r.world.Crafting.Act("killing")
		switch {
		case lawful && len(r.state.Crafting.Law.Cases) != cases:
			t.Fatal("a killing case against a lawful world source")
		case !lawful && act && len(r.state.Crafting.Law.Cases) != cases+1:
			t.Fatal("the killing of an ordinary source opened no case")
		}
		hero := r.state.Life.Actor(playerActorID)
		if !hero.CombatHold || hero.Activity != "down" {
			t.Fatalf("the dead hero is not held down: %v %q", hero.CombatHold, hero.Activity)
		}
		c := &connection{out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{}), delivery: pb.NewViewProjector(&pb.ViewSubscription{StaticOnChange: true})}
		r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 1, X: int32(hero.Position.X + 2), Y: int32(hero.Position.Y)})
		if m := (<-c.out).GetMoveResult(); m == nil || m.Ok || m.Reason != "actor_inactive" {
			t.Fatalf("the dead hero still walks: %+v", m)
		}
		wounds := len(body.Wounds)
		if result, err := r.applyWorldHit(playerActorID, h); err != nil || result.Wound != nil || len(combatBody(r.state.CombatRoster[playerActorID]).Wounds) != wounds {
			t.Fatalf("a dead body took another blow: %+v %v", result, err)
		}
		r.syncLifeHero()
		slot := r.world.Config.SaveSlots[0]
		if err := r.writeSave(slot, r.snapshotState()); err != nil {
			t.Fatal(err)
		}
		loaded, _, err := r.readSave(slot)
		if err != nil {
			t.Fatal(err)
		}
		if !combatBody(loaded.CombatRoster[playerActorID]).Dead {
			t.Fatal("the save lost the death")
		}
	}
}
