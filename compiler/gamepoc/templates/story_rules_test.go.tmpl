    r.advanceStoryRules()
    due := int64(86400 + 8*3600)
    if r.story.next != due { t.Fatalf("idle wake %d, want %d", r.story.next, due) }
    if r.storyGatheringTargets() != nil || r.story.meetingNext != math.MaxInt64 {
        t.Fatal("an inactive gathering is polling")
    }
    for range 1200 {
        r.state.Life.Seconds++
        r.advanceStoryRules()
        if r.storyGatheringTargets() != nil || r.story.next != due || r.story.dirty {
            t.Fatal("idle schedule changed before any event or deadline")
        }
    }
    r.memoryWrite("fact.varya.box_refused", nil, talkCtx{self:varyaNPC})
    if !r.story.dirty { t.Fatal("a fact did not wake the schedule") }
    r.advanceStoryRules()
    if r.story.next != 86400 { t.Fatalf("box's midnight wake %d", r.story.next) }
}
