func TestAudibleReportContainsObservedPositionRatherThanLiveTarget(t *testing.T){
 r:=demoFixture(t);r.state.Tick=20;a:=r.sceneActor("demo.guard.3");at:=point{3,4}
 a.Memory.Record(behavior.Fact{Subject:r.missionSubject(),Kind:"incident",Source:"sight",Value:true,Position:cell(at),ObservedTick:15},r.world.AI.Policy.Memory)
 record:=alarmRecord{Tick:20,ActorID:a.ID,Kind:"shout",At:a.Position};r.reportPayload(a,&record);r.state.Demo.AlarmLog=[]alarmRecord{record};r.state.Player=point{16,7}
 listener:=r.sceneActor(r.world.Config.CaptureDemo.Monitoring.Operator);r.hearReport(listener,behavior.Sound{Kind:"shout",SourceID:a.ID,Tick:20})
 f,k:=listener.Memory.Lookup(r.missionSubject(),"incident");if k!=behavior.KnowledgeTrue||f.Position!=cell(at)||f.ObservedTick!=15{t.Fatalf("report leaked live position or changed observation time: %+v",f)}
