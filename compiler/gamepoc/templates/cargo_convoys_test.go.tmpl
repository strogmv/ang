  if c.Run!=""{leg:=run.Legs[c.Leg];name:=leg.Kind+"/"+c.Phase;if len(seenLegs)==0||seenLegs[len(seenLegs)-1]!=name{seenLegs=append(seenLegs,name)}}
  if r.state.Tick%20==0{if err:=r.state.Life.Validate(r.world.Life,r.state.Tick);err!=nil{t.Fatalf("invalid Life state at %v: %v",seenLegs[len(seenLegs)-1],err)}}
  if got:=cargoTotals(r);!brain&&!reflect.DeepEqual(got,totals){t.Fatalf("goods appeared or vanished at %v: %v -> %v",seenLegs,totals,got)}else if brain{gone:=int64(0);for d,n:=range got{if n>totals[d]{t.Fatalf("%s appeared: %d -> %d",d,totals[d],n)};gone+=totals[d]-n};if gone>r.state.NPCEconomy.Purchases-purchases{t.Fatalf("%d units vanished, people bought %d",gone,r.state.NPCEconomy.Purchases-purchases)}}
  for _,m:=range v.Crew{a:=r.state.Life.Actor(m.ID);if a.Trip!=nil{if edges[m.ID]==nil{edges[m.ID]=map[string]bool{}};edges[m.ID][a.Trip.Edge]=true}}
  for _,lot:=range r.world.CargoConvoys.Lots{tr:=track[lot.Shop];inTrailer:=int64(0);for _,s:=range lot.TrailerStores{inTrailer+=r.cargoStock(s,lot.Owner,"")}
   if tr.Loaded==0&&inTrailer>0{tr.Loaded,tr.Units=r.state.Life.Seconds,inTrailer}
   if sh:=r.cargoLotShop(lot);sh!=nil&&tr.Landed>0&&tr.Opened==0&&r.storefrontOpen(sh.ID){tr.Opened=r.state.Life.Seconds}
   if tr.Loaded>0&&tr.Landed==0&&inTrailer==0{tr.Landed=r.state.Life.Seconds;tr.Cycle=r.state.Inventory.Deliveries[lot.Delivery].Cycle}
   if tr.Landed>0&&tr.Stocked==0{
    if lot.Kind=="delivery"{if p:=r.state.Inventory.Deliveries[lot.Delivery];p.Cycle>tr.Cycle&&p.Phase==""{tr.Stocked=r.state.Life.Seconds}}else if r.cargoStock(lot.LockerStore,lot.Owner,"")<tr.Units||r.state.Visitors.Supplied[lot.Shop]==morning/86400+1{tr.Stocked=r.state.Life.Seconds}}
  }
  if g,ok:=r.state.Life.Gates["gate.freight"];ok&&gateByPass<0&&g.Passable()&&g.PermitVehicle==v.ID&&r.state.Life.Seconds%86400<6*3600{gateByPass=r.state.Life.Seconds}
  for _,k:=range r.state.CargoConvoys.Cranes{hooked=hooked||k.Hook!=""}
  // riding the deck in sight of a landing, the seated crew is drawn on its seats there (not empty seats)
