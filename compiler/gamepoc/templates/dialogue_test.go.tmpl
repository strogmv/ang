			t.Fatalf("seed %d: the same world rolled differently", seed)
		}
		talk := a.Memory.Talks[custodyKey(runs[0])]
		success := talk.Checks[o.ID].Success
		outcomes[success]++
		want, reply := c.Outcome, o.Reply
