// drainDisk does what the storage goroutine does with every queued job (saves, then the lists they queue) and completes
// each on the world's goroutine.
func drainDisk(r *Runtime) {
	for len(r.jobs) > 0 {
		r.diskComplete(r.storageRuntime().diskWork(<-r.jobs))
	}
}

// answer: the action result to a request among what the client got; the other messages are dropped.
func answer(t *testing.T, c *connection, id string) *pb.PocActionResult {
	t.Helper()
	for len(c.out) > 0 {
		if a := (<-c.out).GetActionResult(); a != nil && a.RequestId == id {
			return a
		}
	}
	t.Fatalf("no answer to %s", id)
	return nil
}

