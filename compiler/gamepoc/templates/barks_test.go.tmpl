// barkRun advances the clocks and the barks alone (the people stay where the test put them).
func barkRun(r *Runtime, ticks int) []barks.Speech {
	var out []barks.Speech
	for i := 0; i < ticks; i++ {
		r.state.Tick++
		r.state.Life.Tick = r.state.Tick
		r.state.Life.Seconds++
		if f, ok := r.barkFrame(); ok {
			out = append(out, barkCatalog.Step(&r.state.Barks, f)...)
		}
	}
	return out
}

func TestBarksYataiEveningAndAnswer(t *testing.T) {
	r := barksFixture(t)
	barkYataiEvening(t, r)
	said := barkRun(r, 4000)
	lines, answered := 0, false
	for _, sp := range said {
		switch sp.Kind {
		case "line":
			if !strings.HasPrefix(sp.Line, "bark.yatai.") || sp.Place != barkYatai {
				t.Fatalf("a line of another place at the yatai: %+v", sp)
			}
			lines++
		case "reply", "gesture":
			if sp.Speaker != "char.market_yatai_owner" {
				t.Fatalf("the answer is not the owner's: %+v", sp)
			}
			answered = true
		}
	}
	if lines == 0 || !answered {
		t.Fatalf("the evening yatai: %d lines, answered %v (%+v)", lines, answered, said)
	}
	// the client view: the localized text and the face of the speaker's caste
	c := &connection{locale: "ru", out: make(chan *pb.ServerMessage, 8), stop: make(chan struct{})}
	r.state.Barks.Active = nil
	r.state.Barks.Packs = nil
	r.state.Barks.Lines = nil
	var shown *pb.PocBark
	for i := 0; i < 4000 && shown == nil; i++ {
		started := barkRun(r, 1)
		if len(started) == 0 || started[0].Kind != "line" {
			continue
		}
		r.sendLifeState(c)
		for _, b := range (<-c.out).GetGameState().GetLife().GetBarks() {
			if b.Kind == "line" {
				shown = b
			}
		}
	}
	if shown == nil || shown.Text == "" || shown.Text == shown.LineKey || shown.Face != "stencil" || shown.Reveal != "stamped" || shown.UntilNs <= shown.StartedNs {
		t.Fatalf("the yatai line reached the client wrong: %+v", shown)
	}
}

