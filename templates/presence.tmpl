package presence

import (
	"context"
	"sync"
	"time"

	"github.com/redis/go-redis/v9"
)

// Status represents user online/offline status.
type Status struct {
	IsOnline   bool
	LastSeenAt string
}

const presenceKeyPrefix = "presence:"

// memoryEntry keeps the wall-clock time of the last heartbeat so the
// in-memory fallback expires entries exactly like the Redis keys do.
type memoryEntry struct {
	status Status
	at     time.Time
}

var (
	mu          sync.RWMutex
	store       = map[string]memoryEntry{}
	redisClient *redis.Client
	ttl         = 60 * time.Second
)

// memoryGet returns a stored entry unless its heartbeat is older than the TTL.
func memoryGet(userID string, now time.Time) (Status, bool) {
	entry, ok := store[userID]
	if !ok || now.Sub(entry.at) > ttl {
		return Status{}, false
	}
	return entry.status, true
}

// SetRedisClient enables Redis-backed presence storage.
func SetRedisClient(client *redis.Client) {
	redisClient = client
}

// SetTTL configures the TTL for online presence keys.
func SetTTL(d time.Duration) {
	if d > 0 {
		ttl = d
	}
}

// Set updates the presence for a user and returns the stored status.
func Set(userID string, isOnline bool, at time.Time) Status {
	if redisClient != nil {
		ctx := context.Background()
		key := presenceKeyPrefix + userID
		if !isOnline {
			_ = redisClient.Del(ctx, key).Err()
			return Status{IsOnline: false, LastSeenAt: ""}
		}
		ts := at.UTC().Format(time.RFC3339)
		_ = redisClient.Set(ctx, key, ts, ttl).Err()
		return Status{IsOnline: true, LastSeenAt: ts}
	}

	mu.Lock()
	defer mu.Unlock()
	if !isOnline {
		delete(store, userID)
		return Status{IsOnline: false, LastSeenAt: ""}
	}
	status := Status{
		IsOnline:   true,
		LastSeenAt: at.UTC().Format(time.RFC3339),
	}
	store[userID] = memoryEntry{status: status, at: time.Now()}
	return status
}

// Get returns the stored status for a user.
func Get(userID string) (Status, bool) {
	if redisClient != nil {
		ctx := context.Background()
		val, err := redisClient.Get(ctx, presenceKeyPrefix+userID).Result()
		if err != nil {
			return Status{}, false
		}
		return Status{IsOnline: true, LastSeenAt: val}, true
	}

	mu.RLock()
	defer mu.RUnlock()
	return memoryGet(userID, time.Now())
}

// GetMany returns a map of statuses for the provided user IDs.
func GetMany(userIDs []string) map[string]Status {
	if redisClient != nil {
		ctx := context.Background()
		keys := make([]string, 0, len(userIDs))
		for _, id := range userIDs {
			keys = append(keys, presenceKeyPrefix+id)
		}
		out := make(map[string]Status, len(userIDs))
		if len(keys) == 0 {
			return out
		}
		values, err := redisClient.MGet(ctx, keys...).Result()
		if err != nil {
			return out
		}
		for i, v := range values {
			if v == nil {
				continue
			}
			str, ok := v.(string)
			if !ok || str == "" {
				continue
			}
			out[userIDs[i]] = Status{IsOnline: true, LastSeenAt: str}
		}
		return out
	}

	mu.RLock()
	defer mu.RUnlock()
	now := time.Now()
	out := make(map[string]Status, len(userIDs))
	for _, id := range userIDs {
		if status, ok := memoryGet(id, now); ok {
			out[id] = status
		}
	}
	return out
}
