   if(state.Life.Transit){HudFrame(new Rect(330,330,620,90),false);GUI.Label(new Rect(348,346,584,56),LifeTravelLabel(),hudWrap);}
   DrawPaintedKnownDetails(scene,fit,scale,view);return true;
  }
 }
