    prop.go.transform.SetPositionAndRotation(hand.position+hand.rotation*localGrip,hand.rotation*localProp);
    if(!beat.parried&&phase>=beat.impact&&phase<beat.impact+.08f&&beat.fxDone&&!beat.propDone){beat.propDone=true;Debug.Log("V4_CONTACT actor="+h.id+" target="+beat.target+" part="+beat.part+" gap_m="+Vector3.Distance(tip.position,contact).ToString("F4",System.Globalization.CultureInfo.InvariantCulture)+" skin_gap_m="+CombatSkinGap(victim,tip.position).ToString("F4",System.Globalization.CultureInfo.InvariantCulture)+" built="+rig.built+" wrist_gap="+Vector3.Distance(hand.position,rig.target.position)+" shoulder_goal="+Vector3.Distance(rig.arm.data.root.position,rig.target.position)+" arm_length="+(Vector3.Distance(rig.arm.data.root.position,rig.arm.data.mid.position)+Vector3.Distance(rig.arm.data.mid.position,hand.position)));CombatAutoShot("knife-contact-v4");}
   }
   if(beat!=null&&beat.kind=="attack"&&beat.parried){
    var a=CombatHumanoid(beat.actor);var d=CombatHumanoid(beat.target);CombatProp ap,dp;
    if(a!=null&&d!=null&&combatProps.TryGetValue(beat.actor,out ap)&&combatProps.TryGetValue(beat.target,out dp)&&ap.go!=null&&dp.go!=null){
     var hand=d.animator.GetBoneTransform(HumanBodyBones.RightHand);var tip=Array.Find(dp.go.GetComponentsInChildren<Transform>(),x=>x.name=="contact_tip");var atip=Array.Find(ap.go.GetComponentsInChildren<Transform>(),x=>x.name=="contact_tip");
