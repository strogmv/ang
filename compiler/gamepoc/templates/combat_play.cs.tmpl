     if(t<k){clip=look.bandage_kneel;clipTime=t/k;}else if(t<beat.seconds-r){clip=look.bandage;clipTime=-1;}else{clip=look.bandage_rise;clipTime=(t-(beat.seconds-r))/r;}}
