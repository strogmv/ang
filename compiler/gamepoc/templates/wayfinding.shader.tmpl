Shader "ANG/WayfindingFloor" {
 Properties {_Color ("Presentation tint",Color)=(1,1,1,1) _ZTest ("Depth",Float)=8 _SrcBlend ("Source",Float)=1 _DstBlend ("Destination",Float)=0}
 SubShader { Tags {"Queue"="Transparent-10" "RenderPipeline"="UniversalPipeline"} Pass {
  Tags {"LightMode"="UniversalForward"}
  Cull Off ZWrite Off ZTest [_ZTest] Blend [_SrcBlend] [_DstBlend]
  HLSLPROGRAM
  #pragma vertex vert
  #pragma fragment frag
  #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
  struct appdata {float4 vertex:POSITION;half4 color:COLOR;float2 route:TEXCOORD0;};
  struct v2f {float4 vertex:SV_POSITION;half4 color:COLOR;float2 route:TEXCOORD0;};
  CBUFFER_START(UnityPerMaterial)
  half4 _Color;float4 _RouteProgress;
  CBUFFER_END
  // Also used by DrawMeshNow after GL.LoadPixelMatrix: retain Unity's object/VP matrices.
  v2f vert(appdata v){v2f o;o.vertex=TransformObjectToHClip(v.vertex.xyz);o.color=v.color;o.route=v.route;return o;}
  half4 frag(v2f i):SV_Target{
   half4 color=i.color;
   if(i.route.y>.5){
    // Arc coordinates belong to the exact painted mesh. No clock, A* chord,
    // screen-space connector, or animated UV can move this light off its paint.
    clip(i.route.x-_RouteProgress.x+.0001);
    float filled=1-smoothstep(_RouteProgress.y-.10,_RouteProgress.y+.10,i.route.x);
    float head=_RouteProgress.w*smoothstep(_RouteProgress.y-.18,_RouteProgress.y+.06,i.route.x)*(1-smoothstep(_RouteProgress.y+_RouteProgress.z*.65,_RouteProgress.y+_RouteProgress.z,i.route.x));
    color.rgb=lerp(color.rgb,half3(.94,.93,.84),.20+.20*filled+.25*head);
    color.a=.86+.10*filled+.04*head;
   }
   return color*_Color;
  }
  ENDHLSL
 } }
}
