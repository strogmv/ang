  // ---------------------------------------------------------------- the book page
  List<CraftingRow> CraftingRows(PocCraftingView v) {
   var rows = new List<CraftingRow>();
   Color ok = new Color(.62f, .78f, .52f), wait = new Color(.86f, .74f, .45f), off = new Color(.5f, .52f, .5f);
   if (craftingTab == "book") {
    foreach (var r in v.Book) rows.Add(new CraftingRow { recipe = r, title = r.Name, sub = r.Discipline + " · " + r.Tier.ToString(CultureInfo.InvariantCulture) + (r.Flawed ? " · " + L("ui.crafting.flawed") : ""), tint = r.CanStart ? ok : r.Unlocked ? wait : off, tag = r.Flawed ? "!" : r.CanStart ? "●" : r.Unlocked ? "○" : "·" });
   } else if (craftingTab == "things") {
    foreach (var t in v.Things) foreach (var a in t.Actions) rows.Add(new CraftingRow { thing = t, recipe = a, title = t.Name, sub = a.Name + " · " + (t.ConditionPpm / 10000).ToString(CultureInfo.InvariantCulture) + "%", tint = a.CanStart ? ok : a.Unlocked ? wait : off, tag = t.Heirloom ? "♦" : "·" });
   } else if (craftingTab == "jobs") {
    foreach (var j in v.Jobs) rows.Add(new CraftingRow { job = j, title = j.Name, sub = j.Worker + " · " + j.State, tint = j.Ready ? ok : wait, tag = j.Order ? "◆" : "●" });
   } else if (craftingTab == "learn") {
    foreach (var o in v.Options) rows.Add(new CraftingRow { option = o, title = o.Title, sub = string.IsNullOrEmpty(o.Sub) ? o.Reason : o.Sub, tint = !string.IsNullOrEmpty(o.Warning) && o.Enabled ? new Color(.92f, .55f, .42f) : o.Enabled ? ok : off, tag = o.Action == "rebind" || o.Action == "steal" ? "◇" : "◆" });
   } else if (v.Counter != null) {
    foreach (var r in v.Counter.Offers) rows.Add(new CraftingRow { recipe = r, title = r.Name, sub = string.IsNullOrEmpty(r.Price) ? r.Reason : r.Price, tint = r.CanStart ? ok : off, tag = "◆" });
   }
   return rows;
  }
  string CraftingPrimaryLabel(CraftingRow row) {
   if (row.option != null) return row.option.Label;
   if (row.job != null) return row.job.CanCollect ? L("ui.crafting.collect") : row.job.CanCancel ? L(row.job.Order ? "ui.crafting.cancel_order" : "ui.crafting.cancel") : "";
   if (row.recipe == null) return "";
   if (craftingTab == "order") return L("ui.crafting.order");
   switch (row.recipe.Kind) { case "bypass": return L("ui.crafting.bypass"); case "repair": return L("ui.crafting.repair"); case "maintain": return L("ui.crafting.maintain"); case "disassemble": return L("ui.crafting.disassemble"); default: return L("ui.crafting.craft"); }
  }
  bool CraftingPrimaryEnabled(CraftingRow row) {
   if (row.option != null) return row.option.Enabled;
   if (row.job != null) return row.job.CanCollect || row.job.CanCancel;
   var v = CraftingView();
   return row.recipe != null && row.recipe.CanStart && v != null && (craftingTab == "order" || !v.Busy);
  }
  void CraftingPrimary(CraftingRow row) {
   if (!CraftingPrimaryEnabled(row)) return;
   if (row.option != null) { CraftingSend(row.option.Action, row.option.Recipe, row.option.ItemId, "", row.option.Target); return; }
   if (row.job != null) { CraftingSend(row.job.CanCollect ? "collect" : "cancel", "", "", row.job.Id); return; }
   CraftingSend(craftingTab == "order" ? "order" : "start", row.recipe.Id, row.recipe.ItemId, "");
  }
