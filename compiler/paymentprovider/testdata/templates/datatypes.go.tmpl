func macanAPIErrorsMessage(errs []macanAPIError) string {
	if len(errs) == 0 {
		return model.SCodeDeclinedByBank.Description()
	}
	var b strings.Builder
	for i, e := range errs {
		if i > 0 {
			b.WriteString("; ")
		}
		if e.Type != "" {
			b.WriteString(e.Type)
			b.WriteString(": ")
		}
		b.WriteString(e.Message)
	}
	return b.String()
}

