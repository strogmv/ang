   if a.WaitingDeparture==0||a.WaitingDeparture<s.Seconds{a.WaitingDeparture=s.Seconds;if edge.PeriodSeconds>0{a.WaitingDeparture=((s.Seconds+edge.PeriodSeconds-1)/edge.PeriodSeconds)*edge.PeriodSeconds}}
