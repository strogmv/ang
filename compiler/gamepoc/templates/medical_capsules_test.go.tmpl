func TestMedicalAdmissionForecastRejectsImminentCollapse(t *testing.T) {
	r := medicalFixture(t)
	medicalInjure(t, r, playerActorID, true)
	c := r.state.CombatRoster[playerActorID]
	b := combatBody(c)
	if _, err := combatWounds.ApplyCondition(&b, "poison.ration", "", r.state.Seed); err != nil {
		t.Fatal(err)
	}
	doom := int64(0)
	for _, condition := range b.Conditions {
		if condition.ID == "poison.ration" {
			doom = condition.DoomAt
		}
	}
	if doom <= 10 {
		t.Fatal("missing canonical poison deadline")
	}
	combatWounds.Tick(&b, doom-b.Clock-10)
	if !combatWounds.Status(b).CanWalk {
		t.Fatal("fixture already cannot walk")
	}
	projectWoundBody(&c, b)
	r.state.CombatRoster[playerActorID] = c
	r.storeWoundBody(c)
	u := r.world.MedicalCapsules.Units[0]
	if err := r.medicalRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	r.advanceMedicalCapsules()
	medicalAdvance(t, r, r.world.MedicalCapsules.ScanSeconds)
	p := r.state.Medical.Patients[playerActorID]
	before := r.state.Inventory.Clone()
	if err := r.medicalAccept(playerActorID, u.ID, p.OfferID); err == nil {
		t.Fatal("admitted patient who cannot complete physical entry")
	}
	if r.medicalAttached(playerActorID) || !reflect.DeepEqual(before.Accounts, r.state.Inventory.Accounts) {
		t.Fatal("failed admission moved patient or money")
	}
}
