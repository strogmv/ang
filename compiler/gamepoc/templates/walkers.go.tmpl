// visitorGiveWay: he clears the way of somebody who walks `way` (nil: unknown): a free cell off that way, else a free cell
// farther from `from` (back along a narrow passage).
func (r *Runtime) visitorGiveWay(b *visitorBody, w *walkersPass, way []behavior.Cell, from behavior.Cell) bool {
	on := func(c behavior.Cell) bool {
		for _, a := range way {
			if a == c {
				return true
			}
		}
		return c == from
	}
	sides := r.walkerSides(b, way)
	for _, c := range sides {
		if !on(c) && r.walkerOpen(w, c, b.Serial) {
			r.visitorStepTo(b, w, c)
			return true
		}
	}
	far := absInt(b.At.X-from.X) + absInt(b.At.Y-from.Y)
	for _, c := range sides {
		if absInt(c.X-from.X)+absInt(c.Y-from.Y) > far && r.walkerOpen(w, c, b.Serial) {
			r.visitorStepTo(b, w, c)
			return true
		}
	}
	return false
}

