// Code generated by ANG. Tactical geometry uses real deck positions and heights.
package behavior

import (
	"math"
	"testing"
)

func combatVolumeFixture(t *testing.T, top int) *DeckVolume {
	t.Helper()
	v := &DeckVolume{Schema: "ang.multideck.v1", PlanWidth: 6, PlanDepth: 4, NavWidth: 6, NavDepth: 8, EyeMM: 1600, TargetMM: []int{1000, 1700}, SightRangeCells: 20, Surfaces: []DeckSurface{{ID: "ground", Index: 0, Walkable: true, Grounded: true, NavRow: 0, Slab: []DeckRect{{X: 0, Y: 0, W: 6, H: 4}}}, {ID: "upper", Index: 1, ElevationMM: 3000, SlabMM: 100, Walkable: true, NavRow: 4, Slab: []DeckRect{{X: 0, Y: 0, W: 6, H: 4}}}}}
	if top > 0 {
		v.Solids = []DeckSpan{{Rect: DeckRect{X: 2, Y: 1, W: 1, H: 1}, BottomMM: 0, TopMM: top}}
	}
	if err := v.Prepare(); err != nil {
		t.Fatal(err)
	}
	return v
}
func TestCombatDeckProtectionAndBulletBodyRespectHeight(t *testing.T) {
	v := combatVolumeFixture(t, 1340)
	a, b := Cell{1, 1}, Cell{3, 1}
	if math.Abs(v.CombatProtection(a, b)-2.0/3) > 0.001 || !v.CombatShotClear(a, b) {
		t.Fatal("waist protection became complete wall or lost directional coverage")
	}
	if !v.BodyOnCombatShot(a, b, Cell{2, 1}) || v.BodyOnCombatShot(a, b, Cell{2, 5}) {
		t.Fatal("shot ignored body or blocked on a different floor")
	}
	v = combatVolumeFixture(t, 2200)
	if v.CombatShotClear(a, b) || v.CombatSoundBlockers(a, b) == 0 {
		t.Fatal("full-height obstruction ignored")
	}
}
func TestCombatDeckRangeDoesNotUseNavigationBandDistance(t *testing.T) {
	v := combatVolumeFixture(t, 0)
	if got := v.CombatRangeMM(Cell{1, 1}, Cell{1, 5}); got != 3000 {
		t.Fatalf("same plan point on upper floor range %d, want 3000", got)
	}
	if got := v.CombatRangeMM(Cell{1, 1}, Cell{3, 1}); got != 1000 {
		t.Fatalf("two half-metre cells range %d", got)
	}
}
