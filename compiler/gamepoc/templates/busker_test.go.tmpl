}

// The plan of a day is a pure function of the seed and the day; it fits the day's windows: he comes in the arrive window
// (or not at all, on some days), the sets and breaks follow each other from his arrival to his leaving, no break goes over
// its daily count, every set is at least half the shortest set long.
func TestBuskerDayPlanIsDeterministicAndFitsTheDay(t *testing.T) {
	r := buskerWorld(t, 1)
	b := r.world.Busker
	d := b.Day
	absent := 0
	for day := int64(0); day < 120; day++ {
		p := r.buskerPlanOf(day)
		if day < 5 {
			t.Logf("day %d: absent %v, arrive %02d:%02d, leave %02d:%02d, blocks %v", day, p.Absent, p.Arrive/3600, p.Arrive%3600/60, p.Leave/3600, p.Leave%3600/60, p.Blocks)
		}
		r.busker.ready = false
		if q := r.buskerPlanOf(day); q.Absent != p.Absent || q.Arrive != p.Arrive || len(q.Blocks) != len(p.Blocks) {
			t.Fatalf("day %d: the plan is not the same twice", day)
		}
		if p.Absent {
			absent++
			continue
		}
		if p.Arrive < d.Arrive.From || p.Arrive > d.Arrive.To || p.Leave < d.Leave.From || p.Leave > d.Leave.To || p.Depart != p.Arrive-d.LeadSeconds {
			t.Fatalf("day %d: arrive %d leave %d depart %d", day, p.Arrive, p.Leave, p.Depart)
		}
		if len(p.Blocks) == 0 || p.Blocks[0].From != p.Arrive || p.Blocks[len(p.Blocks)-1].To != p.Leave || p.Blocks[0].Kind != "set" || p.Blocks[len(p.Blocks)-1].Kind != "set" {
			t.Fatalf("day %d: blocks %+v", day, p.Blocks)
		}
		used := map[string]int{}
		for i, bl := range p.Blocks {
			if i > 0 && bl.From != p.Blocks[i-1].To {
				t.Fatalf("day %d: a hole before block %d", day, i)
			}
			if bl.Kind == "set" {
				if bl.To-bl.From < d.SetSeconds.Min/2 {
					t.Fatalf("day %d: a set of %d s", day, bl.To-bl.From)
				}
				continue
			}
			used[bl.Kind]++
			br := d.Breaks[bl.Break]
			if br.ID != bl.Kind || used[bl.Kind] > br.MaxPerDay || bl.To-bl.From < br.Seconds.Min || bl.To-bl.From > br.Seconds.Max {
				t.Fatalf("day %d: break %+v (%d today)", day, bl, used[bl.Kind])
			}
		}
	}
	// absent_permille of the days, give or take the draw
	if want := int(d.AbsentPermille) * 120 / 1000; absent < want/3 || absent > want*3 {
		t.Fatalf("absent %d of 120 days (want about %d)", absent, want)
	}
}

// buskerPresentDay: the next day he comes, from now.
func buskerPresentDay(r *Runtime) int64 {
	day := r.state.Life.Seconds / 86400
	for r.buskerPlanOf(day).Absent || r.buskerPlanOf(day).Arrive < r.state.Life.Seconds%86400+3600 && day == r.state.Life.Seconds/86400 {
		day++
	}
	return day
}

