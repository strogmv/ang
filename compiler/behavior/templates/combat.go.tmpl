func (s CombatState) threatAt(space CombatSpace, r CombatRules, a Combatant, at Cell) float64 {
	risk := 0.0
	for _, c := range a.Contacts {
		if c.Checked || c.Source == "hearing" || c.Team == a.Team || c.ThreatDamage < 1 {
			continue
		}
		age := s.Turn - c.ObservedTurn
		certainty := 1 - float64(age)/float64(r.MemoryTurns+1)
		distance := space.rangeMM(c.Position, at)
		if distance > c.ThreatRangeMM || !space.shotClear(c.Position, at) {
			continue
		}
		damage := float64(c.ThreatDamage)
		protection := space.cover(c.Position, at, a.Crouched)
		if a.Prone && protection > 0 {
			protection = math.Min(1, protection+(1-protection)*.4)
		}
		if r.MaxSuppression > 0 {
			if len(a.Body)>0{damage=float64(c.ThreatDamage)*.5}else{damage = float64(max(0, c.ThreatDamage-a.Armor-a.BodyArmor.Torso)) * .5}
		}
		risk += certainty * damage * (1 - protection)
	}
	return risk
}
func combatVisibleHostileDistance(space CombatSpace, a Combatant, at Cell) int {
	d := math.MaxInt
	for _, c := range a.Contacts {
		if c.Visible && !c.Checked && c.Team != a.Team && c.Source == "sight" {
			d = min(d, space.rangeMM(at, c.Position))
		}
	}
	return d
}

// Only a fresh personally visible held weapon may classify a melee threat.
// Its observed damage/range feed the existing risk evaluator; hidden weapon
// changes, ammunition, AP and durability never enter the guard decision.
func (s CombatState) guardThreat(space CombatSpace, r CombatRules, a Combatant) (risk float64, incoming, riposte bool) {
	view := a
	view.Contacts = nil
	for _, contact := range a.Contacts {
		if !contact.Visible || contact.Checked || contact.Team == a.Team || contact.Source != "sight" || contact.SourceID != a.ID || contact.ObservedTurn != s.Turn || contact.ObservedAction != s.ActionSeq {
			continue
		}
		known := s.Actor(contact.SubjectID)
		if known == nil || known.Position != contact.Position || combatWeaponKind(known.Weapon) == "firearm" || space.rangeMM(a.Position, contact.Position) > contact.ThreatRangeMM || !space.shotClear(contact.Position, a.Position) {
			continue
		}
		incoming = true
		riposte = riposte || space.rangeMM(a.Position, contact.Position) <= a.Weapon.RangeMM
		view.Contacts = append(view.Contacts, contact)
	}
	return s.threatAt(space, r, view, a.Position), incoming, riposte
}

