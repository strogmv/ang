	m := r.world.Crafting
	pack := r.dressPack(r.state.Inventory)
	lamp := dressSupply(t, r, "test.dress.lamp", "item.hub_light_headlamp", pack)
	earphones := dressSupply(t, r, "test.dress.earphones", "item.earphones", pack)
	msg := &pb.PocGameState{}
	r.appendInventory(msg, c.locale)
	r.appendCrafting(msg, c.locale)
	r.appendDress(msg.Inventory, c.locale)
	r.appendDressCraft(msg, c.locale)
	rows := map[string]*pb.PocDressRow{}
	for _, group := range msg.Inventory.Dress.Groups {
		for _, row := range group.Rows {
			rows[row.Id] = row
		}
	}
	check := func(i inv.Item, recipeID string) {
		t.Helper()
		recipe, ok := m.Recipe(recipeID)
		if !ok || rows[i.ID] == nil {
			t.Fatalf("missing %s or %s", i.ID, recipeID)
		}
		row := rows[i.ID]
		w := r.craftingWorker(m.Hero.Actor)
		if row.MayContain != r.dressSalvageHint(c.locale, recipe, w) || row.MayContain == "" {
			t.Fatalf("wrong salvage knowledge for %s: %s", i.ID, row.MayContain)
		}
		for _, option := range row.Actions {
			if option.Id == "salvage" && option.RecipeId == recipe.ID {
				if !m.Open(w, recipe) || !strings.Contains(option.PriceLine, fmt.Sprint(recipe.Minutes)) {
					t.Fatalf("wrong salvage offer: %v", option)
				}
				return
			}
		}
		if m.Open(w, recipe) {
			t.Fatalf("missing known salvage offer for %s", i.ID)
		}
	}
	check(lamp, "disassemble.headlamp")
	check(earphones, "disassemble.earphones")
	w := r.craftingWorker(m.Hero.Actor)
	for _, recipe := range m.Recipes {
		if !m.Knows(w, recipe) {
			continue
		}
		for _, input := range recipe.Inputs {
			class, ok := m.Part(input.Class)
			if !ok || len(class.Items) == 0 {
				continue
			}
			def := class.Items[0].Item
			row := &pb.PocDressRow{}
			r.dressCraftRow(c.locale, row, inv.Item{Definition: def}, nil, false)
			if !strings.Contains(row.WantedBy, r.craftingText(c.locale, recipe.Name)) {
				t.Fatalf("%s does not show its known recipe %s", def, recipe.ID)
			}
			return
		}
	}
	t.Fatal("fixture has no known recipe using a component")
}

