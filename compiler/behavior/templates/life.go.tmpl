func(s LifeState)Clone()LifeState{out:=s;out.Dynamic=nil;out.Vehicles=nil;out.Gates=cloneGates(s.Gates);out.LocationLockdown=cloneGateInputs(s.LocationLockdown);out.LocationPowerLost=cloneGateInputs(s.LocationPowerLost);out.BrainServices=LifeBrainServices{};out.populationEnv=nil;out.Decisions=s.Decisions.Clone();out.traffic=nil;out.trafficActive=false;out.routes=nil;out.RelationOverrides=s.cloneRelations();out.Population=s.Population.Clone();out.Development=s.Development.Clone();out.PracticeLog=append([]string(nil),s.PracticeLog...);if s.PracticePending!=nil{copy:=*s.PracticePending;out.PracticePending=&copy};out.PracticeExcluded=nil;if len(s.PracticeExcluded)>0{out.PracticeExcluded=map[string]bool{};for k,v:=range s.PracticeExcluded{out.PracticeExcluded[k]=v}};out.Observer=s.Observer.Clone();out.Maintenance=s.Maintenance.Clone();out.Events=append([]string(nil),s.Events...);out.Actors=append([]LifeActor(nil),s.Actors...);for i:=range out.Actors{a:=&out.Actors[i];a.Safety=a.Safety.clone();if a.RoutineOverride!=nil{v:=*a.RoutineOverride;a.RoutineOverride=&v};a.Brain=a.Brain.Clone();a.RouteFootprint=append([]Cell(nil),a.RouteFootprint...);a.Path=append([]Cell(nil),a.Path...);a.PendingPath=append([]Cell(nil),a.PendingPath...);a.Body=a.Body.clone();if a.Trip!=nil{trip:=*a.Trip;a.Trip=&trip};if a.Mount!=nil{mount:=*a.Mount;a.Mount=&mount};a.Visits=map[string]int{};for k,v:=range s.Actors[i].Visits{a.Visits[k]=v}};return out}
func(s LifeState)Validate(m LifeModel,tick int64)error{
 if err:=s.Decisions.Validate(tick,s.Seconds);err!=nil{return err};if len(s.Decisions.Last)>len(s.Actors){return fmt.Errorf("oversized named decision index")};for id:=range s.Decisions.Last{if s.Actor(id)==nil{return fmt.Errorf("unknown named decision actor")}}
 if s.PopulationFailure!=""{return fmt.Errorf("population stopped: %s",s.PopulationFailure)}
 if err:=s.validateResidenceState(m);err!=nil{return err}
 if err:=s.validateRelations();err!=nil{return err}
 if err:=s.validatePopulation(m,tick);err!=nil{return err}
 if err:=s.validateDevelopment(m,tick);err!=nil{return err}
 if err:=s.Observer.Validate();err!=nil{return fmt.Errorf("invalid life observer: %w",err)}
 for _,key:=range inspectionKeys(m.Inspection.Observer.Attributes){if _,ok:=s.Observer.Attributes[key];!ok{return fmt.Errorf("missing saved inspection attribute %s",key)}}
 if s.ControlledActorID!=""&&s.Actor(s.ControlledActorID)==nil{return fmt.Errorf("unknown controlled life actor")}
 if !s.Enabled{return nil};if s.Seconds<0||s.SecondsPerTick<1||s.SecondsPerTick>120||s.Tick<0||s.Tick!=tick||len(s.Events)>64||len(s.Actors)!=len(m.Actors){return fmt.Errorf("invalid life state")}
 occupied:=map[string]map[Cell]bool{}
 // In transit Position is the saved departure anchor, not a body on the floor.
 // A gate or lifting deck may close that anchor after departure; exact edge,
 // exit and arrival checks below still validate every such transit record.
 motion:=s.Seconds-m.StartSeconds;for i,a:=range s.Actors{if v:=a.RoutineOverride;v!=nil&&(!m.Walks(v.Level,v.At)||v.Activity==""||v.Label==""||v.MinSeconds<0){return fmt.Errorf("invalid saved Life routine override")};if err:=a.Safety.validate(m,a.Level,s.Seconds);err!=nil{return err};if err:=a.Brain.Validate(m.Brain,s.Seconds);err!=nil{return err};p:=m.Actors[i];if a.ID!=p.ID||a.Step<0||a.Step>=len(p.Steps)||(a.Trip==nil&&!m.Walks(a.Level,a.Position))||a.YieldUntil<0||a.YieldUntil>motion+m.lifeYieldHold(s.SecondsPerTick)||a.MoveStartTick<0||a.MoveStartTick>s.ActorMotionTick(m,tick,&a)||a.StartedAt<0||a.StartedAt>s.Seconds||a.Visits==nil||a.WorkedSeconds<0||a.SleptSeconds<0||a.Meals<0||len(a.Path)>10000||len(a.PendingPath)>10000{return fmt.Errorf("invalid life actor %s",a.ID)}
  if a.BoardedEdge!="" {e:=m.Edge(a.BoardedEdge);if e==nil||e.From!=a.Level||a.Trip!=nil||a.ResidenceID!=""||a.ServiceAttachment!=""||a.Body!=nil||len(a.Path)>0||len(a.PendingPath)>0||a.Position!=e.Exit{return fmt.Errorf("invalid boarded actor %s",a.ID)}}
  if a.ServiceAttachment!=""&&(a.Trip!=nil||a.ResidenceID!=""||a.Body!=nil||len(a.Path)>0||len(a.PendingPath)>0||!a.CombatHold){return fmt.Errorf("invalid service attachment")};
  if err:=a.validateMount();err!=nil{return err}
  if !(a.WalkedMM>=0&&a.WalkedMM<=1e15){return fmt.Errorf("invalid physical walking distance")}
  if a.YieldRequester!=""&&(a.YieldRequester==a.ID||m.Person(a.YieldRequester)==nil||!m.Walks(a.Level,a.YieldOrigin)||a.YieldHoldUntil<0||a.YieldHoldUntil>motion+16*m.MoveTicks){return fmt.Errorf("invalid life courtesy hold")}
  if a.YieldCooldownUntil<0||a.YieldCooldownUntil>motion+10*m.MoveTicks{return fmt.Errorf("invalid life courtesy cooldown")}
  if a.BlockedSince<0||a.BlockedSince>s.Seconds||a.GiveWaySince<0||a.GiveWaySince>s.Seconds||a.GiveWayTo==""&&a.GiveWaySince!=0||a.GiveWayTo!=""&&(a.GiveWayTo==a.ID||m.Person(a.GiveWayTo)==nil){return fmt.Errorf("invalid life give-way state %s",a.ID)}
  if a.AdmissionDeniedEdge!=""{e:=m.Edge(a.AdmissionDeniedEdge);if e==nil||e.Fare==nil||e.From!=a.Level||a.Trip!=nil||a.ID!=s.ControlledActorID{return fmt.Errorf("invalid life admission latch")}}
  if a.Trip!=nil{e:=m.Edge(a.Trip.Edge);if e==nil||e.From!=a.Level||a.Trip.Departure<0||!e.validBoardedDeparture(a.Trip.Departure,s.Seconds)||a.Position!=e.Exit||a.Trip.Arrival!=a.Trip.Departure+e.TravelSeconds||len(a.Path)>0{return fmt.Errorf("invalid life trip")}}else if a.ResidenceID==""&&a.ServiceAttachment==""&&a.BoardedEdge==""&&(a.Mount==nil||a.Mount.Afoot){if occupied[a.Level]==nil{occupied[a.Level]=map[Cell]bool{}};if occupied[a.Level][a.Position]{return fmt.Errorf("life actors overlap")};occupied[a.Level][a.Position]=true}
  for level,count:=range a.Visits{if _,ok:=m.Locations[level];!ok||count<1{return fmt.Errorf("invalid life visit")}}
  if len(a.PendingPath)>0&&(a.ID!=s.ControlledActorID||len(a.Path)>0||a.Trip!=nil){return fmt.Errorf("invalid pending life route")}
  pendingFrom:=a.Position;for _,at:=range a.PendingPath{if !m.Walks(a.Level,at)||!m.Adjacent(a.Level,pendingFrom,at){return fmt.Errorf("invalid pending life path")};pendingFrom=at}
  previous:=a.Position;for _,at:=range a.Path{if !m.Walks(a.Level,at)||!m.Adjacent(a.Level,previous,at){return fmt.Errorf("invalid life path")};previous=at}
  if a.OverrideEdge!=""{e:=m.Edge(a.OverrideEdge);if e==nil||e.To!=a.OverrideLevel||e.Entry!=a.OverrideAt||(a.Level!=e.From&&a.Level!=e.To){return fmt.Errorf("invalid selected life exit")}}
  if a.OverrideLevel!=""&&!m.Walks(a.OverrideLevel,a.OverrideAt){return fmt.Errorf("invalid life destination")}
  if a.Body!=nil{if err:=s.validateBody(m,a);err!=nil{return err}}
 }
 // The cells under a hero body are as exclusive as a position.
 for _,a:=range s.Actors{if a.Body==nil||!a.OnFloor(){continue};for _,c:=range a.Body.Cells[1:]{for _,o:=range s.Actors{if o.ID!=a.ID&&o.OnFloor()&&o.Level==a.Level&&o.Position==c{return fmt.Errorf("life actors overlap a hero body")}}}};if err:=s.validateGates(m,m.MotionTick(tick,s.Seconds));err!=nil{return err};for _,inputs:=range []map[string]bool{s.LocationLockdown,s.LocationPowerLost}{for level,on:=range inputs{if _,ok:=m.Locations[level];!ok||!on{return fmt.Errorf("invalid location safety input")}}};return s.Maintenance.Validate(m,s.Seconds)
}

// A passenger may step onto a free adjacent landing cell, never across a wall.
func(s LifeState)lifeArrivalCell(m LifeModel,e LifeEdge,id string)(Cell,bool){
 candidates:=[]Cell{e.Entry,{X:e.Entry.X+1,Y:e.Entry.Y},{X:e.Entry.X,Y:e.Entry.Y+1},{X:e.Entry.X-1,Y:e.Entry.Y},{X:e.Entry.X,Y:e.Entry.Y-1}}
 for _,at:=range candidates{if m.Walks(e.To,at)&&!s.occupied(e.To,at,id){return at,true}};return Cell{},false
}

// Structural reachability is shared by all route requests in this state. It
// never contains NPC positions/reservations: temporary congestion must remain
// eligible for normal pathfinding on the next tick. This transient cache is
// omitted from saves and rebuilt independently after Clone/load.
type lifeRouteConnectivity struct {
 walkable map[string]bool
 levels map[string]lifeRouteLevel
 travel map[lifeTravelKey]int64
 lanes map[string]*lifeLanes
}
type lifeTravelKey struct{level string;from,to Cell}
// StaticTravelSeconds memoizes the body-free walking time between two cells in
// game seconds (-1: unreachable). Rebuilt with the geometry cache; never saved.
func(s *LifeState)StaticTravelSeconds(m LifeModel,level string,from,to Cell)int64{
 if from==to{return 0};s.ensureLifeRoutes(m);k:=lifeTravelKey{level,from,to}
 if v,ok:=s.routes.travel[k];ok{return v}
 v:=int64(-1);if s.routes.connected(level,from,to){if path:=m.Space(level,nil).Path(from,to,Cell{},0);len(path)>0{v=int64(len(path))*m.MoveTicks}}
 if s.routes.travel==nil{s.routes.travel=map[lifeTravelKey]int64{}};if len(s.routes.travel)<1<<16{s.routes.travel[k]=v};return v
}
type lifeRouteLevel struct {
 terrain []string
 width int
 components []int
}
func(s *LifeState)ensureLifeRoutes(m LifeModel)bool{
 if s.routes!=nil&&s.routes.matches(m){return false}
 cache:=&lifeRouteConnectivity{walkable:make(map[string]bool,len(m.Walkable)),levels:make(map[string]lifeRouteLevel,len(m.Locations))}
 for glyph,walks:=range m.Walkable{cache.walkable[glyph]=walks}
 for id,location:=range m.Locations{
  level:=lifeRouteLevel{terrain:append([]string(nil),location.Terrain...)}
  if len(location.Terrain)>0{level.width=len(location.Terrain[0])}
  level.components=make([]int,level.width*len(location.Terrain))
  queue:=make([]Cell,0,len(level.components));component:=0
  for y,row:=range location.Terrain{for x:=range row{
   origin:=Cell{X:x,Y:y};index:=y*level.width+x
   if level.components[index]!=0||!m.Walks(id,origin){continue}
   component++;level.components[index]=component;queue=append(queue[:0],origin)
   for head:=0;head<len(queue);head++{at:=queue[head];for _,next:=range m.StepNeighbours(id,at){
    if !m.Walks(id,next){continue};nextIndex:=next.Y*level.width+next.X
    if level.components[nextIndex]==0{level.components[nextIndex]=component;queue=append(queue,next)}
   }}
  }}
  cache.levels[id]=level
 }
 // the lanes: measured again only round the cells that changed (the same floor: the same lanes)
 prev:=s.routes;same:=prev!=nil&&len(prev.walkable)==len(cache.walkable);if same{for glyph,walks:=range cache.walkable{if old,ok:=prev.walkable[glyph];!ok||old!=walks{same=false;break}}}
 cache.lanes=map[string]*lifeLanes{}
 for id:=range m.Locations{if old,ok:=prev.levelTerrain(id);same&&ok{cache.lanes[id]=updateLifeLanes(prev.lanes[id],m,id,old)}else{cache.lanes[id]=buildLifeLanes(m,id)}}
 s.routes=cache
 return true
}
// Geometry changes may shorten a previously accepted route. Keep its safe
// prefix and normal movement cadence; neither collision bypass nor teleport
// is a recovery mechanism. Used only on topology refresh, not every frame.
func(m LifeModel)supportedPath(level string,from Cell,path []Cell)[]Cell{
 for i,at:=range path{if !m.Walks(level,at)||!m.Adjacent(level,from,at){return path[:i]};from=at};return path
}
// Compare structural inputs once per tick. Copied row headers and walkability
// entries prevent shared mutable model maps/slices from hiding topology edits.
// Unchanged row strings compare cheaply; no hash collision can reuse stale data.
func(c *lifeRouteConnectivity)levelTerrain(id string)([]string,bool){if c==nil{return nil,false};l,ok:=c.levels[id];return l.terrain,ok}
func(c *lifeRouteConnectivity)matches(m LifeModel)bool{
 if len(c.levels)!=len(m.Locations)||len(c.walkable)!=len(m.Walkable){return false}
 for glyph,walks:=range m.Walkable{old,ok:=c.walkable[glyph];if !ok||old!=walks{return false}}
 for id,location:=range m.Locations{old,ok:=c.levels[id];if !ok||len(old.terrain)!=len(location.Terrain){return false};for i,row:=range location.Terrain{if row!=old.terrain[i]{return false}}}
 return true
}
func(c *lifeRouteConnectivity)connected(levelID string,from,to Cell)bool{
 level,ok:=c.levels[levelID];if !ok||from.X<0||from.Y<0||to.X<0||to.Y<0||from.X>=level.width||to.X>=level.width||from.Y>=len(level.terrain)||to.Y>=len(level.terrain){return false}
 component:=level.components[from.Y*level.width+from.X]
 return component!=0&&component==level.components[to.Y*level.width+to.X]
}

// yieldPopulation propagates one empty pocket through stationary local traffic.
// Named walking NPCs may participate, but the controlled actor, manual actors,
// occupied maintenance workplaces, accepted movement and active tasks remain hard barriers.
// A request examines at most 128 cells/radius twelve. Its final pocket must be
// outside the requester's route. At most seven ordinary steps may lead through
// free corridor cells to that pocket; only the first step is reserved now.
// Actual positions change only by Advance, with normal MoveTicks and collision
// checks, and the existing eight-step hold covers the whole short manoeuvre.
type lifeYieldResident struct{index int;named bool;courtesy bool}
// An explicit autonomous requester is enough for NPC-to-NPC traffic. No hero,
// client connection or synthetic population is required. The legacy anonymous
// wrapper still cannot guess which actor is controlled.
func(s LifeState)autonomousTrafficRequester(id string)bool{
 if a:=s.Actor(id);a!=nil{return a.ID!=s.ControlledActorID&&!a.Manual&&a.OnFloor()&&!a.Arrived&&a.Activity=="walking"&&a.Goal!=a.Position}
 for _,a:=range s.Population.Actors{if a.ID==id{return a.Materialized&&a.Trip==nil&&!a.Arrived&&(a.Activity=="walking"||a.Activity=="waiting_path")&&a.Goal!=a.Position}}
 return false
}
func(s *LifeState)yieldTraffic(m LifeModel,level string,tick int64,requester ...string)(map[Cell]bool,map[Cell]lifeYieldResident){
 owned:=s.beginTraffic();defer s.endTraffic(owned);hard:=map[Cell]bool{};residents:=map[Cell]lifeYieldResident{};who:="";if len(requester)>0{who=requester[0]};autonomous:=s.autonomousTrafficRequester(who)
 for key:=range s.traffic.cells{if key.level!=level{continue};h,r,ok:=s.yieldCell(m,level,key.at,tick,who,autonomous);if h{hard[key.at]=true};if ok{residents[key.at]=r}}
 for at:=range s.yieldPassage(m,who){hard[at]=true};return hard,residents
}
func(s *LifeState)yieldPassage(m LifeModel,who string)map[Cell]bool{
 if actor:=s.Actor(who);actor!=nil{return s.courtesyNamedPassage(m,*actor)};for _,actor:=range s.Population.Actors{if actor.ID==who{return s.courtesyPopulationPassage(m,actor)}};return nil
}
func(s *LifeState)yieldRoute(m LifeModel,level string,from,to Cell,tick int64,requester ...string)[]Cell{
 owned:=s.beginTraffic();defer s.endTraffic(owned);who:="";if len(requester)>0{who=requester[0]};autonomous:=s.autonomousTrafficRequester(who);passage:=s.yieldPassage(m,who)
 space:=m.SpaceFor(level,passage,who);space.Occupied=func(at Cell)bool{hard,_,_:=s.yieldCell(m,level,at,tick,who,autonomous);return hard};return space.Path(from,to,Cell{},0)
}
func(s *LifeState)yieldPopulation(m LifeModel,level string,wanted Cell,tick int64,avoid ...Cell)bool{
 return s.yieldPopulationFor(m,level,wanted,tick,"",avoid...)
}
func(s *LifeState)yieldPopulationFor(m LifeModel,level string,wanted Cell,tick int64,requester string,avoid ...Cell)bool{
 owned:=s.beginTraffic();defer s.endTraffic(owned);autonomous:=s.autonomousTrafficRequester(requester)
 if (autonomous||s.courtesyRequester(requester))&&!s.courtesyAware(m,requester,level,wanted){return false}
 passageAvoid:=s.yieldPassage(m,requester)
 hard:=func(at Cell)bool{h,_,_:=s.yieldCell(m,level,at,tick,requester,autonomous);return h||passageAvoid[at]}
 residents:=func(at Cell)(lifeYieldResident,bool){_,r,ok:=s.yieldCell(m,level,at,tick,requester,autonomous);return r,ok}
 if _,ok:=residents(wanted);!ok||hard(wanted){return false}
 queue:=[]Cell{wanted};seen:=map[Cell]bool{wanted:true};parent:=map[Cell]Cell{}
 for head:=0;head<len(queue)&&head<128;head++{at:=queue[head];for _,next:=range m.StepNeighbours(level,at){if seen[next]||hard(next)||!m.Walks(level,next)||m.courtesyReach(level,wanted,next)>12{continue};seen[next]=true;parent[next]=at
   if _,occupied:=residents(next);!occupied{
    // A free cell in the requested corridor is a way through, not a place to
    // stop: holding it would obstruct the same passage we are trying to clear.
    forbidden:=false;for _,at:=range avoid{if at==next{forbidden=true;break}}
    if forbidden{if len(queue)<128{queue=append(queue,next)};continue}
    move:=[]Cell{next};previous:=parent[next];r,ok:=residents(previous)
    for !ok&&previous!=wanted&&len(move)<7{move=append(move,previous);previous=parent[previous];r,ok=residents(previous)}
    if !ok{continue};if (r.courtesy||autonomous||s.courtesyRequester(requester))&&!s.courtesyRelayAware(m,requester,level,wanted,previous,parent,residents){continue};for i,j:=0,len(move)-1;i<j;i,j=i+1,j-1{move[i],move[j]=move[j],move[i]}
    passage:=map[Cell]bool(nil);if r.named{passage=s.courtesyNamedPassage(m,s.Actors[r.index])}else{passage=s.courtesyPopulationPassage(m,s.Population.Actors[r.index])};refills:=false;for _,at:=range move{if passage[at]{refills=true;break}};if refills{continue}
    pauseMoves,cooldownMoves:=int64(8),int64(10);if s.courtesyRequester(requester)&&previous!=wanted{pauseMoves=int64(len(move))+1;cooldownMoves=pauseMoves+1}
    if r.named{tick:=s.Seconds-m.StartSeconds;a:=&s.Actors[r.index];if r.courtesy{a.Arrived=false};a.YieldRequester="";a.YieldHoldUntil=0;a.YieldOrigin=Cell{};if s.courtesyRequester(requester){a.YieldRequester=requester;a.YieldOrigin=a.Position;a.YieldHoldUntil=tick+16*m.MoveTicks};a.Path=move;a.MoveStartTick=tick;a.YieldUntil=tick+pauseMoves*m.MoveTicks;a.YieldCooldownUntil=tick+cooldownMoves*m.MoveTicks;a.Activity="yielding";a.Label="Уступает проход"}else{a:=&s.Population.Actors[r.index];a.YieldRequester="";a.YieldHoldUntil=0;a.YieldOrigin=Cell{};if s.courtesyRequester(requester){a.YieldRequester=requester;a.YieldOrigin=a.Position;a.YieldHoldUntil=tick+16*m.Population.MoveTicks};a.Path=move;a.MoveStartTick=tick;a.YieldUntil=tick+pauseMoves*m.Population.MoveTicks;a.YieldCooldownUntil=tick+cooldownMoves*m.Population.MoveTicks;a.Arrived=false;a.Activity="yielding"};if r.named{s.syncTrafficBody(r.index)}else{s.syncTrafficBody(len(s.Actors)+r.index)};return true
   }
   if len(queue)<128{queue=append(queue,next)}
 }};return false
}

// MotionTick is the existing clock of the controlled body, population and gates.
func(m LifeModel)MotionTick(tick,seconds int64)int64{if m.Brain.Enabled{return seconds-m.StartSeconds};return tick}

// ActorUsesScheduleMotion keeps directly controlled movement at its
// existing cadence. All routines and scripted NPC paths use game time.
func(s *LifeState)ActorUsesScheduleMotion(m LifeModel,a *LifeActor)bool{
 return m.Brain.Enabled||a.ID!=s.ControlledActorID||!a.Manual
}

func(s *LifeState)ActorMotionTick(m LifeModel,tick int64,a *LifeActor)int64{
 if s.ActorUsesScheduleMotion(m,a){return s.Seconds-m.StartSeconds};return tick
}

// UseScheduleMotion upgrades old schedule-only saves. The remaining portion
// of a step or yield keeps its ordinary cadence at the new clock origin.
func(s *LifeState)UseScheduleMotion(m LifeModel){
 if m.Brain.Enabled||s.ScheduleMotion{return}
 shift:=s.Seconds-m.StartSeconds-s.Tick
 for i:=range s.Actors{
  a:=&s.Actors[i]
  if s.ActorUsesScheduleMotion(m,a)&&a.MoveStartTick>=0{a.MoveStartTick=max(0,a.MoveStartTick+shift)}
  for _,timer:=range []*int64{&a.YieldUntil,&a.YieldHoldUntil,&a.YieldCooldownUntil}{
   if *timer>0{*timer=max(0,*timer+shift)}
  }
 }
 s.ScheduleMotion=true
}
