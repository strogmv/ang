		func(s *CombatState) { s.Turn = math.MaxInt64 },
		func(s *CombatState) { s.ActionSeq = math.MaxUint64 },
	}
	for i, change := range mutations {
		copy := s.Clone()
		change(&copy)
		if err := copy.Validate(r, space); err == nil {
			t.Fatalf("accepted malformed integer mutation %d", i)
		}
	}
