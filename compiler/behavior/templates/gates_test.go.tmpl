func TestGateSaveMidLiftResumesSameProgress(t *testing.T){
 m:=gateFixture();m.StartSeconds=6*3600-5;s:=m.Start()
 for tick:=int64(1);tick<=100;tick++{s.Advance(m,tick)}
 g:=s.Gates["gate"];if g.State!="opening"||g.Position(100)<=0||g.Position(100)>=GateFull{t.Fatalf("not mid lift: %+v",g)}
 raw,err:=json.Marshal(s);if err!=nil{t.Fatal(err)};var loaded LifeState;if err=json.Unmarshal(raw,&loaded);err!=nil{t.Fatal(err)}
 if loaded.Gates["gate"].Position(100)!=g.Position(100){t.Fatal("load changed progress")}
 for tick:=int64(101);tick<=200;tick++{s.Advance(m,tick);loaded.Advance(m,tick);if !reflect.DeepEqual(s.Clone().Gates,loaded.Clone().Gates){t.Fatalf("resumed lift diverged at %d",tick)}}
 if s.Gates["gate"].State!="open"{t.Fatal("did not finish opening")}
}

