// AUTO-GENERATED by ANG
// Retry rules of the API client. Kept apart from endpoints/meta.ts: the client is
// part of every page, and it needs these few rules, not the metadata of every operation.

export type RetryStrategy = {
  maxAttempts: number;
  baseDelayMs: number;
  retryOnStatuses: readonly number[];
  retryNetworkErrors: boolean;
};

export const retryStrategies: readonly RetryStrategy[] = [
{{- range .Strategies }}
  { maxAttempts: {{ .MaxAttempts }}, baseDelayMs: {{ .BaseDelayMS }}, retryOnStatuses: [{{ .RetryOnStatuses }}], retryNetworkErrors: {{ .RetryNetworkErrors }} },
{{- end }}
];

/** The strategy (index into retryStrategies) most operations of a method share; a method not listed is not retried. */
export const retryDefaults: Readonly<Record<string, number>> = {
{{- range .Defaults }}
  {{ .Method }}: {{ .Strategy }},
{{- end }}
};

/** Operations whose rule differs from their method's default: [method, path template, strategy index or -1 = never]. */
export const retryOverrides: ReadonlyArray<readonly [string, string, number]> = [
{{- range .Overrides }}
  ['{{ .Method }}', '{{ .Path }}', {{ .Strategy }}],
{{- end }}
];
