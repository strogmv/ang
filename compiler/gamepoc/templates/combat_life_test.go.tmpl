	r.world.CombatRuntime.Rules.HearingRangeMM = 1
	hero, target := r.state.Life.Actor(playerActorID), r.state.Life.Actor(targetID)
	oldLevel, entry := hero.Level, hero.Position
	// The same complete corner routes now include the authored retreat surcharge.
 // Budget it explicitly; the test still compares every actual NPC search cell.
 r.world.CombatRuntime.Rules.APPerTurn+=r.world.CombatRuntime.Rules.RetreatAP
 const level = "level.test_combat_corner"
	r.world.Life.Locations[level] = behavior.LifeLocation{Name: "Corner search fixture", CellMM: 1000, Terrain: []string{"############", "#....#.....#", "#....#.....#", "#..........#", "#....#.....#", "#....#.....#", "############"}}
	r.world.Life.Edges = append(r.world.Life.Edges, behavior.LifeEdge{ID: "test.corner.exit", From: level, To: oldLevel, Exit: behavior.Cell{X: 1, Y: 3}, Entry: entry, Mode: "walk", TravelSeconds: 3, Seats: 1}, behavior.LifeEdge{ID: "test.corner.entry", From: oldLevel, To: level, Exit: entry, Entry: behavior.Cell{X: 1, Y: 3}, Mode: "walk", TravelSeconds: 3, Seats: 1})
	r.world.Opaque["#"] = true
	r.world.Life.Walkable["."] = true
	for _, a := range []*behavior.LifeActor{hero, target} {
		a.Level = level
		a.Path = nil
		a.PendingPath = nil
		a.Body = nil
		a.Trip = nil
		a.ResidenceID = ""
		a.OverrideLevel = ""
		a.OverrideEdge = ""
		a.Arrived = true
		a.CombatHold = false
		a.Safety = nil
		if a.Visits == nil {
			a.Visits = map[string]int{}
		}
		a.Visits[level]++
	}
	hero.Position = behavior.Cell{X: 4, Y: 3}
	hero.Goal = hero.Position
	hero.Manual = true
	target.Position = behavior.Cell{X: 3, Y: 3}
	target.Goal = target.Position
	target.Manual = false
	r.syncLifeHero()
	r.applyGateTerrain()
	if err := r.state.Life.Validate(r.world.Life, r.state.Tick); err != nil {
		t.Fatal("invalid corner input fixture", err)
	}
	if r.combatSight(level, target.Position, hidden) {
		t.Fatal("fixture has no real occluding corner")
	}
	heroHP, targetHP := r.combatant(playerActorID, "player").HP, r.combatant(targetID, "opposition").HP
	inventory := r.state.Inventory.Clone()
	if err := r.startCombat(targetID); err != nil {
		t.Fatal(err)
	}
	epoch := r.state.Epoch
	if err := r.combatCommand(&pb.PocCombatCommand{Action: "move", X: int32(hidden.X), Y: int32(hidden.Y), ExpectedTurn: r.state.Combat.Turn}); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 20 && r.state.Combat.Active; i++ {
		if err := r.combatCommand(&pb.PocCombatCommand{Action: "end", ExpectedTurn: r.state.Combat.Turn}); err != nil {
			t.Fatal(err)
		}
	}
	if r.state.Combat.Active {
		t.Fatal("actors exhausted their search but retained a permanent encounter")
	}
	moves := []string{}
	disengaged := false
	for _, event := range r.state.Combat.Events {
		if event.ActorID == targetID && event.Type == "move" {
			moves = append(moves, fmt.Sprintf("%d,%d", event.To.X, event.To.Y))
		}
		if event.Type == "disengage" {
			disengaged = true
		}
	}
	if len(moves) == 0 || !disengaged {
		t.Fatal("encounter was closed without executing actual NPC search")
	}
	if r.state.Life.Actor(playerActorID).CombatHold || r.state.Life.Actor(targetID).CombatHold || r.state.CombatRoster[playerActorID].HP != heroHP || r.state.CombatRoster[targetID].HP != targetHP || !reflect.DeepEqual(inventory, r.state.Inventory) {
		t.Fatal("disengagement changed health/items or failed to release able actors")
	}
	if r.state.Epoch == epoch {
		t.Fatal("participating hero retained an old combat input epoch")
	}
	if err := r.state.Life.Validate(r.world.Life, r.state.Tick); err != nil {
		t.Fatal("released state is inconsistent", err)
	}
	return moves
}
func TestCombatWorldExhaustedSearchDisengagesWithoutHiddenPositionTracking(t *testing.T) {
	a := combatWorldCornerEscape(t, behavior.Cell{X: 7, Y: 1})
	b := combatWorldCornerEscape(t, behavior.Cell{X: 8, Y: 1})
	if !reflect.DeepEqual(a, b) {
		t.Fatalf("unseen silent movement changed NPC search: %v / %v", a, b)
	}
}

func TestCombatV4FinishedIntentDoesNotRestartAfterCooldown(t *testing.T){
 r,c,scene:=combatEpisodeFixture(t,"combat_knife_npc","ru");combatEpisodeEngage(t,r,c,scene)
 if err:=r.performCombatAction(playerActorID,&behavior.CombatAction{Type:"surrender"});err!=nil{t.Fatal(err)}
 if r.state.Combat.Active{t.Fatal("accepted surrender did not finish encounter")}
 oldID:=r.state.Combat.ID
 r.state.Life.Seconds+=r.world.CombatLife.ThreatMemorySeconds+1
 r.combatLifeBeforeFrame();if err:=r.advanceWoundCare();err!=nil{t.Fatal(err)};if err:=r.advanceStealth();err!=nil{t.Fatal(err)}
 // Both people remain physically present, conscious and in sight when the
 // original cooldown expires. No patrol/movement can make this pass by leaving.
 h,g:=r.state.Life.Actor(playerActorID),r.state.Life.Actor(scene.Guard)
 if h.CombatHold||g.CombatHold||!r.combatWorldConscious(playerActorID)||!r.combatWorldConscious(scene.Guard){t.Fatal("fixture must have released two conscious actors")}
 if !r.combatWorldIdentifies(combatLifeObserver{ID:g.ID,Level:g.Level,At:g.Position},h.ID){t.Fatal("fixture must retain personal sight")}
 if err:=r.combatLifeAfterFrame();err!=nil{t.Fatal(err)}
 if r.state.Combat.Active||r.state.Combat.ID!=oldID{t.Fatal("same consumed intention restarted the finished fight")}
 // A fresh explicit attack is still allowed by the ordinary executor.
 if err:=r.beginCombat(scene.Guard,playerActorID,"aggressor","defender");err!=nil{t.Fatal(err)}
 if !r.state.Combat.Active{t.Fatal("new explicit attack was blocked")}
}
