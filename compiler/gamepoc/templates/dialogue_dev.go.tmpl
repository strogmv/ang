		s.put("topic", id, q.Fields(map[string]any{"topic": id, "second": json.Number(strconv.FormatInt(at, 10))}))
	}
	for id, step := range m.QuestSteps {
		s.put("quest", id, q.Fields(map[string]any{"quest": dialogueDevObject(step)}))
	}
	for id, know := range m.Story.Hero {
		s.put("knowledge", id, q.Fields(map[string]any{"fact": id, "belief": json.Number(strconv.FormatFloat(know.Belief, 'f', -1, 64)), "refuted": know.Refuted}))
	}
	for _, e := range m.Story.Journal {
		s.put("journal", strconv.FormatUint(e.Serial,10), q.Fields(map[string]any{"journal": e.ID, "source": e.Source, "update": e.Update}))
	}
	for id, item := range r.state.Inventory.Items {
		s.put("item", id, q.Fields(map[string]any{"item": item.Definition, "owner": item.Owner, "location": dialogueDevObject(item.Location), "quantity": json.Number(strconv.FormatInt(item.Quantity, 10)), "condition_ppm": json.Number(strconv.FormatInt(item.Condition, 10))}))
	}
	for _, a := range r.state.Inventory.Accounts {
		if a.Currency == "CRD" {
			s.put("crd", a.Owner, strconv.FormatInt(a.Balance, 10))
		}
	}
	for _, actor := range r.state.Life.Actors {
		if actor.ID != playerActorID {
			trust := r.state.Life.RelationTo(r.world.Life, actor.ID, playerActorID)
			s.put("trust", actor.ID, strconv.FormatFloat(trust,'f',-1,64))
		}
	}
