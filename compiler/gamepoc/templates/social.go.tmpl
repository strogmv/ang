  for _,m:=range members{a:=&d.Agents[r.demoAgentIndex(m.ID)];a.Role="Поддержка";if m.ID==d.Coordination.LeaderID{a.Role="Лидер"};if m.ID==d.Coordination.SpeakerID{if m.ID==d.Coordination.LeaderID{a.Role="Лидер, переговорщик"}else{a.Role="Переговорщик"}}}
