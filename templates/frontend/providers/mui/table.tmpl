// Footer: page pills via the table UI registry (@ui/tables). The host app
// swaps the look once with registerTablePagination(); tables stay generated.
function {{ .Name }}TableFooter() {
  const apiRef = useGridApiContext();
  const page = useGridSelector(apiRef, gridPageSelector);
  const pageCount = useGridSelector(apiRef, gridPageCountSelector);
  return (
    <Box sx={{"{{"}} px: 1, py: 1.5 {{"}}"}}>
      <TablePagination
        page={page + 1}
        pageCount={pageCount}
        onChange={(next) => apiRef.current.setPage(next - 1)}
      />
    </Box>
  );
}

