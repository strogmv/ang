// Space callbacks belong to the host, never the durable save. Cover is a
// directional blocked fraction [0,1]. ShotClear distinguishes a bullet barrier
// from mere lack of visibility; a transparent bulletproof panel is possible.
type CombatSpace struct {
	Space       Space
	CellMM      int
	RangeMM     func(Cell, Cell) int
	Cover       func(shooter, target Cell) float64
	ShotClear   func(Cell, Cell) bool
	Communicate func(from, to Combatant) bool
	// Hosts with stacked decks provide physical body/segment geometry. The
	// planar fallback must not be used to compare navigation-band coordinates.
	BodyOnShot func(from, to, body Cell) bool
	CanHear    func(listener, source Combatant) bool
	// Live ambient bodies are checked only while executing a shot. They must
	// not change candidates or disclose hidden bystanders through preview.
	ExecutionShotBlocked func(from, to Cell) bool
	// Optional physical stance/body-part protection. The fallback is geometric
	// cover with conservative pose multipliers, never inferred material armour.
	Protection        func(from, to Cell, shooter, target Combatant, bodyPart string) float64
	BodyIntersects    func(from, to Cell, shooter, target, bystander Combatant, part string) bool
	ThrowClear        func(Cell, Cell) bool
	BlastProtection   func(Cell, Cell) float64
	VisibleBystanders func(observer Combatant) []Cell
}

var ErrCombatExecutionBlocked = errors.New("combat shot blocked by a body during execution")

func (s CombatSpace) rangeMM(a, b Cell) int {
	if s.RangeMM != nil {
		v := s.RangeMM(a, b)
		if v < 0 || v > 1000000000 {
			return 1000000000
		}
		return v
	}
	return int(math.Round(math.Hypot(float64(a.X-b.X), float64(a.Y-b.Y)) * float64(s.CellMM)))
}
func (s CombatSpace) visible(a, b Cell, r CombatRules) bool {
	return s.rangeMM(a, b) <= r.SightRangeMM && s.Space.Visible != nil && s.Space.Visible(a, b)
}

// ActorVisible uses actual pose rays where available. The legacy standing-eye
// ray must not veto two prone bodies seeing below an overhead beam.
func (s CombatSpace) ActorVisible(observer, target Combatant, r CombatRules) bool {
	if s.rangeMM(observer.Position, target.Position) > r.SightRangeMM {
		return false
	}
	if s.Protection != nil {
		return s.protection(observer.Position, target.Position, observer, target, "") < 1
	}
	return s.Space.Visible != nil && s.Space.Visible(observer.Position, target.Position)
}
func (s CombatSpace) shotClear(a, b Cell) bool {
	if s.ShotClear != nil {
		return s.ShotClear(a, b)
	}
	return s.Space.Visible != nil && s.Space.Visible(a, b)
}
func (s CombatSpace) cover(a, b Cell, crouched bool) float64 {
	c := 0.0
	if s.Cover != nil {
		c = s.Cover(a, b)
	}
	if math.IsNaN(c) || math.IsInf(c, 0) {
		return 1
	}
	c = math.Max(0, math.Min(1, c))
	if crouched && c > 0 {
		c = math.Min(1, c+(1-c)*.2)
	}
	return c
}
func (s CombatSpace) standable(at Cell) bool {
	return at.X >= 0 && at.Y >= 0 && at.X < s.Space.Width && at.Y < s.Space.Height && s.Space.Walkable != nil && s.Space.Walkable(at) && !s.Space.Blocked[at]
}
func (s CombatSpace) canCommunicate(a, b Combatant, r CombatRules) bool {
	if s.Communicate != nil {
		return s.Communicate(a, b)
	}
	return s.rangeMM(a.Position, b.Position) <= r.ShareRangeMM && s.visible(a.Position, b.Position, r)
}
func (r CombatRules) Validate() error {
	for _, n := range []int{r.GuardAP, r.ProneAP, r.BandageAP, r.ReactionAP} {
		if n < 0 || n > 100 {
			return errors.New("invalid tactical stance/aid/reaction cost")
		}
	}
	if r.BandageAmount < 0 || r.BandageAmount > 1000000 || r.MaxSuppression < 0 || r.MaxSuppression > 1000 || r.SuppressionPerAP < 0 || r.SuppressionPerAP > 1000 || r.SuppressionRecovery < 0 || r.SuppressionRecovery > 1000 || r.MoraleRecovery < 0 || r.MoraleRecovery > 100 {
		return errors.New("invalid tactical wound/suppression rule")
	}
	if math.IsNaN(r.SuppressionAccuracyPenalty) || math.IsInf(r.SuppressionAccuracyPenalty, 0) || r.SuppressionAccuracyPenalty < 0 || r.SuppressionAccuracyPenalty > 1 {
		return errors.New("invalid suppression accuracy rule")
	}
	if r.BandageAP > 0 && r.BandageAmount < 1 || r.MaxSuppression > 0 && r.SuppressionPerAP < 1 {
		return errors.New("incomplete tactical aid/suppression rules")
	}

	if r.APPerTurn < 1 || r.APPerTurn > 100 || r.MoveAPPerMeter < 1 || r.MoveAPPerMeter > 100 || r.ReloadAP < 1 || r.ReloadAP > 100 || r.HealAP < 1 || r.HealAP > 100 || r.CrouchAP < 1 || r.CrouchAP > 100 || r.ReportAP < 1 || r.ReportAP > 100 || r.HealAmount < 1 || r.HealAmount > 1000000 || r.MemoryTurns < 1 || r.MemoryTurns > 1000 || r.SightRangeMM < 1 || r.SightRangeMM > 10000000 || r.HearingRangeMM < 1 || r.HearingRangeMM > 10000000 || r.ShareRangeMM < 1 || r.ShareRangeMM > 10000000 || r.MaxSearchCells < 1 || r.MaxSearchCells > 65536 || r.MaxActionsPerTurn < 1 || r.MaxActionsPerTurn > 256 || r.EstimatedDefense < 0 || r.EstimatedDefense > 100 {
		return errors.New("invalid tactical costs or budgets")
	}
	if math.IsNaN(r.MinHit) || math.IsNaN(r.MaxHit) || math.IsInf(r.MinHit, 0) || math.IsInf(r.MaxHit, 0) || r.MinHit < 0 || r.MaxHit > 1 || r.MinHit > r.MaxHit {
		return errors.New("invalid tactical hit limits")
	}
	if math.IsNaN(r.DamageMin) || math.IsNaN(r.DamageMax) || math.IsInf(r.DamageMin, 0) || math.IsInf(r.DamageMax, 0) || r.DamageMin <= 0 || r.DamageMax < r.DamageMin || r.DamageMax > 1000 {
		return errors.New("invalid tactical damage spread")
	}
	for _, v := range []float64{r.CoverWeight, r.AttackWeight, r.MoveWeight, r.HealWeight, r.RetreatWeight} {
		if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1000 {
			return errors.New("invalid tactical weight")
		}
	}
	return nil
}
func NewCombat(id, level string, seed int64, actors []Combatant, r CombatRules, space CombatSpace) (CombatState, error) {
	s := CombatState{ID: id, LevelID: level, Seed: seed, Turn: 1, Active: true, Actors: append([]Combatant(nil), actors...)}
	for i := range s.Actors {
		s.Actors[i].AP = r.APPerTurn
		s.Actors[i].Guarding = false
		s.Actors[i].Overwatch = false
		s.Actors[i].ReservedAP = 0
		if s.Actors[i].WeaponUsesRemaining > 0 {
			s.Actors[i].WeaponUsesLimited = true
		}
		if !s.Actors[i].TacticalInitialized {
			s.Actors[i].Morale = s.Actors[i].Courage
			s.Actors[i].TacticalInitialized = true
		}
		s.Actors[i].Contacts = nil
	}
	sort.SliceStable(s.Actors, func(i, j int) bool {
		a, b := s.Actors[i], s.Actors[j]
		if a.Initiative != b.Initiative {
			return a.Initiative > b.Initiative
		}
		return a.ID < b.ID
	})
	if err := s.Validate(r, space); err != nil {
		return CombatState{}, err
	}
	teams := map[string]bool{}
	for _, a := range s.Actors {
		if a.Able() {
			teams[a.Team] = true
		}
	}
	if len(teams) < 2 {
		return CombatState{}, errors.New("combat needs opposing able teams")
	}
	if !s.beginTurn(r) && s.Active {
		s.nextTurn(r)
	}
	s.Observe(space, r)
	return s, nil
}
func (s *CombatState) Actor(id string) *Combatant {
	for i := range s.Actors {
		if s.Actors[i].ID == id {
			return &s.Actors[i]
		}
	}
	return nil
}
func (s *CombatState) Current() *Combatant {
	if !s.Active || s.CurrentIndex < 0 || s.CurrentIndex >= len(s.Actors) {
		return nil
	}
	return &s.Actors[s.CurrentIndex]
}
func (s CombatState) Clone() CombatState {
	s.Actors = append([]Combatant(nil), s.Actors...)
	for i := range s.Actors {
		s.Actors[i].Contacts = append([]CombatContact(nil), s.Actors[i].Contacts...)
		s.Actors[i].Explosives = append([]CombatExplosiveStock(nil), s.Actors[i].Explosives...)
	}
	s.Events = append([]CombatEvent(nil), s.Events...)
	return s
}
func (s CombatState) Validate(r CombatRules, space CombatSpace) error {
	if err := r.Validate(); err != nil {
		return err
	}
	if s.ID == "" || len(s.ID) > 256 || s.LevelID == "" || len(s.LevelID) > 256 || s.Turn < 1 || s.Turn > 1<<50 || s.ActionSeq > 1<<60 || s.EventSeq > 1<<60 || len(s.Actors) < 2 || len(s.Actors) > 256 || s.CurrentIndex < 0 || s.CurrentIndex >= len(s.Actors) || space.CellMM < 1 || space.CellMM > 100000 || space.Space.Width < 1 || space.Space.Width > 1<<20 || space.Space.Height < 1 || space.Space.Height > 1<<20 || int64(space.Space.Width)*int64(space.Space.Height) > 1<<22 {
		return errors.New("invalid combat identity or topology")
	}
	ids := map[string]bool{}
	cells := map[Cell]bool{}
	for _, a := range s.Actors {
		if err := validateCombatantTactics(a, r); err != nil {
			return err
		}
		if err := validateExplosiveStock(a); err != nil {
			return err
		}
		if len(a.ID) > 256 || len(a.Team) > 256 || len(a.Weapon.ID) > 256 || a.MaxHP > 1000000 || a.Armor > 1000000 || a.Ammo > 1000000 || a.ReserveAmmo > 1000000 || a.Medkits > 10000 || a.Weapon.Damage > 1000000 || a.Weapon.RangeMM > 10000000 || a.Weapon.Magazine > 1000000 || a.Weapon.AttackAP > 100 || a.Initiative < -1000000 || a.Initiative > 1000000 {
			return errors.New("combatant stat bounds exceeded")
		}
		if a.ID == "" || a.Team == "" || ids[a.ID] || a.MaxHP < 1 || a.HP < 0 || a.HP > a.MaxHP || a.AP < 0 || a.AP > r.APPerTurn || a.Armor < 0 || a.Skill < 0 || a.Skill > 100 || a.Courage < 0 || a.Courage > 100 || a.Ammo < 0 || a.Ammo > a.Weapon.Magazine || a.ReserveAmmo < 0 || a.Medkits < 0 || a.Weapon.Damage < 0 || a.Weapon.RangeMM < 0 || a.Weapon.AttackAP < 0 || a.Weapon.Magazine < 0 {
			return fmt.Errorf("invalid combatant %s", a.ID)
		}
		if !space.standable(a.Position) || cells[a.Position] {
			return fmt.Errorf("invalid combat position %s", a.ID)
		}
		cells[a.Position] = true
		ids[a.ID] = true
		if a.Weapon.Damage > 0 && (a.Weapon.RangeMM < 1 || a.Weapon.AttackAP < 1) {
			return fmt.Errorf("invalid combat weapon %s", a.ID)
		}
		if len(a.Contacts) > 512 {
			return errors.New("combat contact capacity exceeded")
		}
		seen := map[string]bool{}
		for _, c := range a.Contacts {
			if c.SubjectID == "" || len(c.SubjectID) > 256 || seen[c.SubjectID] || c.ObservedTurn < 1 || c.ObservedTurn > s.Turn || c.ReceivedTurn < c.ObservedTurn || c.ReceivedTurn > s.Turn || c.ObservedAction > s.ActionSeq || c.CheckedTurn < 0 || c.CheckedTurn > s.Turn || c.CheckedAction > s.ActionSeq || c.Radius < 0 || c.Radius > 1000000 || c.ThreatDamage < 0 || c.ThreatDamage > 1000000 || c.ThreatRangeMM < 0 || c.ThreatRangeMM > 10000000 || c.Position.X < 0 || c.Position.X >= space.Space.Width || c.Position.Y < 0 || c.Position.Y >= space.Space.Height {
				return errors.New("invalid combat contact")
			}
			seen[c.SubjectID] = true
		}
	}
	if s.Active && !s.Actors[s.CurrentIndex].Able() {
		return errors.New("incapable current combat actor")
	}
	if len(s.Events) > 512 {
		return errors.New("combat event capacity exceeded")
	}
	previousEvent := uint64(0)
	for _, e := range s.Events {
		if e.Sequence == 0 || e.Sequence <= previousEvent || e.Sequence > s.EventSeq || e.Turn > s.Turn || e.Turn < 1 || e.AmmoSpent < 0 || e.MedkitsSpent < 0 || e.WeaponUses < 0 || e.ItemsSpent < 0 || e.AmmoSpent > 1000000 || e.MedkitsSpent > 10000 || e.WeaponUses > 1000000 || e.ItemsSpent > 10000 || e.ArmorBlocked < 0 || e.ArmorBlocked > 2000000 {
			return errors.New("invalid combat event clock/resource")
		}
		previousEvent = e.Sequence
	}
	if len(s.Events) > 0 && previousEvent != s.EventSeq || len(s.Events) == 0 && s.EventSeq != 0 {
		return errors.New("combat event cursor does not match durable tail")
	}
	return nil
}

func combatContact(a *Combatant, id string) *CombatContact {
	for i := range a.Contacts {
		if a.Contacts[i].SubjectID == id {
			return &a.Contacts[i]
		}
	}
	return nil
}
func combatContactNewer(c CombatContact, old *CombatContact) bool {
	if old == nil {
		return true
	}
	if c.ObservedTurn != old.ObservedTurn {
		return c.ObservedTurn > old.ObservedTurn
	}
	if c.ObservedAction != old.ObservedAction {
		return c.ObservedAction > old.ObservedAction
	}
	return c.Checked && (!old.Checked || c.CheckedTurn > old.CheckedTurn || c.CheckedAction > old.CheckedAction)
}
func (s *CombatState) remember(a *Combatant, c CombatContact) {
	if old := combatContact(a, c.SubjectID); old != nil {
		if c.ObservedTurn < old.ObservedTurn || (c.ObservedTurn == old.ObservedTurn && c.ObservedAction < old.ObservedAction) {
			return
		}
		if c.Source != "sight" && old.Visible {
			return
		}
		if c.Source != "sight" && !combatContactNewer(c, old) {
			return
		}
		*old = c
		return
	}
	if len(a.Contacts) < 512 {
		a.Contacts = append(a.Contacts, c)
	}
	sort.Slice(a.Contacts, func(i, j int) bool { return a.Contacts[i].SubjectID < a.Contacts[j].SubjectID })
}

// Observe never copies unseen current coordinates into a contact. Empty last
// known locations can be checked, but do not reveal where a subject moved.
func (s *CombatState) Observe(space CombatSpace, r CombatRules) {
	for i := range s.Actors {
		a := &s.Actors[i]
		kept := a.Contacts[:0]
		for _, c := range a.Contacts {
			if s.Turn-c.ObservedTurn <= r.MemoryTurns {
				c.Visible = false
				kept = append(kept, c)
			}
		}
		a.Contacts = kept
		if !a.Able() {
			continue
		}
		for _, other := range s.Actors {
			if a.ID == other.ID || a.Team == other.Team || !space.ActorVisible(*a, other, r) {
				continue
			}
			c := CombatContact{SubjectID: other.ID, Team: other.Team, Position: other.Position, ObservedTurn: s.Turn, ObservedAction: s.ActionSeq, ReceivedTurn: s.Turn, Source: "sight", SourceID: a.ID, Visible: true, ThreatDamage: other.Weapon.Damage, ThreatRangeMM: other.Weapon.RangeMM}
			if !other.Able() {
				c.Checked = true
				c.CheckedTurn, c.CheckedAction = s.Turn, s.ActionSeq
			}
			s.remember(a, c)
		}
		for j := range a.Contacts {
			c := &a.Contacts[j]
			if !c.Visible && !c.Checked && space.visible(a.Position, c.Position, r) {
				c.Checked = true
				c.CheckedTurn, c.CheckedAction = s.Turn, s.ActionSeq
			}
		}
	}
}
func (s *CombatState) event(e CombatEvent) {
	e.Turn = s.Turn
	s.EventSeq++
	e.Sequence = s.EventSeq
	s.Events = append(s.Events, e)
	if len(s.Events) > 512 {
		s.Events = append([]CombatEvent(nil), s.Events[len(s.Events)-512:]...)
	}
}
func (s *CombatState) finishIfResolved() {
	teams := map[string]bool{}
	for _, a := range s.Actors {
		if a.Able() {
			teams[a.Team] = true
		}
	}
	if len(teams) > 1 {
		return
	}
	s.Active = false
	s.Winner = "draw"
	for team := range teams {
		s.Winner = team
	}
}

// Passive losses occur once at the beginning of that actor's own turn. They
// produce durable events, so a reload cannot erase bleeding or suppression.
func (s *CombatState) beginTurn(r CombatRules) bool {
	a := &s.Actors[s.CurrentIndex]
	a.Overwatch = false
	a.Guarding = false
	a.ReservedAP = 0
	if !a.Able() {
		return false
	}
	if a.Bleeding > 0 {
		damage := min(a.Bleeding, a.HP)
		a.HP -= damage
		a.Morale = max(0, a.Morale-int(math.Ceil(float64(damage)*50/float64(a.MaxHP))))
		s.event(CombatEvent{Type: "bleed", ActorID: a.ID, TargetID: a.ID, From: a.Position, To: a.Position, Amount: damage, Hit: true, Reason: "persistent untreated bleeding"})
		if !a.Able() {
			a.Prone = true
			a.Crouched = false
			a.AP = 0
			a.Bleeding = 0
			s.finishIfResolved()
			return false
		}
	}
	if a.StunTurns > 0 {
		a.StunTurns--
		a.AP = 0
		s.event(CombatEvent{Type: "stunned", ActorID: a.ID, TargetID: a.ID, From: a.Position, To: a.Position, Amount: 1, Reason: "recovering from a concussive blow"})
		return false
	}
	penalty := 0
	if r.SuppressionPerAP > 0 {
		penalty = a.Suppression / r.SuppressionPerAP
	}
	penalty += (a.HeadWound+a.ArmWound)/50 + a.LegWound/25
	a.AP = max(1, r.APPerTurn-penalty)
	a.Suppression = max(0, a.Suppression-r.SuppressionRecovery)
	a.Morale = min(100, a.Morale+r.MoraleRecovery)
	return true
}
func (s *CombatState) nextTurn(r CombatRules) {
	s.finishIfResolved()
	if !s.Active {
		return
	}
	// StunTurns is bounded by ten, so even a whole stunned team cannot turn
	// this loop into an unbounded wait or be incorrectly declared a draw.
	for n := 0; n < len(s.Actors)*11; n++ {
		s.CurrentIndex = (s.CurrentIndex + 1) % len(s.Actors)
		if !s.Actors[s.CurrentIndex].Able() {
			continue
		}
		s.Turn++
		if s.beginTurn(r) {
			return
		}
		if !s.Active {
			return
		}
	}
	s.Active = false
	s.Winner = "draw"
}
func (s CombatState) occupied(at Cell, except string, space CombatSpace, r CombatRules, observer Cell, knownOnly bool) bool {
	for _, a := range s.Actors {
		if a.ID != except && a.Position == at && (!knownOnly || space.visible(observer, a.Position, r)) {
			return true
		}
	}
	return false
}

type combatReach struct {
	At     Cell
	MM, AP int
	Path   []Cell
}

func combatMovementScale(a Combatant) int {
	scale := 100 + a.LegWound
	if a.Prone {
		scale *= 2
	}
	return scale
}
func combatMoveUnitsAP(units int64, r CombatRules) int {
	return int((units*int64(r.MoveAPPerMeter) + 99999) / 100000)
}
func combatActorMoveAP(mm int, r CombatRules, a Combatant) int {
	return combatMoveUnitsAP(int64(mm)*int64(combatMovementScale(a)), r)
}

// Bounded Dijkstra is shared by preview and execution. Links use the same host
// metric as ordinary steps; the host supplies physical distances on stairs.
func (s CombatState) reachable(space CombatSpace, r CombatRules, a Combatant, maxAP int, planning bool) ([]combatReach, bool) {
	type node struct {
		at Cell
		mm int
	}
	open := []node{{a.Position, 0}}
	best := map[Cell]int{a.Position: 0}
	prev := map[Cell]Cell{}
	closed := map[Cell]bool{}
	var results []combatReach
	for len(open) > 0 && len(results) < r.MaxSearchCells {
		pick := 0
		for i := 1; i < len(open); i++ {
			if open[i].mm < open[pick].mm || (open[i].mm == open[pick].mm && (open[i].at.Y < open[pick].at.Y || open[i].at.Y == open[pick].at.Y && open[i].at.X < open[pick].at.X)) {
				pick = i
			}
		}
		n := open[pick]
		open = append(open[:pick], open[pick+1:]...)
		if closed[n.at] || best[n.at] != n.mm {
			continue
		}
		closed[n.at] = true
		var path []Cell
		for at := n.at; at != a.Position; at = prev[at] {
			path = append(path, at)
		}
		for i, j := 0, len(path)-1; i < j; i, j = i+1, j-1 {
			path[i], path[j] = path[j], path[i]
		}
		results = append(results, combatReach{n.at, n.mm, combatActorMoveAP(n.mm, r, a), path})
		neighbors := []Cell{{n.at.X + 1, n.at.Y}, {n.at.X, n.at.Y + 1}, {n.at.X - 1, n.at.Y}, {n.at.X, n.at.Y - 1}}
		neighbors = append(neighbors, space.Space.Links[n.at]...)
		for _, to := range neighbors {
			if !space.standable(to) || s.occupied(to, a.ID, space, r, a.Position, planning) || (space.Space.Occupied != nil && (!planning || space.visible(a.Position, to, r)) && space.Space.Occupied(to)) || to == a.Position {
				continue
			}
			if n.at == a.Position && space.Space.FirstStepAllowed != nil && !space.Space.FirstStepAllowed(to) {
				continue
			}
			cost := space.rangeMM(n.at, to)
			if cost < 1 {
				continue
			}
			mm := n.mm + cost
			if combatActorMoveAP(mm, r, a) > maxAP {
				continue
			}
			if old, ok := best[to]; ok && old <= mm {
				continue
			}
			best[to] = mm
			prev[to] = n.at
			open = append(open, node{to, mm})
		}
	}
	return results, len(open) > 0
}
func (s CombatState) movement(space CombatSpace, r CombatRules, a Combatant, to Cell) (combatReach, error) {
	if to == a.Position {
		return combatReach{}, errors.New("already at combat destination")
	}
	options, truncated := s.reachable(space, r, a, a.AP, false)
	for _, p := range options {
		if p.At == to {
			return p, nil
		}
	}
	if truncated {
		return combatReach{}, errors.New("combat route calculation budget exhausted")
	}
	return combatReach{}, errors.New("combat destination blocked or exceeds AP")
}
func combatOnSegment(p, a, b Cell) bool {
	// A conservative capsule around the actual cell-centre shot segment.
	x, y := float64(p.X-a.X), float64(p.Y-a.Y)
	dx, dy := float64(b.X-a.X), float64(b.Y-a.Y)
	length := dx*dx + dy*dy
	if length == 0 {
		return false
	}
	t := (x*dx + y*dy) / length
	return t > 0 && t < 1 && math.Hypot(x-t*dx, y-t*dy) < .45
}
func combatWeaponKind(w CombatWeapon) string {
	if w.Kind != "" {
		return w.Kind
	}
	if w.Magazine > 0 {
		return "firearm"
	}
	return "blunt"
}
func validateCombatantTactics(a Combatant, r CombatRules) error {
	for _, n := range []int{a.BodyArmor.Head, a.BodyArmor.Torso, a.BodyArmor.Arms, a.BodyArmor.Legs} {
		if n < 0 || n > 1000000 {
			return errors.New("invalid physical body armour")
		}
	}

	w := a.Weapon
	if w.Kind != "" && w.Kind != "blunt" && w.Kind != "blade" && w.Kind != "firearm" {
		return errors.New("unknown combat weapon kind")
	}
	for _, n := range []int{w.AimAP, w.BurstAP, w.QuickAP, w.HeavyAP} {
		if n < 0 || n > 100 {
			return errors.New("invalid weapon mode cost")
		}
	}
	if len(w.AmmoDefinition) > 256 || w.AimBonus < 0 || w.AimBonus > 100 || w.BurstSize < 0 || w.BurstSize > 10 || w.BurstSize == 1 || w.BurstPenalty < 0 || w.BurstPenalty > 100 || w.ParryPercent < 0 || w.ParryPercent > 90 || w.QuickDamagePercent < 0 || w.QuickDamagePercent > 300 || w.HeavyDamagePercent < 0 || w.HeavyDamagePercent > 300 || w.Suppression < 0 || w.Suppression > 1000 || w.Bleed < 0 || w.Bleed > 1000000 {
		return errors.New("invalid weapon mode parameters")
	}
	if w.AimAP > 0 && w.AimBonus == 0 || w.QuickAP > 0 && w.QuickDamagePercent == 0 || w.HeavyAP > 0 && w.HeavyDamagePercent == 0 {
		return errors.New("incomplete weapon mode")
	}
	if combatWeaponKind(w) == "firearm" && w.Magazine < 1 || combatWeaponKind(w) != "firearm" && w.Magazine > 0 {
		return errors.New("weapon kind and ammunition disagree")
	}
	if a.Bleeding < 0 || a.Bleeding > a.MaxHP || a.Suppression < 0 || a.Suppression > r.MaxSuppression || a.Morale < 0 || a.Morale > 100 || a.ReservedAP < 0 || a.ReservedAP > r.APPerTurn || a.HeadWound < 0 || a.HeadWound > 100 || a.ArmWound < 0 || a.ArmWound > 100 || a.LegWound < 0 || a.LegWound > 100 || a.StunTurns < 0 || a.StunTurns > 10 || a.WeaponUsesRemaining < 0 || a.WeaponUsesRemaining > 1000000 || a.Prone && a.Crouched {
		return errors.New("invalid tactical injury/pose/reserve")
	}
	if !a.Overwatch && !a.Guarding && a.ReservedAP != 0 || a.Overwatch && a.Guarding || a.Overwatch && (!a.Trained || combatWeaponKind(w) != "firearm") || a.Guarding && combatWeaponKind(w) == "firearm" || (a.Overwatch || a.Guarding) && (a.ReservedAP == 0 || a.WeaponUsesLimited && a.WeaponUsesRemaining == 0) {
		return errors.New("invalid reaction reserve")
	}
	return nil
}

type combatShotSpec struct {
	Mode, BodyPart                  string
	Aim, Shots, Cost, DamagePercent int
}

func combatShot(a Combatant, action CombatAction) (combatShotSpec, error) {
	q := combatShotSpec{Mode: action.Mode, BodyPart: action.BodyPart, Aim: action.Aim, Shots: 1, Cost: a.Weapon.AttackAP, DamagePercent: 100}
	if q.Mode == "" {
		q.Mode = "single"
	}
	if q.BodyPart == "" {
		q.BodyPart = "torso"
	}
	if q.BodyPart != "torso" && q.BodyPart != "head" && q.BodyPart != "arms" && q.BodyPart != "legs" {
		return q, errors.New("unknown attack body part")
	}
	if q.Aim < 0 || q.Aim > 3 || q.Mode != "aimed" && q.Aim != 0 {
		return q, errors.New("invalid aiming level")
	}
	kind := combatWeaponKind(a.Weapon)
	switch q.Mode {
	case "single":
	case "quick":
		if kind == "firearm" || a.Weapon.QuickAP < 1 {
			return q, errors.New("quick strike unavailable")
		}
		q.Cost = a.Weapon.QuickAP
		q.DamagePercent = a.Weapon.QuickDamagePercent
	case "heavy":
		if kind == "firearm" || a.Weapon.HeavyAP < 1 {
			return q, errors.New("heavy strike unavailable")
		}
		q.Cost = a.Weapon.HeavyAP
		q.DamagePercent = a.Weapon.HeavyDamagePercent
	case "aimed":
		if kind != "firearm" || a.Weapon.AimAP < 1 || q.Aim < 1 {
			return q, errors.New("aimed shot unavailable")
		}
		q.Cost += q.Aim * a.Weapon.AimAP
	case "burst":
		if kind != "firearm" || a.Weapon.BurstSize < 2 {
			return q, errors.New("burst unavailable")
		}
		q.Shots = a.Weapon.BurstSize
		q.Cost += a.Weapon.BurstAP
	default:
		return q, errors.New("unknown attack mode")
	}
	if a.WeaponUsesLimited && a.WeaponUsesRemaining < q.Shots {
		return q, errors.New("weapon condition insufficient for attack")
	}
	if kind == "firearm" && a.Ammo < q.Shots {
		return q, errors.New("attack ammunition insufficient")
	}
	return q, nil
}
func (s CombatSpace) protection(from, to Cell, a, b Combatant, part string) float64 {
	if s.Protection != nil {
		v := s.Protection(from, to, a, b, part)
		if math.IsNaN(v) || math.IsInf(v, 0) {
			return 1
		}
		return math.Max(0, math.Min(1, v))
	}
	c := s.cover(from, to, b.Crouched)
	if b.Prone && c > 0 {
		c = math.Min(1, c+(1-c)*.4)
	}
	return c
}
func (s CombatState) friendlyFire(space CombatSpace, r CombatRules, from Cell, a, target Combatant, planning bool, part string) bool {
	for _, b := range s.Actors {
		if planning && !space.ActorVisible(a, b, r) {
			continue
		}
		contains := combatOnSegment(b.Position, from, target.Position)
		if space.BodyOnShot != nil {
			contains = space.BodyOnShot(from, target.Position, b.Position)
		}
		if space.BodyIntersects != nil {
			contains = space.BodyIntersects(from, target.Position, a, target, b, part)
		}
		if b.ID != a.ID && b.ID != target.ID && b.Team == a.Team && b.HP > 0 && contains {
			return true
		}
	}
	return false
}
func (s CombatState) shotChance(space CombatSpace, r CombatRules, a, b Combatant, from Cell, q combatShotSpec, round int) float64 {
	distance := space.rangeMM(from, b.Position)
	falloff := 1 - .5*float64(distance)/float64(a.Weapon.RangeMM)
	chance := float64(a.Skill) / float64(a.Skill+b.Skill+1) * falloff * (1 - space.protection(from, b.Position, a, b, q.BodyPart))
	if a.Crouched {
		chance *= 1.08
	}
	if a.Prone && combatWeaponKind(a.Weapon) == "firearm" {
		chance *= 1.15
	}
	if b.Prone && space.Protection == nil && distance > 1500 {
		chance *= .75
	}
	if a.Guarding {
		chance *= .95
	}
	chance *= math.Max(.2, 1-float64(a.ArmWound)*.004-float64(a.HeadWound)*.002)
	if r.MaxSuppression > 0 {
		chance *= math.Max(.2, 1-float64(a.Suppression)*r.SuppressionAccuracyPenalty)
		chance *= .6 + .4*float64(a.Morale)/100
	}
	switch q.BodyPart {
	case "head":
		chance *= .55
	case "arms":
		chance *= .75
	case "legs":
		chance *= .8
	}
	if q.Mode == "aimed" {
		chance += float64(q.Aim*a.Weapon.AimBonus) / 100
	}
	if q.Mode == "burst" {
		chance -= float64(round*a.Weapon.BurstPenalty) / 100
	}
	if q.Mode == "quick" {
		chance *= 1.08
	}
	if q.Mode == "heavy" {
		chance *= .85
	}
	if combatWeaponKind(a.Weapon) != "firearm" && b.Guarding && b.ReservedAP >= r.GuardAP && r.GuardAP > 0 && b.StunTurns == 0 && space.visible(b.Position, from, r) && (!b.WeaponUsesLimited || b.WeaponUsesRemaining > 0) {
		chance *= 1 - float64(b.Weapon.ParryPercent)/100
	}
	return math.Max(r.MinHit, math.Min(r.MaxHit, chance))
}
func (s CombatState) hitChance(space CombatSpace, r CombatRules, a, b Combatant, from Cell) float64 {
	return s.shotChance(space, r, a, b, from, combatShotSpec{Mode: "single", BodyPart: "torso", Shots: 1, DamagePercent: 100}, 0)
}
func (s CombatState) canAttackAction(space CombatSpace, r CombatRules, a, b Combatant, from Cell, ap int, planning bool, action CombatAction) (combatShotSpec, bool) {
	q, err := combatShot(a, action)
	if err != nil {
		return q, false
	}
	c := combatContact(&a, b.ID)
	valid := !a.Noncombatant && a.Able() && a.StunTurns == 0 && b.Able() && a.Team != b.Team && a.Weapon.Damage > 0 && ap >= q.Cost && c != nil && c.Visible && space.ActorVisible(Combatant{Position: from, Prone: a.Prone, Crouched: a.Crouched, HP: a.HP}, b, r) && space.rangeMM(from, b.Position) <= a.Weapon.RangeMM && space.protection(from, b.Position, a, b, q.BodyPart) < 1 && space.shotClear(from, b.Position) && !s.friendlyFire(space, r, from, a, b, planning, q.BodyPart)
	return q, valid
}
func (s CombatState) canAttack(space CombatSpace, r CombatRules, a, b Combatant, from Cell, ap int, planning bool) bool {
	_, ok := s.canAttackAction(space, r, a, b, from, ap, planning, CombatAction{Type: "attack"})
	return ok
}

// ApplyDamage applies one resolved physical impact. It never draws random
// numbers or creates observations; callers emit their own accepted outcome.
func (s *CombatState) ApplyDamage(space CombatSpace, r CombatRules, sourceID, targetID string, rawDamage, bleed, suppression int, bodyPart string) int {
	b := s.Actor(targetID)
	if b == nil || b.HP <= 0 {
		return 0
	}
	damage := max(0, combatPartDamage(rawDamage, bodyPart)-b.Armor-b.BodyArmor.At(bodyPart))
	damage = min(damage, b.HP)
	oldPenalty := 0
	if r.SuppressionPerAP > 0 {
		oldPenalty = b.Suppression / r.SuppressionPerAP
	}
	b.Suppression = min(r.MaxSuppression, b.Suppression+max(0, suppression))
	newPenalty := 0
	if r.SuppressionPerAP > 0 {
		newPenalty = b.Suppression / r.SuppressionPerAP
	}
	b.AP = max(0, b.AP-max(0, newPenalty-oldPenalty))
	b.ReservedAP = max(0, b.ReservedAP-max(0, newPenalty-oldPenalty))
	if b.ReservedAP == 0 {
		b.Overwatch = false
		b.Guarding = false
	}
	b.HP -= damage
	if damage > 0 {
		wound := int(math.Ceil(float64(damage) * 100 / float64(b.MaxHP)))
		switch bodyPart {
		case "head":
			b.HeadWound = min(100, b.HeadWound+wound)
		case "arms":
			b.ArmWound = min(100, b.ArmWound+wound)
		case "legs":
			b.LegWound = min(100, b.LegWound+wound)
		}
		b.Bleeding = min(b.MaxHP, b.Bleeding+max(0, bleed))
		b.Morale = max(0, b.Morale-(wound+1)/2)
	}
	b.Morale = max(0, b.Morale-max(0, suppression)/4)
	if b.HP <= 0 {
		b.Prone = true
		b.Crouched = false
		b.AP = 0
		b.Bleeding = 0
		b.ReservedAP = 0
		b.Overwatch = false
		b.Guarding = false
	}
	if damage > 0 && b.HP <= 0 {
		for i := range s.Actors {
			ally := &s.Actors[i]
			if ally.ID != b.ID && ally.Team == b.Team && ally.Able() && space.visible(ally.Position, b.Position, r) {
				ally.Morale = max(0, ally.Morale-20)
			}
		}
	}
	return damage
}
func (s *CombatState) gunshot(space CombatSpace, r CombatRules, a Combatant) {
	for i := range s.Actors {
		other := &s.Actors[i]
		if !other.Able() || other.ID == a.ID || other.Team == a.Team || space.rangeMM(other.Position, a.Position) > r.HearingRangeMM || space.ActorVisible(*other, a, r) {
			continue
		}
		if space.CanHear != nil && !space.CanHear(*other, a) {
			continue
		}
		// A heard source has no actor identity. Coarse location is quantized, never
		// the exact cell plus a question mark. No faction or hidden weapon is sent.
		pos := Cell{a.Position.X / 3 * 3, a.Position.Y / 3 * 3}
		s.remember(other, CombatContact{SubjectID: "noise." + strconv.FormatUint(s.ActionSeq, 10), Position: pos, ObservedTurn: s.Turn, ObservedAction: s.ActionSeq, ReceivedTurn: s.Turn, Source: "hearing", SourceID: other.ID, Radius: 3})
	}
}

// fireImpact resolves one projectile or strike from an already accepted action.
// A burst has separate events/resource debits for every projectile; ActionSeq
// remains the command/RNG clock while EventSeq orders all consequences.
func (s *CombatState) fireImpact(space CombatSpace, r CombatRules, actorID, targetID string, q combatShotSpec, round int, eventType string, cost int) {
	a, b := s.Actor(actorID), s.Actor(targetID)
	chance := s.shotChance(space, r, *a, *b, a.Position, q, round)
	if combatWeaponKind(a.Weapon) != "firearm" && b.Guarding && r.GuardAP > 0 && b.ReservedAP >= r.GuardAP && space.visible(b.Position, a.Position, r) && (!b.WeaponUsesLimited || b.WeaponUsesRemaining > 0) {
		b.ReservedAP -= r.GuardAP
		if b.WeaponUsesLimited {
			b.WeaponUsesRemaining--
		}
		s.event(CombatEvent{Type: "parry", ActorID: b.ID, TargetID: a.ID, From: b.Position, To: a.Position, AP: r.GuardAP, WeaponUses: 1, Reason: "guarded weapon deflection attempt"})
		if b.ReservedAP == 0 || b.WeaponUsesLimited && b.WeaponUsesRemaining == 0 {
			b.Guarding = false
			b.ReservedAP = 0
		}
	}
	if a.WeaponUsesLimited {
		a.WeaponUsesRemaining--
	}
	e := CombatEvent{Type: eventType, ActorID: actorID, TargetID: targetID, From: a.Position, To: b.Position, AP: cost, BodyPart: q.BodyPart, WeaponUses: 1}
	if a.Weapon.Magazine > 0 {
		a.Ammo--
		e.AmmoSpent = 1
	}
	stream := "combat.v2/" + s.ID + "/" + strconv.FormatUint(s.ActionSeq, 10) + "/" + eventType + "/" + targetID + "/" + strconv.Itoa(round) + "/" + strconv.FormatUint(s.EventSeq, 10)
	roll := float64(CounterRandom(s.Seed, a.ID, s.Turn, stream+"/hit")>>11) * (1.0 / (1 << 53))
	e.Hit = roll < chance
	raw := 0
	if e.Hit {
		spread := r.DamageMin + (r.DamageMax-r.DamageMin)*float64(CounterRandom(s.Seed, a.ID, s.Turn, stream+"/damage")>>11)*(1.0/(1<<53))
		raw = int(math.Round(float64(a.Weapon.Damage) * float64(q.DamagePercent) / 100 * spread))
		e.Reason = "hit"
	} else {
		e.Reason = "miss"
	}
	bleed := a.Weapon.Bleed
	if combatWeaponKind(a.Weapon) == "blunt" {
		bleed = 0
	}
	e.ArmorBlocked = CombatArmorBlocked(*b, raw, q.BodyPart)
	e.Amount = s.ApplyDamage(space, r, a.ID, b.ID, raw, bleed, a.Weapon.Suppression, q.BodyPart)
	if e.Hit && e.Amount >= max(1, b.MaxHP/5) && combatWeaponKind(a.Weapon) == "blunt" && q.Mode == "heavy" && q.BodyPart == "head" && b.HP > 0 {
		b.StunTurns = max(b.StunTurns, 1)
	}
	s.event(e)
	if a.Weapon.Magazine > 0 {
		s.gunshot(space, r, *a)
		// Near impacts also threaten bodies that really occupy that area. This is
		// execution-only physics; their hidden positions never enter the scorer.
		if a.Weapon.Suppression > 0 {
			for i := range s.Actors {
				other := &s.Actors[i]
				if other.ID != a.ID && other.ID != b.ID && other.HP > 0 && space.rangeMM(other.Position, b.Position) <= 1000 && space.shotClear(a.Position, other.Position) {
					s.ApplyDamage(space, r, a.ID, other.ID, 0, 0, a.Weapon.Suppression/2, "torso")
				}
			}
		}
	}
}
func (s *CombatState) reactionWindow(space CombatSpace, r CombatRules, actorID string) {
	target := s.Actor(actorID)
	if target == nil || !target.Able() {
		return
	}
	for i := range s.Actors {
		watcher := &s.Actors[i]
		if watcher.ID == actorID || watcher.Team == target.Team || !watcher.Able() || watcher.StunTurns > 0 || (!watcher.Overwatch && !watcher.Guarding) || watcher.ReservedAP < watcher.Weapon.AttackAP || watcher.WeaponUsesLimited && watcher.WeaponUsesRemaining == 0 {
			continue
		}
		if watcher.Overwatch && (!watcher.Trained || combatWeaponKind(watcher.Weapon) != "firearm") || watcher.Guarding && combatWeaponKind(watcher.Weapon) == "firearm" {
			continue
		}
		s.Observe(space, r)
		q, ok := s.canAttackAction(space, r, *watcher, *target, watcher.Position, watcher.ReservedAP, false, CombatAction{Type: "attack"})
		if !ok || space.ExecutionShotBlocked != nil && space.ExecutionShotBlocked(watcher.Position, target.Position) {
			continue
		}
		watcher.ReservedAP -= q.Cost
		s.fireImpact(space, r, watcher.ID, target.ID, q, 0, "reaction", q.Cost)
		if watcher.ReservedAP == 0 || watcher.WeaponUsesLimited && watcher.WeaponUsesRemaining == 0 {
			watcher.Overwatch = false
			watcher.Guarding = false
			watcher.ReservedAP = 0
		}
		s.finishIfResolved()
		if !s.Active || !target.Able() || target.StunTurns > 0 {
			return
		}
	}
}

// AfterAction is shared with the explosive executor. Triggered fire is bounded
// by physical reserves and never recursively triggers more reactions.
func (s *CombatState) AfterAction(space CombatSpace, r CombatRules, actorID string, action CombatAction) {
	a := s.Actor(actorID)
	s.finishIfResolved()
	if s.Active && action.Type != "move" && action.Type != "end" && action.Type != "surrender" && action.Type != "overwatch" && action.Type != "guard" {
		s.reactionWindow(space, r, actorID)
	}
	s.finishIfResolved()
	if s.Active && (action.Type == "end" || action.Type == "surrender" || !a.Able() || a.AP == 0 || a.StunTurns > 0) {
		s.nextTurn(r)
	}
	if s.Active {
		s.Observe(space, r)
	}
}

// Execute checks the entire requested action before changing AP, RNG counters,
// ammunition, health or positions. Failed inputs cannot reroll or advance turns.
func (s *CombatState) Execute(space CombatSpace, r CombatRules, actorID string, action CombatAction) error {
	if action.Type == "throw" {
		return s.executeThrow(space, r, actorID, action)
	}
	if err := r.Validate(); err != nil {
		return err
	}
	a := s.Current()
	if a == nil || a.ID != actorID || !a.Able() || a.StunTurns > 0 {
		return errors.New("not the current combat actor")
	}
	observed := s.Clone()
	observed.Observe(space, r)
	actor := observed.Actor(actorID)
	if actor.WeaponUsesRemaining > 0 {
		actor.WeaponUsesLimited = true
	}
	var destination combatReach
	cost := 0
	var target *Combatant
	var shot combatShotSpec
	switch action.Type {
	case "move":
		var err error
		destination, err = observed.movement(space, r, *actor, action.To)
		if err != nil {
			return err
		}
		cost = destination.AP
	case "attack":
		target = observed.Actor(action.TargetID)
		var ok bool
		if target != nil {
			shot, ok = observed.canAttackAction(space, r, *actor, *target, actor.Position, actor.AP, false, action)
		}
		if !ok {
			return errors.New("attack unavailable: mode, target, sight, range, AP, ammo, condition or friendly fire")
		}
		if space.ExecutionShotBlocked != nil && space.ExecutionShotBlocked(actor.Position, target.Position) {
			return ErrCombatExecutionBlocked
		}
		cost = shot.Cost
	case "reload":
		if actor.Weapon.Magazine < 1 || actor.ReserveAmmo < 1 || actor.Ammo >= actor.Weapon.Magazine {
			return errors.New("reload unavailable")
		}
		cost = r.ReloadAP
	case "heal":
		if actor.Medkits < 1 || actor.HP >= actor.MaxHP {
			return errors.New("healing unavailable")
		}
		cost = r.HealAP
	case "bandage":
		id := action.TargetID
		if id == "" {
			id = actorID
		}
		target = observed.Actor(id)
		if r.BandageAP < 1 || actor.Medkits < 1 || target == nil || target.Team != actor.Team || target.HP <= 0 || target.Bleeding < 1 || space.rangeMM(actor.Position, target.Position) > 1000 || !space.visible(actor.Position, target.Position, r) {
			return errors.New("bandaging unavailable")
		}
		cost = r.BandageAP
	case "crouch":
		if actor.Crouched {
			return errors.New("already crouched")
		}
		cost = r.CrouchAP
	case "prone":
		if actor.Prone || r.ProneAP < 1 {
			return errors.New("prone stance unavailable")
		}
		cost = r.ProneAP
	case "stand":
		if !actor.Crouched && !actor.Prone {
			return errors.New("already standing")
		}
		cost = r.CrouchAP
		if actor.Prone {
			cost = r.ProneAP
		}
	case "guard":
		if r.GuardAP < 1 || combatWeaponKind(actor.Weapon) == "firearm" || actor.Noncombatant || actor.Weapon.Damage < 1 || actor.AP <= r.GuardAP || actor.WeaponUsesLimited && actor.WeaponUsesRemaining == 0 {
			return errors.New("guard reserve unavailable")
		}
		cost = r.GuardAP
	case "overwatch":
		if r.ReactionAP < 1 || !actor.Trained || actor.Noncombatant || combatWeaponKind(actor.Weapon) != "firearm" || actor.Ammo < 1 || actor.AP < r.ReactionAP+actor.Weapon.AttackAP || actor.WeaponUsesLimited && actor.WeaponUsesRemaining == 0 {
			return errors.New("overwatch reserve unavailable")
		}
		cost = r.ReactionAP
	case "report":
		target = observed.Actor(action.TargetID)
		if !actor.Trained || target == nil || !target.Able() || target.Team != actor.Team || target.ID == actor.ID || !space.canCommunicate(*actor, *target, r) {
			return errors.New("report channel unavailable")
		}
		useful := false
		for _, c := range actor.Contacts {
			if c.Team != actor.Team && c.Source != "hearing" && combatContactNewer(c, combatContact(target, c.SubjectID)) {
				useful = true
			}
		}
		if !useful {
			return errors.New("no new report information")
		}
		cost = r.ReportAP
	case "surrender", "end":
	default:
		return errors.New("unknown combat action")
	}
	if actor.AP < cost {
		return errors.New("insufficient combat AP")
	}
	*s = observed
	a = s.Actor(actorID)
	s.ActionSeq++
	if action.Type == "move" {
		spent := 0
		distanceUnits := int64(0)
		old := a.Position
		for _, to := range destination.Path {
			segment := space.rangeMM(a.Position, to)
			nextUnits := distanceUnits + int64(segment)*int64(combatMovementScale(*a))
			nextSpent := combatMoveUnitsAP(nextUnits, r)
			delta := nextSpent - spent
			if !a.Able() || a.StunTurns > 0 || a.AP < delta {
				break
			}
			from := a.Position
			a.Position = to
			a.AP -= delta
			distanceUnits = nextUnits
			spent = nextSpent
			s.event(CombatEvent{Type: "move", ActorID: actorID, From: from, To: to, AP: delta, Amount: segment, Reason: "authoritative reachable path step"})
			s.Observe(space, r)
			s.reactionWindow(space, r, actorID)
			if !s.Active || !a.Able() || a.StunTurns > 0 {
				break
			}
		}
		if a.Position != destination.At {
			s.event(CombatEvent{Type: "move_stop", ActorID: actorID, From: old, To: a.Position, Reason: "route interrupted after actual travelled distance"})
		}
	} else {
		a.AP -= cost
		e := CombatEvent{Type: action.Type, ActorID: actorID, TargetID: action.TargetID, From: a.Position, To: a.Position, AP: cost}
		switch action.Type {
		case "attack":
			for round := 0; round < shot.Shots; round++ {
				shotCost := 0
				if round == 0 {
					shotCost = cost
				}
				s.fireImpact(space, r, actorID, action.TargetID, shot, round, "attack", shotCost)
			}
		case "reload":
			amount := min(a.Weapon.Magazine-a.Ammo, a.ReserveAmmo)
			a.Ammo += amount
			a.ReserveAmmo -= amount
			e.Amount = amount
			s.event(e)
		case "heal":
			amount := min(r.HealAmount, a.MaxHP-a.HP)
			a.HP += amount
			a.Medkits--
			e.Amount = amount
			e.MedkitsSpent = 1
			s.event(e)
		case "bandage":
			b := s.Actor(target.ID)
			amount := min(r.BandageAmount, b.Bleeding)
			b.Bleeding -= amount
			a.Medkits--
			e.TargetID = b.ID
			e.To = b.Position
			e.Amount = amount
			e.MedkitsSpent = 1
			s.event(e)
		case "crouch":
			a.Crouched = true
			a.Prone = false
			s.event(e)
		case "prone":
			a.Prone = true
			a.Crouched = false
			s.event(e)
		case "stand":
			a.Prone = false
			a.Crouched = false
			s.event(e)
		case "guard":
			a.Guarding = true
			a.ReservedAP = a.AP
			a.AP = 0
			e.Amount = a.ReservedAP
			s.event(e)
		case "overwatch":
			a.Overwatch = true
			a.ReservedAP = a.AP
			a.AP = 0
			e.Amount = a.ReservedAP
			s.event(e)
		case "surrender":
			a.Surrendered = true
			a.AP = 0
			a.Overwatch = false
			a.Guarding = false
			a.ReservedAP = 0
			s.event(e)
		case "end":
			a.AP = 0
			s.event(e)
		case "report":
			b := s.Actor(action.TargetID)
			for _, c := range a.Contacts {
				if c.Team == a.Team || c.Source == "hearing" {
					continue
				}
				c.Visible = false
				c.Source = "report"
				c.ReporterID = a.ID
				c.ReceivedTurn = s.Turn
				s.remember(b, c)
			}
			s.event(e)
		}
	}
	s.AfterAction(space, r, actorID, action)
	return nil
}

type CombatCandidate struct {
	Action CombatAction
	Score  float64
	Reason string
	AP     int
}
type CombatDecision struct {
	ActorID    string
	Chosen     CombatCandidate
	Candidates []CombatCandidate
	Truncated  bool
}

func (s CombatState) threatAt(space CombatSpace, r CombatRules, a Combatant, at Cell) float64 {
	risk := 0.0
	for _, c := range a.Contacts {
		if c.Checked || c.Source == "hearing" || c.Team == a.Team || c.ThreatDamage < 1 {
			continue
		}
		age := s.Turn - c.ObservedTurn
		certainty := 1 - float64(age)/float64(r.MemoryTurns+1)
		distance := space.rangeMM(c.Position, at)
		if distance > c.ThreatRangeMM || !space.shotClear(c.Position, at) {
			continue
		}
		damage := float64(c.ThreatDamage)
		protection := space.cover(c.Position, at, a.Crouched)
		if a.Prone && protection > 0 {
			protection = math.Min(1, protection+(1-protection)*.4)
		}
		if r.MaxSuppression > 0 {
			damage = float64(max(0, c.ThreatDamage-a.Armor-a.BodyArmor.Torso)) * .5
		}
		risk += certainty * damage * (1 - protection)
	}
	return risk
}
func combatVisibleHostileDistance(space CombatSpace, a Combatant, at Cell) int {
	d := math.MaxInt
	for _, c := range a.Contacts {
		if c.Visible && !c.Checked && c.Team != a.Team && c.Source == "sight" {
			d = min(d, space.rangeMM(at, c.Position))
		}
	}
	return d
}
func (s CombatState) bestAttack(space CombatSpace, r CombatRules, a Combatant, from Cell, ap int) (CombatCandidate, bool) {
	var best CombatCandidate
	found := false
	for _, contact := range a.Contacts {
		if !contact.Visible || contact.Checked || contact.Source != "sight" || contact.SourceID != a.ID || contact.ObservedTurn != s.Turn || contact.ObservedAction != s.ActionSeq {
			continue
		}
		known := s.Actor(contact.SubjectID)
		if known == nil || known.Position != contact.Position {
			continue
		}
		// Exact hidden resources never affect planning, including a visible target's
		// true armour/health/skill. Pose and held weapon are legitimate observations.
		estimate := *known
		estimate.Skill = r.EstimatedDefense
		estimate.Armor = 0
		estimate.BodyArmor = CombatArmor{}
		estimate.HP, estimate.MaxHP = 1, 1
		estimate.HeadWound, estimate.ArmWound, estimate.LegWound = 0, 0, 0
		estimate.Suppression, estimate.Morale = 0, 0
		estimate.StunTurns = 0
		estimate.WeaponUsesLimited = false
		estimate.WeaponUsesRemaining = 0
		// A guard pose is public; exact reserved AP and remaining item durability are
		// private. Conservatively estimate one legal deflection from that pose.
		if estimate.Guarding {
			estimate.ReservedAP = r.GuardAP
		} else {
			estimate.ReservedAP = 0
		}
		actions := []CombatAction{{Type: "attack", TargetID: known.ID}}
		if combatWeaponKind(a.Weapon) == "firearm" {
			if a.Weapon.AimAP > 0 {
				for aim := 1; aim <= 3; aim++ {
					actions = append(actions, CombatAction{Type: "attack", TargetID: known.ID, Mode: "aimed", Aim: aim})
				}
			}
			if a.Weapon.BurstSize > 1 {
				actions = append(actions, CombatAction{Type: "attack", TargetID: known.ID, Mode: "burst"})
			}
		} else {
			if a.Weapon.QuickAP > 0 {
				actions = append(actions, CombatAction{Type: "attack", TargetID: known.ID, Mode: "quick"})
			}
			if a.Weapon.HeavyAP > 0 {
				actions = append(actions, CombatAction{Type: "attack", TargetID: known.ID, Mode: "heavy"}, CombatAction{Type: "attack", TargetID: known.ID, Mode: "heavy", BodyPart: "head"})
			}
		}
		for _, action := range actions {
			q, ok := s.canAttackAction(space, r, a, estimate, from, ap, true, action)
			if !ok {
				continue
			}
			damage := float64(a.Weapon.Damage) * float64(q.DamagePercent) / 100 * (r.DamageMin + r.DamageMax) / 2
			part := 1.0
			switch q.BodyPart {
			case "head":
				part = 1.65
			case "arms":
				part = .75
			case "legs":
				part = .85
			}
			expected := 0.0
			for round := 0; round < q.Shots; round++ {
				chance := s.shotChance(space, r, a, estimate, from, q, round)
				expected += chance * damage * part
			}
			repeats := max(1, ap/q.Cost)
			if a.Weapon.Magazine > 0 {
				repeats = min(repeats, a.Ammo/q.Shots)
			}
			if a.WeaponUsesLimited {
				repeats = min(repeats, a.WeaponUsesRemaining/q.Shots)
			}
			score := expected * float64(repeats) * r.AttackWeight
			if a.Weapon.Suppression > 0 && r.MaxSuppression > 0 {
				score += float64(q.Shots*a.Weapon.Suppression) * .15 * r.AttackWeight
			}
			if q.Mode == "heavy" && q.BodyPart == "head" && combatWeaponKind(a.Weapon) == "blunt" {
				score += s.shotChance(space, r, a, estimate, from, q, 0) * float64(contact.ThreatDamage) * .4 * r.AttackWeight
			}
			c := CombatCandidate{Action: action, Score: score, Reason: "legal observed attack with remaining-turn AP, condition and control value", AP: q.Cost}
			if !found || c.Score > best.Score+1e-9 || math.Abs(c.Score-best.Score) < 1e-9 && (c.AP < best.AP || c.AP == best.AP && c.Action.TargetID < best.Action.TargetID) {
				best = c
				found = true
			}
		}
	}
	return best, found
}

// Decide evaluates a bounded set of reachable positions and immediate actions.
// It does not mutate state or consume random numbers. Only known contacts feed
// exposure/search; a hidden actor's new location never generates a candidate.
func (s CombatState) Decide(space CombatSpace, r CombatRules) CombatDecision {
	copyState := s.Clone()
	copyState.Observe(space, r)
	s = copyState
	a := s.Current()
	if a == nil {
		return CombatDecision{}
	}
	d := CombatDecision{ActorID: a.ID}
	add := func(c CombatCandidate) { d.Candidates = append(d.Candidates, c) }
	baseline := s.threatAt(space, r, *a, a.Position)
	add(CombatCandidate{CombatAction{Type: "end"}, 0, "retain position and finish turn", 0})
	advanced := r.MaxSuppression > 0 || r.GuardAP > 0
	nearest := combatVisibleHostileDistance(space, *a, a.Position)
	outmatched := a.Noncombatant || a.HP*3 < a.MaxHP || advanced && (baseline > float64(a.HP)*.65 || a.Morale < 25 || a.Suppression > r.MaxSuppression*2/3 && r.MaxSuppression > 0)
	if c, ok := s.bestAttack(space, r, *a, a.Position, a.AP); ok {
		if outmatched && baseline > float64(a.HP)*.65 {
			c.Score *= .4
			c.Reason = "attack discounted against known overwhelming reply"
		}
		add(c)
	}
	for _, c := range s.explosiveCandidates(space, r, *a) {
		add(c)
	}
	if r.BandageAP > 0 && a.Medkits > 0 && a.AP >= r.BandageAP {
		for _, b := range s.Actors {
			if b.Team != a.Team || b.HP <= 0 || b.Bleeding <= 0 || space.rangeMM(a.Position, b.Position) > 1000 || !space.visible(a.Position, b.Position, r) {
				continue
			}
			value := float64(r.BandageAmount) * r.HealWeight
			if b.ID == a.ID {
				value = float64(max(r.HealAmount, min(a.Bleeding*4, a.HP))) * 1.25 * r.HealWeight
			}
			value -= baseline * r.CoverWeight * float64(r.BandageAP) / float64(r.APPerTurn)
			add(CombatCandidate{CombatAction{Type: "bandage", TargetID: b.ID}, value, "stop observed continuing bleeding with a carried dressing", r.BandageAP})
		}
	}
	if !a.Noncombatant && r.GuardAP > 0 && combatWeaponKind(a.Weapon) != "firearm" && a.AP > r.GuardAP && nearest <= a.Weapon.RangeMM && (!a.WeaponUsesLimited || a.WeaponUsesRemaining > 0) {
		reserve := a.AP - r.GuardAP
		value := baseline * float64(a.Weapon.ParryPercent) / 100 * r.CoverWeight
		if reserve >= a.Weapon.AttackAP {
			value += float64(a.Weapon.Damage) * .3 * r.AttackWeight
		}
		add(CombatCandidate{CombatAction{Type: "guard"}, value, "hold remaining AP for a deflection and a legal close-range riposte", r.GuardAP})
	}
	if !a.Noncombatant && a.Trained && r.ReactionAP > 0 && combatWeaponKind(a.Weapon) == "firearm" && a.AP >= r.ReactionAP+a.Weapon.AttackAP && a.Ammo > 0 && nearest <= a.Weapon.RangeMM && (!a.WeaponUsesLimited || a.WeaponUsesRemaining > 0) {
		value := float64(a.Weapon.Damage) * .3 * r.AttackWeight
		add(CombatCandidate{CombatAction{Type: "overwatch"}, value, "reserve real AP and ammunition for an observed crossing", r.ReactionAP})
	}
	if a.Prone && a.AP >= r.ProneAP && (nearest <= 2500 || a.Weapon.Magazine == 0) {
		add(CombatCandidate{CombatAction{Type: "stand"}, baseline*r.CoverWeight + float64(a.Weapon.Damage)*.4, "stand to defend against a nearby melee threat or move efficiently", r.ProneAP})
	}
	if !a.Prone && r.ProneAP > 0 && a.AP >= r.ProneAP && nearest > 2500 && baseline > 0 {
		prone := *a
		prone.Prone = true
		prone.Crouched = false
		value := (baseline - s.threatAt(space, r, prone, a.Position)) * r.CoverWeight
		if attack, ok := s.bestAttack(space, r, prone, a.Position, a.AP-r.ProneAP); ok {
			value += attack.Score * .6
		}
		if value > 0 {
			add(CombatCandidate{CombatAction{Type: "prone"}, value, "lower exposed profile without lying down in melee reach", r.ProneAP})
		}
	}
	if a.Medkits > 0 && a.HP < a.MaxHP && a.AP >= r.HealAP {
		heal := min(r.HealAmount, a.MaxHP-a.HP)
		need := 1 - float64(a.HP)/float64(a.MaxHP)
		opportunity := baseline * r.CoverWeight * float64(r.HealAP) / float64(r.APPerTurn)
		add(CombatCandidate{CombatAction{Type: "heal"}, float64(heal)*r.HealWeight*(.5+need) - opportunity, "recover health while accounting for known exposure", r.HealAP})
	}
	if !a.Noncombatant && a.Ammo < a.Weapon.Magazine && a.ReserveAmmo > 0 && a.AP >= r.ReloadAP {
		value := float64(a.Weapon.Damage) * .35 * r.AttackWeight
		if a.Ammo == 0 {
			value = float64(a.Weapon.Damage) * r.AttackWeight
		}
		add(CombatCandidate{CombatAction{Type: "reload"}, value, "restore ammunition before another attack", r.ReloadAP})
	}
	if !a.Crouched && !a.Prone && a.AP >= r.CrouchAP && baseline > 0 {
		crouched := *a
		crouched.Crouched = true
		crouched.Prone = false
		gain := baseline - s.threatAt(space, r, crouched, a.Position)
		if gain > 0 {
			add(CombatCandidate{CombatAction{Type: "crouch"}, gain * r.CoverWeight, "reduce exposed body behind known cover", r.CrouchAP})
		}
	}
	for _, b := range s.Actors {
		if !a.Trained || !b.Able() || b.ID == a.ID || b.Team != a.Team || a.AP < r.ReportAP || !space.canCommunicate(*a, b, r) {
			continue
		}
		useful := false
		for _, c := range a.Contacts {
			old := combatContact(&b, c.SubjectID)
			if c.Source != "hearing" && combatContactNewer(c, old) {
				useful = true
			}
		}
		if useful {
			add(CombatCandidate{CombatAction{Type: "report", TargetID: b.ID}, float64(a.Weapon.Damage) * .5 * r.AttackWeight, "deliver missing observation through available channel", r.ReportAP})
		}
	}
	reachable, truncated := s.reachable(space, r, *a, a.AP, true)
	d.Truncated = truncated
	for _, at := range reachable {
		if at.At == a.Position {
			continue
		}
		risk := s.threatAt(space, r, *a, at.At)
		pathRisk := risk
		if advanced {
			for _, step := range at.Path {
				pathRisk = math.Max(pathRisk, s.threatAt(space, r, *a, step))
			}
		}
		gain := (baseline-risk)*r.CoverWeight - float64(at.AP)*r.MoveWeight
		if advanced {
			gain -= math.Max(0, pathRisk-math.Max(baseline, risk)) * r.CoverWeight
		}
		if advanced && combatWeaponKind(a.Weapon) == "firearm" {
			// The gun's reach is an advantage, not an invitation to walk up to a club.
			for _, contact := range a.Contacts {
				if !contact.Visible || contact.Checked || contact.Team == a.Team || contact.ThreatRangeMM >= a.Weapon.RangeMM {
					continue
				}
				desired := min(a.Weapon.RangeMM*2/3, contact.ThreatRangeMM+2000)
				distance := space.rangeMM(at.At, contact.Position)
				if distance < desired {
					gain -= float64(desired-distance) / 1000 * float64(contact.ThreatDamage) * .4
				}
			}
		}
		reason := "move to reduce known exposure"
		score := gain
		if advanced && !outmatched && nearest != math.MaxInt && combatWeaponKind(a.Weapon) != "firearm" {
			progress := float64(nearest-combatVisibleHostileDistance(space, *a, at.At)) / 1000
			score += progress * float64(a.Weapon.Damage) * .12 * r.AttackWeight
			if progress > 0 {
				reason = "close a known hostile without crossing excessive known threat"
			}
		}
		if !a.Noncombatant {
			if attack, ok := s.bestAttack(space, r, *a, at.At, a.AP-at.AP); ok {
				score = attack.Score + gain
				if outmatched && risk > float64(a.HP)*.65 {
					score -= risk * r.RetreatWeight
				}
				reason = "move with AP reserved for a legal attack"
			}
		}
		if outmatched {
			nearestFrom, nearestTo := math.MaxInt, math.MaxInt
			for _, c := range a.Contacts {
				if c.Checked || c.Team == a.Team {
					continue
				}
				nearestFrom = min(nearestFrom, space.rangeMM(a.Position, c.Position))
				nearestTo = min(nearestTo, space.rangeMM(at.At, c.Position))
			}
			if nearestFrom != math.MaxInt {
				score += (float64(nearestTo-nearestFrom) / 1000) * r.RetreatWeight
				reason = "increase separation from known danger"
			}
		}
		if a.Medkits > 0 && a.HP < a.MaxHP && a.AP-at.AP >= r.HealAP {
			need := 1 - float64(a.HP)/float64(a.MaxHP)
			heal := float64(min(r.HealAmount, a.MaxHP-a.HP)) * r.HealWeight * (.5 + need)
			opportunity := risk * r.CoverWeight * float64(r.HealAP) / float64(r.APPerTurn)
			candidate := gain + heal - opportunity
			if candidate > score {
				score = candidate
				reason = "reach cover with AP reserved for treatment"
			}
		}
		add(CombatCandidate{CombatAction{Type: "move", To: at.At}, score, reason, at.AP})
	}
	// Search uses last-known/noise areas, not hidden targets. Prefer unseen
	// positions near a checked report, and stop once that uncertainty is exhausted.
	visibleEnemy := false
	for _, c := range a.Contacts {
		if c.Visible && !c.Checked && c.Team != a.Team {
			visibleEnemy = true
		}
	}
	if !visibleEnemy && !a.Noncombatant {
		for _, c := range a.Contacts {
			if c.Team == a.Team {
				continue
			}
			for _, at := range reachable {
				if at.At == a.Position {
					continue
				}
				distance := space.rangeMM(at.At, c.Position)
				if c.Checked && (distance > 3*space.CellMM || space.visible(a.Position, at.At, r)) {
					continue
				}
				progress := float64(space.rangeMM(a.Position, c.Position)-distance) / 1000
				score := progress*.5 + 1 - float64(at.AP)*r.MoveWeight - s.threatAt(space, r, *a, at.At)*r.CoverWeight
				if c.Checked {
					score = 1 - float64(distance)/float64(space.CellMM)*.1 - float64(at.AP)*r.MoveWeight
				}
				add(CombatCandidate{CombatAction{Type: "move", To: at.At}, score, "investigate last known or heard area without hidden target tracking", at.AP})
			}
		}
	}
	if (a.HP*5 < a.MaxHP && a.Courage < 30 || advanced && a.Morale < 10) && baseline > 0 {
		// Surrender only when no positive escape or survival choice remains.
		escape := false
		for _, c := range d.Candidates {
			if c.Action.Type == "move" && c.Score > 0 {
				escape = true
			}
		}
		if !escape {
			add(CombatCandidate{CombatAction{Type: "surrender"}, 1, "critically wounded and no evaluated safe escape", 0})
		}
	}
	sort.SliceStable(d.Candidates, func(i, j int) bool {
		a, b := d.Candidates[i], d.Candidates[j]
		if math.Abs(a.Score-b.Score) > 1e-9 {
			return a.Score > b.Score
		}
		if a.AP != b.AP {
			return a.AP < b.AP
		}
		if a.Action.Type != b.Action.Type {
			return a.Action.Type < b.Action.Type
		}
		if a.Action.TargetID != b.Action.TargetID {
			return a.Action.TargetID < b.Action.TargetID
		}
		if a.Action.Mode != b.Action.Mode {
			return a.Action.Mode < b.Action.Mode
		}
		if a.Action.Aim != b.Action.Aim {
			return a.Action.Aim < b.Action.Aim
		}
		if a.Action.BodyPart != b.Action.BodyPart {
			return a.Action.BodyPart < b.Action.BodyPart
		}
		if a.Action.ItemID != b.Action.ItemID {
			return a.Action.ItemID < b.Action.ItemID
		}
		if a.Action.To.Y != b.Action.To.Y {
			return a.Action.To.Y < b.Action.To.Y
		}
		return a.Action.To.X < b.Action.To.X
	})
	d.Chosen = d.Candidates[0]
	return d
}
func (s *CombatState) StepAI(space CombatSpace, r CombatRules) error {
	a := s.Current()
	if a == nil {
		return nil
	}
	if a.Controlled {
		return errors.New("current combat actor is controlled")
	}
	d := s.Decide(space, r)
	if err := s.Execute(space, r, a.ID, d.Chosen.Action); err != nil {
		if errors.Is(err, ErrCombatExecutionBlocked) {
			if endErr := s.Execute(space, r, a.ID, CombatAction{Type: "end"}); endErr != nil {
				return endErr
			}
			if len(s.Events) > 0 {
				s.Events[len(s.Events)-1].Reason = "shot interrupted by a body during execution; no ammunition or attack AP spent"
			}
			return nil
		}
		return err
	}
	if len(s.Events) > 0 {
		for i := len(s.Events) - 1; i >= 0; i-- {
			if s.Events[i].ActorID == a.ID && s.Events[i].Type == d.Chosen.Action.Type {
				s.Events[i].Reason = d.Chosen.Reason
				break
			}
		}
	}
	return nil
}
func (s *CombatState) RunAI(space CombatSpace, r CombatRules) error {
	// Every non-end action costs AP. This bound cannot silently end a healthy
	// actor's turn if a future zero-cost operation is added accidentally.
	limit := len(s.Actors) * r.MaxActionsPerTurn
	for n := 0; n < limit; n++ {
		a := s.Current()
		if a == nil || a.Controlled {
			return nil
		}
		if err := s.StepAI(space, r); err != nil {
			return err
		}
	}
	return errors.New("combat AI action budget exhausted")
}
