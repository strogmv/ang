func(r *Runtime)validateLiftingDecks(s state)error{
 count:=0;if r.world.LiftingDecks!=nil{for _,d:=range r.world.LiftingDecks.Decks{count++;g,ok:=s.LiftingDecks[d.ID];if !ok{return fmt.Errorf("missing lifting deck %s",d.ID)};if g.UpdatedNS<0||g.StartNS<0||g.StartNS>g.UpdatedNS||g.DurationNS<0||g.NextRunSecond<0||g.Runs<0||g.Stops<0||g.RunSlotSecond<0||g.FreightRun<0||g.FreightRun>g.Runs||g.FreightNextSecond<0||g.FreightLandedSecond<0||g.FreightLandedSecond>s.Life.Seconds||g.LowerArriveSecond<0||g.LowerSettleNS<0||g.LowerSettleNS>g.UpdatedNS||(d.Lower==nil&&(g.LowerAway||g.LowerArriveSecond!=0||g.LowerSettleNS!=0))||(!g.LowerAway&&g.LowerArriveSecond!=0){return fmt.Errorf("invalid lifting deck state %s",d.ID)};p:=g.pose(g.UpdatedNS);for _,n:=range []int64{p.Leaves,p.Deck,p.Barrier,p.Unlock,p.Damper,p.Release}{if n<0||n>liftingDeckFull{return fmt.Errorf("lifting deck pose out of range %s",d.ID)}};if p.Deck>0&&p.Leaves<liftingDeckFull{return fmt.Errorf("lifting deck interlock %s",d.ID)}}};if len(s.LiftingDecks)!=count{return fmt.Errorf("lifting deck catalog/state mismatch")};return nil
}

// This existing input-style Life command is for native mechanism proofs only;
// no player screen exposes it. The server still chooses the complete sequence.
func(r *Runtime)requestLiftingDeckCycle(id string)error{
 if r.world.LiftingDecks==nil{return fmt.Errorf("no lifting decks")}
 for _,d:=range r.world.LiftingDecks.Decks{if d.ID!=id||d.LevelID!=r.currentLevel(){continue};if !d.Manual{return fmt.Errorf("not a manual lifting deck")};g:=r.state.LiftingDecks[id];if g.Phase!="rest"||r.state.Life.LocationLockdown[d.LevelID]||r.state.Life.LocationPowerLost[d.LevelID]{return textError{Key:"error.lifting_deck.lockdown"}};g.CycleRequested=true;g.NextRunSecond=r.state.Life.Seconds;r.state.LiftingDecks[id]=g;return nil};return fmt.Errorf("unknown current-level lifting deck")
}

func(r *Runtime)routeLiftingDeckRider(a *behavior.LifeActor,target behavior.Cell){
 a.Manual=true;a.OverrideLevel="";a.OverrideEdge="";a.Goal=target;a.Arrived=false
 model:=r.state.Life.GateModel(r.world.Life);r.state.Life.EnsureHeroBody(model)
 if a.Body!=nil{r.state.Life.HeroBodyRouteTo(model,target)}else{a.Path=model.Space(a.Level,r.state.Life.BlockedCells(a.Level,a.ID)).Path(a.Position,target,behavior.Cell{},0);a.MoveStartTick=r.lifeMotionTick()}
}
func(r *Runtime)routeQueuedLowerLiftingDeckRiders(d liftingDeckDefinition){
 edge:=r.world.Life.Edge(d.ReturnEdge);if edge==nil||d.Lower==nil{return};g:=r.state.LiftingDecks[d.ID]
 for _,id:=range g.PendingRiders{a:=r.state.Life.Actor(id);if a==nil||!a.OnFloor()||a.Level!=d.Lower.LevelID||a.Position==edge.Exit||!a.Manual{continue};if a.Goal!=edge.Exit{r.routeLiftingDeckRider(a,edge.Exit)}}
}
func(r *Runtime)routeQueuedLiftingDeckRiders(d liftingDeckDefinition){
 edge:=r.world.Life.Edge(d.TravelEdge);if edge==nil{return};g:=r.state.LiftingDecks[d.ID]
 for _,id:=range g.PendingRiders{a:=r.state.Life.Actor(id);if a==nil||!a.OnFloor()||a.Level!=d.LevelID||a.Position==edge.Exit{continue};if a.Goal!=edge.Exit{r.routeLiftingDeckRider(a,edge.Exit)}}
}


// Typed visible cargo is derived from actual inventory custody. One cassette
// represents one finite delivery consignment, never the entire shop reserve.
func(r *Runtime)liftingDeckCargo(d liftingDeckDefinition,g liftingDeckState)[]*pb.PocLiftingDeckCargo{
 if d.Freight==nil{return nil};var rows []*pb.PocLiftingDeckCargo
 for _,route:=range d.Freight.Routes{for _,stage:=range []string{"deck","receiving"}{
  store:=route.DeckStore;position:=append([]float64(nil),route.DeckPlan...);if stage=="receiving"{store=route.ReceivingStore;position=append([]float64(nil),route.ReceivingPlan...)}else{position[1]-=d.DepthM*(1-float64(g.pose(g.UpdatedNS).Deck)/float64(liftingDeckFull))}
  row:=&pb.PocLiftingDeckCargo{Id:route.DeliveryID,Stage:stage,PositionM:position};known:=true
  for id,item:=range r.state.Inventory.Items{if item.Location!=(inv.Location{Kind:"store",Store:store})||item.Quantity<1{continue};row.ItemIds=append(row.ItemIds,id);row.Quantity+=item.Quantity;def,ok:=r.world.Inventory.Definitions[item.Definition];if !ok||def.Mass<=0{known=false}else{row.MassG+=def.Mass*item.Quantity}}
  if row.Quantity==0{continue};sort.Strings(row.ItemIds);if !known{row.MassG=-1};rows=append(rows,row)
 }};return rows
}
func(r *Runtime)liftingDeckFreightWithConvoy(d liftingDeckDefinition)bool{
 if d.Freight==nil||d.Freight.ConvoyID==""||r.world.CargoConvoys==nil{return false}
 for _,v:=range r.world.CargoConvoys.Convoys{if v.ID==d.Freight.ConvoyID{c:=r.state.CargoConvoys[v.ID];return r.cargoConvoyCarries(v,c)||(c.Phase=="lower_on_deck"&&r.state.LiftingDecks[d.ID].FreightRun==r.state.LiftingDecks[d.ID].Runs)}}
 return false
}
func(r *Runtime)advanceLiftingDeckFreight()error{
 if r.world.LiftingDecks==nil{return nil}
 model:=r.inventoryModelFor(true)
 for _,d:=range r.world.LiftingDecks.Decks{f:=d.Freight;if f==nil{continue};g:=r.state.LiftingDecks[d.ID]
  if g.Runs>g.FreightRun&&g.RunSlotSecond>=g.FreightNextSecond&&g.RunSlotSecond>=f.FirstSecond&&(g.RunSlotSecond-f.FirstSecond)%f.PeriodSeconds==0{
   work:=r.state.Inventory.Clone()
   for _,route:=range f.Routes{var delivery *inv.Delivery;for i:=range model.Deliveries{if model.Deliveries[i].ID==route.DeliveryID{delivery=&model.Deliveries[i];break}};if delivery==nil{return fmt.Errorf("unknown incoming delivery %s",route.DeliveryID)}
    if _,err:=work.MoveMachineConsignment(model,delivery.Carrier,route.CopperStore,route.DeckStore,delivery.Definition,route.Quantity,fmt.Sprintf("%s/load/%d",d.ID,g.Runs));err!=nil{return err}
   }
   r.state.Inventory=work;g.FreightRun=g.Runs;g.FreightNextSecond=f.FirstSecond+((g.RunSlotSecond-f.FirstSecond)/f.PeriodSeconds+1)*f.PeriodSeconds
  }
  // Freight inside a convoy trailer waits for its crew; loose freight lands by the old machine rule.
  if g.Phase=="loading"&&g.UpdatedNS-g.StartNS>=f.UnloadAfterS*1000000000&&!r.liftingDeckFreightWithConvoy(d){
   work:=r.state.Inventory.Clone();landed:=false
   for _,route:=range f.Routes{var delivery *inv.Delivery;for i:=range model.Deliveries{if model.Deliveries[i].ID==route.DeliveryID{delivery=&model.Deliveries[i];break}};if delivery==nil{return fmt.Errorf("unknown incoming delivery %s",route.DeliveryID)}
    cargo,err:=work.MoveMachineConsignment(model,delivery.Carrier,route.DeckStore,route.ReceivingStore,delivery.Definition,route.Quantity,fmt.Sprintf("%s/unload/%d",d.ID,g.Runs));if err!=nil{return err};landed=landed||len(cargo)>0
   }
   if landed{r.state.Inventory=work;g.FreightLandedSecond=r.state.Life.Seconds;g.FreightLandedNS=g.UpdatedNS}
  }
  r.state.LiftingDecks[d.ID]=g
 }
 return nil
}


// Only a new accepted player movement/travel intent cancels a queued ride.
// Internal routing to a loading deck does not call this ordinary input hook.
func(r *Runtime)cancelQueuedLiftingDeckRide(actorID string){
 for id,g:=range r.state.LiftingDecks{pending:=make([]string,0,len(g.PendingRiders));for _,rider:=range g.PendingRiders{if rider!=actorID{pending=append(pending,rider)}};g.PendingRiders=pending;r.state.LiftingDecks[id]=g}
}
