func (s *LifeState) beginTraffic() bool {
 if s.trafficActive{return false}
 n:=len(s.Actors)+len(s.Population.Actors)
 if s.traffic==nil||len(s.traffic.bodies)!=n||s.traffic.named!=len(s.Actors){s.traffic=&lifeTraffic{cells:map[trafficCell][]int{},bodies:make([]trafficBody,n),named:len(s.Actors),current:-1}}
 for i:=0;i<n;i++{s.syncTrafficBody(i)}
 s.trafficActive=true;return true
}
func(s *LifeState) endTraffic(owned bool){if owned{s.syncTrafficCurrent();s.traffic.current=-1;s.trafficActive=false}}
func(s *LifeState) syncTrafficCurrent(){if s.traffic!=nil&&s.traffic.current>=0{s.syncTrafficBody(s.traffic.current)}}
