// Code generated by ANG. Physical light for perception, independent of graphics settings.
package poc

import (
	behavior "angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"errors"
	"fmt"
	"math"
	"strings"
)

type illuminationModes struct {
	Day   float64 `json:"day"`
	Dusk  float64 `json:"dusk"`
	Night float64 `json:"night"`
}
type illuminationWeights struct{ Guide, Day, Dusk, Night float64 }
type illuminationCalendar struct {
	DawnStart     int64   `json:"dawn_start"`
	DayStart      int64   `json:"day_start"`
	DayEnd        int64   `json:"day_end"`
	NightStart    int64   `json:"night_start"`
	FadeSeconds   int64   `json:"fade_seconds"`
	GuideExponent float64 `json:"guide_exponent"`
}

// Same optical transitions as the v13 bake. The CUE clock is game time, not wall time.
func (c illuminationCalendar) weights(seconds int64) illuminationWeights {
	t := float64((seconds%86400 + 86400) % 86400)
	ramp := func(a, b float64) float64 {
		if b <= a {
			if t >= b {
				return 1
			}
			return 0
		}
		return math.Max(0, math.Min(1, (t-a)/(b-a)))
	}
	dawn, day, end, night := float64(c.DawnStart), float64(c.DayStart), float64(c.DayEnd), float64(c.NightStart)
	g := 0.0
	if t >= dawn && t < day {
		g = math.Pow(ramp(dawn, day), c.GuideExponent)
	} else if t >= day && t < end {
		g = 1
	} else if t >= end && t < night {
		g = math.Pow(1-ramp(end, night), c.GuideExponent)
	}
	half := float64(c.FadeSeconds) / 2
	d := ramp(day-half, day+half) * (1 - ramp(end-half, end+half))
	notNight := ramp(dawn-half, dawn+half) * (1 - ramp(night-half, night+half))
	return illuminationWeights{Guide: g, Day: d, Dusk: math.Max(0, notNight-d), Night: 1 - notNight}
}
func (m illuminationModes) weight(w illuminationWeights) float64 {
	return m.Day*w.Day + m.Dusk*w.Dusk + m.Night*w.Night
}

type illuminationEmitter struct {
	behavior.LightEmitter
	Kind            string            `json:"kind"`
	Mode            illuminationModes `json:"mode"`
	Daylight        bool              `json:"daylight"`
	PowerRef        string            `json:"power_ref"`
	StorefrontIDs   []string          `json:"storefront_ids"`
	VendingID       string            `json:"vending_id"`
	GateID          string            `json:"gate_id"`
	GateBackupPower bool              `json:"gate_backup_power"`
	GuideClean      float64           `json:"guide_clean"`
	InitialOn       bool              `json:"initial_on"`
	ActiveWindows   []struct {
		StartSecond int64 `json:"start_second"`
		EndSecond   int64 `json:"end_second"`
	} `json:"active_windows"`
}
type illuminationPowerLink struct {
	From string `json:"from"`
	To   string `json:"to"`
}
type illuminationGateLeaf struct {
	GateID   string              `json:"gate_id"`
	Node     string              `json:"node"`
	Closed   behavior.DeckRayBox `json:"closed"`
	TravelMM float64             `json:"travel_mm"`
}
type illuminationGeometryReplacement struct {
	Original behavior.DeckSpan     `json:"original"`
	Opaque   []behavior.DeckRayBox `json:"opaque"`
}
type illuminationLevel struct {
	Calendar             illuminationCalendar              `json:"calendar"`
	AmbientLux           illuminationModes                 `json:"ambient_lux"`
	DarkLux              float64                           `json:"dark_lux"`
	BrightLux            float64                           `json:"bright_lux"`
	MinVisibility        float64                           `json:"min_visibility"`
	Emitters             []illuminationEmitter             `json:"emitters"`
	PowerRefs            []string                          `json:"power_refs"`
	PowerLinks           []illuminationPowerLink           `json:"power_links"`
	StaticOccluders      []behavior.DeckRayBox             `json:"static_occluders"`
	GateLeaves           []illuminationGateLeaf            `json:"gate_leaves"`
	GeometryReplacements []illuminationGeometryReplacement `json:"geometry_replacements"`
	rays                 *behavior.DeckVolume
	opaque               []behavior.DeckRayBox
	parents              map[string][]string
	gates                map[string]sdkLightGate
}
type illuminationCatalog struct {
	Enabled bool                         `json:"enabled"`
	Levels  map[string]illuminationLevel `json:"levels"`
}

// Only explicit failed lighting feeds are saved. No invented load, battery or repair economy.
type illuminationState struct {
	Off map[string]map[string]bool `json:"off,omitempty"`
}

func (s illuminationState) Clone() illuminationState {
	if s.Off != nil {
		out := map[string]map[string]bool{}
		for level, refs := range s.Off {
			out[level] = map[string]bool{}
			for ref, v := range refs {
				out[level][ref] = v
			}
		}
		s.Off = out
	}
	return s
}
func illuminationFinite(v float64) bool { return !math.IsNaN(v) && !math.IsInf(v, 0) }
func illuminationPoint(p behavior.DeckPointMM) bool {
	return illuminationFinite(p.X) && illuminationFinite(p.Y) && illuminationFinite(p.Z) && math.Abs(p.X) <= 1e7 && math.Abs(p.Y) <= 1e7 && math.Abs(p.Z) <= 1e7
}
func illuminationBox(b behavior.DeckRayBox) bool {
	return illuminationPoint(b.Min) && illuminationPoint(b.Max) && b.Min.X < b.Max.X && b.Min.Y < b.Max.Y && b.Min.Z < b.Max.Z
}
func (r *Runtime) prepareIllumination() error {
	if !r.world.Illumination.Enabled {
		return nil
	}
	if len(r.world.Illumination.Levels) > len(r.world.Life.Locations) {
		return errors.New("too many illumination levels")
	}
	shops := map[string]bool{}
	for _, s := range r.world.Inventory.Shopfronts {
		shops[s.ID] = true
	}
	vms := map[string]bool{}
	for _, u := range r.world.Vending.Units {
		vms[u.ID] = true
	}
	for id, c := range r.world.Illumination.Levels {
		fail := func() error { return fmt.Errorf("invalid illumination catalog for %s", id) }
		v := r.world.Decks[id]
		if v == nil || r.world.Life.Locations[id].CellMM != 500 {
			return fail()
		}
		k := c.Calendar
		if k.DawnStart < 0 || k.DayStart <= k.DawnStart || k.DayEnd <= k.DayStart || k.NightStart <= k.DayEnd || k.NightStart > 86400 || k.FadeSeconds < 0 || k.FadeSeconds > 3600 || !(k.GuideExponent > 0 && k.GuideExponent <= 8) || !(c.DarkLux >= 0 && c.BrightLux > c.DarkLux && c.BrightLux <= 100000) || !(c.MinVisibility > 0 && c.MinVisibility <= 1) || len(c.Emitters) > 512 || len(c.PowerRefs) > 4096 || len(c.PowerLinks) > 8192 || len(c.StaticOccluders) > 4096 {
			return fail()
		}
		for _, lux := range []float64{c.AmbientLux.Day, c.AmbientLux.Dusk, c.AmbientLux.Night} {
			if !(lux >= 0 && lux <= 100000) {
				return fail()
			}
		}
		refs := map[string]bool{}
		for _, ref := range c.PowerRefs {
			if ref == "" || refs[ref] {
				return fail()
			}
			refs[ref] = true
		}
		c.parents = map[string][]string{}
		for _, link := range c.PowerLinks {
			if !refs[link.From] || !refs[link.To] || link.From == link.To {
				return fail()
			}
			c.parents[link.To] = append(c.parents[link.To], link.From)
		}
		// A feed dependency loop has no defined source; reject it rather than silently energizing it.
		mark := map[string]int{}
		var visit func(string) bool
		visit = func(ref string) bool {
			if mark[ref] == 1 {
				return false
			}
			if mark[ref] == 2 {
				return true
			}
			mark[ref] = 1
			for _, p := range c.parents[ref] {
				if !visit(p) {
					return false
				}
			}
			mark[ref] = 2
			return true
		}
		for ref := range refs {
			if !visit(ref) {
				return fail()
			}
		}
		gates := map[string]bool{}
		for _, g := range r.world.Life.Locations[id].Gates {
			gates[g.ID] = true
		}
		seen := map[string]bool{}
		for _, e := range c.Emitters {
			if e.ID == "" || seen[e.ID] || !illuminationPoint(e.At) || !illuminationPoint(e.Aim) || e.At.X < 0 || e.At.Y < 0 || e.At.X >= float64(v.PlanWidth*500) || e.At.Y >= float64(v.PlanDepth*500) || !(e.Lumens >= 0 && e.Lumens <= 1e7) || !(e.GuideClean >= 0 && e.GuideClean <= 1) || !(e.BeamDegrees >= 1 && e.BeamDegrees <= 360) || !(e.GlassTiltDegrees >= -90 && e.GlassTiltDegrees <= 90) {
				return fail()
			}
			seen[e.ID] = true
			switch e.Distribution {
			case "iso", "lambert_down", "wall_down":
			case "spot", "asym":
				if e.BeamDegrees > 170 {
					return fail()
				}
			default:
				return fail()
			}
			if e.Distribution != "iso" && e.At == e.Aim {
				return fail()
			}
			for _, factor := range []float64{e.Mode.Day, e.Mode.Dusk, e.Mode.Night} {
				if !(factor >= 0 && factor <= 1) {
					return fail()
				}
			}
			if e.Daylight {
				if e.PowerRef != "" {
					return fail()
				}
			} else if !refs[e.PowerRef] {
				return fail()
			}
			for _, shop := range e.StorefrontIDs {
				if !shops[shop] {
					return fail()
				}
			}
			if e.VendingID != "" && (!vms[e.VendingID] || id != r.world.Vending.Level) {
				return fail()
			}
			if e.GateID != "" && !gates[e.GateID] {
				return fail()
			}
			if e.GateBackupPower && e.GateID == "" {
				return fail()
			}
			for _, w := range e.ActiveWindows {
				if w.StartSecond < 0 || w.EndSecond <= w.StartSecond || w.EndSecond > 86400 {
					return fail()
				}
			}
		}
		for _, b := range c.StaticOccluders {
			if !illuminationBox(b) {
				return fail()
			}
		}
		c.gates = map[string]sdkLightGate{}
		for _, binding := range r.world.ModularLocations {
			if binding.LevelID != id {
				continue
			}
			for _, layout := range r.world.LocationSDK.Levels {
				if layout.ID == binding.LayoutID {
					for _, gate := range layout.Gates {
						c.gates[gate.ID] = gate
					}
				}
			}
		}
		leaves := map[string]bool{}
		for _, leaf := range c.GateLeaves {
			key := leaf.GateID + "/" + leaf.Node
			if !gates[leaf.GateID] || leaf.Node == "" || leaves[key] || !illuminationBox(leaf.Closed) || !(leaf.TravelMM >= 0 && leaf.TravelMM <= 200000) {
				return fail()
			}
			leaves[key] = true
		}
		expectedLeaves := 0
		for gateID := range gates {
			contract, ok := c.gates[gateID]
			if !ok || len(contract.Leaves) == 0 {
				return fail()
			}
			for _, expected := range contract.Leaves {
				expectedLeaves++
				matched := false
				for _, leaf := range c.GateLeaves {
					if leaf.GateID == gateID && leaf.Node == expected.Node {
						matched = leaf.TravelMM == float64(expected.TravelMM)
					}
				}
				if !matched {
					return fail()
				}
			}
		}
		if len(c.GateLeaves) != expectedLeaves {
			return fail()
		}
		// Navigation uses conservative occupancy boxes. Optical shells may
		// replace only an exact, uniquely matched authored solid; no source or
		// destination gets a special wall exception.
		optical := *v
		optical.Solids = append([]behavior.DeckSpan(nil), v.Solids...)
		if len(c.GeometryReplacements) > 512 {
			return fail()
		}
		used := map[behavior.DeckSpan]bool{}
		c.opaque = nil
		for _, replacement := range c.GeometryReplacements {
			if used[replacement.Original] || len(replacement.Opaque) == 0 || len(replacement.Opaque) > 256 {
				return fail()
			}
			used[replacement.Original] = true
			found := -1
			for i, solid := range optical.Solids {
				if solid == replacement.Original {
					if found >= 0 {
						return fail()
					}
					found = i
				}
			}
			if found < 0 {
				return fail()
			}
			optical.Solids = append(optical.Solids[:found], optical.Solids[found+1:]...)
			for _, box := range replacement.Opaque {
				if !illuminationBox(box) {
					return fail()
				}
				c.opaque = append(c.opaque, box)
			}
		}
		if err := optical.Prepare(); err != nil {
			return fail()
		}
		c.rays = &optical
		for _, e := range c.Emitters {
			if !c.rays.RayClearMM(e.At, e.At, append(append([]behavior.DeckRayBox(nil), c.StaticOccluders...), c.opaque...)) {
				return fmt.Errorf("buried illumination emitter %s in %s", e.ID, id)
			}
		}
		r.world.Illumination.Levels[id] = c
	}
	return nil
}
func (c illuminationLevel) powered(ref string, off map[string]bool) bool {
	if ref == "" || len(off) == 0 {
		return true
	}
	seen := map[string]bool{}
	pending := []string{ref}
	for len(pending) > 0 {
		n := pending[len(pending)-1]
		pending = pending[:len(pending)-1]
		if off[n] {
			return false
		}
		if seen[n] {
			continue
		}
		seen[n] = true
		pending = append(pending, c.parents[n]...)
	}
	return true
}
func (r *Runtime) illuminationSourceFactor(level string, c illuminationLevel, e illuminationEmitter, w illuminationWeights) float64 {
	if !e.InitialOn {
		return 0
	}
	if len(e.ActiveWindows) > 0 {
		t := (r.state.Life.Seconds%86400 + 86400) % 86400
		active := false
		for _, win := range e.ActiveWindows {
			active = active || (t >= win.StartSecond && t < win.EndSecond)
		}
		if !active {
			return 0
		}
	}
	if !e.GateBackupPower && !c.powered(e.PowerRef, r.state.Illumination.Off[level]) {
		return 0
	}
	if e.GateID != "" {
		g, ok := r.state.Life.Gates[e.GateID]
		if !ok || g.PowerLost && !e.GateBackupPower {
			return 0
		}
		if e.Kind == "signal" {
			active := false
			moving := g.Moving(g.Updated)
			for _, signal := range c.gates[e.GateID].Signals {
				if g.PowerLost && !signal.BackupPower {
					continue
				}
				for _, rule := range signal.Rules {
					if rule.State != g.State || rule.Cause != "" && rule.Cause != g.Cause || rule.Direction != 0 && rule.Direction != g.Direction || rule.Motion == "moving" && !moving || rule.Motion == "rest" && moving {
						continue
					}
					active = true
					break
				}
			}
			if !active {
				return 0
			}
		}

	}
	if len(e.StorefrontIDs) > 0 {
		open := false
		for _, id := range e.StorefrontIDs {
			open = open || r.storefrontOpen(id)
		}
		if !open {
			return 0
		}
	}
	if e.Daylight {
		return w.Guide
	}
	if e.VendingID != "" && strings.HasSuffix(e.ID, ".face") {
		for i, u := range r.world.Vending.Units {
			if u.ID != e.VendingID {
				continue
			}
			occupied := false
			atPanel := func(level string, at behavior.Cell, present bool) bool {
				if !present || level != r.world.Vending.Level {
					return false
				}
				for _, p := range u.Approach {
					if p.X == at.X && p.Y == at.Y {
						return true
					}
				}
				return false
			}
			for _, a := range r.state.Life.Actors {
				occupied = occupied || atPanel(a.Level, a.Position, a.OnFloor())
			}
			for _, a := range r.state.Life.Population.Actors {
				occupied = occupied || atPanel(a.Level, a.Position, a.Trip == nil)
			}
			return float64(r.vendingLamp(i, occupied)) / 1e6
		}
		return 0
	}
	return e.Mode.weight(w)
}
func (r *Runtime) illuminationBoxes(c illuminationLevel) []behavior.DeckRayBox {
	boxes := append(append([]behavior.DeckRayBox(nil), c.StaticOccluders...), c.opaque...)
	for _, leaf := range c.GateLeaves {
		g, ok := r.state.Life.Gates[leaf.GateID]
		if !ok {
			continue
		}
		box := leaf.Closed
		shift := leaf.TravelMM * float64(g.Position(g.Updated)) / 1e6
		box.Min.Z += shift
		box.Max.Z += shift
		boxes = append(boxes, box)
	}
	return boxes
}

// Immutable derived geometry only. Power, presence and calendar weights are
// evaluated afresh; a rollback/save never restores cached gameplay evidence.
type illuminationGeometryCache struct {
	Level    string
	Volume   *behavior.DeckVolume
	Points   [3]behavior.DeckPointMM
	Emitters []behavior.LightEmitter
	Boxes    []behavior.DeckRayBox
	Direct   [][3]float64
}

func (r *Runtime) illuminationGeometry(level string, c illuminationLevel, points [3]behavior.DeckPointMM, boxes []behavior.DeckRayBox) [][3]float64 {
	old := r.illuminationCache
	same := old != nil && old.Level == level && old.Volume == c.rays && old.Points == points && len(old.Emitters) == len(c.Emitters) && len(old.Boxes) == len(boxes)
	if same {
		for i, e := range c.Emitters {
			if old.Emitters[i] != e.LightEmitter {
				same = false
				break
			}
		}
	}
	if same {
		for i, b := range boxes {
			if old.Boxes[i] != b {
				same = false
				break
			}
		}
	}
	if same {
		return old.Direct
	}
	cache := &illuminationGeometryCache{Level: level, Volume: c.rays, Points: points, Boxes: append([]behavior.DeckRayBox(nil), boxes...), Direct: make([][3]float64, len(c.Emitters))}
	for i, e := range c.Emitters {
		cache.Emitters = append(cache.Emitters, e.LightEmitter)
		for j, p := range points {
			lux := behavior.DirectIlluminance(e.LightEmitter, p)
			if lux > 0 && c.rays.RayClearMM(e.At, p, boxes) {
				cache.Direct[i][j] = lux
			}
		}
	}
	r.illuminationCache = cache
	return cache.Direct
}

type illuminationBodySample struct {
	Known       bool
	Lux, Factor [3]float64
	Points      [3]behavior.DeckPointMM
	Weights     illuminationWeights
}

func (c illuminationLevel) visibility(lux float64) float64 {
	return math.Max(c.MinVisibility, math.Sqrt(math.Max(0, math.Min(1, (lux-c.DarkLux)/(c.BrightLux-c.DarkLux)))))
}

// One sample per hero per perception frame, shared by all observers. Body points
// are physical leg/torso/head heights; this is direct-light gameplay lux, not GI.
func (r *Runtime) illuminationBody(h *behavior.LifeActor) illuminationBodySample {
	out := illuminationBodySample{}
	if !r.world.Illumination.Enabled || h == nil || !h.OnFloor() {
		return out
	}
	c, ok := r.world.Illumination.Levels[h.Level]
	v := r.world.Decks[h.Level]
	if !ok || v == nil || c.rays == nil {
		return out
	}
	pose := behavior.Combatant{Crouched: h.Sneaking && !h.SneakUpright}
	if a := r.state.Combat.Actor(h.ID); r.state.Combat.Active && a != nil {
		pose.Crouched, pose.Prone = a.Crouched, a.Prone
	}
	points := v.BodyLightPoints(h.Position, pose)
	for i := range points {
		if h.Body != nil {
			points[i].X, points[i].Y = h.Body.X, h.Body.Y
		}
		if !illuminationPoint(points[i]) {
			return out
		}
	}
	out.Points = points
	out.Known = true
	out.Weights = c.Calendar.weights(r.state.Life.Seconds)
	ambient := c.AmbientLux.weight(out.Weights)
	boxes := r.illuminationBoxes(c)

	for i := range points {
		out.Lux[i] = ambient
	}
	direct := r.illuminationGeometry(h.Level, c, points, boxes)
	for index, e := range c.Emitters {
		factor := r.illuminationSourceFactor(h.Level, c, e, out.Weights)
		if factor <= 0 {
			continue
		}
		for i := range points {
			out.Lux[i] += direct[index][i] * factor
		}

	}
	for i := range points {
		out.Lux[i] = math.Min(1e8, out.Lux[i])
		out.Factor[i] = c.visibility(out.Lux[i])
	}

	return out
}
func (r *Runtime) appendIllumination(view *pb.PocLifeView, h *behavior.LifeActor) {
	s := r.illuminationBody(h)
	m := &pb.PocIllumination{Known: s.Known}
	view.Illumination = m
	if !s.Known {
		return
	}
	for i := range s.Lux {
		m.Lux += s.Lux[i] / 3
		m.VisibilityFactor += s.Factor[i] / 3
	}
	m.Guide, m.Day, m.Dusk, m.Night = s.Weights.Guide, s.Weights.Day, s.Weights.Dusk, s.Weights.Night
	c := r.world.Illumination.Levels[h.Level]
	m.State = "dim"
	if m.Lux <= c.DarkLux {
		m.State = "shadow"
	} else if m.Lux >= c.BrightLux {
		m.State = "lit"
	}
}
func (r *Runtime) illuminationCommand(action, id string) error {
	h := r.state.Life.Actor(playerActorID)
	if !r.world.Config.DebugPerception || !r.world.Illumination.Enabled || r.state.Paused || h == nil || !h.OnFloor() || r.heroInCombat() {
		return textError{Key: "error.illumination.unavailable"}
	}
	c, ok := r.world.Illumination.Levels[h.Level]
	known := false
	for _, ref := range c.PowerRefs {
		known = known || ref == id
	}
	if !ok || !known || (action != "illumination_power_off" && action != "illumination_power_on") {
		return textError{Key: "error.illumination.feed"}
	}
	if action == "illumination_power_on" {
		delete(r.state.Illumination.Off[h.Level], id)
	} else {
		if r.state.Illumination.Off == nil {
			r.state.Illumination.Off = map[string]map[string]bool{}
		}
		if r.state.Illumination.Off[h.Level] == nil {
			r.state.Illumination.Off[h.Level] = map[string]bool{}
		}
		r.state.Illumination.Off[h.Level][id] = true
	}
	return nil
}
func (r *Runtime) validateIllumination(s state) error {
	if len(s.Illumination.Off) > len(r.world.Illumination.Levels) {
		return errors.New("invalid lighting save levels")
	}
	for level, off := range s.Illumination.Off {
		c, ok := r.world.Illumination.Levels[level]
		if !r.world.Illumination.Enabled || !ok || len(off) > len(c.PowerRefs) {
			return errors.New("invalid lighting save feeds")
		}
		known := map[string]bool{}
		for _, id := range c.PowerRefs {
			known[id] = true
		}
		for ref, v := range off {
			if !v || !known[ref] {
				return errors.New("unknown lighting save feed")
			}
		}
	}
	return nil
}
