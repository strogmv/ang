	if s.PhaseNS < 0 || s.PhaseNS >= int64(time.Second)/int64(r.world.Config.TickHz) || s.MoveStartNS < 0 || len(s.Path) > len(r.world.Terrain)*len(r.world.Terrain[0]) {
		return s, 0, errors.New("invalid motion state")
	}
	now := s.Tick*(int64(time.Second)/int64(r.world.Config.TickHz)) + s.PhaseNS
	if len(s.Path) > 0 && (s.MoveStartNS > now || now-s.MoveStartNS >= r.moveDurationNS()+int64(time.Second)/int64(r.world.Config.TickHz)) {
		return s, 0, errors.New("invalid motion time")
	}
	previous := s.Player
	for _, p := range s.Path {
		dx, dy := p.X-previous.X, p.Y-previous.Y
		if dx < 0 {
			dx = -dx
		}
		if dy < 0 {
			dy = -dy
		}
		if !r.walkable(p) || dx+dy != 1 {
			return s, 0, errors.New("invalid saved route")
		}
		previous = p
	}
	if err := r.validateExploration(s); err != nil {
		return s, 0, err
	}
	if err := r.validateInventory(s); err != nil {
		return s, 0, err
	}
	if err := r.validateDemoSave(s); err != nil {
		return s, 0, err
	}
	return s, envelope.CreatedUnixMS, nil
}
func (r *Runtime) walkable(p point) bool {
	if p.Y < 0 || p.Y >= len(r.world.Terrain) || p.X < 0 || p.X >= len(r.world.Terrain[0]) {
		return false
	}
	if !r.world.Walkable[string(r.world.Terrain[p.Y][p.X])] {
		return false
	}
	return true
}
func (r *Runtime) path(from, to point) []point { return r.pathAvoid(from, to, nil) }
func (r *Runtime) pathAvoid(from, to point, blocked map[point]bool) []point {
	if from == to || !r.walkable(to) || blocked[to] {
		return nil
	}
	queue := []point{from}
	seen := map[point]bool{from: true}
	prev := map[point]point{}
	for len(queue) > 0 {
		p := queue[0]
		queue = queue[1:]
		if p == to {
			var route []point
			for p != from {
				route = append(route, p)
				p = prev[p]
			}
			for i, j := 0, len(route)-1; i < j; i, j = i+1, j-1 {
				route[i], route[j] = route[j], route[i]
			}
			return route
		}
		for _, d := range []point{{1, 0}, {0, 1}, {-1, 0}, {0, -1}} {
			n := point{p.X + d.X, p.Y + d.Y}
			if !seen[n] && r.walkable(n) && !blocked[n] {
				seen[n] = true
				prev[n] = p
				queue = append(queue, n)
			}
		}
	}
	return nil
}

// Keep a generated diagnostic with the source content identity.
func (r *Runtime) String() string {
	return fmt.Sprintf("CUE POC world %s", r.canonicalWorld.ContentHash)
}

// migrateSavedOrigins renames the legacy origin of parts ("prewar" -> "heirloom", owner 02.11) in the inventory grades
// and the crafting plans of a loaded save, before it is validated.
func migrateSavedOrigins(s *state) {
	s.Inventory.MigrateProvenance()
	s.Crafting.MigrateOrigins()
}

// validateSavedResidents names the residents a save and the game do not share (owner 20.11): Life keeps its named
// residents aligned with the content, so one more or one less refuses the load (until a growth migration adds the new
// ones); the reason says who, where Life.Validate would only say the state is invalid.
func (r *Runtime) validateSavedResidents(s state) error {
	saved, model := map[string]bool{}, map[string]bool{}
	for _, a := range s.Life.Actors {
		saved[a.ID] = true
	}
	var added, gone []string
	for _, p := range r.world.Life.Actors {
		model[p.ID] = true
		if !saved[p.ID] {
			added = append(added, p.ID)
		}
	}
	for _, a := range s.Life.Actors {
		if !model[a.ID] {
			gone = append(gone, a.ID)
		}
	}
	if len(added) > 0 {
		return fmt.Errorf("the game has residents this save has not: %v", added)
	}
	if len(gone) > 0 {
		return fmt.Errorf("this save has residents the game no longer has: %v", gone)
	}
	return nil
}

// validateSavedPlaces (owner 20.11, saves survive updates): a resident who chose a place keeps a copy of it until he is
// done there — a plan made under the content it was saved with, as a crafting job keeps its plan. The place must still
// be one of the game's, of the same kind; a place gone refuses the load with its name.
func (r *Runtime) validateSavedPlaces(s state) error {
	places := map[string]behavior.LifeAffordance{}
	for _, p := range r.world.Life.Brain.Places {
		places[p.ID] = p
	}
	check := func(actor string, p behavior.LifeAffordance) error {
		if p.ID == "" || p.ID == "home."+actor {
			return nil
		}
		m, ok := places[p.ID]
		if !ok {
			return fmt.Errorf("%s is on the way to %s, which the game no longer has", actor, p.ID)
		}
		if m.Kind != p.Kind {
			return fmt.Errorf("%s is on the way to %s, which is another place now", actor, p.ID)
		}
		return nil
	}
	for _, a := range s.Life.Actors {
		if err := check(a.ID, a.Brain.Place); err != nil {
			return err
		}
	}
	for _, a := range s.Life.Population.Actors {
		if err := check(a.ID, a.Brain.Place); err != nil {
			return err
		}
	}
	return nil
}

// Only explicitly audited additive catalogs may enter; all structural save,
// checksum, body, inventory and wound validation still applies below.
func (r *Runtime) configCompatibleSave(hash string, hasWounds bool) bool {
 if !hasWounds{return false}
 for _,allowed:=range r.world.Config.SaveCompatibleHashes {if hash==allowed{return true}}
 return false
}
