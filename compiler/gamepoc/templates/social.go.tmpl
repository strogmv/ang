 if order.Mode=="approaching"{for _,m:=range r.squadMembers(){if m.ID!=a.ID&&!m.Moving&&r.state.Demo.Squad.StageGoals[m.ID]==m.Position{space.Blocked[m.Position]=true}}}
 route:=space.Path(cell(from),order.Goal,focus,order.MinTargetDistance)
 if from!=goal&&len(route)==0{
  a.Path=nil;a.Task=order.Mode;a.Goal=goal
  a.Progress.Block("route_unavailable","positions_changed",r.state.Tick,r.world.AI.Policy.Recovery.Movement)
  relaxed:=space;relaxed.Blocked=map[behavior.Cell]bool{cell(r.state.Player):true};path:=relaxed.Path(cell(a.Position),order.Goal,focus,order.MinTargetDistance)
  var desired []point;for _,p:=range path{desired=append(desired,location(p))}
  for _,p:=range desired{if r.sceneOccupied(p,a.ID){r.sceneBlocked(a,p,desired);break}}
  return
 }
 var path []point;if moving{path=append(path,from)}else{a.MoveStartNS=r.state.Tick*r.tickNS()}
 for _,p:=range route{path=append(path,location(p))};a.Path=path;a.Goal=goal;a.Task=order.Mode
}
