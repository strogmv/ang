func TestTrainActuallyStandsThroughoutTheUnchangedLifeWindowAtX1(t *testing.T){
 r:=lifeRuntimeFixture(t);c:=r.world.TrainMotion;if c==nil{t.Fatal("missing train catalog")};edge:=r.world.Life.Edge(c.BerthEdgeID);if edge==nil{t.Fatal("missing unchanged berth Life edge")}
 rate:=float64(r.world.Config.TickHz);if rate<=0{t.Fatal("missing CUE tick rate")}
 departure:=c.approachSeconds()+c.BerthDwellSeconds+c.DoorCloseSeconds
 window:=float64(edge.BoardingWindowSeconds)/rate
 state:=trainDispatchState{Active:1,StartNS:0,DepartNS:int64((c.approachSeconds()+c.BerthDwellSeconds)*1e9)}
 for at:=departure-window;at<departure;at+=.01{
  distance,speed,phase,_:=c.dispatchPose(state,int64(at*1e9))
  if math.Abs(distance-c.BerthDistanceM)>1e-8||speed!=0||(phase!="berthed"&&phase!="closing"){t.Fatalf("actual Life boarding window has no standing train at %gs: phase=%s speed=%g",at,phase,speed)}
 }
}
func TestTrainMotionFastTravelUsesTheSameSavedPhysicalFrames(t *testing.T) {
	for _, rate := range []int64{1, 30} {
		r, edge := instantEdgeFixture(t, false, 0, 12345, rate)
		if r.world.TrainMotion == nil {
			t.Skip("world has no exterior train")
		}
		reference := &Runtime{world: r.world, state: r.snapshotState()}
		beforeNS := r.simNS()
		beforeLife := r.state.Life.Seconds
		if err := r.completeHeroTravel(); err != nil {
			t.Fatal(err)
		}
		replayInstantFrames(t, reference, edge.From)
		if r.simNS() <= beforeNS || r.state.Life.Seconds <= beforeLife {
			t.Fatal("fast travel did not advance the physical and calendar clocks")
		}
		actual := r.trainMotionSnapshot().Trains
		expected := reference.trainMotionSnapshot().Trains
		if !reflect.DeepEqual(actual, expected) {
			t.Fatal("offscreen skip differs from ordinary physical-frame replay")
		}
	}
}

