func(s LifeState)Clone()LifeState{out:=s;out.routes=nil;out.RelationOverrides=s.cloneRelations();out.Population=s.Population.Clone();out.Development=s.Development.Clone();out.PracticeLog=append([]string(nil),s.PracticeLog...);if s.PracticePending!=nil{copy:=*s.PracticePending;out.PracticePending=&copy};out.PracticeExcluded=nil;if len(s.PracticeExcluded)>0{out.PracticeExcluded=map[string]bool{};for k,v:=range s.PracticeExcluded{out.PracticeExcluded[k]=v}};out.Observer=s.Observer.Clone();out.Maintenance=s.Maintenance.Clone();out.Events=append([]string(nil),s.Events...);out.Actors=append([]LifeActor(nil),s.Actors...);for i:=range out.Actors{a:=&out.Actors[i];a.Path=append([]Cell(nil),a.Path...);a.PendingPath=append([]Cell(nil),a.PendingPath...);if a.Trip!=nil{trip:=*a.Trip;a.Trip=&trip};a.Visits=map[string]int{};for k,v:=range s.Actors[i].Visits{a.Visits[k]=v}};return out}
func(s LifeState)Validate(m LifeModel,tick int64)error{
 if s.PopulationFailure!=""{return fmt.Errorf("population stopped: %s",s.PopulationFailure)}
 if err:=s.validateRelations();err!=nil{return err}
 if err:=s.validatePopulation(m,tick);err!=nil{return err}
 if err:=s.validateDevelopment(m,tick);err!=nil{return err}
 if err:=s.Observer.Validate();err!=nil{return fmt.Errorf("invalid life observer: %w",err)}
 for _,key:=range inspectionKeys(m.Inspection.Observer.Attributes){if _,ok:=s.Observer.Attributes[key];!ok{return fmt.Errorf("missing saved inspection attribute %s",key)}}
 if s.ControlledActorID!=""&&s.Actor(s.ControlledActorID)==nil{return fmt.Errorf("unknown controlled life actor")}
 if !s.Enabled{return nil};if s.Seconds<0||s.SecondsPerTick<1||s.SecondsPerTick>120||s.Tick<0||s.Tick!=tick||len(s.Events)>64||len(s.Actors)!=len(m.Actors){return fmt.Errorf("invalid life state")}
 occupied:=map[string]map[Cell]bool{}
 for i,a:=range s.Actors{p:=m.Actors[i];if a.ID!=p.ID||a.Step<0||a.Step>=len(p.Steps)||!m.Walks(a.Level,a.Position)||a.YieldUntil<0||a.YieldUntil>tick+8*m.MoveTicks||a.MoveStartTick<0||a.MoveStartTick>tick||a.StartedAt<0||a.StartedAt>s.Seconds||a.Visits==nil||a.WorkedSeconds<0||a.SleptSeconds<0||a.Meals<0||len(a.Path)>10000||len(a.PendingPath)>10000{return fmt.Errorf("invalid life actor %s",a.ID)}
  if a.Trip!=nil{e:=m.Edge(a.Trip.Edge);if e==nil||e.From!=a.Level||a.Trip.Departure<0||a.Trip.Departure>s.Seconds||a.Position!=e.Exit||a.Trip.Arrival!=a.Trip.Departure+e.TravelSeconds||len(a.Path)>0{return fmt.Errorf("invalid life trip")}}else{if occupied[a.Level]==nil{occupied[a.Level]=map[Cell]bool{}};if occupied[a.Level][a.Position]{return fmt.Errorf("life actors overlap")};occupied[a.Level][a.Position]=true}
  for level,count:=range a.Visits{if _,ok:=m.Locations[level];!ok||count<1{return fmt.Errorf("invalid life visit")}}
  if len(a.PendingPath)>0&&(a.ID!=s.ControlledActorID||len(a.Path)>0||a.Trip!=nil){return fmt.Errorf("invalid pending life route")}
  pendingFrom:=a.Position;for _,at:=range a.PendingPath{if !m.Walks(a.Level,at)||Distance(pendingFrom,at)!=1{return fmt.Errorf("invalid pending life path")};pendingFrom=at}
  previous:=a.Position;for _,at:=range a.Path{if !m.Walks(a.Level,at)||Distance(previous,at)!=1{return fmt.Errorf("invalid life path")};previous=at}
  if a.OverrideEdge!=""{e:=m.Edge(a.OverrideEdge);if e==nil||e.To!=a.OverrideLevel||e.Entry!=a.OverrideAt||(a.Level!=e.From&&a.Level!=e.To){return fmt.Errorf("invalid selected life exit")}}
  if a.OverrideLevel!=""&&!m.Walks(a.OverrideLevel,a.OverrideAt){return fmt.Errorf("invalid life destination")}
 };return s.Maintenance.Validate(m,s.Seconds)
}

// A passenger may step onto a free adjacent landing cell, never across a wall.
func(s LifeState)lifeArrivalCell(m LifeModel,e LifeEdge,id string)(Cell,bool){
 candidates:=[]Cell{e.Entry,{X:e.Entry.X+1,Y:e.Entry.Y},{X:e.Entry.X,Y:e.Entry.Y+1},{X:e.Entry.X-1,Y:e.Entry.Y},{X:e.Entry.X,Y:e.Entry.Y-1}}
 for _,at:=range candidates{if m.Walks(e.To,at)&&!s.occupied(e.To,at,id){return at,true}};return Cell{},false
}

// Structural reachability is shared by all route requests in this state. It
// never contains NPC positions/reservations: temporary congestion must remain
// eligible for normal pathfinding on the next tick. This transient cache is
// omitted from saves and rebuilt independently after Clone/load.
type lifeRouteConnectivity struct {
 walkable map[string]bool
 levels map[string]lifeRouteLevel
}
type lifeRouteLevel struct {
 terrain []string
 width int
 components []int
}
func(s *LifeState)ensureLifeRoutes(m LifeModel){
 if s.routes!=nil&&s.routes.matches(m){return}
 cache:=&lifeRouteConnectivity{walkable:make(map[string]bool,len(m.Walkable)),levels:make(map[string]lifeRouteLevel,len(m.Locations))}
 for glyph,walks:=range m.Walkable{cache.walkable[glyph]=walks}
 for id,location:=range m.Locations{
  level:=lifeRouteLevel{terrain:append([]string(nil),location.Terrain...)}
  if len(location.Terrain)>0{level.width=len(location.Terrain[0])}
  level.components=make([]int,level.width*len(location.Terrain))
  queue:=make([]Cell,0,len(level.components));component:=0
  for y,row:=range location.Terrain{for x:=range row{
   origin:=Cell{X:x,Y:y};index:=y*level.width+x
   if level.components[index]!=0||!m.Walks(id,origin){continue}
   component++;level.components[index]=component;queue=append(queue[:0],origin)
   for head:=0;head<len(queue);head++{at:=queue[head];for _,delta:=range cardinal{
    next:=Cell{X:at.X+delta.X,Y:at.Y+delta.Y};if !m.Walks(id,next){continue};nextIndex:=next.Y*level.width+next.X
    if level.components[nextIndex]==0{level.components[nextIndex]=component;queue=append(queue,next)}
   }}
  }}
  cache.levels[id]=level
 }
 s.routes=cache
}
// Compare structural inputs once per tick. Copied row headers and walkability
// entries prevent shared mutable model maps/slices from hiding topology edits.
// Unchanged row strings compare cheaply; no hash collision can reuse stale data.
func(c *lifeRouteConnectivity)matches(m LifeModel)bool{
 if len(c.levels)!=len(m.Locations)||len(c.walkable)!=len(m.Walkable){return false}
 for glyph,walks:=range m.Walkable{old,ok:=c.walkable[glyph];if !ok||old!=walks{return false}}
 for id,location:=range m.Locations{old,ok:=c.levels[id];if !ok||len(old.terrain)!=len(location.Terrain){return false};for i,row:=range location.Terrain{if row!=old.terrain[i]{return false}}}
 return true
}
func(c *lifeRouteConnectivity)connected(levelID string,from,to Cell)bool{
 level,ok:=c.levels[levelID];if !ok||from.X<0||from.Y<0||to.X<0||to.Y<0||from.X>=level.width||to.X>=level.width||from.Y>=len(level.terrain)||to.Y>=len(level.terrain){return false}
 component:=level.components[from.Y*level.width+from.X]
 return component!=0&&component==level.components[to.Y*level.width+to.X]
}

// yieldPopulation propagates one empty pocket through stationary local traffic.
// Named walking NPCs may participate, but the controlled actor, manual actors,
// occupied maintenance workplaces, accepted movement and active tasks remain hard barriers.
// A request examines at most 128 cells/radius twelve. Its final pocket must be
// outside the requester's route. At most seven ordinary steps may lead through
// free corridor cells to that pocket; only the first step is reserved now.
// Actual positions change only by Advance, with normal MoveTicks and collision
// checks, and the existing eight-step hold covers the whole short manoeuvre.
type lifeYieldResident struct{index int;named bool;courtesy bool}
// An explicit autonomous requester is enough for NPC-to-NPC traffic. No hero,
// client connection or synthetic population is required. The legacy anonymous
// wrapper still cannot guess which actor is controlled.
func(s LifeState)autonomousTrafficRequester(id string)bool{
 a:=s.Actor(id);return a!=nil&&a.ID!=s.ControlledActorID&&!a.Manual&&a.Trip==nil&&!a.Arrived&&a.Activity=="walking"&&a.Goal!=a.Position
}
func(s *LifeState)yieldTraffic(m LifeModel,level string,tick int64,requester ...string)(map[Cell]bool,map[Cell]lifeYieldResident){
 hard:=map[Cell]bool{};residents:=map[Cell]lifeYieldResident{};who:="";if len(requester)>0{who=requester[0]};autonomous:=s.autonomousTrafficRequester(who)
 for i,a:=range s.Actors{if a.Level!=level||a.Trip!=nil{continue};repairStep,repairing:=s.maintenanceStep(m,a.ID);atWorkplace:=repairing&&a.Level==repairStep.Level&&a.Position==repairStep.At
  eligible:=(s.ControlledActorID!=""||autonomous)&&a.ID!=s.ControlledActorID&&a.ID!=who&&!a.Manual&&!a.Arrived&&a.Activity=="walking"&&a.Goal!=a.Position&&len(a.Path)==0&&tick>=a.YieldUntil&&!atWorkplace
  courteous:=s.courtesyNamed(m,a,who,tick);if eligible||courteous{residents[a.Position]=lifeYieldResident{i,true,!eligible&&courteous}}else{hard[a.Position]=true;if len(a.Path)>0{hard[a.Path[0]]=true}}
 }
 for i,a:=range s.Population.Actors{if !a.Materialized||a.Level!=level||a.Trip!=nil{continue};if len(a.Path)>0||tick<a.YieldUntil{hard[a.Position]=true;if len(a.Path)>0{hard[a.Path[0]]=true}}else{residents[a.Position]=lifeYieldResident{i,false,false}}}
 return hard,residents
}
func(s *LifeState)yieldRoute(m LifeModel,level string,from,to Cell,tick int64,requester ...string)[]Cell{
 hard,_:=s.yieldTraffic(m,level,tick,requester...);return m.Space(level,hard).Path(from,to,Cell{},0)
}
func(s *LifeState)yieldPopulation(m LifeModel,level string,wanted Cell,tick int64,avoid ...Cell)bool{
 return s.yieldPopulationFor(m,level,wanted,tick,"",avoid...)
}
func(s *LifeState)yieldPopulationFor(m LifeModel,level string,wanted Cell,tick int64,requester string,avoid ...Cell)bool{
 autonomous:=s.autonomousTrafficRequester(requester)
 if autonomous&&!s.courtesyAware(m,requester,level,wanted){return false}
 hard,residents:=s.yieldTraffic(m,level,tick,requester)
 if _,ok:=residents[wanted];!ok||hard[wanted]{return false}
 queue:=[]Cell{wanted};seen:=map[Cell]bool{wanted:true};parent:=map[Cell]Cell{}
 for head:=0;head<len(queue)&&head<128;head++{at:=queue[head];for _,d:=range []Cell{{0,-1},{1,0},{0,1},{-1,0}}{next:=Cell{at.X+d.X,at.Y+d.Y};if seen[next]||hard[next]||!m.Walks(level,next)||Distance(wanted,next)>12{continue};seen[next]=true;parent[next]=at
   if _,occupied:=residents[next];!occupied{
    // A free cell in the requested corridor is a way through, not a place to
    // stop: holding it would obstruct the same passage we are trying to clear.
    forbidden:=false;for _,at:=range avoid{if at==next{forbidden=true;break}}
    if forbidden{if len(queue)<128{queue=append(queue,next)};continue}
    move:=[]Cell{next};previous:=parent[next];r,ok:=residents[previous]
    for !ok&&previous!=wanted&&len(move)<7{move=append(move,previous);previous=parent[previous];r,ok=residents[previous]}
    if !ok{continue};if (r.courtesy||autonomous)&&!s.courtesyAware(m,requester,level,previous){continue};for i,j:=0,len(move)-1;i<j;i,j=i+1,j-1{move[i],move[j]=move[j],move[i]}
    if r.named{a:=&s.Actors[r.index];if r.courtesy{a.Arrived=false};a.Path=move;a.MoveStartTick=tick;a.YieldUntil=tick+8*m.MoveTicks;a.Activity="yielding";a.Label="Уступает проход"}else{a:=&s.Population.Actors[r.index];a.Path=move;a.MoveStartTick=tick;a.YieldUntil=tick+8*m.Population.MoveTicks;a.Arrived=false;a.Activity="yielding"};return true
   }
   if len(queue)<128{queue=append(queue,next)}
 }};return false
}
