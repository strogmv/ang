func populationRuntimeFixture(t *testing.T, count int) *Runtime {
	t.Helper()
	r := lifeRuntimeFixture(t)
	if len(r.world.Life.Population.Stages) < 2 {
		t.Fatal("population CUE schedule missing")
	}
	// Start just before a configured shift boundary, never invent a schedule.
	at := r.world.Life.Population.Stages[1].AtSecond - 60
	if at < 0 {
		at = 0
	}
	r.world.Life.StartSeconds = at
	life, err := r.world.Life.StartWithPopulation(count, playerActorID)
	if err != nil {
		t.Fatal(err)
	}
	r.state.Tick = 0
	r.initLifeState(life)
	r.state.Life.SecondsPerTick = 30
	return r
}
func TestPopulationRuntime100And300ShiftTravelSave(t *testing.T) {
	for _, count := range []int{100, 300} {
		t.Run(fmt.Sprint(count), func(t *testing.T) {
			r := populationRuntimeFixture(t, count)
			initial := r.state.Life.Population.Clone()
			shift, trip, visit := false, false, false
			for i := 0; i < 720; i++ {
				r.step()
				if r.state.Paused {
					t.Fatalf("population stopped: %s", r.state.Life.PopulationFailure)
				}
				if err := r.state.Life.Validate(r.world.Life, r.state.Tick); err != nil {
					t.Fatalf("tick %d: %v", r.state.Tick, err)
				}
				for j, a := range r.state.Life.Population.Actors {
					if a.ID != initial.Actors[j].ID {
						t.Fatal("identity changed")
					}
					shift = shift || a.Stage != initial.Actors[j].Stage
					trip = trip || a.Trip != nil
					visit = visit || len(a.Visits) > 1
				}
				if i == 180 {
					snapshot := r.snapshotState()
					slot := r.world.Config.SaveSlots[0]
					if err := r.writeSave(slot, snapshot); err != nil {
						t.Fatal(err)
					}
					restored, _, err := r.readSave(slot)
					if err != nil {
						t.Fatal(err)
					}
					if !reflect.DeepEqual(snapshot.Life.Clone(), restored.Life.Clone()) {
						t.Fatal("population/save changed persisted state")
					}
					r.state = restored
				}
			}
			if r.state.Life.Population.Count != count || !shift || !trip || !visit {
				t.Fatalf("population never completed shift/travel: count=%d shift=%v trip=%v visit=%v", r.state.Life.Population.Count, shift, trip, visit)
			}
		})
	}
}
