var barkCatalog = mustBarkCatalog()

func mustBarkCatalog() barks.Model {
	m, err := barks.Catalog()
	if err != nil {
		panic("barks catalog: " + err.Error())
	}
	return m
}

func (r *Runtime) initBarks() { r.state.Barks = barks.State{} }

func barkCell(c behavior.Cell) barks.Cell { return barks.Cell{X: c.X, Y: c.Y} }

// barkPosture: on a stool of a seated place; on his post (a staff spot, a counter post, his shop's counter, a crafting
// master's counter). Walking through a cell is neither.
func (r *Runtime) barkPosture(a *behavior.LifeActor) (seated, post bool) {
	if len(a.Path) > 0 {
		return false, false
	}
	for _, p := range r.world.Life.Brain.Places {
		if p.Level != a.Level || p.Seating == nil {
			continue
		}
		for _, s := range p.Seating.Seats {
			seated = seated || s.At == a.Position
		}
		if p.Seating.IsStaff(a.ID) {
			for _, s := range p.Seating.Posts {
				post = post || s.At == a.Position
			}
		}
	}
	if _, ok := r.world.Life.Brain.CounterPost(a.ID, a.Level, a.Position); ok {
		post = true
	}
	for _, sh := range r.world.Inventory.Shopfronts {
		if sh.Owner == a.ID && sh.Service.Level == a.Level && sh.Service.At.X == a.Position.X && sh.Service.At.Y == a.Position.Y {
			post = true
		}
	}
	for _, ms := range r.world.Crafting.Masters {
		if ms.Actor == a.ID && ms.Level == a.Level && craftingNear(a.Position, ms.Approach, ms.Reach) {
			post = true
		}
	}
	return seated, post
}

// barkFrame: the hero, the people of his level and the facts, as the engine reads them.
func (r *Runtime) barkFrame() (barks.Frame, bool) {
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || hero.Trip != nil {
		return barks.Frame{}, false
	}
	f := barks.Frame{Now: r.state.Life.Seconds, Tick: r.state.Tick, Seed: r.state.Seed, Hero: barks.Actor{ID: hero.ID, Level: hero.Level, At: barkCell(hero.Position)}}
	for i := range r.state.Life.Actors {
		a := &r.state.Life.Actors[i]
		if a.ID == playerActorID || a.Level != hero.Level || !a.OnFloor() || a.CombatHold {
			continue
		}
		seated, post := r.barkPosture(a)
		f.Actors = append(f.Actors, barks.Actor{ID: a.ID, Level: a.Level, At: barkCell(a.Position), Seated: seated, OnPost: post})
	}
	// the anonymous people of the population drawn on the level speak the lines of "anyone" of their caste
	for i := range r.state.Life.Population.Actors {
		a := &r.state.Life.Population.Actors[i]
		if a.Level != hero.Level || a.Trip != nil || !a.Materialized || a.CombatHold || a.Profile == nil {
			continue
		}
		if caste := barkCatalog.PopulationCastes[a.Profile.DefinitionID]; caste != "" {
			f.Actors = append(f.Actors, barks.Actor{ID: a.ID, Level: a.Level, At: barkCell(a.Position), Caste: caste})
		}
	}
	f.Facts = r.barkFacts(hero.Level)
	return f, true
}

// barkActorAt: where a speaker is now — a Life person or an anonymous person of the population.
func (r *Runtime) barkActorAt(id string) (string, behavior.Cell, bool) {
	if a := r.state.Life.Actor(id); a != nil {
		return a.Level, a.Position, a.Trip == nil
	}
	for i := range r.state.Life.Population.Actors {
		if a := &r.state.Life.Population.Actors[i]; a.ID == id {
			return a.Level, a.Position, a.Trip == nil
		}
	}
	return "", behavior.Cell{}, false
}

// advanceBarks runs once per Life frame, after the people moved and the systems acted.
func (r *Runtime) advanceBarks() {
	if f, ok := r.barkFrame(); ok {
		barkCatalog.Step(&r.state.Barks, f)
	}
}

// BarkEvent is the entry point of the fighting layer: what happened, what the speaker declares and what he really does,
// with free facts of the moment. The speaker's place is his Life body; a combatant outside Life goes through BarkCue.
func (r *Runtime) BarkEvent(speaker, event, declared, truth string, facts ...string) barks.Outcome {
	if declared == "" {
		declared = event
	}
	c := barks.Cue{Speaker: speaker, Declared: declared, Truth: truth, Facts: facts}
	if a := r.state.Life.Actor(speaker); a != nil {
		c.Level, c.At = a.Level, barkCell(a.Position)
	}
	return r.BarkCue(c)
}

// BarkCue: a combat cue with the speaker's archetype, encounter role and position given by the fighting layer.
func (r *Runtime) BarkCue(c barks.Cue) barks.Outcome {
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || hero.Trip != nil {
		return barks.Outcome{Reason: "no_hero"}
	}
	sense := barks.Sense{Actor: barks.Actor{ID: hero.ID, Level: hero.Level, At: barkCell(hero.Position)}, Skills: map[string]int{}}
	for _, d := range barkCatalog.Combat.Deceptions {
		for _, t := range d.Tells {
			sense.Skills[t.Skill] = r.state.Life.Development.Value(playerActorID, t.Skill)
		}
	}
	return barkCatalog.BarkEvent(&r.state.Barks, r.state.Life.Seconds, r.state.Tick, r.state.Seed, c, sense)
}

// appendBarks projects the lines alive now: the hero hears them (a voice is heard, so a speaker out of sight still
// carries his cell), the text in the client's language, the face of the caste and the clock in simulation time.
func (r *Runtime) appendBarks(view *pb.PocLifeView, msg *pb.PocGameState, hero *behavior.LifeActor, locale string) {
	if hero == nil || hero.Trip != nil {
		return
	}
	loc := r.validLocale(locale)
	tickNS := int64(time.Second) / int64(r.world.Config.TickHz)
	speech := map[string]*pb.PocBark{}
	for _, sp := range r.state.Barks.Visible(r.state.Tick) {
		b := &pb.PocBark{Serial: sp.Serial, Kind: sp.Kind, SpeakerId: sp.Speaker, LineKey: sp.Line, To: sp.To, Caste: sp.Caste, Gesture: sp.Gesture, Sign: sp.Sign, Sfx: sp.Sfx,
			StartedNs: sp.Start * tickNS, UntilNs: sp.Until * tickNS, RevealMs: sp.RevealMS, FixMs: sp.FixMS, HoldMs: sp.HoldMS, FadeMs: sp.FadeMS, OffscreenFadeMs: barkCatalog.Timing.OffscreenFadeMS}
		if sp.Key != "" {
			b.Text = r.localText(loc, sp.Key, "")
			if b.Text == "" {
				continue
			}
		}
		if face, ok := barkCatalog.Face(sp.Caste); ok {
			b.Face, b.Reveal, b.Correction, b.Colour, b.Cps = face.Face, face.Reveal, face.Correction, face.Colour, int32(face.CPS)
		}
		if l, _, ok := barkCatalog.Line(sp.Line); ok && sp.Kind == "line" {
			if fx, ok := l.Fix[loc]; ok {
				b.FixFrom, b.FixTo, b.FixText = int32(fx.From), int32(fx.To), r.localText(loc, fx.Key, "")
			}
		}
		if level, at, ok := r.barkActorAt(sp.Speaker); level != "" {
			if level != hero.Level || !ok {
				continue
			}
			b.X, b.Y = int32(at.X), int32(at.Y)
			if v := r.deckVolume(); v != nil {
				if d, ok := v.SurfaceIndex(at); ok {
					b.Deck = int32(d)
				}
			}
		} else if sp.Kind == "combat" || sp.Kind == "sign" {
			if sp.Level != hero.Level {
				continue
			}
			b.X, b.Y = int32(sp.At.X), int32(sp.At.Y)
		} else if sp.Kind != "thought" {
			continue
		}
		view.Barks = append(view.Barks, b)
		if b.Text != "" && sp.Kind != "thought" {
			speech[sp.Speaker] = b
		}
	}
	// the plain speech fields of the contract carry the same text (for views that draw a simple label)
	for _, a := range msg.SceneAgents {
		if b, ok := speech[a.Id]; ok {
			a.Speech, a.SpeechUntilTick = b.Text, b.UntilNs/tickNS
		}
	}
}

func (r *Runtime) validateBarksSave(s state) error {
	return barkCatalog.ValidateState(s.Barks, s.Life.Seconds, s.Tick)
}
