func TestExchangeAtTheYatai(t *testing.T) {
	r := talkFixture(t)
	got := talkOnly(barkRun(r, 12000))
	if len(got) < 2 {
		t.Fatalf("no talk in 20 minutes by the yatai: %v", got)
	}
	people := map[string]bool{"char.market_yatai_cook": true, "char.market_yatai_helper": true}
	for i, sp := range got {
		if !strings.HasPrefix(sp.To, "char.") && !strings.HasPrefix(sp.To, "population.") {
			t.Fatalf("a turn to nobody: %+v", sp)
		}
		e, _, ok := barkCatalog.TurnOf(sp.Line)
		if !ok {
			t.Fatalf("unknown turn %s", sp.Line)
		}
		if i > 0 && got[i-1].Speaker == sp.To && got[i-1].To == sp.Speaker {
			if sp.Start < got[i-1].Until {
				t.Fatalf("the answer %s started at %d, the line ended at %d", sp.Line, sp.Start, got[i-1].Until)
			}
		}
		if e.ID == "talk.yatai_pot" && !(people[sp.Speaker] && people[sp.To]) {
			t.Fatalf("who talks: %+v", sp)
		}
	}
	if err := barkCatalog.ValidateState(r.state.Barks, r.state.Life.Seconds, r.state.Tick); err != nil {
		t.Fatal(err)
	}
}
func TestExchangeStopsWhenOneWalksAway(t *testing.T) {
	r := talkFixture(t)
	helper := r.state.Life.Actor("char.market_yatai_helper")
	var speech []barks.Speech
	var first *barks.Speech
	for i := 0; i < 12000; i++ {
		for _, sp := range talkOnly(barkRun(r, 1)) {
			if strings.HasPrefix(sp.Line, "bark.talk_yatai.pot") || strings.HasPrefix(sp.Line, "bark.talk_yatai.loaders") {
				speech = append(speech, sp)
				if first == nil {
					c := sp
					first = &c
					// he goes off somewhere the moment she starts
					helper.Path = []behavior.Cell{{X: helper.Position.X + 1, Y: helper.Position.Y}}
				}
			}
		}
		if first != nil && r.state.Tick > first.Until+100 {
			break
		}
	}
	if first == nil {
		t.Fatal("no talk of Galina and Kostya in 20 minutes by the yatai")
	}
	if len(speech) != 1 {
		t.Fatalf("an answer from a man on his way: %+v", speech)
	}
}
