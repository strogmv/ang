 raw,_:=json.MarshalIndent(setup,"","  ");if err:=os.WriteFile(filepath.Join(*combatPaceReport,"setup.json"),raw,0644);err!=nil{t.Fatal(err)}
 // Resolve the same ordinary end-turn command twice from a strict saved state.
 initial:=r.snapshotState();var first []byte
 for i:=0;i<2;i++{r.state=initial;r.state=r.snapshotState();result,state:=combatWire(t,r,c,&pb.PocCombatCommand{Action:"end",ExpectedTurn:r.state.Combat.Turn,RequestId:"pace-replay-"+string(rune(97+i))});if !result.Ok{t.Fatal(result.Message)};trace,_:=json.Marshal(state.Combat);if i==0{first=trace}else if string(trace)!=string(first){t.Fatal("pace projection is nondeterministic")}}
 if err:=os.WriteFile(filepath.Join(*combatPaceReport,"phase.json"),first,0644);err!=nil{t.Fatal(err)}
 // Obtain the last-AP boundary through ordinary posture commands, then save it.
 r.state=initial;r.state=r.snapshotState()
 cost,err:=r.combatTry(behavior.CombatAction{Type:"attack",Mode:"quick",BodyPart:"chest",TargetID:foe});if err!=nil||cost<1{t.Fatal("last-AP attack unavailable",cost,err)}
 for n:=0;r.state.Combat.Actor(playerActorID).AP>cost&&n<2*r.world.CombatRuntime.Rules.APPerTurn;n++{
  posture:="crouch";if r.state.Combat.Actor(playerActorID).Crouched{posture="stand"}
