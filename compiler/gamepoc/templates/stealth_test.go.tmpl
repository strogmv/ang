func TestStealthUnreachableEstimateStaysPhysicalAndExpires(t *testing.T) {
	r := stealthSearchFixture(t, []string{"############", "#....#.....#", "#....#.....#", "############"}, behavior.Cell{X: 1, Y: 1}, 64)
	estimate := behavior.Cell{X: 9, Y: 1}
	until := r.state.Life.Seconds + 30
	for frame := 0; frame < 30; frame++ {
		stealthSearchStep(t, r, estimate, until)
		a := r.state.Life.Actor("search.guard")
		if a.Position.X >= 5 || a.Safety != nil && a.Safety.Goal.X >= 5 {
			t.Fatal("unreachable memory crossed a real closed wall")
		}
	}
	if r.state.Life.Actor("search.guard").Safety != nil {
		t.Fatal("expired unreachable sound kept an investigation alive")
	}
	before := r.snapshotState()
	a := r.state.Life.Actor("search.guard")
	r.stealthSearch(combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}, estimate, r.state.Life.Seconds)
	if !reflect.DeepEqual(before, r.snapshotState()) {
		t.Fatal("an expired remembered estimate restarted search")
	}
}
func TestStealthSearchIgnoresHiddenBodiesButExecutionCannotWalkThroughThem(t *testing.T) {
	r := stealthSearchFixture(t, []string{"##################", "#................#", "##################"}, behavior.Cell{X: 1, Y: 1}, 64)
	hero := behavior.LifePerson{ID: playerActorID, Name: "hidden", Steps: []behavior.LifeStep{{Level: "search", At: behavior.Cell{X: 8, Y: 1}, Activity: "rest", Label: "hidden"}}}
	r.world.Life.Actors = append(r.world.Life.Actors, hero)
	r.state.Life = r.world.Life.Start()
	r.state.Life.ControlledActorID = playerActorID
	h := r.state.Life.Actor(playerActorID)
	h.Manual = true
	estimate := behavior.Cell{X: 15, Y: 1}
	until := r.state.Life.Seconds + 40
	a := r.state.Life.Actor("search.guard")
	observer := combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}
	r.stealthSearch(observer, estimate, until)
	if a.Safety == nil || a.Safety.Goal != estimate {
		t.Fatal("planning consulted an unseen body's current position")
	}
	for frame := 0; frame < 15; frame++ {
		stealthSearchStep(t, r, estimate, until)
	}
	if a.Position.X >= h.Position.X {
		t.Fatal("physical execution walked through the hidden stationary body")
	}
	h.Position = behavior.Cell{X: 11, Y: 1}
	h.Goal = h.Position
	r.clearStealthSearch(a.ID)
	r.stealthSearch(combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}, estimate, until)
	if a.Safety == nil || a.Safety.Goal != estimate {
		t.Fatal("moving a hidden body changed the remembered search destination")
	}
}
func TestStealthRememberedSearchKeepsTheExistingClosedGatePhysical(t *testing.T) {
	r, _, d := playableFixture(t, false)
	a := r.state.Life.Actor(d.Guard)
	estimate := playableTakeAction(t, d, d.GoalSource).At
	r.stealthSearch(combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}, estimate, r.state.Life.Seconds+120)
	if r.state.Life.Gates[d.Gate].Passable() || a.Safety == nil || a.Safety.Goal == estimate {
		t.Fatal("search treated a lowered physical gate as a passable route")
	}
	model := r.state.Life.GateModel(r.world.Life)
	if len(model.Space(a.Level, nil).Path(a.Position, a.Safety.Goal, behavior.Cell{}, 0)) == 0 && a.Position != a.Safety.Goal {
