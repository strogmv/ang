func TestCombatGridKnifeContactAnchorKeepsPhysicalReachAndCellOccupancy(t *testing.T){
 r:=gridCoverRules();space:=combatFixtureSpace();space.CellMM=500;space.Grid=DeriveCombatGrid(space.Space,500,r.Grid,nil);space.EndSpacingMM=func(Combatant,Combatant)int{return 700}
 a,b:=combatFixtureActor("a","blue",Cell{1,3}),combatFixtureActor("b","red",Cell{6,3});a.Controlled=true;a.Weapon=CombatWeapon{ID:"knife",Kind:"blade",Damage:12,RangeMM:900,AttackAP:2};a.Ammo=0
 s,err:=NewCombat("contact","fixture",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)};s.Observe(space,r)
 found:=false
 options,_:=s.reachable(space,r,*s.Actor("a"),s.Actor("a").AP,true)
 for _,at:=range options{if at.At==a.Position||space.rangeMM(at.At,b.Position)>900{continue};if space.Grid.Same(at.At,b.Position){t.Fatal("two bodies occupy one combat area")}
  p:=s.MovePreview(space,r,"a",at.At);before:=s.Actor("a").AP
  if err=s.Execute(space,r,"a",CombatAction{Type:"move",To:at.At});err!=nil{t.Fatal(err)};if before-s.Actor("a").AP!=p.AP{t.Fatal("contact approach charge differs")}
  if err=s.Execute(space,r,"a",CombatAction{Type:"attack",TargetID:"b"});err!=nil{t.Fatalf("knife cannot strike after contact approach: %v",err)};found=true;break
 }
 if !found{t.Fatal("coarse grid lost the knife's physical contact anchors")}
}
