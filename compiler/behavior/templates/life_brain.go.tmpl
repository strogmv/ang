// Seated meal at a counter with reserved seats (demo-hub v5-yatai). The body walks to its spot; a queue place turns into
// a seat as soon as one frees (the person gives up after QueueMax); on the seat the meal is bought at once through the
// host's ordinary inventory purchase, the person sits SitDown + SitMin..SitMax (counter RNG), then rises for Rise seconds
// on the same cell and leaves. A forced return to a post, a withdrawn offer or a lost spot ends it early.
func(b *LifeBrain)seated(m LifeBrainModel,svc LifeBrainServices,id,level,activity string,at Cell,arrived,hot bool,seconds,seed int64)(LifeStep,bool){
 leave:=func(){b.clearSeat();b.Place=LifeAffordance{};b.Target=LifeStep{};b.MealElapsed=0;b.NextDecision=seconds;b.Goal.HoldUntil=b.Goal.ChosenTick;b.DecisionPending=true}
 used:=func(s *LifeSeating){if w:=s.window(seconds);w>=0&&b.SeatWindow<seatMarker(seconds,w){b.SeatWindow=seatMarker(seconds,w)}}
 p,ok:=m.seating(b.Place.ID);if !ok||b.Seat==""{leave();return LifeStep{},false}
 s:=p.Seating;spot,ok:=s.spot(b.Seat);if !ok{leave();return LifeStep{},false}
 forced:=b.BreakKind!=""&&b.Returning
 // Rising: the body stays on the seat cell for the whole rise, then the seat is free.
 if b.RiseAt>0{if seconds<b.RiseAt+s.Rise&&at==spot.At{return b.Target,true};leave();return LifeStep{},false}
 if b.SeatedAt>0{
  if at!=spot.At||level!=p.Level{leave();return LifeStep{},false}
  // The meal ends at SitUntil (or a forced return to the post), never inside the sit-down transition.
  if (seconds>=b.SitUntil||forced)&&seconds>=b.SeatedAt+s.SitDown{b.RiseAt=seconds;b.DecisionPending=true}
  return b.Target,true
 }
 if forced{leave();return LifeStep{},false}
 // On the way or in the queue: the offer must stay live (staffed counter, stock, money) at the decision cadence.
 if seconds>=b.NextDecision{period:=m.ColdSeconds;if hot{period=m.HotSeconds};b.NextDecision=seconds+period
  live:=false;if svc.Offers!=nil&&level==p.Level{for _,o:=range svc.Offers(id,p.Kind,level){if o.ID==p.ID{live=true;break}}}
  if !live{leave();return LifeStep{},false}
 }
 if b.SeatQueue{
  if svc.SeatsTaken!=nil{if seat,ok:=pickSeatSpot(s.Seats,svc.SeatsTaken(level,p.ID,id),at,true);ok{b.Seat=seat.ID;b.SeatQueue=false;b.QueueSince=0;b.Target.At=seat.At;b.Target.Label="life.npc.seated_food";b.Place.At=seat.At;b.DecisionPending=true;return b.Target,true}}
