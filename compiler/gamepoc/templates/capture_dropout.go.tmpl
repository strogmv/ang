package poc
import("strings";"angelsdemons/server/internal/behavior";pb "angelsdemons/server/internal/transport/grpc/pb/game/v1")
const memberUnavailableKey="npc_ai.member_unavailable"
const noReplacementKey="npc_ai.no_replacement"
func(r *Runtime)recoverCaptureMember(){
 d:=&r.state.Demo;if !d.Issued||d.Captured||d.Plan.Status=="failed"||d.Plan.Status=="completed"{return}
 policy:=r.world.AI.Policy.Recovery.Movement
 for _,c:=range d.Candidates{if !c.Selected{continue};a:=r.sceneActor(c.AgentID);if a==nil{r.replaceCaptureMember(c.AgentID);return}
  expected,assigned:=d.Squad.StageGoals[a.ID];if at,ok:=d.Squad.ContactGoals[a.ID];ok&&(d.Squad.Phase=="approaching"||d.Squad.Phase=="committing"||d.Squad.Phase=="in_position"){expected,assigned=at,true}
  if !assigned||cell(a.Position)==expected||a.Position!=a.SquadProgressAt{a.SquadProgressAt=a.Position;a.SquadProgressTick=r.state.Tick;continue}
  // Compare physical position with the group's accepted destination. A broken
  // member setting its own goal to its feet is not successful participation.
  if r.state.Tick-a.SquadProgressTick>=policy.StallTicks*int64(policy.MaxRecoveries+1){r.replaceCaptureMember(a.ID);return}
 }
}
func(r *Runtime)replaceCaptureMember(id string){
 d:=&r.state.Demo;c:=r.candidate(id);if c==nil||!c.Selected||d.Plan.Status=="failed"{return}
 c.Selected=false;c.Unavailable=true;c.Requested=true;c.Reason=memberUnavailableKey
 if a:=r.sceneActor(id);a!=nil{a.Path=nil;a.Task="blocked";a.Inbox=nil}
 available:=false
 for i:=range d.Candidates{candidate:=&d.Candidates[i];if candidate.Selected||candidate.Unavailable{continue};a:=r.sceneActor(candidate.AgentID)
  if a==nil||a.Progress.Status=="failed"||a.BusyUntil>r.state.Tick||a.Task=="blocked"{continue}
  if candidate.Requested&&candidate.Reason!="Резерв: состав набран"&&candidate.Reason!="Резерв"{continue}
  if radius:=r.dangerLevel().CallRadius;radius>0&&candidate.Distance>radius{continue}
  candidate.Requested=false;candidate.Reason="Резерв";available=true
 }
 // Once captured, custody/carrier handoff needs a separate mechanic. Cancel
 // safely instead of silently changing who carries an already captured body.
 if !available||d.Captured{r.failMission(noReplacementKey);return}
 r.state.Inventory.ReleasePurpose(d.Squad.ID)
 d.Squad=behavior.GroupState{ID:d.Squad.ID,SubjectID:d.Squad.SubjectID,Track:d.Squad.Track,Target:d.Squad.Target,Phase:"regroup"}
 d.TeamReady=false;d.Progress=behavior.Progress{};d.Plan.Restart(memberUnavailableKey)
 for i:=range d.Agents{a:=&d.Agents[i];if r.selectedActor(a.ID){a.Progress=behavior.Progress{};a.Path=nil;a.Task="await_team";a.SquadProgressTick=r.state.Tick;a.SquadProgressAt=a.Position}}
 r.requestResponders()
}
func(r *Runtime)localizeNPC0Demo(msg *pb.PocGameState,locale string){
 if msg.CaptureOrder==nil{return};order:=msg.CaptureOrder
 local:=func(text string)string{for _,key:=range []string{memberUnavailableKey,noReplacementKey}{text=strings.ReplaceAll(text,key,r.localText(locale,key,key))};return text}
 order.PlanReason=local(order.PlanReason);for _,c:=range order.Candidates{c.Reason=local(c.Reason)};for i:=range order.Events{order.Events[i]=local(order.Events[i])}
}
