}
func (r *Runtime) advanceCombatBodies(s *behavior.CombatState, seconds int64) {
	if seconds <= 0 {
		return
	}
	for i := range s.Actors {
		a := &s.Actors[i]
		if len(a.Body) == 0 {
			continue
		}
		b := combatBody(*a)
		events := combatWounds.Tick(&b, seconds)
		projectWoundBody(a, b)
		appendWoundEvents(s, *a, events)
		r.stopWoundedFight(s, a)
  r.shiftWoundedFall(s,a)
	}
}
func (r *Runtime) releaseWoundPressure(s *behavior.CombatState, helper string) {
	for i := range s.Actors {
		a := &s.Actors[i]
		if len(a.Body) == 0 {
			continue
		}
		b := combatBody(*a)
		changed := false
		for _, w := range b.Wounds {
			if w.Pressure == helper {
				_, _ = combatWounds.ApplyAid(&b, wounds.AidAct{Kind: "pressure", Wound: w.ID, By: helper, Release: true})
				changed = true
			}
		}
		if changed {
			projectWoundBody(a, b)
		}
	}
}
func (r *Runtime) storeWoundBody(c behavior.Combatant) {
	if len(c.Body) == 0 {
		return
	}
	b := combatBody(c)
	r.state.Wounds.Version = 1
	for i, old := range r.state.Wounds.Bodies {
		if old.ID == b.ID {
			r.state.Wounds.Bodies[i] = b.Clone()
			return
		}
	}
	r.state.Wounds.Bodies = append(r.state.Wounds.Bodies, b.Clone())
	sort.Slice(r.state.Wounds.Bodies, func(i, j int) bool { return r.state.Wounds.Bodies[i].ID < r.state.Wounds.Bodies[j].ID })
}
func (r *Runtime) dropWoundedWeapon(a *behavior.Combatant, level string) error {
	if len(a.Body) == 0 || a.BodyCanHold && !(a.Surrendered&&r.world.CombatLife.SurrenderDropsWeapon) {
		return nil
	}
	var moves []inv.Move
	for _, id := range combatItemKeys(r.state.Inventory) {
		i := r.state.Inventory.Items[id]
		if i.Location.Store == inv.ActorStore(a.ID) && (i.Location.Slot == "hand.main" || i.Location.Slot == "hand.off") {
			moves = append(moves, inv.Move{Item: id, Quantity: i.Quantity, ExpectedRevision: i.Revision, To: inv.Location{Kind: "ground", Level: level, At: inv.Cell{X: a.Position.X, Y: a.Position.Y}}})
		}
	}
	if len(moves) > 0 {
		_, err := r.state.Inventory.Apply(r.inventoryModelFor(true), inv.Transaction{Actor: a.ID, Sequence: r.state.Inventory.Cursors[a.ID].Sequence + 1, RequestTag: fmt.Sprintf("wounds/drop/%s/%d", a.ID, r.state.Inventory.Revision), Moves: moves})
		if err != nil {
			return err
		}
	}
	return nil
}
func (r *Runtime) recordWoundEvents(events []wounds.Event) {
	r.state.Wounds.Ledger.Record(events)
	for _, e := range events {
		switch e.Type {
		case "chip_alarm":
			if level, at, ok := r.knownCombatLifeActor(e.Body); ok {
				ids := make([]string, 0, len(r.world.CombatLife.Responders))
				for id := range r.world.CombatLife.Responders {
					ids = append(ids, id)
				}
				sort.Strings(ids)
				for _, id := range ids {
					where, cell, present := r.knownCombatLifeActor(id)
					if present && where == level && r.combatResponderInLevel(r.world.CombatLife.Responders[id], level) {
						r.combatWorldSafety(combatLifeObserver{ID: id, Level: where, At: cell}, at, "investigate")
					}
				}
			}
		case "down", "dead":
			if level, at, ok := r.knownCombatLifeActor(e.Body); ok {
				for _, observer := range r.combatWorldObservers(level, at) {
					if observer.ID != e.Body && r.combatWorldVisible(observer, at) {
						r.BarkEvent(observer.ID, "ally_down", "ally_down", "")
					}
				}
			}
			if e.Type == "dead" && e.Culprit != "" && e.Culprit != e.Body {
				found := false
				for _, old := range r.state.WoundCrimes {
					found = found || old.Body == e.Body
				}
				if !found {
					r.state.WoundCrimes = append(r.state.WoundCrimes, e)
					r.woundKillingCase(e)
				}
			}
		}
	}
}
func (r *Runtime) commitWoundBodies(previous behavior.CombatState) error {
	for _, event := range r.state.Combat.Events {
		if event.Sequence > previous.EventSeq && (event.Type == "down" || event.Type == "dead" || event.Type == "chip_alarm" || event.Type == "story_node") {
			r.recordWoundEvents([]wounds.Event{{Type: event.Type, Body: event.TargetID, At: event.BodySecond, Wound: event.ItemID, Culprit: event.Culprit, Crime: event.Crime}})
		}
	}
	for i := range r.state.Combat.Actors {
		c := &r.state.Combat.Actors[i]
  if c.Surrendered&&c.StandDownUntil==0{c.StandDownUntil=combatBody(*c).Clock+r.world.CombatRuntime.ShockFallSeconds}
		if err := r.dropWoundedWeapon(c, r.state.Combat.LevelID); err != nil {
			return err
		}
		r.refreshCombatEquipment(r.state.Inventory,c)
		r.storeWoundBody(*c)
	}
	return nil
}
func (r *Runtime) advanceWoundCare() error {
	r.combatCareTrack()
	ids := make([]string, 0, len(r.state.CombatRoster))
	for id := range r.state.CombatRoster {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		if r.state.Combat.Active && r.state.Combat.Actor(id) != nil {
			r.state.CombatCare.Clocks[id] = r.state.Life.Seconds
			continue
		}
		at, onFloor := r.combatCareOnFloor(id)
		if !onFloor {
			continue
		}
		elapsed := r.state.Life.Seconds - r.state.CombatCare.Clocks[id]
		if elapsed <= 0 {
			continue
		}
		c := cloneCombatant(r.state.CombatRoster[id])
		r.initializeWoundBody(&c)
		c.Position = at
		b := combatBody(c)
		// NPCs help themselves using the same aid plan and finite inventory. The
		// loop advances real seconds and is bounded by supplies and treatment work.
		for elapsed > 0 {
   if c.Aid!=nil&&r.woundCareThreatened(c){c.Aid=nil;for i:=range b.Wounds{b.Wounds[i].Pressure=""}}
			if id != playerActorID && combatWounds.Status(b).Conscious && c.Aid == nil {
				c.Controlled = false
				c.AP = r.world.CombatRuntime.Rules.APPerTurn
				c.FightResponse = ""
				planning := c
				planning.Surrendered = false
				planning.Withdrawn = false
				candidates := r.woundAidCandidates(planning)
				if len(candidates) > 0 {
					plan, err := r.woundAidPlan(c, candidates[0].Action)
					if err != nil {
						return err
					}
					if err := r.consumeCombatStock(&r.state.Inventory, id, plan.Item, 1, nil); err != nil {
						return err
					}
					c.Aid = plan
				}
			}
			span := elapsed
			if id != playerActorID && c.Aid != nil {
				span = min(span, int64(c.Aid.RemainingS))
			}
			events := combatWounds.Tick(&b, span)
			projectWoundBody(&c, b)
			r.recordWoundEvents(events)
			elapsed -= span
			if id != playerActorID && c.Aid != nil {
				c.Aid.RemainingS -= int(span)
				if c.Aid.RemainingS <= 0 {
					result, err := r.completeWoundAid(&c, c.Aid)
					if err != nil {
						return err
					}
					r.recordWoundEvents(result.Events)
					b = combatBody(c)
				}
			}
		}
		if c.Surrendered&&c.StandDownUntil>0&&combatBody(c).Clock>=c.StandDownUntil{c.Surrendered=false;c.StandDownUntil=0;c.FightResponse=""}
  if c.FightResponse == "fall" && combatWounds.Status(combatBody(c)).Standing {
			c.FightResponse = ""
		}
		c.Overwatch = false
		c.Guarding = false
		c.ReservedAP = 0
		rules := r.world.CombatRuntime.Rules
		c.Suppression = max(0, c.Suppression-rules.SuppressionRecovery)
		c.Morale = min(c.Courage, c.Morale+rules.MoraleRecovery)
		if err := r.dropWoundedWeapon(&c, r.actorWoundLevel(id)); err != nil {
			return err
		}
		r.refreshCombatEquipment(r.state.Inventory, &c)
		r.state.CombatRoster[id] = c
		r.state.CombatCare.Clocks[id] = r.state.Life.Seconds
		r.storeWoundBody(c)
		r.combatCareHold(c)
	}
	return nil
}
func (r *Runtime) actorWoundLevel(id string) string {
	level, _, _ := r.knownCombatLifeActor(id)
	return level
}
func (r *Runtime) applyWoundLifeLimits() {
	for id, c := range r.state.CombatRoster {
		if r.state.Combat.Active && r.state.Combat.Actor(id) != nil {
			continue
		}
		c = r.advanceRising(id, c)
		r.combatCareHold(c)
		st := combatWounds.Status(combatBody(c))
		pace := int64(0)
		if len(combatBody(c).Wounds) > 0 || st.LostPermille > 0 {
			pace = st.PaceMMS
		}
		if a := r.state.Life.Actor(id); a != nil {
			a.WoundPaceMMS = pace
		}
		for i := range r.state.Life.Population.Actors {
			a := &r.state.Life.Population.Actors[i]
			if a.ID == id {
				a.WoundPaceMMS = pace
			}
		}
	}
}

func (r *Runtime) woundAttackAngle(a, b behavior.Combatant) string {
	dx, dy := float64(a.Position.X-b.Position.X), float64(a.Position.Y-b.Position.Y)
	fx, fy := float64(b.Facing.X), float64(b.Facing.Y)
	norm := math.Hypot(dx, dy) * math.Hypot(fx, fy)
	if norm == 0 {
		return "front"
	}
	dot := (dx*fx + dy*fy) / norm
	if dot < -0.5 {
		return "rear"
	}
	if dot < .5 {
		return "flank"
	}
	return "front"
}

// The fall has an authoritative endpoint. Animation may interpolate, never invent displacement.
func(r *Runtime)fallStripClear(s behavior.CombatState,a behavior.Combatant,dir behavior.Cell,length,width int)bool{
 space:=r.combatSpace(s);unit:=max(1,space.CellMM);norm:=math.Hypot(float64(dir.X),float64(dir.Y));if norm==0{return false}
 dx,dy:=float64(dir.X)/norm,float64(dir.Y)/norm
 // Conservative 125mm samples mapped to physical navigation cells, including both shoulders.
 for along:=-250;along<=length;along+=125{for across:=-width/2;across<=width/2;across+=125{
  p:=behavior.Cell{X:a.Position.X+int(math.Round((float64(along)*dx-float64(across)*dy)/float64(unit))),Y:a.Position.Y+int(math.Round((float64(along)*dy+float64(across)*dx)/float64(unit)))}
  if p.X<0||p.Y<0||p.X>=space.Space.Width||p.Y>=space.Space.Height||space.Space.Blocked[p]||space.Space.Walkable!=nil&&!space.Space.Walkable(p){return false}
  for _,other:=range s.Actors{if other.ID!=a.ID&&other.HP>0&&other.Position==p{return false}}
 }};return true
}
