package config

import (
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"sync"

	"github.com/ilyakaznacheev/cleanenv"
	"github.com/joho/godotenv"
)

type Config struct {
	{{- range .Fields }}
	{{ FieldName . }} {{ ConfigType . }} `env:"{{ .EnvVar }}"{{ if ne .Default "" }} env-default:"{{ ConfigDefault . }}"{{ else if not .IsOptional }} env-required:"true"{{ end }}`
	{{- end }}
}

func Load() (*Config, error) {
	var cfg Config

	// Prefer a local .env file when present. When running nested entrypoints like
	// cmd/server/main.go, walk parent directories until repository root.
	envPath, err := findDotEnv()
	if err != nil {
		return nil, fmt.Errorf("config error: %w", err)
	}
	if envPath != "" {
		if err := applyDotEnvDefaults(envPath); err != nil {
			return nil, fmt.Errorf("config error: %w", err)
		}
	}
	if err := cleanenv.ReadEnv(&cfg); err != nil {
		return nil, fmt.Errorf("config error: %w", err)
	}

	if err := validateJWTConfig(&cfg); err != nil {
		return nil, fmt.Errorf("config error: %w", err)
	}

	return &cfg, nil
}

// dotEnvMu serializes applyDotEnvDefaults: Load runs from many goroutines at
// once (every request that reads the mail settings).
var dotEnvMu sync.Mutex

// applyDotEnvDefaults treats the .env file as defaults: a key the process
// environment already has (EMAIL_DRY_RUN=true go run ..., t.Setenv in a test)
// is never touched, only missing keys are added. It used to load the file over
// the environment and put the old values back afterwards; a Load running at the
// same time could snapshot the file's values in that window and "restore" them
// for good, so a request or test briefly (or permanently) saw the file instead
// of what the process was started with.
func applyDotEnvDefaults(path string) error {
	values, err := godotenv.Read(path)
	if err != nil {
		return err
	}
	dotEnvMu.Lock()
	defer dotEnvMu.Unlock()
	for key, value := range values {
		if _, set := os.LookupEnv(key); !set {
			if err := os.Setenv(key, value); err != nil {
				return err
			}
		}
	}
	return nil
}

func findDotEnv() (string, error) {
	wd, err := os.Getwd()
	if err != nil {
		return "", err
	}
	for {
		candidate := filepath.Join(wd, ".env")
		if _, err := os.Stat(candidate); err == nil {
			return candidate, nil
		} else if !os.IsNotExist(err) {
			return "", err
		}
		parent := filepath.Dir(wd)
		if parent == wd {
			return "", nil
		}
		wd = parent
	}
}

func validateJWTConfig(cfg *Config) error {
	if cfg == nil {
		return fmt.Errorf("nil config")
	}
	alg := strings.ToUpper(strings.TrimSpace(cfg.JWTAlg))
	switch alg {
	case "", "HS256":
		if strings.TrimSpace(cfg.JWTPrivateKey) == "" {
			return fmt.Errorf("JWT_PRIVATE_KEY is required for HS256")
		}
	case "RS256", "ES256":
		if strings.TrimSpace(cfg.JWTPublicKey) == "" {
			return fmt.Errorf("JWT_PUBLIC_KEY is required for %s", alg)
		}
	}
	return nil
}
