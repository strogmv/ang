type authContextKey struct{}

type authContext struct {
	UserID    string
	CompanyID string
	Roles     []string
	Perms     []string
	Scopes    []string
	Locale    string
	Timezone  string
}

type opaqueSessionPayload struct {
	ID           string   `json:"id,omitempty"`
	RefreshToken string   `json:"rt"`
	UserID       string   `json:"uid"`
	CompanyID    string   `json:"cid,omitempty"`
	Roles        []string `json:"roles,omitempty"`
	Perms        []string `json:"perms,omitempty"`
	Scopes       []string `json:"scopes,omitempty"`
	Locale       string   `json:"locale,omitempty"`
	Timezone     string   `json:"timezone,omitempty"`
	ExpiresAt    int64    `json:"exp,omitempty"`
	// LastActiveAt is the last request that counted as the person using the
	// app (unix seconds). The idle deadline is LastActiveAt plus
	// AUTH_SESSION_IDLE_TTL; requests marked passive leave it alone.
	LastActiveAt int64 `json:"act,omitempty"`
	// Ended is set once the server has closed the session ("idle" or
	// "expired"). The record stays for a while as a tombstone so that every
	// tab still holding the cookie gets the same answer.
	Ended string `json:"ended,omitempty"`
}

// sessionEndedError: the cookie names a session that no longer admits
// requests. Reason is "idle", "expired" or "ended" (logged out elsewhere,
// revoked, or long gone).
type sessionEndedError struct {
	reason string
}

func (e *sessionEndedError) Error() string { return "opaque session " + e.reason }

// sessionStoreError: the session could not be read or written. Nothing is
// known about the session, so the answer is 503 and the cookie is kept.
type sessionStoreError struct {
	err error
}

func (e *sessionStoreError) Error() string { return "session store: " + e.err.Error() }

func (e *sessionStoreError) Unwrap() error { return e.err }

const (
	// A request carrying "X-Session-Activity: passive" is answered normally
	// but does not count as the person using the app: background polling,
	// presence heartbeats and requests sent while the tab is idle say so, and
	// only real activity moves the idle deadline.
	sessionActivityHeader  = "X-Session-Activity"
	sessionActivityPassive = "passive"
	// Response headers that let the client show a warning before the server
	// ends the session. Remaining times are relative, so client clock skew
	// does not matter.
	sessionIdleTimeoutHeader   = "X-Session-Idle-Timeout"
	sessionIdleRemainingHeader = "X-Session-Idle-Remaining"
	sessionRemainingHeader     = "X-Session-Remaining"
	// How long an ended session keeps its tombstone.
	sessionEndedGrace = time.Hour
)

