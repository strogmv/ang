// witnessFor: the fact written now (minus ago seconds) with the person as its witness.
func witnessFor(r *Runtime, who, fact string, ago int64) {
	r.memoryWrite(fact, nil, talkCtx{self: who, quiet: true})
	rec := r.state.Memory.Facts[fact]
	rec.Witnesses = append(rec.Witnesses, who)
	rec.Second -= ago
	rec.First = rec.Second
	r.state.Memory.Facts[fact] = rec
}

