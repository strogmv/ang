  {ID:"hero",Steps:[]LifeStep{{Level:"hall",At:Cell{5,2},Activity:"rest"},{AtMinute:1,Level:"hall",At:Cell{7,2},Activity:"work"}}},
  {ID:"service",Steps:[]LifeStep{{Level:"hall",At:Cell{6,2},Activity:"service"}}},
 }}
 m.Population=PopulationModel{MaxActors:1,MaxActive:1,MoveTicks:3,ColdStepSeconds:10,ShiftOffsets:[]int64{0},Stages:[]PopulationStage{{ID:"home",Level:"hall",Activity:"rest"},{ID:"work",Level:"hall",Activity:"work",AtSecond:60},{ID:"leisure",Level:"hall",Activity:"market",AtSecond:600}},Anchors:map[string][]Cell{"hall":{{4,2}}},Profiles:[]PopulationProfileDefinition{{ID:"resident",Home:&PopulationPlaceRule{StageID:"home",Levels:[]string{"hall"}},Work:&PopulationPlaceRule{StageID:"work",Levels:[]string{"hall"}},Leisure:&PopulationPlaceRule{StageID:"leisure",Levels:[]string{"hall"}}}}}
 s,err:=m.StartWithPopulation(1,"hero");if err!=nil{t.Fatal(err)};s.Population.Actors[0].Profile.Work.At=Cell{5,1}
 var replay *LifeState
 for tick:=int64(1);tick<=90;tick++{
  autonomousMixedFlowAdvance(t,m,&s,tick)
