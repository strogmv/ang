			sharedTrip, savedInTrip := false, false
			for range 4500 {
				hero := r.state.Life.Actor(playerActorID)
				savely := r.state.Life.Actor(hub19Savely)
				if hero.Trip != nil && savely.Trip != nil && hero.Trip.Edge == savely.Trip.Edge && hero.Trip.Departure == savely.Trip.Departure {
					sharedTrip = true
					if !savedInTrip {
