func TestTradePrepareNativeProof(t *testing.T) {
	if *tradeProofDir == "" {
		t.Skip("opt-in native trade fixtures")
	}
	for _, name := range []string{"counter", "akim", "fittings"} {
		r := startFixture(t, nil, "life")
		r.state.Life.SecondsPerTick = 1
		r.lifeSetManual(r.state.Life.Actor(playerActorID), true)
		switch name {
		case "counter":
			sh := placeTradeCustomer(t, r, tradeGleb)
			a, _ := r.peddlerAccount(playerActorID)
			a.Balance = 240
			r.state.Inventory.Accounts[a.ID] = a
			openWith(t, r, sh.Owner)
		case "fittings":
			sh := placeTradeCustomer(t, r, "char.market_trader_matvey_khor")
			openWith(t, r, sh.Owner)
		case "akim":
			p := akimAt(t, r)
			dressSupply(t, r, "test.trade.headlamp", "item.hub_light_headlamp", r.dressPack(r.state.Inventory))
			openWith(t, r, p.Actor)
		}
		const slot = "slot3"
		if err := r.writeSave(slot, r.snapshotState()); err != nil {
			t.Fatal(err)
		}
		if _, _, err := r.readSave(slot); err != nil {
			occupied := map[behavior.Cell]string{}
			for _, a := range r.state.Life.Actors {
				if !a.OnFloor() || a.Level != r.currentLevel() {
					continue
				}
				if first := occupied[a.Position]; first != "" {
					t.Logf("%s and %s at %v", first, a.ID, a.Position)
				}
				occupied[a.Position] = a.ID
			}
			t.Fatalf("%s fixture: %v", name, err)
		}
		data, err := os.ReadFile(r.slotFile(slot))
		if err != nil {
			t.Fatal(err)
		}
		if err := os.MkdirAll(*tradeProofDir, 0755); err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(filepath.Join(*tradeProofDir, fmt.Sprintf("%s.json", name)), data, 0644); err != nil {
			t.Fatal(err)
		}
	}
}
