}
func(r *Runtime) sceneOccupied(p point,except string)bool{if p==r.state.Player{return true};for _,a:=range r.sceneActors(){if a.ID!=except&&a.Position==p{return true}};return false}
func(r *Runtime) sceneVisible(from,to behavior.Cell)bool{
