// Code generated by ANG. NPC stage 0 runtime regressions.
package poc
import("encoding/json";"reflect";"testing";"angelsdemons/server/internal/behavior")
func npc0Outcome(r *Runtime)string{life:=r.state.Life.Clone();b,_:=json.Marshal(struct{Named []behavior.LifeActor;Population []behavior.PopulationActor}{life.Actors,life.Population.Actors});return string(b)}
func TestNPC0SeedReplaySaveAndCausalJournal(t *testing.T){
 a,b,c:=populationRuntimeFixture(t,100),populationRuntimeFixture(t,100),populationRuntimeFixture(t,100)
 a.state.Seed=1;b.state.Seed=1;c.state.Seed=99;var resumed *Runtime;different:=false
 for i:=0;i<720;i++{
  before:=map[string]string{};for _,actor:=range a.state.Life.Actors{before[actor.ID]=actor.Activity};for _,actor:=range a.state.Life.Population.Actors{before[actor.ID]=actor.Activity}
  for _,r:=range []*Runtime{a,b,c,resumed}{if r==nil{continue};r.state.Tick++;if err:=r.advanceLifeFrameBy(30);err!=nil{t.Fatal(err)};if r.state.Paused{t.Fatalf("runtime paused: %s",r.state.Life.PopulationFailure)}}
  if npc0Outcome(a)!=npc0Outcome(b){t.Fatal("same seed diverged")};different=different||npc0Outcome(a)!=npc0Outcome(c)
  if resumed!=nil&&npc0Outcome(a)!=npc0Outcome(resumed){for j,actor:=range a.state.Life.Actors{if !reflect.DeepEqual(actor,resumed.state.Life.Actors[j]){t.Logf("named continuous=%+v loaded=%+v",actor,resumed.state.Life.Actors[j])}};for j,actor:=range a.state.Life.Population.Actors{if !reflect.DeepEqual(actor,resumed.state.Life.Population.Actors[j]){t.Logf("population continuous=%+v loaded=%+v",actor,resumed.state.Life.Population.Actors[j])}};t.Fatalf("save/load changed outcome at %d",i)}
  named,pop:=a.LifeDecisionLog();entries:=append(named,pop...)
  check:=func(id,activity string){if before[id]==activity{return};for _,e:=range entries{if e.Actor==id&&e.Tick==a.state.Tick&&e.Decision==activity&&e.Reason!=""{return}};t.Fatalf("activity changed without reason: %s %s -> %s",id,before[id],activity)}
  for _,actor:=range a.state.Life.Actors{check(actor.ID,actor.Activity)};for _,actor:=range a.state.Life.Population.Actors{check(actor.ID,actor.Activity)}
  if i==200{snapshot:=a.snapshotState();slot:=a.world.Config.SaveSlots[0];if err:=a.writeSave(slot,snapshot);err!=nil{t.Fatal(err)};restored,_,err:=a.readSave(slot);if err!=nil{t.Fatal(err)};resumed=populationRuntimeFixture(t,0);resumed.state=restored;if !reflect.DeepEqual(snapshot.Life.Clone(),restored.Life.Clone()){t.Fatal("saved journal or RNG state changed")}}
 }
 if !different{t.Fatal("seed changed metadata but no NPC outcome")}
 if a.state.Life.Population.Decisions.Total==0||len(a.state.Life.Population.Decisions.Entries)>behavior.DecisionLogLimit{t.Fatal("missing or unbounded runtime journal")}
}
func TestNPC0CaptureMemberDropout(t *testing.T){
 r:=emergentFixture(t);frozen:=-1;var at point;var selectedBefore []string;replaced:=false
 for r.state.Tick<3000&&!r.state.Demo.Delivered{
  r.step();d:=&r.state.Demo
  if frozen<0&&len(r.squadMembers())>=r.world.Config.CaptureDemo.RequiredResponders&&d.Squad.Phase!=""{for _,member:=range r.squadMembers(){selectedBefore=append(selectedBefore,member.ID)};frozen=r.demoAgentIndex(selectedBefore[0]);at=d.Agents[frozen].Position}
  if frozen>=0{a:=&d.Agents[frozen];a.Position,a.Goal,a.Path=at,at,nil}
  for _,c:=range d.Candidates{if c.Selected{found:=false;for _,id:=range selectedBefore{found=found||id==c.AgentID};replaced=replaced||len(selectedBefore)>0&&!found}}
 }
 d:=r.state.Demo;if frozen<0{t.Fatal("dropout was not injected")}
 if !d.Delivered&&(d.Plan.Status!="failed"||d.Squad.Phase!="cancelled"||d.Plan.Reason==""){t.Fatalf("dropout left a hanging group: phase=%s plan=%s",d.Squad.Phase,d.Plan.Diagnostic())}
 if !replaced&&d.Plan.Reason!=noReplacementKey{t.Fatal("neither replacement nor explicit no-replacement cancellation")}
 before:=len(d.AlarmLog);tick:=int64(0);for _,a:=range d.Residents{tick+=a.LastReportTick}
 for i:=0;i<200;i++{r.step()};after:=int64(0);for _,a:=range r.state.Demo.Residents{after+=a.LastReportTick};if len(r.state.Demo.AlarmLog)!=before||after!=tick{t.Fatal("terminal mission continued sighting spam")}
 t.Logf("capture-member-dropout: replaced=%t delivered=%t status=%s phase=%s reason=%s",replaced,d.Delivered,d.Plan.Status,d.Squad.Phase,d.Plan.Reason)
}
func TestNPC0CaptureNoReplacementCancelsAndPersists(t *testing.T){
 r:=emergentFixture(t);for r.state.Tick<500&&len(r.squadMembers())<3{r.step()};members:=r.squadMembers();if len(members)<3{t.Fatal("team not formed")}
 for i:=range r.state.Demo.Candidates{c:=&r.state.Demo.Candidates[i];if !c.Selected{c.Unavailable=true}}
 r.replaceCaptureMember(members[0].ID);d:=r.state.Demo
 if d.Plan.Status!="failed"||d.Squad.Phase!="cancelled"||d.Plan.Reason!=noReplacementKey{t.Fatal("no-reserve cancellation failed")}
 snapshot:=r.snapshotState();slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,snapshot);err!=nil{t.Fatal(err)};loaded,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};if !reflect.DeepEqual(snapshot.Demo,loaded.Demo){t.Fatal("dropout reason lost on load")}
}
