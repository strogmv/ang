}
func(r *Runtime) path(from,to point)[]point{return r.pathAvoid(from,to,nil)}
func(r *Runtime) pathAvoid(from,to point,blocked map[point]bool)[]point{
 if from==to||!r.walkable(to)||blocked[to]{return nil};queue:=[]point{from};seen:=map[point]bool{from:true};prev:=map[point]point{}
 for len(queue)>0{p:=queue[0];queue=queue[1:];if p==to{var route []point;for p!=from{route=append(route,p);p=prev[p]};for i,j:=0,len(route)-1;i<j;i,j=i+1,j-1{route[i],route[j]=route[j],route[i]};return route}
  for _,d:=range []point{{1,0},{0,1},{-1,0},{0,-1}}{n:=point{p.X+d.X,p.Y+d.Y};if !seen[n]&&r.walkable(n)&&!blocked[n]{seen[n]=true;prev[n]=p;queue=append(queue,n)}}
 };return nil
}

// Keep a generated diagnostic with the source content identity.
func(r *Runtime) String()string{return fmt.Sprintf("CUE POC world %s",r.world.ContentHash)}
