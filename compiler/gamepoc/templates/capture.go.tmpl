  d.HeroActionTick=r.state.Tick;d.HeroOffenceUntil=r.state.Tick+r.world.AI.Policy.Perception.OffenceVisibleTicks
  r.emitSound(cfg.HeroAction.Sound,r.targetPosition(),r.missionSubject(),"offence");r.demoEvent(fmt.Sprintf("Герой: %s в (%d,%d) — звук слышен в округе",cfg.HeroAction.Sound,r.targetPosition().X,r.targetPosition().Y))
 }
