func peddlerRequest(r *Runtime, action string, item inv.Item, store string) *pb.PocInventoryCommand {
	return &pb.PocInventoryCommand{Epoch: r.state.Epoch, Sequence: r.state.Inventory.Cursors[playerActorID].Sequence + 1, Action: action, ItemId: item.ID, Quantity: 1, ExpectedRevision: item.Revision, StoreId: store}
}
func peddlerHasFact(r *Runtime, event, subject string) bool {
	for _, f := range r.barkFacts(r.world.Peddlers.Level) {
		if f.Event == event && f.Subject == subject {
			return true
		}
	}
	return false
}

// The round: every peddler walks his stops by the schedule; the shop opens only at a stop in his hours, for at least
// the two minutes of a stop and at most a slot, and never while he walks.
func TestPeddlersRoundOpensAtStopsBySchedule(t *testing.T) {
	r := peddlerFixture(t)
	type run struct {
		stop  string
		since int64
	}
	visited := map[string]map[string]bool{}
	current := map[string]run{}
	stands := map[string][]int64{}
	end := int64(9*3600 + 50*60)
	for r.state.Life.Seconds < end {
		peddlerStep(t, r)
		now := r.state.Life.Seconds
		for _, p := range r.world.Peddlers.Peddlers {
			stop := r.peddlerStopNow(p)
			day := now % 86400
			if stop != "" && (day < p.OpenSecond || day >= p.CloseSecond) {
				t.Fatalf("%s open out of hours at %d", p.Shop, day)
			}
			if c := current[p.Shop]; c.stop != stop {
				if c.stop != "" {
					stands[p.Shop] = append(stands[p.Shop], now-c.since)
				}
				current[p.Shop] = run{stop: stop, since: now}
			}
			if stop != "" {
				if visited[p.Shop] == nil {
					visited[p.Shop] = map[string]bool{}
				}
				visited[p.Shop][stop] = true
			}
		}
	}
	shops:=[]string{"peddler.klava","peddler.akim"};if r.world.CalendarEncounter==nil{shops=append(shops,"peddler.prokhor")}
 for _, shop := range shops {
		if len(visited[shop]) < 3 {
			t.Fatalf("%s stood at %d stops by %d, want 3+ (%v)", shop, len(visited[shop]), end, visited[shop])
		}
		long := 0
		for _, d := range stands[shop] {
			if d >= 110 {
				long++
			}
			if d > 6*60 {
				t.Fatalf("%s stood %d s at one stop (a slot is at most 6 min)", shop, d)
			}
		}
		if long < 2 {
			t.Fatalf("%s never stood two minutes at a stop: %v", shop, stands[shop])
		}
	}
	if len(visited["peddler.mitya"]) != 0 {
		t.Fatal("the teenager traded before his afternoon hours")
	}
	t.Logf("PEDDLER_ROUND stands %v visited %v", stands, visited)
}

// The trade keeps goods and money: a piece off Klava's tray for law.price_market's price (once, also when replayed), junk
// to Akim's cart by weight, refusals change nothing, the facts of the deal reach the barks.
func TestPeddlersTradeKeepsGoodsAndMoney(t *testing.T) {
	r := peddlerFixture(t)
	klava, akim := peddlerNamed(t, r, "peddler.klava"), peddlerNamed(t, r, "peddler.akim")
	peddlerOpenAt(t, r, klava, 0)
	peddlerHeroBeside(t, r, klava, 0)
	money, goods := peddlerMoney(r), commerceTotal(r.state.Inventory)
	tape := peddlerFirstOnTray(r, klava, "item.hub_tape_roll")
	if tape.ID == "" {
		t.Fatal("Klava has no tape on her tray")
	}
	price := r.peddlerLawPrice(tape, r.craftingClassStock())
	hero0, klava0, left := peddlerBalance(r, playerActorID), peddlerBalance(r, klava.Actor), tape.Quantity
	req := peddlerRequest(r, "buy", tape, klava.Tray)
	if !inventoryRequest(t, r, req) {
		t.Fatal("purchase from the tray refused")
	}
	if peddlerBalance(r, playerActorID) != hero0-price || peddlerBalance(r, klava.Actor) != klava0+price || peddlerMoney(r) != money || commerceTotal(r.state.Inventory) != goods {
		t.Fatal("purchase did not move exactly the price, or created / lost money or goods")
	}
	if r.state.Inventory.Items[tape.ID].Quantity != left-1 || peddlerCarried(r, "item.hub_tape_roll").ID == "" {
		t.Fatal("purchase did not move one roll from the tray to the hero")
	}
	if !inventoryRequest(t, r, req) || peddlerBalance(r, playerActorID) != hero0-price {
		t.Fatal("a replayed purchase charged twice")
	}
	if !peddlerHasFact(r, "peddler.sold", klava.Actor) {
		t.Fatal("the sale is not a fact Klava can answer")
	}
	// walking away: the tray is out of reach
	peddlerPlace(t, r, playerActorID, inv.Cell{X: klava.Stops[0].At.X + 6, Y: klava.Stops[0].At.Y})
	if inventoryRequest(t, r, peddlerRequest(r, "buy", r.state.Inventory.Items[tape.ID], klava.Tray)) || peddlerBalance(r, playerActorID) != hero0-price {
		t.Fatal("bought from a peddler out of reach")
	}
	// junk to Akim: the hero's old round connector (kit), by weight, never under the floor share of the law's price
	peddlerOpenAt(t, r, akim, 2)
	peddlerHeroBeside(t, r, akim, 2)
	junk := peddlerCarried(r, "item.part.round_connector")
	if junk.ID == "" {
		t.Fatal("the hero's kit has no round connector to sell")
	}
	stock := r.craftingClassStock()
	pay, takes := r.peddlerBuyPrice(akim, junk, stock)
	if !takes || pay < 1 || pay >= r.peddlerLawPrice(junk, stock) {
		t.Fatalf("Akim's offer %d for a part of law price %d", pay, r.peddlerLawPrice(junk, stock))
	}
	money, goods = peddlerMoney(r), commerceTotal(r.state.Inventory)
	hero1, akim1 := peddlerBalance(r, playerActorID), peddlerBalance(r, akim.Actor)
	if !inventoryRequest(t, r, peddlerRequest(r, "sell", junk, akim.Tray)) {
		t.Fatal("Akim refused the junk")
	}
	if peddlerBalance(r, playerActorID) != hero1+pay || peddlerBalance(r, akim.Actor) != akim1-pay || peddlerMoney(r) != money || commerceTotal(r.state.Inventory) != goods {
		t.Fatal("buy-back did not move exactly the price or lost goods")
	}
	sold := inv.Item{}
	for _, i := range r.state.Inventory.Items {
		if i.Location.Store == akim.Tray && i.Definition == "item.part.round_connector" {
			sold = i
		}
	}
	if sold.ID == "" || sold.Owner != akim.Actor || !sold.ForSale || sold.Grade != junk.Grade {
		t.Fatalf("the junk is not on Akim's cart for sale with its grade: %+v", sold)
	}
	if !peddlerHasFact(r, "peddler.bought", akim.Actor) {
		t.Fatal("the buy-back is not a fact Akim can answer")
	}
	// refusals: Klava buys nothing; Akim without money
	cable := peddlerCarried(r, "item.part.braided_cable")
	if cable.ID == "" {
		t.Fatal("the hero's kit has no braided cable")
	}
	if inventoryRequest(t, r, peddlerRequest(r, "sell", cable, klava.Tray)) {
		t.Fatal("Klava bought junk")
	}
	acc, _ := r.peddlerAccount(akim.Actor)
	acc.Balance = 0
	r.state.Inventory.Accounts[acc.ID] = acc
	money, goods = peddlerMoney(r), commerceTotal(r.state.Inventory)
	if inventoryRequest(t, r, peddlerRequest(r, "sell", cable, akim.Tray)) || peddlerMoney(r) != money || commerceTotal(r.state.Inventory) != goods {
		t.Fatal("a broke cart man paid, or a refusal changed the world")
	}
	if !peddlerHasFact(r, "peddler.refused", akim.Actor) {
		t.Fatal("the refusal is not a fact")
	}
	if err := r.validateInventory(r.state); err != nil {
		t.Fatal(err)
	}
}

// Junk reaches a master: the hero's connector sold to Akim goes into Matvey's working box when Akim stops by Matvey's
// counter (deal_cells) and Matvey's box is short; Akim across the hall sells nothing.
func TestPeddlersJunkReachesMaster(t *testing.T) {
	r := peddlerFixture(t)
	akim := peddlerNamed(t, r, "peddler.akim")
	ms, ok := r.world.Crafting.Master("char.market_trader_matvey_khor")
	if !ok {
		t.Skip("no master Matvey")
	}
	idx := -1
	for i, ru := range r.world.Crafting.Market.Restock {
		if ru.Master == ms.Actor && ru.Class == "round_connector" {
			idx = i
		}
	}
	if idx < 0 {
		t.Fatal("Matvey has no restock rule for round connectors")
	}
	ru := r.world.Crafting.Market.Restock[idx]
	ru.Below = r.craftingBox(ms, "round_connector") + 1 // his box is short now
	ru.Buy = 1
	stop := -1
	for k, s := range akim.Stops {
		if manhattan(point{s.At.X, s.At.Y}, point{ms.Approach.X, ms.Approach.Y}) <= r.world.Peddlers.DealCells {
			stop = k
		}
	}
	if stop < 0 {
		t.Fatal("no stop of Akim's round is near Matvey's counter")
	}
	peddlerOpenAt(t, r, akim, stop)
	peddlerHeroBeside(t, r, akim, stop)
	junk := peddlerCarried(r, "item.part.round_connector")
	if junk.ID == "" || !inventoryRequest(t, r, peddlerRequest(r, "sell", junk, akim.Tray)) {
		t.Fatal("the hero could not sell the connector to Akim")
	}
	sh := inv.Shopfront{}
	for _, s := range r.world.Inventory.Shopfronts {
		if s.ID == ms.Shop {
			sh = s
		}
	}
	peddlerPlace(t, r, ms.Actor, sh.Service.At)
	if err := r.advanceMarketSupply(); err != nil || !r.storefrontOpen(ms.Shop) {
		t.Fatalf("Matvey's stall did not open: %v", err)
	}
	acc, _ := r.peddlerAccount(ms.Actor)
	acc.Balance = 5000
	r.state.Inventory.Accounts[acc.ID] = acc
	money, goods := peddlerMoney(r), commerceTotal(r.state.Inventory)
	box0, akim0 := r.craftingBox(ms, "round_connector"), peddlerBalance(r, akim.Actor)
	far := (stop + 3) % len(akim.Stops)
	peddlerPlace(t, r, akim.Actor, akim.Stops[far].At)
	if err := r.advanceMarketSupply(); err != nil {
		t.Fatal(err)
	}
	r.craftingRestock(ms, ru)
	if r.craftingBox(ms, "round_connector") != box0 {
		t.Fatal("Matvey bought off a cart across the hall")
	}
	peddlerPlace(t, r, akim.Actor, akim.Stops[stop].At)
	if err := r.advanceMarketSupply(); err != nil {
		t.Fatal(err)
	}
	r.craftingRestock(ms, ru)
	if r.craftingBox(ms, "round_connector") != box0+1 {
		t.Fatalf("the junk did not reach Matvey's box: %d -> %d", box0, r.craftingBox(ms, "round_connector"))
	}
	got := false
	for _, i := range r.state.Inventory.Items {
		if i.Location.Store == ms.Stores[len(ms.Stores)-1] && i.Definition == "item.part.round_connector" && i.Grade == junk.Grade && i.Owner == ms.Actor {
			got = true
		}
	}
	if !got || peddlerBalance(r, akim.Actor) <= akim0 || peddlerMoney(r) != money || commerceTotal(r.state.Inventory) != goods {
		t.Fatal("the hero's connector is not in Matvey's box, or Akim was not paid, or money / goods changed")
	}
	if err := r.validateInventory(r.state); err != nil {
		t.Fatal(err)
	}
}

// Save and determinism: two runs of one seed walk the same rounds and bring out the same rare piece; a save in the middle
// loads and continues identically.
func TestPeddlersSaveLoadAndDeterminism(t *testing.T) {
	a, b := peddlerFixture(t), peddlerFixture(t)
	klava := peddlerNamed(t, a, "peddler.klava")
	for seed := int64(1); seed < 200; seed++ {
		a.state.Seed = seed
		if a.peddlerRareMoment(klava) >= 0 {
			break
		}
	}
	if a.peddlerRareMoment(klava) < 0 {
		t.Fatal("no seed brings Klava's rare piece out")
	}
	b.state.Seed = a.state.Seed
	view := func(r *Runtime) string {
		type peddler struct {
			Pos   behavior.Cell
			Stop  string
			Items []inv.Item
			Cash  int64
		}
		out := map[string]peddler{}
		for _, p := range r.world.Peddlers.Peddlers {
			x := peddler{Pos: r.state.Life.Actor(p.Actor).Position, Stop: r.peddlerStopNow(p), Cash: peddlerBalance(r, p.Actor)}
			for _, id := range sortedCraftingItems(r.state.Inventory) {
				if i := r.state.Inventory.Items[id]; i.Owner == p.Actor {
					x.Items = append(x.Items, i)
				}
			}
			out[p.Actor] = x
		}
		raw, _ := json.Marshal(struct {
			P map[string]peddler
			S peddlerState
		}{out, r.state.Peddlers})
		return string(raw)
	}
	for i := 0; i < 3600; i++ {
		peddlerStep(t, a)
		peddlerStep(t, b)
	}
	if view(a) != view(b) {
		t.Fatal("two runs of one seed diverged")
	}
	moment := a.peddlerRareMoment(klava)
	for _, r := range []*Runtime{a, b} {
		r.state.Life.Seconds = max(r.state.Life.Seconds, moment+60)
		peddlerOpenAt(t, r, klava, 1)
		if err := r.advancePeddlers(); err != nil {
			t.Fatal(err)
		}
		if r.state.Peddlers.Rare[klava.Shop] == 0 {
			t.Fatal("the rare piece did not come out of the bag")
		}
		rare := false
		for _, i := range r.state.Inventory.Items {
			if i.Location.Store == klava.Tray && i.Definition == klava.Rare.Item && i.Grade.Provenance == klava.Rare.Origin {
				rare = true
			}
		}
		if !rare {
			t.Fatal("the rare piece is not on the tray")
		}
	}
	saved := a.snapshotState()
	slot := a.world.Config.SaveSlots[0]
	if err := a.writeSave(slot, saved); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := a.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(saved.Peddlers, loaded.Peddlers) || !reflect.DeepEqual(saved.Inventory.Items, loaded.Inventory.Items) {
		t.Fatal("the peddlers' state changed on load")
	}
	a.state = loaded
	for i := 0; i < 1800; i++ {
		peddlerStep(t, a)
		peddlerStep(t, b)
	}
	if view(a) != view(b) {
		t.Fatal("a loaded game diverged from the unsaved one")
	}
}

// An older save wrote the origin "prewar" (owner 02.11: it is "heirloom" now); loading renames it and the save validates.
func TestPeddlersLegacyPrewarOriginLoads(t *testing.T) {
	r := peddlerFixture(t)
	s := r.snapshotState()
	changed := ""
	for _, id := range sortedCraftingItems(s.Inventory) {
		if i := s.Inventory.Items[id]; i.Grade.Provenance == "heirloom" {
			i.Grade.Provenance = "prewar"
			s.Inventory.Items[id] = i
			changed = id
			break
		}
	}
	if changed == "" {
		t.Fatal("the world has no old factory-made piece")
	}
	if err := r.validateInventory(s); err == nil {
		t.Fatal("a legacy origin validated before the migration")
	}
	migrateSavedOrigins(&s)
	if s.Inventory.Items[changed].Grade.Provenance != "heirloom" {
		t.Fatal("the legacy origin was not renamed")
	}
	if err := r.validateInventory(s); err != nil {
		t.Fatal(err)
	}
}

// Street sellers use the existing carried shopfront and law; no new transaction or currency.
