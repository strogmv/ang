func visibleBoardingFixture(t *testing.T) (*Runtime, behavior.LifeEdge) {
	t.Helper()
	r := lifeRuntimeFixture(t)
	c := r.world.TrainMotion
	e := r.world.Life.Edge(c.BerthEdgeID)
	if e == nil {
		t.Fatal("missing declared berth edge")
	}
	h := r.state.Life.Actor(playerActorID)
	h.Level = e.From
	h.Position = e.Exit
	h.Goal = e.Exit
	h.Path = nil
	h.PendingPath = nil
	h.Body = nil
	h.Trip = nil
	h.BoardedEdge = ""
	h.Manual = true
	h.Arrived = false
	h.OverrideLevel = e.To
	h.OverrideAt = e.Entry
	h.OverrideEdge = e.ID
	r.state.Tick = 1000
	r.state.Life.Tick = 1000
	r.syncLifeHero()
	r.syncRegionKnowledge()
	r.updateLifeExploration()
	return r, *e
}
func putVisibleBerth(r *Runtime) {
	c := r.world.TrainMotion
	ns := r.state.Tick * r.tickNS()
	start := ns - int64((c.approachSeconds()+1)*1e9)
	r.state.TrainDispatch = trainDispatchState{Initialized: true, Active: 1, Run: 1, StartNS: start, DepartNS: start + int64((c.approachSeconds()+c.BerthDwellSeconds)*1e9), Departure: c.Timetable.next(r.state.Life.Seconds, false), LastNS: ns, Rate: 10}
	for i := 0; i < 2; i++ {
		r.state.TrainDispatch.Next[i] = c.Timetable.next(r.state.Life.Seconds+1, i == 1)
	}
}
func TestVisibleTrainBoardingChargesOnceAndTripStartsWhenMoving(t *testing.T) {
	r, e := visibleBoardingFixture(t)
	before := r.state.Inventory.Clone()
	game := r.state.Life.Seconds
	r.state.Life.BeginControlledTravel(r.lifeTravelModel(), r.admitLifeTravel)
	if r.state.Life.Actor(playerActorID).Trip != nil || len(r.state.TrainPassengers) != 0 || !reflect.DeepEqual(before.Accounts, r.state.Inventory.Accounts) {
		t.Fatal("empty track admitted or charged a rider")
	}
	if err := r.completeHeroTravel(); err != nil {
		t.Fatal(err)
	}
	if r.state.Life.Seconds != game {
		t.Fatal("waiting for visible train fast-forwarded the calendar")
	}
	putVisibleBerth(r)
	r.state.Life.BeginControlledTravel(r.lifeTravelModel(), r.admitLifeTravel)
	h := r.state.Life.Actor(playerActorID)
	p, ok := r.state.TrainPassengers[playerActorID]
	if !ok || h.Trip != nil || h.BoardedEdge != e.ID || h.OnFloor() {
		t.Fatal("boarding was not separate from the journey")
	}
	if got := r.state.Inventory.Accounts[e.Fare.ReceiverAccount].Balance - before.Accounts[e.Fare.ReceiverAccount].Balance; got != e.Fare.AmountMinor {
		t.Fatal("wrong boarding fare", got)
	}
	paid := r.state.Inventory.Clone()
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	r.state = loaded
	if err := r.completeHeroTravel(); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(paid.Accounts, r.state.Inventory.Accounts) || r.state.Life.Seconds != game {
		t.Fatal("saved boarded wait paid twice or advanced time")
	}
	r.state.Tick = (p.DepartNS - 1) / r.tickNS()
	r.advanceTrainPassengers(1)
	if h = r.state.Life.Actor(playerActorID); h.Trip != nil {
		t.Fatal("journey began while doors were still closing")
	}
	r.state.Tick = (p.DepartNS + r.tickNS() - 1) / r.tickNS()
	r.advanceTrainPassengers(1)
	h = r.state.Life.Actor(playerActorID)
	if h.Trip == nil || h.BoardedEdge != "" || h.Trip.Edge != e.ID || h.Trip.Arrival-h.Trip.Departure != e.TravelSeconds || !reflect.DeepEqual(paid.Accounts, r.state.Inventory.Accounts) {
		t.Fatal("departure changed fare/duration or failed to start edge")
	}
}
func TestDockExitRefusesBareWardWithServerReason(t *testing.T) {
	r := lifeRuntimeFixture(t)
	e := r.world.Life.Edge("dock_copper_walk")
	if e == nil || e.ClosedReasonKey == "" {
		t.Fatal("bare ward exit has no data reason")
	}
	h := r.state.Life.Actor(playerActorID)
	h.Level = e.From
	h.Position = e.Exit
	h.Goal = e.Exit
	h.Path = nil
	h.PendingPath = nil
	h.Trip = nil
	h.Body = nil
	h.Manual = true
	r.syncLifeHero()
	r.syncRegionKnowledge()
	r.updateLifeExploration()
	err := r.lifeCommand(&pb.PocLifeCommand{Action: "enter", Destination: e.ID})
	if err == nil {
		t.Fatal("hero entered bare scene")
	}
	for _, locale := range []string{"ru", "en"} {
		if r.localError(locale, err) == "" || r.localError(locale, err) == e.ClosedReasonKey {
			t.Fatal("unlocalized exit refusal", locale)
		}
	}
}

func TestVisibleTrainSubtickDoorClosingRefusesBoarding(t *testing.T) {
	r, e := visibleBoardingFixture(t)
	putVisibleBerth(r)
	tick := r.tickNS()
	// Keep the physical dwell fixed while placing its end between host ticks.
	if r.state.TrainDispatch.DepartNS%tick == 0 {
		r.state.TrainDispatch.StartNS += tick / 2
		r.state.TrainDispatch.DepartNS += tick / 2
	}
	closing := r.state.TrainDispatch.DepartNS
	r.state.Tick = closing / tick
	r.state.PhaseNS = closing%tick + 1
	_, _, oldPhase, oldDoors := r.world.TrainMotion.dispatchPose(r.state.TrainDispatch, r.state.Tick*tick)
	_, _, phase, doors := r.world.TrainMotion.dispatchPose(r.state.TrainDispatch, r.simNS())
	if oldPhase != "berthed" || !oldDoors || phase != "closing" || doors {
		t.Fatal("fixture did not straddle the real door-close boundary", oldPhase, phase)
	}
	before := r.state.Inventory.Clone()
	r.state.Life.BeginControlledTravel(r.lifeTravelModel(), r.admitLifeTravel)
	h := r.state.Life.Actor(playerActorID)
	if h.BoardedEdge != "" || h.Trip != nil || len(r.state.TrainPassengers) != 0 || !reflect.DeepEqual(before.Accounts, r.state.Inventory.Accounts) {
		t.Fatal("subtick closing admitted or charged a rider", e.ID)
	}
}

func TestVisibleTrainStaleBoardedSaveIsRejected(t *testing.T) {
	r, _ := visibleBoardingFixture(t)
	putVisibleBerth(r)
	r.state.Life.BeginControlledTravel(r.lifeTravelModel(), r.admitLifeTravel)
	passenger, ok := r.state.TrainPassengers[playerActorID]
	if !ok {
		t.Fatal("fixture did not board")
	}
	fresh := r.snapshotState()
	if err := r.validateTrainPassengers(fresh); err != nil {
		t.Fatal("valid boarded save refused", err)
	}
	stale := r.snapshotState()
	stale.Tick = (passenger.DepartNS + r.tickNS() - 1) / r.tickNS()
	stale.PhaseNS = 0
	if err := r.validateTrainPassengers(stale); err == nil {
		t.Fatal("save retained a boarded wait after the train had departed")
	}
	// A real sub-tick boarding timestamp remains valid inside the same host tick.
	fresh.PhaseNS = r.tickNS() / 2
	p := fresh.TrainPassengers[playerActorID]
	p.BoardNS = fresh.Tick*r.tickNS() + fresh.PhaseNS
	fresh.TrainPassengers[playerActorID] = p
	if err := r.validateTrainPassengers(fresh); err != nil {
		t.Fatal("valid subtick boarding timestamp refused", err)
	}
}

func observedNPCBoardingFixture(t *testing.T) (*Runtime, behavior.LifeEdge, string) {
	t.Helper()
	r, e := visibleBoardingFixture(t)
	h := r.state.Life.Actor(playerActorID)
	h.Position = behavior.Cell{X: e.Exit.X - 3, Y: e.Exit.Y}
	h.Goal = h.Position
	h.OverrideLevel = ""
	h.OverrideEdge = ""
	h.Arrived = true
	id := "char.poc_hub_guard"
	a := r.state.Life.Actor(id)
	if a == nil {
		t.Fatal("existing named actor fixture missing")
	}
	a.Level = e.From
	a.Position = e.Exit
	a.Goal = e.Exit
	a.Path = nil
	a.PendingPath = nil
	a.Body = nil
	a.Trip = nil
	a.BoardedEdge = ""
	a.Manual = true
	a.Arrived = false
	a.OverrideLevel = e.To
	a.OverrideAt = e.Entry
	a.OverrideEdge = e.ID
	a.WaitingDeparture = 0
	r.world.Life.Brain.Enabled = false
	r.state.Life.Seconds = e.NextDeparture(r.state.Life.Seconds+1) - 1
	return r, e, id
}

func TestObservedNPCWaitsForVisibleTrainThenDepartsWithIt(t *testing.T) {
	r, e, id := observedNPCBoardingFixture(t)
	r.client = &connection{}
	before := r.state.Inventory.Clone()
	r.state.Life.AdvanceWithTravelBy(r.lifeTravelModel(), r.state.Life.Tick+1, 1, nil, r.admitLifeTravel)
	if a := r.state.Life.Actor(id); a.Trip != nil || a.BoardedEdge != "" || len(r.state.TrainPassengers) != 0 {
		t.Fatal("observed NPC used an invisible Life slot")
	}
	putVisibleBerth(r)
	r.state.Life.AdvanceWithTravelBy(r.lifeTravelModel(), r.state.Life.Tick+1, 1, nil, r.admitLifeTravel)
	a := r.state.Life.Actor(id)
	p, ok := r.state.TrainPassengers[id]
	if !ok || p.Paid || a.Trip != nil || a.BoardedEdge != e.ID || a.OnFloor() {
		t.Fatal("observed NPC did not board the visible train")
	}
	if !reflect.DeepEqual(before.Accounts, r.state.Inventory.Accounts) {
		t.Fatal("NPC boarding charged the hero")
	}
	r.state.Tick = (p.DepartNS + r.tickNS() - 1) / r.tickNS()
	r.advanceTrainPassengers(1)
	a = r.state.Life.Actor(id)
	if a.Trip == nil || a.BoardedEdge != "" || a.Trip.Edge != e.ID || a.Trip.Arrival-a.Trip.Departure != e.TravelSeconds {
		t.Fatal("observed NPC departed before or apart from the visible train")
	}
}

func TestUnobservedNPCPreservesOriginalLifeSlot(t *testing.T) {
	r, e, id := observedNPCBoardingFixture(t)
	r.client = nil
	before := r.state.Inventory.Clone()
	baseline := r.state.Life.Clone()
	selected := e.NextDeparture(r.state.Life.Seconds + 1)
	baseline.AdvanceWithTravelBy(r.world.Life, baseline.Tick+1, 1, nil, nil)
	r.state.Life.AdvanceWithTravelBy(r.lifeTravelModel(), r.state.Life.Tick+1, 1, nil, r.admitLifeTravel)
	a := r.state.Life.Actor(id)
	expected := baseline.Actor(id)
	if a.Trip == nil || a.Trip.Departure != selected || a.Trip.Arrival != selected+e.TravelSeconds || a.BoardedEdge != "" || len(r.state.TrainPassengers) != 0 || !reflect.DeepEqual(*a, *expected) {
		t.Fatal("unobserved NPC slot changed", a.Trip, expected.Trip)
	}
	if !reflect.DeepEqual(before.Accounts, r.state.Inventory.Accounts) {
		t.Fatal("unobserved NPC changed hero accounts")
	}
}
