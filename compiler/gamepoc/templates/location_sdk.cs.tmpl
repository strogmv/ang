   float factor=LocationSDKActorPixelScale(body,LocationSDKHeroHeightM);if(factor<=0)return;float sx=crop==null?frame*sheet.frame_w:crop.x,sy=crop==null?row*sheet.frame_h:crop.y;bool flip=crop!=null&&crop.flip_x;
   float u0=sx/texture.width,u1=(sx+w)/texture.width,v0=1-(sy+h)/texture.height,v1=1-sy/texture.height;if(flip){float swap=u0;u0=u1;u1=swap;feetX=w-feetX;}
