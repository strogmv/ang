	for _, at := range reachable {
		if at.At == a.Position {
			continue
		}
		risk := s.threatAt(space, r, *a, at.At)
		pathRisk := risk
		if advanced {
			for _, step := range at.Path {
				pathRisk = math.Max(pathRisk, s.threatAt(space, r, *a, step))
			}
		}
		gain := (baseline-risk)*r.CoverWeight - float64(at.AP)*r.MoveWeight
		if advanced {
			gain -= math.Max(0, pathRisk-math.Max(baseline, risk)) * r.CoverWeight
		}
		if advanced && combatWeaponKind(a.Weapon) == "firearm" {
			// The gun's reach is an advantage, not an invitation to walk up to a club.
			for _, contact := range a.Contacts {
				if !contact.Visible || contact.Checked || contact.Team == a.Team || contact.ThreatRangeMM >= a.Weapon.RangeMM {
					continue
				}
				desired := min(a.Weapon.RangeMM*2/3, contact.ThreatRangeMM+2000)
				distance := space.rangeMM(at.At, contact.Position)
				if distance < desired {
					gain -= float64(desired-distance) / 1000 * float64(contact.ThreatDamage) * .4
				}
			}
		}
		reason := "move to reduce known exposure"
		score := gain
		if advanced && !outmatched && nearest != math.MaxInt && combatWeaponKind(a.Weapon) != "firearm" {
			progress := float64(nearest-combatVisibleHostileDistance(space, *a, at.At)) / 1000
			score += progress * float64(a.WeaponRisk()) * .12 * r.AttackWeight
			if progress > 0 {
				reason = "close a known hostile without crossing excessive known threat"
			}
		}
		if !a.Noncombatant {
			if attack, ok := s.bestAttack(space, r, *a, at.At, a.AP-at.AP); ok {
				score = attack.Score + gain
				if outmatched && risk > 20 {
					score -= risk * r.RetreatWeight
				}
				reason = "move with AP reserved for a legal attack"
			}
		}
		if outmatched {
			nearestFrom, nearestTo := math.MaxInt, math.MaxInt
			for _, c := range a.Contacts {
				if c.Checked || c.Team == a.Team {
					continue
				}
				nearestFrom = min(nearestFrom, space.rangeMM(a.Position, c.Position))
				nearestTo = min(nearestTo, space.rangeMM(at.At, c.Position))
			}
			if nearestFrom != math.MaxInt {
				score += (float64(nearestTo-nearestFrom) / 1000) * r.RetreatWeight
				reason = "increase separation from known danger"
			}
		}
  if space.AidOptions!=nil {
   projected:=*a;projected.Position=at.At;projected.AP-=at.AP
   for _,aid:=range space.AidOptions(projected){
    if aid.AP>projected.AP{continue}
    candidate:=gain+aid.Score-risk*r.CoverWeight*float64(aid.AP)/float64(r.APPerTurn)
    if candidate>score {score=candidate;reason="reach cover with AP reserved for wound care"}
   }
  }
		add(CombatCandidate{CombatAction{Type: "move", To: at.At}, score, reason, at.AP})
	}
	// Search uses last-known/noise areas, not hidden targets. Prefer unseen
	// positions near a checked report, and stop once that uncertainty is exhausted.
	visibleEnemy := false
	for _, c := range a.Contacts {
		if c.Visible && !c.Checked && c.Team != a.Team {
			visibleEnemy = true
		}
	}
	if !visibleEnemy && !a.Noncombatant {
		for _, c := range a.Contacts {
			if c.Team == a.Team {
				continue
			}
			for _, at := range reachable {
				if at.At == a.Position {
					continue
				}
				distance := space.rangeMM(at.At, c.Position)
				if c.Checked && (distance > 3*space.CellMM || space.visible(a.Position, at.At, r)) {
					continue
				}
				progress := float64(space.rangeMM(a.Position, c.Position)-distance) / 1000
				score := progress*.5 + 1 - float64(at.AP)*r.MoveWeight - s.threatAt(space, r, *a, at.At)*r.CoverWeight
				if c.Checked {
					score = 1 - float64(distance)/float64(space.CellMM)*.1 - float64(at.AP)*r.MoveWeight
				}
				add(CombatCandidate{CombatAction{Type: "move", To: at.At}, score, "investigate last known or heard area without hidden target tracking", at.AP})
			}
		}
	}
	if a.FightResponse=="surrender" && baseline > 0 {
		// Surrender only when no positive escape or survival choice remains.
		escape := false
		for _, c := range d.Candidates {
			if c.Action.Type == "move" && c.Score > 0 {
				escape = true
			}
		}
		if !escape {
			add(CombatCandidate{CombatAction{Type: "surrender"}, 1, "critically wounded and no evaluated safe escape", 0})
		}
	}
	sort.SliceStable(d.Candidates, func(i, j int) bool {
		a, b := d.Candidates[i], d.Candidates[j]
		if math.Abs(a.Score-b.Score) > 1e-9 {
			return a.Score > b.Score
		}
		if a.AP != b.AP {
			return a.AP < b.AP
		}
		if a.Action.Type != b.Action.Type {
			return a.Action.Type < b.Action.Type
		}
		if a.Action.TargetID != b.Action.TargetID {
			return a.Action.TargetID < b.Action.TargetID
		}
		if a.Action.Mode != b.Action.Mode {
			return a.Action.Mode < b.Action.Mode
		}
		if a.Action.Aim != b.Action.Aim {
			return a.Action.Aim < b.Action.Aim
		}
		if a.Action.BodyPart != b.Action.BodyPart {
			return a.Action.BodyPart < b.Action.BodyPart
		}
		if a.Action.ItemID != b.Action.ItemID {
			return a.Action.ItemID < b.Action.ItemID
		}
		if a.Action.Type=="move"&&b.Action.Type=="move"&&space.PositionTie!=nil{av,bv:=space.PositionTie(*s.Current(),a.Action.To),space.PositionTie(*s.Current(),b.Action.To);if math.Abs(av-bv)>1e-9{return av<bv}}
  if a.Action.To.Y != b.Action.To.Y {
			return a.Action.To.Y < b.Action.To.Y
		}
		return a.Action.To.X < b.Action.To.X
	})
	d.Chosen = d.Candidates[0]
	return d
}
// A person may give up a fruitless chase after real travel without a weapon exchange.
// Sight/range are public observations; an adjacent reachable opponent is never excused by a command counter.
func(s CombatState) pursuitSpent(space CombatSpace,r CombatRules,a Combatant)bool{
 if r.PursuitTravelMM<=0{return false}
 for _,b:=range s.Actors{if b.Team!=a.Team&&b.Able()&&space.ActorVisible(a,b,r)&&space.rangeMM(a.Position,b.Position)<=max(a.Weapon.RangeMM,b.Weapon.RangeMM){return false}}
 travel:=0
 for i:=len(s.Events)-1;i>=0;i--{e:=s.Events[i];if e.Type=="attack"||e.Type=="reaction"{break};if e.ActorID==a.ID&&e.Type=="move"{travel+=space.rangeMM(e.From,e.To)}}
 return travel>=r.PursuitTravelMM
}
func (s *CombatState) StepAI(space CombatSpace, r CombatRules) error {
	a := s.Current()
	if a == nil {
		return nil
	}
	if a.Controlled {
		return errors.New("current combat actor is controlled")
	}
	if s.pursuitSpent(space,r,*a){return s.Execute(space,r,a.ID,CombatAction{Type:"stop_pursuit"})}
 // A person unable to fight and still inside the known threat can give up.
 if len(a.Body)>0&&!a.BodyCanHold&&a.FightResponse!="flee"&&!s.canLeaveCombat(space,r,*a){return s.Execute(space,r,a.ID,CombatAction{Type:"surrender"})}
 // Own loss of grip is functional incapacity, even beyond the enemy's immediate reach.
 if a.FightResponse=="flee"||len(a.Body)>0&&!a.BodyCanHold{
  if s.canLeaveCombat(space,r,*a){return s.Execute(space,r,a.ID,CombatAction{Type:"disengage"})}
  choices,_:=s.reachable(space,r,*a,a.AP,true);best,score:=a.Position,-1
  for _,at:=range choices{distance:=1000000000;for _,contact:=range a.Contacts{if contact.Visible&&contact.Team!=a.Team{distance=min(distance,space.rangeMM(at.At,contact.Position))}};if distance>score{best,score=at.At,distance}}
  if best!=a.Position{if err:=s.Execute(space,r,a.ID,CombatAction{Type:"move",To:best});err==nil{return nil}}
  return s.Execute(space,r,a.ID,CombatAction{Type:"surrender"})
 }
 d := s.Decide(space, r)
	if err := s.Execute(space, r, a.ID, d.Chosen.Action); err != nil {
        if d.Chosen.Action.Type=="move"{if e:=s.Execute(space,r,a.ID,CombatAction{Type:"end"});e!=nil{return e};if len(s.Events)>0{s.Events[len(s.Events)-1].Reason="movement stopped by an execution-time physical blocker"};return nil}
		if errors.Is(err, ErrCombatExecutionBlocked) {
			if endErr := s.Execute(space, r, a.ID, CombatAction{Type: "end"}); endErr != nil {
				return endErr
			}
			if len(s.Events) > 0 {
				s.Events[len(s.Events)-1].Reason = "shot interrupted by a body during execution; no ammunition or attack AP spent"
			}
			return nil
		}
		return err
	}
	if len(s.Events) > 0 {
		for i := len(s.Events) - 1; i >= 0; i-- {
			if s.Events[i].ActorID == a.ID && s.Events[i].Type == d.Chosen.Action.Type {
				s.Events[i].Reason = d.Chosen.Reason
				break
			}
		}
	}
	return nil
}
func (s *CombatState) RunAI(space CombatSpace, r CombatRules) error {
	// Every non-end action costs AP. This bound cannot silently end a healthy
	// actor's turn if a future zero-cost operation is added accidentally.
	limit := len(s.Actors) * r.MaxActionsPerTurn
	for n := 0; n < limit; n++ {
		a := s.Current()
		if a == nil || a.Controlled {
			return nil
		}
		if err := s.StepAI(space, r); err != nil {
			return err
		}
	}
	return errors.New("combat AI action budget exhausted")
}

// A disengagement tests personal sight and observable weapon reach, never hidden positions.
func(s CombatState)canLeaveCombat(space CombatSpace,r CombatRules,a Combatant)bool{
 if len(a.Body)>0&&!a.BodyCanWalk{return false}
 for _,b:=range s.Actors{if b.Team!=a.Team&&b.Able()&&space.ActorVisible(a,b,r)&&space.rangeMM(a.Position,b.Position)<max(a.Weapon.RangeMM,b.Weapon.RangeMM)+1500{return false}}
 return true
}

func sortedCombatTargetIDs(targets map[string]CombatTarget)[]string{ids:=make([]string,0,len(targets));for id:=range targets{ids=append(ids,id)};sort.Strings(ids);return ids}
func(s CombatState)retreatCost(space CombatSpace,r CombatRules,a Combatant,to Cell)int{
 if r.RetreatAP==0{return 0};for _,c:=range a.Contacts{if c.Visible&&c.Team!=a.Team&&space.rangeMM(a.Position,c.Position)<=c.ThreatRangeMM&&space.rangeMM(to,c.Position)>space.rangeMM(a.Position,c.Position){return r.RetreatAP}};return 0
}
func(s *CombatState)movementReactions(space CombatSpace,r CombatRules,actorID string,other Cell,before bool){
 target:=s.Actor(actorID);if target==nil{return}
 // Temporarily limit eligible reserves to actors whose reach boundary is crossed.
 reserves:=map[string]int{}
 for i:=range s.Actors{w:=&s.Actors[i];if w.ID==actorID||w.Team==target.Team{continue}
  now:=space.rangeMM(w.Position,target.Position);next:=space.rangeMM(w.Position,other)
  crosses:=before&&now<=w.Weapon.RangeMM&&next>now || !before&&now<=w.Weapon.RangeMM&&next>w.Weapon.RangeMM
  if combatWeaponKind(w.Weapon)=="firearm"&&w.Overwatch&&!before&&now<=w.Weapon.RangeMM{crosses=true}
  if !crosses{reserves[w.ID]=w.ReservedAP;w.ReservedAP=0}
 }
 trigger:="entry";if before{trigger="exit"};s.reactionWindow(space,r,actorID,trigger)
 for id,v:=range reserves{if w:=s.Actor(id);w!=nil&&w.Able(){w.ReservedAP=v}}
}
// ThreatensCare uses the next own turn's AP and physical path. No contacts or unseen
// quantities are returned to the UI; both people are subject to this same interlock.
func(s CombatState)ThreatensCare(space CombatSpace,r CombatRules,patient Combatant)bool{
 for _,enemy:=range s.Actors{if enemy.ID==patient.ID||enemy.Team==patient.Team||!enemy.Able()||enemy.StunTurns>0||!space.ActorVisible(enemy,patient,r){continue}
  if len(enemy.Body)>0&&!enemy.BodyCanHold{continue}
  if enemy.WeaponUsesLimited&&enemy.WeaponUsesRemaining<1{continue}
  budget:=max(1,r.APPerTurn-enemy.BodyAPPenalty)
  if combatWeaponKind(enemy.Weapon)=="firearm"{if enemy.Ammo>0&&budget>=enemy.Weapon.AttackAP&&(space.CanUseWeapon==nil||space.CanUseWeapon(enemy))&&space.ballisticClear(enemy.Position,patient.Position,enemy,patient,"torso"){return true};continue}
  if budget<enemy.Weapon.AttackAP{continue}
  if space.rangeMM(enemy.Position,patient.Position)<=enemy.Weapon.RangeMM&&space.ballisticClear(enemy.Position,patient.Position,enemy,patient,"torso"){return true}
  if len(enemy.Body)>0&&!enemy.BodyCanWalk{continue}
  if space.rangeMM(enemy.Position,patient.Position)>enemy.Weapon.RangeMM+(budget-enemy.Weapon.AttackAP)*1000/max(1,r.MoveAPPerMeter){continue}
  direct:=func(xFirst bool)bool{
   at:=enemy.Position;mm:=0
   for step:=0;step<r.MaxSearchCells;step++{if space.rangeMM(at,patient.Position)<=enemy.Weapon.RangeMM{return combatActorMoveAP(mm,r,enemy)<=budget-enemy.Weapon.AttackAP&&space.ballisticClear(at,patient.Position,enemy,patient,"torso")}
    to:=at;dx,dy:=patient.Position.X-at.X,patient.Position.Y-at.Y
    if (xFirst&&dx!=0)||dy==0{if dx>0{to.X++}else{to.X--}}else{if dy>0{to.Y++}else{to.Y--}}
    if !space.standable(to)||s.occupied(to,enemy.ID,space,r,enemy.Position,false)||space.Space.Occupied!=nil&&space.Space.Occupied(to){return false};mm+=space.rangeMM(at,to);if combatActorMoveAP(mm,r,enemy)>budget-enemy.Weapon.AttackAP{return false};at=to
   };return false
  }
  if direct(true)||direct(false){return true}
  reach,_:=s.reachable(space,r,enemy,budget-enemy.Weapon.AttackAP,false)
  for _,at:=range reach{if space.rangeMM(at.At,patient.Position)<=enemy.Weapon.RangeMM&&space.ballisticClear(at.At,patient.Position,enemy,patient,"torso"){return true}}
 };return false
}

func combatAbs(x int)int{if x<0{return -x};return x}

func(r CombatRules)PhysicalPart(id string)string{if t,ok:=r.Targets[id];ok&&t.Part!=""{return t.Part};return id}

func combatReactionView(a Combatant,target string)Combatant{all:=a.Contacts;a.Contacts=nil;for _,c:=range all{if c.SubjectID==target{a.Contacts=append(a.Contacts,c)}};return a}
