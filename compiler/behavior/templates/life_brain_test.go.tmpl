 if people[0].Seat==people[1].Seat||people[0].SeatQueue||people[1].SeatQueue||!people[2].SeatQueue||people[2].Seat!="q1"{t.Fatalf("seats double booked or no queue: %s %s %s",people[0].Seat,people[1].Seat,people[2].Seat)}
