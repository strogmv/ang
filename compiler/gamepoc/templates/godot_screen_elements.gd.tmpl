# Generated by ANG. Shared screen mechanics, configured by the catalog.
extends RefCounted
const C = preload("res://generated/game_contract.gd")
const Catalog = preload("res://generated/screens/catalog.gd")
var ui
var row_number := 0
func _init(screen):
	ui = screen
func _label(parent: Node, copy: String, px: int) -> Label:
	var label := Label.new()
	label.set_meta("font_px", px)
	label.text = keep_units(copy)
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.add_theme_font_size_override("font_size", roundi(px*(1.25 if ui._large() else 1.0)))
	if ui.spec.chrome == "tactical":
		label.add_theme_color_override("font_color", Color("e7e5d3"))
	parent.add_child(label)
	return label


func _button(parent: Node, copy: String, callback: Callable, id: String, wrap := false,
		px := 19, number := 0, mode := "", min_height := 48, expected_number := 0) -> Button:
	var button: Button
	copy = keep_units(copy)
	if mode == "tile" and number > 0:
		copy = str(number) + "  " + copy
	if wrap and ui.spec.chrome == "folk" and not Catalog.specification().get("response", "").is_empty():
		button = Catalog.response()
		parent.add_child(button)
		button.reduced_motion = ui._motion()
		button.configure(number, copy)
		button.ordinal.visible = number > 0
		if number > 0:
			button.set_meta("expected_ordinal", expected_number if expected_number > 0 else number)
		button.copy_label.set_meta("font_px", px)
		button.copy_label.add_theme_font_size_override("font_size", roundi(px*(1.25 if ui._large() else 1.0)))
	else:
		button = Button.new()
		button.theme_type_variation = &"QuietButton"
		if mode == "tab":
			button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			button.toggle_mode = true
		button.text = copy if not wrap else ""
		button.custom_minimum_size = Vector2(0 if mode in ["tab", "tile"] else 156, min_height)
		button.add_theme_font_size_override("font_size", roundi(px*(1.25 if ui._large() else 1.0)))
		parent.add_child(button)
		if wrap:
			var label := _label(button, copy, px)
			label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
			label.offset_left = 8 if mode == "tab" else 18
			label.offset_right = -label.offset_left
			label.offset_top = 5 if mode in ["tile", "tab"] else 10
			label.offset_bottom = -label.offset_top
			label.mouse_filter = Control.MOUSE_FILTER_IGNORE
			label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
			button.accessibility_name = copy
			button.resized.connect(func():
				var pixels := label.get_theme_font_size("font_size")
				var measured := label.get_theme_font("font").get_multiline_string_size(copy,
					HORIZONTAL_ALIGNMENT_LEFT, maxf(
					1, button.size.x-(16 if mode == "tab" else 36)), pixels, -1, \
						TextServer.BREAK_WORD_BOUND | TextServer.BREAK_MANDATORY)
				button.custom_minimum_size.y = maxf(min_height, ceilf(measured.y)+(10 if mode in ["tile",
					"tab"] else 20)))
	# Commit on press: a live view may replace the node before release.
	button.action_mode = BaseButton.ACTION_MODE_BUTTON_PRESS
	button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	button.set_meta("focus_id", id)
	button.set_meta("focus_uid", id+"@"+scope(parent)+"#"+str(ui.focus_ids.count(id)))
	button.pressed.connect(callback)
	ui.rail.append(button)
	ui.focus_ids.append(id)
	return button


func _copy(n: Dictionary, row: C.ProtoMessage) -> String:
	var parts: Array[String] = []
	if not n.get("text_key", "").is_empty():
		parts.append(ui.tr(n.text_key))
	for field in ["text", "title", "meta", "reason"]:
		if n.get("bind", {}).has(field):
			var v = ui.value(n.bind[field], row)
			if v is Array:
				for line in v:
					parts.append(str(line))
			elif v != null and not str(v).is_empty():
				if n.get("formatter", "") == "datetime":
					var offset: int = int(ui.value(n.bind.get("timezone", {"value": 0}), row))
					var date := Time.get_datetime_dict_from_unix_time(int(v)/1000 + offset)
					var fields := {}
					for key in date:
						fields[key] = str(date[key]).pad_zeros(4 if key == "year" else 2)
					parts.append(ui.tr(n.format_key).format(fields))
				elif n.get("formatter", "") == "format":
					parts.append(ui.tr(n.format_key).format({"value": v}))
				else:
					parts.append(str(v))
	if parts.is_empty() and not n.get("empty_key", "").is_empty():
		parts.append(ui.tr(n.empty_key))
	return str(n.get("join", "\n")).join(parts)


func _row_title(nodes: Array, row: C.ProtoMessage) -> String:
	for node in nodes:
		if node.get("row_title", false):
			return _copy(node, row)
	for n in nodes:
		if n.kind == "label":
			var copy := _copy(n, row)
			if not copy.is_empty():
				return copy
		elif n.kind != "list":
			var copy := _row_title(n.get("children", []), row)
			if not copy.is_empty():
				return copy
	return ""


func _truth(v: Variant) -> bool:
	if v == null:
		return false
	if v is bool:
		return v
	if v is String or v is Array or v is Dictionary:
		return not v.is_empty()
	return true


func _grid_view(grid: GridContainer, rows: int) -> void:
	if not is_instance_valid(grid) or not grid.is_inside_tree():
		return
	var scroll: Node = grid.get_parent()
	while scroll != null and not scroll is ScrollContainer:
		scroll = scroll.get_parent()
	if scroll == null:
		return
	var height := 0.0
	for child in grid.get_children():
		if child is Control:
			height = maxf(height, child.get_combined_minimum_size().y)
	for child in grid.get_children():
		if child is Control:
			child.custom_minimum_size.y = height
	var count := mini(rows, ceili(float(grid.get_child_count()) / grid.columns))
	var pixels: float = height * count + grid.get_theme_constant("v_separation") * maxi(0, count - 1)
	var container := scroll as ScrollContainer
	container.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	container.custom_minimum_size.y = pixels

func _selected_visible(button: Button) -> void:
	await ui.get_tree().process_frame
	await ui.get_tree().process_frame
	if not is_instance_valid(button) or not button.is_inside_tree():
		return
	var parent: Node = button.get_parent()
	while parent != null:
		if parent is ScrollContainer:
			parent.ensure_control_visible(button)
		parent = parent.get_parent()

func _node(n: Dictionary, parent: Node, row: C.ProtoMessage) -> void:
	if n.get("collapsed", false) and not ui.toggles.get(ui.screen_id + "/" + n.id, false):
		return
	var bindings: Dictionary = n.get("bind", {})
	if bindings.has("visible") and not _truth(ui.value(bindings.visible, row)):
		return
	if bindings.has("visible_not") and _truth(ui.value(bindings.visible_not, row)):
		return
	if n.has("inset_px"):
		var margin := MarginContainer.new()
		parent.add_child(margin)
		margin.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		margin.size_flags_stretch_ratio = n.get("weight", 1.0)
		var sides := ["margin_left", "margin_top", "margin_right", "margin_bottom"]
		for side in range(4):
			margin.add_theme_constant_override(sides[side], n.inset_px[side])
		parent = margin
	match n.kind:
		"region":
			var panel := PanelContainer.new()
			var plate := StyleBoxFlat.new()
			var appearance: Dictionary = Catalog.specification().get("region_styles", {}).get(n.get("style", ""), {})
			plate.bg_color = Color(appearance.get("background", "18201fee"))
			plate.border_color = Color(appearance.get("border", "7f8d83"))
			for side in range(4):
				plate.set_content_margin(side, n.get("padding_px", 12))
				plate.set_border_width(side, 1)
			panel.add_theme_stylebox_override("panel", plate)
			parent.add_child(panel)
			var scale: Vector2 = ui.size / Vector2(1280, 800) if ui.spec.layout == "hud" else Vector2.ONE
			panel.position = Vector2(n.rect[0], n.rect[1]) * scale
			panel.size = Vector2(n.rect[2], n.rect[3]) * scale
			panel.set_meta("hud_panel", n.id)
			var scroll := ScrollContainer.new()
			scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
			scroll.follow_focus = true
			scroll.set_meta("scroll_id", ui.screen_id+"/"+n.id)
			var column := VBoxContainer.new()
			column.add_theme_constant_override("separation", n.get("gap_px", 6))
			panel.add_child(column)
			for child in n.get("children", []):
				if child.get("dock", "") == "top":
					_node(child, column, row)
			scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
			column.add_child(scroll)
			if n.get("focusable", false):
				scroll.focus_mode = Control.FOCUS_ALL
				scroll.set_meta("focus_id", n.id)
				scroll.set_meta("focus_uid", n.id+"#0")
				ui.rail.append(scroll)
				ui.focus_ids.append(n.id)
			var box := VBoxContainer.new()
			box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			scroll.add_child(box)
			for child in n.get("children", []):
				if child.get("dock", "body") == "body":
					_node(child, box, row)
			var bottom: Node = column
			for child in n.get("children", []):
				if child.get("visible_rows", 0) > 0:
					var foot := VBoxContainer.new()
					foot.alignment = BoxContainer.ALIGNMENT_END
					foot.size_flags_vertical = Control.SIZE_EXPAND_FILL
					column.add_child(foot)
					bottom = foot
					break
			for child in n.get("children", []):
				if child.get("dock", "body") == "bottom":
					_node(child, bottom, row)
		"divider":
			var divider := TextureRect.new()
			divider.set_meta("guard_control", true)
			divider.texture = Catalog.image("divider")
			divider.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			divider.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			divider.custom_minimum_size.y = 22
			divider.mouse_filter = Control.MOUSE_FILTER_IGNORE
			parent.add_child(divider)
		"spacer":
			var space := Control.new()
			space.custom_minimum_size.y = n.get("height_px", 7)
			space.mouse_filter = Control.MOUSE_FILTER_IGNORE
			parent.add_child(space)
		"label":
			var copy := _copy(n, row)
			if not copy.is_empty():
				var label := _label(parent, copy, n.font_px)
				label.theme_type_variation = n.get("style", ui.chrome.profile.get("body_role", ""))
				label.set_meta("control_id", n.id)
				if n.has("line_spacing_px"):
					label.add_theme_constant_override("line_spacing", n.line_spacing_px)
				if n.get("align", "left") == "center":
					label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		"button":
			var number: int = int(n.get("ordinal", 0))
			var expected := row_number
			if expected == 0:
				expected = 1
				for sibling in parent.get_children():
					if sibling is Button:
						expected += 1
			if number == 0:
				number = expected if ui.spec.chrome == "folk" else row_number
			var b := _button(parent, _copy(n, row), ui._act.bind(n.action, row), n.id,
				n.get("mode", "") in ["response", "tile"], n.font_px, number, n.get("mode", ""), n.get(
					"min_height_px", 48), \
					expected)
			if n.get("mode", "") == "response" and parent is BoxContainer and not parent.vertical:
				b.custom_minimum_size.x = n.width_px
			if n.get("mode", "") == "tab":
				b.button_pressed = bool(ui.value(bindings.get("active", {"value": false}), row))
				b.set_meta("current_tab", b.button_pressed)
			b.set_meta("row", row)
			# Refused actions stay reachable; selecting one shows the server reason.
			if bindings.has("enabled") and not ui.value(bindings.enabled, row):
				b.modulate.a = 0.65
		"list":
			var rows: Array = rows_for(n, row)
			if rows.is_empty():
				_label(parent, ui.tr(n.get("empty_key", "") if not n.get("empty_key", "").is_empty(
					) else Catalog.specification().text.empty), 18)
				return
			if n.get("mode", "") in ["choices", "commands"]:
				var flow: Container
				if n.get("columns", 0) > 0:
					var grid := GridContainer.new()
					grid.columns = n.columns
					grid.add_theme_constant_override("h_separation", n.get("gap_px", 6))
					grid.add_theme_constant_override("v_separation", n.get("gap_px", 6))
					flow = grid
				else:
					flow = HFlowContainer.new()
				parent.add_child(flow)
				flow.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				for index in range(rows.size()):
					var item = rows[index]
					var execute: bool = n.get("mode", "") == "commands"
					var callback: Callable = ui._act.bind(n.action, item) if execute else ui._select.bind(n.id, item)
					var mode: String = "tile" if execute else "tab"
					var b := _button(flow, _row_title(n.get("children", []), item), callback,
						n.id, execute or n.get("columns", 0) > 0, n.font_px, index + 1, mode,
						n.get("min_height_px", 48), index + 1)
					b.custom_minimum_size.x = n.width_px if n.get("columns", 0) > 0 else 300
					b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
					b.set_meta("row", item)
					b.set_meta("row_identity", identity(n, item))
					b.set_meta("focus_uid", n.id + "=" + identity(n, item))
					b.set_meta("selected", item == ui.selected.get(n.id))
					if execute and n.bind.has("enabled") and not ui.value(n.bind.enabled, item):
						b.modulate.a = 0.55
					if execute and n.bind.has("reason"):
						b.tooltip_text = str(ui.value(n.bind.reason, item))
					if execute:
						b.focus_entered.connect(ui._select.bind(n.id, item))
					else:
						b.toggle_mode = true
						b.button_pressed = item == ui.selected.get(n.id)
					if b.get_meta("selected", false):
						_selected_visible.call_deferred(b)
				if flow is GridContainer and n.get("visible_rows", 0) > 0:
					flow.resized.connect(_grid_view.bind(flow, int(n.visible_rows)))
					_grid_view.call_deferred(flow, int(n.visible_rows))
				return
			if n.get("mode", "select") == "cards":
				var previous_number := row_number
				for index in range(rows.size()):
					var item = rows[index]
					row_number = index+1
					var card := VBoxContainer.new()
					card.add_theme_constant_override("separation", 8)
					card.set_meta("row_scope", n.id+"="+identity(n, item))
					parent.add_child(card)
					for child in n.get("children", []):
						_node(child, card, item)
				row_number = previous_number
				return
			var split := HBoxContainer.new()
			split.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			split.size_flags_vertical = Control.SIZE_EXPAND_FILL
			split.add_theme_constant_override("separation", 36)
			parent.add_child(split)
			var list_scroll := ScrollContainer.new()
			list_scroll.set_meta("scroll_id", ui.screen_id+"/"+n.id+"/list")
			list_scroll.custom_minimum_size = Vector2(n.get("list_width_px", 350), 240)
			list_scroll.follow_focus = true
			list_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
			split.add_child(list_scroll)
			var list := VBoxContainer.new()
			list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			list_scroll.add_child(list)
			var current: C.ProtoMessage = ui.selected.get(n.id, rows[0])
			ui.selected[n.id] = current
			for index in range(rows.size()):
				var item: C.ProtoMessage = rows[index]
				var copy := _row_title(n.get("children", []), item)
				if copy.is_empty():
					copy = ui.tr(Catalog.specification().text.inspect)+" "+str(index+1)
				var b := _button(list, copy, ui._select.bind(n.id, item), n.id, true, n.font_px, index+1)
				b.set_meta("row", item)
				b.set_meta("row_identity", identity(n, item))
				b.set_meta("focus_uid", n.id+"="+identity(n, item))
				b.set_meta("selected", item == current)
				b.toggle_mode = true
				b.button_pressed = item == current
				b.custom_minimum_size.x = 300
			var detail_scroll := ScrollContainer.new()
			detail_scroll.set_meta("scroll_id", ui.screen_id+"/"+n.id+"/detail")
			ui.scroll_targets.append(detail_scroll)
			detail_scroll.custom_minimum_size.y = 240
			detail_scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			detail_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
			detail_scroll.follow_focus = true
			detail_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
			split.add_child(detail_scroll)
			var detail := VBoxContainer.new()
			detail.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			detail.add_theme_constant_override("separation", 10)
			detail_scroll.add_child(detail)
			for child in n.get("children", []):
				_node(child, detail, current)
		"image":
			var art := TextureRect.new()
			art.set_meta("guard_control", true)
			art.texture = Catalog.image(n.widget)
			art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			art.custom_minimum_size.y = n.get("height_px", 320)
			art.mouse_filter = Control.MOUSE_FILTER_IGNORE
			parent.add_child(art)
		"custom":
			var widget: Control = Catalog.widget(n.widget)
			widget.set_meta("guard_control", true)
			parent.add_child(widget)
			widget.custom_minimum_size.y = n.get("height_px", 320)
			widget.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			var values := {}
			for key in bindings:
				values[key] = ui.value(bindings[key], row)
			# a widget that chooses among rows sees them as a list would: where, filters and order applied
			if n.get("action_source", "") == "source" and bindings.has("source"):
				values["source"] = rows_for(n, row)
			# a named action of the widget's (CUE actions, checked by the generator) on a row: act.call(name, row)
			var act := func(name: String, item):
				if n.has("actions") and n.actions.has(name):
					ui._act(n.actions[name], item)
			var context := {"host":ui.host, "theme":ui.theme, "reduced_motion":ui._motion(),
				"text_scale":
					1.25 if ui._large(
				) else 1.0, "portrait_fallback":Catalog.specification().get("portrait_fallback", ""), "act":act}
			var selected_row := func(item):
				if n.get("action_source", "") == "source":
					ui._select(n.id, item)
				if n.has("action"):
					ui._act(n.action, item)
			values["selected"] = ui.selected.get(n.id)
			var focus: Array = widget.configure_screen(values, context, selected_row)
			if n.get("live", false):
				ui.live_widgets.append({"widget": widget, "node": n, "row": row})
			if not n.get("passive", false):
				for b in focus:
					if b is Button:
						b.action_mode = BaseButton.ACTION_MODE_BUTTON_PRESS
					b.set_meta("focus_id", n.id)
					# a button that stands for a row (meta row) is known by the row, as a list's: the focus comes back to
					# it after a rebuild and a hotkey's direction steps from the selected one
					if b.has_meta("row") and b.get_meta("row") is C.ProtoMessage:
						b.set_meta("row_identity", identity(n, b.get_meta("row")))
						b.set_meta("focus_uid", n.id+"="+str(b.get_meta("row_identity")))
					else:
						b.set_meta("focus_uid", n.id+"#"+str(ui.focus_ids.count(n.id)))
					ui.rail.append(b)
					ui.focus_ids.append(n.id)

		_:
			var box := BoxContainer.new()
			box.vertical = n.kind != "row"
			box.size_flags_stretch_ratio = n.get("weight", 1.0)
			box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			box.add_theme_constant_override("separation", int(n.get("gap_px", 14)))
			parent.add_child(box)
			for child in n.get("children", []):
				_node(child, box, row)


func rows_for(n: Dictionary, row: C.ProtoMessage) -> Array:
	var rows = ui.value(n.bind.source, row)
	if not rows is Array:
		return []
	if n.has("where"):
		rows = rows.filter(func(item):
			return _truth(ui.value(n.where, item))
		)
	for filter in n.get("filters", []):
		rows = rows.filter(func(item):
			var values = ui.value(filter["in"], item)
			return values is Array and values.has(ui.value(filter.value, item))
		)
	if not n.get("order", []).is_empty():
		rows = rows.duplicate()
		var ranks := {}
		for index in range(rows.size()):
			var item = rows[index]
			var rank: int = n.order.find(str(item.to_dict().get(n.row_key, "")))
			ranks[item] = rank if rank >= 0 else n.order.size() + index
		rows.sort_custom(func(a, b):
			return ranks[a] < ranks[b]
		)
	return rows
func identity(n: Dictionary, row: C.ProtoMessage) -> String:
	var data: Dictionary = row.to_dict()
	var keys: Array = n.get("row_keys", []).duplicate()
	if not n.get("row_key", "").is_empty():
		keys.append(n.row_key)
	if keys.is_empty():
		return JSON.stringify(data)
	var result := []
	for key in keys:
		result.append(data.get(key))
	return JSON.stringify(result)
func scope(parent: Node) -> String:
	var result: Array[String] = []
	var node := parent
	while node != null and node != ui.content:
		if node.has_meta("row_scope"):
			result.append(str(node.get_meta("row_scope")))
		node = node.get_parent()
	return "/".join(result)

func definition(id: String, nodes: Array) -> Dictionary:
	for node in nodes:
		if node.id == id:
			return node
		var child := definition(id, node.get("children", []))
		if not child.is_empty():
			return child
	return {}

static func keep_units(copy: String) -> String:
	var pattern := RegEx.new()
	pattern.compile("([0-9]) ([A-Za-zА-Яа-яЁё%]+)(?=$|[ .,;:!?)\\n])")
	return pattern.sub(copy, "$1\u00a0$2", true)
