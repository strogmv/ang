func TestCombatReportDedupKeepsFreshSightAndRealMovement(t *testing.T) {
	s, space, r := combatReportScene(t)
	d := s.Decide(space, r)
	if d.Chosen.Action.Type != "report" || d.Chosen.Action.TargetID != "friend" {
		t.Fatalf("new observation was not delivered: %+v", d.Chosen)
	}
	combatDo(t, &s, space, r, "scout", d.Chosen.Action)
	received := *combatContact(s.Actor("friend"), "enemy")
	personal := *combatContact(s.Actor("scout"), "enemy")
	if personal.ObservedAction <= received.ObservedAction || personal.Position != received.Position || personal.Source != "sight" || personal.SourceID != "scout" {
		t.Fatal("dedup froze or replaced fresh personal observation")
	}
	for _, candidate := range s.Decide(space, r).Candidates {
		if candidate.Action.Type == "report" && candidate.Action.TargetID == "friend" {
			t.Fatal("the same LOS sample became another useful report")
		}
	}
	before := s.Clone()
	if err := s.Execute(space, r, "scout", CombatAction{Type: "report", TargetID: "friend"}); err == nil || !reflect.DeepEqual(before, s) {
		t.Fatal("duplicate report spent AP or changed perception/RNG state")
	}
	combatDo(t, &s, space, r, "scout", CombatAction{Type: "end"})
	combatDo(t, &s, space, r, "friend", CombatAction{Type: "end"})
	combatDo(t, &s, space, r, "enemy", CombatAction{Type: "move", To: Cell{9, 1}})
	combatDo(t, &s, space, r, "enemy", CombatAction{Type: "end"})
	actual := *combatContact(s.Actor("scout"), "enemy")
	combatDo(t, &s, space, r, "scout", CombatAction{Type: "report", TargetID: "friend"})
	updated := *combatContact(s.Actor("friend"), "enemy")
	if updated.Position != (Cell{9, 1}) || updated.ObservedTurn != actual.ObservedTurn || updated.ObservedAction != actual.ObservedAction || updated.SourceID != "scout" || updated.Visible {
		t.Fatalf("real movement lost its observation/provenance: %+v", updated)
	}
}

