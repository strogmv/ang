func TestCombatGridRollUsesTheExactValidatedEndpoint(t *testing.T){
 r:=gridCoverRules();r.RollAP=1;r.RollDistanceMM=1500;r.RollClearanceMM=0
 space:=combatFixtureSpace();space.CellMM=500;space.Grid=DeriveCombatGrid(space.Space,500,r.Grid,nil)
 a,b:=combatFixtureActor("a","blue",Cell{2,2}),combatFixtureActor("b","red",Cell{11,6});a.Controlled=true;a.Body=[]byte(`{}`);a.BodyCanWalk=true;a.BodyCanStand=true;a.BodyCanHold=true
 s,err:=NewCombat("roll-grid","fixture",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)}
 end:=Cell{5,2};if snapped:=s.SnapCombatCell(space,r,*s.Actor("a"),end,false);snapped==end{t.Fatal("fixture no longer distinguishes exact and snapped ends")}
 blocked:=space;blocked.EndPositionClear=func(_ Combatant,at Cell)bool{return at!=end}
 copy:=s.Clone();if err=copy.Execute(blocked,r,"a",CombatAction{Type:"roll",To:end});err==nil{t.Fatal("roll accepted a forbidden actual endpoint")};if copy.Actor("a").Position!=a.Position{t.Fatal("rejected roll mutated position")}
 space.EndPositionClear=func(_ Combatant,at Cell)bool{return at==end}
 if err=s.Execute(space,r,"a",CombatAction{Type:"roll",To:end});err!=nil{t.Fatal(err)}
 if s.Actor("a").Position!=end{t.Fatalf("roll executed a different end: %v",s.Actor("a").Position)}
 for _,event:=range s.Events{if event.Type=="roll"&&event.To!=end{t.Fatal("roll event endpoint differs")}}
}
func TestCombatGridStartConflictUsesPaidPhysicalMoves(t *testing.T){
 r:=gridCoverRules();space:=combatFixtureSpace();space.CellMM=500;space.Grid=DeriveCombatGrid(space.Space,500,r.Grid,nil);space.EndSpacingMM=func(Combatant,Combatant)int{return 700}
 a,b:=combatFixtureActor("a","blue",Cell{4,2}),combatFixtureActor("b","red",Cell{5,3});a.Controlled=true
 s,err:=NewCombat("start-grid","fixture",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)}
 if !s.GridReady{t.Fatal("new encounter did not finish clearance")};if err=s.ValidateGridOccupancy(space);err!=nil{t.Fatal(err)}
 paid,steps:=0,0;for _,e:=range s.Events{if e.Type=="move"{steps++;paid+=e.AP;if Distance(e.From,e.To)!=1{t.Fatal("start clearance teleported")}}}
 if steps==0||paid==0{t.Fatal("start clearance did not make real paid steps")}
 old:=s.Clone();old.GridReady=false;old.Actors[0].Position=a.Position;old.Actors[1].Position=b.Position
 if err=old.Validate(r,space);err!=nil{t.Fatalf("legacy physical encounter was made unreadable: %v",err)}
 if err=old.ResolveGridConflicts(space,r);err!=nil{t.Fatal(err)};if err=old.ValidateGridOccupancy(space);err!=nil{t.Fatal(err)}
}
func TestCombatGridMultideckWalkCrossesTheActualStairWithPaidAP(t *testing.T){
 m,v:=multideckFixture();if err:=v.Prepare();err!=nil{t.Fatal(err)}
 r:=gridCoverRules();space:=CombatSpace{CellMM:500,Space:m.Space("md",nil),RangeMM:v.CombatRangeMM};space.Grid=DeriveCombatGrid(space.Space,500,r.Grid,v.Locate)
 space.GridDirection=func(a,b Cell)(int,int){p,_,_,_:=v.Locate(a);q,_,_,_:=v.Locate(b);return p.X-q.X,p.Y-q.Y}
 a,b:=combatFixtureActor("a","blue",Cell{5,10}),combatFixtureActor("b","red",Cell{10,11});a.Controlled=true
 s,err:=NewCombat("stair-grid","md",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)}
 end:=s.SnapCombatCell(space,r,*s.Actor("a"),Cell{5,16},false);p:=s.MovePreview(space,r,"a",end)
 if p.Reason!=""||p.AP!=4{t.Fatalf("whole authored stair should cost four tactical boundaries: %+v",p)}
 from:=a.Position;links:=0;for _,to:=range p.Path{if Distance(from,to)!=1{found:=false;for _,next:=range space.Space.Links[from]{if next==to{found=true;links++}};if !found{t.Fatal("stair path teleported between layers")}};from=to}
 if links<2{t.Fatal("path did not traverse both authored landings")}
 before:=s.Actor("a").AP;if err=s.Execute(space,r,"a",CombatAction{Type:"move",To:end});err!=nil{t.Fatal(err)}
 if s.Actor("a").Position!=end||before-s.Actor("a").AP!=p.AP{t.Fatal("stair preview/endpoint/AP differs from execution")}
 if _,_,layer,_:=v.Locate(end);layer!=1{t.Fatal("walk did not arrive on the gallery")}
 for _,link:=range v.Links{p,_,_,_:=v.Locate(link.A);q,_,_,_:=v.Locate(link.B);want:=Cell{X:q.X-p.X,Y:q.Y-p.Y};if got:=space.movementHeading(link.A,link.B);got!=want{t.Fatalf("stair heading uses navigation bands: %v / %v",got,want)}}
}
func TestCombatGridLifeKeepsAnOrdinaryPersonsLastHeading(t *testing.T){
 m:=lifeFixture();m.Actors=m.Actors[:1];s:=m.Start();a:=&s.Actors[0];a.Manual=true;a.Arrived=false;a.Goal=Cell{3,1};a.Path=[]Cell{{2,1},{3,1}}
 for tick:=int64(1);tick<=12;tick++{s.Advance(m,tick)}
 if a.Position!=(Cell{3,1})||a.Heading.X<=0||a.Heading.Y!=0{t.Fatalf("last completed ordinary move lost its physical heading: %+v",a)}
}
func TestCombatGridPursuitBudgetDoesNotUseAnOpponentsLongerWeapon(t *testing.T){
 r:=gridCoverRules();r.PursuitTravelMM=1000;space:=combatFixtureSpace();space.CellMM=500;space.Grid=DeriveCombatGrid(space.Space,500,r.Grid,nil)
 a,b:=combatFixtureActor("a","blue",Cell{4,2}),combatFixtureActor("b","red",Cell{11,2});a.Weapon=CombatWeapon{ID:"knife",Kind:"blade",Damage:12,RangeMM:900,AttackAP:2};a.Ammo=0
 s,err:=NewCombat("pursuit-grid","fixture",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)}
 s.event(CombatEvent{Type:"move",ActorID:"a",From:Cell{2,2},To:Cell{4,2},Amount:1000});s.Observe(space,r)
 if !s.pursuitSpent(space,r,*s.Actor("a")){t.Fatal("a visible long gun kept an out-of-contact chase alive forever")}
 s.event(CombatEvent{Type:"attack",ActorID:"b",TargetID:"third-person"});if !s.pursuitSpent(space,r,*s.Actor("a")){t.Fatal("an unrelated exchange reset the personal pursuit budget")}
 s.Actor("b").Position=Cell{6,3};s.Actor("a").Weapon.RangeMM=1300;s.Observe(space,r)
 if s.pursuitSpent(space,r,*s.Actor("a")){t.Fatal("a legal immediate own attack was discarded")}
}
