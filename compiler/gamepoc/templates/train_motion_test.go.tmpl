func TestTrainMotionHostClockSaveAndNoEntry(t *testing.T){
 r:=lifeRuntimeFixture(t);if r.world.TrainMotion==nil{t.Skip("no train catalog")}
 r.state.Life.SecondsPerTick=1
 for i:=0;i<5000&&r.state.TrainDispatch.Active!=1;i++{r.step()}
 if r.state.TrainDispatch.Active!=1{t.Fatal("passenger dispatch starved")}
 for i:=0;i<1000;i++{_,_,phase,_:=r.world.TrainMotion.dispatchPose(r.state.TrainDispatch,r.simNS());if phase=="berthed"{break};r.step()}
 expected:=r.trainMotionSnapshot();r.state.Paused=true
 for i:=0;i<60;i++{r.step()}
 if !reflect.DeepEqual(expected,r.trainMotionSnapshot()){t.Fatal("pause moved train")}
 slot:=r.world.Config.SaveSlots[0];if err:=r.writeSave(slot,r.snapshotState());err!=nil{t.Fatal(err)}
 saved,_,err:=r.readSave(slot);if err!=nil{t.Fatal(err)};r.state=saved
 if !reflect.DeepEqual(expected,r.trainMotionSnapshot()){t.Fatal("disk save/load reset train")}
 before:=r.snapshotState();r.state.Epoch=newEpoch();after:=r.trainMotionSnapshot()
 if !reflect.DeepEqual(expected.Trains,after.Trains){t.Fatal("reconnect changed physical train")}
 r.state.Epoch=before.Epoch
 c:=&connection{out:make(chan *pb.ServerMessage,16),stop:make(chan struct{})};r.sendState(c);wire:=(<-c.out).GetGameState()
 if wire==nil||wire.Life==nil||wire.Life.TrainMotion==nil||wire.Life.TrainMotion.SampleSimNs!=r.simNS()||wire.Life.TrainCatalog==nil{t.Fatal("typed train absent from frame")}
 for _,train:=range wire.Life.TrainMotion.Trains{for _,module:=range train.Modules{for _,binding:=range module.Bindings{if binding.LevelId!=wire.Life.LevelId{t.Fatal("another level pose sent live")}}}}
 for _,train:=range expected.Trains{before:=r.snapshotState();if err:=r.lifeCommand(&pb.PocLifeCommand{Action:"enter",Destination:train.TrainID});err==nil{t.Fatal("exterior physical boarding advertised")};if !reflect.DeepEqual(before,r.snapshotState()){t.Fatal("refused physical boarding changed state")}}
}
func TestTrainMotionAuthoredThreeLevelContinuity(t *testing.T){
 r:=lifeRuntimeFixture(t);c:=r.world.TrainMotion;if c==nil{t.Skip("no train")}
 if len(c.Bindings)<3||c.Timetable==nil{t.Fatal("three views and shared timetable required")}
 seen:=map[string]bool{}
 for distance:=0.0;distance<c.length();distance+=.2{for _,module:=range c.render(distance,c.SpeedMPS,"passing",1,false,true).Modules{for _,binding:=range module.Bindings{if binding.Visible{seen[binding.LevelID]=true}}}}
 if len(seen)<3{t.Fatal("one route does not reach three locations")}
