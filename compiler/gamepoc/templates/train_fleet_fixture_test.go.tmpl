// Code generated by ANG. Explicit evening fixture through the ordinary world clock.
package poc

import (
	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"encoding/json"
	"os"
	"path/filepath"
	"testing"
)

func TestTrainFleetEveningFixture(t *testing.T) {
	dir := os.Getenv("ANG_TRAIN_FLEET_NATIVE_DIR")
	if dir == "" {
		t.Skip("explicit normal evening save export")
	}
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	c := &connection{out: make(chan *pb.ServerMessage, 64), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "fleet.evening.new", Scenario: "life", Seed: 777}}}})
	for len(c.out) > 0 {
		<-c.out
	}
	if !r.state.Life.Enabled || !r.world.Life.Brain.Enabled || !r.state.Active {
		t.Fatal("canonical NewGame Life failed")
	}
	if !r.world.Life.Walks("level.c7_market", behavior.Cell{X: 101, Y: 70}) {
		t.Fatal("rail observation cell is not walkable")
	}
	start := r.state.Life.Seconds
	startTick := r.state.Tick
	target := start/86400*86400 + 21*3600
	if start >= target {
		t.Fatal("new game starts after evening")
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 30}); err != nil {
		t.Fatal(err)
	}
	for r.state.Life.Seconds < target {
		if target-r.state.Life.Seconds < 30 {
			if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
				t.Fatal(err)
			}
		}
		before := r.state.Tick
		r.step()
		if r.state.Tick <= before || r.state.Life.PopulationFailure != "" {
			t.Fatalf("ordinary simulation stopped: %s", r.state.Life.PopulationFailure)
		}
	}
	if r.state.Life.Seconds != target || r.state.Tick <= startTick || r.simNS() <= 0 {
		t.Fatal("evening requires real physical and calendar progress")
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "rate", SecondsPerTick: 1}); err != nil {
		t.Fatal(err)
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_GameOptions{GameOptions: &pb.PocOptionsRequest{Epoch: r.state.Epoch, RequestId: "fleet.evening.pause", Speed: 1, Paused: true}}}})
	for len(c.out) > 0 {
		<-c.out
	}
	if !r.state.Paused {
		t.Fatal("ordinary pause failed")
	}
	if err := r.writeSave("slot3", r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	saved, _, err := r.readSave("slot3")
	if err != nil {
		t.Fatal(err)
	}
	if saved.Life.Seconds != target || !saved.Paused || saved.Tick != r.state.Tick {
		t.Fatal("evening save roundtrip mismatch")
	}
	if err := os.MkdirAll(dir, 0755); err != nil {
		t.Fatal(err)
	}
	raw, err := os.ReadFile(filepath.Join(r.data, "slot3.json"))
	if err != nil {
		t.Fatal(err)
	}
	if err = os.WriteFile(filepath.Join(dir, "slot3.json"), raw, 0600); err != nil {
		t.Fatal(err)
	}
	report := map[string]any{"source": "canonical NewGame Life + authoritative rate + ordinary Runtime.step", "start_seconds": start, "evening_seconds": target, "tick": r.state.Tick, "sim_ns": r.simNS(), "brain_enabled": r.world.Life.Brain.Enabled, "hero_body_enabled": r.world.Life.HeroBody.RadiusMM > 0, "paused": saved.Paused, "observation_cell": []int{101, 70}, "trains": len(r.world.TrainMotion.snapshots(float64(r.simNS()) / 1e9))}
	raw, _ = json.MarshalIndent(report, "", "  ")
	if err = os.WriteFile(filepath.Join(dir, "provenance.json"), append(raw, '\n'), 0644); err != nil {
		t.Fatal(err)
	}
}
