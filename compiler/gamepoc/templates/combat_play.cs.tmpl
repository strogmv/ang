  void CombatBloodStart(CombatBeat b,LocationSDKHumanoid victim,PocCombatLook look,Vector3 point,Vector3 normal){
   if(look.blood==null||look.blood.signs==null||string.IsNullOrEmpty(b.sign))return;var s=Array.Find(look.blood.signs,x=>x.sign==b.sign);if(s==null)return;
   var rng=new System.Random((int)(b.turn*7919)+(b.zone==null?0:b.zone.GetHashCode()&0)+b.amount+(b.side=="left"?1:2));var bleed=new CombatBleed{sign=s,at=CombatNow,nextPulse=CombatNow+s.pulse_s,pulsesLeft=s.pulses,body=victim,zone=b.zone,side=b.side,rng=rng,normal=normal};
   normal=CombatBloodDir(normal,victim,b.actor);bleed.normal=normal;
   CombatDroplets(point,normal,s,s.droplets,rng,victim.go.transform.position.y);
   // the stain on the clothes
   var bone=CombatNearestBone(victim,point);var stain=CombatBloodPiece("wound stain",point,Quaternion.LookRotation(normal),Vector3.one*.001f);if(bone!=null)stain.transform.SetParent(bone,true);bleed.stain=stain.transform;bleed.stainSize=s.stain_m;
   if(s.pool_m>0){var at=point;at.y=victim.go.transform.position.y+.004f;at+=normal*.1f;var pool=CombatBloodPiece("floor pool",at,Quaternion.identity,new Vector3(.001f,.002f,.001f));bleed.pool=pool.transform;bleed.poolSize=s.pool_m;}
   if(look.contact!=null&&look.contact.points!=null){var zp=Array.Find(look.contact.points,x=>x.id==b.zone);if(zp!=null&&zp.stain>0)bleed.stainScale=zp.stain;}
