  for _,e:=range r.world.Region.Links{if e.InitialKnown&&k.KnownNodes[e.FromNode]&&k.KnownNodes[e.ToNode]{k.KnownLinks[e.ID]=true}}
  k.Initialized=true
 }
 hero:=r.state.Life.Actor(playerActorID);if hero==nil{return}
 for _,n:=range r.world.Region.Nodes{if n.LevelID!=""&&hero.Visits[n.LevelID]>0{k.KnownNodes[n.ID]=true;if _,ok:=k.Visited[n.ID];!ok{k.Visited[n.ID]=r.state.Life.Seconds}}}
