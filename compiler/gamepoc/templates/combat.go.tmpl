 }
 if q.Action == "start" {
		return r.startCombat(q.TargetId)
	}
 if q.Action=="takedown"{return r.startTakedown(playerActorID,q.TargetId,q.Mode)}
	if !r.state.Combat.Active || q.ExpectedTurn != r.state.Combat.Turn {
		return textError{Key: "error.combat_stale_turn"}
	}
	if r.state.Paused {
		return textError{Key: "error.combat_unavailable"}
	}
	a := r.state.Combat.Current()
	if a == nil || a.ID != playerActorID {
		return textError{Key: "error.combat_not_your_turn"}
	}
	action := behavior.CombatAction{Type: q.Action, TargetID: q.TargetId, To: behavior.Cell{X: int(q.X), Y: int(q.Y)},Mode:q.Mode,Aim:int(q.Aim),BodyPart:q.BodyPart,ItemID:q.ItemId}
