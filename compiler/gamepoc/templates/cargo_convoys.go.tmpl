// Code generated by ANG. Server-driven cargo convoys (cargo to the market v1, part B): a tug that pulls one trailer of a
// fleet along a route of legs — drive, ride a lifting deck, cross a vehicle-only edge (a timed transfer), work at a stand —
// with its crew riding it (behavior/life_riders). Trailers stand on the bays of a stand; a crane swaps them by time only
// (the server keeps "move N since T" and the trailer on the hook). No physics.
package poc

import (
 "encoding/json"
 "fmt"
 "math"
 "sort"
 "strconv"
 "strings"

 "angelsdemons/server/internal/behavior"
 inv "angelsdemons/server/internal/inventory"
 pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
)

type cargoPose struct{X float64 `json:"x"`;Y float64 `json:"y"`;Yaw float64 `json:"yaw_degrees"`}
type cargoCrewAt struct{Seat bool `json:"seat"`;At *behavior.Cell `json:"at,omitempty"`}
type cargoSeat struct{ID string `json:"id"`;M [3]float64 `json:"m"`;Side string `json:"side"`;Pose string `json:"pose"`}
type cargoLeg struct{
 Kind string `json:"kind"`;Label string `json:"label"`;Posts []cargoCrewAt `json:"posts,omitempty"`
 LevelID string `json:"level_id,omitempty"`;Path [][2]float64 `json:"path,omitempty"`;Reverse bool `json:"reverse,omitempty"`;TurnRadiusM float64 `json:"turn_radius_m,omitempty"`
 DeckID string `json:"deck_id,omitempty"`;LifeEdge string `json:"life_edge,omitempty"`;StandID string `json:"stand_id,omitempty"`;Bay string `json:"bay,omitempty"`;CraneID string `json:"crane_id,omitempty"`
 Moves []struct{From string `json:"from"`;To string `json:"to"`} `json:"moves,omitempty"`
 FromSecond int64 `json:"from_second,omitempty"`;Seconds int64 `json:"seconds,omitempty"`
 Level string `json:"level"`;ToLevel string `json:"to_level"`;Trailer bool `json:"trailer"`
}
type cargoRun struct{ID string `json:"id"`;StartSecond int64 `json:"start_second"`;Legs []cargoLeg `json:"legs"`}
type cargoConvoyDefinition struct{
 ID string `json:"id"`
 Tug struct{Resource string `json:"resource"`;HitchBackM float64 `json:"hitch_back_m"`;NoseM float64 `json:"nose_m"`;RearM float64 `json:"rear_m"`;HalfWidthM float64 `json:"half_width_m"`;MassKG int64 `json:"mass_kg"`;Seats []cargoSeat `json:"seats"`;ChargeM [3]float64 `json:"charge_m"`} `json:"tug"`
 Trailer struct{Resource string `json:"resource"`;EyeM float64 `json:"eye_m"`;TailM float64 `json:"tail_m"`;BodyFrontM float64 `json:"body_front_m"`;HalfWidthM float64 `json:"half_width_m"`;HeightM float64 `json:"height_m"`;MassKG int64 `json:"mass_kg"`} `json:"trailer"`
 Trailers []struct{ID string `json:"id"`;Start struct{Hitched bool `json:"hitched"`;StandID string `json:"stand_id,omitempty"`;Bay string `json:"bay,omitempty"`} `json:"start"`} `json:"trailers"`
 SpeedMMPerSecond int64 `json:"speed_mm_per_second"`;ReverseMMPerSecond int64 `json:"reverse_mm_per_second"`;TurnRadiusM float64 `json:"turn_radius_m"`;WalkMMPerSecond int64 `json:"walk_mm_per_second"`;RiderMassKG int64 `json:"rider_mass_kg"`
 Crew []struct{ID string `json:"id"`;Seat string `json:"seat"`} `json:"crew"`
 Home struct{LevelID string `json:"level_id"`;At [2]float64 `json:"at"`;YawDegrees float64 `json:"yaw_degrees"`} `json:"home"`
 Gates []struct{LevelID string `json:"level_id"`;GateID string `json:"gate_id"`} `json:"gates"`
 Runs []cargoRun `json:"runs"`
}
type cargoStandDefinition struct{
 ID string `json:"id"`;LevelID string `json:"level_id"`
 Bays []struct{ID string `json:"id"`;Trailer cargoPose `json:"trailer"`;Rect struct{X [2]float64 `json:"x"`;Y [2]float64 `json:"y"`} `json:"rect"`} `json:"bays"`
 Marks []struct{ID string `json:"id"`;Kind string `json:"kind"`;Rect struct{X [2]float64 `json:"x"`;Y [2]float64 `json:"y"`;Z [2]float64 `json:"z"`} `json:"rect"`} `json:"marks"`
 Lamps []struct{ID string `json:"id"`;At [3]float64 `json:"at"`;RangeM float64 `json:"range_m"`} `json:"lamps"`
 ChargePostM [3]float64 `json:"charge_post_m"`
 LampsOn struct{FromSecond int64 `json:"from_second"`;ToSecond int64 `json:"to_second"`} `json:"lamps_on"`
}
type cargoCraneDefinition struct{
 ID string `json:"id"`;LevelID string `json:"level_id"`;StandID string `json:"stand_id"`
 Park struct{BridgeYM float64 `json:"bridge_y_m"`;HoistXM float64 `json:"hoist_x_m"`;HookZM float64 `json:"hook_z_m"`} `json:"park"`
 Travel struct{BridgeYM [2]float64 `json:"bridge_y_m"`;HoistXM [2]float64 `json:"hoist_x_m"`;HookZM [2]float64 `json:"hook_z_m"`} `json:"travel"`
 Speed struct{BridgeMPS float64 `json:"bridge_mps"`;HoistMPS float64 `json:"hoist_mps"`;HookMPS float64 `json:"hook_mps"`;TurnDPS float64 `json:"turn_dps"`} `json:"speed"`
 AttachZM float64 `json:"attach_z_m"`;LiftM float64 `json:"lift_m"`;AttachSeconds int64 `json:"attach_seconds"`;ReleaseSeconds int64 `json:"release_seconds"`
 Band struct{X int `json:"x"`;Y int `json:"y"`;W int `json:"w"`;H int `json:"h"`} `json:"band"`
}
type cargoLotDefinition struct{
 Shop string `json:"shop"`;Owner string `json:"owner"`;Kind string `json:"kind"`;CopperStore string `json:"copper_store"`;LockerStore string `json:"locker_store"`;Quantity int64 `json:"quantity,omitempty"`
 Delivery string `json:"delivery,omitempty"`;Definition string `json:"definition,omitempty"`;Items []struct{Item string `json:"item"`;Full int64 `json:"full"`} `json:"items,omitempty"`
 TrailerStores map[string]string `json:"trailer_stores"`
}
type cargoConvoyCatalog struct{
 Convoys []cargoConvoyDefinition `json:"convoys"`
 Stands []cargoStandDefinition `json:"stands"`
 Cranes []cargoCraneDefinition `json:"cranes"`
 Lots []cargoLotDefinition `json:"lots"`
 Floors map[string]float64 `json:"floors"`
 DeliveryTrolley struct{Resource string `json:"resource"`;CouplingForwardM float64 `json:"coupling_forward_m"`} `json:"delivery_trolley"`
}

// The saved state. A convoy: the run and leg it is on, the phase inside the leg, the distance along the leg's track and
// when the phase began; where the tug (and a hitched trailer) stands, on which level ("" in transit); the crew's short
// walks at a stop. A trailer: hitched (to the convoy that names it), on a stand's bay, or on a crane's hook. A crane: its
// queue of moves, the move under way since a second, and the trailer on its hook.
type cargoWalk struct{Path []behavior.Cell `json:"path,omitempty"`;AccMM int64 `json:"acc_mm,omitempty"`}
type cargoConvoyState struct{
 Run string `json:"run,omitempty"`;Day int64 `json:"day"`;Leg int `json:"leg"`;Phase string `json:"phase,omitempty"`
 S int64 `json:"s_mm"`;Since int64 `json:"since"`;Done int `json:"done"`
 Level string `json:"level"`;Pose cargoPose `json:"pose"`;TrailerPose cargoPose `json:"trailer_pose"`;Hitched string `json:"hitched,omitempty"`
 Charging bool `json:"charging,omitempty"`;Walk map[string]cargoWalk `json:"walk,omitempty"`;UpdatedNS int64 `json:"updated_ns"`
}
type cargoTrailerState struct{Stand string `json:"stand,omitempty"`;Bay string `json:"bay,omitempty"`;Hook string `json:"hook,omitempty"`}
type cargoCraneMove struct{From string `json:"from"`;To string `json:"to"`;Trailer string `json:"trailer"`}
type cargoCraneState struct{Queue []cargoCraneMove `json:"queue,omitempty"`;Move int `json:"move"`;Since int64 `json:"since"`;Hook string `json:"hook,omitempty"`}
type cargoState struct{
 Convoys map[string]cargoConvoyState `json:"convoys"`
 Trailers map[string]cargoTrailerState `json:"trailers"`
 Cranes map[string]cargoCraneState `json:"cranes"`
 // shop -> the game second its lot reached the locker (a stall stocked late lays out again)
 Landed map[string]int64 `json:"landed,omitempty"`
}

func cloneCargoConvoys(in *cargoState)*cargoState{
 if in==nil{return nil};out:=&cargoState{Convoys:map[string]cargoConvoyState{},Trailers:map[string]cargoTrailerState{},Cranes:map[string]cargoCraneState{}}
 for k,v:=range in.Convoys{if len(v.Walk)>0{w:=map[string]cargoWalk{};for id,x:=range v.Walk{x.Path=append([]behavior.Cell(nil),x.Path...);w[id]=x};v.Walk=w}else{v.Walk=nil};out.Convoys[k]=v}
 for k,v:=range in.Trailers{out.Trailers[k]=v}
 for k,v:=range in.Cranes{if len(v.Queue)>0{v.Queue=append([]cargoCraneMove(nil),v.Queue...)}else{v.Queue=nil};out.Cranes[k]=v}
 if in.Landed!=nil{out.Landed=map[string]int64{};for k,v:=range in.Landed{out.Landed[k]=v}}
 return out
}
func cargoDeg(rad float64)float64{return math.Mod(rad*180/math.Pi+720,360)}
func(r *Runtime)initCargoConvoys(){
 r.state.CargoConvoys=nil;if r.world.CargoConvoys==nil{return}
 st:=&cargoState{Convoys:map[string]cargoConvoyState{},Trailers:map[string]cargoTrailerState{},Cranes:map[string]cargoCraneState{}}
 for _,v:=range r.world.CargoConvoys.Convoys{
  c:=cargoConvoyState{Level:v.Home.LevelID,Pose:cargoPose{v.Home.At[0],v.Home.At[1],cargoDeg(v.Home.YawDegrees*math.Pi/180)}}
  for _,t:=range v.Trailers{if t.Start.Hitched{c.Hitched=t.ID;st.Trailers[t.ID]=cargoTrailerState{}}else{st.Trailers[t.ID]=cargoTrailerState{Stand:t.Start.StandID,Bay:t.Start.Bay}}}
  c.TrailerPose=v.trailerBehind(c.Pose);st.Convoys[v.ID]=c
 }
 for _,k:=range r.world.CargoConvoys.Cranes{st.Cranes[k.ID]=cargoCraneState{}}
 r.state.CargoConvoys=st
}

// ---- geometry
func cargoTrackLength(track [][2]float64)float64{n:=0.0;for i:=1;i<len(track);i++{n+=math.Hypot(track[i][0]-track[i-1][0],track[i][1]-track[i-1][1])};return n}
// A point at distance s along a track; before the start and past the end the track continues straight.
func cargoTrackAt(track [][2]float64,s float64)(float64,float64){
 if s<=0{dx,dy:=track[1][0]-track[0][0],track[1][1]-track[0][1];l:=math.Hypot(dx,dy);return track[0][0]+dx/l*s,track[0][1]+dy/l*s}
 for i:=1;i<len(track);i++{dx,dy:=track[i][0]-track[i-1][0],track[i][1]-track[i-1][1];l:=math.Hypot(dx,dy);if s<=l||i==len(track)-1{return track[i-1][0]+dx/l*s,track[i-1][1]+dy/l*s};s-=l}
 return track[len(track)-1][0],track[len(track)-1][1]
}
// The tug's rear axle is on the track and looks along its chord (backwards when it backs up); a hitched trailer's rear
// axle follows the same track one drawbar behind and looks at the tug's hitch. A pure function of the distance.
func(v cargoConvoyDefinition)poses(track [][2]float64,s float64,reverse bool)(cargoPose,cargoPose){
 ax,ay:=cargoTrackAt(track,s);fx,fy:=cargoTrackAt(track,s+0.4);bx,by:=cargoTrackAt(track,s-0.4)
 yaw:=math.Atan2(fy-by,fx-bx);if reverse{yaw+=math.Pi}
 hx,hy:=ax-math.Cos(yaw)*v.Tug.HitchBackM,ay-math.Sin(yaw)*v.Tug.HitchBackM
 tx,ty:=cargoTrackAt(track,s-v.Tug.HitchBackM-v.Trailer.EyeM)
 return cargoPose{ax,ay,cargoDeg(yaw)},cargoPose{tx,ty,cargoDeg(math.Atan2(hy-ty,hx-tx))}
}
func(v cargoConvoyDefinition)trailerBehind(tug cargoPose)cargoPose{yaw:=tug.Yaw*math.Pi/180;back:=v.Tug.HitchBackM+v.Trailer.EyeM;return cargoPose{tug.X-math.Cos(yaw)*back,tug.Y-math.Sin(yaw)*back,tug.Yaw}}
// cargoBody: the cells of a level whose middles lie inside a body rectangle (back..front along the heading, ±half).
func cargoBody(p cargoPose,back,front,half,cell float64,add func(behavior.Cell)){
 yaw:=p.Yaw*math.Pi/180;fx,fy:=math.Cos(yaw),math.Sin(yaw);lx,ly:=math.Sin(yaw),-math.Cos(yaw)
 minX,maxX,minY,maxY:=math.Inf(1),math.Inf(-1),math.Inf(1),math.Inf(-1)
 for _,a:=range [2]float64{-back,front}{for _,b:=range [2]float64{-half,half}{x,y:=p.X+fx*a+lx*b,p.Y+fy*a+ly*b;minX,maxX,minY,maxY=math.Min(minX,x),math.Max(maxX,x),math.Min(minY,y),math.Max(maxY,y)}}
 for cy:=int(math.Floor(minY/cell));cy<=int(math.Floor(maxY/cell));cy++{for cx:=int(math.Floor(minX/cell));cx<=int(math.Floor(maxX/cell));cx++{
  mx,my:=(float64(cx)+0.5)*cell-p.X,(float64(cy)+0.5)*cell-p.Y;along,across:=mx*fx+my*fy,mx*lx+my*ly
  if along>= -back&&along<=front&&math.Abs(across)<=half{add(behavior.Cell{X:cx,Y:cy})}
 }}
}
func(r *Runtime)cargoCell(level string)float64{c:=float64(r.world.Life.Locations[level].CellMM)/1000;if c<=0{c=0.5};return c}
func(v cargoConvoyDefinition)tugCells(p cargoPose,cell float64,add func(behavior.Cell)){cargoBody(p,v.Tug.RearM,v.Tug.NoseM,v.Tug.HalfWidthM,cell,add)}
func(v cargoConvoyDefinition)trailerCells(p cargoPose,cell float64,add func(behavior.Cell)){cargoBody(p,v.Trailer.TailM,v.Trailer.BodyFrontM,v.Trailer.HalfWidthM,cell,add)}
// A point on the tug in its own frame (forward, left) in plan metres.
func cargoAt(p cargoPose,forward,left float64)(float64,float64){yaw:=p.Yaw*math.Pi/180;return p.X+math.Cos(yaw)*forward+math.Sin(yaw)*left,p.Y+math.Sin(yaw)*forward-math.Cos(yaw)*left}
func(r *Runtime)cargoNearest(level string,x,y float64,radius int,ok func(behavior.Cell)bool)(behavior.Cell,bool){
 cell:=r.cargoCell(level);c0:=behavior.Cell{X:int(math.Floor(x/cell)),Y:int(math.Floor(y/cell))}
 for d:=0;d<=radius;d++{best,found,bestD:=behavior.Cell{},false,math.Inf(1)
  for dy:=-d;dy<=d;dy++{for dx:=-d;dx<=d;dx++{if max(absInt(dx),absInt(dy))!=d{continue};c:=behavior.Cell{X:c0.X+dx,Y:c0.Y+dy};if !r.world.Life.Walks(level,c)||!ok(c){continue};dd:=math.Hypot((float64(c.X)+0.5)*cell-x,(float64(c.Y)+0.5)*cell-y);if dd<bestD-1e-9{best,found,bestD=c,true,dd}}}
  if found{return best,true}}
 return behavior.Cell{},false
}
func absInt(v int)int{if v<0{return -v};return v}

// ---- catalog lookups
func(r *Runtime)cargoRunOf(v cargoConvoyDefinition,id string)*cargoRun{for i:=range v.Runs{if v.Runs[i].ID==id{return &v.Runs[i]}};return nil}
func(r *Runtime)cargoStand(id string)*cargoStandDefinition{for i:=range r.world.CargoConvoys.Stands{if r.world.CargoConvoys.Stands[i].ID==id{return &r.world.CargoConvoys.Stands[i]}};return nil}
func(r *Runtime)cargoCrane(id string)*cargoCraneDefinition{for i:=range r.world.CargoConvoys.Cranes{if r.world.CargoConvoys.Cranes[i].ID==id{return &r.world.CargoConvoys.Cranes[i]}};return nil}
func(s *cargoStandDefinition)bay(id string)(cargoPose,bool){if s==nil{return cargoPose{},false};for _,b:=range s.Bays{if b.ID==id{return b.Trailer,true}};return cargoPose{},false}
func(r *Runtime)cargoDeck(id string)*liftingDeckDefinition{if r.world.LiftingDecks==nil{return nil};for i:=range r.world.LiftingDecks.Decks{if r.world.LiftingDecks.Decks[i].ID==id{return &r.world.LiftingDecks.Decks[i]}};return nil}
func(r *Runtime)cargoConvoyDef(id string)*cargoConvoyDefinition{if r.world.CargoConvoys==nil{return nil};for i:=range r.world.CargoConvoys.Convoys{if r.world.CargoConvoys.Convoys[i].ID==id{return &r.world.CargoConvoys.Convoys[i]}};return nil}
func(v cargoConvoyDefinition)seat(id string)cargoSeat{for _,s:=range v.Tug.Seats{if s.ID==id{return s}};return cargoSeat{}}
func(r *Runtime)cargoFloor(level string)float64{return r.world.CargoConvoys.Floors[level]}

// ---- the crane: a move is a fixed timeline from where the hook stands to the next bay and back up.
type cargoCranePose struct{BridgeY,HoistX,HookZ,LoadYaw,LoadZ float64;Load bool;Moving bool}
type cargoCraneSeg struct{Seconds float64;To cargoCranePose}
func(r *Runtime)cargoCraneLift(v cargoConvoyDefinition,p cargoPose)(float64,float64){mid:=(v.Trailer.BodyFrontM-v.Trailer.TailM)/2;yaw:=p.Yaw*math.Pi/180;return p.X+math.Cos(yaw)*mid,p.Y+math.Sin(yaw)*mid}
// The segments of move i from the hook's rest over the previous bay (or the park) and, past the last move, back to the park.
func(r *Runtime)cargoCraneSegments(k cargoCraneDefinition,v cargoConvoyDefinition,st cargoCraneState,i int)(cargoCranePose,[]cargoCraneSeg){
 stand:=r.cargoStand(k.StandID);park:=cargoCranePose{BridgeY:k.Park.BridgeYM,HoistX:k.Park.HoistXM,HookZ:k.Park.HookZM}
 start:=park
 if i>0&&i-1<len(st.Queue){to,_:=stand.bay(st.Queue[i-1].To);x,y:=r.cargoCraneLift(v,to);start=cargoCranePose{BridgeY:y,HoistX:x,HookZ:k.Park.HookZM,LoadYaw:to.Yaw}}
 travel:=func(a,b cargoCranePose,turn bool)float64{t:=math.Max(math.Abs(b.BridgeY-a.BridgeY)/k.Speed.BridgeMPS,math.Abs(b.HoistX-a.HoistX)/k.Speed.HoistMPS);if turn{d:=math.Mod(b.LoadYaw-a.LoadYaw+540,360)-180;t=math.Max(t,math.Abs(d)/k.Speed.TurnDPS)};return t}
 if i>=len(st.Queue){return start,[]cargoCraneSeg{{travel(start,park,false)+1,park}}}
 m:=st.Queue[i];from,_:=stand.bay(m.From);to,_:=stand.bay(m.To);fx,fy:=r.cargoCraneLift(v,from);tx,ty:=r.cargoCraneLift(v,to)
 over:=cargoCranePose{BridgeY:fy,HoistX:fx,HookZ:k.Park.HookZM,LoadYaw:from.Yaw}
 down:=over;down.HookZ=k.AttachZM
 held:=down;held.Load=true
 up:=held;up.HookZ=k.AttachZM+k.LiftM;up.LoadZ=k.LiftM
 // the load turns the shorter way to the new heading while the bridge and the hoist travel
 there:=up;there.BridgeY,there.HoistX=ty,tx;there.LoadYaw=from.Yaw+(math.Mod(to.Yaw-from.Yaw+540,360)-180)
 set:=there;set.HookZ=k.AttachZM;set.LoadZ=0
 free:=set;free.Load=false
 raised:=free;raised.HookZ=k.Park.HookZM;raised.LoadYaw=to.Yaw
 hook:=func(a,b cargoCranePose)float64{return math.Abs(b.HookZ-a.HookZ)/k.Speed.HookMPS}
 return start,[]cargoCraneSeg{{travel(start,over,false)+1,over},{hook(over,down),down},{float64(k.AttachSeconds),held},{hook(held,up),up},{travel(up,there,true),there},{hook(there,set),set},{float64(k.ReleaseSeconds),free},{hook(free,raised),raised}}
}
func cargoCraneDuration(segs []cargoCraneSeg)int64{t:=0.0;for _,s:=range segs{t+=s.Seconds};return int64(math.Ceil(t))}
func cargoCraneAt(start cargoCranePose,segs []cargoCraneSeg,t float64)cargoCranePose{
 at:=start
 for _,s:=range segs{if t<=s.Seconds&&s.Seconds>0{u:=t/s.Seconds;p:=s.To;p.BridgeY=at.BridgeY+(s.To.BridgeY-at.BridgeY)*u;p.HoistX=at.HoistX+(s.To.HoistX-at.HoistX)*u;p.HookZ=at.HookZ+(s.To.HookZ-at.HookZ)*u;p.LoadYaw=at.LoadYaw+(s.To.LoadYaw-at.LoadYaw)*u;p.LoadZ=at.LoadZ+(s.To.LoadZ-at.LoadZ)*u;p.Load=at.Load&&s.To.Load||(at.Load&&!s.To.Load&&u<1);p.Moving=true;return p};t-=s.Seconds;at=s.To}
 at.Moving=false;return at
}
// cargoCranePoseNow: where the crane is at a game second (parked when idle).
func(r *Runtime)cargoCranePoseNow(k cargoCraneDefinition,seconds int64)cargoCranePose{
 st:=r.state.CargoConvoys.Cranes[k.ID];v:=r.cargoCraneConvoy(k)
 if v==nil||len(st.Queue)==0{return cargoCranePose{BridgeY:k.Park.BridgeYM,HoistX:k.Park.HoistXM,HookZ:k.Park.HookZM}}
 start,segs:=r.cargoCraneSegments(k,*v,st,st.Move)
 if st.Since==0{return start}
 return cargoCraneAt(start,segs,float64(seconds-st.Since))
}
// cargoHookBay: while the hook is on its way to the trailer or has let it go, the trailer named on the hook still stands
// on a bay (the one it leaves before the attach, the new one after the release); false while it hangs.
func(r *Runtime)cargoHookBay(k cargoCraneDefinition,seconds int64)(string,bool){
 st:=r.state.CargoConvoys.Cranes[k.ID];v:=r.cargoCraneConvoy(k)
 if v==nil||st.Move>=len(st.Queue){return "",false}
 m:=st.Queue[st.Move]
 if st.Since==0{return m.From,true}
 start,segs:=r.cargoCraneSegments(k,*v,st,st.Move);t:=float64(seconds-st.Since)
 if cargoCraneAt(start,segs,t).Load{return "",false}
 held:=0.0;for _,s:=range segs[:min(3,len(segs))]{held+=s.Seconds}
 if t<held{return m.From,true}
 return m.To,true
}
func(r *Runtime)cargoCraneConvoy(k cargoCraneDefinition)*cargoConvoyDefinition{for i:=range r.world.CargoConvoys.Convoys{v:=&r.world.CargoConvoys.Convoys[i];for _,run:=range v.Runs{for _,l:=range run.Legs{if l.CraneID==k.ID{return v}}}};return nil}
// Somebody stands in the crane's band: a move waits for it to be clear.
func(r *Runtime)cargoBandPeople(k cargoCraneDefinition)bool{
 in:=func(c behavior.Cell)bool{return c.X>=k.Band.X&&c.X<k.Band.X+k.Band.W&&c.Y>=k.Band.Y&&c.Y<k.Band.Y+k.Band.H}
 for _,a:=range r.state.Life.Actors{if a.Level!=k.LevelID||!a.OnFloor(){continue};if in(a.Position){return true};if a.Body!=nil{for _,c:=range a.Body.Cells{if in(c){return true}}}}
 for _,a:=range r.state.Life.Population.Actors{if a.Level==k.LevelID&&a.Materialized&&a.Trip==nil&&in(a.Position){return true}}
 if r.visitorsOn()&&r.world.Visitors.Level==k.LevelID{for _,b:=range r.state.Visitors.Bodies{if in(b.At){return true}}}
 return false
}
func(r *Runtime)advanceCargoCranes(seconds int64){
 for _,k:=range r.world.CargoConvoys.Cranes{
  st:=r.state.CargoConvoys.Cranes[k.ID];v:=r.cargoCraneConvoy(k)
  for guard:=0;guard<8&&len(st.Queue)>0&&v!=nil;guard++{
   if st.Since==0{
    if st.Move<len(st.Queue)&&r.cargoBandPeople(k){break}
    st.Since=max(int64(1),seconds)
    if st.Move<len(st.Queue){m:=st.Queue[st.Move];t:=r.state.CargoConvoys.Trailers[m.Trailer];t.Stand,t.Bay,t.Hook="","",k.ID;r.state.CargoConvoys.Trailers[m.Trailer]=t;st.Hook=m.Trailer}
   }
   _,segs:=r.cargoCraneSegments(k,*v,st,st.Move)
   if seconds-st.Since<cargoCraneDuration(segs){break}
   end:=st.Since+cargoCraneDuration(segs)
   if st.Move<len(st.Queue){m:=st.Queue[st.Move];r.state.CargoConvoys.Trailers[m.Trailer]=cargoTrailerState{Stand:k.StandID,Bay:m.To};st.Hook="";st.Move++;st.Since=0
    // the next move starts at once when the band is clear (time-only: its start is the end of the previous one)
    if st.Move<len(st.Queue)&&!r.cargoBandPeople(k){st.Since=end;m=st.Queue[st.Move];t:=r.state.CargoConvoys.Trailers[m.Trailer];t.Stand,t.Bay,t.Hook="","",k.ID;r.state.CargoConvoys.Trailers[m.Trailer]=t;st.Hook=m.Trailer}else if st.Move>=len(st.Queue){st.Since=end}
    continue}
   st=cargoCraneState{} // back at the park
  }
  r.state.CargoConvoys.Cranes[k.ID]=st
 }
}

// ---- bodies on the floor: the moving convoy, the parked trailers and, while the crane works, its band.
func(r *Runtime)cargoBodies(add func(level string,c behavior.Cell)){
 if r.world.CargoConvoys==nil||r.state.CargoConvoys==nil{return}
 for _,v:=range r.world.CargoConvoys.Convoys{c:=r.state.CargoConvoys.Convoys[v.ID];if c.Level==""||r.cargoOnMovingDeck(v,c){continue};cell:=r.cargoCell(c.Level)
  v.tugCells(c.Pose,cell,func(x behavior.Cell){add(c.Level,x)});if c.Hitched!=""{v.trailerCells(c.TrailerPose,cell,func(x behavior.Cell){add(c.Level,x)})}
 }
 for _,v:=range r.world.CargoConvoys.Convoys{for _,tr:=range v.Trailers{t:=r.state.CargoConvoys.Trailers[tr.ID];if t.Stand==""||t.Bay==""{continue};s:=r.cargoStand(t.Stand);p,ok:=s.bay(t.Bay);if !ok{continue};v.trailerCells(p,r.cargoCell(s.LevelID),func(x behavior.Cell){add(s.LevelID,x)})}}
 for _,k:=range r.world.CargoConvoys.Cranes{st:=r.state.CargoConvoys.Cranes[k.ID];if st.Hook==""{continue};for y:=k.Band.Y;y<k.Band.Y+k.Band.H;y++{for x:=k.Band.X;x<k.Band.X+k.Band.W;x++{add(k.LevelID,behavior.Cell{X:x,Y:y})}}}
}
// cargoVehicles: the cells of the convoys and the parked trailers, by level (they hold a gate or a deck like a person).
func(r *Runtime)cargoVehicles()map[string]map[behavior.Cell]bool{
 var out map[string]map[behavior.Cell]bool
 r.cargoBodies(func(level string,c behavior.Cell){if out==nil{out=map[string]map[behavior.Cell]bool{}};if out[level]==nil{out[level]=map[behavior.Cell]bool{}};out[level][c]=true})
 return out
}
// On a deck that has left its landing the convoy is in the shaft: no body on any floor.
func(r *Runtime)cargoOnMovingDeck(v cargoConvoyDefinition,c cargoConvoyState)bool{return c.Run!=""&&c.Phase=="away"}

// ---- people and the way ahead
func(r *Runtime)cargoPeopleAt(level string,cells map[behavior.Cell]bool)bool{
 for _,a:=range r.state.Life.Actors{if a.Level!=level||!a.OnFloor(){continue};if cells[a.Position]{return true};if a.Body!=nil{for _,c:=range a.Body.Cells{if cells[c]{return true}}}}
 for _,a:=range r.state.Life.Population.Actors{if a.Level==level&&(a.Materialized||a.CombatHold)&&a.Trip==nil&&cells[a.Position]{return true}}
 if r.visitorsOn()&&r.world.Visitors.Level==level{for _,b:=range r.state.Visitors.Bodies{if cells[b.At]{return true}}}
 return false
}
// The next stretch of the track is free: no person and no closed thing (a lowered gate) under the new body. Void and the
// space beyond the level's grid (the corridor drawn as a vista) are free.
func(r *Runtime)cargoWayClear(v cargoConvoyDefinition,level string,from,to cargoPose,fromTrailer,toTrailer *cargoPose,model behavior.LifeModel)bool{
 cell:=r.cargoCell(level);old,next:=map[behavior.Cell]bool{},map[behavior.Cell]bool{}
 v.tugCells(from,cell,func(c behavior.Cell){old[c]=true});if fromTrailer!=nil{v.trailerCells(*fromTrailer,cell,func(c behavior.Cell){old[c]=true})}
 v.tugCells(to,cell,func(c behavior.Cell){if !old[c]{next[c]=true}});if toTrailer!=nil{v.trailerCells(*toTrailer,cell,func(c behavior.Cell){if !old[c]{next[c]=true}})}
 t:=model.Locations[level].Terrain
 for c:=range next{if c.Y<0||c.Y>=len(t)||c.X<0||c.X>=len(t[c.Y]){continue};g:=t[c.Y][c.X];if g!=' '&&!model.Walkable[string(g)]{return false}}
 return !r.cargoPeopleAt(level,next)
}

// ---- the crew: seated riders go with the tug; at a stop they step down and walk a few cells to their posts.
func(r *Runtime)cargoSeatPoint(v cargoConvoyDefinition,c cargoConvoyState,seat string)(float64,float64){s:=v.seat(seat);return cargoAt(c.Pose,s.M[0],s.M[2])}
func(r *Runtime)cargoSeatCell(v cargoConvoyDefinition,c cargoConvoyState,seat string)behavior.Cell{x,y:=r.cargoSeatPoint(v,c,seat);at,ok:=r.cargoNearest(c.Level,x,y,24,func(behavior.Cell)bool{return true});if !ok{return behavior.Cell{}};return at}
// The cell beside a seat where its rider gets on and off: off the vehicle's body, free.
func(r *Runtime)cargoBoardCell(v cargoConvoyDefinition,c cargoConvoyState,seat,id string)(behavior.Cell,bool){
 s:=v.seat(seat);side:=v.Tug.HalfWidthM+0.45;if s.Side=="right"{side=-side}
 x,y:=cargoAt(c.Pose,s.M[0],side);body:=map[behavior.Cell]bool{};cell:=r.cargoCell(c.Level)
 v.tugCells(c.Pose,cell,func(x behavior.Cell){body[x]=true});if c.Hitched!=""{v.trailerCells(c.TrailerPose,cell,func(x behavior.Cell){body[x]=true})}
 blocked:=r.state.Life.BlockedCells(c.Level,id)
 return r.cargoNearest(c.Level,x,y,6,func(at behavior.Cell)bool{return !body[at]&&!blocked[at]})
}
func(r *Runtime)cargoWant(v cargoConvoyDefinition,leg cargoLeg,i int)cargoCrewAt{if i<len(leg.Posts){return leg.Posts[i]};return cargoCrewAt{Seat:true}}
// cargoPlaceCrew moves every crew member towards where the leg wants him; true when all are there.
func(r *Runtime)cargoPlaceCrew(v cargoConvoyDefinition,c *cargoConvoyState,leg cargoLeg,delta int64)bool{
 m:=r.world.Life;ready:=true
 for i,member:=range v.Crew{
  a:=r.state.Life.Actor(member.ID);if a==nil{return false};want:=r.cargoWant(v,leg,i)
  if a.Mount==nil||a.Mount.Vehicle!=v.ID{
   // gather: a free crew member on the convoy's level joins it where he stands
   if leg.Kind!="gather"||!a.OnFloor()||a.Level!=c.Level||a.CombatHold||a.Body!=nil{ready=false;continue}
   if err:=r.state.Life.Board(a.ID,v.ID,member.Seat);err!=nil{ready=false;continue};a.Mount.Afoot=true;a.Arrived=true
  }
  if want.Seat{
   if !a.Mount.Afoot{if err:=r.state.Life.Carry(m,a.ID,c.Level,r.cargoSeatCell(v,*c,member.Seat));err!=nil{return false};continue}
   board,ok:=r.cargoBoardCell(v,*c,member.Seat,a.ID);if !ok{ready=false;continue}
   if a.Position==board||behavior.Distance(a.Position,board)<=1&&r.cargoNextTo(v,*c,a.Position){
    if err:=r.state.Life.Board(a.ID,v.ID,member.Seat);err==nil{_=r.state.Life.Carry(m,a.ID,c.Level,r.cargoSeatCell(v,*c,member.Seat));delete(c.Walk,a.ID)};continue}
   r.cargoWalkTo(v,c,a,board,delta);ready=false;continue
  }
  target:=*want.At
  if !a.Mount.Afoot{
   board,ok:=r.cargoBoardCell(v,*c,member.Seat,a.ID);if !ok{ready=false;continue}
   if err:=r.state.Life.StepDown(m,a.ID,c.Level,board);err!=nil{ready=false;continue}
  }
  if a.Position!=target{r.cargoWalkTo(v,c,a,target,delta);ready=a.Position==target&&ready}
 }
 return ready
}
// A cell touching the tug's body (a rider who stands there can climb on).
func(r *Runtime)cargoNextTo(v cargoConvoyDefinition,c cargoConvoyState,at behavior.Cell)bool{
 body:=map[behavior.Cell]bool{};v.tugCells(c.Pose,r.cargoCell(c.Level),func(x behavior.Cell){body[x]=true})
 for _,d:=range []behavior.Cell{{X:1},{X:-1},{Y:1},{Y:-1},{X:1,Y:1},{X:-1,Y:1},{X:1,Y:-1},{X:-1,Y:-1}}{if body[behavior.Cell{X:at.X+d.X,Y:at.Y+d.Y}]{return true}}
 return false
}
// cargoWalkTo: an afoot rider walks at his pace along a path round bodies; a taken next cell holds him a tick.
func(r *Runtime)cargoWalkTo(v cargoConvoyDefinition,c *cargoConvoyState,a *behavior.LifeActor,to behavior.Cell,delta int64){
 if c.Walk==nil{c.Walk=map[string]cargoWalk{}};w:=c.Walk[a.ID]
 if len(w.Path)==0||w.Path[len(w.Path)-1]!=to{w.Path=r.world.Life.SpaceFor(a.Level,r.state.Life.BlockedCells(a.Level,a.ID),a.ID).Path(a.Position,to,behavior.Cell{},0)}
 w.AccMM+=delta*v.WalkMMPerSecond;step:=int64(r.world.Life.Locations[a.Level].CellMM);if step<1{step=500}
 for w.AccMM>=step&&len(w.Path)>0{next:=w.Path[0];if r.state.Life.Stand(r.world.Life,a.ID,next)!=nil{w.Path=nil;break};w.Path=w.Path[1:];w.AccMM-=step}
 if len(w.Path)==0{w.AccMM=0}
 if w.AccMM>4*step{w.AccMM=4*step}
 c.Walk[a.ID]=w
}
// Activity of the crew while bound: the driver drives on the move; everyone else does the leg's work.
func(r *Runtime)cargoLabelCrew(v cargoConvoyDefinition,c cargoConvoyState,leg cargoLeg,moving bool){
 // seated on "drive"/"sit" seats the client shows the sitting clip, on the step a standing one; afoot they work
 for i,member:=range v.Crew{a:=r.state.Life.Actor(member.ID);if a==nil||a.Mount==nil||a.Mount.Vehicle!=v.ID{continue};a.Label=leg.Label;if i==0&&moving{a.Label="life.cargo.driving"}
  switch{case a.Mount.Afoot:a.Activity="work";case v.seat(member.Seat).Pose=="stand":a.Activity="ride";default:a.Activity="sit"}}
}
// Every seated rider of the convoy leaves the level on an edge (a deck's or the freight road's).
func(r *Runtime)cargoDepartRiders(v cargoConvoyDefinition,edge string,seconds int64)error{
 for _,member:=range v.Crew{a:=r.state.Life.Actor(member.ID);if a==nil||a.Mount==nil||a.Mount.Vehicle!=v.ID{continue};if a.Mount.Afoot{return fmt.Errorf("%s: %s is afoot while the convoy leaves",v.ID,a.ID)};if err:=r.state.Life.Depart(r.world.Life,a.ID,edge,min(seconds,r.state.Life.Seconds));err!=nil{return err}}
 return nil
}
func(r *Runtime)cargoCarryRiders(v cargoConvoyDefinition,c cargoConvoyState)error{
 for _,member:=range v.Crew{a:=r.state.Life.Actor(member.ID);if a==nil||a.Mount==nil||a.Mount.Vehicle!=v.ID||a.Mount.Afoot{continue};if err:=r.state.Life.Carry(r.world.Life,a.ID,c.Level,r.cargoSeatCell(v,c,member.Seat));err!=nil{return err}}
 return nil
}

// ---- the lots: from the Copper stores into the hitched trailer, from the trailer into the stalls' lockers.
func(r *Runtime)cargoStock(store,owner,item string)int64{n:=int64(0);for _,i:=range r.state.Inventory.Items{if i.Quantity>0&&i.Location.Kind=="store"&&i.Location.Store==store&&(owner==""||i.Owner==owner)&&(item==""||i.Definition==item){n+=i.Quantity}};return n}
func(r *Runtime)cargoLotShop(lot cargoLotDefinition)*inv.Shopfront{for i:=range r.world.Inventory.Shopfronts{if r.world.Inventory.Shopfronts[i].ID==lot.Shop{return &r.world.Inventory.Shopfronts[i]}};return nil}
// What one lot takes this morning: a delivery its fixed quantity; a supply lot what the stall lacks of its full stock,
// counting the counter, the locked reserve, the locker and the trailers.
func(r *Runtime)cargoLotNeeds(lot cargoLotDefinition)map[string]int64{
 out:=map[string]int64{}
 if lot.Kind=="delivery"{out[lot.Definition]=lot.Quantity;return out}
 shop:=r.cargoLotShop(lot);if shop==nil{return out}
 for _,it:=range lot.Items{have:=r.cargoStock(shop.DisplayStore,lot.Owner,it.Item)+r.cargoStock(shop.ReserveStore,lot.Owner,it.Item)+r.cargoStock(lot.LockerStore,lot.Owner,it.Item);for _,s:=range lot.TrailerStores{have+=r.cargoStock(s,lot.Owner,it.Item)};if it.Full>have{out[it.Item]=it.Full-have}}
 return out
}
func(r *Runtime)cargoMoveLot(lot cargoLotDefinition,from,to string,needs map[string]int64,tag string)(int64,error){
 model:=r.inventoryModelFor(true);work:=r.state.Inventory.Clone();moved:=int64(0)
 items:=make([]string,0,len(needs));for k:=range needs{items=append(items,k)};sort.Strings(items)
 for _,item:=range items{q:=needs[item];if q<1{continue};cargo,err:=work.MoveMachineConsignment(model,lot.Owner,from,to,item,q,tag+"/"+item);if err!=nil{return 0,err};for _,x:=range cargo{moved+=x.Quantity}}
 if moved>0{r.state.Inventory=work};return moved,nil
}
func(r *Runtime)cargoLoadLot(v cargoConvoyDefinition,c cargoConvoyState,lot cargoLotDefinition,day int64)error{
 if c.Hitched==""{return nil};store:=lot.TrailerStores[c.Hitched];if store==""{return fmt.Errorf("lot %s has no store in %s",lot.Shop,c.Hitched)}
 _,err:=r.cargoMoveLot(lot,lot.CopperStore,store,r.cargoLotNeeds(lot),fmt.Sprintf("%s/load/%d/%s",v.ID,day,lot.Shop));return err
}
func(r *Runtime)cargoUnloadLot(v cargoConvoyDefinition,c cargoConvoyState,lot cargoLotDefinition,day int64)error{
 if c.Hitched==""{return nil};store:=lot.TrailerStores[c.Hitched];all:=map[string]int64{}
 for _,i:=range r.state.Inventory.Items{if i.Quantity>0&&i.Location.Kind=="store"&&i.Location.Store==store&&i.Owner==lot.Owner{all[i.Definition]+=i.Quantity}}
 moved,err:=r.cargoMoveLot(lot,store,lot.LockerStore,all,fmt.Sprintf("%s/unload/%d/%s",v.ID,day,lot.Shop));if err!=nil||moved==0{return err}
 if r.state.CargoConvoys.Landed==nil{r.state.CargoConvoys.Landed=map[string]int64{}};r.state.CargoConvoys.Landed[lot.Shop]=r.state.Life.Seconds
 // a stall that laid out today before its lot came lays out again (visitors' consignment rule)
 if lot.Kind=="supply"&&r.state.Visitors.Supplied!=nil&&r.state.Visitors.Supplied[lot.Shop]==r.state.Life.Seconds/86400+1{delete(r.state.Visitors.Supplied,lot.Shop)}
 return nil
}
// cargoLotLanded: the game second today's lot of a shop reached its locker (0: not today).
func(r *Runtime)cargoLotLanded(shop string)int64{if r.state.CargoConvoys==nil{return 0};t:=r.state.CargoConvoys.Landed[shop];if t/86400!=r.state.Life.Seconds/86400{return 0};return t}
// cargoLotPending: the stall's locker is empty and today's lot is still on its way — in a trailer, or in Copper while
// today's run has its loading still ahead. A locker with goods in it is never waited for: they are taken now.
func(r *Runtime)cargoLotPending(shop string)bool{
 if r.world.CargoConvoys==nil||r.state.CargoConvoys==nil{return false}
 var lot *cargoLotDefinition;for i:=range r.world.CargoConvoys.Lots{if r.world.CargoConvoys.Lots[i].Shop==shop{lot=&r.world.CargoConvoys.Lots[i]}};if lot==nil{return false}
 if r.cargoStock(lot.LockerStore,lot.Owner,"")>0{return false}
 for _,s:=range lot.TrailerStores{if r.cargoStock(s,lot.Owner,"")>0{return true}}
 day:=r.state.Life.Seconds/86400
 for _,v:=range r.world.CargoConvoys.Convoys{c:=r.state.CargoConvoys.Convoys[v.ID];run:=r.cargoRunOf(v,c.Run);if run==nil||c.Day!=day+1{continue}
  for li:=c.Leg;li<len(run.Legs);li++{if run.Legs[li].Kind=="load"{return r.cargoStock(lot.CopperStore,lot.Owner,"")>0}}}
 return false
}

// ---- the convoy's route
func(r *Runtime)cargoGates(v cargoConvoyDefinition,c cargoConvoyState){
 for _,g:=range v.Gates{want:="";if c.Run!=""{if c.Level==g.LevelID{want=v.ID};if run:=r.cargoRunOf(v,c.Run);run!=nil&&c.Leg<len(run.Legs){l:=run.Legs[c.Leg];if l.Kind=="edge"&&l.ToLevel==g.LevelID{want=v.ID}}}
  if gs,ok:=r.state.Life.Gates[g.GateID];ok&&gs.PermitVehicle!=want{_=r.state.Life.SetGatePermit(r.world.Life,g.GateID,want)}}
}
func(r *Runtime)advanceCargoConvoys(seconds,delta int64)error{
 if r.world.CargoConvoys==nil||!r.state.Life.Enabled||r.state.CargoConvoys==nil{return nil};now:=r.state.Tick*r.tickNS()
 for _,v:=range r.world.CargoConvoys.Convoys{
  c:=r.state.CargoConvoys.Convoys[v.ID];day,sod:=seconds/86400,seconds%86400
  if c.Run==""{for _,run:=range v.Runs{if c.Day!=day+1&&sod>=run.StartSecond&&sod<run.StartSecond+3600{c.Run,c.Day,c.Leg,c.Phase,c.S,c.Since,c.Done=run.ID,day+1,0,"crew",0,seconds,0;break}}}
  for guard:=0;c.Run!=""&&guard<4;guard++{
   run:=r.cargoRunOf(v,c.Run);if run==nil||c.Leg>=len(run.Legs){return fmt.Errorf("invalid cargo run %s/%s",v.ID,c.Run)}
   leg:=run.Legs[c.Leg];done,err:=r.cargoLeg(v,&c,leg,seconds,delta,now);if err!=nil{return err}
   r.cargoLabelCrew(v,c,leg,c.Phase=="go"&&(leg.Kind=="drive")||c.Phase=="board")
   if !done{break}
   c.Leg++;c.Phase,c.S,c.Since,c.Done="crew",0,seconds,0
   if c.Leg>=len(run.Legs){c.Run,c.Leg,c.Phase="",0,"";c.Walk=nil;break}
  }
  // canonical form (the same after a save): no finished walks, no empty paths
  for id,w:=range c.Walk{if len(w.Path)==0{w.Path=nil};if w.Path==nil&&w.AccMM==0{delete(c.Walk,id)}else{c.Walk[id]=w}};if len(c.Walk)==0{c.Walk=nil}
  c.UpdatedNS=now;r.state.CargoConvoys.Convoys[v.ID]=c;r.cargoGates(v,c)
 }
 r.advanceCargoCranes(seconds)
 return nil
}
// cargoLeg advances one leg; true when it is finished.
func(r *Runtime)cargoLeg(v cargoConvoyDefinition,c *cargoConvoyState,leg cargoLeg,seconds,delta,now int64)(bool,error){
 dayStart:=(c.Day-1)*86400
 if leg.Kind=="drive"&&c.Level==""{
  // arrival from an edge: the convoy appears at the start of this track with its riders on their seats
  c.Level=leg.Level;c.Pose,c.TrailerPose=v.poses(leg.Path,0,leg.Reverse);if err:=r.cargoCarryRiders(v,*c);err!=nil{return false,err}
 }
 if c.Phase=="crew"{
  // the crew takes its places first; a moving leg wants everyone on a seat (or at a post off its way)
  if leg.Kind!="release"&&!r.cargoPlaceCrew(v,c,leg,delta){return false,nil}
  c.Phase,c.Since="go",seconds
 }
 switch leg.Kind{
 case "gather","charge":if leg.Kind=="charge"{c.Charging=true};return true,nil
 case "load","unload":
  if c.Phase=="go"{if leg.FromSecond>0&&seconds<dayStart+leg.FromSecond{return false,nil};c.Phase,c.Since,c.Done="work",seconds,0}
  lots:=r.world.CargoConvoys.Lots;due:=len(lots);if leg.Seconds>0{due=int(min(int64(len(lots)),(seconds-c.Since)*int64(len(lots))/leg.Seconds+1))}
  for ;c.Done<due;c.Done++{var err error;if leg.Kind=="load"{err=r.cargoLoadLot(v,*c,lots[c.Done],c.Day)}else{err=r.cargoUnloadLot(v,*c,lots[c.Done],c.Day)};if err!=nil{return false,err}}
  return c.Done>=len(lots)&&seconds-c.Since>=leg.Seconds,nil
 case "unhitch":
  s:=r.cargoStand(leg.StandID);if _,ok:=s.bay(leg.Bay);!ok||c.Hitched==""{return false,fmt.Errorf("%s: unhitch at %s/%s",v.ID,leg.StandID,leg.Bay)}
  r.state.CargoConvoys.Trailers[c.Hitched]=cargoTrailerState{Stand:leg.StandID,Bay:leg.Bay};c.Hitched="";c.Charging=false;return true,nil
 case "hitch":
  for id,t:=range r.state.CargoConvoys.Trailers{if t.Stand==leg.StandID&&t.Bay==leg.Bay{p,_:=r.cargoStand(leg.StandID).bay(leg.Bay);c.Hitched=id;c.TrailerPose=p;r.state.CargoConvoys.Trailers[id]=cargoTrailerState{};return true,nil}}
  return false,nil // the crane has not brought it yet
 case "crane":
  k:=r.cargoCrane(leg.CraneID);st:=r.state.CargoConvoys.Cranes[k.ID]
  if c.Phase=="go"{
   if len(st.Queue)>0{return false,nil}
   for _,m:=range leg.Moves{tr:="";for id,t:=range r.state.CargoConvoys.Trailers{if t.Stand==leg.StandID&&t.Bay==m.From{tr=id}};if tr==""{return false,fmt.Errorf("%s: no trailer on %s for the crane",v.ID,m.From)};st.Queue=append(st.Queue,cargoCraneMove{From:m.From,To:m.To,Trailer:tr})}
   r.state.CargoConvoys.Cranes[k.ID]=st;c.Phase="work";return false,nil
  }
  return len(st.Queue)==0,nil
 case "release":
  for _,member:=range v.Crew{a:=r.state.Life.Actor(member.ID);if a==nil||a.Mount==nil||a.Mount.Vehicle!=v.ID{continue}
   at:=a.Position;if !a.Mount.Afoot{b,ok:=r.cargoBoardCell(v,*c,member.Seat,a.ID);if !ok{return false,nil};at=b}
   if err:=r.state.Life.Dismount(r.world.Life,a.ID,c.Level,at);err!=nil{return false,nil};a.Activity="rest";a.Label=leg.Label}
  c.Charging=false;return true,nil
 case "drive":
  return r.cargoDrive(v,c,leg,leg.Path,leg.Reverse,delta),nil
 case "edge":
  e:=r.world.Life.Edge(leg.LifeEdge);if e==nil{return false,fmt.Errorf("%s: unknown edge %s",v.ID,leg.LifeEdge)}
  if c.Phase=="go"{if err:=r.cargoDepartRiders(v,e.ID,seconds);err!=nil{return false,err};c.Level="";c.Phase,c.Since="away",seconds}
  return seconds>=c.Since+e.TravelSeconds,nil
 case "deck":
  d:=r.cargoDeck(leg.DeckID);if d==nil||d.Lower==nil{return false,fmt.Errorf("%s: unknown deck %s",v.ID,leg.DeckID)}
  g:=r.state.LiftingDecks[d.ID];p:=g.pose(g.UpdatedNS);_,_,lowerOpen:=g.lowerPose(*d);up:=leg.Level==d.Lower.LevelID
  upperOpen:=g.Phase=="loading"&&p.Deck==liftingDeckFull&&p.Barrier==0
  switch c.Phase{
  case "go":
   ok:=false
   if up{ok=lowerOpen&&g.Phase=="rest"&&!g.LowerAway}else{
    // board only with time to spare: the deck's loading window runs in physical time, the drive in game time
    left:=g.StartNS+g.DurationNS-g.UpdatedNS;need:=int64(math.Ceil(cargoTrackLength(leg.Path)*1000/float64(v.SpeedMMPerSecond*max(int64(1),delta))))+2
    ok=upperOpen&&left>=need*r.tickNS()}
   if ok{c.Phase="board"}
   return false,nil
  case "board":
   if r.cargoDrive(v,c,leg,leg.Path,false,delta){c.Phase="on_deck"}
   return false,nil
  case "on_deck":
   left:=false;edge:=d.TravelEdge;if up{left=g.LowerAway&&g.LowerArriveSecond==0;edge=d.ReturnEdge}else{left=g.LowerAway&&g.LowerArriveSecond>0}
   if left{if err:=r.cargoDepartRiders(v,edge,seconds);err!=nil{return false,err};c.Phase,c.Since="away",seconds}
   return false,nil
  case "away":
   arrived:=false;if up{arrived=upperOpen}else{arrived=!g.LowerAway&&lowerOpen}
   if !arrived{return false,nil}
   up2:=[2]float64{float64(d.Rect.X*2+d.Rect.W)/4,float64(d.Rect.Y*2+d.Rect.H)/4};low:=[2]float64{float64(d.Lower.Rect.X*2+d.Lower.Rect.W)/4,float64(d.Lower.Rect.Y*2+d.Lower.Rect.H)/4}
   from,to:=low,up2;if !up{from,to=up2,low}
   c.Pose.X,c.Pose.Y=c.Pose.X-from[0]+to[0],c.Pose.Y-from[1]+to[1];c.TrailerPose.X,c.TrailerPose.Y=c.TrailerPose.X-from[0]+to[0],c.TrailerPose.Y-from[1]+to[1];c.Level=leg.ToLevel
   if err:=r.cargoCarryRiders(v,*c);err!=nil{return false,err}
   return true,nil
  }
  return false,nil
 }
 return false,fmt.Errorf("%s: unknown leg %q",v.ID,leg.Kind)
}
// cargoDrive moves the convoy along a track at its pace; it stops before a body or a closed thing. True at the end.
func(r *Runtime)cargoDrive(v cargoConvoyDefinition,c *cargoConvoyState,leg cargoLeg,track [][2]float64,reverse bool,delta int64)bool{
 length:=int64(math.Round(cargoTrackLength(track)*1000));if c.S>=length{return true}
 speed:=v.SpeedMMPerSecond;if reverse{speed=v.ReverseMMPerSecond};budget:=speed*delta
 model:=r.state.Life.GateModel(r.liftingDeckLifeModel(r.state,r.world.Life))
 for budget>0&&c.S<length{
  step:=min(budget,int64(250),length-c.S);tug,trailer:=v.poses(track,float64(c.S+step)/1000,reverse)
  var ft,tt *cargoPose;if c.Hitched!=""{ft,tt=&c.TrailerPose,&trailer}
  if !r.cargoWayClear(v,c.Level,c.Pose,tug,ft,tt,model){break}
  c.S+=step;budget-=step;c.Pose=tug;if c.Hitched!=""{c.TrailerPose=trailer}
 }
 if err:=r.cargoCarryRiders(v,*c);err!=nil{return false}
 return c.S>=length
}

// ---- saves
func(r *Runtime)validateCargoConvoys(s state)error{
 if r.world.CargoConvoys==nil{if s.CargoConvoys!=nil{return fmt.Errorf("cargo state without a cargo catalog")};return nil}
 st:=s.CargoConvoys;if st==nil{return fmt.Errorf("cargo state differs from the catalog; explicit save migration required")}
 if len(st.Convoys)!=len(r.world.CargoConvoys.Convoys)||len(st.Cranes)!=len(r.world.CargoConvoys.Cranes){return fmt.Errorf("cargo state differs from the catalog; explicit save migration required")}
 trailers:=0;hitched:=map[string]string{}
 for _,v:=range r.world.CargoConvoys.Convoys{
  c,ok:=st.Convoys[v.ID];if !ok{return fmt.Errorf("missing cargo convoy %s",v.ID)}
  trailers+=len(v.Trailers);for _,t:=range v.Trailers{if _,ok:=st.Trailers[t.ID];!ok{return fmt.Errorf("missing cargo trailer %s",t.ID)}}
  if c.Hitched!=""{if t,ok:=st.Trailers[c.Hitched];!ok||t.Stand!=""||t.Hook!=""{return fmt.Errorf("invalid hitched trailer %s",c.Hitched)};hitched[c.Hitched]=v.ID}
  if c.Run!=""{run:=r.cargoRunOf(v,c.Run);if run==nil||c.Leg<0||c.Leg>=len(run.Legs)||c.Day<1||c.S<0||c.Since<0||c.Since>s.Life.Seconds||c.Done<0||c.Done>len(r.world.CargoConvoys.Lots){return fmt.Errorf("invalid cargo convoy state %s",v.ID)}
   leg:=run.Legs[c.Leg];if (leg.Kind=="drive"||leg.Kind=="deck")&&c.S>int64(math.Round(cargoTrackLength(leg.Path)*1000)){return fmt.Errorf("invalid cargo convoy distance %s",v.ID)}
   if c.Level==""&&c.Phase!="away"{return fmt.Errorf("cargo convoy %s lost between levels",v.ID)}}
  for _,member:=range v.Crew{a:=s.Life.Actor(member.ID);if a!=nil&&a.Mount!=nil&&a.Mount.Vehicle==v.ID&&(c.Run==""||a.Mount.Seat!=member.Seat){return fmt.Errorf("rider %s is bound to an idle convoy or a wrong seat",a.ID)}}
 }
 if len(st.Trailers)!=trailers{return fmt.Errorf("cargo trailer catalog/state mismatch")}
 bays:=map[[2]string]bool{}
 for id,t:=range st.Trailers{
  switch{
  case t.Hook!="":k:=r.cargoCrane(t.Hook);if k==nil||st.Cranes[k.ID].Hook!=id||hitched[id]!=""{return fmt.Errorf("invalid trailer on a hook %s",id)}
  case t.Stand!="":if _,ok:=r.cargoStand(t.Stand).bay(t.Bay);!ok||bays[[2]string{t.Stand,t.Bay}]||hitched[id]!=""{return fmt.Errorf("invalid parked trailer %s",id)};bays[[2]string{t.Stand,t.Bay}]=true
  default:if hitched[id]==""{return fmt.Errorf("trailer %s is nowhere",id)}
  }
 }
 for _,k:=range r.world.CargoConvoys.Cranes{c,ok:=st.Cranes[k.ID];if !ok||c.Move<0||c.Move>len(c.Queue)||c.Since<0||c.Since>s.Life.Seconds||(c.Hook!=""&&(c.Move>=len(c.Queue)||c.Queue[c.Move].Trailer!=c.Hook||st.Trailers[c.Hook].Hook!=k.ID)){return fmt.Errorf("invalid crane state %s",k.ID)}}
 return nil
}

// ---- the lifting deck weighs the convoy that stands on it: tug, trailer, the goods inside, the riders (PART-B §1.4)
func(r *Runtime)cargoDeckWeightG(d liftingDeckDefinition)(int64,bool){
 if r.world.CargoConvoys==nil||r.state.CargoConvoys==nil{return 0,false}
 for _,v:=range r.world.CargoConvoys.Convoys{c:=r.state.CargoConvoys.Convoys[v.ID];run:=r.cargoRunOf(v,c.Run);if run==nil||c.Leg>=len(run.Legs){continue};leg:=run.Legs[c.Leg];if leg.Kind!="deck"||leg.DeckID!=d.ID||(c.Phase!="on_deck"&&c.Phase!="away"){continue}
  g:=v.Tug.MassKG*1000;if c.Hitched!=""{g+=v.Trailer.MassKG*1000;stores:=map[string]bool{};for _,lot:=range r.world.CargoConvoys.Lots{stores[lot.TrailerStores[c.Hitched]]=true};for _,i:=range r.state.Inventory.Items{if i.Quantity>0&&i.Location.Kind=="store"&&stores[i.Location.Store]{if def,ok:=r.world.Inventory.Definitions[i.Definition];ok{g+=def.Mass*i.Quantity}}}}
  for _,member:=range v.Crew{if a:=r.state.Life.Actor(member.ID);a!=nil&&a.Mount!=nil&&a.Mount.Vehicle==v.ID&&!a.Mount.Afoot{g+=v.RiderMassKG*1000}}
  return g,true}
 return 0,false
}

// ---- the view
func(r *Runtime)cargoTrailerUnits(v cargoConvoyDefinition,trailer string)int64{n:=int64(0);for _,lot:=range r.world.CargoConvoys.Lots{n+=r.cargoStock(lot.TrailerStores[trailer],"","")};return n}
// Where the convoy is for somebody on the given level: on its level, or riding the deck at that landing.
func(r *Runtime)cargoVisiblePose(v cargoConvoyDefinition,c cargoConvoyState,level string)(cargoPose,cargoPose,float64,bool){
 if c.Level==level&&c.Phase!="away"{return c.Pose,c.TrailerPose,r.cargoFloor(level),true}
 run:=r.cargoRunOf(v,c.Run);if run==nil||c.Leg>=len(run.Legs){return cargoPose{},cargoPose{},0,false};leg:=run.Legs[c.Leg]
 if leg.Kind!="deck"||c.Phase!="away"{return cargoPose{},cargoPose{},0,false}
 d:=r.cargoDeck(leg.DeckID);if d==nil{return cargoPose{},cargoPose{},0,false};g:=r.state.LiftingDecks[d.ID];p:=g.pose(g.UpdatedNS)
 lowerDeck,_,_:=g.lowerPose(*d);upperY:=-d.DepthM*(1-float64(p.Deck)/float64(liftingDeckFull));lowerY:=d.Lower.ClearHeightM*float64(lowerDeck)/float64(liftingDeckFull)
 up2:=[2]float64{float64(d.Rect.X*2+d.Rect.W)/4,float64(d.Rect.Y*2+d.Rect.H)/4};low:=[2]float64{float64(d.Lower.Rect.X*2+d.Lower.Rect.W)/4,float64(d.Lower.Rect.Y*2+d.Lower.Rect.H)/4}
 from:=low;if leg.Level==d.LevelID{from=up2}
 at:=func(o [2]float64,y float64)(cargoPose,cargoPose,float64,bool){a,b:=c.Pose,c.TrailerPose;a.X,a.Y=a.X-from[0]+o[0],a.Y-from[1]+o[1];b.X,b.Y=b.X-from[0]+o[0],b.Y-from[1]+o[1];return a,b,r.cargoFloor(level)+y,true}
 if level==d.Lower.LevelID&&lowerDeck<liftingDeckFull&&!(leg.Level==d.LevelID&&g.LowerAway){return at(low,lowerY)}
 if level==d.LevelID&&(p.Leaves>0||p.Deck>0){return at(up2,upperY)}
 return cargoPose{},cargoPose{},0,false
}
// cargoRidersShown: the seated riders of a convoy that rides a deck in sight of the given level, by actor, at the cell
// under the tug there. Between the landings they travel (their Life trip), but the deck brings them into view with
// the convoy: they are drawn on their seats like it, not left as empty seats.
func(r *Runtime)cargoRidersShown(level string)map[string]behavior.Cell{
 if r.world.CargoConvoys==nil||r.state.CargoConvoys==nil{return nil}
 var out map[string]behavior.Cell
 for _,v:=range r.world.CargoConvoys.Convoys{
  c:=r.state.CargoConvoys.Convoys[v.ID];if c.Phase!="away"{continue}
  tug,_,_,shown:=r.cargoVisiblePose(v,c,level);if !shown{continue}
  at,ok:=r.cargoNearest(level,tug.X,tug.Y,24,func(behavior.Cell)bool{return true});if !ok{continue}
  for _,m:=range v.Crew{a:=r.state.Life.Actor(m.ID);if a==nil||a.Mount==nil||a.Mount.Vehicle!=v.ID||a.Mount.Afoot{continue};if out==nil{out=map[string]behavior.Cell{}};out[a.ID]=at}
 }
 return out
}
func(r *Runtime)appendCargoConvoys(view *pb.PocLifeView,hero *behavior.LifeActor){
 if r.world.CargoConvoys==nil||hero==nil||view==nil||r.state.CargoConvoys==nil{return};st:=r.state.CargoConvoys
 drawn:=map[string]bool{}
 for _,v:=range r.world.CargoConvoys.Convoys{
  c:=st.Convoys[v.ID];tug,trailer,y,shown:=r.cargoVisiblePose(v,c,hero.Level);if !shown{continue}
  run:=r.cargoRunOf(v,c.Run);phase:="parked";moving:=false;reverse:=false;shutter:=false
  if run!=nil&&c.Leg<len(run.Legs){leg:=run.Legs[c.Leg];phase=leg.Kind+"/"+c.Phase;reverse=leg.Reverse;moving=(leg.Kind=="drive"&&c.Phase=="go"||c.Phase=="board");shutter=(leg.Kind=="load"||leg.Kind=="unload")&&c.Phase=="work"}
  row:=&pb.PocCargoConvoy{Id:v.ID,Phase:phase,TugResource:v.Tug.Resource,TrailerResource:v.Trailer.Resource,Tug:&pb.PocCargoPose{X:tug.X,Y:y,Z:tug.Y,YawDegrees:tug.Yaw},ShutterOpen:shutter,DriverId:v.Crew[0].ID,SampleNs:c.UpdatedNS,Moving:moving,TrailerId:c.Hitched,Charging:c.Charging,Reversing:reverse}
  if c.Hitched!=""{row.Trailer=&pb.PocCargoPose{X:trailer.X,Y:y,Z:trailer.Y,YawDegrees:trailer.Yaw};row.CargoUnits=r.cargoTrailerUnits(v,c.Hitched);drawn[c.Hitched]=true
   view.CargoTrailers=append(view.CargoTrailers,&pb.PocCargoTrailer{Id:c.Hitched,Resource:v.Trailer.Resource,Pose:row.Trailer,ShutterOpen:shutter,DrawbarDown:true,Hitched:true,SampleNs:c.UpdatedNS,CargoUnits:row.CargoUnits})}
  for _,member:=range v.Crew{a:=r.state.Life.Actor(member.ID);if a==nil||a.Mount==nil||a.Mount.Vehicle!=v.ID||a.Mount.Afoot{continue};s:=v.seat(member.Seat);row.Riders=append(row.Riders,&pb.PocCargoRider{ActorId:a.ID,SeatM:[]float64{s.M[0],s.M[1],s.M[2]},Pose:s.Pose})}
  if c.Charging{for _,s:=range r.world.CargoConvoys.Stands{if s.LevelID==hero.Level{row.ChargePostM=[]float64{s.ChargePostM[0],s.ChargePostM[2],s.ChargePostM[1]}}};row.ChargeSocketM=[]float64{v.Tug.ChargeM[0],v.Tug.ChargeM[1],v.Tug.ChargeM[2]}}
  view.CargoConvoys=append(view.CargoConvoys,row)
 }
 // parked trailers and the one on a hook
 ids:=make([]string,0,len(st.Trailers));for id:=range st.Trailers{ids=append(ids,id)};sort.Strings(ids)
 for _,id:=range ids{t:=st.Trailers[id];if drawn[id]{continue}
  var v *cargoConvoyDefinition;for i:=range r.world.CargoConvoys.Convoys{for _,x:=range r.world.CargoConvoys.Convoys[i].Trailers{if x.ID==id{v=&r.world.CargoConvoys.Convoys[i]}}};if v==nil{continue}
  if t.Stand!=""{s:=r.cargoStand(t.Stand);if s==nil||s.LevelID!=hero.Level{continue};p,_:=s.bay(t.Bay);view.CargoTrailers=append(view.CargoTrailers,&pb.PocCargoTrailer{Id:id,Resource:v.Trailer.Resource,Pose:&pb.PocCargoPose{X:p.X,Y:r.cargoFloor(s.LevelID),Z:p.Y,YawDegrees:p.Yaw},SampleNs:r.state.Tick*r.tickNS(),CargoUnits:r.cargoTrailerUnits(*v,id)});continue}
  if t.Hook!=""{k:=r.cargoCrane(t.Hook);if k==nil||k.LevelID!=hero.Level{continue}
   if b,on:=r.cargoHookBay(*k,r.state.Life.Seconds);on{s:=r.cargoStand(k.StandID);p,_:=s.bay(b);view.CargoTrailers=append(view.CargoTrailers,&pb.PocCargoTrailer{Id:id,Resource:v.Trailer.Resource,Pose:&pb.PocCargoPose{X:p.X,Y:r.cargoFloor(k.LevelID),Z:p.Y,YawDegrees:p.Yaw},SampleNs:r.state.Tick*r.tickNS(),CargoUnits:r.cargoTrailerUnits(*v,id)});continue}
   cp:=r.cargoCranePoseNow(*k,r.state.Life.Seconds);mid:=(v.Trailer.BodyFrontM-v.Trailer.TailM)/2;yaw:=cp.LoadYaw*math.Pi/180
   view.CargoTrailers=append(view.CargoTrailers,&pb.PocCargoTrailer{Id:id,Resource:v.Trailer.Resource,Pose:&pb.PocCargoPose{X:cp.HoistX-math.Cos(yaw)*mid,Y:r.cargoFloor(k.LevelID)+cp.LoadZ,Z:cp.BridgeY-math.Sin(yaw)*mid,YawDegrees:cargoDeg(yaw)},OnHook:true,SampleNs:r.state.Tick*r.tickNS(),CargoUnits:r.cargoTrailerUnits(*v,id)})}
 }
 for _,k:=range r.world.CargoConvoys.Cranes{if k.LevelID!=hero.Level{continue};st2:=st.Cranes[k.ID];cp:=r.cargoCranePoseNow(k,r.state.Life.Seconds)
  view.CargoCranes=append(view.CargoCranes,&pb.PocCargoCrane{Id:k.ID,BridgeYM:cp.BridgeY,HoistXM:cp.HoistX,HookZM:cp.HookZ,ParkBridgeYM:k.Park.BridgeYM,ParkHoistXM:k.Park.HoistXM,ParkHookZM:k.Park.HookZM,LoadTrailer:st2.Hook,Moving:cp.Moving,Beacon:len(st2.Queue)>0,Move:int32(st2.Move),SampleNs:r.state.Tick*r.tickNS()})}
 for _,s:=range r.world.CargoConvoys.Stands{if s.LevelID!=hero.Level{continue}
  spec,_:=json.Marshal(s);row:=&pb.PocCargoStand{Id:s.ID,SpecJson:string(spec)}
  sod:=r.state.Life.Seconds%86400;row.LampsOn=sod>=s.LampsOn.FromSecond&&sod<s.LampsOn.ToSecond
  for _,k:=range r.world.CargoConvoys.Cranes{if k.StandID==s.ID&&len(st.Cranes[k.ID].Queue)>0{row.LampsOn=true}}
