// Code generated by ANG. Explicit first aid follows the ordinary command wire.
package poc

import (
	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"reflect"
	"testing"
)

// Existing people/equipment and an explicit test weapon balance are arranged.
// Accepted kernel actions + the real atomic host commit cause all injuries and
// surrender. This tests execution/first aid, not the NPC's utility choice.
func combatPlayerCareInjury(t *testing.T, stun bool) (*Runtime, *connection, string) {
	t.Helper()
	r, c, target := combatLifeFixture(t, true)
	combatPhysicalFixture(t, r, target, false)
	r.world.CombatLife.Responders = map[string]combatResponder{}
	w := r.world.CombatRuntime.Weapons[combatFixtureBlade]
	w.Damage = 4
	w.Bleed = 4
	if stun {
		w.Kind = "blunt"
		w.Damage = 80
		w.HeavyAP = 4
		w.HeavyDamagePercent = 100
		w.Bleed = 0
	}
	r.world.CombatRuntime.Weapons[combatFixtureBlade] = w
	combatStart(t, r, c, target)
	apply := func(id string, action behavior.CombatAction) {
		t.Helper()
		candidate := r.state.Combat.Clone()
		if err := candidate.Execute(r.combatSpace(candidate), r.world.CombatRuntime.Rules, id, action); err != nil {
			t.Fatal(err)
		}
		if err := r.commitCombat(candidate); err != nil {
			t.Fatal(err)
		}
	}
	apply(playerActorID, behavior.CombatAction{Type: "end"})
	if r.state.Combat.Current() == nil || r.state.Combat.Current().ID != target {
		t.Fatal("actual initiative did not reach opponent")
	}
	strike := behavior.CombatAction{Type: "attack", TargetID: playerActorID}
	if stun {
		strike.Mode = "heavy"
		strike.BodyPart = "head"
	}
	apply(target, strike)
	hero := r.state.Combat.Actor(playerActorID)
	if hero.HP >= hero.MaxHP || hero.HP <= 0 || stun && hero.StunTurns == 0 || !stun && hero.Bleeding == 0 {
		t.Fatalf("real strike failed to cause expected surviving injury: %+v", hero)
	}
	apply(target, behavior.CombatAction{Type: "surrender"})
	if r.state.Combat.Active || r.state.Combat.Winner != "player" {
		t.Fatal("real opponent surrender did not end combat")
	}
	return r, c, target
}
func TestCombatPlayerCareWireBandageHealTimeAndReplay(t *testing.T) {
	r, c, _ := combatPlayerCareInjury(t, false)
	old := r.state.CombatRoster[playerActorID]
	seconds := r.state.Life.Seconds
	count := r.combatCount(r.state.Inventory, playerActorID, "item.med_patch", nil)
	q := &pb.PocCombatCommand{RequestId: "care.player.bandage", Action: "bandage", ExpectedTurn: r.state.Combat.Turn}
	result, view := combatWire(t, r, c, q)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	after := r.state.CombatRoster[playerActorID]
	if after.HP != old.HP || after.Bleeding != max(0, old.Bleeding-r.world.CombatRuntime.Rules.BandageAmount) || r.state.Life.Seconds != seconds+r.world.CombatRuntime.CareActionSeconds || r.combatCount(r.state.Inventory, playerActorID, "item.med_patch", nil) != count-1 {
		t.Fatal("outside bandage was free, healed HP, or did not stop real bleeding")
	}
	if view == nil || view.PlayerCondition == nil || int(view.PlayerCondition.Hp) != after.HP || int(view.PlayerCondition.Bleeding) != after.Bleeding {
		t.Fatal("outside player condition did not publish current health")
	}
	items := r.state.Inventory.Clone()
	clock := r.state.Life.Seconds
	result, _ = combatWire(t, r, c, q)
	if !result.Ok || !reflect.DeepEqual(items, r.state.Inventory) || clock != r.state.Life.Seconds {
		t.Fatal("replayed first aid consumed materials/time twice")
	}
	result, _ = combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "care.player.heal", Action: "heal", ExpectedTurn: r.state.Combat.Turn})
	if !result.Ok {
		t.Fatal(result.Message)
	}
	healed := r.state.CombatRoster[playerActorID]
	if healed.HP != min(old.MaxHP, after.HP+r.world.CombatRuntime.Rules.HealAmount) || r.state.Life.Seconds != clock+r.world.CombatRuntime.CareActionSeconds || r.combatCount(r.state.Inventory, playerActorID, "item.med_patch", nil) != count-2 {
		t.Fatal("outside explicit healing bypassed physical materials or time")
	}
}
func TestCombatPlayerCareRejectsPauseMovementAndRealStunAtomically(t *testing.T) {
	for _, kind := range []string{"paused", "moving", "stunned"} {
		t.Run(kind, func(t *testing.T) {
			r, c, _ := combatPlayerCareInjury(t, kind == "stunned")
			if kind == "paused" {
				r.state.Paused = true
			}
			if kind == "moving" {
				hero := r.state.Life.Actor(playerActorID)
				model := r.state.Life.GateModel(r.world.Life)
				blocked := r.state.Life.BlockedCells(hero.Level, hero.ID)
				chosen := false
				for _, goal := range model.StepNeighbours(hero.Level, hero.Position) {
					if !model.Walks(hero.Level, goal) || blocked[goal] {
						continue
					}
					r.lifeMove(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: 17, X: int32(goal.X), Y: int32(goal.Y)})
					for len(c.out) > 0 {
						<-c.out
					}
					if len(r.state.Life.Actor(playerActorID).Path) > 0 || r.state.Life.Actor(playerActorID).Body != nil && r.state.Life.Actor(playerActorID).Body.Moving {
						chosen = true
						break
					}
				}
				if !chosen {
					t.Fatal("real Life route did not enter movement")
				}
			}
			if kind == "stunned" && !r.state.Life.Actor(playerActorID).CombatHold {
				t.Fatal("real heavy head blow did not pin player body")
			}
			before := r.snapshotState()
			result, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "care.player.reject." + kind, Action: "heal", ExpectedTurn: r.state.Combat.Turn})
			if result.Ok || !reflect.DeepEqual(before.Inventory, r.state.Inventory) || !reflect.DeepEqual(before.CombatRoster, r.state.CombatRoster) || before.Life.Seconds != r.state.Life.Seconds || !reflect.DeepEqual(before.CombatCare, r.state.CombatCare) {
				t.Fatal("rejected outside aid committed physical/health/time changes")
			}
		})
	}
}
