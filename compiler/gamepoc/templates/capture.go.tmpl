 for _,m:=range r.squadMembers(){if m.ID==exclude{continue};a:=r.sceneActor(m.ID);at:=cell(a.Position);distance:=behavior.Distance(at,cell(center));if a.Task=="escorting"&&len(a.Path)==0&&a.Position==a.Goal&&distance>=1&&distance<=2&&!future[at]{settled[a.ID]=true;reserved[at]=true;space.Blocked[at]=true}}
 for _,m:=range r.squadMembers(){if m.ID==exclude||settled[m.ID]{continue};a:=r.sceneActor(m.ID);best:=int(^uint(0)>>1);var goal behavior.Cell;found:=false
  for y:=center.Y-2;y<=center.Y+2;y++{for x:=center.X-2;x<=center.X+2;x++{p:=behavior.Cell{X:x,Y:y};distance:=behavior.Distance(p,cell(center));if distance<1||distance>2||reserved[p]||!space.CanStand(p){continue};route:=space.Path(cell(a.Position),p,cell(center),0);if cell(a.Position)!=p&&len(route)==0{continue};cost:=len(route)*4+distance;if a.Task=="escorting"&&p==cell(a.Goal){cost-=3};if future[p]{cost+=1000};if cost<best{best=cost;goal=p;found=true}}}
  if !found{continue};reserved[goal]=true;space.Blocked[goal]=true;r.applySocialOrder(a,behavior.Order{ActorID:a.ID,Goal:goal,Mode:"escorting"},cell(center))
