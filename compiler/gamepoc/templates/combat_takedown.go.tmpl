// Code generated by ANG. A held blade from behind, started out of stealth (moment 2, design/combat-play/moments). One rule for whoever does it:
// the attacker is any actor, the target's own senses decide. The encounter is opened inside the same command, so no ordinary fight comes first;
// everything after that (AP, wound, reaction, witnesses, Ledger, justice) is the ordinary executor.
package poc

import (
	"angelsdemons/server/internal/behavior"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"math"
	"sort"
)

type combatTakedownIntent struct {
	Target    string `json:"target"`
	Technique string `json:"technique"`
}

// The direction a body is known to face: a stealth observer's own orientation; the hero's last real motion. No guess for anyone else.
func (r *Runtime) actorFace(id string) (float64, float64, bool) {
	if o, ok := r.state.Stealth.Observers[id]; ok {
		return o.FaceX, o.FaceY, o.FaceX != 0 || o.FaceY != 0
	}
	if id == playerActorID && (r.state.Stealth.HeroFaceX != 0 || r.state.Stealth.HeroFaceY != 0) {
		return r.state.Stealth.HeroFaceX, r.state.Stealth.HeroFaceY, true
	}
	return 0, 0, false
}

// takedownCheck: why this attacker cannot start this technique on this target now (nil — he can). The senses are the stealth ones, unchanged:
// a person within near_mm is always noticed; the field of view is cone_cos; the hero's own observers remember what they recognised.
func (r *Runtime) takedownCheck(attackerID, targetID, mode string) error {
	t, known := r.world.CombatRuntime.Rules.Techniques[mode]
	a, b := r.state.Life.Actor(attackerID), r.state.Life.Actor(targetID)
	if !known || r.state.Combat.Active || r.state.Paused || a == nil || b == nil || a.ID == b.ID || !a.OnFloor() || !b.OnFloor() || a.Level != b.Level || a.CombatHold || b.CombatHold || !r.combatWorldConscious(attackerID) || !r.combatWorldConscious(targetID) {
		return textError{Key: "error.takedown.unavailable"}
	}
	if _, w, ok := r.equippedCombatItem(r.state.Inventory, attackerID); !ok || behavior.CombatWeaponKind(w) != t.WeaponKind {
		return textError{Key: "error.takedown.weapon"}
	}
	fx, fy, facing := r.actorFace(targetID)
	if !facing {
		return textError{Key: "error.takedown.unavailable"}
	}
	if o, watched := r.state.Stealth.Observers[targetID]; watched && attackerID == playerActorID && (o.Contact.Visible || o.Contact.HasSeen) {
		return textError{Key: "error.takedown.noticed"}
	}
	dist := r.combatWorldDistance(a.Level, b.Position, a.Position)
	if dist > t.ReachMM {
		return textError{Key: "error.takedown.reach"}
	}
	if !r.combatSight(a.Level, a.Position, b.Position) {
		return textError{Key: "error.takedown.reach"}
	}
	if dist <= r.world.Stealth.NearMM {
		return textError{Key: "error.takedown.near"}
	}
	ax, ay := r.stealthPlan(a.Level, a.Position)
	bx, by := r.stealthPlan(b.Level, b.Position)
	dx, dy := ax-bx, ay-by
	norm := math.Hypot(dx, dy) * math.Hypot(fx, fy)
	if norm == 0 || (dx*fx+dy*fy)/norm >= r.world.Stealth.ConeCos {
		return textError{Key: "error.takedown.noticed"}
	}
	if (dx*fx+dy*fy)/norm >= -.5 {
		return textError{Key: "error.takedown.rear"}
	}
	return nil
}

// startTakedown opens the encounter and runs the technique as its first action, inside one command. A refused action changes nothing.
func (r *Runtime) startTakedown(attackerID, targetID, mode string) error {
	if err := r.takedownCheck(attackerID, targetID, mode); err != nil {
		return err
	}
	t := r.world.CombatRuntime.Rules.Techniques[mode]
	trial := &Runtime{world: r.world, state: r.snapshotState(), npcAccountIDs: r.npcAccountIDs}
	teamA, teamB := "aggressor", "defender"
	if attackerID == playerActorID {
		teamA, teamB = "player", "opposition"
	}
	if err := trial.openCombat(attackerID, targetID, teamA, teamB); err != nil {
		return err
	}
	s := &trial.state.Combat
	for i := range s.Actors {
		if s.Actors[i].ID == attackerID {
			s.CurrentIndex = i
		}
	}
	if fx, fy, ok := r.actorFace(targetID); ok {
		s.Actor(targetID).Facing = behavior.Cell{X: int(math.Round(fx * 1000)), Y: int(math.Round(fy * 1000))}
	}
	action := behavior.CombatAction{Type: "attack", TargetID: targetID, Mode: mode, BodyPart: t.BodyPart, Unnoticed: true}
	if err := trial.performCombatAction(attackerID, &action); err != nil {
		return textError{Key: "error.takedown.unavailable"}
	}
	trial.syncCombatLife()
	if err := trial.advanceCombatAI(); err != nil {
		return err
	}
	r.state = trial.state
	return nil
}

// Authored NPC intentions (world.combat_life.takedowns). The same check and the same command as the hero's.
func (r *Runtime) combatLifeTakedowns() error {
	ids := make([]string, 0, len(r.world.CombatLife.Takedowns))
	for id := range r.world.CombatLife.Takedowns {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	for _, id := range ids {
		intent := r.world.CombatLife.Takedowns[id]
		if r.takedownCheck(id, intent.Target, intent.Technique) == nil {
			return r.startTakedown(id, intent.Target, intent.Technique)
		}
	}
	return nil
}

// «Interrupted» from outside: someone conscious within break_reach who sees the holder and would stop him (a fighter of the other side, a responder
// who protects the victim, or a person hostile to the holder). Positions are the ordinary ones: nobody is teleported to do it.
func (r *Runtime) takedownBreaker(s *behavior.CombatState, holder, target string, t behavior.CombatTechnique) string {
	h := s.Actor(holder)
	if h == nil || t.BreakReachMM < 1 {
		return ""
	}
	ids := make([]string, 0, len(r.state.Life.Actors))
	for _, a := range r.state.Life.Actors {
		ids = append(ids, a.ID)
	}
	sort.Strings(ids)
	for _, id := range ids {
		a := r.state.Life.Actor(id)
		if id == holder || id == target || !a.OnFloor() || a.Level != s.LevelID || !r.combatWorldConscious(id) {
			continue
		}
		if r.combatWorldDistance(s.LevelID, a.Position, h.Position) > t.BreakReachMM || !r.combatWorldVisible(combatLifeObserver{ID: id, Level: a.Level, At: a.Position}, h.Position) {
			continue
		}
		role, responder := r.world.CombatLife.Responders[id]
		if responder && r.combatResponderProtects(role, target, s.LevelID) || r.state.Life.RelationTo(r.world.Life, id, holder) <= r.world.CombatLife.HostileAtOrBelow {
			return id
		}
	}
	return ""
}

// The end of the hold. Completed: the body is lowered to the floor where it stood (the fall strip checked; no strip — the compact collapse).
// Interrupted: the wound stays, the vessel's own clock and the ordinary stop-fight reaction take over: he is alive and dangerous.
func (r *Runtime) endHold(s *behavior.CombatState, holder, target string, t behavior.CombatTechnique, completed bool) {
	b := s.Actor(target)
	if b == nil || len(b.Body) == 0 {
		return
	}
	if a := s.Actor(holder); a != nil {
		a.Position = r.holdEndCell(*s, *a, *b)
	}
	if !completed {
		body := combatBody(*b)
		combatWounds.ReleaseHold(&body)
		projectWoundBody(b, body)
		b.FightResponse = ""
		r.stopWoundedFight(s, b)
		r.shiftWoundedFall(s, b)
		return
	}
	b.FightResponse = "fall"
	if b.FallShifted {
		return
	}
	dir := behavior.Cell{X: 0, Y: 1}
	if b.Facing.X != 0 || b.Facing.Y != 0 {
		angle := math.Round(math.Atan2(float64(b.Facing.Y), float64(b.Facing.X))/(math.Pi/4)) * (math.Pi / 4)
		dir = behavior.Cell{X: int(math.Round(math.Cos(angle))), Y: int(math.Round(math.Sin(angle)))}
	}
	style := t.FallStyle
	if !r.fallStripClear(*s, *b, dir, r.world.CombatSpacing.FallLengthMM, r.world.CombatSpacing.FallWidthMM) {
		style = "knees"
	}
	b.FallShifted, b.FallStyle, b.FallDirection = true, style, dir
	s.EventSeq++
	s.Events = append(s.Events, behavior.CombatEvent{Type: "fall_shift", Mode: style, ActorID: b.ID, TargetID: b.ID, From: b.Position, To: b.Position, Turn: s.Turn, Sequence: s.EventSeq, Reason: "lowered where he stood"})
}

// Where the holder stands when it is over: the cell on his line of approach nearest to the victim at a body's distance (world.combat_spacing). He did not teleport:
// the closing step and the steps back are the presentation of this one cell change, like a roll. Nothing free on the line: he stays where he started.
func (r *Runtime) holdEndCell(s behavior.CombatState, a, b behavior.Combatant) behavior.Cell {
	space := r.combatSpace(s)
	best := a.Position
	dx, dy := b.Position.X-a.Position.X, b.Position.Y-a.Position.Y
	steps := max(max(dx, -dx), max(dy, -dy))
	for n := 1; n < steps; n++ {
		at := behavior.Cell{X: a.Position.X + int(math.Round(float64(dx*n)/float64(steps))), Y: a.Position.Y + int(math.Round(float64(dy*n)/float64(steps)))}
		if space.Space.Blocked[at] || space.Space.Walkable != nil && !space.Space.Walkable(at) || space.Space.Occupied != nil && space.Space.Occupied(at) || r.combatDistance(at, b.Position) < r.world.CombatSpacing.BodyMM {
			break
		}
		best = at
	}
	return best
}

// What the hero may start right now, in words: the nearest target he could reach within an offer distance, enabled or with the reason.
func (r *Runtime) appendTakedownOptions(msg *pb.PocGameState, locale string) {
	if r.state.Combat.Active || !r.state.Life.Enabled || len(r.world.CombatRuntime.Rules.Techniques) == 0 || len(r.world.Stealth.Watchers) == 0 {
		return
	}
	h := r.state.Life.Actor(playerActorID)
	if h == nil || !h.OnFloor() || h.CombatHold {
		return
	}
	if _, _, armed := r.equippedCombatItem(r.state.Inventory, playerActorID); !armed {
		return
	}
	locale = r.validLocale(locale)
	modes := make([]string, 0, len(r.world.CombatRuntime.Rules.Techniques))
	for mode := range r.world.CombatRuntime.Rules.Techniques {
		modes = append(modes, mode)
	}
	sort.Strings(modes)
	targets := make([]string, 0, len(r.world.Stealth.Watchers))
	for id := range r.world.Stealth.Watchers {
		targets = append(targets, id)
	}
	sort.Strings(targets)
	for _, mode := range modes {
		t := r.world.CombatRuntime.Rules.Techniques[mode]
		for _, id := range targets {
			b := r.state.Life.Actor(id)
			if b == nil || !b.OnFloor() || b.Level != h.Level || r.combatWorldDistance(h.Level, h.Position, b.Position) > t.ReachMM+r.world.CombatLife.TakedownOfferMM || !r.combatWorldConscious(id) {
				continue
			}
			o := &pb.PocCombatOption{Id: "takedown." + mode + "." + id, Action: "takedown", TargetId: id, Mode: mode, Ap: int32(t.AP), Group: "stealth", Label: r.localText(locale, "wounds.technique."+mode, mode)}
			if err := r.takedownCheck(playerActorID, id, mode); err == nil {
				o.Enabled = true
			} else if refusal, ok := err.(textError); ok {
				o.Reason = r.localText(locale, refusal.Key, refusal.Key)
			}
			msg.Takedowns = append(msg.Takedowns, o)
		}
	}
}
