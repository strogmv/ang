// StartWithPopulation enables an explicit population scenario. Count zero keeps
// the ordinary life state byte-for-byte compatible in its existing fields.
func(m LifeModel)StartWithPopulation(count int,observerID string)(LifeState,error){
 if err:=m.Validate();err!=nil{return LifeState{},err}
 s:=m.Start();if count==0{return s,nil}
 observer:=s.Actor(observerID);if observer==nil{return LifeState{},fmt.Errorf("population observer missing")};s.ControlledActorID=observerID
 p,err:=m.Population.Start(m,count,s.Seconds,s.Tick);if err!=nil{return LifeState{},err};s.Population=p
 if err=s.AdvancePopulation(m,observerID);err!=nil{return LifeState{},err}
 if err=s.Validate(m,s.Tick);err!=nil{return LifeState{},err};return s,nil
}
// BlockedCells includes both persistent named actors and materialized crowd
