   if(barkLive.Count>64){var gone=new List<ulong>();foreach(var k in barkLive.Keys)if(!alive.Contains(k))gone.Add(k);foreach(var k in gone)barkLive.Remove(k);}
  }
  // The hero's thought (he saw through a lie): drawn low in the middle of the band, never over the enemy.
  void DrawBarkThought(PocBark b,BarkLive live,float t,float total,float life,float em,float lineH,float scale,Func<Vector2,Vector2> px){
   if(string.IsNullOrEmpty(b.Text)||string.IsNullOrEmpty(b.Face)||t>life)return;
   if(live.body==null){try{live.body=BarkLay(b.Text,b.Face,b.Reveal,b.RevealMs,b.Serial,BarkEM);}catch(Exception){live.skipped=true;return;}}
