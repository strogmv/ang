// Code generated by ANG. Crafting interlocks and wounds commit with the shot.
package poc

import (
	"angelsdemons/server/internal/behavior"
 "angelsdemons/server/internal/wounds"
	crafting "angelsdemons/server/internal/crafting"
	inv "angelsdemons/server/internal/inventory"
	"errors"
	"sort"
	"strconv"
)

type combatHolderInjury struct {
	Damage   int    `json:"damage"`
	Bleed    int    `json:"bleed"`
	BodyPart string `json:"body_part"`
}

// A condition watermark consumes the existing deterministic crafting outcome
// exactly once. Neither a later Life frame nor a save/load repeats a shot roll.
func (r *Runtime) craftingUseRisk(id string, shot bool) (string, error) {
	h, hacked := r.state.Crafting.Law.Hacked[id]
	i, ok := r.state.Inventory.Items[id]
	if !hacked || !ok || h.Jammed {
		return "", nil
	}
	if !shot && i.Condition >= h.Condition {
		h.Condition = i.Condition
		r.state.Crafting.Law.Hacked[id] = h
		return "", nil
	}
	h.Uses++
	h.Condition = i.Condition
	policy := r.world.Crafting.Law.Rebind
	dice := int64(craftingRoll(r.state.Seed, id+":use:"+strconv.FormatInt(h.Uses, 10)) % 1000)
	outcome := ""
	if dice < policy.MisfirePermille {
		if _, err := r.state.Inventory.Transform(r.inventoryModelFor(true), inv.Transform{Restore: []inv.Restore{{Item: id, Condition: 0}}}); err != nil {
			return "", err
		}
		h.Jammed = true
		h.Condition = 0
		outcome = "misfire"
	} else if dice < policy.MisfirePermille+policy.InjurePermille {
		outcome = "injured"
	}
	r.state.Crafting.Law.Hacked[id] = h
	if outcome != "" {
		r.state.Crafting.Notice = crafting.Notice{Key: "crafting.notice." + outcome, Detail: i.Definition, Second: r.state.Life.Seconds}
	}
	return outcome, nil
}

func (r *Runtime) combatItemHolder(id string) string {
	i, ok := r.state.Inventory.Items[id]
	if !ok {
		return ""
	}
	at := i.Location
	for depth := 0; depth <= r.world.Inventory.MaxDepth && at.Kind == "store"; depth++ {
		st, ok := r.state.Inventory.Stores[at.Store]
		if !ok {
			return ""
		}
		if st.Anchor.Kind == "actor" {
			return st.Anchor.Actor
		}
		if st.Anchor.Kind != "item" {
			return ""
		}
		parent, ok := r.state.Inventory.Items[st.Anchor.Item]
		if !ok {
			return ""
		}
		at = parent.Location
	}
	return ""
}

func (r *Runtime) combatCraftingUse(item, holder string, inEncounter bool) error {
	outcome, err := r.craftingUseRisk(item, inEncounter)
	if err != nil || outcome != "injured" {
		return err
	}
	i := r.state.Inventory.Items[item]

	c := r.combatant(holder, "bystander")
	active := inEncounter && r.state.Combat.Actor(holder) != nil
	if active {
		c = cloneCombatant(*r.state.Combat.Actor(holder))
	} else {
		_, at, present := r.knownCombatLifeActor(holder)
		if !present {
			return errors.New("wounded holder has no physical body")
		}
		c.Position = at
	}
	// A needle released inside the grip punctures the hand beneath outer armour.
	// Use the same part wounds, bleeding and morale calculation as other impacts.

 b:=combatBody(c)
 result,err:=combatWounds.ApplyHit(&b,wounds.Hit{Author:holder,Weapon:i.Definition,Zone:"arm",Angle:"front",Skill:int64(c.Skill),Seed:r.state.Seed+int64(r.state.Combat.EventSeq)})
 if err!=nil{return err};projectWoundBody(&c,b);damage:=0;if result.Wound!=nil{damage=1}
 r.recordWoundEvents(result.Events)

	if !active {
		r.storeAmbientCombatCasualty(c)
		r.combatCareHold(c)
	}
	// Even a shot that ends the encounter must retain its holder's final wound.
	if active {
		*r.state.Combat.Actor(holder) = c
		s := &r.state.Combat
		s.EventSeq++
		s.Events = append(s.Events, behavior.CombatEvent{Type: "weapon_injury", ActorID: holder, TargetID: holder, ItemID: item, From: c.Position, To: c.Position, BodyPart: "arms", Amount: damage, Hit: damage > 0, Turn: s.Turn, Sequence: s.EventSeq})
	}
	return nil
}

// Only declared guards who can identify the shooter can report this act.
// Hearing through a wall alone conveys no chip identity or hacking knowledge.
func (r *Runtime) combatShotGuards(before behavior.CombatState, e behavior.CombatEvent) []string {
	shooter := before.Actor(e.ActorID)
	if shooter == nil {
		return nil
	}
	source := cloneCombatant(*shooter)
	source.Position = e.From
	space := r.combatSpace(before)
	var guards []string
	for _, id := range r.world.Crafting.Law.Rebind.Guards {
		if id == e.ActorID {
			continue
		}
		level, at, present := r.knownCombatLifeActor(id)
		if !present || level != before.LevelID {
			continue
		}
		guard := r.combatant(id, "guard")
		guard.Position = at
		if a := before.Actor(id); a != nil {
			guard = cloneCombatant(*a)
		}
		if id == e.TargetID {
			guard.Position = e.To
		}
		if !guard.Able() || guard.StunTurns > 0 || r.combatWorldDistance(level, e.From, guard.Position) > r.world.Crafting.Law.WitnessCells*space.CellMM || r.combatWorldDistance(level, e.From, guard.Position) > r.world.CombatRuntime.Rules.HearingRangeMM || !space.ActorVisible(guard, source, r.world.CombatRuntime.Rules) {
			continue
		}
		guards = append(guards, id)
	}
	sort.Strings(guards)
	return guards
}
