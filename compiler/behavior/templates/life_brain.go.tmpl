// SeatedPlace is the model place of a seated meal (host: purchase rules and presentation spots).
func(m LifeBrainModel)SeatedPlace(id string)(LifeAffordance,bool){return m.seating(id)}
// SeatPresentation: what an observer sees of a seated meal — the spot, "queue" / "sit" / "rise" and since when (game s).
func(b LifeBrain)SeatPresentation(m LifeBrainModel,level string,at Cell)(LifeSpot,string,int64,bool){
 if b.Seat==""||b.Place.Kind!="seated_food"{return LifeSpot{},"",0,false}
 p,ok:=m.seating(b.Place.ID);if !ok||p.Level!=level{return LifeSpot{},"",0,false};x,ok:=p.Seating.spot(b.Seat);if !ok||x.At!=at{return LifeSpot{},"",0,false}
 if b.SeatQueue{return x,"queue",b.QueueSince,true}
 if b.RiseAt>0{return x,"rise",b.RiseAt,true}
 if b.SeatedAt>0{return x,"sit",b.SeatedAt,true}
 return LifeSpot{},"",0,false
}
func(b LifeBrain)alternatives()[3]string{var a [3]string;n:=0;for _,g:=range b.Goal.Top{if g.ID==b.Goal.GoalID{continue};a[n]=fmt.Sprintf("%s=%.3f",g.ID,g.Score);n++;if n==len(a){break}};return a}
func(b LifeBrain)reason()string{return fmt.Sprintf("utility.%s=%.3f; hold=%d",b.Goal.GoalID,b.Goal.Score,b.Goal.HoldUntil)}
func(m LifeModel)namedHome(person *LifePerson)LifeStep{for _,s:=range person.Steps{if s.Activity=="sleep"{return s}};for _,p:=range m.Brain.Places{if p.Kind=="sleep"{at:=p.At;if len(p.Slots)>0{at=p.Slots[CounterRandom(0,person.ID,0,"life.home.fallback.v1")%uint64(len(p.Slots))]};return LifeStep{Level:p.Level,At:at,Activity:"sleep",Label:"life.npc.sleep"}}};return LifeStep{}}
func(m LifeModel)namedSchedule(p *LifePerson,seconds int64)(int,int64){index:=len(p.Steps)-1;day:=seconds/86400;found:=false;for i,s:=range p.Steps{if s.AtMinute<=seconds%86400/60{index=i;found=true}};if !found{day--};return index,day}

// A named NPC commits to the first edge of its current trip by expected arrival
// in game seconds: walk to the exit, the real next departure (night cadence),
// the visible boarding queue in whole trains, the ride and the static remainder.
// The leg is re-checked at most once per brainLegRecheck and replaced only by a
// clearly earlier alternative (brainLegMargin), never once boarding is committed.
const brainLegRecheck,brainLegMargin=int64(60),int64(120)
// Visible queue: bodies on the platform level heading for its gate or pockets.
func(s *LifeState)edgeQueue(e LifeEdge,self string)int{
 n:=0;waiting:=func(level string,goal Cell)bool{if level!=e.From{return false};if goal==e.Exit{return true};for _,at:=range e.WaitingCells{if at==goal{return true}};return false}
 for _,a:=range s.Actors{if a.ID!=self&&a.Trip==nil&&a.OnFloor()&&waiting(a.Level,a.Goal){n++}}
 for _,a:=range s.Population.Actors{if a.ID!=self&&a.Materialized&&a.Trip==nil&&waiting(a.Level,a.Goal){n++}}
 return n
}
func(s *LifeState)brainLegCost(m LifeModel,a *LifeActor,e LifeEdge,goal string)(int64,bool){
 if e.To==a.Level{return 0,false};_,rest,ok:=m.routePlan(e.To,goal,a.Level);if !ok{return 0,false}
 walk:=s.StaticTravelSeconds(m,a.Level,a.Position,e.Exit);if walk<0{return 0,false}
 wait:=int64(0);if e.PeriodSeconds>0{t:=s.Seconds+walk;d:=e.NextDeparture(t);wait=d-t;if e.Seats>0{wait+=int64(s.edgeQueue(e,a.ID)/e.Seats)*(e.NextDeparture(d+1)-d)}}
 return walk+wait+e.TravelSeconds+rest,true
}
func(s *LifeState)brainLegEdge(m LifeModel,a *LifeActor,goal string)*LifeEdge{
 b:=&a.Brain;var current *LifeEdge
 if b.LegFrom==a.Level&&b.LegTo==goal{if e:=m.Edge(b.LegEdge);e!=nil&&e.From==a.Level{current=e}}
 if current!=nil&&(a.WaitingDeparture>0&&a.Goal==current.Exit||s.Seconds<b.LegCheck){return current}
 var best *LifeEdge;bestCost:=int64(1<<62)
 for i:=range m.Edges{e:=&m.Edges[i];if e.From!=a.Level{continue};if cost,ok:=s.brainLegCost(m,a,*e,goal);ok&&cost<bestCost{best,bestCost=e,cost}}
 if current!=nil{if cost,ok:=s.brainLegCost(m,a,*current,goal);ok&&cost<=bestCost+brainLegMargin{best=current}}
 if best==nil{b.LegEdge,b.LegFrom,b.LegTo,b.LegCheck="","","",0;return m.NextEdge(a.Level,goal)}
 // A stale timetable choice of another edge must not delay the new leg.
 if current!=nil&&current.ID!=best.ID{a.WaitingDeparture=0}
 b.LegEdge,b.LegFrom,b.LegTo,b.LegCheck=best.ID,a.Level,goal,s.Seconds+brainLegRecheck
 return best
}
