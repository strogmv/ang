   if(pick==null&&(me.HeldItem=="unarmed"||string.IsNullOrEmpty(me.HeldItem))){pick=CombatAutoOption("equip.");why="ready the weapon from the bag";}
   if(pick==null&&gun&&me.Ammo<1){pick=CombatAutoOption("reload");why="load the clip";}
   if(pick==null&&Time.unscaledTime-combatAutoFightAt<50f){pick=CombatAutoOption("aid_continue");if(pick!=null)why="continue the work on the same wound";}
