func TestSanitaryCrossServiceAndCommands(t *testing.T) {
	r, u := sanitaryFixture(t, "shower")
	sanitaryUsing(t, r, u)
	serial := r.state.Sanitary.Serial
	if err := r.sanitaryRequest(playerActorID, u.ID); err != nil || serial != r.state.Sanitary.Serial {
		t.Fatal("request not idempotent")
	}
	if err := r.medicalRequest(playerActorID, r.world.MedicalCapsules.Units[0].ID); err == nil {
		t.Fatal("medical stole sanitary user")
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "travel", Destination: "level.poc_housing"}); err == nil {
		t.Fatal("ordinary command stole attachment")
	}
	if err := r.sanitaryCommand(&pb.PocLifeCommand{Action: "sanitary_cancel"}); err != nil {
		t.Fatal(err)
	}
	if r.state.Sanitary.Users[playerActorID].Phase != "opening_exit" {
		t.Fatal("cancel teleported out")
	}
}

func TestSanitaryFIFOBlockedExitAndSaveValidation(t *testing.T) {
	r, u := sanitaryFixture(t, "shower")
	sanitaryUsing(t, r, u)
	ids := []string{"char.market_granny", "char.market_resident_01"}
	for i, id := range ids {
		a := r.state.Life.Actor(id)
		if a == nil {
			t.Fatal("missing real NPC")
		}
		a.Trip = nil
		a.ResidenceID = ""
		a.Level = u.LevelID
		a.Position = behavior.Cell{X: 12 + i, Y: 41}
		a.Goal = a.Position
		a.Path = nil
		a.PendingPath = nil
		a.Body = nil
		a.Manual = false
		a.CombatHold = false
		if err := r.sanitaryRequest(id, u.ID); err != nil {
			t.Fatal(err)
		}
	}
	for _, id := range ids {
		if r.state.Sanitary.Users[id].Phase != "queued" {
			t.Fatal("queue stole occupied unit")
		}
	}
	if err := r.validateSanitary(r.state); err != nil {
		t.Fatal(err)
	}
	before := r.snapshotState()
	bad := r.snapshotState()
	p := bad.Sanitary.Users[ids[0]]
	p.Phase = "using"
	bad.Sanitary.Users[ids[0]] = p
	if r.validateSanitary(bad) == nil {
		t.Fatal("duplicate occupancy accepted")
	}
	if !reflect.DeepEqual(before.Sanitary, r.state.Sanitary) {
		t.Fatal("snapshot aliases state")
	}
	blocker := r.state.Life.Actor(ids[1])
	blocker.Position = u.EntryCell
	blocker.Goal = blocker.Position
	sanitaryAdvance(t, r, 180)
	sanitaryAdvance(t, r, 1)
	if !r.state.Sanitary.Users[playerActorID].ExitBlocked || r.state.Life.Actor(playerActorID).OnFloor() {
		t.Fatal("blocked exit teleported")
	}
	blocker.Position = behavior.Cell{X: 13, Y: 41}
	blocker.Goal = blocker.Position
	sanitaryAdvance(t, r, 1)
	sanitaryAdvance(t, r, 2)
	sanitaryAdvance(t, r, 1)
	if r.state.Sanitary.Users[ids[1]].Phase != "queued" {
		t.Fatal("FIFO overtaken")
	}
	if r.state.Sanitary.Users[ids[0]].Phase != "queued" {
		t.Fatal("occupied return anchor should retain FIFO waiting")
	}
	hero := r.state.Life.Actor(playerActorID)
	hero.Position = behavior.Cell{X: 12, Y: 43}
	hero.Goal = hero.Position
	sanitaryAdvance(t, r, 1)
	if p := r.state.Sanitary.Users[ids[0]]; p.Phase != "approach" {
		t.Fatalf("first queue not admitted: %+v", p)
	}
}
func TestSanitaryPhysicalHeroApproachAndUnloadedNPC(t *testing.T) {
	r, u := sanitaryFixture(t, "basin")
	var original worldData
	if err := json.Unmarshal(compiledJSON, &original); err != nil {
		t.Fatal(err)
	}
	r.world.Life.HeroBody = original.Life.HeroBody
	r.canonicalWorld.Life.HeroBody = original.Life.HeroBody
	hero := r.state.Life.Actor(playerActorID)
	hero.Position = behavior.Cell{X: r.world.SanitaryServices.CommonEntryCell.X + 1, Y: r.world.SanitaryServices.CommonEntryCell.Y}
	hero.Goal = hero.Position
	r.state.Life.EnsureHeroBody(r.world.Life)
	if hero.Body == nil {
		t.Fatal("missing real body")
	}
	if err := r.sanitaryRequest(playerActorID, u.ID); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 500 && r.state.Sanitary.Users[playerActorID].Phase != "using"; i++ {
		r.state.Tick++
		r.state.Inventory.Advance(r.state.Tick)
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	if !r.sanitaryAttached(playerActorID) || r.state.Sanitary.Users[playerActorID].Phase != "using" || hero.Position != u.EntryCell {
		t.Fatal("hero did not physically arrive")
	}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave(slot); err != nil {
		t.Fatal(err)
	}
	// Real named NPC, normal existing hygiene goal; no NPC command or visual double.
	id := "char.market_granny"
	npc := r.state.Life.Actor(id)
	v := r.world.SanitaryServices.Units[5]
	npc.Trip = nil
	npc.ResidenceID = ""
	npc.Level = v.LevelID
	npc.Position = v.EntryCell
	npc.Goal = npc.Position
	npc.Path = nil
	npc.PendingPath = nil
	npc.Body = nil
	npc.Manual = false
	npc.CombatHold = false
	npc.Brain.Place = behavior.LifeAffordance{ID: r.world.SanitaryServices.ManagedAffordance, Kind: "hygiene"}
	r.world.SanitaryServices.NPCHygiene = true
	r.sanitaryNPCRequests()
	p, ok := r.state.Sanitary.Users[id]
	if !ok {
		t.Fatal("ordinary NPC hygiene policy not hosted")
	}
	r.world.SanitaryServices.NPCHygiene = false
	// Finish hero then move observation away; NPC service continues from saved clocks.
	if err := r.sanitaryCommand(&pb.PocLifeCommand{Action: "sanitary_cancel"}); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 500 && r.sanitaryReserved(playerActorID); i++ {
		r.state.Tick++
		r.state.Inventory.Advance(r.state.Tick)
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	hero = r.state.Life.Actor(playerActorID)
	hero.Level = "level.poc_housing"
	for _, person := range r.world.Life.Actors {
		if person.ID == playerActorID {
			for _, step := range person.Steps {
				if step.Level == hero.Level {
					hero.Position = step.At
					break
				}
			}
		}
	}
	hero.Goal = hero.Position
	hero.Body = nil
	hero.Path = nil
	hero.PendingPath = nil
	hero.Manual = true
	for i := 0; i < 1000 && r.sanitaryReserved(id); i++ {
		r.state.Tick++
		r.state.Inventory.Advance(r.state.Tick)
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
	}
	if r.sanitaryReserved(id) || r.state.Sanitary.Completed[p.UnitID] != 1 {
		t.Fatal("unloaded service stalled")
	}
}
