func TestStealthStateSavesAndSearchDoesNotUseHiddenHeroPosition(t *testing.T) {
	r, _, target := stealthFootstep(t, false)
	before := r.snapshotState()
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, before); err != nil {
		t.Fatal(err)
	}
	saved, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(saved.Stealth, before.Stealth) {
		t.Fatal("save lost private acquisition/facing/stride")
	}
	clone := before.Stealth.Clone()
	o := clone.Observers[target]
	o.Contact.Score = 999
	clone.Observers[target] = o
	if reflect.DeepEqual(clone, r.state.Stealth) {
		t.Fatal("cloned perception aliases live state")
	}
	bad := before
	bad.Stealth = before.Stealth.Clone()
	o = bad.Stealth.Observers[target]
	o.Contact.UpdatedAt = bad.Life.Seconds + 1
	bad.Stealth.Observers[target] = o
	if r.validateStealth(bad) == nil {
		t.Fatal("future private observation accepted")
	}
	observer, _ := r.combatWorldActor(target)
	fact, _ := r.state.CombatWorld.Memories[target].Best("combat.noise")
	r.clearStealthSearch(target)
	r.stealthSearch(observer, fact.Position, fact.ExpiresTick)
	goal := r.state.Life.Actor(target).Safety.Goal
	// Projection/planning-only initial-pose variant: a hidden coordinate is not
	// a new sensed event. The same real path planner must retain its same goal.
	h := r.state.Life.Actor(playerActorID)
	h.Position = before.Life.Actor(playerActorID).Position
	h.Position.X++
	r.clearStealthSearch(target)
	r.stealthSearch(observer, fact.Position, fact.ExpiresTick)
	if r.state.Life.Actor(target).Safety.Goal != goal {
		t.Fatal("search used a hidden current hero position instead of remembered noise")
	}
}

func TestStealthRealBellReachesTheRememberedEstimateWithinExistingBudget(t *testing.T) {
	r, c, d := playableFixture(t, false)
	if result, _ := stealthWire(t, r, c, "search.bell.quiet", "on"); !result.Ok {
		t.Fatal(result)
	}
	playableUse(t, r, c, playableFind(t, d, "power_toggle"), "search.bell.dark")
	bell := playableFind(t, d, "noise")
	playableWalk(t, r, c, behavior.Cell{X: bell.At.X + 1, Y: bell.At.Y})
	for r.state.Life.Seconds < d.StartSecond+75 {
		r.step()
		playableDrain(c)
	}
	budget := r.world.CombatLife.MaxSafetyCells
	if result, _ := playableAction(t, r, c, bell.ID, "search.bell.ring"); !result.Ok {
		t.Fatal(result)
	}
	var sound behavior.Fact
	for _, fact := range r.state.CombatWorld.Memories[d.Guard].Facts {
		if strings.HasPrefix(fact.Subject, "noise.playable.") {
			sound = fact
		}
	}
	guard := r.state.Life.Actor(d.Guard)
	if sound.Source != "sound" || sound.Cause != "" || sound.ExpiresTick <= r.state.Life.Seconds || guard.Safety == nil || guard.Safety.Goal != sound.Position {
		t.Fatalf("bounded search stopped short of a reachable remembered bell: sound=%+v safety=%+v", sound, guard.Safety)
	}
	// The player actually retreats behind the electrical cabinet, outside the
	// estimated sound point. Sight, lamps and quieter footfalls remain active.
	playableWalk(t, r, c, behavior.Cell{X: 2, Y: 14})
	for r.state.Life.Seconds < sound.ExpiresTick {
		guard = r.state.Life.Actor(d.Guard)
		if guard.Position == sound.Position && guard.Arrived {
			break
		}
		r.step()
		playableDrain(c)
	}
	if guard.Position != sound.Position || !guard.Arrived || r.world.CombatLife.MaxSafetyCells != budget {
		t.Fatalf("guard never physically reached the heard estimate under the same budget: heard=%+v guard=%+v safety=%+v", sound.Position, guard.Position, guard.Safety)
	}
}

// A small explicit static-floor fixture forces partial search results. It uses
// the ordinary Life planner, occupancy and save representation for execution.
func stealthSearchFixture(t *testing.T, terrain []string, at behavior.Cell, budget int) *Runtime {
	t.Helper()
	m := behavior.LifeModel{StartSeconds: 100, SecondsPerTick: 1, MoveTicks: 1, Walkable: map[string]bool{".": true}, Locations: map[string]behavior.LifeLocation{"search": {Name: "search", Terrain: terrain, CellMM: 500}}, Actors: []behavior.LifePerson{{ID: "search.guard", Name: "guard", Steps: []behavior.LifeStep{{Level: "search", At: at, Activity: "rest", Label: "guard"}}}}}
	if err := m.Validate(); err != nil {
		t.Fatal(err)
	}
	r := &Runtime{world: worldData{Life: m, CombatLife: combatLifeCatalog{MaxSafetyCells: budget}}}
	r.state.Life = m.Start()
	return r
}
func stealthSearchStep(t *testing.T, r *Runtime, estimate behavior.Cell, until int64) {
	t.Helper()
	a := r.state.Life.Actor("search.guard")
	r.stealthSearch(combatLifeObserver{ID: a.ID, Level: a.Level, At: a.Position}, estimate, until)
	from := a.Position
	r.state.Tick++
	r.state.Life.Advance(r.world.Life, r.state.Tick)
	if a.Position != from && !r.world.Life.Adjacent(a.Level, from, a.Position) {
		t.Fatal("search execution teleported")
	}
}
