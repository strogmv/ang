// Exercise the real publication order, not appendLiftingDecks on a hand-built
// message whose Life field was already present. Both first and lean frames
// must carry dynamic poses, while static sound/node specs are sent once.
func TestLiftingDeckPublishedThroughRealSendState(t *testing.T){
 r:=lifeRuntimeFixture(t)
 for _,d:=range r.world.LiftingDecks.Decks{t.Run(d.ID,func(t *testing.T){
  h:=r.state.Life.Actor(playerActorID);h.Level=d.LevelID;h.Position=behavior.Cell{X:d.Approach.X,Y:d.Approach.Y};h.Goal=h.Position;h.Trip=nil;h.BoardedEdge="";h.Path=nil;h.PendingPath=nil;h.Body=nil;h.OverrideLevel="";h.OverrideEdge="";h.Manual=true;h.Arrived=true;r.syncLifeHero();r.syncRegionKnowledge();r.updateLifeExploration()
  c:=&connection{out:make(chan *pb.ServerMessage,32),stop:make(chan struct{}),delivery:pb.NewViewProjector(&pb.ViewSubscription{StaticOnChange:true})}
  for frame:=0;frame<2;frame++{
   r.sendState(c);packet:= <-c.out
   raw,err:=(protojson.MarshalOptions{UseProtoNames:true}).Marshal(packet);if err!=nil{t.Fatal(err)}
   var wire map[string]any;if err=json.Unmarshal(raw,&wire);err!=nil{t.Fatal(err)}
   life:=wire["game_state"].(map[string]any)["life"].(map[string]any)
   rows,ok:=life["lifting_decks"].([]any);if !ok||len(rows)!=1||rows[0].(map[string]any)["id"]!=d.ID{t.Fatalf("real lean packet lost %s at level %v: %v",d.ID,life["level_id"],rows)}
   state:=packet.GetGameState();access:=state.GetLife().GetLiftingDecks()[0].GetAccess()
   if access==nil||access.WorldX!=d.ControlPlan[0]||access.WorldY!=d.ControlPlan[1]||access.WorldZ!=d.ControlPlan[2]{t.Fatal("real deck control target lost its measured panel centre")}
   if access==nil||!viewSees(state.PlayerView,int32(d.Approach.X),int32(d.Approach.Y))||!access.Visible||!access.Reachable||!access.Routable{t.Fatalf("deck access was built before perception or lost ordinary reach: %+v",access)}
   specs:=packet.GetGameState().GetLife().GetLiftingDeckSpecs()
   if frame==0&&(len(specs)!=1||len(specs[0].GetSounds())!=len(d.Sounds)||len(specs[0].GetNodes())!=len(d.Nodes)){t.Fatal("first frame lost static deck bindings")}
   if frame==1&&len(specs)!=0{t.Fatal("unchanged static specs repeated")}
