    bool occluding=false;var roots=new List<GameObject>();
    foreach(var id in g.instances)foreach(var v in locationSDKOverrideVisuals)if(v.instance==id&&v.root!=null&&v.root.activeInHierarchy){
     roots.Add(v.root);Bounds b;
     if(!locationSDKInstanceBounds.TryGetValue(v.root,out b)){bool any=false;foreach(var r in v.root.GetComponentsInChildren<Renderer>(false)){if(r.sharedMaterial!=null&&r.sharedMaterial.shader!=null&&r.sharedMaterial.shader.name=="ANG/WorldText")continue;if(!any){b=r.bounds;any=true;}else b.Encapsulate(r.bounds);}if(!any)continue;locationSDKInstanceBounds[v.root]=b;}
