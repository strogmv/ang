      continue;
    }
    query.set(key, String(raw));
  }
  const queryString = query.toString();
  if (!queryString) {
    return url;
  }
  return url.includes('?') ? `${url}&${queryString}` : `${url}?${queryString}`;
};

const parseSSEEvent = (rawEvent: string): { event: string; data: string } | null => {
