// Code generated by ANG. Tactical grid/cover regressions.
package behavior
import("testing";"reflect";"math")

func TestCombatGridReanchorsInsideOwnCellFromAllFourSides(t *testing.T){
 cases:=[]struct{name string;from,target Cell}{{"east",Cell{4,2},Cell{6,2}},{"west",Cell{7,3},Cell{5,3}},{"south",Cell{2,4},Cell{2,6}},{"north",Cell{3,7},Cell{3,5}}}
 for _,tt:=range cases{t.Run(tt.name,func(t *testing.T){
  r:=gridCoverRules();space:=combatFixtureSpace();space.CellMM=500;space.Space.Height=10;space.Grid=DeriveCombatGrid(space.Space,500,r.Grid,nil);space.EndSpacingMM=func(Combatant,Combatant)int{return 700}
  a,b:=combatFixtureActor("a","blue",tt.from),combatFixtureActor("b","red",tt.target);a.Controlled=true;a.Weapon=CombatWeapon{ID:"knife",Kind:"blade",Damage:12,RangeMM:900,AttackAP:2};a.Ammo=0
  s,err:=NewCombat("own-anchor","fixture",711,[]Combatant{a,b},r,space);if err!=nil{t.Fatal(err)}
  before:=s.Actor("a").AP;to:=s.SnapCombatCell(space,r,*s.Actor("a"),tt.from,true)
  if to==tt.from||!space.Grid.Same(tt.from,to)||space.Grid.Same(to,tt.target)||space.rangeMM(to,tt.target)>900||space.rangeMM(to,tt.target)<700{t.Fatalf("no legal own-cell contact: %v -> %v vs %v",tt.from,to,tt.target)}
  preview:=s.MovePreview(space,r,"a",tt.from);if preview.Reason!=""||len(preview.Path)==0{t.Fatalf("no physical re-anchor path: %+v",preview)}
  at:=tt.from;for _,p:=range preview.Path{if Distance(at,p)!=1{t.Fatal("re-anchor teleported")};at=p}
  if err=s.Execute(space,r,"a",CombatAction{Type:"move",To:tt.from});err!=nil{t.Fatal(err)}
  if s.Actor("a").Position!=to||before-s.Actor("a").AP!=preview.AP{t.Fatal("re-anchor preview and executor differ")}
  if err=s.Execute(space,r,"a",CombatAction{Type:"attack",TargetID:"b"});err!=nil{t.Fatalf("prepared knife strike refused: %v",err)}
 })}
}
