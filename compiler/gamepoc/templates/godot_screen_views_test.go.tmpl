func TestScreenSaveSlotTellsWorldDayClockAndPlace(t *testing.T) {
	r := lifeRuntimeFixture(t)
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil {
		t.Fatal("fixture needs the hero")
	}
	slots := r.world.Config.SaveSlots
	if len(slots) < 2 {
		t.Fatal("fixture needs two save slots")
	}
	r.state.Life.Seconds = 2*86400 + 14*3600 + 20*60
	if err := r.writeSave(slots[0], r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	listed := r.storageRuntime().readSlots()
	saved, empty := listed[0], listed[1]
	if !saved.Valid || saved.GameDay != 3 || saved.GameClockSeconds != 14*3600+20*60 || saved.LevelId != hero.Level {
		t.Fatalf("saved slot day %d clock %d level %q, want 3, 51600, %q", saved.GameDay, saved.GameClockSeconds,
			saved.LevelId, hero.Level)
	}
	if empty.Exists || empty.GameDay != 0 || empty.LevelId != "" {
		t.Fatalf("an empty slot claims a world: %+v", empty)
	}
	for _, locale := range []string{
		"ru",
		"en",
	} {
		slot := &pb.PocSaveSlot{LevelId: saved.LevelId}
		r.screenSlotPlace(locale, slot)
		want := r.regionLevelName(locale, saved.LevelId)
		if node := r.regionNodeForLevel(saved.LevelId); node != nil {
			if label := r.localText(locale, "region.node."+node.ID+".label", ""); label != "region.node."+node.ID+".label" {
				want = label
			}
		}
		if slot.Place == "" || slot.Place != want {
			t.Fatalf("%s place %q, want the world's own short name %q", locale, slot.Place, want)
		}
	}
	nowhere := &pb.PocSaveSlot{}
	r.screenSlotPlace("ru", nowhere)
	if nowhere.Place != "" {
		t.Fatal("a slot without a level got a place")
	}
}
func TestScreenSaveSlotsComeAgainInTheNewLanguage(t *testing.T) {
	r := lifeRuntimeFixture(t)
	slots := r.world.Config.SaveSlots
	if len(slots) < 1 {
		t.Fatal("fixture needs a save slot")
	}
	if err := r.writeSave(slots[0], r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	for len(r.jobs) > 0 {
		<-r.jobs
	}
	c := &connection{locale: "ru", out: make(chan *pb.ServerMessage, 64), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_Locale{Locale: &pb.PocLocaleRequest{Locale: "en"}}}})
	if len(r.jobs) != 1 {
		t.Fatalf("a new language queued %d slot lists, want 1", len(r.jobs))
	}
	j := <-r.jobs
	if j.action != "list" || j.client != c {
		t.Fatalf("a new language queued %+v, want the slot list for that client", j)
	}
	r.diskComplete(diskResult{job: j, slots: r.storageRuntime().readSlots()})
	want := &pb.PocSaveSlot{LevelId: r.state.Life.Actor(playerActorID).Level}
	r.screenSlotPlace("en", want)
	for len(c.out) > 0 {
		m := <-c.out
		if list := m.GetSaveSlots(); list != nil {
			if len(list.Slots) == 0 || list.Slots[0].Place != want.Place || want.Place == "" {
				t.Fatalf("slots after the new language name the place %q, want %q", list.Slots[0].Place, want.Place)
			}
			return
		}
	}
	t.Fatal("no slot list was sent in the new language")
}
