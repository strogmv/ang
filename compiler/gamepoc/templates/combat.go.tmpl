// Code generated by ANG. Tactical encounters in the ordinary Life world.
package poc

import (
	"angelsdemons/server/internal/behavior"
	inv "angelsdemons/server/internal/inventory"
	pb "angelsdemons/server/internal/transport/grpc/pb/game/v1"
	"errors"
	"fmt"
	"math"
	"sort"
)

type combatProfile struct {
	MaxHP        int                   `json:"max_hp"`
	Armor        int                   `json:"armor"`
	Skill        int                   `json:"skill"`
	Courage      int                   `json:"courage"`
	Initiative   int                   `json:"initiative"`
	Noncombatant bool                  `json:"noncombatant"`
	Trained      bool                  `json:"trained"`
	Weapon       behavior.CombatWeapon `json:"weapon"`
	Ammo         int                   `json:"ammo"`
	ReserveAmmo  int                   `json:"reserve_ammo"`
	Medkits      int                   `json:"medkits"`
}
type combatCatalog struct {
	Rules           behavior.CombatRules             `json:"rules"`
	DefaultProfile  string                           `json:"default_profile"`
	Profiles        map[string]combatProfile         `json:"profiles"`
	Actors          map[string]string                `json:"actors"`
	Weapons         map[string]behavior.CombatWeapon `json:"weapons"`
	MaxParticipants int                              `json:"max_participants"`
	JoinRangeMM     int                              `json:"join_range_mm"`
}

func (c combatCatalog) Validate() error {
	if c.DefaultProfile == "" && c.Rules.APPerTurn == 0 {
		return nil
	}
	if err := c.Rules.Validate(); err != nil {
		return err
	}
	if _, ok := c.Profiles[c.DefaultProfile]; !ok {
		return errors.New("combat default profile missing")
	}
	if c.MaxParticipants < 2 || c.MaxParticipants > 64 || c.JoinRangeMM < 1 {
		return errors.New("combat participant policy invalid")
	}
	for _, p := range c.Profiles {
		if p.MaxHP < 1 || p.Skill < 0 || p.Skill > 100 || p.Courage < 0 || p.Courage > 100 || p.Weapon.ID == "" || p.Weapon.Damage < 1 || p.Weapon.AttackAP < 1 || p.Weapon.RangeMM < 1 {
			return errors.New("invalid combat profile")
		}
	}
	for _, id := range c.Actors {
		if _, ok := c.Profiles[id]; !ok {
			return fmt.Errorf("unknown combat profile %s", id)
		}
	}
	return nil
}
func (r *Runtime) combatant(id, team string) behavior.Combatant {
	old, existed := r.state.CombatRoster[id]
	name := r.world.CombatRuntime.Actors[id]
	if name == "" {
		name = r.world.CombatRuntime.DefaultProfile
	}
	p := r.world.CombatRuntime.Profiles[name]
	a := behavior.Combatant{ID: id, Team: team, HP: p.MaxHP, MaxHP: p.MaxHP, Armor: p.Armor, Skill: p.Skill, Courage: p.Courage, Initiative: p.Initiative, Noncombatant: p.Noncombatant, Trained: p.Trained, Weapon: p.Weapon, Ammo: p.Ammo, ReserveAmmo: p.ReserveAmmo, Medkits: p.Medkits, Controlled: id == playerActorID}
	if existed {
		a.HP = old.HP
		a.Ammo = old.Ammo
		a.ReserveAmmo = old.ReserveAmmo
		a.Medkits = old.Medkits
		a.Surrendered = old.Surrendered
	}
	// Only a physically equipped item can replace the authored unarmed attack.
	ids := make([]string, 0, len(r.state.Inventory.Items))
	for key := range r.state.Inventory.Items {
		ids = append(ids, key)
	}
	sort.Strings(ids)
	for _, key := range ids {
		item := r.state.Inventory.Items[key]
		definition := r.world.Inventory.Definitions[item.Definition]
		if item.Location.Kind != "store" || item.Location.Store != inv.ActorStore(id) || item.Location.Slot == "" || item.Condition < definition.WearPerUse || item.Condition <= 0 {
			continue
		}
		if weapon, ok := r.world.CombatRuntime.Weapons[item.Definition]; ok {
			a.Weapon = weapon
			break
		}
	}
	if existed && (old.Weapon.ID != a.Weapon.ID || old.Weapon.Magazine != a.Weapon.Magazine) {
		a.Ammo = 0
	}
	if a.Ammo > a.Weapon.Magazine {
		a.Ammo = a.Weapon.Magazine
	}
	return a
}

func (r *Runtime) combatSpace(s behavior.CombatState) behavior.CombatSpace {
	model := r.state.Life.GateModel(r.world.Life)
	level := model.Locations[s.LevelID]
	space := model.Space(s.LevelID, nil)
	unit := level.CellMM
	if unit < 1 {
		unit = 1000
	}
	result := behavior.CombatSpace{Space: space, CellMM: unit}
	result.Space.Visible = func(a, b behavior.Cell) bool { return r.sightLine(location(a), location(b)) }
	if v := r.world.Decks[s.LevelID]; v != nil {
		result.RangeMM = v.CombatRangeMM
		result.Cover = v.CombatProtection
		result.ShotClear = v.CombatShotClear
		result.BodyOnShot = v.BodyOnCombatShot
	} else {
		result.Cover = func(from, to behavior.Cell) float64 {
			// Planar legacy levels only declare opaque walls; do not invent armour
			// for a graphical prop or classify every blocked cell as ballistic cover.
			if !r.sightLine(location(from), location(to)) {
				return 1
			}
			return 0
		}
		result.ShotClear = result.Space.Visible
	}
	participants := map[string]bool{}
	for _, a := range s.Actors {
		participants[a.ID] = true
	}
	blocked := map[behavior.Cell]bool{}
	for _, a := range r.state.Life.Actors {
		if a.Level == s.LevelID && a.OnFloor() && !participants[a.ID] {
			blocked[a.Position] = true
			if len(a.Path) > 0 {
				blocked[a.Path[0]] = true
			}
			if a.Body != nil {
				for _, p := range a.Body.Cells {
					blocked[p] = true
				}
			}
		}
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.Materialized && a.Level == s.LevelID && a.Trip == nil {
			blocked[a.Position] = true
			if len(a.Path) > 0 {
				blocked[a.Path[0]] = true
			}
		}
	}
	// Physical execution uses all occupants. The planner's ambient blockers
	// are limited to current actor sight, avoiding a hidden-person radar.
	result.Space.Blocked = nil
	result.Space.Occupied = func(at behavior.Cell) bool { return blocked[at] }
	result.ExecutionShotBlocked = func(from, to behavior.Cell) bool {
		onShot := func(at behavior.Cell) bool {
			if result.BodyOnShot != nil {
				return result.BodyOnShot(from, to, at)
			}
			dx, dy := float64(to.X-from.X), float64(to.Y-from.Y)
			n := dx*dx + dy*dy
			if n == 0 {
				return false
			}
			t := (float64(at.X-from.X)*dx + float64(at.Y-from.Y)*dy) / n
			if t <= 0 || t >= 1 {
				return false
			}
			return math.Hypot(float64(from.X)+t*dx-float64(at.X), float64(from.Y)+t*dy-float64(at.Y))*float64(unit) < 225
		}
		for _, a := range r.state.Life.Actors {
			if !participants[a.ID] && a.OnFloor() && a.Level == s.LevelID && onShot(a.Position) {
				return true
			}
		}
		for _, a := range r.state.Life.Population.Actors {
			if a.Materialized && a.Level == s.LevelID && a.Trip == nil && onShot(a.Position) {
				return true
			}
		}
		return false
	}
	result.CanHear = func(listener, source behavior.Combatant) bool {
		policy := r.world.AI.Policy.Perception.Hearing
		policy.RangeCells = max(1, r.world.CombatRuntime.Rules.HearingRangeMM/unit)
		from, to := source.Position, listener.Position
		walls := 0
		if v := r.world.Decks[s.LevelID]; v != nil {
			from, _, _, _ = v.Locate(source.Position)
			to, _, _, _ = v.Locate(listener.Position)
			walls = v.CombatSoundBlockers(source.Position, listener.Position)
		} else {
			walls = r.soundBlockers(from, to)
		}
		_, ok := policy.Hear(behavior.Sound{Origin: from, Loudness: policy.Loudness("fight", false, 1)}, to, 1, walls, r.cellNoise(location(listener.Position)))
		return ok
	}
	return result
}
func (r *Runtime) combatDistance(a, b behavior.Cell) int {
	if v := r.deckVolume(); v != nil {
		return v.CombatRangeMM(a, b)
	}
	unit := r.world.Life.Locations[r.currentLevel()].CellMM
	if unit < 1 {
		unit = 1000
	}
	return int(math.Ceil(math.Hypot(float64(a.X-b.X), float64(a.Y-b.Y)) * float64(unit)))
}
func (r *Runtime) startCombat(targetID string) error {
	if !r.state.Life.Enabled || r.state.Paused || r.world.CombatRuntime.DefaultProfile == "" {
		return textError{Key: "error.combat_unavailable"}
	}
	hero, target := r.state.Life.Actor(playerActorID), r.state.Life.Actor(targetID)
	if hero == nil || target == nil || target.ID == hero.ID || !hero.OnFloor() || !target.OnFloor() || hero.Level != target.Level || !r.sightWithin(location(hero.Position), location(target.Position), r.world.Visibility.PlayerRange) || r.combatDistance(hero.Position, target.Position) > r.world.CombatRuntime.JoinRangeMM {
		return textError{Key: "error.combat_unknown_target"}
	}
	if hero.CombatHold || target.CombatHold {
		return textError{Key: "error.combat_unknown_target"}
	}
	actors := []behavior.Combatant{r.combatant(hero.ID, "player"), r.combatant(target.ID, "opposition")}
	if !actors[0].Able() || !actors[1].Able() {
		return textError{Key: "error.combat_unknown_target"}
	}
	// Only explicitly authored responders join; bystanders do not acquire a
	// combat role from sharing a room or from a faction-wide broadcast.
	if !actors[1].Noncombatant {
		for _, other := range r.state.Life.Actors {
			if len(actors) >= r.world.CombatRuntime.MaxParticipants {
				break
			}
			if other.ID == hero.ID || other.ID == target.ID || !other.OnFloor() || other.Level != hero.Level || other.CombatHold {
				continue
			}
			binding, authored := r.world.CombatRuntime.Actors[other.ID]
			profile := r.world.CombatRuntime.Profiles[binding]
			if !authored || profile.Noncombatant || r.combatDistance(other.Position, target.Position) > r.world.CombatRuntime.JoinRangeMM || !r.sightLine(location(other.Position), location(target.Position)) {
				continue
			}
			candidate := r.combatant(other.ID, "opposition")
			if candidate.Able() {
				actors = append(actors, candidate)
			}
		}
	}
	for i := range actors {
		actors[i].Position = r.state.Life.Actor(actors[i].ID).Position
	}
	proposed := behavior.CombatState{LevelID: hero.Level, Actors: actors}
	if r.state.CombatSerial >= 1<<50 {
		return textError{Key: "error.combat_unavailable"}
	}
	encounter, err := behavior.NewCombat(fmt.Sprintf("encounter.%d", r.state.CombatSerial+1), hero.Level, r.state.Seed, actors, r.world.CombatRuntime.Rules, r.combatSpace(proposed))
	if err != nil {
		return err
	}
	r.state.Combat = encounter
	r.state.CombatSerial++
	// A delayed action from a previous encounter must not match a new turn 1.
	r.state.Epoch = newEpoch()
	r.state.CombatPublicEvents = nil
	r.state.CombatPublicSeq = 0
	for _, actor := range actors {
		a := r.state.Life.Actor(actor.ID)
		if actor.ID == playerActorID {
			a.Manual = true
		}
		a.CombatHold = true
		a.Path = nil
		a.PendingPath = nil
		a.YieldUntil = 0
		a.YieldHoldUntil = 0
		a.YieldRequester = ""
		a.OverrideLevel = ""
		a.OverrideEdge = ""
		a.Arrived = true
		a.MoveStartTick = r.lifeMotionTick()
		if a.Body != nil {
			a.Body.Mode = ""
			a.Body.Route = nil
			a.Body.Moving = false
			a.Body.DX = 0
			a.Body.DY = 0
		}
	}
	r.resetInstantTravel()
	r.syncCombatLife()
	return r.advanceCombatAI()
}
func (r *Runtime) advanceCombatAI() error {
	// One NPC action per pass permits a new physical occupancy view each time.
	limit := r.world.CombatRuntime.MaxParticipants * (r.world.CombatRuntime.Rules.MaxActionsPerTurn + 1)
	for n := 0; r.state.Combat.Active && n < limit; n++ {
		a := r.state.Combat.Current()
		if a == nil || a.Controlled {
			break
		}
		candidate := r.state.Combat.Clone()
		if err := candidate.StepAI(r.combatSpace(candidate), r.world.CombatRuntime.Rules); err != nil {
			return err
		}
		if err := r.commitCombat(candidate); err != nil {
			fallback := r.state.Combat.Clone()
			if endErr := fallback.Execute(r.combatSpace(fallback), r.world.CombatRuntime.Rules, a.ID, behavior.CombatAction{Type: "end"}); endErr != nil {
				return endErr
			}
			if len(fallback.Events) > 0 {
				fallback.Events[len(fallback.Events)-1].Reason = "physical equipment use failed; turn ended"
			}
			if endErr := r.commitCombat(fallback); endErr != nil {
				return endErr
			}
		}
		r.syncCombatLife()
	}
	r.syncCombatLife()
	return nil
}
func (r *Runtime) combatCommand(q *pb.PocCombatCommand) error {
	if q.Action == "start" {
		if r.state.Combat.Active {
			return textError{Key: "error.combat_already_active"}
		}
		return r.startCombat(q.TargetId)
	}
	if !r.state.Combat.Active || q.ExpectedTurn != r.state.Combat.Turn {
		return textError{Key: "error.combat_stale_turn"}
	}
	if r.state.Paused {
		return textError{Key: "error.combat_unavailable"}
	}
	a := r.state.Combat.Current()
	if a == nil || a.ID != playerActorID {
		return textError{Key: "error.combat_not_your_turn"}
	}
	action := behavior.CombatAction{Type: q.Action, TargetID: q.TargetId, To: behavior.Cell{X: int(q.X), Y: int(q.Y)}}
	candidate := r.state.Combat.Clone()
	if err := candidate.Execute(r.combatSpace(candidate), r.world.CombatRuntime.Rules, playerActorID, action); err != nil {
		return textError{Key: "error.combat_invalid_action"}
	}
	if err := r.commitCombat(candidate); err != nil {
		return textError{Key: "error.combat_invalid_action"}
	}
	r.syncCombatLife()
	return r.advanceCombatAI()
}
func (r *Runtime) combatMove(c *connection, m *pb.MoveTo) {
	result := &pb.PocMoveResult{Epoch: r.state.Epoch, InputSeq: m.InputSeq}
	target := behavior.Cell{X: int(m.X), Y: int(m.Y)}
	deckOK := m.Deck == 0
	if volume := r.deckVolume(); volume != nil {
		deck, ok := volume.SurfaceIndex(target)
		deckOK = ok && int32(deck) == m.Deck
	}
	if !deckOK {
		result.Reason = "invalid_deck"
	} else if m.Epoch != r.state.Epoch || m.InputSeq == 0 || m.InputSeq <= c.lastMoveSeq {
		result.Reason = "stale_input"
	} else {
		c.lastMoveSeq = m.InputSeq
		q := &pb.PocCombatCommand{Action: "move", X: m.X, Y: m.Y, ExpectedTurn: r.state.Combat.Turn}
		if err := r.combatCommand(q); err != nil {
			result.Reason = "combat_action_rejected"
		} else {
			result.Ok = true
			r.state.LastMoveSeq = m.InputSeq
		}
	}
	r.send(c, &pb.ServerMessage{Msg: &pb.ServerMessage_MoveResult{MoveResult: result}})
	r.sendState(c)
}

// Commit the tactical action and physical equipment wear together. A rejected
// use leaves HP/AP, random counter and the inventory transaction cursor intact.
func (r *Runtime) commitCombat(candidate behavior.CombatState) error {
	inventory := r.state.Inventory.Clone()
	for _, event := range candidate.Events {
		if event.Sequence <= r.state.Combat.ActionSeq || event.Type != "attack" {
			continue
		}
		actor := r.state.Combat.Actor(event.ActorID)
		if actor == nil || actor.Weapon.ID == "unarmed" {
			continue
		}
		keys := make([]string, 0, len(inventory.Items))
		for key := range inventory.Items {
			keys = append(keys, key)
		}
		sort.Strings(keys)
		used := false
		for _, key := range keys {
			item := inventory.Items[key]
			if item.Definition != actor.Weapon.ID || item.Location.Kind != "store" || item.Location.Store != inv.ActorStore(actor.ID) || item.Location.Slot == "" {
				continue
			}
			definition := r.world.Inventory.Definitions[item.Definition]
			if definition.WearPerUse < 1 {
				return errors.New("combat weapon has no physical use contract")
			}
			_, err := inventory.Apply(r.inventoryModelFor(true), inv.Transaction{Actor: actor.ID, Sequence: inventory.Cursors[actor.ID].Sequence + 1, RequestTag: fmt.Sprintf("combat/%s/%d", candidate.ID, event.Sequence), Wear: []inv.Wear{{Item: item.ID, ExpectedRevision: item.Revision, Amount: definition.WearPerUse}}})
			if err != nil {
				return err
			}
			used = true
			break
		}
		if !used {
			return errors.New("combat weapon is no longer equipped")
		}
	}
	r.state.Inventory = inventory
	r.state.Combat = candidate
	// A worn-out tool falls back to the actor's unarmed profile at the next
	// decision. It is not repaired by starting another encounter.
	for i := range r.state.Combat.Actors {
		a := &r.state.Combat.Actors[i]
		actual := r.combatant(a.ID, a.Team)
		if a.Weapon.ID != actual.Weapon.ID {
			a.Weapon = actual.Weapon
			a.Ammo = 0
		}
	}
	return nil
}
func (r *Runtime) syncCombatLife() {
	if r.state.Combat.ID == "" {
		return
	}
	if r.state.CombatRoster == nil {
		r.state.CombatRoster = map[string]behavior.Combatant{}
	}
	for _, c := range r.state.Combat.Actors {
		stored := c
		stored.Contacts = append([]behavior.CombatContact(nil), c.Contacts...)
		r.state.CombatRoster[c.ID] = stored
		a := r.state.Life.Actor(c.ID)
		if a == nil {
			continue
		}
		wasHeld := a.CombatHold
		if a.Position != c.Position {
			a.Position = c.Position
			a.Goal = c.Position
			a.Body = nil
		}
		a.Path = nil
		a.PendingPath = nil
		a.MoveStartTick = r.lifeMotionTick()
		a.CombatHold = r.state.Combat.Active || !c.Able()
		if a.CombatHold {
			a.Activity = "combat"
			a.Label = "ui.combat.active"
			if c.HP <= 0 {
				a.Activity = "down"
				a.Label = "ui.combat.down"
			} else if c.Surrendered {
				a.Activity = "surrendered"
				a.Label = "ui.combat.surrendered"
			}
		} else if wasHeld {
			a.Activity = "rest"
			a.Label = "ui.combat.finished"
			a.Arrived = c.ID == playerActorID
		}
	}
	r.state.Life.EnsureHeroBody(r.state.Life.GateModel(r.world.Life))
	r.syncLifeHero()
	r.capturePublicCombatEvents()
	r.state.Life.ObserveDecisions()
}
func (r *Runtime) appendCombat(msg *pb.PocGameState) {
	s := r.state.Combat
	if s.ID == "" {
		return
	}
	view := &pb.PocCombatView{Active: s.Active, EncounterId: s.ID, LevelId: s.LevelID, Turn: s.Turn, Winner: s.Winner}
	// Finished encounters retain an outcome, not live bodies at historical
	// cells. The ordinary Life simulation can already have moved or travelled.
	if !s.Active || s.LevelID != r.currentLevel() {
		msg.Combat = view
		return
	}
	if a := s.Current(); a != nil {
		if a.ID == playerActorID || r.sightWithin(r.state.Player, location(a.Position), r.world.Visibility.PlayerRange) {
			view.CurrentActorId = a.ID
		}
	}
	for _, a := range s.Actors {
		if a.ID != playerActorID && !r.sightWithin(r.state.Player, location(a.Position), r.world.Visibility.PlayerRange) {
			continue
		}
		v := &pb.PocCombatActor{Id: a.ID, X: int32(a.Position.X), Y: int32(a.Position.Y), Surrendered: a.Surrendered, Down: a.HP <= 0}
		if a.ID == playerActorID {
			v.Hp = int32(a.HP)
			v.MaxHp = int32(a.MaxHP)
			v.Ap = int32(a.AP)
			v.Ammo = int32(a.Ammo)
		}
		view.Actors = append(view.Actors, v)
	}
	for _, e := range r.state.CombatPublicEvents {
		view.Events = append(view.Events, &pb.PocCombatEvent{Type: e.Type, ActorId: e.ActorID, TargetId: e.TargetID, FromX: int32(e.From.X), FromY: int32(e.From.Y), ToX: int32(e.To.X), ToY: int32(e.To.Y), Amount: int32(e.Amount), Hit: e.Hit, Turn: e.Turn, Sequence: e.Sequence})
	}
	msg.Combat = view
}
func (r *Runtime) capturePublicCombatEvents() {
	for _, event := range r.state.Combat.Events {
		if event.Sequence <= r.state.CombatPublicSeq {
			continue
		}
		r.state.CombatPublicSeq = event.Sequence
		seenFrom := r.sightWithin(r.state.Player, location(event.From), r.world.Visibility.PlayerRange)
		seenTo := r.sightWithin(r.state.Player, location(event.To), r.world.Visibility.PlayerRange)
		if event.ActorID != playerActorID && event.TargetID != playerActorID && !seenFrom && !seenTo {
			continue
		}
		event.Reason = ""
		if event.ActorID != playerActorID && !seenFrom {
			event.ActorID = ""
			event.From = behavior.Cell{X: -1, Y: -1}
		}
		if event.TargetID != playerActorID && !seenTo {
			event.TargetID = ""
			event.To = behavior.Cell{X: -1, Y: -1}
		}
		r.state.CombatPublicEvents = append(r.state.CombatPublicEvents, event)
		if len(r.state.CombatPublicEvents) > 64 {
			r.state.CombatPublicEvents = append([]behavior.CombatEvent(nil), r.state.CombatPublicEvents[len(r.state.CombatPublicEvents)-64:]...)
		}
	}
}
func (r *Runtime) validateCombatSave(s state) error {
	if s.CombatSerial > 1<<50 || (s.Combat.ID != "" && s.CombatSerial == 0) {
		return errors.New("invalid encounter sequence")
	}
	if len(s.CombatPublicEvents) > 64 || s.CombatPublicSeq > s.Combat.ActionSeq {
		return errors.New("invalid public combat event history")
	}
	if s.Combat.ID == "" {
		if len(s.CombatRoster) > 0 || len(s.CombatPublicEvents) != 0 || s.CombatPublicSeq != 0 {
			return errors.New("combat roster without encounter")
		}
		return nil
	}
	if !s.Life.Enabled {
		return errors.New("combat outside Life")
	}
	validator := &Runtime{world: r.world, state: s}
	space := validator.combatSpace(s.Combat)
	if !s.Combat.Active {
		// A closed gate may now occupy an empty historical combat cell. Only
		// an active battle is constrained by the present gate configuration.
		space.Space.Walkable = func(at behavior.Cell) bool { return r.world.Life.Walks(s.Combat.LevelID, at) }
		space.Space.Blocked = nil
	}
	if err := s.Combat.Validate(r.world.CombatRuntime.Rules, space); err != nil {
		return err
	}
	if len(s.CombatRoster) > len(s.Life.Actors) {
		return errors.New("combat roster exceeds persistent population")
	}
	for id, c := range s.CombatRoster {
		a := s.Life.Actor(id)
		if id != c.ID || a == nil || r.world.Life.Person(id) == nil || c.Team == "" || len(c.Team) > 256 || c.Controlled != (id == playerActorID) {
			return errors.New("unknown combat roster actor")
		}
		if c.MaxHP < 1 || c.MaxHP > 1000000 || c.HP < 0 || c.HP > c.MaxHP || c.AP < 0 || c.AP > r.world.CombatRuntime.Rules.APPerTurn || c.Armor < 0 || c.Armor > 1000000 || c.Skill < 0 || c.Skill > 100 || c.Courage < 0 || c.Courage > 100 || c.Initiative < -1000000 || c.Initiative > 1000000 || c.Ammo < 0 || c.Ammo > c.Weapon.Magazine || c.ReserveAmmo < 0 || c.ReserveAmmo > 1000000 || c.Medkits < 0 || c.Medkits > 10000 {
			return errors.New("invalid persistent combat resources")
		}
		if c.Weapon.ID == "" || len(c.Weapon.ID) > 256 || c.Weapon.Damage < 1 || c.Weapon.Damage > 1000000 || c.Weapon.RangeMM < 1 || c.Weapon.RangeMM > 10000000 || c.Weapon.AttackAP < 1 || c.Weapon.AttackAP > 100 || c.Weapon.Magazine < 0 || c.Weapon.Magazine > 1000000 || len(c.Contacts) > 512 {
			return errors.New("invalid persistent combat equipment")
		}
		if !c.Able() && (!a.OnFloor() || !a.CombatHold || a.Position != c.Position) {
			return errors.New("incapable combat actor resumed an ordinary routine")
		}
		if c.Able() && a.CombatHold && (!s.Combat.Active || s.Combat.Actor(id) == nil) {
			return errors.New("orphan combat hold")
		}
	}
	for _, c := range s.Combat.Actors {
		a := s.Life.Actor(c.ID)
		if a == nil || a.CombatHold != (s.Combat.Active || !c.Able()) || ((s.Combat.Active || !c.Able()) && (!a.OnFloor() || a.Level != s.Combat.LevelID || a.Position != c.Position)) {
			return errors.New("combat/life pose or hold mismatch")
		}
		cached, ok := s.CombatRoster[c.ID]
		if !ok || cached.HP != c.HP || cached.MaxHP != c.MaxHP || cached.AP != c.AP || cached.Ammo != c.Ammo || cached.ReserveAmmo != c.ReserveAmmo || cached.Medkits != c.Medkits || cached.Weapon != c.Weapon || cached.Surrendered != c.Surrendered || cached.Controlled != c.Controlled || cached.Team != c.Team {
			return errors.New("combat roster differs")
		}
	}
	lastSequence := uint64(0)
	for _, e := range s.CombatPublicEvents {
		validCell := func(at behavior.Cell) bool {
			return (at.X == -1 && at.Y == -1) || (at.X >= 0 && at.Y >= 0 && at.X < space.Space.Width && at.Y < space.Space.Height)
		}
		if e.Sequence <= lastSequence || e.Sequence > s.CombatPublicSeq || e.Turn < 1 || e.Turn > s.Combat.Turn || e.Reason != "" || !validCell(e.From) || !validCell(e.To) || (e.ActorID != "" && s.Life.Actor(e.ActorID) == nil) || (e.TargetID != "" && s.Life.Actor(e.TargetID) == nil) {
			return errors.New("invalid filtered combat event")
		}
		lastSequence = e.Sequence
	}
	return nil
}
