func(r *Runtime) emitSound(kind string,origin point,sourceID,cause string){
 d:=&r.state.Demo;hearing:=r.world.AI.Policy.Perception.Hearing;loudness:=hearing.Loudness(kind,false,1);if loudness<=0{return}
 d.SoundSeq++;d.Sounds=append(d.Sounds,behavior.Sound{ID:fmt.Sprintf("sound.%d",d.SoundSeq),Kind:kind,SourceID:sourceID,Cause:cause,Loudness:loudness,Origin:cell(origin),Tick:r.state.Tick})
