// Add author-declared story placements exactly once to pre-story saves.
// Initial placement provenance identifies already surviving items, wherever they are.
func (r *Runtime) backfillStoryPlacements(s *state) error {
	m := r.world.Memory
	if m == nil || s.Memory.StoryVersion != 0 || len(m.BackfillPlacements) == 0 {
		return nil
	}
	present := map[string]bool{}
	for _, item := range s.Inventory.Items {
		present[item.Origin] = true
	}
	model := r.inventoryModelFor(true)
	var additions []inv.Make
	for _, source := range model.Sources {
		if present[source.ID] || !slices.Contains(m.BackfillPlacements, source.ID) {
			continue
		}
		additions = append(additions, inv.Make{ID: inv.InstanceID(source.ID, 0, 0), Definition: source.Definition,
			Quantity: source.Quantity, Condition: source.Condition, Owner: source.Owner, Origin: source.ID,
			Location: source.Location, Grade: source.Grade})
	}
	if len(additions) == 0 {
		return nil
	}
	_, err := s.Inventory.Transform(model, inv.Transform{Make: additions})
	return err
}
