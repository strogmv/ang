func TestParseSecrets(t *testing.T) {
{{- if and .UseMacanP2P .HasOptionalReturnRecipientDetails }}
	tests := []struct {
		name      string
		input     string
		wantErr   bool
		wantRetRD bool
	}{
		{"valid", "x:x", false, false},
		{"valid with returnRD=true", "x:x:true", false, true},
		{"valid with returnRD=false", "x:x:false", false, false},
		{"empty", "", true, false},
		{"single part", "onlyone", true, false},
		{"missing part", "a:", true, false},
		{"missing other", ":b", true, false},
		{"invalid returnRD value", "x:x:notabool", true, false},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			s, err := parseSecrets(tt.input)
			if tt.wantErr {
				require.Error(t, err)
				assert.ErrorIs(t, err, providers.ErrInvalidMerchantSecret)
				return
			}
			require.NoError(t, err)
			require.NotEmpty(t, s.apiToken, "apiToken must not be empty")
			require.NotEmpty(t, s.signatureKey, "signatureKey must not be empty")
			assert.Equal(t, tt.wantRetRD, s.returnRecipientDetails)
		})
	}
{{- else }}
	tests := []struct {
		name    string
		input   string
		wantErr bool
	}{
		{"valid", "{{ .SecretTestValue }}", false},
		{"empty", "", true},
		{"single part", "onlyone", true},
		{"missing part", "a:", true},
		{"missing other", ":b", true},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			s, err := parseSecrets(tt.input)
			if tt.wantErr {
				require.Error(t, err)
				return
			}
			require.NoError(t, err)
			{{- range $i, $p := .SecretParts }}
			{{- if not $p.Optional }}
			require.NotEmpty(t, s.{{ $p.Key }}, "{{ $p.Key }} must not be empty")
			{{- end }}
			{{- end }}
		})
	}
{{- end }}
}

