		}
		location, ok := r.world.Life.Locations[q.Destination]
		if !ok {
			return errors.New("Неизвестная локация")
		}
		_ = location
		var goal behavior.Cell
		found := false
		for _, e := range r.world.Life.Edges {
			if e.To == q.Destination {
				goal = e.Entry
				found = true
