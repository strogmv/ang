   combatM1Rows.Add("{\"dsp\":"+AudioSettings.dspTime.ToString("R",System.Globalization.CultureInfo.InvariantCulture)+",\"t\":"+CombatF(CombatAutoTime)+",\"clock\":"+CombatF(CombatNow)+",\"frame\":"+Time.frameCount+",\"actor\":"+CombatJ(b.actor)+",\"target\":"+CombatJ(b.target)+",\"outcome\":"+CombatJ(outcome)+",\"mode\":"+CombatJ(b.mode)+",\"zone\":"+CombatJ(b.zone)+",\"side\":"+CombatJ(b.side)+",\"sign\":"+CombatJ(b.sign)+",\"clip\":"+CombatJ(b.clip==null?"":b.clip.state)+",\"reaction\":"+CombatJ(b.reaction==null?"":b.reaction.state)+",\"ik_weight\":"+CombatF(w)+",\"tip_to_point_m\":"+CombatF(Vector3.Distance(tip.position,point))+",\"tip_to_skin_m\":"+CombatF(CombatSkinGap(v,tip.position))+",\"tip_signed_m\":"+CombatF(CombatSkinSigned(v,tip.position,CombatNoArms(v)))+",\"hand_signed_m\":"+CombatF(CombatSkinSigned(v,hand.position,CombatNoArms(v)))+",\"depth\":"+CombatJ(b.depth)+",\"pelvis_deg\":"+CombatF(M1Yaw(pelvis,to))+",\"shoulders_deg\":"+CombatF(M1Yaw(chest,to))+",\"root_deg\":"+CombatF(M1Yaw(a.go.transform.forward,to))+",\"hips_travel_m\":"+CombatF(Vector3.Dot(f,flat))+",\"tip_travel_m\":"+CombatF(Vector3.Dot(tip.position-b.tip0,flat))+",\"body_gap_m\":"+CombatF(M1BodyGap(a,v))+",\"feet_m\":"+CombatF(to.magnitude)+",\"lf\":["+CombatF(lf.x)+","+CombatF(lf.y)+","+CombatF(lf.z)+"],\"rf\":["+CombatF(rf.x)+","+CombatF(rf.y)+","+CombatF(rf.z)+"]}");
