func combatBomb() CombatExplosive {
	return CombatExplosive{ID: "grenade.fixture", Damage: 40, RadiusMM: 3000, RangeMM: 10000, AP: 3, Suppression: 20, Bleed: 3}
}
func combatBomber(id, team string, at Cell, count int) Combatant {
	a := combatClub(id, team, at)
	a.Explosives = []CombatExplosiveStock{{Explosive: combatBomb(), Count: count}}
	return a
}
func TestCombatExplosiveRealOutcomesFiniteStockAndSaveContinuation(t *testing.T) {
	r, space := combatAdvancedRules(), combatFixtureSpace()
	r.DamageMin = 1
	r.DamageMax = 1
	a, b := combatBomber("a", "blue", Cell{1, 1}, 2), combatClub("b", "red", Cell{5, 1})
	a.Initiative = 30
	b.Initiative = 20
	s := combatNewAdvanced(t, r, space, a, b)
	combatDo(t, &s, space, r, "a", CombatAction{Type: "throw", ItemID: combatBomb().ID, To: Cell{5, 1}})
	if s.Actor("a").AP != 5 || s.Actor("a").Explosives[0].Count != 1 || len(combatFixtureHits(s.Actor("b"))) != 1 || combatFixtureHits(s.Actor("b"))[0].Mode!="blast" {
		t.Fatal("explosive did not spend real AP/stock or dispatch the blast to the wound host")
	}
	clone := s.Clone()
	clone.Actor("a").Explosives[0].Count = 99
	if s.Actor("a").Explosives[0].Count != 1 {
		t.Fatal("explosive clone aliased stock")
	}
	raw, _ := json.Marshal(s)
	var loaded CombatState
	if err := json.Unmarshal(raw, &loaded); err != nil {
		t.Fatal(err)
	}
	if err := loaded.Validate(r, space); err != nil {
		t.Fatal(err)
	}
	for _, state := range []*CombatState{&s, &loaded} {
		combatDo(t, state, space, r, "a", CombatAction{Type: "throw", ItemID: combatBomb().ID, To: Cell{6, 1}})
	}
	if !reflect.DeepEqual(s, loaded) || s.Actor("a").Explosives[0].Count != 0 || len(combatFixtureHits(s.Actor("b"))) != 2 {
		t.Fatal("save changed actual blast outcomes or restored stock")
	}
	n, items, ap := 0, 0, 0
	for _, e := range s.Events {
		if e.Type == "throw" {
			n++
			items += e.ItemsSpent
			ap += e.AP
		}
	}
	if n != 2 || items != 2 || ap != 6 {
		t.Fatal("one physical grenade was not spent for each accepted throw")
	}
	before := s.Clone()
	if err := s.Execute(space, r, "a", CombatAction{Type: "throw", ItemID: combatBomb().ID, To: Cell{5, 1}}); err == nil || !reflect.DeepEqual(before, s) {
		t.Fatal("empty stock threw again or mutated rejected command")
	}
}
