  TravelSeconds:func(string,Cell,Cell)int64{return 30}}
 schedule:=LifeStep{Level:"market",At:Cell{6,6},Activity:"market"};home:=LifeStep{Level:"home",Activity:"sleep"}
 // Late in the window (past every personal arrival delay) and only lightly hungry: the meal-time appetite decides.
