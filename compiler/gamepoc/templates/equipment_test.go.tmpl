func TestCaptureResponseAndPhaseTimeline(t *testing.T){
 for _,at:=range []point{{2,2},{16,2},{16,7},{2,7},{3,2}}{t.Run(fmt.Sprintf("%d_%d",at.X,at.Y),func(t *testing.T){
  r:=equipmentFixture(t);r.initDemo("");placeHeroForScenario(r,at);last:="";var timeline []string;lastSwap:="";equippedAt:=int64(0);idle,maxIdle:=0,0;previous:=map[string]point{}
  for r.state.Tick<1200&&!r.state.Demo.Delivered&&r.state.Demo.Plan.Status!="failed"{r.step();assertDemoNoOverlap(t,r);d:=r.state.Demo;if at==(point{16,2})&&len(d.Events)>0 {event:=d.Events[len(d.Events)-1];if event!=lastSwap&&strings.Contains(event,"меняет позиции"){lastSwap=event;t.Logf("swap tick=%d stage=%v travel=%v contact=%v",r.state.Tick,d.Squad.StageGoals,d.Squad.TravelGoals,d.Squad.ContactGoals);for _,m:=range r.squadMembers(){a:=r.sceneActor(m.ID);t.Logf(" actor=%s at=%v goal=%v path=%v blocked=%d yield=%d",a.ID,a.Position,a.Goal,a.Path,a.BlockedTicks,a.YieldUntil)}}}
   phase:=fmt.Sprintf("%s/%s/%s",d.Squad.Phase,d.Supply.Status,d.Plan.Current);if phase!=last{timeline=append(timeline,fmt.Sprintf("%d:%s",r.state.Tick,phase));last=phase};if d.Supply.Status=="equipped"&&equippedAt==0{equippedAt=r.state.Tick};if equippedAt>0&&!d.Captured{moved:=false;for _,m:=range r.squadMembers(){at:=location(m.Position);if previous[m.ID]!=at{moved=true};previous[m.ID]=at};if moved{idle=0}else{idle++;if idle>maxIdle{maxIdle=idle}}}}
  t.Logf("timeline=%v max_idle_ticks=%d capture=%d equip_to_capture=%d",timeline,maxIdle,r.state.Demo.CapturedTick,r.state.Demo.CapturedTick-equippedAt)
  if at==(point{16,2}){if maxIdle>int(2*r.world.Config.CaptureDemo.MoveEveryTicks){t.Fatalf("near-service group stopped for %d ticks",maxIdle)};if equippedAt==0||r.state.Demo.CapturedTick-equippedAt>90{t.Fatal("near-service approach exceeded nine seconds")}}
  if !r.state.Demo.Delivered{for _,a:=range r.sceneActors(){t.Logf("%s pos=%v goal=%v task=%s path=%v reason=%s",a.ID,a.Position,a.Goal,a.Task,a.Path,a.Progress.Reason)};t.Fatalf("mission failed: %s",r.state.Demo.Plan.Diagnostic())}
 })}
}

