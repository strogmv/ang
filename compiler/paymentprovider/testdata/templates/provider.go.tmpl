func (pp *{{ .StructName }}) ParseCallback(r *http.Request) (*model.CallbackData, error) {
{{- if .CallbackReturnQueryTxIDParam }}
	queryTxID := r.URL.Query().Get("{{ .CallbackReturnQueryTxIDParam }}")
	if queryTxID != "" {
		cb := &cbData{
{{- if .CallbackTxIDField }}
			{{ .CallbackTxIDField }}: queryTxID,
{{- end }}
{{- if and (eq .StatusCodeType "string") .CallbackStatusField .CallbackReturnQueryStatusValue }}
			{{ .CallbackStatusField }}: "{{ .CallbackReturnQueryStatusValue }}",
{{- end }}
		}
		return &model.CallbackData{
			TnxId:        queryTxID,
			Data:         cb,
			InfoCallback: {{ .CallbackReturnQueryInfoCallback }},
			HttpCode:     http.StatusOK,
		}, nil
	}
{{- end }}
	body, err := io.ReadAll(io.LimitReader(r.Body, maxCallbackBodyBytes+1))
	if err != nil {
		return nil, fmt.Errorf(errReadCallbackBodyFmt, err)
	}
	if len(body) > maxCallbackBodyBytes {
		return nil, fmt.Errorf(errCallbackTooLargeFmt, maxCallbackBodyBytes)
	}

	var cb cbData
	if err := json.Unmarshal(body, &cb); err != nil {
		return nil, fmt.Errorf(providers.ErrUnmarshalCallbackFmt, err)
	}
	cb.raw = body

	var txID string
{{- if .CallbackTxIDField }}
	txID = cb.{{ .CallbackTxIDField }}
{{- else }}
	txID = cb.PayInID
	if txID == "" {
		txID = cb.PayOutID
	}
{{- end }}

	cd := &model.CallbackData{
		TnxId:    txID,
		Data:     &cb,
		HttpCode: http.StatusOK,
	}
{{- if .CallbackForeignIDField }}
	cd.ForeignID = cb.{{ .CallbackForeignIDField }}
{{- end }}
	return cd, nil
}

func (pp *{{ .StructName }}) ValidateCallback(mc *model.MerchantCreds, tx *model.Transaction, cd *model.CallbackData) error {
{{- if .CallbackSignature }}
	d, ok := cd.Data.(*cbData)
	if !ok {
		return fmt.Errorf("%s: unexpected callback data type %T", ppSID, cd.Data)
	}
	secrets, err := pp.parseProviderSecrets(mc, opCallback)
	if err != nil {
		return err
	}
	if !verifyCallbackSignature(secrets.{{ .CallbackSignature.SecretKeyField }}, d.{{ .CallbackSignature.SignatureField }}, d) {
		return providers.ErrInvalidSignature
	}
{{- if .UseMacanP2P }}
	if !macanCallbackAmountMatches(tx, d) {
		return fmt.Errorf("%s: callback amount mismatch", ppSID)
	}
{{- end }}
{{- else if .UseMacanP2P }}
	d, ok := cd.Data.(*cbData)
	if !ok {
		return fmt.Errorf("%s: unexpected callback data type %T", ppSID, cd.Data)
	}
	secrets, err := pp.parseProviderSecrets(mc, opCallback)
	if err != nil {
		return err
	}
	if !verifyMacanCallbackSignature(secrets.signatureKey, d.Signature, d) {
		return providers.ErrInvalidSignature
	}
	if !macanCallbackAmountMatches(tx, d) {
		return fmt.Errorf("%s: callback amount mismatch", ppSID)
	}
{{- else if eq .SigningAlgorithm "hmac-sha256" }}
	d, ok := cd.Data.(*cbData)
	if !ok {
		return fmt.Errorf("%s: unexpected callback data type %T", ppSID, cd.Data)
	}
	if len(d.raw) == 0 {
		return nil
	}

	secrets, err := pp.parseProviderSecrets(mc, opCallback)
	if err != nil {
		return err
	}

	if !verifySignature(secrets.{{ .SigningSecretField }}, d.raw, "" /* TODO: extract signature from callback */) {
		return providers.ErrInvalidSignature
	}
{{- end }}
	return nil
}

func (pp *{{ .StructName }}) FinishCallback(mc *model.MerchantCreds, tx *model.Transaction, cd *model.CallbackData) (*model.StatusResponse, error) {
{{- if not .CallbackStatusField }}
	return nil, providers.ErrNotImplemented
{{- else }}
	d, ok := cd.Data.(*cbData)
	if !ok {
		return nil, fmt.Errorf("%s: unexpected callback data type %T", ppSID, cd.Data)
	}

	pp.txPathLogger.Log(tx, model.LogActionTypeCallback, providers.LogActionTypeReceived, string(d.raw))

{{- if and .ErrorCodes .CallbackErrorCodeField }}
	if d.{{ .CallbackErrorCodeField }} != "" {
		status, code := mapErrorCode(d.{{ .CallbackErrorCodeField }})
		return &model.StatusResponse{Status: status, Code: code, Message: code.Description()}, nil
	}
{{ end }}
	var status model.TnxStatus
	var code model.TnxStatusCode
	var msg string

	if tx.Type == model.TnxTypePay {
{{- if .UseMacanP2P }}
		status, code, msg = macanPayInStatus(providerStatus(d.{{ .CallbackStatusField }}), d.StatusDetails)
{{- else if eq .StatusCodeType "string" }}
		status, code, msg = mapPayinStatus(providerStatus(d.{{ .CallbackStatusField }}))
{{- else }}
		status, code, msg = mapPayinStatus(d.{{ .CallbackStatusField }})
{{- end }}
	} else {
{{- if .UseMacanP2P }}
		status, code, msg = macanPayOutStatus(providerStatus(d.{{ .CallbackStatusField }}), d.StatusDetails)
{{- else if eq .StatusCodeType "string" }}
		status, code, msg = mapPayoutStatus(providerStatus(d.{{ .CallbackStatusField }}))
{{- else }}
		status, code, msg = mapPayoutStatus(d.{{ .CallbackStatusField }})
{{- end }}
	}
{{- if and .ExtendedCallbackConfig .ExtendedCallbackConfig.Enabled }}
	applyExtendedCallbackFallbacks(tx)
{{- end }}
{{- if .UseMacanP2P }}
	if d.Amount > 0 {
		tx.ExchangedAmount = helpers.FloatAmountToCoins(d.Amount, tx.Currency)
	}
{{- end }}
{{- if .UseOperationRuntime }}
	if status.Pending() && pp.shouldCheckStatusAfterPendingCallback("finish_callback") {
		statusResp, err := pp.CheckStatus(mc, tx)
		if err != nil {
			pp.txPathLogger.Log(tx, model.LogActionTypeCallback, "pending callback check status failed", err.Error())
		} else if statusResp != nil {
			return statusResp, nil
		}
	}
{{- end }}
	resp := &model.StatusResponse{
		Status:  status,
		Code:    code,
		Message: msg,
	}
{{- if and .Async3DSConfig .Async3DSConfig.Enabled }}
	return pp.tryAsync3DSCallback(mc, tx, cd, resp)
{{- else }}
	return resp, nil
{{- end }}
{{- end }}
}

