	if len(previous)>0&&previous[0]=="flee"&&reaction.Kind=="fight_on"{reaction.Kind="flee";reaction.Reason="continuing escape after another serious wound"}
 a.FightResponse = reaction.Kind
 // Fear requests escape; only the ordinary distance-checked disengage can withdraw a body.
 if reaction.Kind == "surrender" {
  a.StandDownUntil=combatBody(*a).Clock+r.world.CombatRuntime.ShockFallSeconds
		a.Surrendered = true
		a.AP = 0
		a.ReservedAP = 0
		a.Guarding = false
		a.Overwatch = false
	}
	if reaction.Kind == "fall" {
		b := combatBody(*a)
		b.StunUntil = max(b.StunUntil, b.Clock+r.world.CombatRuntime.ShockFallSeconds)
		projectWoundBody(a, b)
		a.AP = 0
		a.Prone = true
		a.Crouched = false
	}
	s.EventSeq++
	s.Events = append(s.Events, behavior.CombatEvent{Type: reaction.Kind, ActorID: a.ID, TargetID: a.ID, From: a.Position, To: a.Position, Turn: s.Turn, Sequence: s.EventSeq, Reason: reaction.Reason})
}
