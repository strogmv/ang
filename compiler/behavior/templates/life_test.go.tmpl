func TestLifeInspectionStatePersistsAndClones(t *testing.T) {
	m := lifeInspectionFixture()
	if err := m.Validate(); err != nil { t.Fatal("blocked prop cell must be accepted", err) }
	s := m.Start()
	s.Observer.Attributes["observation"] = 75
	s.Observer.Knowledge[0] = "discovered_log"
	if m.Inspection.Observer.Attributes["observation"] != 20 || m.Inspection.Observer.Knowledge[0] != "home" { t.Fatal("initial observer aliases catalog") }
	clone := s.Clone()
	clone.Observer.Attributes["observation"] = 1
	clone.Observer.Knowledge[0] = "other"
	if s.Observer.Attributes["observation"] != 75 || s.Observer.Knowledge[0] != "discovered_log" { t.Fatal("life clone aliases observer") }
	raw, err := json.Marshal(s)
	if err != nil { t.Fatal(err) }
	var restored LifeState
	if err := json.Unmarshal(raw, &restored); err != nil { t.Fatal(err) }
	if !reflect.DeepEqual(s.Observer, restored.Observer) { t.Fatal("inspection progression lost on save/load") }
	if err := restored.Validate(m, 0); err != nil { t.Fatal(err) }
	for _, value := range []int{-1, 101} {
		restored.Observer.Attributes["observation"] = value
		if restored.Validate(m, 0) == nil { t.Fatal("invalid saved observer accepted") }
	}
}

