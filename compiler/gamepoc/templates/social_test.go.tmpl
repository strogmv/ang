func TestLostTargetStartsSearchWithoutFollowingHiddenCoordinates(t *testing.T){
 r:=demoFixture(t);r.world.Scene.Cameras=nil;r.world.AI.Policy.Perception.Reports.Intents=nil;for !r.state.Demo.Issued{r.step()};d:=&r.state.Demo
 r.state.Tick+=r.world.AI.Policy.Group.Search.LostGraceTicks+1
 // Use accepted participants with a real last-known report, then move the hero out of sight.
 for i:=range d.Candidates{d.Candidates[i].Selected=i<3};for i:=range d.Agents{a:=&d.Agents[i];a.Position=point{2+i,2};a.Path=nil;a.Task="await_team";a.YieldUntil=0;a.Reaction.Awareness=behavior.Awareness{Known:true,Active:true,Position:cell(d.Call),ObservedTick:r.state.Tick,ExpiresTick:r.state.Tick+100}}
 r.world.AI.Policy.Social.SightRange=1;r.state.Player=point{16,7}
 r.socialStep();if d.Squad.Phase!="search_assembling"&&d.Squad.Phase!="searching"{t.Fatalf("did not enter search: %+v",d.Squad)}
 origin,deadline:=d.Squad.Search.Origin,d.Squad.Search.DeadlineTick
 if origin==cell(r.state.Player){t.Fatal("search used hidden hero coordinates")}
 r.state.Player=point{17,7};r.state.Tick++;r.socialStep()
 if d.Squad.Search.Origin!=origin||d.Squad.Search.DeadlineTick!=deadline||d.Captured{t.Fatal("hidden target moved the shared search")}
 before:=r.snapshotState();if len(before.Demo.Squad.Search.Checked)==0{t.Fatal("search area missing")};before.Demo.Squad.Search.Checked[0]=!before.Demo.Squad.Search.Checked[0];if before.Demo.Squad.Search.Checked[0]==d.Squad.Search.Checked[0]{t.Fatal("snapshot aliases search")}
}
