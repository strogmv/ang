  internal static double LocationSDKGateEase(double u,double d,double r){
   if(d<=0)return 1;u=Math.Max(0,Math.Min(d,u));if(r<=0||2*r>d)return u/d;double cruise=d-r;
   if(u<r)return u*u/(2*r*cruise);if(u>d-r){double v=d-u;return 1-v*v/(2*r*cruise);}return (2*u-r)/(2*cruise);
  }
  internal static double LocationSDKGatePPM(AngelsDemons.Game.V1.PocGateState s,double simNS){
