; Generated by ANG: common CUE architecture only, without a second location.
[gd_scene format=3]
{{.FinishHeader}}
[sub_resource type="BoxMesh" id="box"]
size = Vector3(1, 1, 1)

[node name="ArchitectureGeometry" type="Node3D"]
metadata/layout_id = {{quote .LayoutID}}
metadata/world_frame = {{quote .Frame}}
{{if .FinishBindings}}
[node name="Finish" type="Node" parent="."]
script = ExtResource("location_finish")
material_bindings = {
{{.FinishBindings}}}
{{end}}
[node name="Structure" type="Node3D" parent="."]
{{template "procedural_box_nodes" .}}
