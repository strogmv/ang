	if len(r.world.Peddlers.Peddlers) == 0 {
		t.Skip("world has no peddlers")
	}
	r.state.Life.SecondsPerTick = 1
	r.state.Life.Actor(playerActorID).Manual = true
	return r
}
func peddlerNamed(t *testing.T, r *Runtime, shop string) peddlerDef {
	t.Helper()
	for _, p := range r.world.Peddlers.Peddlers {
		if p.Shop == shop {
			return p
		}
	}
	t.Fatalf("no peddler %s", shop)
	return peddlerDef{}
}
func peddlerStep(t *testing.T, r *Runtime) {
	t.Helper()
	r.state.Tick++
	if err := r.state.Inventory.Advance(r.state.Tick); err != nil {
		t.Fatal(err)
	}
	if err := r.advanceLifeFrameBy(r.state.Life.SecondsPerTick); err != nil {
		t.Fatal(err)
	}
