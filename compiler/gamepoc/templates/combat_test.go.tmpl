// Only the initial arrangement is controlled: put the existing hero on real,
// unoccupied floor within unarmed contact of an existing resident. Encounters,
// actions, decisions, resource effects, messages and saves use the actual host.
// No actor, successful hit or AI decision is injected into encounter state.
func combatLifeFixture(t *testing.T, opponent bool) (*Runtime, *connection, string) {
	t.Helper()
	r, err := New(t.TempDir(), "token")
	if err != nil {
		t.Fatal(err)
	}
	if r.world.CombatRuntime.DefaultProfile == "" {
		t.Skip("this generated world has no authored combat adapter")
	}
	c := &connection{locale: "ru", out: make(chan *pb.ServerMessage, 256), stop: make(chan struct{})}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: r.state.Epoch, RequestId: "combat.life.new", Scenario: "life", Seed: 777}}}})
	for len(c.out) > 0 {
		m := <-c.out
		if result := m.GetActionResult(); result != nil && !result.Ok {
			t.Fatal(result.Message)
		}
	}
	if !r.state.Life.Enabled || r.state.SDKLayout != "" {
		t.Fatal("fixture must use the ordinary Life world, not an isolated SDK or custody scene")
	}
	r.state.Life.SecondsPerTick = 1
	r.world.Config.DebugPerception = false
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || !hero.OnFloor() {
		t.Fatal("ordinary hero missing")
	}
	ids := make([]string, 0, len(r.state.Life.Actors))
	for _, a := range r.state.Life.Actors {
		if a.ID != hero.ID && a.Level == hero.Level && a.OnFloor() {
			ids = append(ids, a.ID)
		}
	}
	sort.Strings(ids)
	// Prefer the existing roommate in open circulation over a seller behind a counter.
	for i, id := range ids {
		if id == "char.roommate_senya" {
			ids[0], ids[i] = ids[i], ids[0]
			break
		}
	}
	model := r.state.Life.GateModel(r.world.Life)
	space := model.Space(hero.Level, r.state.Life.BlockedCells(hero.Level, hero.ID))
	for _, id := range ids {
		target := r.state.Life.Actor(id)
		for _, d := range []behavior.Cell{{X: 2}, {X: -2}, {Y: 2}, {Y: -2}, {X: 1}, {X: -1}, {Y: 1}, {Y: -1}} {
			at := behavior.Cell{X: target.Position.X + d.X, Y: target.Position.Y + d.Y}
			if at.X < 0 || at.Y < 0 || at.X >= space.Width || at.Y >= space.Height || !space.Walkable(at) || space.Blocked[at] || r.combatDistance(at, target.Position) > r.world.CombatRuntime.Profiles["hero"].Weapon.RangeMM || !r.sightLine(location(at), location(target.Position)) {
				continue
			}
			if v := r.deckVolume(); v != nil && !v.CombatShotClear(at, target.Position) {
				continue
			}
			hero.Position, hero.Goal = at, at
			hero.Path, hero.PendingPath, hero.Body = nil, nil, nil
			hero.Manual, hero.Arrived = true, true
			hero.OverrideLevel, hero.OverrideEdge = "", ""
			hero.MoveStartTick = r.lifeMotionTick()
			r.state.Life.EnsureHeroBody(model)
			r.syncLifeHero()
			r.updateLifeExploration()
			if opponent {
				// Authored guard profile on an existing resident is an explicit test
				// arrangement; it does not turn market sellers into guards in content.
				r.world.CombatRuntime.Actors[id] = "guard"
			}
			return r, c, id
		}
	}
	t.Fatal("ordinary market has no clear, unoccupied contact approach for combat fixture")
	return nil, nil, ""
}

func combatWire(t *testing.T, r *Runtime, c *connection, q *pb.PocCombatCommand) (*pb.PocActionResult, *pb.PocGameState) {
	t.Helper()
	if q.Epoch == "" {
		q.Epoch = r.state.Epoch
	}
	r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_CombatCommand{CombatCommand: q}}})
	var result *pb.PocActionResult
	var snapshot *pb.PocGameState
	for len(c.out) > 0 {
		m := <-c.out
		if v := m.GetActionResult(); v != nil && v.RequestId == q.RequestId {
			result = v
		}
		if m.GetGameState() != nil {
			snapshot = m.GetGameState()
		}
	}
	if result == nil {
		t.Fatal("combat intent did not produce an authoritative action result")
	}
	return result, snapshot
}

func combatStart(t *testing.T, r *Runtime, c *connection, id string) {
	t.Helper()
	result, snapshot := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "combat.start", Action: "start", TargetId: id})
	if !result.Ok || snapshot == nil || snapshot.Combat == nil || !snapshot.Combat.Active || r.state.Combat.Current() == nil || r.state.Combat.Current().ID != playerActorID {
		t.Fatalf("ordinary Life encounter did not start through command/snapshot: %v %v", result, snapshot)
	}
}

func combatCopy(t *testing.T, s state) state {
	t.Helper()
	b, err := json.Marshal(s)
	if err != nil {
		t.Fatal(err)
	}
	var copy state
	if err := json.Unmarshal(b, &copy); err != nil {
		t.Fatal(err)
	}
	return copy
}

func TestCombatLifeAuthoredDefaultsDoNotGrantEquipment(t *testing.T) {
	r, _, target := combatLifeFixture(t, false)
	if err := r.world.CombatRuntime.Validate(); err != nil {
		t.Fatal(err)
	}
	for id, profile := range r.world.CombatRuntime.Profiles {
		if profile.Weapon.ID != "unarmed" || profile.Weapon.Magazine != 0 || profile.Ammo != 0 || profile.ReserveAmmo != 0 || profile.Medkits != 0 {
			t.Fatalf("profile %s grants unearned combat inventory: %+v", id, profile)
		}
	}
	if actor := r.combatant(target, "opposition"); actor.Weapon.ID != "unarmed" || actor.Trained || actor.Ammo != 0 || !actor.Noncombatant {
		t.Fatalf("ordinary resident acquired weapon or training without physical equipment: %+v", actor)
	}
}

func TestCombatLifeWireAPDamageDuplicateAndStaleTurn(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	// A certain-hit rules fixture isolates host AP/resource execution from the
	// separately tested stochastic balance. Decisions and resolution still run.
	r.world.CombatRuntime.Rules.MinHit, r.world.CombatRuntime.Rules.MaxHit = 1, 1
	combatStart(t, r, c, target)
	beforeWounds := len(combatBody(*r.state.Combat.Actor(target)).Wounds)
	beforeAP := r.state.Combat.Actor(playerActorID).AP
	q := &pb.PocCombatCommand{RequestId: "combat.attack.1", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn}
	result, snapshot := combatWire(t, r, c, q)
	if !result.Ok || snapshot == nil || snapshot.Combat == nil || len(combatBody(*r.state.Combat.Actor(target)).Wounds) != beforeWounds+1 || r.state.Combat.Actor(playerActorID).AP != beforeAP-r.state.Combat.Actor(playerActorID).Weapon.AttackAP {
		t.Fatalf("attack did not spend AP and apply authoritative damage: %v %+v", result, r.state.Combat)
	}
	accepted := r.state.Combat.Clone()
	result, _ = combatWire(t, r, c, q)
	if !result.Ok || !reflect.DeepEqual(accepted, r.state.Combat) {
		t.Fatal("duplicate accepted command applied a second attack or changed RNG state")
	}
	result, _ = combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "combat.attack.stale", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn + 1})
	if result.Ok || result.Message == "" || !reflect.DeepEqual(accepted, r.state.Combat) {
		t.Fatal("stale turn consumed resources or silently succeeded")
	}
	turn := r.state.Combat.Turn
	result, _ = combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "combat.end", Action: "end", ExpectedTurn: turn})
	if !result.Ok || !r.state.Combat.Active || r.state.Combat.Turn <= turn || r.state.Combat.Current() == nil || r.state.Combat.Current().ID != playerActorID {
		t.Fatalf("end did not run the real NPC turn and return control: %v %+v", result, r.state.Combat)
	}
	npcAction := false
	for _, event := range r.state.Combat.Events {
		if event.ActorID == target {
			npcAction = true
		}
	}
	if !npcAction {
		t.Fatal("end turn advanced a counter without executing an NPC action")
	}
}

func TestCombatLifeHoldsParticipantsWhileWorldContinues(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	combatStart(t, r, c, target)
	seconds := r.state.Life.Seconds
	poses := map[string]behavior.Cell{}
	for _, actor := range r.state.Combat.Actors {
		poses[actor.ID] = actor.Position
	}
	otherID := ""
	otherSecond := int64(0)
	for _, a := range r.state.Life.Actors {
		if _, held := poses[a.ID]; !held {
			otherID, otherSecond = a.ID, a.Brain.LastSecond
			break
		}
	}
	for i := 0; i < 10; i++ {
		r.step()
	}
	if r.state.Life.Seconds <= seconds {
		t.Fatal("encounter froze the independent Life calendar")
	}
	for id, at := range poses {
		a := r.state.Life.Actor(id)
		if !a.CombatHold || a.Position != at || len(a.Path) != 0 || len(a.PendingPath) != 0 || r.state.Combat.Actor(id).Position != at {
			t.Fatalf("ordinary routine moved combat participant %s while awaiting a turn", id)
		}
	}
	if r.world.Life.Brain.Enabled && otherID != "" && r.state.Life.Actor(otherID).Brain.LastSecond <= otherSecond {
		t.Fatal("unrelated actor's needs simulation did not continue")
	}
}

func TestCombatLifeSaveResumesRNGAndRejectsSemanticTamper(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	combatStart(t, r, c, target)
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(loaded.Combat, r.state.Combat) {
		t.Fatal("save changed current turn, contacts, resources or queue")
	}
	first, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "combat.branch.a", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if !first.Ok {
		t.Fatal(first.Message)
	}
	expected := r.state.Combat.Clone()
	r.state = combatCopy(t, loaded)
	second, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: "combat.branch.b", Action: "attack", TargetId: target, ExpectedTurn: r.state.Combat.Turn})
	if !second.Ok || !reflect.DeepEqual(expected, r.state.Combat) {
		t.Fatal("save/load rerolled the same attack or altered its resource effects")
	}
	for name, corrupt := range map[string]func(*state){
		"ap":     func(s *state) { s.Combat.Actor(playerActorID).AP = r.world.CombatRuntime.Rules.APPerTurn + 1 },
		"hold":   func(s *state) { s.Life.Actor(playerActorID).CombatHold = false },
		"pose":   func(s *state) { s.Combat.Actor(playerActorID).Position = s.Combat.Actor(target).Position },
		"roster": func(s *state) { a := s.CombatRoster[playerActorID]; a.HP--; s.CombatRoster[playerActorID] = a },
	} {
		t.Run(name, func(t *testing.T) {
			bad := combatCopy(t, loaded)
			corrupt(&bad)
			// Recompute envelope checksum through the real writer: rejection must
			// come from semantic validation, not from a broken checksum alone.
			if err := r.writeSave(slot, bad); err != nil {
				t.Fatal(err)
			}
			if _, _, err := r.readSave(slot); err == nil {
				t.Fatalf("accepted semantically invalid combat %s", name)
			}
		})
	}
}

func TestCombatLifeWireHidesOpponentResourcesAndUnseenBodies(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	combatStart(t, r, c, target)
	r.sendState(c)
	var view *pb.PocCombatView
	for len(c.out) > 0 {
		if m := (<-c.out).GetGameState(); m != nil {
			view = m.Combat
		}
	}
	if view == nil {
		t.Fatal("ordinary Life snapshot omitted active combat")
	}
	found := false
	for _, a := range view.Actors {
		if a.Id == target {
			found = true
			if a.Hp != 0 || a.MaxHp != 0 || a.Ap != 0 || a.Ammo != 0 {
				t.Fatal("visible opponent leaked exact private resources")
			}
		}
	}
	if !found {
		t.Fatal("visible real opponent missing from encounter projection")
	}
	// A zero-range observer is an explicit blindness fixture; it must not
	// discover the other participant merely because it is in Combat.Actors.
	r.world.Visibility.PlayerRange = 0
	msg := &pb.PocGameState{}
	r.appendCombat(msg)
	for _, a := range msg.Combat.Actors {
		if a.Id != playerActorID {
			t.Fatal("unseen encounter participant was exposed by combat view")
		}
	}
}

func TestCombatLifeRejectsFreeControlAndKeepsRejectionsAtomic(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	combatStart(t, r, c, target)
	before := r.state.Combat.Clone()
	for i, action := range []string{"auto", "rate", "goto"} {
		q := &pb.PocLifeCommand{Epoch: r.state.Epoch, RequestId: fmt.Sprintf("combat.free.%d", i), Action: action, Destination: "level.poc_monorail", SecondsPerTick: 30}
		r.command(input{client: c, msg: &pb.ClientMessage{Msg: &pb.ClientMessage_LifeCommand{LifeCommand: q}}})
		rejected := false
		for len(c.out) > 0 {
			if result := (<-c.out).GetActionResult(); result != nil {
				rejected = !result.Ok
			}
		}
		if !rejected || !reflect.DeepEqual(before, r.state.Combat) {
			t.Fatalf("free Life command %s bypassed encounter control", action)
		}
	}
	r.heroSteer(c, &pb.PocHeroSteer{Epoch: r.state.Epoch, InputSeq: 101, Mode: "direction", X: 1})
	result := (<-c.out).GetMoveResult()
	if result == nil || result.Ok || result.Reason == "" || !reflect.DeepEqual(before, r.state.Combat) {
		t.Fatal("continuous steer bypassed combat AP or altered state on rejection")
	}
	for len(c.out) > 0 {
		<-c.out
	}
	for i, action := range []string{"reload", "heal"} {
		res, _ := combatWire(t, r, c, &pb.PocCombatCommand{RequestId: fmt.Sprintf("combat.unearned.%d", i), Action: action, ExpectedTurn: r.state.Combat.Turn})
		if res.Ok || !reflect.DeepEqual(before, r.state.Combat) {
			t.Fatalf("%s succeeded without authored resources or mutated rejected action", action)
		}
	}
}

func TestCombatLifeResolvedEncounterAllowsWalkingSavingAndTravel(t *testing.T) {
	r, c, target := combatLifeFixture(t, true)
	r.world.CombatRuntime.Rules.MinHit, r.world.CombatRuntime.Rules.MaxHit = 1, 1
	combatStart(t, r, c, target)
 // A real refusal to fight resolves the encounter without requiring a lethal hit.
 if err:=r.performCombatAction(playerActorID,&behavior.CombatAction{Type:"end"});err!=nil{t.Fatal(err)}
 if err:=r.performCombatAction(target,&behavior.CombatAction{Type:"surrender"});err!=nil{t.Fatal(err)}
 res:=&pb.PocActionResult{Ok:true}
	if !res.Ok || r.state.Combat.Active || !r.state.Combat.Actor(target).Surrendered {
		t.Fatalf("real attack did not resolve encounter: %v %+v", res, r.state.Combat)
	}
	hero := r.state.Life.Actor(playerActorID)
	origin, level := hero.Position, hero.Level
	space := r.state.Life.GateModel(r.world.Life).Space(level, r.state.Life.BlockedCells(level, hero.ID))
	moved := false
	for _, d := range []behavior.Cell{{X: 2}, {X: -2}, {Y: 2}, {Y: -2}, {X: 3}, {X: -3}, {Y: 3}, {Y: -3}} {
		at := behavior.Cell{X: origin.X + d.X, Y: origin.Y + d.Y}
		if !space.Walkable(at) || space.Blocked[at] {
			continue
		}
		deck := int32(0)
		if v := r.deckVolume(); v != nil {
			n, ok := v.SurfaceIndex(at)
			if !ok {
				continue
			}
			deck = int32(n)
		}
		r.move(c, &pb.MoveTo{Epoch: r.state.Epoch, InputSeq: uint64(c.lastMoveSeq + 1), X: int32(at.X), Y: int32(at.Y), Deck: deck})
		accepted := false
		for len(c.out) > 0 {
			if q := (<-c.out).GetMoveResult(); q != nil {
				accepted = q.Ok
			}
		}
		if !accepted {
			continue
		}
		for i := 0; i < 1200; i++ {
			r.step()
			hero = r.state.Life.Actor(playerActorID)
			if hero.Position == at && (hero.Body == nil || hero.Body.Mode != "route") {
				break
			}
		}
		if hero.Position != at {
			t.Fatalf("post-combat ordinary route stalled at %v, wanted %v", hero.Position, at)
		}
		moved = true
		break
	}
	if !moved || hero.CombatHold || hero.Position == origin {
		t.Fatal("resolved encounter did not release ordinary walking")
	}
 // Finished views must follow ordinary Life rather than reuse the encounter origin.
 live:=&pb.PocGameState{};r.appendCombat(live);found:=false
 for _,a:=range live.Combat.Actors{if a.Id==playerActorID{found=true;if int(a.X)!=hero.Position.X||int(a.Y)!=hero.Position.Y{t.Fatal("finished view retained historical coordinates")}}}
 if !found{t.Fatal("finished encounter lost current public pose")}
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	loaded, _, err := r.readSave(slot)
	if err != nil {
		t.Fatal("finished battle rejected a later ordinary pose:", err)
	}
	r.state = loaded
	if loaded.Life.Actor(playerActorID).Position != hero.Position {
		t.Fatal("save rewound hero to historical combat pose")
	}
	edgeID, destination := "", ""
	for _, e := range r.world.Life.Edges {
		if e.From == level && e.Mode == "walk" && r.lifeExitKnown(e) {
			edgeID, destination = e.ID, e.To
			break
		}
	}
	if edgeID == "" {
		t.Fatal("ordinary authored market has no known walking exit")
	}
	if err := r.lifeCommand(&pb.PocLifeCommand{Action: "enter", Destination: edgeID}); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 3000 && r.currentLevel() == level; i++ {
		r.step()
	}
	if r.currentLevel() != destination {
		t.Fatal("finished encounter prevented real walking transition")
	}
	msg := &pb.PocGameState{}
	r.appendCombat(msg)
	if msg.Combat == nil || msg.Combat.Active || msg.Combat.LevelId != level || len(msg.Combat.Actors) > 0 || len(msg.Combat.Events) > 0 || msg.Combat.CurrentActorId != "" {
		t.Fatal("travel projected historical encounter bodies into another level")
	}
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := r.readSave(slot); err != nil {
		t.Fatal("finished battle rejected later travel save:", err)
	}
	bad := combatCopy(t, r.state)
	unknown := bad.CombatRoster[target]
	unknown.ID = "char.missing.combat"
	bad.CombatRoster[unknown.ID] = unknown
	if err := r.validateCombatSave(bad); err == nil {
		t.Fatal("unknown historical roster actor accepted")
	}
	bad = combatCopy(t, r.state)
	old := bad.CombatRoster[target]
	old.HP = old.MaxHP + 1
	bad.CombatRoster[target] = old
	if err := r.validateCombatSave(bad); err == nil {
		t.Fatal("historical roster resources outside bounds accepted")
	}
}

func TestCombatLifeGRPCStreamCommandsAndIdempotency(t *testing.T) {
	r, _, target := combatLifeFixture(t, true)
	r.world.CombatRuntime.Rules.MinHit, r.world.CombatRuntime.Rules.MaxHit = 1, 1
	// Save the initial physical arrangement before starting the concurrent host.
	// The stream itself performs Hello, NewGame and Load; no live state is edited.
	r.state.Life.Actor(target).Manual = true
	r.state.Life.Actor(target).Arrived = true
	r.canonicalWorld = r.world
	slot := r.world.Config.SaveSlots[0]
	if err := r.writeSave(slot, r.snapshotState()); err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()
	listener := bufconn.Listen(1 << 20)
	server := grpc.NewServer()
	pb.RegisterGameServiceServer(server, r)
	go func() { _ = server.Serve(listener) }()
	done := make(chan struct{})
	go func() { defer close(done); r.Run(ctx) }()
	defer func() { cancel(); server.Stop(); _ = listener.Close(); <-done }()
	conn, err := grpc.NewClient("passthrough:///combat", grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return listener.Dial() }))
	if err != nil {
		t.Fatal(err)
	}
	defer conn.Close()
	stream, err := pb.NewGameServiceClient(conn).Play(ctx)
	if err != nil {
		t.Fatal(err)
	}
	send := func(m *pb.ClientMessage) {
		t.Helper()
		if err := stream.Send(m); err != nil {
			t.Fatal(err)
		}
	}
	recv := func(id string) (*pb.PocActionResult, *pb.PocGameState) {
		t.Helper()
		var result *pb.PocActionResult
		for {
			m, err := stream.Recv()
			if err != nil {
				t.Fatal(err)
			}
			if q := m.GetActionResult(); q != nil && q.RequestId == id {
				result = q
			}
			if q := m.GetGameState(); q != nil && (id == "" || result != nil) {
				return result, q
			}
		}
	}
	send(&pb.ClientMessage{Msg: &pb.ClientMessage_Hello{Hello: &pb.Hello{SessionToken: "token", Locale: "en"}}})
	_, view := recv("")
	send(&pb.ClientMessage{Msg: &pb.ClientMessage_NewGame{NewGame: &pb.PocNewGameRequest{Epoch: view.Epoch, RequestId: "grpc.new", Scenario: "life", Seed: 777}}})
	result, view := recv("grpc.new")
	if !result.Ok {
		t.Fatal(result.Message)
	}
	send(&pb.ClientMessage{Msg: &pb.ClientMessage_LoadGame{LoadGame: &pb.PocLoadRequest{Epoch: view.Epoch, RequestId: "grpc.load", Slot: slot}}})
	result, view = recv("grpc.load")
	if !result.Ok {
		t.Fatal(result.Message)
	}
	command := func(q *pb.PocCombatCommand) (*pb.PocActionResult, *pb.PocGameState) {
		t.Helper()
		send(&pb.ClientMessage{Msg: &pb.ClientMessage_CombatCommand{CombatCommand: q}})
		return recv(q.RequestId)
	}
	result, view = command(&pb.PocCombatCommand{Epoch: view.Epoch, RequestId: "grpc.start", Action: "start", TargetId: target})
	if !result.Ok || view.Combat == nil || !view.Combat.Active || view.Combat.CurrentActorId != playerActorID {
		t.Fatalf("gRPC encounter start failed: %v %v", result, view.Combat)
	}
	attack := &pb.PocCombatCommand{Epoch: view.Epoch, RequestId: "grpc.attack", Action: "attack", TargetId: target, ExpectedTurn: view.Combat.Turn}
	result, view = command(attack)
	if !result.Ok {
		t.Fatal(result.Message)
	}
	initial := view.Combat
	found := false
	for _, e := range initial.Events {
		if e.Type == "attack" && e.ActorId == playerActorID && e.TargetId == target && e.Hit && e.Amount > 0 {
			found = true
		}
	}
	if !found {
		t.Fatal("accepted gRPC attack omitted authoritative damage event")
	}
	result, view = command(attack)
	if !result.Ok || !reflect.DeepEqual(initial, view.Combat) {
		t.Fatal("duplicate gRPC attack changed AP/events/turn")
	}
	result, view = command(&pb.PocCombatCommand{Epoch: view.Epoch, RequestId: "grpc.stale", Action: "attack", TargetId: target, ExpectedTurn: view.Combat.Turn + 1})
	if result.Ok || !reflect.DeepEqual(initial, view.Combat) {
		t.Fatal("stale gRPC turn changed combat")
	}
	turn := view.Combat.Turn
	result, view = command(&pb.PocCombatCommand{Epoch: view.Epoch, RequestId: "grpc.end", Action: "end", ExpectedTurn: turn})
	if !result.Ok || view.Combat.Turn <= turn {
		t.Fatal("gRPC end did not execute opposing tactical turn")
	}
}
