   if(state!=null&&look!=null&&locationSDKRoot!=null)foreach(var item in state.GroundWeapons){
    var weapon=CombatWeapon(item.Definition);if(weapon==null||string.IsNullOrEmpty(weapon.prop)||weapon.prop=="none")continue;
    visible.Add(item.ItemId);GameObject go;if(!combatGroundProps.TryGetValue(item.ItemId,out go)||go==null){var prefab=Resources.Load<GameObject>("CombatProps/"+weapon.prop);if(prefab==null)continue;go=Instantiate(prefab,locationSDKRoot.transform,false);go.name="floor weapon / "+item.ItemId;foreach(var child in go.GetComponentsInChildren<Transform>(true))child.gameObject.layer=LocationSDKLayer;combatGroundProps[item.ItemId]=go;}
    bool waiting=false;CombatBody owner;
    if(!string.IsNullOrEmpty(item.OwnerId)&&combatBodies.TryGetValue(item.OwnerId,out owner)&&CombatPlaying){
     waiting=owner.held==item.Definition;
     foreach(var beat in combatQueue)if(beat.victimShift&&beat.target==item.OwnerId||beat.kind=="fall_shift"&&beat.actor==item.OwnerId){waiting=true;break;}
