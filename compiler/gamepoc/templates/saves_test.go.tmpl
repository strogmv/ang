func TestSaveListGoesNewestFirstWithEachSaveKind(t *testing.T) {
	r, c := saveFixture(t)
	manual, auto, quick := r.world.Config.SaveSlots, r.world.Config.AutoSave.Slots, r.world.Config.QuickSave.Slots
	r.testCommand(c, saveRequest(r, "manual", manual[1], ""))
	time.Sleep(3 * time.Millisecond)
	r.saves.playedNS = r.world.Config.AutoSave.EveryPlayMinutes * int64(time.Minute)
	r.autosaveWhenDue()
	drainDisk(r)
	time.Sleep(3 * time.Millisecond)
	r.testCommand(c, saveRequest(r, "quick", "", "quick"))
	listed := r.storageRuntime().readSlots()
	var got, want []string
	for _, s := range listed {
		got = append(got, fmt.Sprintf("%s:%s:%v:%v:%d", s.Id, s.Kind, s.Exists, s.Writable, s.Number))
	}
	want = append(want, quick[0]+":quick:true:false:1", auto[0]+":auto:true:false:1", manual[1]+":manual:true:true:2")
	for i, slot := range manual {
		if i != 1 {
			want = append(want, fmt.Sprintf("%s:manual:false:true:%d", slot, i+1))
		}
	}
	if !reflect.DeepEqual(got, want) {
		t.Fatalf("list %v, want newest first, then the empty manual slots, no empty auto or quick slot: %v", got, want)
	}
	for _, s := range listed[:3] {
		if !s.Valid || s.SavedAtUnixMs == 0 || s.Problem != "" {
			t.Fatalf("a fresh save is not valid: %+v", s)
		}
	}
	if !(listed[0].SavedAtUnixMs >= listed[1].SavedAtUnixMs && listed[1].SavedAtUnixMs >= listed[2].SavedAtUnixMs) {
		t.Fatal("the list is not newest first")
	}
	// a damaged autosave stays in the list, so it can be deleted
	if err := os.WriteFile(r.slotFile(auto[1]), []byte("{"), 0600); err != nil {
		t.Fatal(err)
	}
	damaged := false
	for _, s := range r.storageRuntime().readSlots() {
		if s.Id == auto[1] {
			damaged = s.Exists && !s.Valid && s.Problem != "" && s.Kind == "auto"
		}
	}
	if !damaged {
		t.Fatal("a damaged autosave is not listed with its problem")
	}
}

