// AUTO-GENERATED by ANG
// What the API client decides per request — retries, cache bypass, idempotency key.
// Kept apart from endpoints/meta.ts: the client is part of every page, and it needs
// these few rules, not the metadata of every operation.

export type RetryStrategy = {
  maxAttempts: number;
  baseDelayMs: number;
  retryOnStatuses: readonly number[];
  retryNetworkErrors: boolean;
};

export const retryStrategies: readonly RetryStrategy[] = [
{{- range .Strategies }}
  { maxAttempts: {{ .MaxAttempts }}, baseDelayMs: {{ .BaseDelayMS }}, retryOnStatuses: [{{ .RetryOnStatuses }}], retryNetworkErrors: {{ .RetryNetworkErrors }} },
{{- end }}
];

/** [retry strategy index or -1, bypass caches, send an Idempotency-Key] */
export type RequestRule = readonly [number, boolean, boolean];

/** The rule most operations of an HTTP method share. */
export const requestDefaults: Readonly<Record<string, RequestRule>> = {
{{- range .Defaults }}
  {{ .Method }}: [{{ .Strategy }}, {{ .NoStore }}, {{ .Idempotent }}],
{{- end }}
};

/** Operations whose rule differs from their method's default: [method, path template, ...rule]. */
export const requestOverrides: ReadonlyArray<readonly [string, string, number, boolean, boolean]> = [
{{- range .Overrides }}
  ['{{ .Method }}', '{{ .Path }}', {{ .Strategy }}, {{ .NoStore }}, {{ .Idempotent }}],
{{- end }}
];
