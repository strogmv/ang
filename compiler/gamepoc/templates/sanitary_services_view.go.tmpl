			return fmt.Errorf("invalid sanitary user")
		}
		serials[p.Serial] = true
		count[u.ID]++
		if p.ReturnBySecond > 0 && (id == playerActorID || a.Brain.BreakReturnAt != p.ReturnBySecond || a.Brain.BreakStarted > p.RequestedSecond || a.Brain.BreakUntil-a.Brain.BreakStarted != r.world.Life.Brain.HygieneSeconds || a.Brain.BreakReturnAt > a.Brain.BreakUntil || a.Brain.BreakKind != "" && a.Brain.BreakKind != "hygiene" || !r.world.Life.Walks(a.Brain.BreakPost.Level, a.Brain.BreakPost.At)) {
			return fmt.Errorf("sanitary duty break lost its saved budget/post")
		}
