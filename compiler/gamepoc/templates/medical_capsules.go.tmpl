func (r *Runtime) medicalAccount(id string) (inv.Account, bool) {
	ids := []string{}
	for key, a := range r.state.Inventory.Accounts {
		if a.Owner == id && a.Currency == r.world.MedicalCapsules.Currency {
			ids = append(ids, key)
		}
	}
	sort.Strings(ids)
	if len(ids) == 0 {
