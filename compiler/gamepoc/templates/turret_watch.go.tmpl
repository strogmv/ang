// world.turret_watch: when anyone who is not a guard comes closer to the guarded object than the rule's
// range, a turret turns to them; of several, both watch the one nearest to the object (ties by id).
// Each turret needs its own line of sight; walls and closed doors block it. With nobody left, it holds
// the last point for hold_ms and slowly returns to rest. Watching only: no fire, alarm or law.
// Detailed where the player is: turret state exists only on the hero's level; elsewhere nothing is kept.
type turretWatchCatalog struct {
	Rule  turretWatchRule   `json:"rule"`
	Look  turretWatchLook   `json:"look"`
	Posts []turretWatchPost `json:"posts"`
}

type turretWatchRule struct {
	RangeM          float64 `json:"range_m"`
	HoldMS          int64   `json:"hold_ms"`
	SwitchMarginM   float64 `json:"switch_margin_m"`
	AimHeightM      float64 `json:"aim_height_m"`
	PanSlewDegS     float64 `json:"pan_slew_deg_s"`
	TiltSlewDegS    float64 `json:"tilt_slew_deg_s"`
	ReturnSlewDegS  float64 `json:"return_slew_deg_s"`
	PanHalfRangeDeg float64 `json:"pan_half_range_deg"`
	TiltMinDeg      float64 `json:"tilt_min_deg"`
	TiltMaxDeg      float64 `json:"tilt_max_deg"`
	EyeRiseMS       int64   `json:"eye_rise_ms"`
	EyeFallMS       int64   `json:"eye_fall_ms"`
}

type turretWatchLook struct {
	EyeRestEnergy  float64 `json:"eye_rest_energy"`
	EyeWatchEnergy float64 `json:"eye_watch_energy"`
	EyeLightEnergy float64 `json:"eye_light_energy"`
	EyeLightRangeM float64 `json:"eye_light_range_m"`
	EyeLightColor  string  `json:"eye_light_color"`
}

type turretWatchPost struct {
	ID         string   `json:"id"`
	LevelID    string   `json:"level_id"`
	InstanceID string   `json:"instance_id"`
	GuardPost  string   `json:"guard_post"`
	StaffLabel string   `json:"staff_label"`
	Guards     []string `json:"guards"`
	Object     struct {
		ID string  `json:"id"`
		XM float64 `json:"x_m"`
		YM float64 `json:"y_m"`
	} `json:"object"`
	PivotM          []float64 `json:"pivot_m"`
	FacingDeg       float64   `json:"facing_deg"`
	RestAimM        []float64 `json:"rest_aim_m"`
	PanNode         string    `json:"pan_node"`
	TiltNode        string    `json:"tilt_node"`
	EyeNodes        []string  `json:"eye_nodes"`
	RestHeadingMdeg int64     `json:"rest_heading_mdeg"`
	RestPitchMdeg   int64     `json:"rest_pitch_mdeg"`
}

// One watched turret of the hero's level. Saved with the game; replaced as a whole every tick
// (copy on write), so a snapshot that shares the old slice never sees it change.
type turretWatchState struct {
	ID     string `json:"id"`
	Phase  string `json:"phase"` // rest | tracking | holding | returning
	Target string `json:"target,omitempty"`
	// The server's own aim after the slew limits: plan heading (0 east, +90 south) and pitch, millidegrees.
	HeadingMdeg int64 `json:"heading_mdeg"`
	PitchMdeg   int64 `json:"pitch_mdeg"`
	// The point aimed at last: plan millimetres and height above the floor.
	AimMM     [3]int64 `json:"aim_mm"`
	EyePPM    int64    `json:"eye_ppm"` // 0 at rest .. 1000000 watching (the eye light fraction)
	LostNS    int64    `json:"lost_ns,omitempty"`
	UpdatedNS int64    `json:"updated_ns"`
}

// Anyone standing on the level: the hero, Life people, residents and hall visitors.
type turretWatchPerson struct {
	ID       string
	XMM, YMM int64
	Cell     behavior.Cell
}

func turretWatchMdeg(deg float64) int64 { return int64(math.Round(deg * 1000)) }

func turretWatchWrap(mdeg int64) int64 {
	mdeg %= 360000
	if mdeg <= -180000 {
		mdeg += 360000
	}
	if mdeg > 180000 {
		mdeg -= 360000
	}
	return mdeg
}

func turretWatchToward(current, want, step int64) int64 {
	if current < want {
		return min(want, current+step)
	}
	return max(want, current-step)
}

func (p turretWatchPost) guard(id string) bool {
	for _, g := range p.Guards {
		if g == id {
			return true
		}
	}
	return false
}

func (p turretWatchPost) rest(r turretWatchRule) turretWatchState {
	return turretWatchState{ID: p.ID, Phase: "rest", HeadingMdeg: p.RestHeadingMdeg, PitchMdeg: p.RestPitchMdeg,
		AimMM: [3]int64{int64(math.Round(p.RestAimM[0] * 1000)), int64(math.Round(p.RestAimM[1] * 1000)), int64(math.Round(p.RestAimM[2] * 1000))}}
}

// aim is the heading and pitch from the sphere centre to a plan point (mm, height mm), and whether the
// mount can point there at all (pan about its facing, tilt within the limits).
func (p turretWatchPost) aim(r turretWatchRule, x, y, h int64) (heading, pitch int64, ok bool) {
	dx, dy := float64(x)/1000-p.PivotM[0], float64(y)/1000-p.PivotM[1]
	dh := float64(h)/1000 - p.PivotM[2]
	flat := math.Hypot(dx, dy)
	if flat < .05 {
		return 0, 0, false
	}
	heading = turretWatchWrap(turretWatchMdeg(math.Atan2(dy, dx) * 180 / math.Pi))
	pitch = turretWatchMdeg(math.Atan2(dh, flat) * 180 / math.Pi)
	rel := turretWatchWrap(heading - turretWatchMdeg(p.FacingDeg))
	half := turretWatchMdeg(r.PanHalfRangeDeg)
	return heading, pitch, rel >= -half && rel <= half && pitch >= turretWatchMdeg(r.TiltMinDeg) && pitch <= turretWatchMdeg(r.TiltMaxDeg)
}

func (r *Runtime) turretWatchCellMM(level string) int64 {
	if cell := r.world.Life.Locations[level].CellMM; cell > 0 {
		return int64(cell)
	}
	return 1000
}

// turretWatchPeople: everyone on the floor of the level, sorted by id. NPCs stand at their cell centre;
// the hero's continuous body is used as it is.
func (r *Runtime) turretWatchPeople(level string) []turretWatchPerson {
	cell := r.turretWatchCellMM(level)
	centre := func(id string, at behavior.Cell) turretWatchPerson {
		return turretWatchPerson{ID: id, XMM: int64(at.X)*cell + cell/2, YMM: int64(at.Y)*cell + cell/2, Cell: at}
	}
	var out []turretWatchPerson
	for _, a := range r.state.Life.Actors {
		if a.Level != level || !a.OnFloor() || r.sanitaryPrivateActor(a.ID) {
			continue
		}
		p := centre(a.ID, a.Position)
		if a.Body != nil {
			p.XMM, p.YMM = int64(math.Round(a.Body.X)), int64(math.Round(a.Body.Y))
			p.Cell = behavior.Cell{X: int(p.XMM / cell), Y: int(p.YMM / cell)}
		}
		out = append(out, p)
	}
	for _, a := range r.state.Life.Population.Actors {
		if a.Materialized && a.Trip == nil && a.Level == level {
			out = append(out, centre(a.ID, a.Position))
		}
	}
	if r.visitorsOn() && r.world.Visitors.Level == level {
		for _, b := range r.state.Visitors.Bodies {
			out = append(out, centre(fmt.Sprintf("visitor.%d", b.Serial), b.At))
		}
	}
	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
	return out
}

// turretWatchChoose: the person this turret watches now. In range of the object, not a guard, in the
// mount's reach and in its own sight; the nearest to the object (ties by id). A watched person keeps the
// turret unless another is nearer by more than switch_margin_m.
func (r *Runtime) turretWatchChoose(p turretWatchPost, previous string, people []turretWatchPerson) (turretWatchPerson, bool) {
	rule := r.world.TurretWatch.Rule
	cell := r.turretWatchCellMM(p.LevelID)
	pivot := behavior.Cell{X: int(math.Floor(p.PivotM[0] * 1000 / float64(cell))), Y: int(math.Floor(p.PivotM[1] * 1000 / float64(cell)))}
	ox, oy := int64(math.Round(p.Object.XM*1000)), int64(math.Round(p.Object.YM*1000))
	reach := int64(math.Round(rule.RangeM * 1000))
	height := int64(math.Round(rule.AimHeightM * 1000))
	type candidate struct {
		person   turretWatchPerson
		distance int64
	}
	var best, kept *candidate
	for _, person := range people {
		if p.guard(person.ID) {
			continue
		}
		distance := int64(math.Round(math.Hypot(float64(person.XMM-ox), float64(person.YMM-oy))))
		if distance > reach {
			continue
		}
		if _, _, ok := p.aim(rule, person.XMM, person.YMM, height); !ok {
			continue
		}
		if !r.turretWatchSees(p, pivot, person, height) {
			continue
		}
		c := &candidate{person, distance}
		if best == nil || distance < best.distance || (distance == best.distance && person.ID < best.person.ID) {
			best = c
		}
		if person.ID == previous {
			kept = c
		}
	}
	if best == nil {
		return turretWatchPerson{}, false
	}
	if kept != nil && kept.distance-best.distance <= int64(math.Round(rule.SwitchMarginM*1000)) {
		return kept.person, true
	}
	return best.person, true
}

// turretWatchSees: the turret's own line of sight, from the sphere centre to the person's chest. On a level with a
// 500 mm deck volume it is the exact 3D ray of the volume (walls and slabs, and the closed leaves of gates through the
// level's light boxes, block it; a low counter under the ray does not); elsewhere the planar sight of the level
// (walls and closed doors of the gate terrain).
func (r *Runtime) turretWatchSees(p turretWatchPost, pivot behavior.Cell, person turretWatchPerson, height int64) bool {
	v := r.world.Decks[p.LevelID]
	if v == nil || r.turretWatchCellMM(p.LevelID) != 500 {
		return r.combatSight(p.LevelID, pivot, person.Cell)
	}
	c := r.world.Illumination.Levels[p.LevelID]
	if c.rays != nil {
		v = c.rays
	}
	_, floor, _, ok := v.Locate(person.Cell)
	if !ok {
		return false
	}
	base := floor
	if _, under, _, found := v.Locate(pivot); found {
		base = under
	}
	from := behavior.DeckPointMM{X: p.PivotM[0] * 1000, Y: p.PivotM[1] * 1000, Z: float64(base) + p.PivotM[2]*1000}
	to := behavior.DeckPointMM{X: float64(person.XMM), Y: float64(person.YMM), Z: float64(floor + int(height))}
	return v.RayClearMM(from, to, r.illuminationBoxes(c))
}

func (r *Runtime) advanceTurretWatch() {
	if r.world.TurretWatch == nil || !r.state.Life.Enabled {
		r.state.Turrets = nil
		return
	}
	hero := r.state.Life.Actor(playerActorID)
	level := ""
	if hero != nil && hero.Trip == nil {
		level = hero.Level
	}
	now := r.state.Tick * r.tickNS()
	rule := r.world.TurretWatch.Rule
	var people []turretWatchPerson
	var next []turretWatchState
	for _, p := range r.world.TurretWatch.Posts {
		if p.LevelID != level {
			continue // nobody watches where the player is not
		}
		if people == nil {
			people = r.turretWatchPeople(level)
		}
		s := p.rest(rule)
		s.UpdatedNS = now
		for _, saved := range r.state.Turrets {
			if saved.ID == p.ID {
				s = saved
			}
		}
		dt := max(int64(0), now-s.UpdatedNS)
		wantH, wantP, rate, ratePitch := s.HeadingMdeg, s.PitchMdeg, int64(0), int64(0)
		height := int64(math.Round(rule.AimHeightM * 1000))
		if person, ok := r.turretWatchChoose(p, s.Target, people); ok {
			s.Phase, s.Target, s.LostNS = "tracking", person.ID, 0
			s.AimMM = [3]int64{person.XMM, person.YMM, height}
			wantH, wantP, _ = p.aim(rule, person.XMM, person.YMM, height)
			rate, ratePitch = turretWatchMdeg(rule.PanSlewDegS), turretWatchMdeg(rule.TiltSlewDegS)
		} else {
			switch s.Phase {
			case "tracking":
				s.Phase, s.Target, s.LostNS = "holding", "", now
			case "holding":
				if now-s.LostNS >= rule.HoldMS*1000000 {
					s.Phase = "returning"
				}
			}
			if s.Phase == "returning" || s.Phase == "rest" {
				rest := p.rest(rule)
				s.AimMM, wantH, wantP = rest.AimMM, rest.HeadingMdeg, rest.PitchMdeg
				rate, ratePitch = turretWatchMdeg(rule.ReturnSlewDegS), turretWatchMdeg(rule.ReturnSlewDegS)
			}
		}
		// Pan travels inside the mount's arc, never through the wall behind it.
		facing, half := turretWatchMdeg(p.FacingDeg), turretWatchMdeg(rule.PanHalfRangeDeg)
		rel := max(-half, min(half, turretWatchWrap(s.HeadingMdeg-facing)))
		want := max(-half, min(half, turretWatchWrap(wantH-facing)))
		s.HeadingMdeg = turretWatchWrap(facing + turretWatchToward(rel, want, rate*dt/1000000000))
		wantP = max(turretWatchMdeg(rule.TiltMinDeg), min(turretWatchMdeg(rule.TiltMaxDeg), wantP))
		s.PitchMdeg = turretWatchToward(s.PitchMdeg, wantP, ratePitch*dt/1000000000)
		if s.Phase == "returning" && s.HeadingMdeg == p.RestHeadingMdeg && s.PitchMdeg == p.RestPitchMdeg {
			s.Phase = "rest"
		}
		if s.Phase == "tracking" || s.Phase == "holding" {
			s.EyePPM = turretWatchToward(s.EyePPM, 1000000, 1000000*dt/(rule.EyeRiseMS*1000000))
		} else {
			s.EyePPM = turretWatchToward(s.EyePPM, 0, 1000000*dt/(rule.EyeFallMS*1000000))
		}
		s.UpdatedNS = now
		next = append(next, s)
	}
	r.state.Turrets = next
}

func (r *Runtime) turretWatchSpec(p turretWatchPost) *pb.PocTurretWatchSpec {
	rule, look := r.world.TurretWatch.Rule, r.world.TurretWatch.Look
	return &pb.PocTurretWatchSpec{Id: p.ID, InstanceId: p.InstanceID, PanNode: p.PanNode, TiltNode: p.TiltNode, EyeNodes: append([]string(nil), p.EyeNodes...),
		PivotM: append([]float64(nil), p.PivotM...), FacingMdeg: turretWatchMdeg(p.FacingDeg), RestHeadingMdeg: p.RestHeadingMdeg, RestPitchMdeg: p.RestPitchMdeg,
		PanHalfRangeMdeg: turretWatchMdeg(rule.PanHalfRangeDeg), TiltMinMdeg: turretWatchMdeg(rule.TiltMinDeg), TiltMaxMdeg: turretWatchMdeg(rule.TiltMaxDeg),
		PanSlewMdegS: turretWatchMdeg(rule.PanSlewDegS), TiltSlewMdegS: turretWatchMdeg(rule.TiltSlewDegS), ReturnSlewMdegS: turretWatchMdeg(rule.ReturnSlewDegS),
		AimHeightM: rule.AimHeightM, EyeRestEnergy: look.EyeRestEnergy, EyeWatchEnergy: look.EyeWatchEnergy, EyeLightEnergy: look.EyeLightEnergy,
		EyeLightRangeM: look.EyeLightRangeM, EyeLightColor: look.EyeLightColor}
}

// appendTurretWatch: the turrets of the hero's level. The target id is sent only for a person the hero
// sees (so the client can follow the drawn body between ticks); the aim itself is always sent.
func (r *Runtime) appendTurretWatch(view *pb.PocLifeView, hero *behavior.LifeActor, perception *pb.PocObserverView) {
	if r.world.TurretWatch == nil || hero == nil || hero.Trip != nil {
		return
	}
	rule := r.world.TurretWatch.Rule
	for _, p := range r.world.TurretWatch.Posts {
		if p.LevelID != hero.Level {
			continue
		}
		s := p.rest(rule)
		s.UpdatedNS = r.state.Tick * r.tickNS()
		for _, saved := range r.state.Turrets {
			if saved.ID == p.ID {
				s = saved
			}
		}
		target := s.Target
		if target != "" {
			cell := r.turretWatchCellMM(p.LevelID)
			if !viewSees(perception, int32(s.AimMM[0]/cell), int32(s.AimMM[1]/cell)) {
				target = ""
			}
		}
		view.TurretWatch = append(view.TurretWatch, &pb.PocTurretWatchState{Id: p.ID, InstanceId: p.InstanceID, Phase: s.Phase, TargetId: target,
			HeadingMdeg: s.HeadingMdeg, PitchMdeg: s.PitchMdeg, AimM: []float64{float64(s.AimMM[0]) / 1000, float64(s.AimMM[1]) / 1000, float64(s.AimMM[2]) / 1000},
			EyePpm: s.EyePPM, SampleNs: s.UpdatedNS})
		view.TurretWatchSpecs = append(view.TurretWatchSpecs, r.turretWatchSpec(p))
	}
	if len(view.TurretWatchSpecs) > 0 {
		raw, _ := json.Marshal(view.TurretWatchSpecs)
		h := fnv.New64a()
		h.Write(raw)
		view.TurretWatchSpecsRevision = h.Sum64()
	}
}

// validateTurretWatch: a saved turret belongs to a post of the hero's level and stays inside its limits.
func (r *Runtime) validateTurretWatch(s state) error {
	if len(s.Turrets) == 0 {
		return nil
	}
	if r.world.TurretWatch == nil {
		return errors.New("turret state in a world without turrets")
	}
	hero := s.Life.Actor(playerActorID)
	rule := r.world.TurretWatch.Rule
	seen := map[string]bool{}
	for _, t := range s.Turrets {
		var post *turretWatchPost
		for i := range r.world.TurretWatch.Posts {
			if r.world.TurretWatch.Posts[i].ID == t.ID {
				post = &r.world.TurretWatch.Posts[i]
			}
		}
		if post == nil || seen[t.ID] || hero == nil || hero.Trip != nil || hero.Level != post.LevelID {
			return fmt.Errorf("turret %s is saved away from the hero's level", t.ID)
		}
		seen[t.ID] = true
		switch t.Phase {
		case "rest", "tracking", "holding", "returning":
		default:
			return fmt.Errorf("turret %s has an unknown phase %q", t.ID, t.Phase)
		}
		rel := turretWatchWrap(t.HeadingMdeg - turretWatchMdeg(post.FacingDeg))
		if (t.Phase == "tracking") != (t.Target != "") || rel < -turretWatchMdeg(rule.PanHalfRangeDeg) || rel > turretWatchMdeg(rule.PanHalfRangeDeg) ||
			t.PitchMdeg < turretWatchMdeg(rule.TiltMinDeg) || t.PitchMdeg > turretWatchMdeg(rule.TiltMaxDeg) || t.EyePPM < 0 || t.EyePPM > 1000000 || t.UpdatedNS < 0 || t.LostNS < 0 {
			return fmt.Errorf("turret %s is saved outside its limits", t.ID)
		}
		if post.guard(t.Target) {
			return fmt.Errorf("turret %s is saved watching a guard", t.ID)
		}
	}
	return nil
}
