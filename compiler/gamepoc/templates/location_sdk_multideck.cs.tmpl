  internal bool LocationSDKInstanceFaded(GameObject root){return root!=null&&locationSDKInstanceFaded.Contains(root);}
  void ReleaseLocationSDKMultideck(){locationSDKInstanceFadeMaterial=null;locationSDKInstanceBounds.Clear();locationSDKInstanceFaded.Clear();locationSDKInstanceHiddenText.Clear();locationSDKNav=null;locationSDKHeroWorldValid=false;locationSDKNavWorld.Clear();locationSDKNavDeck.Clear();locationSDKDeckRoots.Clear();locationSDKCutawayHidden.Clear();locationSDKCutawayFaded.Clear();locationSDKFadeOriginal.Clear();locationSDKGlassMaterial=null;locationSDKFadeMaterial=null;}
 }
