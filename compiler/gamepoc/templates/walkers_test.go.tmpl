// A visitor standing in the hero's way steps aside and the hero walks on; a visitor who cannot step aside stops the hero:
// the hero's body never enters his cell.
func TestWalkersStepAsideForTheHero(t *testing.T) {
	r := visitorsRuntime(t, 1)
	v := r.world.Visitors
	visitorsRun(t, r, (10*3600-r.state.Life.Seconds%86400+86400)%86400, nil)
	r.state.Life.SecondsPerTick = 1
	r.world.Visitors.PerDay = 0
	r.visitors = visitorRuntime{}
	for _, b := range r.state.Visitors.Bodies {
		r.visitorLeave(v.Slots[b.Slot])
	}
	r.state.Visitors.Bodies = nil
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || hero.Level != v.Level || hero.Body == nil {
		t.Skip("the hero has no body on the visitors' level")
	}
	// the hero walks 8 cells east over open floor; a visitor stands 4 cells ahead of him, at a stall (dwelling)
	from := hero.Position
	target := behavior.Cell{X: from.X + 8, Y: from.Y}
	for x := from.X; x <= target.X; x++ {
		for dy := -1; dy <= 1; dy++ {
			if !r.world.Life.Walks(v.Level, behavior.Cell{X: x, Y: from.Y + dy}) {
				t.Skip("no open floor east of the hero's start")
			}
		}
	}
	model := r.state.Life.GateModel(r.world.Life)
	ahead := behavior.Cell{X: from.X + 4, Y: from.Y}
	r.state.Visitors.Bodies = []visitorBody{{Serial: 9, Slot: 1, At: ahead, Phase: "stand", Wait: 400, Since: r.state.Tick + 1}}
	if !r.state.Life.HeroBodyRouteTo(model, target) {
		t.Fatal("the hero has no route east")
	}
	moved, passed := false, false
	for i := 0; i < 300; i++ {
		r.state.Tick++
		if err := r.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
		if err := walkersCheck(r, v.Level); err != nil {
			t.Fatalf("tick %d: %v", i, err)
		}
		if len(r.state.Visitors.Bodies) == 1 && r.state.Visitors.Bodies[0].At != ahead {
			moved = true
		}
		if h := r.state.Life.Actor(playerActorID); h.Position.X > ahead.X {
			passed = true
			break
		}
	}
	if !moved || !passed {
		t.Fatalf("the visitor stepped aside %v, the hero passed him %v", moved, passed)
	}
	// boxed in a passage one cell wide (another walker dwells behind him): he cannot step aside, the hero stops before him
	r2 := visitorsRuntime(t, 1)
	visitorsRun(t, r2, (10*3600-r2.state.Life.Seconds%86400+86400)%86400, nil)
	r2.state.Life.SecondsPerTick = 1
	for _, b := range r2.state.Visitors.Bodies {
		r2.visitorLeave(v.Slots[b.Slot])
	}
	r2.state.Visitors.Bodies = nil
	y, x0, x1 := walkersStand(t, r2)
	walkersCorridor(t, r2, y, x0, x1)
	hero = r2.state.Life.Actor(playerActorID)
	if hero == nil || hero.Body == nil {
		t.Skip("the hero has no body")
	}
	cell := float64(r2.world.Life.Locations[v.Level].CellMM)
	at := behavior.Cell{X: x0, Y: y}
	hero.Level, hero.Position, hero.Goal, hero.Path, hero.PendingPath = v.Level, at, at, nil, nil
	hero.Body.X, hero.Body.Y, hero.Body.Mode, hero.Body.Route, hero.Body.Cells = (float64(at.X)+.5)*cell, (float64(at.Y)+.5)*cell, "", nil, []behavior.Cell{at}
	ahead = behavior.Cell{X: x0 + 4, Y: y}
	r2.state.Visitors.Bodies = []visitorBody{
		{Serial: 20, Slot: 1, At: ahead, Phase: "stand", Wait: 400, Since: r2.state.Tick + 1},
		{Serial: 21, Slot: 2, At: behavior.Cell{X: x0 + 5, Y: y}, Phase: "stand", Wait: 400, Since: r2.state.Tick + 1},
	}
	model = r2.state.Life.GateModel(r2.world.Life)
	if !r2.state.Life.HeroBodyRouteTo(model, behavior.Cell{X: x1, Y: y}) {
		t.Fatal("the hero has no route along the passage")
	}
	contact := false
	for i := 0; i < 200; i++ {
		r2.state.Tick++
		if err := r2.advanceLifeFrameBy(1); err != nil {
			t.Fatal(err)
		}
		if err := walkersCheck(r2, v.Level); err != nil {
			t.Fatalf("boxed, tick %d: %v", i, err)
		}
		h := r2.state.Life.Actor(playerActorID)
		if h.Position == ahead || r2.state.Visitors.Bodies[0].At != ahead {
			t.Fatalf("tick %d: the hero is at %v, the boxed visitor at %v (stood at %v)", i, h.Position, r2.state.Visitors.Bodies[0].At, ahead)
		}
		contact = contact || h.Position == behavior.Cell{X: ahead.X - 1, Y: ahead.Y}
	}
	// he may find his own way round the passage afterwards, never through the visitor
	if !contact {
		t.Fatal("the hero never came up to the boxed visitor")
	}
}

// The hero stands in the cabinet's lane at night and does not move: the cabinet waits for him, then drives a way round
// him on free floor, joins its leg again, loads the modules and drives home; it never shares a cell with him.
func TestWalkersTheCabinetGoesRoundABodyInItsLane(t *testing.T) {
	r := visitorsRuntime(t, 30)
	rb := r.world.Vending.Robot
	if rb.OutLeg == nil || len(rb.OutLeg.Cells) < 50 || r.world.Vending.Level != r.world.Visitors.Level {
		t.Skip("no night round of a cabinet on the visitors' level")
	}
	visitorsRun(t, r, 86400-r.state.Life.Seconds%86400, nil)
	r.state.Life.SecondsPerTick = 10
	hero := r.state.Life.Actor(playerActorID)
	if hero == nil || hero.Body == nil || hero.Level != r.world.Vending.Level {
		t.Skip("the hero has no body on the cabinet's level")
	}
	at := behavior.Cell{X: rb.OutLeg.Cells[45].X, Y: rb.OutLeg.Cells[45].Y}
	cell := float64(r.world.Life.Locations[hero.Level].CellMM)
	hero.Position, hero.Goal, hero.Path, hero.PendingPath = at, at, nil, nil
	hero.Body.X, hero.Body.Y, hero.Body.Mode, hero.Body.Route, hero.Body.Cells = (float64(at.X)+.5)*cell, (float64(at.Y)+.5)*cell, "", nil, []behavior.Cell{at}
