	rules := map[string]bool{}
	for _, r := range m.Rules {
		if !practiceKey(r.ID) || rules[r.ID] || strings.TrimSpace(r.Name) == "" || !skills[r.Skill] || r.BaseGainMilli < 0 || r.BaseGainMilli > 100000 || r.Difficulty < 0 || r.Difficulty > 100 || r.SuccessPermille < 0 || r.SuccessPermille > 1000 || r.FailurePermille < 0 || r.FailurePermille > 1000 || r.CooldownTicks < 1 || r.CooldownTicks > 100000 || r.RepeatWindowTicks < r.CooldownTicks || r.RepeatScale < 1 || r.RepeatScale > 10000 {
			return fmt.Errorf("invalid practice rule %q", r.ID)
		}
		rules[r.ID] = true
	}
	for _, id := range practiceKeys(m.Profiles) {
		p := m.Profiles[id]
		if !practiceKey(id) || p.LearnPermille < 0 || p.LearnPermille > 3000 {
			return fmt.Errorf("invalid practice profile %q", id)
		}
		for _, skill := range practiceKeys(p.Skills) {
			v := p.Skills[skill]
			if !skills[skill] || v.Start < 0 || v.Cap < 0 || v.Cap > 100 || v.Start > v.Cap {
				return fmt.Errorf("invalid practice profile %q skill %q", id, skill)
			}
		}
