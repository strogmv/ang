		return nil
	}
	if c.Aid != nil {
		return []behavior.CombatCandidate{{Action: behavior.CombatAction{Type: "aid_continue"}, Score: 100, Reason: "continue first aid already in progress", AP: min(c.AP, c.Aid.RemainingS)}}
	}
	body := combatBody(c)
