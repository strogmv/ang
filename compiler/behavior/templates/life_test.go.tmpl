 s.Advance(m,1);if a=s.Actor("one");a.Trip!=nil||a.WaitingDeparture!=79200{t.Fatalf("wrong dusk waiting slot: %+v",a)}
 roundtrip:=func(value LifeState)LifeState{t.Helper();data,err:=json.Marshal(value);if err!=nil{t.Fatal(err)};var restored LifeState;if err=json.Unmarshal(data,&restored);err!=nil{t.Fatal(err)};return restored}
 restored:=roundtrip(s);s.SecondsPerTick=120;restored.SecondsPerTick=120
 for _,state:=range []*LifeState{&s,&restored}{state.Advance(m,2);a=state.Actor("one");if a.Trip==nil||a.Trip.Departure!=79200||a.Trip.Arrival!=79500{t.Fatalf("coarse tick skipped reserved departure: %+v",a)};if err:=state.Validate(m,2);err!=nil{t.Fatal(err)}}
 restored=roundtrip(restored)
